# a value taken into an inline table holds the key
def kk.VI(
  +gg: K3G,
  +rest: List<&2, T.Ctx>,
  +at: List<&2, String>,
  +saved: List<&2, String>,
  +parts: List<&2, String>,
  +vv: T.Val
) -> Bool:
  kk.sfx(Laws.k3.pl(rest, at, saved, List.append(&2, String, List.reverse(&2, String, parts), [])), kk.tp(gg), HVal{vv},
    kk.key(gg))

