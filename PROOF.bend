    case Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {Laws.own(T.doc.read(Laws.g.expr.text(Laws.GxKeyval{w1, Laws.GInlineTableKeyvals{_a0, _a1,
        _a2, _a3}, w2, com}, tail), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})})) == ap.F(ls,
          Laws.replay.expr(Laws.GxKeyval{w1, Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}, w2, com}, Laws.RpSt{"",
            Laws.own.rows(rw), hs, he})) : T.Doc}, Eq.and.left(Laws.g.ok.val(Laws.GInlineTableKeyvals{_a0, _a1, _a2,
              _a3}, Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com)), Eq.and.right(Laws.abnf.ws(w1),
                Bool.and(Laws.g.ok.val(Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}, Laws.RKeyval{}),
                  Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))), hx)))
    case Laws.GInlineTableKeyvalsLast{_a0}:
      Eq.bit.absurd(&2, {Laws.own(T.doc.read(Laws.g.expr.text(Laws.GxKeyval{w1, Laws.GInlineTableKeyvalsLast{_a0}, w2,
        com}, tail), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})})) == ap.F(ls,
          Laws.replay.expr(Laws.GxKeyval{w1, Laws.GInlineTableKeyvalsLast{_a0}, w2, com}, Laws.RpSt{"",
            Laws.own.rows(rw), hs, he})) : T.Doc}, Eq.and.left(Laws.g.ok.val(Laws.GInlineTableKeyvalsLast{_a0},
              Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com)), Eq.and.right(Laws.abnf.ws(w1),
                Bool.and(Laws.g.ok.val(Laws.GInlineTableKeyvalsLast{_a0}, Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w2),
                  Laws.g.ok.com(com))), hx)))

# one expression from the start of a line in any table, then the rest as
# aq.K reads it
def aq.xstep(
  +ex: Laws.GExpr,
  +tail: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ls: List<&2, Laws.GLine>,
  +hx: {Laws.g.ok.expr(ex) == True{} : Bool},
  +es: {Laws.short(Laws.g.expr.text(ex, tail)) == True{} : Bool},
  +hft: {aq.fol(tail) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls)
) -> {Laws.own(T.doc.read(Laws.g.expr.text(ex, tail), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf,
  False{})})) == ap.F(ls, Laws.replay.expr(ex, Laws.RpSt{"", Laws.own.rows(rw), hs, he})) : T.Doc}:
  match ex:
    case Laws.GxBlank{+w1, +com}:
      Equal.trans(T.Doc, Laws.own(T.doc.read(String.append(w1, Laws.g.com.text(com, tail)), T.MScan{ap.s(T.LTop{}, bk,
        rw, hs, he, [], qk, [], un, lf, False{})})), Laws.own(T.doc.read(tail, T.MScan{ap.aft(com, T.LTop{}, bk, rw,
          hs, he, [], qk, [], un, lf, False{})})), ap.F(ls, Laws.RpSt{"", Laws.own.rows(rw), hs, he}),
            Equal.cong(T.Doc, T.Doc, dd => Laws.own(dd), T.doc.read(String.append(w1, Laws.g.com.text(com, tail)),
              T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})}), T.doc.read(tail,
                T.MScan{ap.aft(com, T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})}), ap.tail(w1, com, tail,
                  T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{}, {==}, {==}, Eq.and.left(Laws.abnf.ws(w1),
                    Laws.g.ok.com(com), hx), Eq.and.right(Laws.abnf.ws(w1), Laws.g.ok.com(com), hx))), kk(com,
                      T.LTop{}, {==}, bk, rw, hs, he, qk, un, lf))
    case Laws.GxKeyval{+w1, +kv, +w2, +com}:
      aq.xkv0(w1, kv, w2, com, tail, rw, hs, he, bk, qk, un, lf, ls, hx, es, hft, kk, ee)
    case Laws.GxTable{+w1, +tb, +w2, +com}:
      aq.xtb(tb, w1, w2, com, tail, rw, hs, he, bk, qk, un, lf, ls, hx, kk, ee)

# the end of the text after the last expression: the rows, sealed and read
# out
def aq.fin(
  +com: Laws.GCom,
  +lx: T.Lex,
  +hl: {ap.tll(lx) == True{} : Bool},
  +bk: T.Lex,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +qk: T.QKind,
  +un: U32,
  +lf: U32
) -> {Laws.own(T.doc.read("", T.MScan{ap.aft(com, lx, bk, rw, hs, he, [], qk, [], un, lf, False{})})) == ap.F([],
  Laws.RpSt{"", Laws.own.rows(rw), hs, he}) : T.Doc}:
  Equal.trans(T.Doc, Laws.own(T.doc.read("", T.MScan{ap.aft(com, lx, bk, rw, hs, he, [], qk, [], un, lf, False{})})),
    Laws.own(T.Doc{"", T.rows.seal(rw)}), T.Doc{"", T.rows.seal(Laws.own.rows(rw))}, Equal.cong(T.Doc, T.Doc, dd =>
      Laws.own(dd), T.doc.read("", T.MScan{ap.aft(com, lx, bk, rw, hs, he, [], qk, [], un, lf, False{})}), T.Doc{"",
        T.rows.seal(rw)}, ap.fin(com, lx, bk, rw, hs, he, [], qk, un, lf, False{}, hl)), Equal.cong(List<&2, T.Val>,
          T.Doc, zs => T.Doc{"", zs}, Laws.own.rows(T.rows.seal(rw)), T.rows.seal(Laws.own.rows(rw)), cv.osl(rw)))

# the lines after a newline read from the start of the next line, own-level,
# to the replay
def aq.NL(
  +ex2: Laws.GExpr,
  +ls2: List<&2, Laws.GLine>,
  +lx: T.Lex,
  +bk: T.Lex,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +qk: T.QKind,
  +un: U32,
  +lf: U32
) -> Type:
  {Laws.own(T.doc.read(Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, "")), T.MScan{ap.s(lx, bk, rw, hs, he, [], qk, [],
    un,
    lf, False{})})) == Laws.replay.doc(Laws.replay.lines(ls2, Laws.replay.expr(ex2, Laws.RpSt{"", Laws.own.rows(rw), hs,
    he}))) : T.Doc}

# a newline, then the next line's expression and the lines after it, from
# the state a [ comment ] leaves, read own-level to the replay
def aq.nl(
  +com: Laws.GCom,
  +lx: T.Lex,
  +nn: String,
  +ex2: Laws.GExpr,
  +ls2: List<&2, Laws.GLine>,
  +bk: T.Lex,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +hm: {ap.coml(lx) == True{} : Bool},
  +hn: {Laws.abnf.newline(nn) == True{} : Bool},
  ih: aq.NL(ex2, ls2, ap.nlx(lx), ap.abk(com, lx, bk), rw, hs, he, qk, un, lf)
) -> {Laws.own(T.doc.read(String.append(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, ""))), T.MScan{ap.aft(com,
  lx, bk, rw, hs, he, [], qk, [], un, lf, False{})})) == ap.F(Laws.GLine{nn, ex2} <> ls2, Laws.RpSt{"",
    Laws.own.rows(rw), hs, he}) : T.Doc}:
  Equal.trans(T.Doc, Laws.own(T.doc.read(String.append(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, ""))),
    T.MScan{ap.aft(com, lx, bk, rw, hs, he, [], qk, [], un, lf, False{})})), Laws.own(T.doc.read(Laws.g.expr.text(ex2,
      Laws.g.lines.text(ls2, "")), T.MScan{ap.s(ap.nlx(lx), ap.abk(com, lx, bk), rw, hs, he, [], qk, [], un, lf,
        False{})})), Laws.replay.doc(Laws.replay.lines(ls2, Laws.replay.expr(ex2, Laws.RpSt{"", Laws.own.rows(rw), hs,
          he}))), Equal.cong(T.Doc, T.Doc, dd => Laws.own(dd), T.doc.read(String.append(nn, Laws.g.expr.text(ex2,
            Laws.g.lines.text(ls2, ""))), T.MScan{ap.aft(com, lx, bk, rw, hs, he, [], qk, [], un, lf, False{})}),
              T.doc.read(Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, "")), T.MScan{ap.s(ap.nlx(lx), ap.abk(com, lx,
                bk), rw, hs, he, [], qk, [], un, lf, False{})}), ap.eol(com, lx, nn, Laws.g.expr.text(ex2,
                  Laws.g.lines.text(ls2, "")), bk, rw, hs, he, [], qk, [], un, lf, False{}, hm, hn)), ih)

# the lines after an expression: the expression, a newline and the next
# line's, and so on to the end, read from the start of a line to a document
# own reads as the replay's
def aq.go(
  +ls: List<&2, Laws.GLine>,
  +ex: Laws.GExpr,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +hx: {Laws.g.ok.expr(ex) == True{} : Bool},
  +hl: {Laws.g.ok.lines(ls) == True{} : Bool},
  +es: {Laws.short(Laws.g.expr.text(ex, Laws.g.lines.text(ls, ""))) == True{} : Bool}
) -> {Laws.own(T.doc.read(Laws.g.expr.text(ex, Laws.g.lines.text(ls, "")), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [],
  qk, [], un, lf, False{})})) == Laws.replay.doc(Laws.replay.lines(ls, Laws.replay.expr(ex, Laws.RpSt{"",
    Laws.own.rows(rw), hs, he}))) : T.Doc}:
  match ls:
    case []:
      aq.xstep(ex, "", rw, hs, he, bk, qk, un, lf, [], hx, es, {==}, +com => +lx => +h2 => +b2 => +r2 => +s2 => +e2 =>
        +q2 => +u2 => +l2 => aq.fin(com, lx, h2, b2, r2, s2, e2, q2, u2, l2), aq.E([]))
    case Laws.GLine{+nn, +ex2} <> +ls2:
      +h1 = {Eq.and.right(Laws.abnf.newline(nn), Bool.and(Laws.g.ok.expr(ex2), Laws.g.ok.lines(ls2)),
        hl) : {Bool.and(Laws.g.ok.expr(ex2), Laws.g.ok.lines(ls2)) == True{} : Bool}}
      +hn = {Eq.and.left(Laws.abnf.newline(nn), Bool.and(Laws.g.ok.expr(ex2), Laws.g.ok.lines(ls2)),
        hl) : {Laws.abnf.newline(nn) == True{} : Bool}}
      +es2 = {aq.sh(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, "")), aq.sh(Laws.g.expr.text(ex, ""),
        String.append(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, ""))), aq.shq(Laws.g.expr.text(ex,
          String.append(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, "")))), String.append(Laws.g.expr.text(ex,
            ""), String.append(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, "")))), gt.expr(ex, String.append(nn,
              Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, "")))), es))) : {Laws.short(Laws.g.expr.text(ex2,
                Laws.g.lines.text(ls2, ""))) == True{} : Bool}}
      aq.xstep(ex, String.append(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, ""))), rw, hs, he, bk, qk, un, lf,
        Laws.GLine{nn, ex2} <> ls2, hx, es, aq.fol.nl(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, "")), hn),
        +com => +lx => +h2 => +b2 => +r2 => +s2 => +e2 => +q2 => +u2 => +l2 => ap.tll.elim(l3 =>
          {Laws.own(T.doc.read(String.append(nn, Laws.g.expr.text(ex2, Laws.g.lines.text(ls2, ""))),
            T.MScan{ap.aft(com, l3, b2, r2, s2, e2, [], q2, [], u2, l2, False{})})) == ap.F(Laws.GLine{nn,
              ex2} <> ls2, Laws.RpSt{"", Laws.own.rows(r2), s2, e2}) : T.Doc}, lx, h2,
          aq.nl(com, T.LTop{}, nn, ex2, ls2, b2, r2, s2, e2, q2, u2, l2, {==}, hn, aq.go(ls2, ex2, r2, s2, e2,
            ap.abk(com, T.LTop{}, b2), q2, u2, l2, Eq.and.left(Laws.g.ok.expr(ex2), Laws.g.ok.lines(ls2), h1),
              Eq.and.right(Laws.g.ok.expr(ex2), Laws.g.ok.lines(ls2), h1), es2)),
          aq.nl(com, T.LLine{}, nn, ex2, ls2, b2, r2, s2, e2, q2, u2, l2, {==}, hn, aq.go(ls2, ex2, r2, s2, e2,
            ap.abk(com, T.LLine{}, b2), q2, u2, l2, Eq.and.left(Laws.g.ok.expr(ex2), Laws.g.ok.lines(ls2), h1),
              Eq.and.right(Laws.g.ok.expr(ex2), Laws.g.ok.lines(ls2), h1), es2))),
        aq.E(Laws.GLine{nn, ex2} <> ls2))

# WP-A: the whole document. Its text starts with no byte-order mark (aq.nb.expr:
# a keyval starts with blank space and a key, whose first character is a
# bare-key character, a quotation mark or an apostrophe), so parse reads it
# from the start of a line (ap.lead), and the lines read own-level to the
# replay (aq.go).

# a bare-key character is no byte-order mark
def aq.nbc2(
  bom: Bool,
  +xx: U32,
  eb: {U32.is_eq(xx, 65279) == bom : Bool},
  hk: {Laws.abnf.unquoted_key_char(Chr{xx}) == True{} : Bool}
) -> {Bool.not(bom) == True{} : Bool}:
  match bom:
    case False{}:
      {==}
    case True{}:
      Equal.trans(Bool, False{}, Laws.abnf.unquoted_key_char(Chr{xx}), True{}, Equal.sym(Bool,
        Laws.abnf.unquoted_key_char(Chr{xx}), False{}, Equal.cong(U32, Bool, uu =>
          Laws.abnf.unquoted_key_char(Chr{uu}), xx, 65279, s1.isk(xx, 65279, eb))), hk)

# and so a text that starts with one does not start with a byte-order mark
def aq.nbc(
  hh: Char,
  +hk: {Laws.abnf.unquoted_key_char(hh) == True{} : Bool}
) -> {Bool.not(U32.is_eq(Char.to_u32(hh), 65279)) == True{} : Bool}:
  match hh:
    case Chr{+xx}:
      aq.nbc2(U32.is_eq(xx, 65279), xx, {==}, hk)

# a key segment starts with no byte-order mark
def aq.nb.seg(
  +sg: Laws.KSeg,
  +xx: String,
  +hs: {Laws.g.ok.seg(sg) == True{} : Bool}
) -> {ap.nobom(Laws.k3.seg.text(sg, xx)) == True{} : Bool}:
  match sg:
    case Laws.KsBare{+name}:
      match name:
        case SNil{}:
          Eq.bit.absurd(&2, {ap.nobom(Laws.k3.seg.text(Laws.KsBare{""}, xx)) == True{} : Bool}, hs)
        case SCon{+hh, +tt}:
          aq.nbc(hh, Eq.and.left(Laws.abnf.unquoted_key_char(hh), Laws.abnf.all_unquoted_key_chars(tt), hs))
    case Laws.KsBasic{_pl}:
      {==}
    case Laws.KsLit{_name}:
      {==}

# and so does a key
def aq.nb.key(
  +key: Laws.GKey,
  +xx: String,
  +hk: {Laws.g.ok.key(key) == True{} : Bool}
) -> {ap.nobom(Laws.g.key.text(key, xx)) == True{} : Bool}:
  match key:
    case Laws.GSimpleKey{+sk}:
      aq.nb.seg(sk, xx, hk)
    case Laws.GDottedKey{+sk, +more}:
      aq.nb.seg(sk, Laws.g.dots.text(more, xx), Eq.and.left(Laws.g.ok.seg(sk), Laws.g.ok.dots(more),
        Eq.and.right(Bool.not(List.is_empty(&2, Laws.GDotSep, more)), Bool.and(Laws.g.ok.seg(sk),
          Laws.g.ok.dots(more)), hk)))

# and so does a keyval
def aq.nb.kv(
  +kv: Laws.GVal,
  +xx: String,
  +hk: {Laws.g.ok.val(kv, Laws.RKeyval{}) == True{} : Bool}
) -> {ap.nobom(Laws.g.val.text(kv, xx)) == True{} : Bool}:
  match kv:
    case Laws.GKeyval{+key, +wa, +wb, +val}:
      aq.nb.key(key, String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val, xx))}),
        Eq.and.left(Laws.g.ok.key(key), Bool.and(Laws.abnf.ws(wa), Bool.and(Laws.abnf.ws(wb), Laws.g.ok.val(val,
          Laws.RVal{}))), hk))
    case Laws.GvString{_a0}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvString{_a0}, xx)) == True{} : Bool}, hk)
    case Laws.GvBoolean{_a0}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvBoolean{_a0}, xx)) == True{} : Bool}, hk)
    case Laws.GvArrayEmpty{_a0}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvArrayEmpty{_a0}, xx)) == True{} : Bool}, hk)
    case Laws.GvArray{_a0, _a1}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvArray{_a0, _a1}, xx)) == True{} : Bool}, hk)
    case Laws.GvInlineTableEmpty{_a0, _a1}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvInlineTableEmpty{_a0, _a1}, xx)) == True{} : Bool}, hk)
    case Laws.GvInlineTable{_a0, _a1, _a2}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvInlineTable{_a0, _a1, _a2}, xx)) == True{} : Bool}, hk)
    case Laws.GvDateTime{_a0}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvDateTime{_a0}, xx)) == True{} : Bool}, hk)
    case Laws.GvFloat{_a0}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvFloat{_a0}, xx)) == True{} : Bool}, hk)
    case Laws.GvInteger{_a0}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GvInteger{_a0}, xx)) == True{} : Bool}, hk)
    case Laws.GArrayValues{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GArrayValues{_a0, _a1, _a2, _a3}, xx)) == True{} : Bool}, hk)
    case Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}, xx)) == True{} : Bool}, hk)
    case Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3},
        xx)) == True{} : Bool}, hk)
    case Laws.GInlineTableKeyvalsLast{_a0}:
      Eq.bit.absurd(&2, {ap.nobom(Laws.g.val.text(Laws.GInlineTableKeyvalsLast{_a0}, xx)) == True{} : Bool}, hk)

# an expression starts with no byte-order mark, before a text that starts
# with none
def aq.nb.expr(
  +ex: Laws.GExpr,
  +xx: String,
  +hx: {Laws.g.ok.expr(ex) == True{} : Bool},
  +ht: {ap.nobom(xx) == True{} : Bool}
) -> {ap.nobom(Laws.g.expr.text(ex, xx)) == True{} : Bool}:
  match ex:
    case Laws.GxBlank{+w1, +com}:
      ap.nb.ws(w1, Laws.g.com.text(com, xx), Eq.and.left(Laws.abnf.ws(w1), Laws.g.ok.com(com), hx), ap.nb.com(com, xx,
        ht))
    case Laws.GxKeyval{+w1, +kv, +w2, +com}:
      ap.nb.ws(w1, Laws.g.val.text(kv, String.append(w2, Laws.g.com.text(com, xx))), Eq.and.left(Laws.abnf.ws(w1),
        Bool.and(Laws.g.ok.val(kv, Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))), hx), aq.nb.kv(kv,
          String.append(w2, Laws.g.com.text(com, xx)), Eq.and.left(Laws.g.ok.val(kv, Laws.RKeyval{}),
            Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com)), Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.g.ok.val(kv,
              Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))), hx))))
    case Laws.GxTable{+w1, +tb, +w2, +com}:
      ap.nb.ws(w1, Laws.g.table.text(tb, String.append(w2, Laws.g.com.text(com, xx))), Eq.and.left(Laws.abnf.ws(w1),
        Bool.and(Laws.g.ok.table(tb), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))), hx), ap.nb.tb(tb,
          String.append(w2, Laws.g.com.text(com, xx))))

def Laws.text_reads_as_replay(d, ok, es):
  match d:
    case Laws.GToml{+first, +rest}:
