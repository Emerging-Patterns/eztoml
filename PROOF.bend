            he})) : T.Doc}, Eq.and.left(Laws.g.ok.val(Laws.GvBoolean{_a0}, Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w2),
              Laws.g.ok.com(com)), Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.g.ok.val(Laws.GvBoolean{_a0},
                Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))), hx)))
    case Laws.GvArrayEmpty{_a0}:
