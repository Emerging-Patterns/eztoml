        Nat.is_lt(_d, 0n), True{}, Equal.sym(Bool, Nat.is_lt(_d, 0n), False{}, nlt.zero(_d)), hd))
    case 0n 1n+(+k1):
      lt.add(cn, rn, Nat.mul(k1, rn), hc)
    case 1n+(+d1) 1n+(+k1):
      %Equal.sym(Nat, Nat.add(Nat.add(rn, Nat.mul(d1, rn)), cn), Nat.add(rn, Nat.add(Nat.mul(d1, rn), cn)),
        Ar.nat_add_assoc(rn, Nat.mul(d1, rn), cn)) : {Nat.is_lt(_, Nat.add(rn, Nat.mul(k1, rn))) == True{} : Bool}
      Equal.trans(Bool, Nat.is_lt(Nat.add(rn, Nat.add(Nat.mul(d1, rn), cn)), Nat.add(rn, Nat.mul(k1, rn))),
        Nat.is_lt(Nat.add(Nat.mul(d1, rn), cn), Nat.mul(k1, rn)), True{}, Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx),
        Nat.cmp(Nat.add(rn, Nat.add(Nat.mul(d1, rn), cn)), Nat.add(rn, Nat.mul(k1, rn))), Nat.cmp(Nat.add(Nat.mul(d1,
        rn), cn), Nat.mul(k1, rn)), n1.cmp.add(rn, Nat.add(Nat.mul(d1, rn), cn), Nat.mul(k1, rn))), n1.dig.bd(d1, k1,
        rn, cn, hd, hc))

# ten times a radix's base
def n1.rb10(rx: Laws.ARadix) -> U32:
  match rx:
    case Laws.AHex{}:
      160
    case Laws.AOct{}:
      80
    case Laws.ABin{}:
      20

# what ten times a radix's base counts
def n1.rb10.n(rx: Laws.ARadix) -> {U32.to_nat(n1.rb10(rx)) == Nat.mul(U32.to_nat(n1.rb(rx)), 10n) : Nat}:
  match rx:
    case Laws.AHex{}:
      {==}
    case Laws.AOct{}:
      {==}
    case Laws.ABin{}:
      {==}

# and it is at most 256
def n1.rb.k(rx: Laws.ARadix) -> {Nat.is_le(Nat.mul(10n, U32.to_nat(n1.rb(rx))), 256n) == True{} : Bool}:
  match rx:
    case Laws.AHex{}:
      {==}
    case Laws.AOct{}:
      {==}
    case Laws.ABin{}:
      {==}

# a base is at most 100
def n1.rb.h(rx: Laws.ARadix) -> {Nat.is_le(U32.to_nat(n1.rb(rx)), 100n) == True{} : Bool}:
  match rx:
    case Laws.AHex{}:
      {==}
    case Laws.AOct{}:
      {==}
    case Laws.ABin{}:
      {==}

# a digit below ten times a base counts the digit times the base
def n1.mR(
  rx: Laws.ARadix,
  +dd: U32,
  +hd: {U32.is_lt(dd, 10) == True{} : Bool}
) -> {U32.to_nat(U32.mul(dd, n1.rb(rx))) == Nat.mul(U32.to_nat(dd), U32.to_nat(n1.rb(rx))) : Nat}:
  match rx:
    case Laws.AHex{}:
      sm.elim(zz => {U32.to_nat(U32.mul(zz, 16)) == Nat.mul(U32.to_nat(zz), 16n) : Nat}, dd, hd, {==}, {==}, {==},
        {==}, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.AOct{}:
      sm.elim(zz => {U32.to_nat(U32.mul(zz, 8)) == Nat.mul(U32.to_nat(zz), 8n) : Nat}, dd, hd, {==}, {==}, {==},
        {==}, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.ABin{}:
      sm.elim(zz => {U32.to_nat(U32.mul(zz, 2)) == Nat.mul(U32.to_nat(zz), 2n) : Nat}, dd, hd, {==}, {==}, {==},
        {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a U32 comparison below, as Nats
def n1.ul(
  +aa: U32,
  +bb: U32,
  +hh: {U32.is_lt(aa, bb) == True{} : Bool}
