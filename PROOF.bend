  Laws.g.val(Laws.GvInteger{'0' <> 'x' <> c2 <> rest}, vv)) == Bool.and(Laws.prose.radix_in_range(Laws.AHex{},
  '0' <> 'x' <> c2 <> rest), n1.gi(vv, T.Plus{}, c2 <> rest, 16n)) : Bool}:
