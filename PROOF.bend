  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool
) -> T.St:
  sip.S(bd, rw, hs, he, pt, bf, T.LKeyQ{}, bk, T.QLit{}, sk, un, lf, at)

# the mode r1.kql.ch reads its text from
def r1.kql.chM(
  +qq: Bool,
  +cr: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
