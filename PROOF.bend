    Nat.mul(vv, Nat.mul(10n, rr)), Ar.nat_mul_assoc(vv, 10n, rr)))))

# dec.go multiplies what digits below ten count by the base and adds a carry
# below the base
def n1.Wgo(
  +uu: Unit,
  ds: List<&2, U32>,
  +rx: Laws.ARadix,
  +cc: U32,
  +hd: {n1.d10(ds) == True{} : Bool},
  +hc: {U32.is_lt(cc, n1.rb(rx)) == True{} : Bool}
) -> {n1.W(T.dec.go(ds, n1.rb(rx), cc)) == Nat.add(Nat.mul(n1.W(ds), U32.to_nat(n1.rb(rx))), U32.to_nat(cc)) : Nat}:
  match ds:
    case []:
      n1.carry.a(U32.is_zero(cc), cc, {==}, n1.c100(rx, cc, hc))
    case +dd <> +tt:
      +hdd = {Eq.and.left(U32.is_lt(dd, 10), n1.d10(tt), hd) : {U32.is_lt(dd, 10) == True{} : Bool}}
      +hdt = {Eq.and.right(U32.is_lt(dd, 10), n1.d10(tt), hd) : {n1.d10(tt) == True{} : Bool}}
      +xx = U32.add(U32.mul(dd, n1.rb(rx)), cc)
      %Equal.sym(Nat, n1.W(T.dec.go(tt, n1.rb(rx), U32.div(xx, 10))), Nat.add(Nat.mul(n1.W(tt), U32.to_nat(n1.rb(rx))),
        U32.to_nat(U32.div(xx, 10))), n1.Wgo(uu, tt, rx, U32.div(xx, 10), hdt, n1.rs.q(uu, rx, dd, cc, hdd, hc))) :
        {Nat.add(Nat.mul(_, 10n), U32.to_nat(U32.mod(xx, 10))) == Nat.add(Nat.mul(Nat.add(Nat.mul(n1.W(tt), 10n),
        U32.to_nat(dd)), U32.to_nat(n1.rb(rx))), U32.to_nat(cc)) : Nat}
      n1.alg(n1.W(tt), U32.to_nat(n1.rb(rx)), U32.to_nat(U32.div(xx, 10)), U32.to_nat(U32.mod(xx, 10)),
        U32.to_nat(dd), U32.to_nat(cc), n1.rs.v(uu, rx, dd, cc, hdd, hc))

# and leaves digits below ten
def n1.Wok(
  +uu: Unit,
  ds: List<&2, U32>,
  +rx: Laws.ARadix,
  +cc: U32,
  +hd: {n1.d10(ds) == True{} : Bool},
  +hc: {U32.is_lt(cc, n1.rb(rx)) == True{} : Bool}
) -> {n1.d10(T.dec.go(ds, n1.rb(rx), cc)) == True{} : Bool}:
  match ds:
    case []:
      n1.carry.oka(U32.is_zero(cc), cc, n1.c100(rx, cc, hc))
    case +dd <> +tt:
      +hdd = {Eq.and.left(U32.is_lt(dd, 10), n1.d10(tt), hd) : {U32.is_lt(dd, 10) == True{} : Bool}}
      +hdt = {Eq.and.right(U32.is_lt(dd, 10), n1.d10(tt), hd) : {n1.d10(tt) == True{} : Bool}}
      +xx = U32.add(U32.mul(dd, n1.rb(rx)), cc)
      and.tt(U32.is_lt(U32.mod(xx, 10), 10), n1.d10(T.dec.go(tt, n1.rb(rx), U32.div(xx, 10))), md(xx), n1.Wok(uu, tt,
        rx, U32.div(xx, 10), hdt, n1.rs.q(uu, rx, dd, cc, hdd, hc)))

# whether every character is a DIGIT
def n1.lall(cs: List<&2, Char>) -> Bool:
  match cs:
    case []:
      True{}
    case hh <> tt:
      Bool.and(Laws.abnf.DIGIT(hh), n1.lall(tt))

# a digit below ten is written as a DIGIT
def n1.dch.d(+dd: U32, +hd: {U32.is_lt(dd, 10) == True{} : Bool}) -> {Laws.abnf.DIGIT(T.dec.ch(dd)) == True{} : Bool}:
  sm.elim(zz => {Laws.abnf.DIGIT(T.dec.ch(zz)) == True{} : Bool}, dd, hd, {==}, {==}, {==}, {==}, {==}, {==}, {==},
    {==}, {==}, {==})

# digits below ten are written as DIGITs
def n1.dall.ch(ds: List<&2, U32>, +hd: {n1.d10(ds) == True{} : Bool}) -> {n1.lall(T.dec.chars(ds)) == True{} : Bool}:
  match ds:
    case []:
      {==}
    case +dd <> +tt:
      and.tt(Laws.abnf.DIGIT(T.dec.ch(dd)), n1.lall(T.dec.chars(tt)), n1.dch.d(dd, Eq.and.left(U32.is_lt(dd, 10),
        n1.d10(tt), hd)), n1.dall.ch(tt, Eq.and.right(U32.is_lt(dd, 10), n1.d10(tt), hd)))

# reversed onto digits below ten, digits below ten stay so
def n1.d10.rev(
  ds: List<&2, U32>,
  +acc: List<&2, U32>,
  +hd: {n1.d10(ds) == True{} : Bool},
  +ha: {n1.d10(acc) == True{} : Bool}
) -> {n1.d10(List.reverse.go(&2, U32, ds, acc)) == True{} : Bool}:
  match ds:
    case []:
      ha
    case +dd <> +tt:
      n1.d10.rev(tt, dd <> acc, Eq.and.right(U32.is_lt(dd, 10), n1.d10(tt), hd), and.tt(U32.is_lt(dd, 10),
        n1.d10(acc), Eq.and.left(U32.is_lt(dd, 10), n1.d10(tt), hd), ha))

# DIGITs make a string of DIGITs
def n1.lall.fl(
  cs: List<&2, Char>,
  +hc: {n1.lall(cs) == True{} : Bool}
) -> {Laws.g.dec.all(String.from_list(cs)) == True{} : Bool}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      and.tt(Laws.abnf.DIGIT(hh), Laws.g.dec.all(String.from_list(tt)), Eq.and.left(Laws.abnf.DIGIT(hh),
        n1.lall(tt), hc), n1.lall.fl(tt, Eq.and.right(Laws.abnf.DIGIT(hh), n1.lall(tt), hc)))

# a DIGIT that is not 0 is a digit1-9
def n1.nzd(
  +cc: Char,
  +hd: {Laws.abnf.DIGIT(cc) == True{} : Bool},
  +hz: {Char.is_eq(cc, '0') == False{} : Bool}
) -> {Laws.abnf.digit1_9(cc) == True{} : Bool}:
  dg.elim(zz => {Char.is_eq(zz, '0') == False{} : Bool} -> {Laws.abnf.digit1_9(zz) == True{} : Bool}, cc,
    gs.dig(cc, hd), ee => Eq.bit.absurd2(&2, {Laws.abnf.digit1_9('0') == True{} : Bool}, ee), _e => {==}, _e => {==},
    _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==})(hz)

# a character that is not 0, then DIGITs, is canonical
def n1.nzc(
  +hh: Char,
  +tt: List<&2, Char>,
  +hd: {Laws.abnf.DIGIT(hh) == True{} : Bool},
  +hz: {Char.is_eq(hh, '0') == False{} : Bool},
  +ht: {n1.lall(tt) == True{} : Bool}
) -> {Laws.g.dec.canon(String.from_list(hh <> tt)) == True{} : Bool}:
  %Equal.sym(Bool, Laws.abnf.DIGIT(hh), True{}, hd) : {Bool.and(_, Bool.or(Bool.and(Laws.abnf.cp(hh, 48),
    String.is_empty(String.from_list(tt))), Bool.and(Laws.abnf.digit1_9(hh), Laws.g.dec.all(String.from_list(tt)))))
    == True{} : Bool}
  %Equal.sym(Bool, Laws.abnf.cp(hh, 48), False{}, Equal.trans(Bool, Laws.abnf.cp(hh, 48), Char.is_eq(hh, '0'),
    False{}, Equal.sym(Bool, Char.is_eq(hh, Chr{48}), Laws.abnf.cp(hh, 48), n1.cp(hh, 48)), hz)) :
    {Bool.and(True{}, Bool.or(Bool.and(_, String.is_empty(String.from_list(tt))), Bool.and(Laws.abnf.digit1_9(hh),
    Laws.g.dec.all(String.from_list(tt))))) == True{} : Bool}
  %Equal.sym(Bool, Laws.abnf.digit1_9(hh), True{}, n1.nzd(hh, hd, hz)) : {Bool.and(True{}, Bool.or(Bool.and(False{},
    String.is_empty(String.from_list(tt))), Bool.and(_, Laws.g.dec.all(String.from_list(tt))))) == True{} : Bool}
  n1.lall.fl(tt, ht)

# after the first character, with dec.drop's lead: a 0 is dropped, and any
# other DIGIT starts the canonical numeral
def n1.drop.go.c(
  zz: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +ez: {Char.is_eq(hh, '0') == zz : Bool},
  +hd: {Laws.abnf.DIGIT(hh) == True{} : Bool},
  +ht: {n1.lall(tt) == True{} : Bool},
  +ih: {Laws.g.dec.canon(T.dec.drop(tt, True{}, [])) == True{} : Bool}
) -> {Laws.g.dec.canon(T.dec.drop(tt, zz, T.dec.drop.outz(zz, hh, []))) == True{} : Bool}:
  match zz:
    case True{}:
      ih
    case False{}:
      %Equal.sym(String, T.dec.drop(tt, False{}, [hh]), String.from_list(hh <> tt), dd.kept(tt, [hh])) :
        {Laws.g.dec.canon(_) == True{} : Bool}
      n1.nzc(hh, tt, hd, ez, ht)

# dec.drop of DIGITs from the lead is canonical
def n1.drop.c(
  cs: List<&2, Char>,
  +hc: {n1.lall(cs) == True{} : Bool}
) -> {Laws.g.dec.canon(T.dec.drop(cs, True{}, [])) == True{} : Bool}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      +ht = {Eq.and.right(Laws.abnf.DIGIT(hh), n1.lall(tt), hc) : {n1.lall(tt) == True{} : Bool}}
      n1.drop.go.c(Char.is_eq(hh, '0'), hh, tt, {==}, Eq.and.left(Laws.abnf.DIGIT(hh), n1.lall(tt), hc), ht,
        n1.drop.c(tt, ht))

# and worth what the DIGITs are
def n1.drop.go.v(
  zz: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +ez: {Char.is_eq(hh, '0') == zz : Bool},
  +ih: {n1.h10(T.dec.drop(tt, True{}, [])) == Laws.g.num.nat(tt, 10n, 0n) : Nat}
) -> {n1.h10(T.dec.drop(tt, zz, T.dec.drop.outz(zz, hh, []))) == Laws.g.num.nat(hh <> tt, 10n, 0n) : Nat}:
  match zz:
    case True{}:
      %Equal.sym(Char, hh, '0', Eq.char_eq_true(hh, '0', ez)) : {n1.h10(T.dec.drop(tt, True{}, [])) ==
        Laws.g.num.nat(_ <> tt, 10n, 0n) : Nat}
      ih
    case False{}:
      %Equal.sym(String, T.dec.drop(tt, False{}, [hh]), String.from_list(hh <> tt), dd.kept(tt, [hh])) :
        {n1.h10(_) == Laws.g.num.nat(hh <> tt, 10n, 0n) : Nat}
      %Equal.sym(List<&2, Char>, String.to_list(String.from_list(tt)), tt, gd.tlfl(tt)) : {Laws.g.num.nat(hh <> _,
        10n, 0n) == Laws.g.num.nat(hh <> tt, 10n, 0n) : Nat}
      {==}

# dec.drop of DIGITs from the lead is worth what they are
def n1.drop.v(cs: List<&2, Char>) -> {n1.h10(T.dec.drop(cs, True{}, [])) == Laws.g.num.nat(cs, 10n, 0n) : Nat}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      n1.drop.go.v(Char.is_eq(hh, '0'), hh, tt, {==}, n1.drop.v(tt))

# dec.text of digits below ten is canonical
def n1.text.c(
  +ds: List<&2, U32>,
  +hd: {n1.d10(ds) == True{} : Bool}
) -> {Laws.g.dec.canon(T.dec.text(ds)) == True{} : Bool}:
  n1.drop.c(T.dec.chars(List.reverse(&2, U32, ds)), n1.dall.ch(List.reverse(&2, U32, ds), n1.d10.rev(ds, [], hd,
    {==})))

# and worth what they count
def n1.text.v(+ds: List<&2, U32>, +hd: {n1.d10(ds) == True{} : Bool}) -> {n1.h10(T.dec.text(ds)) == n1.W(ds) : Nat}:
  Equal.trans(Nat, n1.h10(T.dec.text(ds)), n1.V(ds), n1.W(ds), n1.drop.v(T.dec.chars(List.reverse(&2, U32, ds))),
    n1.VW(ds, hd))

# The prefixed integer's numeral. After the prefix the scan reads each digit
# of the radix into the numeral with dec.go and passes over each underscore;
# n1.cv is that reading, and it counts the digits' value in the radix.

# one character of the reading: an underscore is passed over, and a digit
# goes into the numeral
def n1.cv.s(uu: Bool, +rx: Laws.ARadix, +hh: Char, ds: List<&2, U32>) -> List<&2, U32>:
  match uu:
    case True{}:
      ds
    case False{}:
      T.dec.go(ds, n1.rb(rx), T.dig.val(hh))

# the numeral the scan reads from a prefixed integer's digits
def n1.cv(+rx: Laws.ARadix, xs: List<&2, Char>, ds: List<&2, U32>) -> List<&2, U32>:
  match xs:
    case []:
      ds
    case +hh <> tt:
      n1.cv(rx, tt, n1.cv.s(Char.is_eq(hh, '_'), rx, hh, ds))

# the type of n1.Bv.go's ihd
def n1.Bv.go.P1(+cc: Char, +tt: List<&2, Char>, +sg: T.Sign, +rx: Laws.ARadix, +ds: List<&2, U32>) -> Type:
  {Laws.abnf.radix_rep(tt, rx) == True{} : Bool} -> {T.num.go(tt, n1.sb(sg, rx, T.dec.go(ds, n1.rb(rx),
    T.dig.val(cc)))) == n1.sb(sg, rx, n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(cc)))) : T.Num}

# the type of n1.Bv.go's ihu
def n1.Bv.go.P2(+tt: List<&2, Char>, +sg: T.Sign, +rx: Laws.ARadix, +ds: List<&2, U32>) -> Type:
  {n1.bg(tt, rx) == True{} : Bool} -> {T.num.go(tt, T.Num{T.NBase{}, sg, n1.rb(rx), ds, True{}, True{},
    ""}) == n1.sb(sg, rx, n1.cv(rx, tt, ds)) : T.Num}

# the character after a digit of a prefixed integer that is the radix's
# repetition: an underscore goes on to a digit, and a digit goes into the
# numeral
def n1.Bv.go(
  uu: Bool,
  ok: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +eu: {Char.is_eq(cc, '_') == uu : Bool},
  +eo: {T.dig.ok(T.dig.val(cc), n1.rb(rx)) == ok : Bool},
  +hr: {Laws.abnf.radix_rep(cc <> tt, rx) == True{} : Bool},
  ihd: n1.Bv.go.P1(cc, tt, sg, rx, ds),
  ihu: n1.Bv.go.P2(tt, sg, rx, ds)
) -> {T.num.go(tt, T.num.based.go(uu, n1.sb(sg, rx, ds), cc)) == n1.sb(sg, rx, n1.cv(rx, tt, n1.cv.s(uu, rx, cc, ds)))
  : T.Num}:
  match uu:
    case True{}:
      ihu(Equal.trans(Bool, n1.bg(tt, rx), Laws.abnf.radix_rep('_' <> tt, rx), True{}, n1.rrep.u(rx, tt),
        Equal.trans(Bool, Laws.abnf.radix_rep('_' <> tt, rx), Laws.abnf.radix_rep(cc <> tt, rx), True{},
        Equal.cong(Char, Bool, xx => Laws.abnf.radix_rep(xx <> tt, rx), '_', cc, Equal.sym(Char, cc, '_',
        Eq.char_eq_true(cc, '_', eu))), hr)))
    case False{}:
      match ok:
        case True{}:
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), n1.rb(rx)), True{}, eo) : {T.num.go(tt, T.num.digit.ok(_, cc,
            T.NBase{}, sg, n1.rb(rx), ds)) == n1.sb(sg, rx, n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(cc))))
            : T.Num}
          ihd(Equal.trans(Bool, Laws.abnf.radix_rep(tt, rx), Laws.abnf.radix_rep(cc <> tt, rx), True{},
            n1.rrep.d(rx, cc, tt, n1.cls.t(rx, cc, eo)), hr))
        case False{}:
          Eq.bit.absurd(&2, {T.num.go(tt, T.num.based.go(False{}, n1.sb(sg, rx, ds), cc)) == n1.sb(sg, rx, n1.cv(rx,
            tt, n1.cv.s(False{}, rx, cc, ds))) : T.Num}, Equal.trans(Bool, False{}, Laws.abnf.radix_rep(cc <> tt,
            rx), True{}, n1.rrep.n(rx, cc, tt, n1.cls.f(rx, cc, eo), eu), hr))

# the type of n1.Buv.go's ih
def n1.Buv.go.P1(+cc: Char, +tt: List<&2, Char>, +sg: T.Sign, +rx: Laws.ARadix, +ds: List<&2, U32>) -> Type:
  {Laws.abnf.radix_rep(tt, rx) == True{} : Bool} -> {T.num.go(tt, n1.sb(sg, rx, T.dec.go(ds, n1.rb(rx),
    T.dig.val(cc)))) == n1.sb(sg, rx, n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(cc)))) : T.Num}

# a prefixed integer's state where an underscore fails, before a digit of
# the radix and the repetition: the digit goes into the numeral
def n1.Buv.go(
  uu: Bool,
  ok: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +eu: {Char.is_eq(cc, '_') == uu : Bool},
  +eo: {T.dig.ok(T.dig.val(cc), n1.rb(rx)) == ok : Bool},
  +hr: {n1.bg(cc <> tt, rx) == True{} : Bool},
  ih: n1.Buv.go.P1(cc, tt, sg, rx, ds)
) -> {T.num.go(tt, T.num.based.go(uu, T.Num{T.NBase{}, sg, n1.rb(rx), ds, us, saw, why}, cc)) == n1.sb(sg, rx,
  n1.cv(rx, tt, n1.cv.s(uu, rx, cc, ds))) : T.Num}:
  match uu:
    case True{}:
      Eq.bit.absurd(&2, {T.num.go(tt, T.num.based.go(True{}, T.Num{T.NBase{}, sg, n1.rb(rx), ds, us, saw, why}, cc))
        == n1.sb(sg, rx, n1.cv(rx, tt, n1.cv.s(True{}, rx, cc, ds))) : T.Num}, Equal.trans(Bool, False{},
        Laws.abnf.radix_digit(rx, cc), True{}, Equal.trans(Bool, False{}, Laws.abnf.radix_digit(rx, '_'),
        Laws.abnf.radix_digit(rx, cc), Equal.sym(Bool, Laws.abnf.radix_digit(rx, '_'), False{}, n1.rd.us(rx)),
        Equal.cong(Char, Bool, xx => Laws.abnf.radix_digit(rx, xx), '_', cc, Equal.sym(Char, cc, '_',
        Eq.char_eq_true(cc, '_', eu)))), Eq.and.left(Laws.abnf.radix_digit(rx, cc), Laws.abnf.radix_rep(tt, rx), hr)))
    case False{}:
      match ok:
        case True{}:
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), n1.rb(rx)), True{}, eo) : {T.num.go(tt, T.num.digit.ok(_, cc,
            T.NBase{}, sg, n1.rb(rx), ds)) == n1.sb(sg, rx, n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(cc))))
            : T.Num}
          ih(Eq.and.right(Laws.abnf.radix_digit(rx, cc), Laws.abnf.radix_rep(tt, rx), hr))
        case False{}:
          Eq.bit.absurd(&2, {T.num.go(tt, T.num.based.go(False{}, T.Num{T.NBase{}, sg, n1.rb(rx), ds, us, saw, why},
            cc)) == n1.sb(sg, rx, n1.cv(rx, tt, n1.cv.s(False{}, rx, cc, ds))) : T.Num}, Equal.trans(Bool, False{},
            Laws.abnf.radix_digit(rx, cc), True{}, Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), False{},
            n1.cls.f(rx, cc, eo)), Eq.and.left(Laws.abnf.radix_digit(rx, cc), Laws.abnf.radix_rep(tt, rx), hr)))

# the type of n1.Buv's ih
def n1.Buv.P1(+cc: Char, +tt: List<&2, Char>, +sg: T.Sign, +rx: Laws.ARadix, +ds: List<&2, U32>) -> Type:
  {Laws.abnf.radix_rep(tt, rx) == True{} : Bool} -> {T.num.go(tt, n1.sb(sg, rx, T.dec.go(ds, n1.rb(rx),
    T.dig.val(cc)))) == n1.sb(sg, rx, n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(cc)))) : T.Num}

# with a character and the rest
def n1.Buv(
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +hr: {n1.bg(cc <> tt, rx) == True{} : Bool},
  ih: n1.Buv.P1(cc, tt, sg, rx, ds)
) -> {T.num.go(cc <> tt, T.Num{T.NBase{}, sg, n1.rb(rx), ds, us, saw, why}) == n1.sb(sg, rx, n1.cv(rx, cc <> tt, ds))
  : T.Num}:
  n1.Buv.go(Char.is_eq(cc, '_'), T.dig.ok(T.dig.val(cc), n1.rb(rx)), cc, tt, sg, rx, ds, us, saw, why, {==}, {==}, hr,
    ih)

# after a digit of a prefixed integer, the radix's repetition is read into
# the numeral
def n1.Bv(
  rest: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +hr: {Laws.abnf.radix_rep(rest, rx) == True{} : Bool}
) -> {T.num.go(rest, n1.sb(sg, rx, ds)) == n1.sb(sg, rx, n1.cv(rx, rest, ds)) : T.Num}:
  match rest:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          n1.Bv.go(Char.is_eq(hh, '_'), T.dig.ok(T.dig.val(hh), n1.rb(rx)), hh, [], sg, rx, ds, {==}, {==}, hr,
            _h => {==}, hb => Eq.bit.absurd(&2, {T.num.go([], T.Num{T.NBase{}, sg, n1.rb(rx), ds, True{}, True{}, ""})
            == n1.sb(sg, rx, n1.cv(rx, [], ds)) : T.Num}, hb))
        case +h2 <> +t2:
          n1.Bv.go(Char.is_eq(hh, '_'), T.dig.ok(T.dig.val(hh), n1.rb(rx)), hh, h2 <> t2, sg, rx, ds, {==}, {==}, hr,
            hd => n1.Bv(h2 <> t2, sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(hh)), hd), hb => n1.Buv(h2, t2, sg, rx,
            ds, True{}, True{}, "", hb, h3 => n1.Bv(t2, sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(h2)), h3)))

# after a prefix, a digit of the radix and the repetition are read into the
# numeral
def n1.B0v(
  rest: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +hr: {n1.bg(rest, rx) == True{} : Bool}
) -> {T.num.go(rest, T.Num{T.NBase{}, sg, n1.rb(rx), [], False{}, False{}, ""}) == n1.sb(sg, rx, n1.cv(rx, rest, []))
  : T.Num}:
  match rest:
    case []:
      Eq.bit.absurd(&2, {T.num.go([], T.Num{T.NBase{}, sg, n1.rb(rx), [], False{}, False{}, ""}) == n1.sb(sg, rx,
        n1.cv(rx, [], [])) : T.Num}, hr)
    case +hh <> +tt:
      n1.Buv(hh, tt, sg, rx, [], False{}, False{}, "", hr, hd => n1.Bv(tt, sg, rx, T.dec.go([], n1.rb(rx),
        T.dig.val(hh)), hd))

# whether each character is an underscore or a digit of the radix
def n1.rr(+rx: Laws.ARadix, xs: List<&2, Char>) -> Bool:
  match xs:
    case []:
      True{}
    case +hh <> tt:
      Bool.and(Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt))

# an or with True on its right is True
def n1.or.t(aa: Bool) -> {Bool.or(aa, True{}) == True{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      {==}

# a character of the repetition, by whether it is an underscore or a digit
def n1.rr.go(
  uu: Bool,
  dd: Bool,
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +rx: Laws.ARadix,
  +eu: {Char.is_eq(hh, '_') == uu : Bool},
  +ed: {Laws.abnf.radix_digit(rx, hh) == dd : Bool},
  +hr: {Laws.abnf.radix_rep(hh <> h2 <> t2, rx) == True{} : Bool},
  i1: {Laws.abnf.radix_rep(h2 <> t2, rx) == True{} : Bool} -> {n1.rr(rx, h2 <> t2) == True{} : Bool},
  i2: {Laws.abnf.radix_rep(t2, rx) == True{} : Bool} -> {n1.rr(rx, t2) == True{} : Bool}
) -> {n1.rr(rx, hh <> h2 <> t2) == True{} : Bool}:
  match uu:
    case True{}:
      +hb = {Equal.trans(Bool, n1.bg(h2 <> t2, rx), Laws.abnf.radix_rep('_' <> h2 <> t2, rx), True{},
        n1.rrep.u(rx, h2 <> t2), Equal.trans(Bool, Laws.abnf.radix_rep('_' <> h2 <> t2, rx),
        Laws.abnf.radix_rep(hh <> h2 <> t2, rx), True{}, Equal.cong(Char, Bool, xx => Laws.abnf.radix_rep(xx <> h2 <>
        t2, rx), '_', hh, Equal.sym(Char, hh, '_', Eq.char_eq_true(hh, '_', eu))), hr)) : {n1.bg(h2 <> t2, rx)
        == True{} : Bool}}
      %Equal.sym(Bool, Char.is_eq(hh, '_'), True{}, eu) : {Bool.and(Bool.or(_, Laws.abnf.radix_digit(rx, hh)),
        n1.rr(rx, h2 <> t2)) == True{} : Bool}
      %Equal.sym(Bool, Laws.abnf.radix_digit(rx, h2), True{}, Eq.and.left(Laws.abnf.radix_digit(rx, h2),
        Laws.abnf.radix_rep(t2, rx), hb)) : {Bool.and(Bool.or(True{}, Laws.abnf.radix_digit(rx, hh)),
        Bool.and(Bool.or(Char.is_eq(h2, '_'), _), n1.rr(rx, t2))) == True{} : Bool}
      %Equal.sym(Bool, Bool.or(Char.is_eq(h2, '_'), True{}), True{}, n1.or.t(Char.is_eq(h2, '_'))) :
        {Bool.and(True{}, Bool.and(_, n1.rr(rx, t2))) == True{} : Bool}
      i2(Eq.and.right(Laws.abnf.radix_digit(rx, h2), Laws.abnf.radix_rep(t2, rx), hb))
    case False{}:
      match dd:
        case True{}:
          %Equal.sym(Bool, Char.is_eq(hh, '_'), False{}, eu) : {Bool.and(Bool.or(_, Laws.abnf.radix_digit(rx, hh)),
            n1.rr(rx, h2 <> t2)) == True{} : Bool}
          %Equal.sym(Bool, Laws.abnf.radix_digit(rx, hh), True{}, ed) : {Bool.and(Bool.or(False{}, _),
            n1.rr(rx, h2 <> t2)) == True{} : Bool}
          %Equal.sym(Bool, n1.rr(rx, h2 <> t2), True{}, i1(Equal.trans(Bool, Laws.abnf.radix_rep(h2 <> t2, rx),
            Laws.abnf.radix_rep(hh <> h2 <> t2, rx), True{}, n1.rrep.d(rx, hh, h2 <> t2, ed), hr))) :
            {Bool.and(Bool.or(False{}, True{}), _) == True{} : Bool}
          {==}
        case False{}:
          Eq.bit.absurd(&2, {n1.rr(rx, hh <> h2 <> t2) == True{} : Bool}, Equal.trans(Bool, False{},
            Laws.abnf.radix_rep(hh <> h2 <> t2, rx), True{}, n1.rrep.n(rx, hh, h2 <> t2, ed, eu), hr))

# the radix's repetition is underscores and digits of the radix
def n1.rr.rep(
  xs: List<&2, Char>,
  +rx: Laws.ARadix,
  +hr: {Laws.abnf.radix_rep(xs, rx) == True{} : Bool}
) -> {n1.rr(rx, xs) == True{} : Bool}:
  match xs:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          %Equal.sym(Bool, Laws.abnf.radix_digit(rx, hh), True{}, hr) : {Bool.and(Bool.or(Char.is_eq(hh, '_'), _),
            True{}) == True{} : Bool}
          %Equal.sym(Bool, Bool.or(Char.is_eq(hh, '_'), True{}), True{}, n1.or.t(Char.is_eq(hh, '_'))) :
            {Bool.and(_, True{}) == True{} : Bool}
          {==}
        case +h2 <> +t2:
          n1.rr.go(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh), hh, h2, t2, rx, {==}, {==}, hr,
            h1 => n1.rr.rep(h2 <> t2, rx, h1), h3 => n1.rr.rep(t2, rx, h3))

# and so is a digit of the radix and the repetition
def n1.rr.bg(
  xs: List<&2, Char>,
  +rx: Laws.ARadix,
  +hb: {n1.bg(xs, rx) == True{} : Bool}
) -> {n1.rr(rx, xs) == True{} : Bool}:
  match xs:
    case []:
      Eq.bit.absurd(&2, {n1.rr(rx, []) == True{} : Bool}, hb)
    case +hh <> +tt:
      %Equal.sym(Bool, Laws.abnf.radix_digit(rx, hh), True{}, Eq.and.left(Laws.abnf.radix_digit(rx, hh),
        Laws.abnf.radix_rep(tt, rx), hb)) : {Bool.and(Bool.or(Char.is_eq(hh, '_'), _), n1.rr(rx, tt)) == True{}
        : Bool}
      %Equal.sym(Bool, Bool.or(Char.is_eq(hh, '_'), True{}), True{}, n1.or.t(Char.is_eq(hh, '_'))) :
        {Bool.and(_, n1.rr(rx, tt)) == True{} : Bool}
      n1.rr.rep(tt, rx, Eq.and.right(Laws.abnf.radix_digit(rx, hh), Laws.abnf.radix_rep(tt, rx), hb))

# a character that is no underscore, of the underscores and digits, is a
# digit of the radix
def n1.rr.d(
  +hh: Char,
  +rx: Laws.ARadix,
  +eu: {Char.is_eq(hh, '_') == False{} : Bool},
  +ho: {Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)) == True{} : Bool}
) -> {Laws.abnf.radix_digit(rx, hh) == True{} : Bool}:
  Equal.trans(Bool, Laws.abnf.radix_digit(rx, hh), Bool.or(False{}, Laws.abnf.radix_digit(rx, hh)), True{}, {==},
    Equal.trans(Bool, Bool.or(False{}, Laws.abnf.radix_digit(rx, hh)), Bool.or(Char.is_eq(hh, '_'),
    Laws.abnf.radix_digit(rx, hh)), True{}, Equal.cong(Bool, Bool, bb => Bool.or(bb, Laws.abnf.radix_digit(rx,
    hh)), False{}, Char.is_eq(hh, '_'), Equal.sym(Bool, Char.is_eq(hh, '_'), False{}, eu)), ho))

# what cvW claims of the rest, from a numeral es
def n1.cvW.go.P1(+rx: Laws.ARadix, +tt: List<&2, Char>, +es: List<&2, U32>) -> Type:
  {n1.d10(es) == True{} : Bool} -> {n1.W(n1.cv(rx, tt, es)) == Laws.g.num.nat(tt, U32.to_nat(n1.rb(rx)), n1.W(es))
    : Nat}

# a character of the reading, by whether it is an underscore: its value goes
# on from what the numeral counts
def n1.cvW.go(
  uu: Bool,
  +vv: Unit,
  +rx: Laws.ARadix,
  +hh: Char,
  +tt: List<&2, Char>,
  +ds: List<&2, U32>,
  +eu: {Char.is_eq(hh, '_') == uu : Bool},
  +hd: {n1.d10(ds) == True{} : Bool},
  +ho: {Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)) == True{} : Bool},
  ih: @es:List<&2, U32> -> n1.cvW.go.P1(rx, tt, es)
) -> {n1.W(n1.cv(rx, tt, n1.cv.s(uu, rx, hh, ds))) == Laws.g.num.nat(tt, U32.to_nat(n1.rb(rx)),
  Laws.g.num.nat.step(Laws.abnf.underscore(hh), hh, U32.to_nat(n1.rb(rx)), n1.W(ds))) : Nat}:
  match uu:
    case True{}:
      %Equal.sym(Bool, Laws.abnf.underscore(hh), True{}, Equal.trans(Bool, Laws.abnf.underscore(hh),
        Char.is_eq(hh, '_'), True{}, Equal.sym(Bool, Char.is_eq(hh, '_'), Laws.abnf.underscore(hh), n1.us(hh)), eu)) :
        {n1.W(n1.cv(rx, tt, ds)) == Laws.g.num.nat(tt, U32.to_nat(n1.rb(rx)), Laws.g.num.nat.step(_, hh,
        U32.to_nat(n1.rb(rx)), n1.W(ds))) : Nat}
      ih(ds, hd)
    case False{}:
      +hr = {n1.rr.d(hh, rx, eu, ho) : {Laws.abnf.radix_digit(rx, hh) == True{} : Bool}}
      +hc = {Equal.trans(Bool, T.dig.ok(T.dig.val(hh), n1.rb(rx)), Laws.abnf.radix_digit(rx, hh), True{}, n1.cls(rx,
        hh), hr) : {U32.is_lt(T.dig.val(hh), n1.rb(rx)) == True{} : Bool}}
      %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, Equal.trans(Bool, Laws.abnf.underscore(hh),
        Char.is_eq(hh, '_'), False{}, Equal.sym(Bool, Char.is_eq(hh, '_'), Laws.abnf.underscore(hh), n1.us(hh)), eu)) :
        {n1.W(n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(hh)))) == Laws.g.num.nat(tt, U32.to_nat(n1.rb(rx)),
        Laws.g.num.nat.step(_, hh, U32.to_nat(n1.rb(rx)), n1.W(ds))) : Nat}
      %n1.dv(rx, hh, hr) : {n1.W(n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(hh)))) == Laws.g.num.nat(tt,
        U32.to_nat(n1.rb(rx)), Nat.add(Nat.mul(n1.W(ds), U32.to_nat(n1.rb(rx))), _)) : Nat}
      %n1.Wgo(vv, ds, rx, T.dig.val(hh), hd, hc) : {n1.W(n1.cv(rx, tt, T.dec.go(ds, n1.rb(rx), T.dig.val(hh))))
        == Laws.g.num.nat(tt, U32.to_nat(n1.rb(rx)), _) : Nat}
      ih(T.dec.go(ds, n1.rb(rx), T.dig.val(hh)), n1.Wok(vv, ds, rx, T.dig.val(hh), hd, hc))

# the reading counts the digits' value in the radix, after what the numeral
# counts
def n1.cvW(
  +vv: Unit,
  +rx: Laws.ARadix,
  xs: List<&2, Char>,
  +ds: List<&2, U32>,
  +hd: {n1.d10(ds) == True{} : Bool},
  +hx: {n1.rr(rx, xs) == True{} : Bool}
) -> {n1.W(n1.cv(rx, xs, ds)) == Laws.g.num.nat(xs, U32.to_nat(n1.rb(rx)), n1.W(ds)) : Nat}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      n1.cvW.go(Char.is_eq(hh, '_'), vv, rx, hh, tt, ds, {==}, hd, Eq.and.left(Bool.or(Char.is_eq(hh, '_'),
        Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx), es => he => n1.cvW(vv, rx, tt, es, he,
        Eq.and.right(Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx)))

# a character of the reading leaves digits below ten
def n1.cvok.go(
  uu: Bool,
  +vv: Unit,
  +rx: Laws.ARadix,
  +hh: Char,
  +tt: List<&2, Char>,
  +ds: List<&2, U32>,
  +eu: {Char.is_eq(hh, '_') == uu : Bool},
  +hd: {n1.d10(ds) == True{} : Bool},
  +ho: {Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)) == True{} : Bool},
  ih: @es:List<&2, U32> -> {n1.d10(es) == True{} : Bool} -> {n1.d10(n1.cv(rx, tt, es)) == True{} : Bool}
) -> {n1.d10(n1.cv(rx, tt, n1.cv.s(uu, rx, hh, ds))) == True{} : Bool}:
  match uu:
    case True{}:
      ih(ds, hd)
    case False{}:
      ih(T.dec.go(ds, n1.rb(rx), T.dig.val(hh)), n1.Wok(vv, ds, rx, T.dig.val(hh), hd, Equal.trans(Bool,
        T.dig.ok(T.dig.val(hh), n1.rb(rx)), Laws.abnf.radix_digit(rx, hh), True{}, n1.cls(rx, hh), n1.rr.d(hh, rx,
        eu, ho))))

# the reading is digits below ten
def n1.cvok(
  +vv: Unit,
  +rx: Laws.ARadix,
  xs: List<&2, Char>,
  +ds: List<&2, U32>,
  +hd: {n1.d10(ds) == True{} : Bool},
  +hx: {n1.rr(rx, xs) == True{} : Bool}
) -> {n1.d10(n1.cv(rx, xs, ds)) == True{} : Bool}:
  match xs:
    case []:
      hd
    case +hh <> +tt:
      n1.cvok.go(Char.is_eq(hh, '_'), vv, rx, hh, tt, ds, {==}, hd, Eq.and.left(Bool.or(Char.is_eq(hh, '_'),
        Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx), es => he => n1.cvok(vv, rx, tt, es, he,
        Eq.and.right(Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx)))

# The limits. 2^63 is 8 * 16^15, 8^21 and 2^63, and the checker would
# expand any of them, or the value of "9223372036854775808", to unary to
# compare it. So each is named behind a unit uu, and the digits of each are
# computed as small Nats: 8 multiplied by 16 fifteen times, 1 by 8 twenty-one
# times, 1 by 2 sixty-three times, least-significant digit first, and checked
# against the limit's characters.

# whether two Nats are equal
def n1.eqn(aa: Nat, bb: Nat, +hh: {Nat.is_eq(aa, bb) == True{} : Bool}) -> {aa == bb : Nat}:
  match aa bb:
    case 0n 0n:
      {==}
    case 0n 1n+_b:
      Eq.bit.absurd(&2, {0n == 1n+_b : Nat}, hh)
    case 1n+_a 0n:
      Eq.bit.absurd(&2, {1n+_a == 0n : Nat}, hh)
    case 1n+(+a1) 1n+(+b1):
      Equal.cong(Nat, Nat, nn => 1n+nn, a1, b1, n1.eqn(a1, b1, hh))

# one more than a quotient and remainder by ten: the remainder goes up, or
# after 9 the quotient does
def n1.dq.t(nine: Bool, qq: Nat, mm: Nat) -> Nat & Nat:
  match nine:
    case True{}:
      (1n+qq, 0n)
    case False{}:
      (qq, 1n+mm)

# one more than a quotient and remainder
def n1.dq.n(pr: Nat & Nat) -> Nat & Nat:
  match pr:
    case (+qq, +mm):
      n1.dq.t(Nat.is_eq(mm, 9n), qq, mm)

# a Nat's quotient and remainder by ten, counted up one at a time
def n1.dq(xx: Nat) -> Nat & Nat:
  match xx:
    case 0n:
      (0n, 0n)
    case 1n+pp:
      n1.dq.n(n1.dq(pp))

# the quotient of a pair
def n1.pq(pr: Nat & Nat) -> Nat:
  match pr:
    case (qq, _m):
      qq

# the remainder of a pair
def n1.pm(pr: Nat & Nat) -> Nat:
  match pr:
    case (_q, mm):
      mm

# what a quotient and remainder by ten are worth
def n1.pv(pr: Nat & Nat) -> Nat:
  match pr:
    case (qq, mm):
      Nat.add(Nat.mul(qq, 10n), mm)

# which is the quotient's and the remainder's
def n1.pv.e(pr: Nat & Nat) -> {n1.pv(pr) == Nat.add(Nat.mul(n1.pq(pr), 10n), n1.pm(pr)) : Nat}:
  match pr:
    case (_q, _m):
      {==}

# one more, by whether the remainder was 9
def n1.dq.tv(
  nine: Bool,
  +qq: Nat,
  +mm: Nat,
  +en: {Nat.is_eq(mm, 9n) == nine : Bool}
) -> {n1.pv(n1.dq.t(nine, qq, mm)) == 1n+Nat.add(Nat.mul(qq, 10n), mm) : Nat}:
  match nine:
    case True{}:
      %Equal.sym(Nat, mm, 9n, n1.eqn(mm, 9n, en)) : {Nat.add(Nat.mul(1n+qq, 10n), 0n) == 1n+Nat.add(Nat.mul(qq, 10n), _)
        : Nat}
      %Equal.sym(Nat, Nat.add(Nat.mul(qq, 10n), 9n), Nat.add(9n, Nat.mul(qq, 10n)), Ar.nat_add_comm(Nat.mul(qq, 10n),
        9n)) : {Nat.add(Nat.mul(1n+qq, 10n), 0n) == 1n+_ : Nat}
      Ar.nat_add_zero(Nat.mul(1n+qq, 10n))
    case False{}:
      Ar.nat_add_succ(Nat.mul(qq, 10n), mm)

# one more than a pair is worth one more
def n1.dq.nv(pr: Nat & Nat) -> {n1.pv(n1.dq.n(pr)) == 1n+n1.pv(pr) : Nat}:
  match pr:
    case (+qq, +mm):
      n1.dq.tv(Nat.is_eq(mm, 9n), qq, mm, {==})

# a Nat is its quotient by ten times ten and its remainder
def n1.qr(xx: Nat) -> {n1.pv(n1.dq(xx)) == xx : Nat}:
  match xx:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.trans(Nat, n1.pv(n1.dq.n(n1.dq(pp))), 1n+n1.pv(n1.dq(pp)), 1n+pp, n1.dq.nv(n1.dq(pp)), Equal.cong(Nat,
        Nat, nn => 1n+nn, n1.pv(n1.dq(pp)), pp, n1.qr(pp)))

# small Nats as the digits of a numeral, least-significant first
def n1.nv(ds: List<&2, Nat>) -> Nat:
  match ds:
    case []:
      0n
    case dd <> tt:
      Nat.add(Nat.mul(n1.nv(tt), 10n), dd)

# a carry below 100 as its digits, least-significant first: none for 0
def n1.ec(zq: Bool, zm: Bool, qq: Nat, mm: Nat) -> List<&2, Nat>:
  match zq zm:
    case True{} True{}:
      []
    case True{} False{}:
      [mm]
    case False{} _z:
      [mm, qq]

# a carry's quotient and remainder as its digits
def n1.ep(pr: Nat & Nat) -> List<&2, Nat>:
  match pr:
    case (+qq, +mm):
      n1.ec(Nat.is_eq(qq, 0n), Nat.is_eq(mm, 0n), qq, mm)

# the digit a step leaves, and the rest times r after the step's carry
def n1.mq(ds: List<&2, Nat>, pr: Nat & Nat, +rr: Nat) -> List<&2, Nat>:
  match ds:
    case []:
      match pr:
        case (qq, mm):
          mm <> n1.ep(n1.dq(qq))
    case dd <> tt:
      match pr:
        case (qq, mm):
          mm <> n1.mq(tt, n1.dq(Nat.add(Nat.mul(dd, rr), qq)), rr)

# small-Nat digits times r and a carry
def n1.mr(ds: List<&2, Nat>, +rr: Nat, cc: Nat) -> List<&2, Nat>:
  match ds:
    case []:
      n1.ep(n1.dq(cc))
    case dd <> tt:
      n1.mq(tt, n1.dq(Nat.add(Nat.mul(dd, rr), cc)), rr)

# a carry's digits are worth its quotient and remainder
def n1.ec.v(
  zq: Bool,
  zm: Bool,
  +qq: Nat,
  +mm: Nat,
  +eq: {Nat.is_eq(qq, 0n) == zq : Bool},
  +em: {Nat.is_eq(mm, 0n) == zm : Bool}
) -> {n1.nv(n1.ec(zq, zm, qq, mm)) == Nat.add(Nat.mul(qq, 10n), mm) : Nat}:
  match zq zm:
    case True{} True{}:
      %Equal.sym(Nat, qq, 0n, n1.eqn(qq, 0n, eq)) : {0n == Nat.add(Nat.mul(_, 10n), mm) : Nat}
      Equal.sym(Nat, mm, 0n, n1.eqn(mm, 0n, em))
    case True{} False{}:
      %Equal.sym(Nat, qq, 0n, n1.eqn(qq, 0n, eq)) : {n1.nv([mm]) == Nat.add(Nat.mul(_, 10n), mm) : Nat}
      {==}
    case False{} _z:
      {==}

# a pair's digits are worth the pair
def n1.ep.pv(pr: Nat & Nat) -> {n1.nv(n1.ep(pr)) == n1.pv(pr) : Nat}:
  match pr:
    case (+qq, +mm):
      n1.ec.v(Nat.is_eq(qq, 0n), Nat.is_eq(mm, 0n), qq, mm, {==}, {==})

# a Nat is its quotient and remainder by ten
def n1.pq.x(+xx: Nat) -> {Nat.add(Nat.mul(n1.pq(n1.dq(xx)), 10n), n1.pm(n1.dq(xx))) == xx : Nat}:
  Equal.trans(Nat, Nat.add(Nat.mul(n1.pq(n1.dq(xx)), 10n), n1.pm(n1.dq(xx))), n1.pv(n1.dq(xx)), xx, Equal.sym(Nat,
    n1.pv(n1.dq(xx)), Nat.add(Nat.mul(n1.pq(n1.dq(xx)), 10n), n1.pm(n1.dq(xx))), n1.pv.e(n1.dq(xx))), n1.qr(xx))

# a carry's digits are worth the carry
def n1.ep.v(+xx: Nat) -> {n1.nv(n1.ep(n1.dq(xx))) == xx : Nat}:
  Equal.trans(Nat, n1.nv(n1.ep(n1.dq(xx))), n1.pv(n1.dq(xx)), xx, n1.ep.pv(n1.dq(xx)), n1.qr(xx))

# a step's value
def n1.mq.v(
  ds: List<&2, Nat>,
  pr: Nat & Nat,
  +rr: Nat
) -> {n1.nv(n1.mq(ds, pr, rr)) == Nat.add(Nat.mul(Nat.add(Nat.mul(n1.nv(ds), rr), n1.pq(pr)), 10n), n1.pm(pr)) : Nat}:
  match ds:
    case []:
      match pr:
        case (+qq, +mm):
          Equal.cong(Nat, Nat, nn => Nat.add(Nat.mul(nn, 10n), mm), n1.nv(n1.ep(n1.dq(qq))), qq, n1.ep.v(qq))
    case +dd <> +tt:
      match pr:
        case (+qq, +mm):
          %Equal.sym(Nat, n1.nv(n1.mq(tt, n1.dq(Nat.add(Nat.mul(dd, rr), qq)), rr)), Nat.add(Nat.mul(Nat.add(
            Nat.mul(n1.nv(tt), rr), n1.pq(n1.dq(Nat.add(Nat.mul(dd, rr), qq)))), 10n), n1.pm(n1.dq(Nat.add(
            Nat.mul(dd, rr), qq)))), n1.mq.v(tt, n1.dq(Nat.add(Nat.mul(dd, rr), qq)), rr)) : {Nat.add(Nat.mul(_,
            10n), mm) == Nat.add(Nat.mul(Nat.add(Nat.mul(n1.nv(dd <> tt), rr), qq), 10n), mm) : Nat}
          Equal.cong(Nat, Nat, nn => Nat.add(Nat.mul(nn, 10n), mm), Nat.add(Nat.mul(Nat.add(Nat.mul(n1.nv(tt), rr),
            n1.pq(n1.dq(Nat.add(Nat.mul(dd, rr), qq)))), 10n), n1.pm(n1.dq(Nat.add(Nat.mul(dd, rr), qq)))),
            Nat.add(Nat.mul(n1.nv(dd <> tt), rr), qq), n1.alg(n1.nv(tt), rr, n1.pq(n1.dq(Nat.add(Nat.mul(dd, rr),
            qq))), n1.pm(n1.dq(Nat.add(Nat.mul(dd, rr), qq))), dd, qq, n1.pq.x(Nat.add(Nat.mul(dd, rr), qq))))

# the digits times r and a carry are worth their value times r and the carry
def n1.mrv(
  ds: List<&2, Nat>,
  +rr: Nat,
  +cc: Nat
) -> {n1.nv(n1.mr(ds, rr, cc)) == Nat.add(Nat.mul(n1.nv(ds), rr), cc) : Nat}:
  match ds:
    case []:
      n1.ep.v(cc)
    case +dd <> +tt:
      Equal.trans(Nat, n1.nv(n1.mq(tt, n1.dq(Nat.add(Nat.mul(dd, rr), cc)), rr)), Nat.add(Nat.mul(Nat.add(Nat.mul(
        n1.nv(tt), rr), n1.pq(n1.dq(Nat.add(Nat.mul(dd, rr), cc)))), 10n), n1.pm(n1.dq(Nat.add(Nat.mul(dd, rr), cc)))),
        Nat.add(Nat.mul(n1.nv(dd <> tt), rr), cc), n1.mq.v(tt, n1.dq(Nat.add(Nat.mul(dd, rr), cc)), rr),
        n1.alg(n1.nv(tt), rr, n1.pq(n1.dq(Nat.add(Nat.mul(dd, rr), cc))), n1.pm(n1.dq(Nat.add(Nat.mul(dd, rr), cc))),
        dd, cc, n1.pq.x(Nat.add(Nat.mul(dd, rr), cc))))

# small-Nat digits times r, k times
def n1.mi(ds: List<&2, Nat>, +rr: Nat, kk: Nat) -> List<&2, Nat>:
  match kk:
    case 0n:
      ds
    case 1n+pp:
      n1.mr(n1.mi(ds, rr, pp), rr, 0n)

# are worth their value times r to the k
def n1.miv(
  +ds: List<&2, Nat>,
  +rr: Nat,
  kk: Nat
) -> {n1.nv(n1.mi(ds, rr, kk)) == Nat.mul(n1.nv(ds), Nat.pow(rr, kk)) : Nat}:
  match kk:
    case 0n:
      Equal.sym(Nat, Nat.mul(n1.nv(ds), 1n), n1.nv(ds), Ar.nat_mul_one(n1.nv(ds)))
    case 1n+(+pp):
      %Equal.sym(Nat, n1.nv(n1.mr(n1.mi(ds, rr, pp), rr, 0n)), Nat.add(Nat.mul(n1.nv(n1.mi(ds, rr, pp)), rr), 0n),
        n1.mrv(n1.mi(ds, rr, pp), rr, 0n)) : {_ == Nat.mul(n1.nv(ds), Nat.mul(rr, Nat.pow(rr, pp))) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.mul(n1.nv(n1.mi(ds, rr, pp)), rr), 0n), Nat.mul(n1.nv(n1.mi(ds, rr, pp)), rr),
        Ar.nat_add_zero(Nat.mul(n1.nv(n1.mi(ds, rr, pp)), rr))) : {_ == Nat.mul(n1.nv(ds), Nat.mul(rr, Nat.pow(rr,
        pp))) : Nat}
      %Equal.sym(Nat, n1.nv(n1.mi(ds, rr, pp)), Nat.mul(n1.nv(ds), Nat.pow(rr, pp)), n1.miv(ds, rr, pp)) :
        {Nat.mul(_, rr) == Nat.mul(n1.nv(ds), Nat.mul(rr, Nat.pow(rr, pp))) : Nat}
      Equal.trans(Nat, Nat.mul(Nat.mul(n1.nv(ds), Nat.pow(rr, pp)), rr), Nat.mul(n1.nv(ds), Nat.mul(Nat.pow(rr, pp),
        rr)), Nat.mul(n1.nv(ds), Nat.mul(rr, Nat.pow(rr, pp))), Ar.nat_mul_assoc(n1.nv(ds), Nat.pow(rr, pp), rr),
        Equal.cong(Nat, Nat, nn => Nat.mul(n1.nv(ds), nn), Nat.mul(Nat.pow(rr, pp), rr), Nat.mul(rr, Nat.pow(rr,
        pp)), n1.mulc(Nat.pow(rr, pp), rr)))

# small Nats' value from the most significant, after acc
def n1.gm(ns: List<&2, Nat>, acc: Nat) -> Nat:
  match ns:
    case []:
      acc
    case mm <> nt:
      n1.gm(nt, Nat.add(Nat.mul(acc, 10n), mm))

# reversed onto acc, least-significant digits are acc's after their value
def n1.rvg(
  ds: List<&2, Nat>,
  +acc: List<&2, Nat>
) -> {n1.gm(List.reverse.go(&2, Nat, ds, acc), 0n) == n1.gm(acc, n1.nv(ds)) : Nat}:
  match ds:
    case []:
      {==}
    case +dd <> +tt:
      n1.rvg(tt, dd <> acc)

# whether characters spell small Nats, each a digit no underscore of that
# value
def n1.spl(cs: List<&2, Char>, ns: List<&2, Nat>) -> Bool:
  match cs:
    case []:
      List.is_empty(&2, Nat, ns)
    case +hh <> ct:
      match ns:
        case []:
          False{}
        case mm <> nt:
          Bool.and(Bool.not(Laws.abnf.underscore(hh)), Bool.and(Nat.is_eq(Laws.g.hexdig.val(hh), mm), n1.spl(ct,
            nt)))

# characters that spell small Nats are worth what they are
def n1.splv(
  cs: List<&2, Char>,
  ns: List<&2, Nat>,
  +acc: Nat,
  +hs: {n1.spl(cs, ns) == True{} : Bool}
) -> {Laws.g.num.nat(cs, 10n, acc) == n1.gm(ns, acc) : Nat}:
  match cs:
    case []:
      match ns:
        case []:
          {==}
        case _m <> _mt:
          Eq.bit.absurd(&2, {Laws.g.num.nat([], 10n, acc) == n1.gm(_m <> _mt, acc) : Nat}, hs)
    case +hh <> +ct:
      match ns:
        case []:
          Eq.bit.absurd(&2, {Laws.g.num.nat(hh <> ct, 10n, acc) == n1.gm([], acc) : Nat}, hs)
        case +mm <> +nt:
          +hu = {Eq.and.left(Bool.not(Laws.abnf.underscore(hh)), Bool.and(Nat.is_eq(Laws.g.hexdig.val(hh), mm),
            n1.spl(ct, nt)), hs) : {Bool.not(Laws.abnf.underscore(hh)) == True{} : Bool}}
          +hr = {Eq.and.right(Bool.not(Laws.abnf.underscore(hh)), Bool.and(Nat.is_eq(Laws.g.hexdig.val(hh), mm),
            n1.spl(ct, nt)), hs) : {Bool.and(Nat.is_eq(Laws.g.hexdig.val(hh), mm), n1.spl(ct, nt)) == True{} : Bool}}
          Equal.trans(Nat, Laws.g.num.nat(hh <> ct, 10n, acc), Laws.g.num.nat(ct, 10n, Nat.add(Nat.mul(acc, 10n),
            Laws.g.hexdig.val(hh))), n1.gm(mm <> nt, acc), n1.gn.step(hh, ct, 10n, acc, hu), Equal.trans(Nat,
            Laws.g.num.nat(ct, 10n, Nat.add(Nat.mul(acc, 10n), Laws.g.hexdig.val(hh))), n1.gm(nt,
            Nat.add(Nat.mul(acc, 10n), Laws.g.hexdig.val(hh))), n1.gm(nt, Nat.add(Nat.mul(acc, 10n), mm)),
            n1.splv(ct, nt, Nat.add(Nat.mul(acc, 10n), Laws.g.hexdig.val(hh)), Eq.and.right(Nat.is_eq(
            Laws.g.hexdig.val(hh), mm), n1.spl(ct, nt), hr)), Equal.cong(Nat, Nat, nn => n1.gm(nt,
            Nat.add(Nat.mul(acc, 10n), nn)), Laws.g.hexdig.val(hh), mm, n1.eqn(Laws.g.hexdig.val(hh), mm,
            Eq.and.left(Nat.is_eq(Laws.g.hexdig.val(hh), mm), n1.spl(ct, nt), hr)))))

# a numeral's value in base 10, once uu is known
def n1.hu(+ss: String, uu: Unit) -> Nat:
  match uu:
    case Unit{}:
      n1.h10(ss)

# small-Nat digits' value, once uu is known
def n1.nvu(+ds: List<&2, Nat>, uu: Unit) -> Nat:
  match uu:
    case Unit{}:
      n1.nv(ds)

# a numeral that spells small-Nat digits, the most significant first, is
# worth what they are
def n1.cert(
  +ss: String,
  +ds: List<&2, Nat>,
  +hs: {n1.spl(String.to_list(ss), List.reverse(&2, Nat, ds)) == True{} : Bool},
  uu: Unit
) -> {n1.hu(ss, uu) == n1.nvu(ds, uu) : Nat}:
  match uu:
    case Unit{}:
      Equal.trans(Nat, n1.h10(ss), n1.gm(List.reverse(&2, Nat, ds), 0n), n1.nv(ds), n1.splv(String.to_list(ss),
        List.reverse(&2, Nat, ds), 0n, hs), n1.rvg(ds, []))

# a small Nat's digits times r to the k, once uu is known
def n1.pb(+ds: List<&2, Nat>, +rr: Nat, +kk: Nat, uu: Unit) -> Nat:
  match uu:
    case Unit{}:
      Nat.mul(n1.nv(ds), Nat.pow(rr, kk))

# digits times r, k times, once uu is known, are worth their value times r
# to the k
def n1.miu(
  +ds: List<&2, Nat>,
  +rr: Nat,
  +kk: Nat,
  uu: Unit
) -> {n1.nvu(n1.mi(ds, rr, kk), uu) == n1.pb(ds, rr, kk, uu) : Nat}:
  match uu:
    case Unit{}:
      n1.miv(ds, rr, kk)

# the type of n1.lim's hs
def n1.lim.P1(+ds: List<&2, Nat>, +rr: Nat, +kk: Nat) -> Type:
  {n1.spl(String.to_list(T.i64.limit(T.Minus{})), List.reverse(&2, Nat, n1.mi(ds, rr, kk))) == True{} : Bool}

# the limit of a minus, as digits times a radix to a power
def n1.lim(
  +ds: List<&2, Nat>,
  +rr: Nat,
  +kk: Nat,
  hs: n1.lim.P1(ds, rr, kk),
  +uu: Unit
) -> {n1.hu(T.i64.limit(T.Minus{}), uu) == n1.pb(ds, rr, kk, uu) : Nat}:
  Equal.trans(Nat, n1.hu(T.i64.limit(T.Minus{}), uu), n1.nvu(n1.mi(ds, rr, kk), uu), n1.pb(ds, rr, kk, uu),
    n1.cert(T.i64.limit(T.Minus{}), n1.mi(ds, rr, kk), hs, uu), n1.miu(ds, rr, kk, uu))

# 2^63 is 8 * 16^15
def n1.lim.x(+uu: Unit) -> {n1.hu(T.i64.limit(T.Minus{}), uu) == n1.pb([8n], 16n, 15n, uu) : Nat}:
  n1.lim([8n], 16n, 15n, {==}, uu)

# and 8^21
def n1.lim.o(+uu: Unit) -> {n1.hu(T.i64.limit(T.Minus{}), uu) == n1.pb([1n], 8n, 21n, uu) : Nat}:
  n1.lim([1n], 8n, 21n, {==}, uu)

# and 2^63
def n1.lim.b(+uu: Unit) -> {n1.hu(T.i64.limit(T.Minus{}), uu) == n1.pb([1n], 2n, 63n, uu) : Nat}:
  n1.lim([1n], 2n, 63n, {==}, uu)

# A prefixed integer's significant digits (prose.sig: its underscores and
# leading zeros removed) are worth what its digits are, start with a digit
# other than 0, and bound its value by their number.

# whether every character is a digit of the radix
def n1.rdl(+rx: Laws.ARadix, xs: List<&2, Char>) -> Bool:
  match xs:
    case []:
      True{}
    case hh <> tt:
      Bool.and(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, tt))

# whether characters are digits of the radix, the first not 0
def n1.sgk(+rx: Laws.ARadix, xs: List<&2, Char>) -> Bool:
  match xs:
    case []:
      True{}
    case +hh <> tt:
      Bool.and(Bool.not(Laws.abnf.cp(hh, 48)), Bool.and(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, tt)))

# the left of an `or` that answered False
def n1.orF.l(aa: Bool, +bb: Bool, +hh: {Bool.or(aa, bb) == False{} : Bool}) -> {aa == False{} : Bool}:
  match aa:
    case True{}:
      hh
    case False{}:
      {==}

# and its right
def n1.orF.r(aa: Bool, +bb: Bool, +hh: {Bool.or(aa, bb) == False{} : Bool}) -> {bb == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd2(&2, {bb == False{} : Bool}, hh)
    case False{}:
      hh

# a character by whether it is an underscore: the value goes on as over the
# characters with the underscores removed
def n1.gnu.go(
  uu: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +rr: Nat,
  +acc: Nat,
  +eu: {Laws.abnf.underscore(hh) == uu : Bool},
  ih: @aa:Nat -> {Laws.g.num.nat(tt, rr, aa) == Laws.g.num.nat(String.to_list(Laws.abnf.no_us(tt)), rr, aa) : Nat}
) -> {Laws.g.num.nat(tt, rr, Laws.g.num.nat.step(uu, hh, rr, acc)) == Laws.g.num.nat(String.to_list(
  Laws.abnf.no_us.pick(uu, hh, Laws.abnf.no_us(tt))), rr, acc) : Nat}:
  match uu:
    case True{}:
      ih(acc)
    case False{}:
      %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, eu) : {Laws.g.num.nat(tt, rr, Nat.add(Nat.mul(acc, rr),
        Laws.g.hexdig.val(hh))) == Laws.g.num.nat(String.to_list(Laws.abnf.no_us(tt)), rr, Laws.g.num.nat.step(_, hh,
        rr, acc)) : Nat}
      ih(Nat.add(Nat.mul(acc, rr), Laws.g.hexdig.val(hh)))

# underscores add nothing to the value
def n1.gnu(
  xs: List<&2, Char>,
  +rr: Nat,
  +acc: Nat
) -> {Laws.g.num.nat(xs, rr, acc) == Laws.g.num.nat(String.to_list(Laws.abnf.no_us(xs)), rr, acc) : Nat}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      n1.gnu.go(Laws.abnf.underscore(hh), hh, tt, rr, acc, {==}, aa => n1.gnu(tt, rr, aa))

# an underscore or a 0 from 0 leaves 0
def n1.st0(
  uu: Bool,
  +hh: Char,
  +rr: Nat,
  +eu: {Laws.abnf.underscore(hh) == uu : Bool},
  +ho: {Bool.or(Laws.abnf.underscore(hh), Laws.abnf.cp(hh, 48)) == True{} : Bool}
) -> {Laws.g.num.nat.step(Laws.abnf.underscore(hh), hh, rr, 0n) == 0n : Nat}:
  match uu:
    case True{}:
      %Equal.sym(Bool, Laws.abnf.underscore(hh), True{}, eu) : {Laws.g.num.nat.step(_, hh, rr, 0n) == 0n : Nat}
      {==}
    case False{}:
      +hz = {Equal.trans(Bool, Laws.abnf.cp(hh, 48), Bool.or(False{}, Laws.abnf.cp(hh, 48)), True{}, {==},
        Equal.trans(Bool, Bool.or(False{}, Laws.abnf.cp(hh, 48)), Bool.or(Laws.abnf.underscore(hh),
        Laws.abnf.cp(hh, 48)), True{}, Equal.cong(Bool, Bool, bb => Bool.or(bb, Laws.abnf.cp(hh, 48)), False{},
        Laws.abnf.underscore(hh), Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, eu)), ho)) :
        {Laws.abnf.cp(hh, 48) == True{} : Bool}}
      %Equal.sym(Char, hh, '0', Eq.char_eq_true(hh, '0', Equal.trans(Bool, Char.is_eq(hh, Chr{48}),
        Laws.abnf.cp(hh, 48), True{}, n1.cp(hh, 48), hz))) : {Laws.g.num.nat.step(Laws.abnf.underscore(_), _, rr, 0n)
        == 0n : Nat}
      {==}

# a character by whether it is an underscore or a 0
def n1.gsig.go(
  bb: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +rr: Nat,
  +eb: {Bool.or(Laws.abnf.underscore(hh), Laws.abnf.cp(hh, 48)) == bb : Bool},
  +ih: {Laws.g.num.nat(tt, rr, 0n) == Laws.g.num.nat(Laws.prose.sig(tt), rr, 0n) : Nat}
) -> {Laws.g.num.nat(hh <> tt, rr, 0n) == Laws.g.num.nat(Laws.prose.sig.pick(bb, hh, tt, Laws.prose.sig(tt)), rr, 0n)
  : Nat}:
  match bb:
    case True{}:
      %Equal.sym(Nat, Laws.g.num.nat.step(Laws.abnf.underscore(hh), hh, rr, 0n), 0n, n1.st0(Laws.abnf.underscore(hh),
        hh, rr, {==}, eb)) : {Laws.g.num.nat(tt, rr, _) == Laws.g.num.nat(Laws.prose.sig(tt), rr, 0n) : Nat}
      ih
    case False{}:
      n1.gnu(hh <> tt, rr, 0n)

# the significant digits are worth what the digits are
def n1.gsig(
  xs: List<&2, Char>,
  +rr: Nat
) -> {Laws.g.num.nat(xs, rr, 0n) == Laws.g.num.nat(Laws.prose.sig(xs), rr, 0n) : Nat}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      n1.gsig.go(Bool.or(Laws.abnf.underscore(hh), Laws.abnf.cp(hh, 48)), hh, tt, rr, {==}, n1.gsig(tt, rr))

# a character by whether it is an underscore: with the underscores removed,
# digits of the radix
def n1.nurdl.go(
  uu: Bool,
  +rx: Laws.ARadix,
  +hh: Char,
  +tt: List<&2, Char>,
  +eu: {Laws.abnf.underscore(hh) == uu : Bool},
  +ho: {Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)) == True{} : Bool},
  +ih: {n1.rdl(rx, String.to_list(Laws.abnf.no_us(tt))) == True{} : Bool}
) -> {n1.rdl(rx, String.to_list(Laws.abnf.no_us.pick(uu, hh, Laws.abnf.no_us(tt)))) == True{} : Bool}:
  match uu:
    case True{}:
      ih
    case False{}:
      and.tt(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, String.to_list(Laws.abnf.no_us(tt))), n1.rr.d(hh, rx,
        Equal.trans(Bool, Char.is_eq(hh, '_'), Laws.abnf.underscore(hh), False{}, n1.us(hh), eu), ho), ih)

# underscores and digits of the radix, with the underscores removed, are
# digits of the radix
def n1.nurdl(
  +rx: Laws.ARadix,
  xs: List<&2, Char>,
  +hx: {n1.rr(rx, xs) == True{} : Bool}
) -> {n1.rdl(rx, String.to_list(Laws.abnf.no_us(xs))) == True{} : Bool}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      n1.nurdl.go(Laws.abnf.underscore(hh), rx, hh, tt, {==}, Eq.and.left(Bool.or(Char.is_eq(hh, '_'),
        Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx), n1.nurdl(rx, tt, Eq.and.right(Bool.or(Char.is_eq(hh, '_'),
        Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx)))

# a character by whether it is an underscore or a 0: the significant digits
# start with a digit other than 0
def n1.sigk.go(
  bb: Bool,
  +rx: Laws.ARadix,
  +hh: Char,
  +tt: List<&2, Char>,
  +eb: {Bool.or(Laws.abnf.underscore(hh), Laws.abnf.cp(hh, 48)) == bb : Bool},
  +ho: {Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)) == True{} : Bool},
  +hr: {n1.rr(rx, tt) == True{} : Bool},
  +ih: {n1.sgk(rx, Laws.prose.sig(tt)) == True{} : Bool}
) -> {n1.sgk(rx, Laws.prose.sig.pick(bb, hh, tt, Laws.prose.sig(tt))) == True{} : Bool}:
  match bb:
    case True{}:
      ih
    case False{}:
      +eu = {n1.orF.l(Laws.abnf.underscore(hh), Laws.abnf.cp(hh, 48), eb) : {Laws.abnf.underscore(hh) == False{}
        : Bool}}
      +ez = {n1.orF.r(Laws.abnf.underscore(hh), Laws.abnf.cp(hh, 48), eb) : {Laws.abnf.cp(hh, 48) == False{} : Bool}}
      %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, eu) : {n1.sgk(rx, String.to_list(Laws.abnf.no_us.pick(_, hh,
        Laws.abnf.no_us(tt)))) == True{} : Bool}
      %Equal.sym(Bool, Laws.abnf.cp(hh, 48), False{}, ez) : {Bool.and(Bool.not(_), Bool.and(Laws.abnf.radix_digit(rx,
        hh), n1.rdl(rx, String.to_list(Laws.abnf.no_us(tt))))) == True{} : Bool}
      and.tt(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, String.to_list(Laws.abnf.no_us(tt))), n1.rr.d(hh, rx,
        Equal.trans(Bool, Char.is_eq(hh, '_'), Laws.abnf.underscore(hh), False{}, n1.us(hh), eu), ho), n1.nurdl(rx,
        tt, hr))

# the significant digits of underscores and digits of the radix are digits
# of the radix, the first not 0
def n1.sigk(
  +rx: Laws.ARadix,
  xs: List<&2, Char>,
  +hx: {n1.rr(rx, xs) == True{} : Bool}
) -> {n1.sgk(rx, Laws.prose.sig(xs)) == True{} : Bool}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      +hr = {Eq.and.right(Bool.or(Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx)
        : {n1.rr(rx, tt) == True{} : Bool}}
      n1.sigk.go(Bool.or(Laws.abnf.underscore(hh), Laws.abnf.cp(hh, 48)), rx, hh, tt, {==}, Eq.and.left(Bool.or(
        Char.is_eq(hh, '_'), Laws.abnf.radix_digit(rx, hh)), n1.rr(rx, tt), hx), hr, n1.sigk(rx, tt, hr))

# digits of the radix are no underscores
def n1.rdl.nou(
  +rx: Laws.ARadix,
  xs: List<&2, Char>,
  +hx: {n1.rdl(rx, xs) == True{} : Bool}
) -> {n1.nou(xs) == True{} : Bool}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      and.tt(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt), Equal.cong(Bool, Bool, bb => Bool.not(bb),
        Laws.abnf.underscore(hh),
        False{}, Equal.sym(Bool, False{}, Laws.abnf.underscore(hh), n1.rd.nus(Char.is_eq(hh, '_'), rx, hh, {==},
        Eq.and.left(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, tt), hx)))), n1.rdl.nou(rx, tt,
        Eq.and.right(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, tt), hx)))

# and worth less than the base
def n1.rdl.dlt(
  +rx: Laws.ARadix,
  xs: List<&2, Char>,
  +hx: {n1.rdl(rx, xs) == True{} : Bool}
) -> {n1.dlt(xs, U32.to_nat(n1.rb(rx))) == True{} : Bool}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      and.tt(Nat.is_lt(Laws.g.hexdig.val(hh), U32.to_nat(n1.rb(rx))), n1.dlt(tt, U32.to_nat(n1.rb(rx))), n1.dlr(rx,
        hh, Eq.and.left(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, tt), hx)), n1.rdl.dlt(rx, tt,
        Eq.and.right(Laws.abnf.radix_digit(rx, hh), n1.rdl(rx, tt), hx)))

# a power of a radix above 0 is above 0
def n1.pow.pos(
  +rr: Nat,
  +kk: Nat,
  +hr: {Nat.is_lt(0n, rr) == True{} : Bool}
) -> {Nat.is_lt(0n, Nat.pow(rr, kk)) == True{} : Bool}:
  n1.lt.le(0n, 1n, Nat.pow(rr, kk), {==}, Equal.trans(Bool, Nat.is_le(1n, Nat.pow(rr, kk)), Nat.is_le(Nat.pow(rr, 0n),
    Nat.pow(rr, kk)), True{}, {==}, n1.pw.mono(rr, 0n, kk, hr, n1.le0(kk))))

# a times P is below b times P for a below b and P above 0
def n1.mul.lt(
  aa: Nat,
  bb: Nat,
  +pp: Nat,
  +hh: {Nat.is_lt(aa, bb) == True{} : Bool},
  +hp: {Nat.is_lt(0n, pp) == True{} : Bool}
) -> {Nat.is_lt(Nat.mul(aa, pp), Nat.mul(bb, pp)) == True{} : Bool}:
  match aa bb:
    case _a 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(Nat.mul(_a, pp), 0n) == True{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(_a,
        0n), True{}, Equal.sym(Bool, Nat.is_lt(_a, 0n), False{}, nlt.zero(_a)), hh))
    case 0n 1n+(+b1):
      lt.add(0n, pp, Nat.mul(b1, pp), hp)
    case 1n+(+a1) 1n+(+b1):
      Equal.trans(Bool, Nat.is_lt(Nat.add(pp, Nat.mul(a1, pp)), Nat.add(pp, Nat.mul(b1, pp))),
        Nat.is_lt(Nat.mul(a1, pp), Nat.mul(b1, pp)), True{}, Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx),
        Nat.cmp(Nat.add(pp, Nat.mul(a1, pp)), Nat.add(pp, Nat.mul(b1, pp))), Nat.cmp(Nat.mul(a1, pp), Nat.mul(b1, pp)),
        n1.cmp.add(pp, Nat.mul(a1, pp), Nat.mul(b1, pp))), n1.mul.lt(a1, b1, pp, hh, hp))

# one more than a is at most b exactly when a is below b
def n1.les(aa: Nat, bb: Nat) -> {Nat.is_le(1n+aa, bb) == Nat.is_lt(aa, bb) : Bool}:
  match aa bb:
    case 0n 0n:
      {==}
    case 0n 1n+(+b1):
      n1.le0(b1)
    case 1n+_a 0n:
      {==}
    case 1n+(+a1) 1n+(+b1):
      n1.les(a1, b1)

# not below b is at least b
def n1.nlt.le(aa: Nat, bb: Nat, +hh: {Nat.is_lt(aa, bb) == False{} : Bool}) -> {Nat.is_le(bb, aa) == True{} : Bool}:
  match aa bb:
    case _a 0n:
      n1.le0(_a)
    case 0n 1n+_b:
      Eq.bit.absurd2(&2, {Nat.is_le(1n+_b, 0n) == True{} : Bool}, hh)
    case 1n+(+a1) 1n+(+b1):
      n1.nlt.le(a1, b1, hh)

# a Nat below itself is not
def n1.ltirr(aa: Nat) -> {Nat.is_lt(aa, aa) == False{} : Bool}:
  match aa:
    case 0n:
      {==}
    case 1n+(+a1):
      n1.ltirr(a1)

# a Nat equals itself
def n1.eqrefl(aa: Nat) -> {Nat.is_eq(aa, aa) == True{} : Bool}:
  match aa:
    case 0n:
      {==}
    case 1n+(+a1):
      n1.eqrefl(a1)

# Nats that compare equal are equal
def n1.ceqn(aa: Nat, bb: Nat, +hh: {Nat.cmp(aa, bb) == EQ{} : Cmp}) -> {aa == bb : Nat}:
  n1.eqn(aa, bb, Equal.cong(Cmp, Bool, cc => Cmp.is_eq(cc), Nat.cmp(aa, bb), EQ{}, hh))

# a comparison with 0 is never LT, so after an order it keeps being LT
# exactly when the order was
def n1.ord0(cc: Cmp, +xx: Nat) -> {Cmp.is_lt(T.i64.ord(cc, Nat.cmp(xx, 0n))) == Cmp.is_lt(cc) : Bool}:
  match cc:
    case EQ{}:
      nlt.zero(xx)
    case LT{}:
      {==}
    case GT{}:
      {==}

# the value of a digit other than 0 of the radix and more after it
def n1.hsplit(
  +ff: Char,
  +tt: List<&2, Char>,
  +rr: Nat,
  +hn: {n1.nou(ff <> tt) == True{} : Bool}
) -> {Laws.g.num.nat(ff <> tt, rr, 0n) == Nat.add(Nat.mul(Laws.g.hexdig.val(ff), Nat.pow(rr, List.length(&2, Char,
  tt))), Laws.g.num.nat(tt, rr, 0n)) : Nat}:
  Equal.trans(Nat, Laws.g.num.nat(ff <> tt, rr, 0n), Laws.g.num.nat(tt, rr, Laws.g.hexdig.val(ff)),
    Nat.add(Nat.mul(Laws.g.hexdig.val(ff), Nat.pow(rr, List.length(&2, Char, tt))), Laws.g.num.nat(tt, rr, 0n)),
    n1.gn.step(ff, tt, rr, 0n, Eq.and.left(Bool.not(Laws.abnf.underscore(ff)), n1.nou(tt), hn)), n1.hl(tt, rr,
    Laws.g.hexdig.val(ff), Eq.and.right(Bool.not(Laws.abnf.underscore(ff)), n1.nou(tt), hn)))

# a base is above 0
def n1.rb.pos(rx: Laws.ARadix) -> {Nat.is_lt(0n, U32.to_nat(n1.rb(rx))) == True{} : Bool}:
  match rx:
    case Laws.AHex{}:
      {==}
    case Laws.AOct{}:
      {==}
    case Laws.ABin{}:
      {==}

# significant digits of a radix, more than k of them, are worth at least
# the radix to the k
def n1.b.hi(
  +rx: Laws.ARadix,
  +ff: Char,
  +tt: List<&2, Char>,
  +kk: Nat,
  +hs: {n1.sgk(rx, ff <> tt) == True{} : Bool},
  +hk: {Nat.is_le(kk, List.length(&2, Char, tt)) == True{} : Bool}
) -> {Nat.is_le(Nat.pow(U32.to_nat(n1.rb(rx)), kk), Laws.g.num.nat(ff <> tt, U32.to_nat(n1.rb(rx)), 0n)) == True{}
  : Bool}:
  +hr = {Eq.and.right(Bool.not(Laws.abnf.cp(ff, 48)), Bool.and(Laws.abnf.radix_digit(rx, ff), n1.rdl(rx, tt)), hs)
    : {Bool.and(Laws.abnf.radix_digit(rx, ff), n1.rdl(rx, tt)) == True{} : Bool}}
  n1.le.trans(Nat.pow(U32.to_nat(n1.rb(rx)), kk), Nat.pow(U32.to_nat(n1.rb(rx)), List.length(&2, Char, tt)),
    Laws.g.num.nat(ff <> tt, U32.to_nat(n1.rb(rx)), 0n), n1.pw.mono(U32.to_nat(n1.rb(rx)), kk, List.length(&2, Char,
    tt), n1.rb.pos(rx), hk), n1.low(ff, tt, U32.to_nat(n1.rb(rx)), n1.rdl.nou(rx, ff <> tt, hr), n1.d0(rx, ff,
    Eq.and.left(Laws.abnf.radix_digit(rx, ff), n1.rdl(rx, tt), hr), Eq.not.true(Laws.abnf.cp(ff, 48),
    Eq.and.left(Bool.not(Laws.abnf.cp(ff, 48)), Bool.and(Laws.abnf.radix_digit(rx, ff), n1.rdl(rx, tt)), hs)))))

# and digits of a radix, at most k of them, are worth less than the radix to
# the k
def n1.b.lo(
  +rx: Laws.ARadix,
  +xs: List<&2, Char>,
  +kk: Nat,
  +hx: {n1.rdl(rx, xs) == True{} : Bool},
  +hk: {Nat.is_le(List.length(&2, Char, xs), kk) == True{} : Bool}
) -> {Nat.is_lt(Laws.g.num.nat(xs, U32.to_nat(n1.rb(rx)), 0n), Nat.pow(U32.to_nat(n1.rb(rx)), kk)) == True{} : Bool}:
  n1.lt.le(Laws.g.num.nat(xs, U32.to_nat(n1.rb(rx)), 0n), Nat.pow(U32.to_nat(n1.rb(rx)), List.length(&2, Char, xs)),
    Nat.pow(U32.to_nat(n1.rb(rx)), kk), n1.hb(xs, U32.to_nat(n1.rb(rx)), n1.rdl.nou(rx, xs, hx), n1.rdl.dlt(rx, xs,
    hx)), n1.pw.mono(U32.to_nat(n1.rb(rx)), List.length(&2, Char, xs), kk, n1.rb.pos(rx), hk))

# the significant digits of an octal or binary integer, by whether the ones
# after the first are fewer than k: they are worth less than the radix to
# the k exactly when they are at most k
def n1.bo.go(
  bb: Bool,
  +rx: Laws.ARadix,
  +ff: Char,
  +tt: List<&2, Char>,
  +kk: Nat,
  +eb: {Nat.is_lt(List.length(&2, Char, tt), kk) == bb : Bool},
  +hs: {n1.sgk(rx, ff <> tt) == True{} : Bool}
) -> {Nat.is_lt(Laws.g.num.nat(ff <> tt, U32.to_nat(n1.rb(rx)), 0n), Nat.pow(U32.to_nat(n1.rb(rx)), kk))
  == Nat.is_lt(List.length(&2, Char, tt), kk) : Bool}:
  match bb:
    case True{}:
      Equal.trans(Bool, Nat.is_lt(Laws.g.num.nat(ff <> tt, U32.to_nat(n1.rb(rx)), 0n), Nat.pow(U32.to_nat(n1.rb(rx)),
        kk)), True{}, Nat.is_lt(List.length(&2, Char, tt), kk), n1.b.lo(rx, ff <> tt, kk, Eq.and.right(Bool.not(
        Laws.abnf.cp(ff, 48)), Bool.and(Laws.abnf.radix_digit(rx, ff), n1.rdl(rx, tt)), hs), Equal.trans(Bool,
        Nat.is_le(1n+List.length(&2, Char, tt), kk), Nat.is_lt(List.length(&2, Char, tt), kk), True{},
        n1.les(List.length(&2, Char, tt), kk), eb)), Equal.sym(Bool, Nat.is_lt(List.length(&2, Char, tt), kk), True{},
        eb))
    case False{}:
      Equal.trans(Bool, Nat.is_lt(Laws.g.num.nat(ff <> tt, U32.to_nat(n1.rb(rx)), 0n), Nat.pow(U32.to_nat(n1.rb(rx)),
        kk)), False{}, Nat.is_lt(List.length(&2, Char, tt), kk), n1.le.nlt(Nat.pow(U32.to_nat(n1.rb(rx)), kk),
        Laws.g.num.nat(ff <> tt, U32.to_nat(n1.rb(rx)), 0n), n1.b.hi(rx, ff, tt, kk, hs, n1.nlt.le(List.length(&2,
        Char, tt), kk, eb))), Equal.sym(Bool, Nat.is_lt(List.length(&2, Char, tt), kk), False{}, eb))

# significant digits of a radix are worth less than the radix to the k
# exactly when there are at most k of them
def n1.bo(
  +rx: Laws.ARadix,
  xs: List<&2, Char>,
  +kk: Nat,
  +hs: {n1.sgk(rx, xs) == True{} : Bool}
) -> {Nat.is_lt(Laws.g.num.nat(xs, U32.to_nat(n1.rb(rx)), 0n), Nat.mul(1n, Nat.pow(U32.to_nat(n1.rb(rx)), kk)))
  == Nat.is_le(List.length(&2, Char, xs), kk) : Bool}:
  match xs:
    case []:
      %Equal.sym(Nat, Nat.mul(1n, Nat.pow(U32.to_nat(n1.rb(rx)), kk)), Nat.pow(U32.to_nat(n1.rb(rx)), kk),
        Ar.nat_add_zero(Nat.pow(U32.to_nat(n1.rb(rx)), kk))) : {Nat.is_lt(Laws.g.num.nat([], U32.to_nat(n1.rb(rx)),
        0n), _) == Nat.is_le(List.length(&2, Char, []), kk) : Bool}
      Equal.trans(Bool, Nat.is_lt(0n, Nat.pow(U32.to_nat(n1.rb(rx)), kk)), True{}, Nat.is_le(0n, kk),
        n1.pow.pos(U32.to_nat(n1.rb(rx)), kk, n1.rb.pos(rx)), Equal.sym(Bool, Nat.is_le(0n, kk), True{}, n1.le0(kk)))
    case +ff <> +tt:
      %Equal.sym(Nat, Nat.mul(1n, Nat.pow(U32.to_nat(n1.rb(rx)), kk)), Nat.pow(U32.to_nat(n1.rb(rx)), kk),
        Ar.nat_add_zero(Nat.pow(U32.to_nat(n1.rb(rx)), kk))) : {Nat.is_lt(Laws.g.num.nat(ff <> tt,
        U32.to_nat(n1.rb(rx)),
        0n), _) == Nat.is_le(List.length(&2, Char, ff <> tt), kk) : Bool}
      %Equal.sym(Bool, Nat.is_le(1n+List.length(&2, Char, tt), kk), Nat.is_lt(List.length(&2, Char, tt), kk),
        n1.les(List.length(&2, Char, tt), kk)) : {Nat.is_lt(Laws.g.num.nat(ff <> tt, U32.to_nat(n1.rb(rx)), 0n),
        Nat.pow(U32.to_nat(n1.rb(rx)), kk)) == _ : Bool}
      n1.bo.go(Nat.is_lt(List.length(&2, Char, tt), kk), rx, ff, tt, kk, {==}, hs)

# the significant digits of a hexadecimal integer, by how the number after
# the first compares with k: fewer are worth less than 8 * 16^k, as many are
# exactly when the first is at most 7, and more are not
def n1.bx.go(
  cc: Cmp,
  +ff: Char,
  +tt: List<&2, Char>,
  +kk: Nat,
  +ec: {Nat.cmp(List.length(&2, Char, tt), kk) == cc : Cmp},
  +hs: {n1.sgk(Laws.AHex{}, ff <> tt) == True{} : Bool}
) -> {Nat.is_lt(Laws.g.num.nat(ff <> tt, 16n, 0n), Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(Nat.is_lt(List.length(&2,
  Char, tt), kk), Bool.and(Nat.is_eq(List.length(&2, Char, tt), kk), Laws.abnf.digit0_7(ff))) : Bool}:
  match cc:
    case LT{}:
      +hl = {Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Nat.cmp(List.length(&2, Char, tt), kk), LT{}, ec)
        : {Nat.is_lt(List.length(&2, Char, tt), kk) == True{} : Bool}}
      %Equal.sym(Bool, Nat.is_lt(List.length(&2, Char, tt), kk), True{}, hl) : {Nat.is_lt(Laws.g.num.nat(ff <> tt,
        16n, 0n), Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(_, Bool.and(Nat.is_eq(List.length(&2, Char, tt), kk),
        Laws.abnf.digit0_7(ff))) : Bool}
      n1.lt.le(Laws.g.num.nat(ff <> tt, 16n, 0n), Nat.pow(16n, kk), Nat.mul(8n, Nat.pow(16n, kk)), n1.b.lo(Laws.AHex{},
        ff <> tt, kk, Eq.and.right(Bool.not(Laws.abnf.cp(ff, 48)), Bool.and(Laws.abnf.radix_digit(Laws.AHex{}, ff),
        n1.rdl(Laws.AHex{}, tt)), hs), n1.lt.suc(List.length(&2, Char, tt), kk, hl)), n1.le.addr(Nat.pow(16n, kk),
        Nat.mul(7n, Nat.pow(16n, kk))))
    case EQ{}:
      +hr = {Eq.and.right(Bool.not(Laws.abnf.cp(ff, 48)), Bool.and(Laws.abnf.radix_digit(Laws.AHex{}, ff),
        n1.rdl(Laws.AHex{}, tt)), hs) : {Bool.and(Laws.abnf.radix_digit(Laws.AHex{}, ff), n1.rdl(Laws.AHex{}, tt))
        == True{} : Bool}}
      +el = {n1.ceqn(List.length(&2, Char, tt), kk, ec) : {List.length(&2, Char, tt) == kk : Nat}}
      +ht = {n1.b.lo(Laws.AHex{}, tt, kk, Eq.and.right(Laws.abnf.radix_digit(Laws.AHex{}, ff), n1.rdl(Laws.AHex{},
        tt), hr), Equal.cong(Cmp, Bool, xx => Cmp.is_le(xx), Nat.cmp(List.length(&2, Char, tt), kk), EQ{}, ec))
        : {Nat.is_lt(Laws.g.num.nat(tt, 16n, 0n), Nat.pow(16n, kk)) == True{} : Bool}}
      %Equal.sym(Nat, Laws.g.num.nat(ff <> tt, 16n, 0n), Nat.add(Nat.mul(Laws.g.hexdig.val(ff), Nat.pow(16n,
        List.length(&2, Char, tt))), Laws.g.num.nat(tt, 16n, 0n)), n1.hsplit(ff, tt, 16n, n1.rdl.nou(Laws.AHex{},
        ff <> tt, hr))) : {Nat.is_lt(_, Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(Nat.is_lt(List.length(&2, Char,
        tt), kk), Bool.and(Nat.is_eq(List.length(&2, Char, tt), kk), Laws.abnf.digit0_7(ff))) : Bool}
      %Equal.sym(Nat, List.length(&2, Char, tt), kk, el) : {Nat.is_lt(Nat.add(Nat.mul(Laws.g.hexdig.val(ff),
        Nat.pow(16n, _)), Laws.g.num.nat(tt, 16n, 0n)), Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(Nat.is_lt(_, kk),
        Bool.and(Nat.is_eq(_, kk), Laws.abnf.digit0_7(ff))) : Bool}
      %Equal.sym(Bool, Nat.is_lt(kk, kk), False{}, n1.ltirr(kk)) : {Nat.is_lt(Nat.add(Nat.mul(Laws.g.hexdig.val(ff),
        Nat.pow(16n, kk)), Laws.g.num.nat(tt, 16n, 0n)), Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(_,
        Bool.and(Nat.is_eq(kk, kk), Laws.abnf.digit0_7(ff))) : Bool}
      %Equal.sym(Bool, Nat.is_eq(kk, kk), True{}, n1.eqrefl(kk)) : {Nat.is_lt(Nat.add(Nat.mul(Laws.g.hexdig.val(ff),
        Nat.pow(16n, kk)), Laws.g.num.nat(tt, 16n, 0n)), Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(False{},
        Bool.and(_, Laws.abnf.digit0_7(ff))) : Bool}
      %Equal.sym(Bool, Laws.abnf.digit0_7(ff), Nat.is_lt(Laws.g.hexdig.val(ff), 8n), n1.d07(ff,
        Eq.and.left(Laws.abnf.radix_digit(Laws.AHex{}, ff), n1.rdl(Laws.AHex{}, tt), hr))) : {Nat.is_lt(Nat.add(
        Nat.mul(Laws.g.hexdig.val(ff), Nat.pow(16n, kk)), Laws.g.num.nat(tt, 16n, 0n)), Nat.mul(8n, Nat.pow(16n,
        kk))) == Bool.or(False{}, Bool.and(True{}, _)) : Bool}
      %Ar.nat_add_zero(Nat.mul(8n, Nat.pow(16n, kk))) : {Nat.is_lt(Nat.add(Nat.mul(Laws.g.hexdig.val(ff),
        Nat.pow(16n, kk)), Laws.g.num.nat(tt, 16n, 0n)), _) == Nat.is_lt(Laws.g.hexdig.val(ff), 8n) : Bool}
      Equal.trans(Bool, Nat.is_lt(Nat.add(Nat.mul(Laws.g.hexdig.val(ff), Nat.pow(16n, kk)), Laws.g.num.nat(tt, 16n,
        0n)), Nat.add(Nat.mul(8n, Nat.pow(16n, kk)), 0n)), Cmp.is_lt(T.i64.ord(Nat.cmp(Laws.g.hexdig.val(ff), 8n),
        Nat.cmp(Laws.g.num.nat(tt, 16n, 0n), 0n))), Nat.is_lt(Laws.g.hexdig.val(ff), 8n), Equal.cong(Cmp, Bool,
        xx => Cmp.is_lt(xx), Nat.cmp(Nat.add(Nat.mul(Laws.g.hexdig.val(ff), Nat.pow(16n, kk)), Laws.g.num.nat(tt,
        16n, 0n)), Nat.add(Nat.mul(8n, Nat.pow(16n, kk)), 0n)), T.i64.ord(Nat.cmp(Laws.g.hexdig.val(ff), 8n),
        Nat.cmp(Laws.g.num.nat(tt, 16n, 0n), 0n)), n1.ka(Laws.g.hexdig.val(ff), 8n, Nat.pow(16n, kk),
        Laws.g.num.nat(tt, 16n, 0n), 0n, ht, n1.pow.pos(16n, kk, {==}))), n1.ord0(Nat.cmp(Laws.g.hexdig.val(ff),
        8n), Laws.g.num.nat(tt, 16n, 0n)))
    case GT{}:
      %Equal.sym(Bool, Nat.is_lt(List.length(&2, Char, tt), kk), False{}, Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx),
        Nat.cmp(List.length(&2, Char, tt), kk), GT{}, ec)) : {Nat.is_lt(Laws.g.num.nat(ff <> tt, 16n, 0n),
        Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(_, Bool.and(Nat.is_eq(List.length(&2, Char, tt), kk),
        Laws.abnf.digit0_7(ff))) : Bool}
      %Equal.sym(Bool, Nat.is_eq(List.length(&2, Char, tt), kk), False{}, Equal.cong(Cmp, Bool, xx => Cmp.is_eq(xx),
        Nat.cmp(List.length(&2, Char, tt), kk), GT{}, ec)) : {Nat.is_lt(Laws.g.num.nat(ff <> tt, 16n, 0n),
        Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(False{}, Bool.and(_, Laws.abnf.digit0_7(ff))) : Bool}
      n1.le.nlt(Nat.mul(8n, Nat.pow(16n, kk)), Laws.g.num.nat(ff <> tt, 16n, 0n), n1.lt.lte(Nat.mul(8n, Nat.pow(16n,
        kk)), Laws.g.num.nat(ff <> tt, 16n, 0n), n1.lt.le(Nat.mul(8n, Nat.pow(16n, kk)), Nat.mul(16n, Nat.pow(16n,
        kk)), Laws.g.num.nat(ff <> tt, 16n, 0n), n1.mul.lt(8n, 16n, Nat.pow(16n, kk), {==}, n1.pow.pos(16n, kk, {==})),
        n1.b.hi(Laws.AHex{}, ff, tt, 1n+kk, hs, n1.lt.suc(kk, List.length(&2, Char, tt), n1.gt.lt(List.length(&2,
        Char, tt), kk, ec))))))

# significant hexadecimal digits are worth less than 8 * 16^k exactly when
# there are at most k, or k + 1 and the first is at most 7
def n1.bx(
  xs: List<&2, Char>,
  +kk: Nat,
  +hs: {n1.sgk(Laws.AHex{}, xs) == True{} : Bool}
) -> {Nat.is_lt( Laws.g.num.nat(xs, 16n, 0n), Nat.mul(8n, Nat.pow(16n, kk))) == Bool.or(Nat.is_lt(List.length(&2,
  Char, xs), 1n+kk), Bool.and(Nat.is_eq(List.length(&2, Char, xs), 1n+kk), Laws.prose.first_le7(xs))) : Bool}:
  match xs:
    case []:
      lt.add(0n, Nat.pow(16n, kk), Nat.mul(7n, Nat.pow(16n, kk)), n1.pow.pos(16n, kk, {==}))
    case +ff <> +tt:
      n1.bx.go(Nat.cmp(List.length(&2, Char, tt), kk), ff, tt, kk, {==}, hs)

# significant digits of a radix, against its limit once uu is known: at most
# k, for octal and binary
def n1.bo.u(
  +rx: Laws.ARadix,
  +xs: List<&2, Char>,
  +kk: Nat,
  +hs: {n1.sgk(rx, xs) == True{} : Bool},
  uu: Unit
) -> {Nat.is_lt(Laws.g.num.nat(xs, U32.to_nat(n1.rb(rx)), 0n), n1.pb([1n], U32.to_nat(n1.rb(rx)), kk, uu))
  == Nat.is_le(List.length(&2, Char, xs), kk) : Bool}:
  match uu:
    case Unit{}:
      n1.bo(rx, xs, kk, hs)

# and for hexadecimal
def n1.bx.u(
  +xs: List<&2, Char>,
  +kk: Nat,
  +hs: {n1.sgk(Laws.AHex{}, xs) == True{} : Bool},
  uu: Unit
) -> {Nat.is_lt(Laws.g.num.nat(xs, 16n, 0n), n1.pb([8n], 16n, kk, uu)) == Bool.or(Nat.is_lt(List.length(&2, Char, xs),
  1n+kk), Bool.and(Nat.is_eq(List.length(&2, Char, xs), 1n+kk), Laws.prose.first_le7(xs))) : Bool}:
  match uu:
