  here,
  arrtab,
  back,
  qkind,
  uni,
  left,
  rest,
  eo,
  et
):
  kk.atroot(T.root(Laws.k3.hd.doc(arr, g0, ds, last, g9, rows, heads, here, arrtab, back, qkind, uni, left, rest)),
    Laws.k3.dk.init(ds), Laws.k3.seg.name(last), Laws.header_found_anywhere(arr, g0, ds, last, ok,
    g9, rows, heads, here, arrtab, back, qkind, uni, left, rest, eo), et)

def Laws.key_found_in_document(
  pre,
  at,
  g0,
  ds,
  last,
  ok,
  g,
  rows,
  heads,
  here,
  stack,
  arrtab,
  back,
  qkind,
  uni,
  left,
  rest,
  es,
  ep,
  eo
):
  %Equal.sym(T.Doc, T.parse(String.append(pre, String.append(Laws.gap(g0), Laws.k3.dk.text(ds, last,
    String.append(Laws.gap(g), SCon{'=', rest}))))), Laws.k3.key.doc(at, g0, ds, last, g, rows, heads, here, stack,
      arrtab, back, qkind, uni, left, rest), ep) : {Laws.k3.has(T.root(_), Laws.k3.key.table(stack, here, ds),
        Laws.k3.seg.name(last)) == True{} : Bool}
  Laws.key_found_anywhere(at, g0, ds, last, ok, g, rows, heads, here, stack, arrtab, back, qkind, uni, left, rest, es,
    Equal.trans(Bool, String.is_empty(T.bad(Laws.k3.key.doc(at, g0, ds, last, g, rows, heads, here, stack, arrtab,
      back, qkind, uni, left, rest))), String.is_empty(T.bad(T.parse(String.append(pre, String.append(Laws.gap(g0),
        Laws.k3.dk.text(ds, last, String.append(Laws.gap(g), SCon{'=', rest}))))))), True{}, Equal.cong(T.Doc, Bool,
      dd => String.is_empty(T.bad(dd)), Laws.k3.key.doc(at, g0, ds, last, g, rows, heads, here, stack, arrtab, back,
        qkind, uni, left, rest), T.parse(String.append(pre, String.append(Laws.gap(g0), Laws.k3.dk.text(ds, last,
          String.append(Laws.gap(g), SCon{'=', rest}))))), Equal.sym(T.Doc, T.parse(String.append(pre,
            String.append(Laws.gap(g0), Laws.k3.dk.text(ds, last, String.append(Laws.gap(g), SCon{'=', rest}))))),
              Laws.k3.key.doc(at, g0, ds, last, g, rows, heads, here, stack, arrtab, back, qkind, uni, left, rest),
                ep)), eo))

# GRAMMAR SPIKE: the lemmas of dec_int_word (retired by REVIEW-G10 once
# TOML-NUM-1 was proved). The transcribed rule is taken apart by the
# characters it tests, and each part is read by the numeral lemmas of WP-N
# (nw.lead, nw.sign, nw.step, dgo, int.fin): an underscore between digits
# leaves the numeral as it was, so the scan reads the digits with the
# underscores removed.

# a DIGIT is a digit: the two tests are one test once the code point is out
def gs.dig(cc: Char, h: {Laws.abnf.DIGIT(cc) == True{} : Bool}) -> {Char.is_digit(cc) == True{} : Bool}:
  match cc:
    case Chr{+cp}:
      h

# a digit is no underscore
def gs.nous(cc: Char, hc: {Char.is_digit(cc) == True{} : Bool}) -> {Laws.abnf.underscore(cc) == False{} : Bool}:
  dg.elim(zz => {Laws.abnf.underscore(zz) == False{} : Bool}, cc, hc,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# an underscore is the character _
def gs.us(cc: Char, h: {Laws.abnf.underscore(cc) == True{} : Bool}) -> {cc == '_' : Char}:
  match cc:
    case Chr{+cp}:
      Eq.char_eq_true(Chr{cp}, '_', h)

# a minus is the character -
def gs.minus(cc: Char, h: {Laws.abnf.minus(cc) == True{} : Bool}) -> {cc == '-' : Char}:
  match cc:
    case Chr{+cp}:
      Eq.char_eq_true(Chr{cp}, '-', h)

# a plus is the character +
def gs.plus(cc: Char, h: {Laws.abnf.plus(cc) == True{} : Bool}) -> {cc == '+' : Char}:
  match cc:
    case Chr{+cp}:
      Eq.char_eq_true(Chr{cp}, '+', h)

# the 31 bits above a code point's lowest
def gs.up(uu: U32) -> Word(31n):
  match uu:
    case U32{WCon{_bb, rr}}:
      rr

# 48 and 49 differ in their lowest bit only: a code point at least 49 is at
# least 48
def gs.ge01(
  +b0: Bool,
  tt: Cmp,
  +h: {Cmp.is_ge(Word.cmp.fin(b0, True{}, tt)) == True{} : Bool}
) -> {Cmp.is_ge(Word.cmp.fin(b0, False{}, tt)) == True{} : Bool}:
  match b0 tt:
    case _b LT{}:
      h
    case True{} EQ{}:
      {==}
    case False{} EQ{}:
      {==}
    case _b GT{}:
      {==}

# and is not 48
def gs.eq01(
  +b0: Bool,
  tt: Cmp,
  +h: {Cmp.is_ge(Word.cmp.fin(b0, True{}, tt)) == True{} : Bool}
) -> {Cmp.is_eq(Word.cmp.fin(b0, False{}, tt)) == False{} : Bool}:
  match b0 tt:
    case _b LT{}:
      {==}
    case True{} EQ{}:
      {==}
    case False{} EQ{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, h)
    case _b GT{}:
      {==}

# a digit1-9 is a digit
def gs.d19(cc: Char, +h: {Laws.abnf.digit1_9(cc) == True{} : Bool}) -> {Char.is_digit(cc) == True{} : Bool}:
  match cc:
    case Chr{U32{WCon{+b0, +rr}}}:
      and.tt(Cmp.is_ge(Word.cmp.fin(b0, False{}, Word.cmp(31n, rr, gs.up(48)))),
        Cmp.is_le(Word.cmp.fin(b0, True{}, Word.cmp(31n, rr, gs.up(57)))),
        gs.ge01(b0, Word.cmp(31n, rr, gs.up(48)), Eq.and.left(Cmp.is_ge(Word.cmp.fin(b0, True{}, Word.cmp(31n, rr,
          gs.up(48)))), Cmp.is_le(Word.cmp.fin(b0, True{}, Word.cmp(31n, rr, gs.up(57)))), h)),
        Eq.and.right(Cmp.is_ge(Word.cmp.fin(b0, True{}, Word.cmp(31n, rr, gs.up(48)))),
          Cmp.is_le(Word.cmp.fin(b0, True{}, Word.cmp(31n, rr, gs.up(57)))), h))

# and is not 0
def gs.d19z(cc: Char, h: {Laws.abnf.digit1_9(cc) == True{} : Bool}) -> {Char.is_eq(cc, '0') == False{} : Bool}:
  match cc:
    case Chr{U32{WCon{+b0, +rr}}}:
      gs.eq01(b0, Word.cmp(31n, rr, gs.up(48)), Eq.and.left(Cmp.is_ge(Word.cmp.fin(b0, True{}, Word.cmp(31n, rr,
        gs.up(48)))), Cmp.is_le(Word.cmp.fin(b0, True{}, Word.cmp(31n, rr, gs.up(57)))), h))

# an and with False on its right is False
def gs.andf(aa: Bool) -> {Bool.and(aa, False{}) == False{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      {==}

# with a DIGIT first, the repetition is the repetition after it
def gs.rep.dl(
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +ed: {Laws.abnf.DIGIT(hh) == True{} : Bool},
  +hu: {Laws.abnf.underscore(hh) == False{} : Bool}
) -> {Bool.or(Laws.abnf.dec_rep(h2 <> t2), False{}) == Laws.abnf.dec_rep(hh <> h2 <> t2) : Bool}:
  %Equal.sym(Bool, Laws.abnf.DIGIT(hh), True{}, ed) : {Bool.or(Laws.abnf.dec_rep(h2 <> t2), False{})
    == Bool.or(Bool.and(_, Laws.abnf.dec_rep(h2 <> t2)), Bool.and(Laws.abnf.underscore(hh),
    Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)))) : Bool}
  %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, hu) : {Bool.or(Laws.abnf.dec_rep(h2 <> t2), False{})
    == Bool.or(Bool.and(True{}, Laws.abnf.dec_rep(h2 <> t2)), Bool.and(_, Bool.and(Laws.abnf.DIGIT(h2),
    Laws.abnf.dec_rep(t2)))) : Bool}
  {==}

# with no DIGIT first, it is an underscore, a DIGIT and the rest
def gs.rep.ul(
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +ed: {Laws.abnf.DIGIT(hh) == False{} : Bool}
) -> {Bool.and(Laws.abnf.underscore(hh), Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)))
  == Laws.abnf.dec_rep(hh <> h2 <> t2) : Bool}:
  %Equal.sym(Bool, Laws.abnf.DIGIT(hh), False{}, ed) : {Bool.and(Laws.abnf.underscore(hh),
    Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2))) == Bool.or(Bool.and(_, Laws.abnf.dec_rep(h2 <> t2)),
    Bool.and(Laws.abnf.underscore(hh), Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)))) : Bool}
  {==}

# The repetition *( DIGIT / underscore DIGIT ), taken apart: a claim of each
# of its three shapes is a claim of every text it matches. A DIGIT leads, or
# an underscore and a DIGIT do.
def gs.rep.two(
  -P: List<&2, Char> -> Type,
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  dd: Bool,
  +ed: {Laws.abnf.DIGIT(hh) == dd : Bool},
  +h: {Laws.abnf.dec_rep(hh <> h2 <> t2) == True{} : Bool},
  kd: {Char.is_digit(hh) == True{} : Bool} -> {Laws.abnf.dec_rep(h2 <> t2) == True{} : Bool} -> P(hh <> h2 <> t2),
  ku: {Char.is_digit(h2) == True{} : Bool} -> {Laws.abnf.dec_rep(t2) == True{} : Bool} -> P('_' <> h2 <> t2)
) -> P(hh <> h2 <> t2):
  match dd:
    case True{}:
      +hx = {gs.dig(hh, ed) : {Char.is_digit(hh) == True{} : Bool}}
      kd(hx, or.fl(Laws.abnf.dec_rep(h2 <> t2), Equal.trans(Bool, Bool.or(Laws.abnf.dec_rep(h2 <> t2), False{}),
        Laws.abnf.dec_rep(hh <> h2 <> t2), True{}, gs.rep.dl(hh, h2, t2, ed, gs.nous(hh, hx)), h)))
    case False{}:
      +hq = {Equal.trans(Bool, Bool.and(Laws.abnf.underscore(hh), Bool.and(Laws.abnf.DIGIT(h2),
        Laws.abnf.dec_rep(t2))), Laws.abnf.dec_rep(hh <> h2 <> t2), True{}, gs.rep.ul(hh, h2, t2, ed), h)
        : {Bool.and(Laws.abnf.underscore(hh), Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2))) == True{} : Bool}}
      +hk = {Eq.and.right(Laws.abnf.underscore(hh), Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)), hq)
        : {Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)) == True{} : Bool}}
      %Equal.sym(Char, hh, '_', gs.us(hh, Eq.and.left(Laws.abnf.underscore(hh), Bool.and(Laws.abnf.DIGIT(h2),
        Laws.abnf.dec_rep(t2)), hq))) : P(_ <> h2 <> t2)
      ku(gs.dig(h2, Eq.and.left(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2), hk)),
        Eq.and.right(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2), hk))

# a digit joins the numeral
def gs.join(
  +sg: T.Sign,
  +acc: List<&2, Char>,
  +hh: Char,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  +hn: {nzl(acc) == True{} : Bool}
) -> {T.num.step(ndig(sg, vals(acc)), hh) == ndig(sg, vals(hh <> acc)) : T.Num}:
  Equal.trans(T.Num, T.num.step(ndig(sg, vals(acc)), hh), ndig(sg, T.dec.go(vals(acc), 10, T.dig.val(hh))),
    ndig(sg, vals(hh <> acc)), nw.step(sg, vals(acc), hh, hx),
    Equal.cong(List<&2, U32>, T.Num, ds => ndig(sg, ds), T.dec.go(vals(acc), 10, T.dig.val(hh)), vals(hh <> acc),
      dgo(acc, hh, hx, hn)))

# an underscore then a digit: the underscore leaves the numeral as it was
def gs.us.step(
  +sg: T.Sign,
  +ds: List<&2, U32>,
  dd: Char,
  +hd: {Char.is_digit(dd) == True{} : Bool}
) -> {T.num.step(T.num.step(ndig(sg, ds), '_'), dd) == ndig(sg, T.dec.go(ds, 10, T.dig.val(dd))) : T.Num}:
  dg.elim(zz => {T.num.step(T.num.step(ndig(sg, ds), '_'), zz) == ndig(sg, T.dec.go(ds, 10, T.dig.val(zz))) : T.Num},
    dd, hd, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# and so the digit joins it
def gs.join2(
  +sg: T.Sign,
  +acc: List<&2, Char>,
  +h2: Char,
  +hx: {Char.is_digit(h2) == True{} : Bool},
  +hn: {nzl(acc) == True{} : Bool}
) -> {T.num.step(T.num.step(ndig(sg, vals(acc)), '_'), h2) == ndig(sg, vals(h2 <> acc)) : T.Num}:
  Equal.trans(T.Num, T.num.step(T.num.step(ndig(sg, vals(acc)), '_'), h2),
    ndig(sg, T.dec.go(vals(acc), 10, T.dig.val(h2))), ndig(sg, vals(h2 <> acc)), gs.us.step(sg, vals(acc), h2, hx),
    Equal.cong(List<&2, U32>, T.Num, ds => ndig(sg, ds), T.dec.go(vals(acc), 10, T.dig.val(h2)), vals(h2 <> acc),
      dgo(acc, h2, hx, hn)))

# what the scan over the repetition claims: it reads the digits, underscores
# removed, onto the numeral
def gs.Scan(cs: List<&2, Char>, acc: List<&2, Char>, sg: T.Sign) -> Type:
  {T.num.go(cs, ndig(sg, vals(acc))) == ndig(sg, vals(rev.onto(Laws.abnf.no_us(cs), acc))) : T.Num}

# a DIGIT first
def gs.scan.d(
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +acc: List<&2, Char>,
  +sg: T.Sign,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  +hn: {nzl(acc) == True{} : Bool},
  ih: {nzl(hh <> acc) == True{} : Bool} -> gs.Scan(h2 <> t2, hh <> acc, sg)
) -> gs.Scan(hh <> h2 <> t2, acc, sg):
  %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, gs.nous(hh, hx)) : {T.num.go(hh <> h2 <> t2, ndig(sg,
    vals(acc))) == ndig(sg, vals(rev.onto(Laws.abnf.no_us.pick(_, hh, Laws.abnf.no_us(h2 <> t2)), acc))) : T.Num}
  Equal.trans(T.Num, T.num.go(h2 <> t2, T.num.step(ndig(sg, vals(acc)), hh)),
    T.num.go(h2 <> t2, ndig(sg, vals(hh <> acc))), ndig(sg, vals(rev.onto(Laws.abnf.no_us(h2 <> t2), hh <> acc))),
    Equal.cong(T.Num, T.Num, nn => T.num.go(h2 <> t2, nn), T.num.step(ndig(sg, vals(acc)), hh),
      ndig(sg, vals(hh <> acc)), gs.join(sg, acc, hh, hx, hn)),
    ih(nzl.cons(hh, acc, hx, hn)))

# an underscore and a DIGIT first
def gs.scan.u(
  +h2: Char,
  +t2: List<&2, Char>,
  +acc: List<&2, Char>,
  +sg: T.Sign,
  +hx: {Char.is_digit(h2) == True{} : Bool},
  +hn: {nzl(acc) == True{} : Bool},
  ih: {nzl(h2 <> acc) == True{} : Bool} -> gs.Scan(t2, h2 <> acc, sg)
) -> gs.Scan('_' <> h2 <> t2, acc, sg):
  %Equal.sym(Bool, Laws.abnf.underscore(h2), False{}, gs.nous(h2, hx)) : {T.num.go('_' <> h2 <> t2, ndig(sg,
    vals(acc))) == ndig(sg, vals(rev.onto(Laws.abnf.no_us.pick(_, h2, Laws.abnf.no_us(t2)), acc))) : T.Num}
  Equal.trans(T.Num, T.num.go(t2, T.num.step(T.num.step(ndig(sg, vals(acc)), '_'), h2)),
    T.num.go(t2, ndig(sg, vals(h2 <> acc))), ndig(sg, vals(rev.onto(Laws.abnf.no_us(t2), h2 <> acc))),
    Equal.cong(T.Num, T.Num, nn => T.num.go(t2, nn), T.num.step(T.num.step(ndig(sg, vals(acc)), '_'), h2),
      ndig(sg, vals(h2 <> acc)), gs.join2(sg, acc, h2, hx, hn)),
    ih(nzl.cons(h2, acc, hx, hn)))

# the numeral scan reads the repetition *( DIGIT / underscore DIGIT ) as its
# digits with the underscores removed
def gs.scan(
  cs: List<&2, Char>,
  +acc: List<&2, Char>,
  +sg: T.Sign,
  +h: {Laws.abnf.dec_rep(cs) == True{} : Bool},
  +hn: {nzl(acc) == True{} : Bool}
) -> gs.Scan(cs, acc, sg):
  match cs:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          +hx = {gs.dig(hh, h) : {Char.is_digit(hh) == True{} : Bool}}
          %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, gs.nous(hh, hx)) : {T.num.go([hh], ndig(sg,
            vals(acc))) == ndig(sg, vals(rev.onto(Laws.abnf.no_us.pick(_, hh, ""), acc))) : T.Num}
          gs.join(sg, acc, hh, hx, hn)
        case +h2 <> +t2:
          gs.rep.two(zs => gs.Scan(zs, acc, sg), hh, h2, t2, Laws.abnf.DIGIT(hh), {==}, h,
            hx => hr => gs.scan.d(hh, h2, t2, acc, sg, hx, hn, ha => gs.scan(h2 <> t2, hh <> acc, sg, hr, ha)),
            hx => hr => gs.scan.u(h2, t2, acc, sg, hx, hn, ha => gs.scan(t2, h2 <> acc, sg, hr, ha)))

# what the digits lemma claims
def gs.Dg(cs: List<&2, Char>) -> Type:
  {T.wf.digits(Laws.abnf.no_us(cs)) == True{} : Bool}

# a DIGIT first
def gs.digits.d(
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  ih: gs.Dg(h2 <> t2)
) -> gs.Dg(hh <> h2 <> t2):
  %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, gs.nous(hh, hx)) :
    {T.wf.digits(Laws.abnf.no_us.pick(_, hh, Laws.abnf.no_us(h2 <> t2))) == True{} : Bool}
  dgs.cons(hh, Laws.abnf.no_us(h2 <> t2), hx, ih)

# an underscore and a DIGIT first
def gs.digits.u(
  +h2: Char,
  +t2: List<&2, Char>,
  +hx: {Char.is_digit(h2) == True{} : Bool},
  ih: gs.Dg(t2)
) -> gs.Dg('_' <> h2 <> t2):
  %Equal.sym(Bool, Laws.abnf.underscore(h2), False{}, gs.nous(h2, hx)) :
    {T.wf.digits(Laws.abnf.no_us.pick(_, h2, Laws.abnf.no_us(t2))) == True{} : Bool}
  dgs.cons(h2, Laws.abnf.no_us(t2), hx, ih)

# the repetition with its underscores removed is digits
def gs.digits(cs: List<&2, Char>, +h: {Laws.abnf.dec_rep(cs) == True{} : Bool}) -> gs.Dg(cs):
  match cs:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          +hx = {gs.dig(hh, h) : {Char.is_digit(hh) == True{} : Bool}}
          %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, gs.nous(hh, hx)) :
            {T.wf.digits(Laws.abnf.no_us.pick(_, hh, "")) == True{} : Bool}
          dgs.cons(hh, "", hx, {==})
        case +h2 <> +t2:
          gs.rep.two(zs => gs.Dg(zs), hh, h2, t2, Laws.abnf.DIGIT(hh), {==}, h,
            hx => hr => gs.digits.d(hh, h2, t2, hx, gs.digits(h2 <> t2, hr)),
            hx => hr => gs.digits.u(h2, t2, hx, gs.digits(t2, hr)))

# what the colon lemma claims
def gs.Cl(cs: List<&2, Char>) -> Type:
  {T.word.colon(cs) == False{} : Bool}

# a DIGIT first
def gs.colon.d(
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  ih: gs.Cl(h2 <> t2)
) -> gs.Cl(hh <> h2 <> t2):
  %Equal.sym(Bool, Char.is_eq(hh, ':'), False{}, dg.nocolon(hh, hx)) :
    {T.word.or(_, T.word.colon(h2 <> t2)) == False{} : Bool}
  ih

# an underscore and a DIGIT first
def gs.colon.u(
  +h2: Char,
  +t2: List<&2, Char>,
  +hx: {Char.is_digit(h2) == True{} : Bool},
  ih: gs.Cl(t2)
) -> gs.Cl('_' <> h2 <> t2):
  %Equal.sym(Bool, Char.is_eq(h2, ':'), False{}, dg.nocolon(h2, hx)) :
    {T.word.or(_, T.word.colon(t2)) == False{} : Bool}
  ih

# the repetition holds no colon
def gs.colon(cs: List<&2, Char>, +h: {Laws.abnf.dec_rep(cs) == True{} : Bool}) -> gs.Cl(cs):
  match cs:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          %Equal.sym(Bool, Char.is_eq(hh, ':'), False{}, dg.nocolon(hh, gs.dig(hh, h))) :
            {T.word.or(_, T.word.colon([])) == False{} : Bool}
          {==}
        case +h2 <> +t2:
          gs.rep.two(zs => gs.Cl(zs), hh, h2, t2, Laws.abnf.DIGIT(hh), {==}, h,
            hx => hr => gs.colon.d(hh, h2, t2, hx, gs.colon(h2 <> t2, hr)),
            hx => hr => gs.colon.u(h2, t2, hx, gs.colon(t2, hr)))

# what the dash lemma claims
def gs.Ds(cs: List<&2, Char>) -> Type:
  {T.word.dash(cs, False{}) == False{} : Bool}

# a DIGIT first
def gs.dash.d(
  +hh: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  ih: gs.Ds(h2 <> t2)
) -> gs.Ds(hh <> h2 <> t2):
  %Equal.sym(Bool, T.word.dash.hit(False{}, hh), False{}, dash.hit.f(False{}, hh, hx)) :
    {T.word.or(_, T.word.dash(h2 <> t2, False{})) == False{} : Bool}
  ih

# an underscore and a DIGIT first
def gs.dash.u(
  +h2: Char,
  +t2: List<&2, Char>,
  +hx: {Char.is_digit(h2) == True{} : Bool},
  ih: gs.Ds(t2)
) -> gs.Ds('_' <> h2 <> t2):
  %Equal.sym(Bool, T.word.dash.hit(False{}, h2), False{}, dash.hit.f(False{}, h2, hx)) :
    {T.word.or(_, T.word.dash(t2, False{})) == False{} : Bool}
  ih

# the repetition holds no dash
def gs.dash(cs: List<&2, Char>, +h: {Laws.abnf.dec_rep(cs) == True{} : Bool}) -> gs.Ds(cs):
  match cs:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          %Equal.sym(Bool, T.word.dash.hit(False{}, hh), False{}, dash.hit.f(False{}, hh, gs.dig(hh, h))) :
            {T.word.or(_, T.word.dash([], False{})) == False{} : Bool}
          {==}
        case +h2 <> +t2:
          gs.rep.two(zs => gs.Ds(zs), hh, h2, t2, Laws.abnf.DIGIT(hh), {==}, h,
            hx => hr => gs.dash.d(hh, h2, t2, hx, gs.dash(h2 <> t2, hr)),
            hx => hr => gs.dash.u(h2, t2, hx, gs.dash(t2, hr)))

# a digit then the repetition holds no colon
def gs.hc(
  +hh: Char,
  +rest: List<&2, Char>,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  +hr: {Laws.abnf.dec_rep(rest) == True{} : Bool}
) -> {T.word.colon(hh <> rest) == False{} : Bool}:
  %Equal.sym(Bool, Char.is_eq(hh, ':'), False{}, dg.nocolon(hh, hx)) :
    {T.word.or(_, T.word.colon(rest)) == False{} : Bool}
  gs.colon(rest, hr)

# and no dash after its first character
def gs.hd1(
  +hh: Char,
  +rest: List<&2, Char>,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  +hr: {Laws.abnf.dec_rep(rest) == True{} : Bool}
) -> {T.word.dash(hh <> rest, False{}) == False{} : Bool}:
  %Equal.sym(Bool, T.word.dash.hit(False{}, hh), False{}, dash.hit.f(False{}, hh, hx)) :
    {T.word.or(_, T.word.dash(rest, False{})) == False{} : Bool}
  gs.dash(rest, hr)

# a word that starts with a plus and a digit is no special: it differs from
# +inf and +nan at the digit, and from the others at the plus
def gs.spec.p(
  +hh: Char,
  +rest: List<&2, Char>,
  +ei: {False{} == Char.is_eq(hh, 'i') : Bool},
  +en: {False{} == Char.is_eq(hh, 'n') : Bool}
) -> {T.word.spec(String.from_list('+' <> hh <> rest)) == T.GotBad{""} : T.Got}:
  Equal.trans(T.Got,
    T.word.spec.inf2(T.str.eq.step(String.from_list(rest), "nf", Char.is_eq(hh, 'i')), False{},
      String.from_list('+' <> hh <> rest)),
    T.word.spec.inf2(False{}, False{}, String.from_list('+' <> hh <> rest)),
    T.GotBad{""},
    Equal.cong(Bool, T.Got, bb => T.word.spec.inf2(bb, False{}, String.from_list('+' <> hh <> rest)),
      T.str.eq.step(String.from_list(rest), "nf", Char.is_eq(hh, 'i')), False{},
      str.eq.off2(String.from_list(rest), "nf", Char.is_eq(hh, 'i'), ei)),
    Equal.cong(Bool, T.Got, bb => T.word.spec.nan2(bb, False{}),
      T.str.eq.step(String.from_list(rest), "an", Char.is_eq(hh, 'n')), False{},
      str.eq.off2(String.from_list(rest), "an", Char.is_eq(hh, 'n'), en)))

# a digit that is no underscore is kept in front of the rest
def gs.nu(
  +hh: Char,
  +tt: List<&2, Char>,
  +hu: {Laws.abnf.underscore(hh) == False{} : Bool}
) -> {SCon{hh, Laws.abnf.no_us(tt)} == Laws.abnf.no_us(hh <> tt) : String}:
  %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, hu) :
    {SCon{hh, Laws.abnf.no_us(tt)} == Laws.abnf.no_us.pick(_, hh, Laws.abnf.no_us(tt)) : String}
  {==}

# after a first digit that is not 0, the scan reads the repetition and
# finishes as the integer, in range
def gs.fin(
  +sg: T.Sign,
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>,
  st0: T.Num,
  +e0: {T.num.step(st0, hh) == ndig(sg, vals([hh])) : T.Num},
  +hx: {Char.is_digit(hh) == True{} : Bool},
  +hz: {Char.is_eq(hh, '0') == False{} : Bool},
  +hr: {Laws.abnf.dec_rep(t1 <> ts) == True{} : Bool},
  +hf: {T.i64.fits(sg, SCon{hh, Laws.abnf.no_us(t1 <> ts)}) == True{} : Bool},
  +cs: List<&2, Char>
) -> {T.num.fin(T.num.go(t1 <> ts, T.num.step(st0, hh)), cs)
  == T.GotVal{T.VInt{sg, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}} : T.Got}:
  Equal.trans(T.Got, T.num.fin(T.num.go(t1 <> ts, T.num.step(st0, hh)), cs),
    T.num.fin(ndig(sg, vals(rev.onto(Laws.abnf.no_us(t1 <> ts), [hh]))), cs),
    T.GotVal{T.VInt{sg, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}},
    Equal.cong(T.Num, T.Got, nn => T.num.fin(nn, cs), T.num.go(t1 <> ts, T.num.step(st0, hh)),
      ndig(sg, vals(rev.onto(Laws.abnf.no_us(t1 <> ts), [hh]))),
      Equal.trans(T.Num, T.num.go(t1 <> ts, T.num.step(st0, hh)), T.num.go(t1 <> ts, ndig(sg, vals([hh]))),
        ndig(sg, vals(rev.onto(Laws.abnf.no_us(t1 <> ts), [hh]))),
        Equal.cong(T.Num, T.Num, nn => T.num.go(t1 <> ts, nn), T.num.step(st0, hh), ndig(sg, vals([hh])), e0),
        gs.scan(t1 <> ts, [hh], sg, hr, nzl.one(hh, hx, hz)))),
    int.fin(sg, hh, Laws.abnf.no_us(t1 <> ts), hx, hz, gs.digits(t1 <> ts, hr), hf, cs))

# the digits are kept in front of the rest, so the bound is the scan's
def gs.hf(
  +sg: T.Sign,
  +hh: Char,
  +tt: List<&2, Char>,
  +hu: {Laws.abnf.underscore(hh) == False{} : Bool},
  +rr: {T.i64.fits(sg, Laws.abnf.no_us(hh <> tt)) == True{} : Bool}
) -> {T.i64.fits(sg, SCon{hh, Laws.abnf.no_us(tt)}) == True{} : Bool}:
  Equal.trans(Bool, T.i64.fits(sg, SCon{hh, Laws.abnf.no_us(tt)}), T.i64.fits(sg, Laws.abnf.no_us(hh <> tt)), True{},
    Equal.cong(String, Bool, ss => T.i64.fits(sg, ss), SCon{hh, Laws.abnf.no_us(tt)}, Laws.abnf.no_us(hh <> tt),
      gs.nu(hh, tt, hu)), rr)

# an unsigned-dec-int of more than one character
def gs.many.u(
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>,
  +hd: {Laws.abnf.digit1_9(hh) == True{} : Bool},
  +hr: {Laws.abnf.dec_rep(t1 <> ts) == True{} : Bool},
  +rr: {T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> t1 <> ts)) == True{} : Bool}
) -> {T.word.val(hh <> t1 <> ts) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us(hh <> t1 <> ts)}} : T.Got}:
  +hx = {gs.d19(hh, hd) : {Char.is_digit(hh) == True{} : Bool}}
  +hz = {gs.d19z(hh, hd) : {Char.is_eq(hh, '0') == False{} : Bool}}
  +hu = {gs.nous(hh, hx) : {Laws.abnf.underscore(hh) == False{} : Bool}}
  %gs.nu(hh, t1 <> ts, hu) : {T.word.val(hh <> t1 <> ts) == T.GotVal{T.VInt{T.Plus{}, _}} : T.Got}
  Equal.trans(T.Got, T.word.val.pick(T.word.special(hh), hh <> t1 <> ts), T.word.val.pick(False{}, hh <> t1 <> ts),
    T.GotVal{T.VInt{T.Plus{}, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}},
    Equal.cong(Bool, T.Got, bb => T.word.val.pick(bb, hh <> t1 <> ts), T.word.special(hh), False{},
      dg.nospec(hh, hx)),
    Equal.trans(T.Got, T.word.route(T.GotBad{""}, T.word.or(T.word.colon(hh <> t1 <> ts),
      T.word.dash(hh <> t1 <> ts, True{})), hh <> t1 <> ts), T.word.num(hh <> t1 <> ts),
      T.GotVal{T.VInt{T.Plus{}, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}},
      route.num(hh <> t1 <> ts, gs.hc(hh, t1 <> ts, hx, hr), gs.dash(t1 <> ts, hr)),
      gs.fin(T.Plus{}, hh, t1, ts, T.num.start(), nw.lead(T.Plus{}, hh, hx, hz), hx, hz, hr,
        gs.hf(T.Plus{}, hh, t1 <> ts, hu, rr), hh <> t1 <> ts)))

# and after a minus
def gs.many.m(
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>,
  +hd: {Laws.abnf.digit1_9(hh) == True{} : Bool},
  +hr: {Laws.abnf.dec_rep(t1 <> ts) == True{} : Bool},
  +rr: {T.i64.fits(T.Minus{}, Laws.abnf.no_us(hh <> t1 <> ts)) == True{} : Bool}
) -> {T.word.val('-' <> hh <> t1 <> ts) == T.GotVal{T.VInt{T.Minus{}, Laws.abnf.no_us(hh <> t1 <> ts)}} : T.Got}:
  +hx = {gs.d19(hh, hd) : {Char.is_digit(hh) == True{} : Bool}}
  +hz = {gs.d19z(hh, hd) : {Char.is_eq(hh, '0') == False{} : Bool}}
  +hu = {gs.nous(hh, hx) : {Laws.abnf.underscore(hh) == False{} : Bool}}
  %gs.nu(hh, t1 <> ts, hu) : {T.word.val('-' <> hh <> t1 <> ts) == T.GotVal{T.VInt{T.Minus{}, _}} : T.Got}
  Equal.trans(T.Got, T.word.route(T.word.spec(String.from_list('-' <> hh <> t1 <> ts)),
    T.word.or(T.word.colon('-' <> hh <> t1 <> ts), T.word.dash('-' <> hh <> t1 <> ts, True{})), '-' <> hh <> t1 <> ts),
    T.word.route(T.GotBad{""}, T.word.or(T.word.colon('-' <> hh <> t1 <> ts), T.word.dash('-' <> hh <> t1 <> ts,
      True{})), '-' <> hh <> t1 <> ts),
    T.GotVal{T.VInt{T.Minus{}, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}},
    Equal.cong(T.Got, T.Got, gg => T.word.route(gg, T.word.or(T.word.colon('-' <> hh <> t1 <> ts),
      T.word.dash('-' <> hh <> t1 <> ts, True{})), '-' <> hh <> t1 <> ts),
      T.word.spec(String.from_list('-' <> hh <> t1 <> ts)), T.GotBad{""},
      spec.m(hh, t1 <> ts, dg.noi(hh, hx), dg.non(hh, hx))),
    Equal.trans(T.Got, T.word.route(T.GotBad{""}, T.word.or(T.word.colon('-' <> hh <> t1 <> ts),
      T.word.dash('-' <> hh <> t1 <> ts, True{})), '-' <> hh <> t1 <> ts), T.word.num('-' <> hh <> t1 <> ts),
      T.GotVal{T.VInt{T.Minus{}, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}},
      route.num('-' <> hh <> t1 <> ts, gs.hc(hh, t1 <> ts, hx, hr), gs.hd1(hh, t1 <> ts, hx, hr)),
      gs.fin(T.Minus{}, hh, t1, ts, T.Num{T.NSign{}, T.Minus{}, 10, [], False{}, False{}, ""},
        nw.sign(T.Minus{}, hh, hx, hz), hx, hz, hr, gs.hf(T.Minus{}, hh, t1 <> ts, hu, rr),
        '-' <> hh <> t1 <> ts)))

# and after a plus
def gs.many.p(
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>,
  +hd: {Laws.abnf.digit1_9(hh) == True{} : Bool},
  +hr: {Laws.abnf.dec_rep(t1 <> ts) == True{} : Bool},
  +rr: {T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> t1 <> ts)) == True{} : Bool}
) -> {T.word.val('+' <> hh <> t1 <> ts) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us(hh <> t1 <> ts)}} : T.Got}:
  +hx = {gs.d19(hh, hd) : {Char.is_digit(hh) == True{} : Bool}}
  +hz = {gs.d19z(hh, hd) : {Char.is_eq(hh, '0') == False{} : Bool}}
  +hu = {gs.nous(hh, hx) : {Laws.abnf.underscore(hh) == False{} : Bool}}
  %gs.nu(hh, t1 <> ts, hu) : {T.word.val('+' <> hh <> t1 <> ts) == T.GotVal{T.VInt{T.Plus{}, _}} : T.Got}
  Equal.trans(T.Got, T.word.route(T.word.spec(String.from_list('+' <> hh <> t1 <> ts)),
    T.word.or(T.word.colon('+' <> hh <> t1 <> ts), T.word.dash('+' <> hh <> t1 <> ts, True{})), '+' <> hh <> t1 <> ts),
    T.word.route(T.GotBad{""}, T.word.or(T.word.colon('+' <> hh <> t1 <> ts), T.word.dash('+' <> hh <> t1 <> ts,
      True{})), '+' <> hh <> t1 <> ts),
    T.GotVal{T.VInt{T.Plus{}, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}},
    Equal.cong(T.Got, T.Got, gg => T.word.route(gg, T.word.or(T.word.colon('+' <> hh <> t1 <> ts),
      T.word.dash('+' <> hh <> t1 <> ts, True{})), '+' <> hh <> t1 <> ts),
      T.word.spec(String.from_list('+' <> hh <> t1 <> ts)), T.GotBad{""},
      gs.spec.p(hh, t1 <> ts, dg.noi(hh, hx), dg.non(hh, hx))),
    Equal.trans(T.Got, T.word.route(T.GotBad{""}, T.word.or(T.word.colon('+' <> hh <> t1 <> ts),
      T.word.dash('+' <> hh <> t1 <> ts, True{})), '+' <> hh <> t1 <> ts), T.word.num('+' <> hh <> t1 <> ts),
      T.GotVal{T.VInt{T.Plus{}, SCon{hh, Laws.abnf.no_us(t1 <> ts)}}},
      route.num('+' <> hh <> t1 <> ts, gs.hc(hh, t1 <> ts, hx, hr), gs.hd1(hh, t1 <> ts, hx, hr)),
      gs.fin(T.Plus{}, hh, t1, ts, T.Num{T.NSign{}, T.Plus{}, 10, [], False{}, False{}, ""},
        nw.sign(T.Plus{}, hh, hx, hz), hx, hz, hr, gs.hf(T.Plus{}, hh, t1 <> ts, hu, rr),
        '+' <> hh <> t1 <> ts)))

# a lone DIGIT, with no sign, a minus or a plus: a fixed text for each digit
def gs.one.u(
  hh: Char,
  hx: {Char.is_digit(hh) == True{} : Bool}
) -> {T.word.val([hh]) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us([hh])}} : T.Got}:
  dg.elim(zz => {T.word.val([zz]) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us([zz])}} : T.Got}, hh, hx,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# after a minus
def gs.one.m(
  hh: Char,
  hx: {Char.is_digit(hh) == True{} : Bool}
) -> {T.word.val(['-', hh]) == T.GotVal{T.VInt{T.Minus{}, Laws.abnf.no_us([hh])}} : T.Got}:
  dg.elim(zz => {T.word.val(['-', zz]) == T.GotVal{T.VInt{T.Minus{}, Laws.abnf.no_us([zz])}} : T.Got}, hh, hx,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# after a plus
def gs.one.p(
  hh: Char,
  hx: {Char.is_digit(hh) == True{} : Bool}
) -> {T.word.val(['+', hh]) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us([hh])}} : T.Got}:
  dg.elim(zz => {T.word.val(['+', zz]) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us([zz])}} : T.Got}, hh, hx,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a lone character that is an unsigned-dec-int is a DIGIT
def gs.body.z(
  +hh: Char,
  +ed: {Laws.abnf.DIGIT(hh) == False{} : Bool}
) -> {False{} == Laws.abnf.unsigned_dec_int([hh]) : Bool}:
  %Equal.sym(Bool, Laws.abnf.DIGIT(hh), False{}, ed) : {False{} == Bool.or(Bool.and(_, True{}),
    Bool.and(Laws.abnf.digit1_9(hh), False{})) : Bool}
  Equal.sym(Bool, Bool.and(Laws.abnf.digit1_9(hh), False{}), False{}, gs.andf(Laws.abnf.digit1_9(hh)))

# so it is a digit
def gs.body.one(
  +hh: Char,
  dd: Bool,
  +ed: {Laws.abnf.DIGIT(hh) == dd : Bool},
  +hu: {Laws.abnf.unsigned_dec_int([hh]) == True{} : Bool}
) -> {Char.is_digit(hh) == True{} : Bool}:
  match dd:
    case True{}:
      gs.dig(hh, ed)
    case False{}:
      Eq.bit.absurd(&2, {Char.is_digit(hh) == True{} : Bool}, Equal.trans(Bool, False{},
        Laws.abnf.unsigned_dec_int([hh]), True{}, gs.body.z(hh, ed), hu))

# a longer one is a digit1-9 and the repetition
def gs.body.e(
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>
) -> {Bool.and(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep(t1 <> ts)) == Laws.abnf.unsigned_dec_int(hh <> t1 <> ts)
  : Bool}:
  %Equal.sym(Bool, Bool.and(Laws.abnf.DIGIT(hh), False{}), False{}, gs.andf(Laws.abnf.DIGIT(hh))) :
    {Bool.and(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep(t1 <> ts)) == Bool.or(_, Bool.and(Laws.abnf.digit1_9(hh),
    Laws.abnf.dec_rep(t1 <> ts))) : Bool}
  {==}

# so a longer one's first character is a digit1-9
def gs.body.l(
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>,
  hu: {Laws.abnf.unsigned_dec_int(hh <> t1 <> ts) == True{} : Bool}
) -> {Laws.abnf.digit1_9(hh) == True{} : Bool}:
  Eq.and.left(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep(t1 <> ts), Equal.trans(Bool, Bool.and(Laws.abnf.digit1_9(hh),
    Laws.abnf.dec_rep(t1 <> ts)), Laws.abnf.unsigned_dec_int(hh <> t1 <> ts), True{}, gs.body.e(hh, t1, ts), hu))

# and the rest is the repetition
def gs.body.r(
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>,
  hu: {Laws.abnf.unsigned_dec_int(hh <> t1 <> ts) == True{} : Bool}
) -> {Laws.abnf.dec_rep(t1 <> ts) == True{} : Bool}:
  Eq.and.right(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep(t1 <> ts), Equal.trans(Bool, Bool.and(Laws.abnf.digit1_9(hh),
    Laws.abnf.dec_rep(t1 <> ts)), Laws.abnf.unsigned_dec_int(hh <> t1 <> ts), True{}, gs.body.e(hh, t1, ts), hu))

# an unsigned-dec-int with no sign: a lone DIGIT, or a digit1-9 and the
# repetition at least once
def gs.uns(
  +hh: Char,
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(hh <> tt) == True{} : Bool},
  +rr: {T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> tt)) == True{} : Bool}
) -> {T.word.val(hh <> tt) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us(hh <> tt)}} : T.Got}:
  match tt:
    case []:
      gs.one.u(hh, gs.body.one(hh, Laws.abnf.DIGIT(hh), {==}, hu))
    case +t1 <> +ts:
      gs.many.u(hh, t1, ts, gs.body.l(hh, t1, ts, hu), gs.body.r(hh, t1, ts, hu), rr)

# after a minus
def gs.neg.go(
  +hh: Char,
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(hh <> tt) == True{} : Bool},
  +rr: {T.i64.fits(T.Minus{}, Laws.abnf.no_us(hh <> tt)) == True{} : Bool}
) -> {T.word.val('-' <> hh <> tt) == T.GotVal{T.VInt{T.Minus{}, Laws.abnf.no_us(hh <> tt)}} : T.Got}:
  match tt:
    case []:
      gs.one.m(hh, gs.body.one(hh, Laws.abnf.DIGIT(hh), {==}, hu))
    case +t1 <> +ts:
      gs.many.m(hh, t1, ts, gs.body.l(hh, t1, ts, hu), gs.body.r(hh, t1, ts, hu), rr)

# a minus and an unsigned-dec-int
def gs.neg(
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(tt) == True{} : Bool},
  +rr: {T.i64.fits(T.Minus{}, Laws.abnf.no_us(tt)) == True{} : Bool}
) -> {T.word.val('-' <> tt) == T.GotVal{T.VInt{T.Minus{}, Laws.abnf.no_us(tt)}} : T.Got}:
  match tt:
    case []:
      Eq.bit.absurd(&2, {T.word.val(['-']) == T.GotVal{T.VInt{T.Minus{}, Laws.abnf.no_us([])}} : T.Got}, hu)
    case +hh <> +tl:
      gs.neg.go(hh, tl, hu, rr)

# after a plus
def gs.pos.go(
  +hh: Char,
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(hh <> tt) == True{} : Bool},
  +rr: {T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> tt)) == True{} : Bool}
) -> {T.word.val('+' <> hh <> tt) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us(hh <> tt)}} : T.Got}:
  match tt:
    case []:
      gs.one.p(hh, gs.body.one(hh, Laws.abnf.DIGIT(hh), {==}, hu))
    case +t1 <> +ts:
      gs.many.p(hh, t1, ts, gs.body.l(hh, t1, ts, hu), gs.body.r(hh, t1, ts, hu), rr)

# a plus and an unsigned-dec-int
def gs.pos(
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(tt) == True{} : Bool},
  +rr: {T.i64.fits(T.Plus{}, Laws.abnf.no_us(tt)) == True{} : Bool}
) -> {T.word.val('+' <> tt) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us(tt)}} : T.Got}:
  match tt:
    case []:
      Eq.bit.absurd(&2, {T.word.val(['+']) == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.no_us([])}} : T.Got}, hu)
    case +hh <> +tl:
      gs.pos.go(hh, tl, hu, rr)

# what the retired dec_int_word claimed of a word
def gs.Goal(cs: List<&2, Char>) -> Type:
  {T.word.val(cs) == T.GotVal{T.VInt{Laws.abnf.dec_sign(cs), Laws.abnf.dec_digits(cs)}} : T.Got}

# with no sign, dec-int is unsigned-dec-int
def gs.top.hu(
  +hh: Char,
  +tt: List<&2, Char>,
  +em: {Laws.abnf.minus(hh) == False{} : Bool},
  +ep: {Laws.abnf.plus(hh) == False{} : Bool}
) -> {Laws.abnf.unsigned_dec_int(hh <> tt) == Laws.abnf.dec_int(hh <> tt) : Bool}:
  %Equal.sym(Bool, Laws.abnf.minus(hh), False{}, em) : {Laws.abnf.unsigned_dec_int(hh <> tt)
    == Bool.or(Bool.and(Bool.or(_, Laws.abnf.plus(hh)), Laws.abnf.unsigned_dec_int(tt)),
    Laws.abnf.unsigned_dec_int(hh <> tt)) : Bool}
  %Equal.sym(Bool, Laws.abnf.plus(hh), False{}, ep) : {Laws.abnf.unsigned_dec_int(hh <> tt)
    == Bool.or(Bool.and(Bool.or(False{}, _), Laws.abnf.unsigned_dec_int(tt)),
    Laws.abnf.unsigned_dec_int(hh <> tt)) : Bool}
  {==}

# and it reads as plus, all its characters kept but the underscores
def gs.top.r(
  +hh: Char,
  +tt: List<&2, Char>,
  +em: {Laws.abnf.minus(hh) == False{} : Bool},
  +ep: {Laws.abnf.plus(hh) == False{} : Bool}
) -> {T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> tt))
  == T.i64.fits(Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)) : Bool}:
  %Equal.sym(Bool, Laws.abnf.minus(hh), False{}, em) : {T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> tt))
    == T.i64.fits(Laws.abnf.sign.pick(_), Laws.abnf.digits.pick(Bool.or(_, Laws.abnf.plus(hh)), hh, tt)) : Bool}
  %Equal.sym(Bool, Laws.abnf.plus(hh), False{}, ep) : {T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> tt))
    == T.i64.fits(T.Plus{}, Laws.abnf.digits.pick(Bool.or(False{}, _), hh, tt)) : Bool}
  {==}

# by the first character: a minus, a plus, or the first digit
def gs.top(
  +hh: Char,
  +tt: List<&2, Char>,
  mm: Bool,
  +em: {Laws.abnf.minus(hh) == mm : Bool},
  pp: Bool,
  +ep: {Laws.abnf.plus(hh) == pp : Bool},
  +h: {Laws.abnf.dec_int(hh <> tt) == True{} : Bool},
  +rr: {T.i64.fits(Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)) == True{} : Bool}
) -> gs.Goal(hh <> tt):
  match mm:
    case True{}:
      +ee = {Equal.sym(Char, hh, '-', gs.minus(hh, em)) : {'-' == hh : Char}}
      %ee : gs.Goal(_ <> tt)
      gs.neg(tt, or.fl(Laws.abnf.unsigned_dec_int(tt), Equal.trans(Bool, Laws.abnf.dec_int('-' <> tt),
        Laws.abnf.dec_int(hh <> tt), True{}, Equal.cong(Char, Bool, cc => Laws.abnf.dec_int(cc <> tt), '-', hh, ee),
        h)), Equal.trans(Bool, T.i64.fits(Laws.abnf.dec_sign('-' <> tt), Laws.abnf.dec_digits('-' <> tt)),
        T.i64.fits(Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)), True{},
        Equal.cong(Char, Bool, cc => T.i64.fits(Laws.abnf.dec_sign(cc <> tt), Laws.abnf.dec_digits(cc <> tt)), '-',
          hh, ee), rr))
    case False{}:
      match pp:
        case True{}:
          +ee = {Equal.sym(Char, hh, '+', gs.plus(hh, ep)) : {'+' == hh : Char}}
          %ee : gs.Goal(_ <> tt)
          gs.pos(tt, or.fl(Laws.abnf.unsigned_dec_int(tt), Equal.trans(Bool, Laws.abnf.dec_int('+' <> tt),
            Laws.abnf.dec_int(hh <> tt), True{}, Equal.cong(Char, Bool, cc => Laws.abnf.dec_int(cc <> tt), '+', hh,
            ee), h)), Equal.trans(Bool, T.i64.fits(Laws.abnf.dec_sign('+' <> tt), Laws.abnf.dec_digits('+' <> tt)),
            T.i64.fits(Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)), True{},
            Equal.cong(Char, Bool, cc => T.i64.fits(Laws.abnf.dec_sign(cc <> tt), Laws.abnf.dec_digits(cc <> tt)),
              '+', hh, ee), rr))
        case False{}:
          %Equal.sym(Bool, Laws.abnf.minus(hh), False{}, em) : {T.word.val(hh <> tt)
            == T.GotVal{T.VInt{Laws.abnf.sign.pick(_), Laws.abnf.digits.pick(Bool.or(_, Laws.abnf.plus(hh)), hh,
            tt)}} : T.Got}
          %Equal.sym(Bool, Laws.abnf.plus(hh), False{}, ep) : {T.word.val(hh <> tt)
            == T.GotVal{T.VInt{T.Plus{}, Laws.abnf.digits.pick(Bool.or(False{}, _), hh, tt)}} : T.Got}
          gs.uns(hh, tt, Equal.trans(Bool, Laws.abnf.unsigned_dec_int(hh <> tt), Laws.abnf.dec_int(hh <> tt), True{},
            gs.top.hu(hh, tt, em, ep), h), Equal.trans(Bool, T.i64.fits(T.Plus{}, Laws.abnf.no_us(hh <> tt)),
            T.i64.fits(Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)), True{},
            gs.top.r(hh, tt, em, ep), rr))

# GRAMMAR: the basic facts of the transcription (WP-G). The text lemmas say
# that each def of g.text writes its part before the tail it is given, so a
# derivation's text is its parts' texts one after another.

def Laws.gap_is_ws(gs):
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          Laws.gap_is_ws(rest)
        case False{}:
          Laws.gap_is_ws(rest)

def Laws.g_lines_text_append(xs, ys, tail):
  match xs:
    case []:
      {==}
    case Laws.GLine{+nl, +ex} <> rest:
      Equal.cong(String, String, zz => String.append(nl, Laws.g.expr.text(ex, zz)),
        Laws.g.lines.text(List.append(&2, Laws.GLine, rest, ys), tail),
        Laws.g.lines.text(rest, Laws.g.lines.text(ys, tail)), Laws.g_lines_text_append(rest, ys, tail))

# what the text lemmas claim: a part written before the tail is the part
# written before nothing, then the tail
def gt.T(fa: String, fb: String, tail: String) -> Type:
  {fa == String.append(fb, tail) : String}

# f(x, g(y, t)) is f(x, g(y, "")) then t, when f and g each write their text
# before the tail they are given: pre is f's text alone, and gt and g0 are
# g's before t and before nothing
def gt.step(
  +fa: String,
  +fb: String,
  +pre: String,
  +gt: String,
  +g0: String,
  +tail: String,
  e1: {fa == String.append(pre, gt) : String},
  e2: {gt == String.append(g0, tail) : String},
  e3: {fb == String.append(pre, g0) : String}
) -> gt.T(fa, fb, tail):
  Equal.trans(String, fa, String.append(pre, gt), String.append(fb, tail), e1,
    Equal.trans(String, String.append(pre, gt), String.append(pre, String.append(g0, tail)),
      String.append(fb, tail),
      Equal.cong(String, String, zz => String.append(pre, zz), gt, String.append(g0, tail), e2),
      Equal.trans(String, String.append(pre, String.append(g0, tail)), String.append(String.append(pre, g0), tail),
        String.append(fb, tail),
        Equal.sym(String, String.append(String.append(pre, g0), tail), String.append(pre, String.append(g0, tail)),
          Eq.append_assoc(pre, g0, tail)),
        Equal.cong(String, String, zz => String.append(zz, tail), String.append(pre, g0), fb,
          Equal.sym(String, fb, String.append(pre, g0), e3)))))

# a text in front of a part
def gt.app(
  +ss: String,
  +xa: String,
  +xb: String,
  +tail: String,
  ee: gt.T(xa, xb, tail)
) -> gt.T(String.append(ss, xa), String.append(ss, xb), tail):
  gt.step(String.append(ss, xa), String.append(ss, xb), ss, xa, xb, tail, {==}, ee, {==})

# a character in front of a part
def gt.cons(
  +cc: Char,
  +xa: String,
  +xb: String,
  +tail: String,
  ee: gt.T(xa, xb, tail)
) -> gt.T(SCon{cc, xa}, SCon{cc, xb}, tail):
  Equal.cong(String, String, zz => SCon{cc, zz}, xa, String.append(xb, tail), ee)

# a text written with nothing after it
def gt.nil(+ss: String, +tail: String) -> gt.T(String.append(ss, tail), String.append(ss, ""), tail):
  Equal.cong(String, String, zz => String.append(zz, tail), ss, String.append(ss, ""),
    Equal.sym(String, String.append(ss, ""), ss, Eq.append_nil(ss)))

# a basic string's piece
def gt.pc(pp: Laws.KPiece, +tail: String) -> gt.T(Laws.k3.pc.text(pp, tail), Laws.k3.pc.text(pp, ""), tail):
  match pp:
    case Laws.KpChar{_c}:
      {==}
    case Laws.KpEsc{_m}:
      {==}
    case Laws.KpU4{_d, _c, _b, _a}:
      {==}
    case Laws.KpU8{_h, _g, _f, _e, _d, _c, _b, _a}:
      {==}

# a basic string's pieces
def gt.pcs(
  ps: List<&2, Laws.KPiece>,
  +tail: String
) -> gt.T(Laws.k3.pcs.text(ps, tail), Laws.k3.pcs.text(ps, ""), tail):
  match ps:
    case []:
      {==}
    case +pp <> +rest:
      gt.step(Laws.k3.pc.text(pp, Laws.k3.pcs.text(rest, tail)), Laws.k3.pc.text(pp, Laws.k3.pcs.text(rest, "")),
        Laws.k3.pc.text(pp, ""), Laws.k3.pcs.text(rest, tail), Laws.k3.pcs.text(rest, ""), tail,
        gt.pc(pp, Laws.k3.pcs.text(rest, tail)), gt.pcs(rest, tail), gt.pc(pp, Laws.k3.pcs.text(rest, "")))

# pieces before a closing character
def gt.pcs.close(
  +ps: List<&2, Laws.KPiece>,
  +cc: Char,
  +tail: String
) -> gt.T(Laws.k3.pcs.text(ps, SCon{cc, tail}), Laws.k3.pcs.text(ps, SCon{cc, ""}), tail):
  gt.step(Laws.k3.pcs.text(ps, SCon{cc, tail}), Laws.k3.pcs.text(ps, SCon{cc, ""}), Laws.k3.pcs.text(ps, ""),
    SCon{cc, tail}, SCon{cc, ""}, tail, gt.pcs(ps, SCon{cc, tail}), {==}, gt.pcs(ps, SCon{cc, ""}))

# a simple-key
def gt.seg(sg: Laws.KSeg, +tail: String) -> gt.T(Laws.k3.seg.text(sg, tail), Laws.k3.seg.text(sg, ""), tail):
  match sg:
    case Laws.KsBare{+name}:
      gt.nil(name, tail)
    case Laws.KsBasic{+pl}:
      gt.cons('"', Laws.k3.pcs.text(pl, SCon{'"', tail}), Laws.k3.pcs.text(pl, SCon{'"', ""}), tail,
        gt.pcs.close(pl, '"', tail))
    case Laws.KsLit{+name}:
      gt.cons('\'', String.append(name, SCon{'\'', tail}), String.append(name, SCon{'\'', ""}), tail,
        gt.app(name, SCon{'\'', tail}, SCon{'\'', ""}, tail, {==}))

# a key's dot-seps and simple-keys after its first
def gt.dots(
  ds: List<&2, Laws.GDotSep>,
  +tail: String
) -> gt.T(Laws.g.dots.text(ds, tail), Laws.g.dots.text(ds, ""), tail):
  match ds:
    case []:
      {==}
    case Laws.GDotSep{+w1, +w2, +sk} <> +rest:
      +xa = Laws.k3.seg.text(sk, Laws.g.dots.text(rest, tail))
      +xb = Laws.k3.seg.text(sk, Laws.g.dots.text(rest, ""))
      gt.app(w1, SCon{'.', String.append(w2, xa)}, SCon{'.', String.append(w2, xb)}, tail,
        gt.cons('.', String.append(w2, xa), String.append(w2, xb), tail,
          gt.app(w2, xa, xb, tail,
            gt.step(xa, xb, Laws.k3.seg.text(sk, ""), Laws.g.dots.text(rest, tail), Laws.g.dots.text(rest, ""), tail,
              gt.seg(sk, Laws.g.dots.text(rest, tail)), gt.dots(rest, tail), gt.seg(sk, Laws.g.dots.text(rest, ""))))))

# a key
def gt.key(kk: Laws.GKey, +tail: String) -> gt.T(Laws.g.key.text(kk, tail), Laws.g.key.text(kk, ""), tail):
  match kk:
    case Laws.GSimpleKey{sk}:
      gt.seg(sk, tail)
    case Laws.GDottedKey{+sk, +more}:
      gt.step(Laws.k3.seg.text(sk, Laws.g.dots.text(more, tail)), Laws.k3.seg.text(sk, Laws.g.dots.text(more, "")),
        Laws.k3.seg.text(sk, ""), Laws.g.dots.text(more, tail), Laws.g.dots.text(more, ""), tail,
        gt.seg(sk, Laws.g.dots.text(more, tail)), gt.dots(more, tail), gt.seg(sk, Laws.g.dots.text(more, "")))

# a comment, if there is one
def gt.com(cm: Laws.GCom, +tail: String) -> gt.T(Laws.g.com.text(cm, tail), Laws.g.com.text(cm, ""), tail):
  match cm:
    case Laws.GcNone{}:
      {==}
    case Laws.GcSome{+body}:
      gt.cons('#', String.append(body, tail), String.append(body, ""), tail, gt.nil(body, tail))

# ws-comment-newline
def gt.wcn(
  ws: List<&2, Laws.GWcn>,
  +tail: String
) -> gt.T(Laws.g.wcn.text(ws, tail), Laws.g.wcn.text(ws, ""), tail):
  match ws:
    case []:
      {==}
    case Laws.GwWschar{+cc} <> +rest:
      gt.cons(cc, Laws.g.wcn.text(rest, tail), Laws.g.wcn.text(rest, ""), tail, gt.wcn(rest, tail))
    case Laws.GwNewline{+com, +nl} <> +rest:
      +xa = String.append(nl, Laws.g.wcn.text(rest, tail))
      +xb = String.append(nl, Laws.g.wcn.text(rest, ""))
      gt.step(Laws.g.com.text(com, xa), Laws.g.com.text(com, xb), Laws.g.com.text(com, ""), xa, xb, tail,
        gt.com(com, xa), gt.app(nl, Laws.g.wcn.text(rest, tail), Laws.g.wcn.text(rest, ""), tail, gt.wcn(rest, tail)),
        gt.com(com, xb))

# ws-comment-newline before a text
def gt.wcn.before(
  +ws: List<&2, Laws.GWcn>,
  +xa: String,
  +xb: String,
  +tail: String,
  ee: gt.T(xa, xb, tail)
) -> gt.T(Laws.g.wcn.text(ws, xa), Laws.g.wcn.text(ws, xb), tail):
  gt.step(Laws.g.wcn.text(ws, xa), Laws.g.wcn.text(ws, xb), Laws.g.wcn.text(ws, ""), xa, xb, tail,
    gt.wcn(ws, xa), ee, gt.wcn(ws, xb))

# one or two quotes
def gt.quotes(
  two: Bool,
  +qc: Char,
  +tail: String
) -> gt.T(Laws.g.quotes.text(two, qc, tail), Laws.g.quotes.text(two, qc, ""), tail):
  match two:
    case True{}:
      {==}
    case False{}:
      {==}

# a multi-line basic body
def gt.mlb(
  ps: List<&2, Laws.GMlb>,
  +tail: String
) -> gt.T(Laws.g.mlb.text(ps, tail), Laws.g.mlb.text(ps, ""), tail):
  match ps:
    case []:
      {==}
    case Laws.GmChar{+kp} <> +rest:
      gt.step(Laws.k3.pc.text(kp, Laws.g.mlb.text(rest, tail)), Laws.k3.pc.text(kp, Laws.g.mlb.text(rest, "")),
        Laws.k3.pc.text(kp, ""), Laws.g.mlb.text(rest, tail), Laws.g.mlb.text(rest, ""), tail,
        gt.pc(kp, Laws.g.mlb.text(rest, tail)), gt.mlb(rest, tail), gt.pc(kp, Laws.g.mlb.text(rest, "")))
    case Laws.GmNewline{+nl} <> +rest:
      gt.app(nl, Laws.g.mlb.text(rest, tail), Laws.g.mlb.text(rest, ""), tail, gt.mlb(rest, tail))
    case Laws.GmEscapedNl{+w1, +nl, +more} <> +rest:
      +ma = String.append(more, Laws.g.mlb.text(rest, tail))
      +mb = String.append(more, Laws.g.mlb.text(rest, ""))
      gt.cons('\\', String.append(w1, String.append(nl, ma)), String.append(w1, String.append(nl, mb)), tail,
        gt.app(w1, String.append(nl, ma), String.append(nl, mb), tail,
          gt.app(nl, ma, mb, tail,
            gt.app(more, Laws.g.mlb.text(rest, tail), Laws.g.mlb.text(rest, ""), tail, gt.mlb(rest, tail)))))
    case Laws.GmQuotes{+two} <> +rest:
      gt.step(Laws.g.quotes.text(two, '"', Laws.g.mlb.text(rest, tail)),
        Laws.g.quotes.text(two, '"', Laws.g.mlb.text(rest, "")), Laws.g.quotes.text(two, '"', ""),
        Laws.g.mlb.text(rest, tail), Laws.g.mlb.text(rest, ""), tail,
        gt.quotes(two, '"', Laws.g.mlb.text(rest, tail)), gt.mlb(rest, tail),
        gt.quotes(two, '"', Laws.g.mlb.text(rest, "")))

# a multi-line literal body
def gt.mll(
  ps: List<&2, Laws.GMll>,
  +tail: String
) -> gt.T(Laws.g.mll.text(ps, tail), Laws.g.mll.text(ps, ""), tail):
  match ps:
    case []:
      {==}
    case Laws.GlChar{+cc} <> +rest:
      gt.cons(cc, Laws.g.mll.text(rest, tail), Laws.g.mll.text(rest, ""), tail, gt.mll(rest, tail))
    case Laws.GlNewline{+nl} <> +rest:
      gt.app(nl, Laws.g.mll.text(rest, tail), Laws.g.mll.text(rest, ""), tail, gt.mll(rest, tail))
    case Laws.GlQuotes{+two} <> +rest:
      gt.step(Laws.g.quotes.text(two, '\'', Laws.g.mll.text(rest, tail)),
        Laws.g.quotes.text(two, '\'', Laws.g.mll.text(rest, "")), Laws.g.quotes.text(two, '\'', ""),
        Laws.g.mll.text(rest, tail), Laws.g.mll.text(rest, ""), tail,
        gt.quotes(two, '\'', Laws.g.mll.text(rest, tail)), gt.mll(rest, tail),
        gt.quotes(two, '\'', Laws.g.mll.text(rest, "")))

# three delimiter characters and a tail
def gt.delim(+qc: Char, +tail: String) -> String:
  SCon{qc, SCon{qc, SCon{qc, tail}}}

# a string, with its delimiters
def gt.str(st: Laws.GString, +tail: String) -> gt.T(Laws.g.str.text(st, tail), Laws.g.str.text(st, ""), tail):
  match st:
    case Laws.GsMlBasic{+nl, +body}:
      +ba = Laws.g.mlb.text(body, gt.delim('"', tail))
      +bb = Laws.g.mlb.text(body, gt.delim('"', ""))
      gt.cons('"', SCon{'"', SCon{'"', String.append(nl, ba)}}, SCon{'"', SCon{'"', String.append(nl, bb)}}, tail,
        gt.cons('"', SCon{'"', String.append(nl, ba)}, SCon{'"', String.append(nl, bb)}, tail,
          gt.cons('"', String.append(nl, ba), String.append(nl, bb), tail,
            gt.app(nl, ba, bb, tail,
              gt.step(ba, bb, Laws.g.mlb.text(body, ""), gt.delim('"', tail), gt.delim('"', ""), tail,
                gt.mlb(body, gt.delim('"', tail)), {==}, gt.mlb(body, gt.delim('"', "")))))))
    case Laws.GsBasic{+pl}:
      gt.cons('"', Laws.k3.pcs.text(pl, SCon{'"', tail}), Laws.k3.pcs.text(pl, SCon{'"', ""}), tail,
        gt.pcs.close(pl, '"', tail))
    case Laws.GsMlLiteral{+nl, +body}:
      +ba = Laws.g.mll.text(body, gt.delim('\'', tail))
      +bb = Laws.g.mll.text(body, gt.delim('\'', ""))
      gt.cons('\'', SCon{'\'', SCon{'\'', String.append(nl, ba)}}, SCon{'\'', SCon{'\'', String.append(nl, bb)}},
        tail,
        gt.cons('\'', SCon{'\'', String.append(nl, ba)}, SCon{'\'', String.append(nl, bb)}, tail,
          gt.cons('\'', String.append(nl, ba), String.append(nl, bb), tail,
            gt.app(nl, ba, bb, tail,
              gt.step(ba, bb, Laws.g.mll.text(body, ""), gt.delim('\'', tail), gt.delim('\'', ""), tail,
                gt.mll(body, gt.delim('\'', tail)), {==}, gt.mll(body, gt.delim('\'', "")))))))
    case Laws.GsLiteral{+text}:
      gt.cons('\'', String.append(text, SCon{'\'', tail}), String.append(text, SCon{'\'', ""}), tail,
        gt.app(text, SCon{'\'', tail}, SCon{'\'', ""}, tail, {==}))

# [ array-sep ]
def gt.sep(sep: Bool, +tail: String) -> gt.T(Laws.g.sep.text(sep, tail), Laws.g.sep.text(sep, ""), tail):
  match sep:
    case True{}:
      {==}
    case False{}:
      {==}

# a value before a text
def gt.val.before(
  +vv: Laws.GVal,
  +xa: String,
  +xb: String,
  +tail: String,
  ee: gt.T(xa, xb, tail),
  ea: gt.T(Laws.g.val.text(vv, xa), Laws.g.val.text(vv, ""), xa),
  eb: gt.T(Laws.g.val.text(vv, xb), Laws.g.val.text(vv, ""), xb)
) -> gt.T(Laws.g.val.text(vv, xa), Laws.g.val.text(vv, xb), tail):
  gt.step(Laws.g.val.text(vv, xa), Laws.g.val.text(vv, xb), Laws.g.val.text(vv, ""), xa, xb, tail, ea, ee, eb)

def Laws.g_val_text_tail(vv, tail):
  match vv:
    case Laws.GvString{st}:
      gt.str(st, tail)
    case Laws.GvBoolean{+cs}:
      gt.nil(String.from_list(cs), tail)
    case Laws.GvArrayEmpty{+wn}:
      gt.cons('[', Laws.g.wcn.text(wn, SCon{']', tail}), Laws.g.wcn.text(wn, SCon{']', ""}), tail,
        gt.wcn.before(wn, SCon{']', tail}, SCon{']', ""}, tail, {==}))
    case Laws.GvArray{+vals, +wn}:
      +wa = Laws.g.wcn.text(wn, SCon{']', tail})
      +wb = Laws.g.wcn.text(wn, SCon{']', ""})
      gt.cons('[', Laws.g.val.text(vals, wa), Laws.g.val.text(vals, wb), tail,
        gt.val.before(vals, wa, wb, tail, gt.wcn.before(wn, SCon{']', tail}, SCon{']', ""}, tail, {==}),
          Laws.g_val_text_tail(vals, wa), Laws.g_val_text_tail(vals, wb)))
    case Laws.GvInlineTableEmpty{+w1, +w2}:
      gt.cons('{', String.append(w1, String.append(w2, SCon{'}', tail})),
        String.append(w1, String.append(w2, SCon{'}', ""})), tail,
        gt.app(w1, String.append(w2, SCon{'}', tail}), String.append(w2, SCon{'}', ""}), tail,
          gt.app(w2, SCon{'}', tail}, SCon{'}', ""}, tail, {==})))
    case Laws.GvInlineTable{+w1, +kvs, +w2}:
      +xa = String.append(w2, SCon{'}', tail})
      +xb = String.append(w2, SCon{'}', ""})
      gt.cons('{', String.append(w1, Laws.g.val.text(kvs, xa)), String.append(w1, Laws.g.val.text(kvs, xb)), tail,
        gt.app(w1, Laws.g.val.text(kvs, xa), Laws.g.val.text(kvs, xb), tail,
          gt.val.before(kvs, xa, xb, tail, gt.app(w2, SCon{'}', tail}, SCon{'}', ""}, tail, {==}),
            Laws.g_val_text_tail(kvs, xa), Laws.g_val_text_tail(kvs, xb))))
    case Laws.GvDateTime{+cs}:
      gt.nil(String.from_list(cs), tail)
    case Laws.GvFloat{+cs}:
      gt.nil(String.from_list(cs), tail)
    case Laws.GvInteger{+cs}:
      gt.nil(String.from_list(cs), tail)
    case Laws.GArrayValues{+wa, +val, +wb, +rest}:
      +ra = {SCon{',', Laws.g.val.text(rest, tail)} : String}
      +rb = {SCon{',', Laws.g.val.text(rest, "")} : String}
      ea = gt.cons(',', Laws.g.val.text(rest, tail), Laws.g.val.text(rest, ""), tail,
        Laws.g_val_text_tail(rest, tail))
      +ba = Laws.g.wcn.text(wb, ra)
      +bb = Laws.g.wcn.text(wb, rb)
      gt.wcn.before(wa, Laws.g.val.text(val, ba), Laws.g.val.text(val, bb), tail,
        gt.val.before(val, ba, bb, tail, gt.wcn.before(wb, ra, rb, tail, ea),
          Laws.g_val_text_tail(val, ba), Laws.g_val_text_tail(val, bb)))
    case Laws.GArrayValuesLast{+wa, +val, +wb, +sep}:
      +ba = Laws.g.wcn.text(wb, Laws.g.sep.text(sep, tail))
      +bb = Laws.g.wcn.text(wb, Laws.g.sep.text(sep, ""))
      gt.wcn.before(wa, Laws.g.val.text(val, ba), Laws.g.val.text(val, bb), tail,
        gt.val.before(val, ba, bb, tail,
          gt.wcn.before(wb, Laws.g.sep.text(sep, tail), Laws.g.sep.text(sep, ""), tail, gt.sep(sep, tail)),
          Laws.g_val_text_tail(val, ba), Laws.g_val_text_tail(val, bb)))
    case Laws.GInlineTableKeyvals{+kv, +w1, +w2, +rest}:
      +ra = String.append(w2, Laws.g.val.text(rest, tail))
      +rb = String.append(w2, Laws.g.val.text(rest, ""))
      +xa = String.append(w1, SCon{',', ra})
      +xb = String.append(w1, SCon{',', rb})
      gt.val.before(kv, xa, xb, tail,
        gt.app(w1, SCon{',', ra}, SCon{',', rb}, tail,
          gt.cons(',', ra, rb, tail,
            gt.app(w2, Laws.g.val.text(rest, tail), Laws.g.val.text(rest, ""), tail,
              Laws.g_val_text_tail(rest, tail)))),
        Laws.g_val_text_tail(kv, xa), Laws.g_val_text_tail(kv, xb))
    case Laws.GInlineTableKeyvalsLast{kv}:
      Laws.g_val_text_tail(kv, tail)
    case Laws.GKeyval{+key, +w1, +w2, +val}:
      +ra = String.append(w2, Laws.g.val.text(val, tail))
      +rb = String.append(w2, Laws.g.val.text(val, ""))
      +xa = String.append(w1, SCon{'=', ra})
      +xb = String.append(w1, SCon{'=', rb})
      gt.step(Laws.g.key.text(key, xa), Laws.g.key.text(key, xb), Laws.g.key.text(key, ""), xa, xb, tail,
        gt.key(key, xa),
        gt.app(w1, SCon{'=', ra}, SCon{'=', rb}, tail,
          gt.cons('=', ra, rb, tail,
            gt.app(w2, Laws.g.val.text(val, tail), Laws.g.val.text(val, ""), tail,
              Laws.g_val_text_tail(val, tail)))),
        gt.key(key, xb))

# a table header
def gt.table(tb: Laws.GTable, +tail: String) -> gt.T(Laws.g.table.text(tb, tail), Laws.g.table.text(tb, ""), tail):
  match tb:
    case Laws.GStdTable{+w1, +key, +w2}:
      +xa = String.append(w2, SCon{']', tail})
      +xb = String.append(w2, SCon{']', ""})
      gt.cons('[', String.append(w1, Laws.g.key.text(key, xa)), String.append(w1, Laws.g.key.text(key, xb)), tail,
        gt.app(w1, Laws.g.key.text(key, xa), Laws.g.key.text(key, xb), tail,
          gt.step(Laws.g.key.text(key, xa), Laws.g.key.text(key, xb), Laws.g.key.text(key, ""), xa, xb, tail,
            gt.key(key, xa), gt.app(w2, SCon{']', tail}, SCon{']', ""}, tail, {==}), gt.key(key, xb))))
    case Laws.GArrayTable{+w1, +key, +w2}:
      +xa = String.append(w2, SCon{']', SCon{']', tail}})
      +xb = String.append(w2, SCon{']', SCon{']', ""}})
      gt.cons('[', SCon{'[', String.append(w1, Laws.g.key.text(key, xa))},
        SCon{'[', String.append(w1, Laws.g.key.text(key, xb))}, tail,
        gt.cons('[', String.append(w1, Laws.g.key.text(key, xa)), String.append(w1, Laws.g.key.text(key, xb)), tail,
          gt.app(w1, Laws.g.key.text(key, xa), Laws.g.key.text(key, xb), tail,
            gt.step(Laws.g.key.text(key, xa), Laws.g.key.text(key, xb), Laws.g.key.text(key, ""), xa, xb, tail,
              gt.key(key, xa), gt.app(w2, SCon{']', SCon{']', tail}}, SCon{']', SCon{']', ""}}, tail, {==}),
              gt.key(key, xb)))))

# an expression
def gt.expr(ex: Laws.GExpr, +tail: String) -> gt.T(Laws.g.expr.text(ex, tail), Laws.g.expr.text(ex, ""), tail):
  match ex:
    case Laws.GxBlank{+w1, +com}:
      gt.app(w1, Laws.g.com.text(com, tail), Laws.g.com.text(com, ""), tail, gt.com(com, tail))
    case Laws.GxKeyval{+w1, +kv, +w2, +com}:
      +xa = String.append(w2, Laws.g.com.text(com, tail))
      +xb = String.append(w2, Laws.g.com.text(com, ""))
      gt.app(w1, Laws.g.val.text(kv, xa), Laws.g.val.text(kv, xb), tail,
        gt.val.before(kv, xa, xb, tail, gt.app(w2, Laws.g.com.text(com, tail), Laws.g.com.text(com, ""), tail,
          gt.com(com, tail)), Laws.g_val_text_tail(kv, xa), Laws.g_val_text_tail(kv, xb)))
    case Laws.GxTable{+w1, +tb, +w2, +com}:
      +xa = String.append(w2, Laws.g.com.text(com, tail))
      +xb = String.append(w2, Laws.g.com.text(com, ""))
      gt.app(w1, Laws.g.table.text(tb, xa), Laws.g.table.text(tb, xb), tail,
        gt.step(Laws.g.table.text(tb, xa), Laws.g.table.text(tb, xb), Laws.g.table.text(tb, ""), xa, xb, tail,
          gt.table(tb, xa), gt.app(w2, Laws.g.com.text(com, tail), Laws.g.com.text(com, ""), tail, gt.com(com, tail)),
          gt.table(tb, xb)))

def Laws.g_text_parts(first, rest):
  gt.expr(first, Laws.g.lines.text(rest, ""))

# The word rules are disjoint. A boolean is one of two fixed words. An
# integer or a float's integer part holds only DIGITs and underscores after
# its sign, and a date-time has a - or a : after its first DIGITs, which such
# a word cannot have; the prefixes 0x, 0o and 0b, a sign, and the letters of
# inf and nan are each ruled out by the character where they stand.

# an or that holds: a claim from either half that holds is a claim
def gp.or(
  -P: Type,
  aa: Bool,
  bb: Bool,
  +h: {Bool.or(aa, bb) == True{} : Bool},
  ka: {aa == True{} : Bool} -> P,
  kb: {bb == True{} : Bool} -> P
) -> P:
  match aa:
    case True{}:
      ka({==})
    case False{}:
      kb(h)

# a character a code point test passed is that character
def gp.cp(cc: Char, +nn: U32, +h: {Laws.abnf.cp(cc, nn) == True{} : Bool}) -> {cc == Chr{nn} : Char}:
  match cc:
    case Chr{+cp}:
      Eq.u32_eq(cp, nn, h)

# a claim of what a word is equal to is a claim of the word
def gp.subst(
  -P: List<&2, Char> -> Type,
  +aa: List<&2, Char>,
  +bb: List<&2, Char>,
  ee: {aa == bb : List<&2, Char>},
  pb: P(bb)
) -> P(aa):
  %Equal.sym(List<&2, Char>, aa, bb, ee) : P(_)
  pb

# a claim of the character a word starts with, when it is known
def gp.head(
  -P: List<&2, Char> -> Type,
  +hh: Char,
  +kk: Char,
  +tt: List<&2, Char>,
  ee: {hh == kk : Char},
  pk: P(kk <> tt)
) -> P(hh <> tt):
  %Equal.sym(Char, hh, kk, ee) : P(_ <> tt)
  pk

# a word a %x string matched is that string's characters
def gp.chars(
  cs: List<&2, Char>,
  ss: String,
  +h: {Laws.abnf.chars_are(cs, ss) == True{} : Bool}
) -> {cs == String.to_list(ss) : List<&2, Char>}:
  match cs ss:
    case Nil{} SNil{}:
      {==}
    case +hh <> +tt SCon{+h2, +t2}:
      +e1 = {Eq.char_eq_true(hh, h2, Eq.and.left(Char.is_eq(hh, h2), Laws.abnf.chars_are(tt, t2), h))
        : {hh == h2 : Char}}
      Equal.trans(List<&2, Char>, hh <> tt, h2 <> tt, h2 <> String.to_list(t2),
        Equal.cong(Char, List<&2, Char>, zz => zz <> tt, hh, h2, e1),
        Equal.cong(List<&2, Char>, List<&2, Char>, zz => h2 <> zz, tt, String.to_list(t2),
          gp.chars(tt, t2, Eq.and.right(Char.is_eq(hh, h2), Laws.abnf.chars_are(tt, t2), h))))
    case Nil{} SCon{+xx, +yy}:
      Eq.bit.absurd(&2, {[] == String.to_list(SCon{xx, yy}) : List<&2, Char>}, h)
    case +xx <> +yy SNil{}:
      Eq.bit.absurd(&2, {xx <> yy == String.to_list(SNil{}) : List<&2, Char>}, h)

# a claim of true and of false is a claim of every boolean word
def gp.bool(
  -P: List<&2, Char> -> Type,
  +cs: List<&2, Char>,
  +h: {Laws.abnf.boolean(cs) == True{} : Bool},
  pt: P(String.to_list("true")),
  pf: P(String.to_list("false"))
) -> P(cs):
  gp.or(P(cs), Laws.abnf.true(cs), Laws.abnf.false(cs), h,
    ht => gp.subst(P, cs, String.to_list("true"), gp.chars(cs, "true", ht), pt),
    hf => gp.subst(P, cs, String.to_list("false"), gp.chars(cs, "false", hf), pf))

def Laws.boolean_not_integer(cs, h):
  gp.bool(zs => {Laws.abnf.integer(zs) == False{} : Bool}, cs, h, {==}, {==})

def Laws.boolean_not_float(cs, h):
  gp.bool(zs => {Laws.abnf.float(zs) == False{} : Bool}, cs, h, {==}, {==})

def Laws.boolean_not_date_time(cs, h):
  gp.bool(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, cs, h, {==}, {==})

# a character of a dec-int's digits: a DIGIT or an underscore
def gp.dc(+cc: Char) -> Bool:
  Bool.or(Laws.abnf.DIGIT(cc), Laws.abnf.underscore(cc))

# every character of a word is one
def gp.decs(cs: List<&2, Char>) -> Bool:
  match cs:
    case []:
      True{}
    case hh <> tt:
      Bool.and(gp.dc(hh), gp.decs(tt))

# a claim of the underscore is a claim of what an underscore test passed
def gp.us.elim(
  -P: Char -> Type,
  +cc: Char,
  +h: {Laws.abnf.underscore(cc) == True{} : Bool},
  pu: P('_')
) -> P(cc):
  %Equal.sym(Char, cc, '_', gs.us(cc, h)) : P(_)
  pu

# a claim of each digit and of the underscore is a claim of every such
# character
def gp.dc.elim(
  -P: Char -> Type,
  +cc: Char,
  +h: {gp.dc(cc) == True{} : Bool},
  p0: P('0'),
  p1: P('1'),
  p2: P('2'),
  p3: P('3'),
  p4: P('4'),
  p5: P('5'),
  p6: P('6'),
  p7: P('7'),
  p8: P('8'),
  p9: P('9'),
  pu: P('_')
) -> P(cc):
  gp.or(P(cc), Laws.abnf.DIGIT(cc), Laws.abnf.underscore(cc), h,
    hd => dg.elim(P, cc, gs.dig(cc, hd), p0, p1, p2, p3, p4, p5, p6, p7, p8, p9),
    hu => gp.us.elim(P, cc, hu, pu))

# a DIGIT is such a character
def gp.dc.digit(+cc: Char, +h: {Laws.abnf.DIGIT(cc) == True{} : Bool}) -> {gp.dc(cc) == True{} : Bool}:
  %Equal.sym(Bool, Laws.abnf.DIGIT(cc), True{}, h) : {Bool.or(_, Laws.abnf.underscore(cc)) == True{} : Bool}
  {==}

# so is a digit
def gp.dc.is_digit(+cc: Char, +h: {Char.is_digit(cc) == True{} : Bool}) -> {gp.dc(cc) == True{} : Bool}:
  dg.elim(zz => {gp.dc(zz) == True{} : Bool}, cc, h, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# the repetition *( DIGIT / underscore DIGIT ) holds only such characters
def gp.rep.decs(cs: List<&2, Char>, +h: {Laws.abnf.dec_rep(cs) == True{} : Bool}) -> {gp.decs(cs) == True{} : Bool}:
  match cs:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          and.tt(gp.dc(hh), True{}, gp.dc.digit(hh, h), {==})
        case +h2 <> +t2:
          gs.rep.two(zs => {gp.decs(zs) == True{} : Bool}, hh, h2, t2, Laws.abnf.DIGIT(hh), {==}, h,
            hx => hr => and.tt(gp.dc(hh), gp.decs(h2 <> t2), gp.dc.is_digit(hh, hx), gp.rep.decs(h2 <> t2, hr)),
            hx => hr => and.tt(gp.dc(h2), gp.decs(t2), gp.dc.is_digit(h2, hx), gp.rep.decs(t2, hr)))

# a digit1-9 is a DIGIT
def gp.d19(+cc: Char, +h: {Laws.abnf.digit1_9(cc) == True{} : Bool}) -> {Laws.abnf.DIGIT(cc) == True{} : Bool}:
  dg.elim(zz => {Laws.abnf.DIGIT(zz) == True{} : Bool}, cc, gs.d19(cc, h),
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a DIGIT alone holds only such characters
def gp.one.decs(
  +hh: Char,
  tt: List<&2, Char>,
  +ha: {Bool.and(Laws.abnf.DIGIT(hh), List.is_empty(&2, Char, tt)) == True{} : Bool}
) -> {gp.decs(hh <> tt) == True{} : Bool}:
  match tt:
    case []:
      and.tt(gp.dc(hh), True{}, gp.dc.digit(hh, Eq.and.left(Laws.abnf.DIGIT(hh), True{}, ha)), {==})
    case +xx <> +yy:
      Eq.bit.absurd(&2, {gp.decs(hh <> xx <> yy) == True{} : Bool},
        Eq.and.right(Laws.abnf.DIGIT(hh), False{}, ha))

# a digit1-9 then one or more of the repetition
def gp.many.decs(
  +hh: Char,
  tt: List<&2, Char>,
  +hb: {Bool.and(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep1(tt)) == True{} : Bool}
) -> {gp.decs(hh <> tt) == True{} : Bool}:
  match tt:
    case []:
      Eq.bit.absurd(&2, {gp.decs([hh]) == True{} : Bool}, Eq.and.right(Laws.abnf.digit1_9(hh), False{}, hb))
    case +xx <> +yy:
      and.tt(gp.dc(hh), gp.decs(xx <> yy),
        gp.dc.digit(hh, gp.d19(hh, Eq.and.left(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep(xx <> yy), hb))),
        gp.rep.decs(xx <> yy, Eq.and.right(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep(xx <> yy), hb)))

# an unsigned-dec-int holds only such characters
def gp.udi.decs(
  cs: List<&2, Char>,
  +h: {Laws.abnf.unsigned_dec_int(cs) == True{} : Bool}
) -> {gp.decs(cs) == True{} : Bool}:
  match cs:
    case []:
      Eq.bit.absurd(&2, {gp.decs([]) == True{} : Bool}, h)
    case +hh <> +tt:
      gp.or({gp.decs(hh <> tt) == True{} : Bool}, Bool.and(Laws.abnf.DIGIT(hh), List.is_empty(&2, Char, tt)),
        Bool.and(Laws.abnf.digit1_9(hh), Laws.abnf.dec_rep1(tt)), h,
        ha => gp.one.decs(hh, tt, ha), hb => gp.many.decs(hh, tt, hb))

# whether the first character that is no DIGIT or underscore, if there is
# one, is no - and no : (%x2D is 45, %x3A is 58)
def gp.nd.pick(dc: Bool, +hh: Char, rest: Bool) -> Bool:
  match dc:
    case True{}:
      rest
    case False{}:
      Bool.not(Bool.or(Laws.abnf.cp(hh, 45), Laws.abnf.cp(hh, 58)))

# whether a word's first character that is no DIGIT or underscore is no -
# and no :
def gp.nd(cs: List<&2, Char>) -> Bool:
  match cs:
    case []:
      True{}
    case +hh <> tt:
      gp.nd.pick(gp.dc(hh), hh, gp.nd(tt))

# what is left after DIGITs of such a word is such a word, or no match
def gp.ndr(rr: Laws.ARest) -> Bool:
  match rr:
    case Laws.ALeft{cs}:
      gp.nd(cs)
    case Laws.ANone{}:
      True{}

# a word of only such characters is one
def gp.decs.nd(cs: List<&2, Char>, +h: {gp.decs(cs) == True{} : Bool}) -> {gp.nd(cs) == True{} : Bool}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      %Equal.sym(Bool, gp.dc(hh), True{}, Eq.and.left(gp.dc(hh), gp.decs(tt), h)) :
        {gp.nd.pick(_, hh, gp.nd(tt)) == True{} : Bool}
      gp.decs.nd(tt, Eq.and.right(gp.dc(hh), gp.decs(tt), h))

# its first character is no - and no :
def gp.nd.head(
  +hh: Char,
  +tt: List<&2, Char>,
  dd: Bool,
  +ed: {gp.dc(hh) == dd : Bool},
  +h: {gp.nd(hh <> tt) == True{} : Bool}
) -> {Bool.or(Laws.abnf.cp(hh, 45), Laws.abnf.cp(hh, 58)) == False{} : Bool}:
  match dd:
    case True{}:
      gp.dc.elim(zz => {Bool.or(Laws.abnf.cp(zz, 45), Laws.abnf.cp(zz, 58)) == False{} : Bool}, hh, ed,
        {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})
    case False{}:
      Eq.not.true(Bool.or(Laws.abnf.cp(hh, 45), Laws.abnf.cp(hh, 58)),
        Equal.trans(Bool, gp.nd.pick(False{}, hh, gp.nd(tt)), gp.nd.pick(gp.dc(hh), hh, gp.nd(tt)), True{},
          Equal.cong(Bool, Bool, xx => gp.nd.pick(xx, hh, gp.nd(tt)), False{}, gp.dc(hh),
            Equal.sym(Bool, gp.dc(hh), False{}, ed)), h))

# a DIGIT taken keeps the rest such a word
def gp.ndr.digit.go(
  +hh: Char,
  +tt: List<&2, Char>,
  dd: Bool,
  +ed: {Laws.abnf.DIGIT(hh) == dd : Bool},
  +h: {gp.nd(hh <> tt) == True{} : Bool}
) -> {gp.ndr(Laws.abnf.keep(Laws.abnf.DIGIT(hh), tt)) == True{} : Bool}:
  match dd:
    case True{}:
      %Equal.sym(Bool, Laws.abnf.DIGIT(hh), True{}, ed) : {gp.ndr(Laws.abnf.keep(_, tt)) == True{} : Bool}
      Equal.trans(Bool, gp.nd(tt), gp.nd.pick(gp.dc(hh), hh, gp.nd(tt)), True{},
        Equal.cong(Bool, Bool, xx => gp.nd.pick(xx, hh, gp.nd(tt)), True{}, gp.dc(hh),
          Equal.sym(Bool, gp.dc(hh), True{}, gp.dc.digit(hh, ed))), h)
    case False{}:
      %Equal.sym(Bool, Laws.abnf.DIGIT(hh), False{}, ed) : {gp.ndr(Laws.abnf.keep(_, tt)) == True{} : Bool}
      {==}

# DIGIT from the front keeps such a word such a word
def gp.ndr.digit(rr: Laws.ARest, +h: {gp.ndr(rr) == True{} : Bool}) -> {gp.ndr(Laws.abnf.digit_r(rr)) == True{} : Bool}:
  match rr:
    case Laws.ALeft{cs}:
      match cs:
        case []:
          {==}
        case +hh <> +tt:
          gp.ndr.digit.go(hh, tt, Laws.abnf.DIGIT(hh), {==}, h)
    case Laws.ANone{}:
      {==}

# no - from the front of such a word
def gp.ndr.dash(
  rr: Laws.ARest,
  +h: {gp.ndr(rr) == True{} : Bool}
) -> {Laws.abnf.char_r(rr, 45) == Laws.ANone{} : Laws.ARest}:
  match rr:
    case Laws.ALeft{cs}:
      match cs:
        case []:
          {==}
        case +hh <> +tt:
          %Equal.sym(Bool, Laws.abnf.cp(hh, 45), False{}, Eq.or.false_left(Laws.abnf.cp(hh, 45), Laws.abnf.cp(hh, 58),
            gp.nd.head(hh, tt, gp.dc(hh), {==}, h))) : {Laws.abnf.keep(_, tt) == Laws.ANone{} : Laws.ARest}
          {==}
    case Laws.ANone{}:
      {==}

# no : from the front of such a word
def gp.ndr.colon(
  rr: Laws.ARest,
  +h: {gp.ndr(rr) == True{} : Bool}
) -> {Laws.abnf.char_r(rr, 58) == Laws.ANone{} : Laws.ARest}:
  match rr:
    case Laws.ALeft{cs}:
      match cs:
        case []:
          {==}
        case +hh <> +tt:
          %Equal.sym(Bool, Laws.abnf.cp(hh, 58), False{}, Eq.or.false_right(Laws.abnf.cp(hh, 45), Laws.abnf.cp(hh, 58),
            gp.nd.head(hh, tt, gp.dc(hh), {==}, h))) : {Laws.abnf.keep(_, tt) == Laws.ANone{} : Laws.ARest}
          {==}
    case Laws.ANone{}:
      {==}

# date-time, from what is left after a full-date's first four DIGITs (d4)
# and a partial-time's first two (d2) and the character after each
def gp.dt.g(d4: Laws.ARest, d2: Laws.ARest) -> Bool:
  +fd = Laws.abnf.date_mday(Laws.abnf.char_r(Laws.abnf.date_month(d4), 45))
  Bool.or(Laws.abnf.all_r(Laws.abnf.full_time(Laws.abnf.time_delim(fd))),
    Bool.or(Laws.abnf.all_r(Laws.abnf.partial_time(Laws.abnf.time_delim(fd))), Bool.or(Laws.abnf.all_r(fd),
      Laws.abnf.all_r(Laws.abnf.opt_secfrac(Laws.abnf.time_second(Laws.abnf.char_r(Laws.abnf.time_minute(d2),
      58)))))))

# a word whose first character that is no DIGIT or underscore is no - and
# no : is no date-time: a full-date has a - after four DIGITs, and a
# partial-time a : after two
def gp.nd.dt(+cs: List<&2, Char>, +h: {gp.nd(cs) == True{} : Bool}) -> {Laws.abnf.date_time(cs) == False{} : Bool}:
  +r2 = Laws.abnf.digit_r(Laws.abnf.digit_r(Laws.ALeft{cs}))
  +n2 = gp.ndr.digit(Laws.abnf.digit_r(Laws.ALeft{cs}), gp.ndr.digit(Laws.ALeft{cs}, h))
  +r4 = Laws.abnf.digit_r(Laws.abnf.digit_r(r2))
  Equal.trans(Bool, gp.dt.g(Laws.abnf.char_r(r4, 45), Laws.abnf.char_r(r2, 58)),
    gp.dt.g(Laws.ANone{}, Laws.abnf.char_r(r2, 58)), False{},
    Equal.cong(Laws.ARest, Bool, xx => gp.dt.g(xx, Laws.abnf.char_r(r2, 58)), Laws.abnf.char_r(r4, 45), Laws.ANone{},
      gp.ndr.dash(r4, gp.ndr.digit(Laws.abnf.digit_r(r2), gp.ndr.digit(r2, n2)))),
    Equal.trans(Bool, gp.dt.g(Laws.ANone{}, Laws.abnf.char_r(r2, 58)), gp.dt.g(Laws.ANone{}, Laws.ANone{}), False{},
      Equal.cong(Laws.ARest, Bool, xx => gp.dt.g(Laws.ANone{}, xx), Laws.abnf.char_r(r2, 58), Laws.ANone{},
        gp.ndr.colon(r2, n2)),
      {==}))

# a word that starts with a sign is no date-time
def gp.dt.sign(
  +hh: Char,
  +tt: List<&2, Char>,
  +hs: {Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)) == True{} : Bool}
) -> {Laws.abnf.date_time(hh <> tt) == False{} : Bool}:
  gp.or({Laws.abnf.date_time(hh <> tt) == False{} : Bool}, Laws.abnf.minus(hh), Laws.abnf.plus(hh), hs,
    hm => gp.head(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, hh, '-', tt, gs.minus(hh, hm), {==}),
    hp => gp.head(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, hh, '+', tt, gs.plus(hh, hp), {==}))

# a dec-int is no date-time
def gp.decint.dt(
  cs: List<&2, Char>,
  +h: {Laws.abnf.dec_int(cs) == True{} : Bool}
) -> {Laws.abnf.date_time(cs) == False{} : Bool}:
  match cs:
    case []:
      Eq.bit.absurd(&2, {Laws.abnf.date_time([]) == False{} : Bool}, h)
    case +hh <> +tt:
      gp.or({Laws.abnf.date_time(hh <> tt) == False{} : Bool},
        Bool.and(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)), Laws.abnf.unsigned_dec_int(tt)),
        Laws.abnf.unsigned_dec_int(hh <> tt), h,
        ha => gp.dt.sign(hh, tt, Eq.and.left(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)),
          Laws.abnf.unsigned_dec_int(tt), ha)),
        hb => gp.nd.dt(hh <> tt, gp.decs.nd(hh <> tt, gp.udi.decs(hh <> tt, hb))))

# a prefixed integer's word, taken apart: a claim of each word that starts
# with 0 and the prefix letter ll is a claim of it
def gp.pre.case(
  -P: List<&2, Char> -> Type,
  cs: List<&2, Char>,
  +ll: U32,
  +rx: Laws.ARadix,
  +h: {Laws.abnf.prefixed(cs, ll, rx) == True{} : Bool},
  kk: @c2: Char -> @rest: List<&2, Char> -> P('0' <> Chr{ll} <> c2 <> rest)
) -> P(cs):
  match cs:
    case []:
      Eq.bit.absurd(&1, P([]), h)
    case +c0 <> t0:
      match t0:
        case []:
          Eq.bit.absurd(&1, P([c0]), h)
        case +c1 <> t1:
          match t1:
            case []:
              Eq.bit.absurd(&1, P([c0, c1]), h)
            case +c2 <> +rest:
              +hr = {Bool.and(Laws.abnf.cp(c1, ll), Bool.and(Laws.abnf.radix_digit(rx, c2),
                Laws.abnf.radix_rep(rest, rx))) : Bool}
              +e0 = {gp.cp(c0, 48, Eq.and.left(Laws.abnf.cp(c0, 48), hr, h)) : {c0 == Chr{48} : Char}}
              +e1 = {gp.cp(c1, ll, Eq.and.left(Laws.abnf.cp(c1, ll), Bool.and(Laws.abnf.radix_digit(rx, c2),
                Laws.abnf.radix_rep(rest, rx)), Eq.and.right(Laws.abnf.cp(c0, 48), hr, h))) : {c1 == Chr{ll} : Char}}
              gp.head(P, c0, Chr{48}, c1 <> c2 <> rest, e0,
                gp.head(zs => P(Chr{48} <> zs), c1, Chr{ll}, c2 <> rest, e1, kk(c2, rest)))

def Laws.integer_not_date_time(cs, h):
  gp.or({Laws.abnf.date_time(cs) == False{} : Bool}, Laws.abnf.dec_int(cs),
    Bool.or(Laws.abnf.hex_int(cs), Bool.or(Laws.abnf.oct_int(cs), Laws.abnf.bin_int(cs))), h,
    hd => gp.decint.dt(cs, hd),
    hr => gp.or({Laws.abnf.date_time(cs) == False{} : Bool}, Laws.abnf.hex_int(cs),
      Bool.or(Laws.abnf.oct_int(cs), Laws.abnf.bin_int(cs)), hr,
      hx => gp.pre.case(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, cs, 120, Laws.AHex{}, hx,
        _c => _r => {==}),
      hq => gp.or({Laws.abnf.date_time(cs) == False{} : Bool}, Laws.abnf.oct_int(cs), Laws.abnf.bin_int(cs), hq,
        ho => gp.pre.case(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, cs, 111, Laws.AOct{}, ho,
          _c => _r => {==}),
        hb => gp.pre.case(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, cs, 98, Laws.ABin{}, hb,
          _c => _r => {==}))))

# a word is no float when nothing follows a first decimal-point or e (there
# is none) and it is no special-float
def gp.flo.zero(
  +cs: List<&2, Char>,
  ep: {Laws.abnf.cut.post(cs, Laws.ACutDot{}) == [] : List<&2, Char>},
  es: {Laws.abnf.special_float(cs) == False{} : Bool}
) -> {Laws.abnf.float(cs) == False{} : Bool}:
  +aa = Laws.abnf.dec_int(Laws.abnf.cut.pre(cs, Laws.ACutDot{}))
  +post = Laws.abnf.cut.post(cs, Laws.ACutDot{})
  Equal.trans(Bool, Bool.or(Bool.and(aa, Bool.or(Laws.abnf.exp(post), Laws.abnf.frac_exp(post))),
    Laws.abnf.special_float(cs)), Bool.or(Bool.and(aa, False{}), Laws.abnf.special_float(cs)), False{},
    Equal.cong(List<&2, Char>, Bool, pp => Bool.or(Bool.and(aa, Bool.or(Laws.abnf.exp(pp), Laws.abnf.frac_exp(pp))),
      Laws.abnf.special_float(cs)), post, [], ep),
    Equal.trans(Bool, Bool.or(Bool.and(aa, False{}), Laws.abnf.special_float(cs)),
      Bool.or(Bool.and(aa, False{}), False{}), False{},
      Equal.cong(Bool, Bool, ss => Bool.or(Bool.and(aa, False{}), ss), Laws.abnf.special_float(cs), False{}, es),
      Equal.cong(Bool, Bool, xx => Bool.or(xx, False{}), Bool.and(aa, False{}), False{}, gs.andf(aa))))

# a word of DIGITs and underscores has no decimal-point or e
def gp.decs.post(
  cs: List<&2, Char>,
  +h: {gp.decs(cs) == True{} : Bool}
) -> {Laws.abnf.cut.post(cs, Laws.ACutDot{}) == [] : List<&2, Char>}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      +ec = {gp.dc.elim(zz => {Laws.abnf.cut.at(Laws.ACutDot{}, zz) == False{} : Bool}, hh,
        Eq.and.left(gp.dc(hh), gp.decs(tt), h), {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})
        : {Laws.abnf.cut.at(Laws.ACutDot{}, hh) == False{} : Bool}}
      %Equal.sym(Bool, Laws.abnf.cut.at(Laws.ACutDot{}, hh), False{}, ec) :
        {Laws.abnf.cut.post.pick(_, hh, tt, Laws.abnf.cut.post(tt, Laws.ACutDot{})) == [] : List<&2, Char>}
      gp.decs.post(tt, Eq.and.right(gp.dc(hh), gp.decs(tt), h))

# and it is no inf and no nan
def gp.decs.noinf(
  tt: List<&2, Char>,
  +h: {gp.decs(tt) == True{} : Bool}
) -> {Bool.or(Laws.abnf.inf(tt), Laws.abnf.nan(tt)) == False{} : Bool}:
  match tt:
    case []:
      {==}
    case +xx <> +yy:
      gp.dc.elim(zz => {Bool.or(Laws.abnf.inf(zz <> yy), Laws.abnf.nan(zz <> yy)) == False{} : Bool}, xx,
        Eq.and.left(gp.dc(xx), gp.decs(yy), h), {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# after a sign, a word of DIGITs and underscores is no special-float
def gp.flo.sp(
  +tt: List<&2, Char>,
  +h: {gp.decs(tt) == True{} : Bool}
) -> {Bool.or(Bool.or(Laws.abnf.inf(tt), Laws.abnf.nan(tt)), False{}) == False{} : Bool}:
  Equal.cong(Bool, Bool, xx => Bool.or(xx, False{}), Bool.or(Laws.abnf.inf(tt), Laws.abnf.nan(tt)), False{},
    gp.decs.noinf(tt, h))

# a sign and an unsigned-dec-int is no float
def gp.flo.signed(
  +hh: Char,
  +tt: List<&2, Char>,
  +ha: {Bool.and(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)), Laws.abnf.unsigned_dec_int(tt)) == True{} : Bool}
) -> {Laws.abnf.float(hh <> tt) == False{} : Bool}:
  +hd = {gp.udi.decs(tt, Eq.and.right(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)),
    Laws.abnf.unsigned_dec_int(tt), ha)) : {gp.decs(tt) == True{} : Bool}}
  gp.or({Laws.abnf.float(hh <> tt) == False{} : Bool}, Laws.abnf.minus(hh), Laws.abnf.plus(hh),
    Eq.and.left(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)), Laws.abnf.unsigned_dec_int(tt), ha),
    hm => gp.head(zs => {Laws.abnf.float(zs) == False{} : Bool}, hh, '-', tt, gs.minus(hh, hm),
      gp.flo.zero('-' <> tt, gp.decs.post(tt, hd), gp.flo.sp(tt, hd))),
    hp => gp.head(zs => {Laws.abnf.float(zs) == False{} : Bool}, hh, '+', tt, gs.plus(hh, hp),
      gp.flo.zero('+' <> tt, gp.decs.post(tt, hd), gp.flo.sp(tt, hd))))

# a word of DIGITs and underscores is no float
def gp.flo.unsigned(
  +hh: Char,
  +tt: List<&2, Char>,
  +hd: {gp.decs(hh <> tt) == True{} : Bool}
) -> {Laws.abnf.float(hh <> tt) == False{} : Bool}:
  gp.flo.zero(hh <> tt, gp.decs.post(hh <> tt, hd),
    gp.dc.elim(zz => {Laws.abnf.special_float(zz <> tt) == False{} : Bool}, hh,
      Eq.and.left(gp.dc(hh), gp.decs(tt), hd), {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}))

# a dec-int is no float
def gp.decint.flo(
  cs: List<&2, Char>,
  +h: {Laws.abnf.dec_int(cs) == True{} : Bool}
) -> {Laws.abnf.float(cs) == False{} : Bool}:
  match cs:
    case []:
      Eq.bit.absurd(&2, {Laws.abnf.float([]) == False{} : Bool}, h)
    case +hh <> +tt:
      gp.or({Laws.abnf.float(hh <> tt) == False{} : Bool},
        Bool.and(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)), Laws.abnf.unsigned_dec_int(tt)),
        Laws.abnf.unsigned_dec_int(hh <> tt), h,
        ha => gp.flo.signed(hh, tt, ha),
        hb => gp.flo.unsigned(hh, tt, gp.udi.decs(hh <> tt, hb)))

def Laws.integer_not_float(cs, h):
  gp.or({Laws.abnf.float(cs) == False{} : Bool}, Laws.abnf.dec_int(cs),
    Bool.or(Laws.abnf.hex_int(cs), Bool.or(Laws.abnf.oct_int(cs), Laws.abnf.bin_int(cs))), h,
    hd => gp.decint.flo(cs, hd),
    hr => gp.or({Laws.abnf.float(cs) == False{} : Bool}, Laws.abnf.hex_int(cs),
      Bool.or(Laws.abnf.oct_int(cs), Laws.abnf.bin_int(cs)), hr,
      hx => gp.pre.case(zs => {Laws.abnf.float(zs) == False{} : Bool}, cs, 120, Laws.AHex{}, hx, _c => _r => {==}),
      hq => gp.or({Laws.abnf.float(cs) == False{} : Bool}, Laws.abnf.oct_int(cs), Laws.abnf.bin_int(cs), hq,
        ho => gp.pre.case(zs => {Laws.abnf.float(zs) == False{} : Bool}, cs, 111, Laws.AOct{}, ho, _c => _r => {==}),
        hb => gp.pre.case(zs => {Laws.abnf.float(zs) == False{} : Bool}, cs, 98, Laws.ABin{}, hb,
          _c => _r => {==}))))

# a special-float is no date-time: it starts with a sign, an i or an n
def gp.spec.dt(
  cs: List<&2, Char>,
  +h: {Laws.abnf.special_float(cs) == True{} : Bool}
) -> {Laws.abnf.date_time(cs) == False{} : Bool}:
  match cs:
    case []:
      Eq.bit.absurd(&2, {Laws.abnf.date_time([]) == False{} : Bool}, h)
    case +hh <> +tt:
      gp.or({Laws.abnf.date_time(hh <> tt) == False{} : Bool},
        Bool.and(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)), Bool.or(Laws.abnf.inf(tt), Laws.abnf.nan(tt))),
        Bool.or(Laws.abnf.inf(hh <> tt), Laws.abnf.nan(hh <> tt)), h,
        ha => gp.dt.sign(hh, tt, Eq.and.left(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)),
          Bool.or(Laws.abnf.inf(tt), Laws.abnf.nan(tt)), ha)),
        hb => gp.or({Laws.abnf.date_time(hh <> tt) == False{} : Bool}, Laws.abnf.inf(hh <> tt),
          Laws.abnf.nan(hh <> tt), hb,
          hi => gp.head(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, hh, 'i', tt,
            Eq.char_eq_true(hh, 'i', Eq.and.left(Char.is_eq(hh, 'i'), Laws.abnf.chars_are(tt, "nf"), hi)), {==}),
          hn => gp.head(zs => {Laws.abnf.date_time(zs) == False{} : Bool}, hh, 'n', tt,
            Eq.char_eq_true(hh, 'n', Eq.and.left(Char.is_eq(hh, 'n'), Laws.abnf.chars_are(tt, "an"), hn)), {==})))

# the step of gp.pre.nd: a decimal-point or e first is no - or :, and a DIGIT
# or underscore first leaves the rest
def gp.pre.nd.go(
  +hh: Char,
  +tt: List<&2, Char>,
  cc: Bool,
  +ec: {Laws.abnf.cut.at(Laws.ACutDot{}, hh) == cc : Bool},
  +h: {gp.decs(Laws.abnf.cut.pre(hh <> tt, Laws.ACutDot{})) == True{} : Bool},
  ih: {gp.decs(Laws.abnf.cut.pre(tt, Laws.ACutDot{})) == True{} : Bool} -> {gp.nd(tt) == True{} : Bool}
) -> {gp.nd(hh <> tt) == True{} : Bool}:
  match cc:
    case True{}:
      gp.or({gp.nd(hh <> tt) == True{} : Bool}, Laws.abnf.cp(hh, 46),
        Bool.or(Laws.abnf.cp(hh, 101), Laws.abnf.cp(hh, 69)), ec,
        hd => gp.head(zs => {gp.nd(zs) == True{} : Bool}, hh, Chr{46}, tt, gp.cp(hh, 46, hd), {==}),
        he => gp.or({gp.nd(hh <> tt) == True{} : Bool}, Laws.abnf.cp(hh, 101), Laws.abnf.cp(hh, 69), he,
          hl => gp.head(zs => {gp.nd(zs) == True{} : Bool}, hh, Chr{101}, tt, gp.cp(hh, 101, hl), {==}),
          hu => gp.head(zs => {gp.nd(zs) == True{} : Bool}, hh, Chr{69}, tt, gp.cp(hh, 69, hu), {==})))
    case False{}:
      +pt = Laws.abnf.cut.pre(tt, Laws.ACutDot{})
      +hq = {Equal.trans(Bool, gp.decs(hh <> pt),
        gp.decs(Laws.abnf.cut.pre.pick(Laws.abnf.cut.at(Laws.ACutDot{}, hh), hh, pt)), True{},
        Equal.cong(Bool, Bool, xx => gp.decs(Laws.abnf.cut.pre.pick(xx, hh, pt)), False{},
          Laws.abnf.cut.at(Laws.ACutDot{}, hh), Equal.sym(Bool, Laws.abnf.cut.at(Laws.ACutDot{}, hh), False{}, ec)), h)
        : {gp.decs(hh <> pt) == True{} : Bool}}
      %Equal.sym(Bool, gp.dc(hh), True{}, Eq.and.left(gp.dc(hh), gp.decs(pt), hq)) :
        {gp.nd.pick(_, hh, gp.nd(tt)) == True{} : Bool}
      ih(Eq.and.right(gp.dc(hh), gp.decs(pt), hq))

# a word whose part before its first decimal-point or e holds only DIGITs and
# underscores has no - or : before a character that is none of those
def gp.pre.nd(
  cs: List<&2, Char>,
  +h: {gp.decs(Laws.abnf.cut.pre(cs, Laws.ACutDot{})) == True{} : Bool}
) -> {gp.nd(cs) == True{} : Bool}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      gp.pre.nd.go(hh, tt, Laws.abnf.cut.at(Laws.ACutDot{}, hh), {==}, h, hr => gp.pre.nd(tt, hr))

# a word whose integer part is unsigned, before its first decimal-point or e,
# is no date-time
def gp.pre.dt.u(
  +hh: Char,
  +tt: List<&2, Char>,
  +hd: {gp.decs(hh <> Laws.abnf.cut.pre(tt, Laws.ACutDot{})) == True{} : Bool}
) -> {Laws.abnf.date_time(hh <> tt) == False{} : Bool}:
  +pt = Laws.abnf.cut.pre(tt, Laws.ACutDot{})
  gp.nd.dt(hh <> tt, Equal.trans(Bool, gp.nd(hh <> tt), gp.nd(tt), True{},
    Equal.cong(Bool, Bool, xx => gp.nd.pick(xx, hh, gp.nd(tt)), gp.dc(hh), True{},
      Eq.and.left(gp.dc(hh), gp.decs(pt), hd)),
    gp.pre.nd(tt, Eq.and.right(gp.dc(hh), gp.decs(pt), hd))))

# the step of gp.pre.dt: a decimal-point or e first leaves no integer part,
# and otherwise the integer part starts with this character
def gp.pre.dt.go(
  +hh: Char,
  +tt: List<&2, Char>,
  cc: Bool,
  +ec: {Laws.abnf.cut.at(Laws.ACutDot{}, hh) == cc : Bool},
  +h: {Laws.abnf.dec_int(Laws.abnf.cut.pre(hh <> tt, Laws.ACutDot{})) == True{} : Bool}
) -> {Laws.abnf.date_time(hh <> tt) == False{} : Bool}:
  match cc:
    case True{}:
      +pt = Laws.abnf.cut.pre(tt, Laws.ACutDot{})
      Eq.bit.absurd(&2, {Laws.abnf.date_time(hh <> tt) == False{} : Bool},
        Equal.trans(Bool, False{}, Laws.abnf.dec_int(Laws.abnf.cut.pre.pick(Laws.abnf.cut.at(Laws.ACutDot{}, hh),
          hh, pt)), True{},
          Equal.cong(Bool, Bool, xx => Laws.abnf.dec_int(Laws.abnf.cut.pre.pick(xx, hh, pt)), True{},
            Laws.abnf.cut.at(Laws.ACutDot{}, hh), Equal.sym(Bool, Laws.abnf.cut.at(Laws.ACutDot{}, hh), True{}, ec)),
          h))
    case False{}:
      +pt = Laws.abnf.cut.pre(tt, Laws.ACutDot{})
      +hq = {Equal.trans(Bool, Laws.abnf.dec_int(hh <> pt),
        Laws.abnf.dec_int(Laws.abnf.cut.pre.pick(Laws.abnf.cut.at(Laws.ACutDot{}, hh), hh, pt)), True{},
        Equal.cong(Bool, Bool, xx => Laws.abnf.dec_int(Laws.abnf.cut.pre.pick(xx, hh, pt)), False{},
          Laws.abnf.cut.at(Laws.ACutDot{}, hh), Equal.sym(Bool, Laws.abnf.cut.at(Laws.ACutDot{}, hh), False{}, ec)), h)
        : {Laws.abnf.dec_int(hh <> pt) == True{} : Bool}}
      gp.or({Laws.abnf.date_time(hh <> tt) == False{} : Bool},
        Bool.and(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)), Laws.abnf.unsigned_dec_int(pt)),
        Laws.abnf.unsigned_dec_int(hh <> pt), hq,
        ha => gp.dt.sign(hh, tt, Eq.and.left(Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)),
          Laws.abnf.unsigned_dec_int(pt), ha)),
        hb => gp.pre.dt.u(hh, tt, gp.udi.decs(hh <> pt, hb)))

# a word whose part before its first decimal-point or e is a dec-int is no
# date-time
def gp.pre.dt(
  cs: List<&2, Char>,
  +h: {Laws.abnf.dec_int(Laws.abnf.cut.pre(cs, Laws.ACutDot{})) == True{} : Bool}
) -> {Laws.abnf.date_time(cs) == False{} : Bool}:
  match cs:
    case []:
      Eq.bit.absurd(&2, {Laws.abnf.date_time([]) == False{} : Bool}, h)
    case +hh <> +tt:
      gp.pre.dt.go(hh, tt, Laws.abnf.cut.at(Laws.ACutDot{}, hh), {==}, h)

def Laws.float_not_date_time(cs, h):
  +post = Laws.abnf.cut.post(cs, Laws.ACutDot{})
  +aa = Laws.abnf.dec_int(Laws.abnf.cut.pre(cs, Laws.ACutDot{}))
  +bb = Bool.or(Laws.abnf.exp(post), Laws.abnf.frac_exp(post))
  gp.or({Laws.abnf.date_time(cs) == False{} : Bool}, Bool.and(aa, bb), Laws.abnf.special_float(cs), h,
    hs => gp.pre.dt(cs, Eq.and.left(aa, bb, hs)),
    hp => gp.spec.dt(cs, hp))

# WP-T1: datetime words, exact in both directions. The datetime scan
# (when.read) and toml.abnf's date-time rules are walked together, one
# character test at a time: each test the scan makes is the one the grammar
# makes at the same character (a DIGIT, a separator, T or t, Z or z), so the
# two agree on every word, the failing tests included. The grammar is read
# through its rules' ARest results, and the two digits of each field through
# one eliminator (t1.tk2), with the digits symbolic. A word that matches is
# routed to the datetime scan by word.val (t1.rs); every other word reads as
# no datetime (t1.rn).

# what a datetime scan gives, as a datetime or none
type T1o is Data:
  T1some{w: T.When}
  T1none{}

# a datetime scan's datetime, or none
def t1.wopt(ww: T.WhenOut) -> T1o:
  match ww:
    case T.WSome{w}:
      T1some{w}
    case _:
      T1none{}

# a datetime when the test holds, and none otherwise
def t1.pk(bb: Bool, ww: T.When) -> T1o:
  match bb:
    case True{}:
      T1some{ww}
    case False{}:
      T1none{}

# what the grammar says a word is: the datetime it denotes when it matches a
# date-time rule within the ranges, and none otherwise
def t1.spec(+cs: List<&2, Char>) -> T1o:
  t1.pk(Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)), Laws.g.dt.when(cs))

# nothing is below zero, as a comparison
def t1.ge0n(nn: Nat) -> {Cmp.is_ge(Nat.cmp(nn, 0n)) == True{} : Bool}:
  match nn:
    case 0n:
      {==}
    case 1n+_p:
      {==}

# every U32 is at least 0
def t1.ge0(+xx: U32) -> {U32.is_ge(xx, 0) == True{} : Bool}:
  Equal.trans(Bool, U32.is_ge(xx, 0), Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 0n)), True{},
    Equal.cong(Cmp, Bool, cc => Cmp.is_ge(cc), U32.cmp(xx, 0), Nat.cmp(U32.to_nat(xx), 0n), Ar.u_cmp(xx, 0)),
    t1.ge0n(U32.to_nat(xx)))

# zero plus a word is the word
def t1.wadd0(nn: Nat, ww: Word(nn)) -> {Word.adc(nn, Word.zero(nn), ww, False{}, False{}) == ww : Word(nn)}:
  match nn:
    case 0n:
      match ww:
        case WNil{}:
          {==}
    case 1n+p:
      match ww:
        case WCon{bb, ts}:
          match bb:
            case False{}:
              Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.zero(p), ts, False{}, False{}),
                ts,
                t1.wadd0(p, ts))
            case True{}:
              Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.zero(p), ts, False{}, False{}), ts,
                t1.wadd0(p, ts))

# zero plus a number is the number
def t1.add0(xx: U32) -> {U32.add(0, xx) == xx : U32}:
  match xx:
    case U32{ww}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.adc(32n, Word.zero(32n), ww, False{}, False{}), ww,
        t1.wadd0(32n, ww))

# the claim of the two-digit eliminator for a failed take and no match
def t1.Tb(-P: List<&2, Char> -> T.Dig -> Laws.ARest -> Type) -> Type:
  @xs: List<&2, Char> -> P(xs, T.DigBad{}, Laws.ANone{})

# and for two digits and the rest
def t1.Tk(-P: List<&2, Char> -> T.Dig -> Laws.ARest -> Type) -> Type:
  @c1: Char -> @c2: Char -> @rr: List<&2, Char> -> {Char.is_digit(c1) == True{} : Bool} ->
    {Char.is_digit(c2) == True{} : Bool} -> P(c1 <> c2 <> rr, T.DigOk{Laws.g.two(c1 <> c2 <> rr), rr}, Laws.ALeft{rr})

# the second digit
def t1.tk2.b(
  -P: List<&2, Char> -> T.Dig -> Laws.ARest -> Type,
  +x1: U32,
  +x2: U32,
  +ts: List<&2, Char>,
  d2: Bool,
  +e1: {Char.is_digit(Chr{x1}) == True{} : Bool},
  +e2: {Char.is_digit(Chr{x2}) == d2 : Bool},
  hb: t1.Tb(P),
  hk: t1.Tk(P)
) -> P(Chr{x1} <> Chr{x2} <> ts, T.take.fin(d2, T.take.acc.d(d2, U32.add(U32.mul(0, 10), U32.sub(x1, 48)), Chr{x2}),
  ts),
  Laws.abnf.keep(d2, ts)):
  match d2:
    case False{}:
      hb(Chr{x1} <> Chr{x2} <> ts)
    case True{}:
      %Equal.sym(U32, U32.add(0, U32.sub(x1, 48)), U32.sub(x1, 48), t1.add0(U32.sub(x1, 48))) :
        P(Chr{x1} <> Chr{x2} <> ts, T.DigOk{U32.add(U32.mul(_, 10), U32.sub(x2, 48)), ts}, Laws.ALeft{ts})
      hk(Chr{x1}, Chr{x2}, ts, e1, e2)

# the first digit
def t1.tk2.a(
  -P: List<&2, Char> -> T.Dig -> Laws.ARest -> Type,
  +x1: U32,
  d1: Bool,
  ts: List<&2, Char>,
  e1: {Char.is_digit(Chr{x1}) == d1 : Bool},
  hb: t1.Tb(P),
  hk: t1.Tk(P)
) -> P(Chr{x1} <> ts, T.take.n(1n, ts, T.take.acc.d(d1, 0, Chr{x1}), d1),
  Laws.abnf.digit_r(Laws.abnf.keep(d1, ts))):
  match d1:
    case False{}:
      match ts:
        case []:
          hb([Chr{x1}])
        case +h2 <> +t2:
          hb(Chr{x1} <> h2 <> t2)
    case True{}:
      match ts:
        case []:
          hb([Chr{x1}])
        case +h2 <> +t2:
          match h2:
            case Chr{+x2}:
              t1.tk2.b(P, x1, x2, t2, Char.is_digit(Chr{x2}), e1, {==}, hb, hk)

# two digits from the front of a word, as the scan takes them and as two
# DIGITs of the grammar: a claim of the failed take and no match, and of two
# digits and the rest, is a claim of every word
def t1.tk2(
  -P: List<&2, Char> -> T.Dig -> Laws.ARest -> Type,
  cs: List<&2, Char>,
  hb: t1.Tb(P),
  hk: t1.Tk(P)
) -> P(cs, T.take.n(2n, cs, 0, True{}), Laws.abnf.digit_r(Laws.abnf.digit_r(Laws.ALeft{cs}))):
  match cs:
    case []:
      hb([])
    case hh <> +ts:
      match hh:
        case Chr{+x1}:
          t1.tk2.a(P, x1, Char.is_digit(Chr{x1}), ts, {==}, hb, hk)

# a range from 0 is the upper bound's test, since every number is at least 0
def t1.rng0(+xx: U32, +hi: U32) -> {T.bound.rng(xx, 0, hi) == U32.is_le(xx, hi) : Bool}:
  %Equal.sym(Bool, U32.is_ge(xx, 0), True{}, t1.ge0(xx)) : {Bool.and(_, U32.is_le(xx, hi)) == U32.is_le(xx, hi) : Bool}
  {==}

# A zone, or the end of a local datetime. The grammar's time-offset, or
# nothing, after a partial-time: a word that ends there is a local-date-time
# (or local-time), and one that goes on with a time-offset is an
# offset-date-time.

# a time-offset's range, or nothing to check when the word ends
def t1.zok(zz: List<&2, Char>) -> Bool:
  match zz:
    case []:
      True{}
    case _h <> _t:
      Laws.prose.zone_ok(Laws.g.dt.zone(zz))

# what the grammar says of the text z after a partial-time: the end, or a
# time-offset within its range, and the datetime of the date and clock with
# that zone
def t1.zn(+zz: List<&2, Char>, clock: T.Clock, date: T.Date) -> T1o:
  t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz})),
    t1.zok(zz)), Laws.g.dt.zoned(date, clock, zz))

# the offset's two ranges, once nothing follows it
def t1.z.ok(
  hk: Bool,
  mk: Bool,
  +sign: T.Sign,
  +hh: U32,
  +mi: U32,
  +clock: T.Clock,
  +date: T.Date
) -> {t1.wopt(T.when.zone.mm.ok(hk, mk, sign, hh, mi, clock, date))
  == t1.pk(Bool.and(True{}, Bool.and(hk, mk)), T.WOff{date, clock, T.Shift{sign, hh, mi}}) : T1o}:
  match hk:
    case False{}:
      {==}
    case True{}:
      match mk:
        case False{}:
          {==}
        case True{}:
          {==}

# nothing may follow the offset's minutes
def t1.z.end(
  rr: List<&2, Char>,
  +hk: Bool,
  +mk: Bool,
  +sign: T.Sign,
  +hh: U32,
  +mi: U32,
  +clock: T.Clock,
  +date: T.Date
) -> {t1.wopt(T.when.zone.mm.end(rr, hk, mk, sign, hh, mi, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.ALeft{rr}), False{}), Bool.and(hk, mk)),
    T.WOff{date, clock, T.Shift{sign, hh, mi}}) : T1o}:
  match rr:
    case []:
      t1.z.ok(hk, mk, sign, hh, mi, clock, date)
    case _h <> _t:
      {==}

# the offset's end, with its ranges as the scan tests them
def t1.z.fin(
  +rr: List<&2, Char>,
  +sign: T.Sign,
  +hh: U32,
  +mi: U32,
  +clock: T.Clock,
  +date: T.Date
) -> {t1.wopt(T.when.zone.mm.end(rr, T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), sign, hh, mi, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.ALeft{rr}), False{}), Laws.prose.zone_ok(T.Shift{sign, hh, mi})),
    T.WOff{date, clock, T.Shift{sign, hh, mi}}) : T1o}:
  %t1.rng0(hh, 23) : {t1.wopt(T.when.zone.mm.end(rr, T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), sign, hh, mi,
    clock,
    date)) == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.ALeft{rr}), False{}), Bool.and(_, U32.is_le(mi, 59))),
    T.WOff{date, clock, T.Shift{sign, hh, mi}}) : T1o}
  %t1.rng0(mi, 59) : {t1.wopt(T.when.zone.mm.end(rr, T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), sign, hh, mi,
    clock,
    date)) == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.ALeft{rr}), False{}), Bool.and(T.bound.rng(hh, 0, 23), _)),
    T.WOff{date, clock, T.Shift{sign, hh, mi}}) : T1o}
  t1.z.end(rr, T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), sign, hh, mi, clock, date)

# the offset's minutes, after its colon
def t1.z.mm(
  hit: Bool,
  +uu: List<&2, Char>,
  +sign: T.Sign,
  +hh: U32,
  +clock: T.Clock,
  +date: T.Date
) -> {t1.wopt(T.when.zone.mm(hit, T.take.n(2n, uu, 0, True{}), sign, hh, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.digit_r(Laws.abnf.digit_r(Laws.abnf.keep(hit, uu)))), False{}),
    Laws.prose.zone_ok(T.Shift{sign, hh, Laws.g.two(List.drop(&2, Char, uu, 0n))})),
    T.WOff{date, clock, T.Shift{sign, hh, Laws.g.two(List.drop(&2, Char, uu, 0n))}}) : T1o}:
  match hit:
    case False{}:
      {==}
    case True{}:
      t1.tk2(xs => dd => r => {t1.wopt(T.when.zone.mm.go(dd, sign, hh, clock, date))
        == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(r), False{}),
        Laws.prose.zone_ok(T.Shift{sign, hh, Laws.g.two(List.drop(&2, Char, xs, 0n))})),
        T.WOff{date, clock, T.Shift{sign, hh, Laws.g.two(List.drop(&2, Char, xs, 0n))}}) : T1o}, uu,
        _xs => {==},
        +c1 => +c2 => +rr => _e1 => _e2 => t1.z.fin(rr, sign, hh, Laws.g.two(c1 <> c2 <> rr), clock, date))

# the colon after the offset's hour
def t1.z.col(
  rr: List<&2, Char>,
  +sign: T.Sign,
  +hh: U32,
  +clock: T.Clock,
  +date: T.Date
) -> {t1.wopt(T.when.zone.hh.colon(rr, sign, hh, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.digit_r(Laws.abnf.digit_r(Laws.abnf.char_r(Laws.ALeft{rr},
    58)))), False{}), Laws.prose.zone_ok(T.Shift{sign, hh, Laws.g.two(List.drop(&2, Char, rr, 1n))})),
    T.WOff{date, clock, T.Shift{sign, hh, Laws.g.two(List.drop(&2, Char, rr, 1n))}}) : T1o}:
  match rr:
    case []:
      {==}
    case hh2 <> +uu:
      match hh2:
        case Chr{+qq}:
          t1.z.mm(Char.is_eq(Chr{qq}, ':'), uu, sign, hh, clock, date)

# a numeric offset's hour, colon and minute, after its sign
def t1.z.off(
  +sign: T.Sign,
  +tt: List<&2, Char>,
  +clock: T.Clock,
  +date: T.Date
) -> {t1.wopt(T.when.zone.off(sign, tt, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_minute(Laws.abnf.char_r(Laws.abnf.time_hour(Laws.ALeft{tt}),
    58))), False{}), Laws.prose.zone_ok(T.Shift{sign, Laws.g.two(tt), Laws.g.two(List.drop(&2, Char, tt, 3n))})),
    T.WOff{date, clock, T.Shift{sign, Laws.g.two(tt), Laws.g.two(List.drop(&2, Char, tt, 3n))}}) : T1o}:
  t1.tk2(xs => dd => r => {t1.wopt(T.when.zone.hh(dd, sign, clock, date))
    == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.digit_r(Laws.abnf.digit_r(Laws.abnf.char_r(r, 58)))), False{}),
    Laws.prose.zone_ok(T.Shift{sign, Laws.g.two(xs), Laws.g.two(List.drop(&2, Char, xs, 3n))})),
    T.WOff{date, clock, T.Shift{sign, Laws.g.two(xs), Laws.g.two(List.drop(&2, Char, xs, 3n))}}) : T1o}, tt,
    _xs => {==},
    +c1 => +c2 => +rr => _e1 => _e2 => t1.z.col(rr, sign, Laws.g.two(c1 <> c2 <> rr), clock, date))

# what the grammar says after a time-offset's sign: the numeric offset
def t1.z.num(+pl: Bool, +mi: Bool, +tt: List<&2, Char>) -> Laws.ARest:
  Laws.abnf.time_minute(Laws.abnf.char_r(Laws.abnf.time_hour(Laws.abnf.or_r(Laws.abnf.keep(pl, tt),
    Laws.abnf.keep(mi, tt))), 58))

# a plus: the offset is read with that sign, since a plus is no minus
def t1.z.plus(
  mi: Bool,
  +tt: List<&2, Char>,
  +clock: T.Clock,
  +date: T.Date,
  hm: {Char.is_eq('+', '-') == mi : Bool}
) -> {t1.wopt(T.when.zone.off(T.Plus{}, tt, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(t1.z.num(True{}, mi, tt)), False{}),
    Laws.prose.zone_ok(Laws.g.dt.zone.pick(mi, False{}, tt))), T.WOff{date, clock, Laws.g.dt.zone.pick(mi, False{},
      tt)})
    : T1o}:
  match mi:
    case True{}:
      Eq.bit.absurd(&2, {t1.wopt(T.when.zone.off(T.Plus{}, tt, clock, date))
        == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(t1.z.num(True{}, True{}, tt)), False{}),
        Laws.prose.zone_ok(Laws.g.dt.zone.pick(True{}, False{}, tt))), T.WOff{date, clock,
        Laws.g.dt.zone.pick(True{}, False{}, tt)}) : T1o}, hm)
    case False{}:
      t1.z.off(T.Plus{}, tt, clock, date)

# a plus or a minus starts a numeric offset
def t1.z.sign(
  pl: Bool,
  mi: Bool,
  +xx: U32,
  +tt: List<&2, Char>,
  +clock: T.Clock,
  +date: T.Date,
  hp: {Char.is_eq(Chr{xx}, '+') == pl : Bool},
  hm: {Char.is_eq(Chr{xx}, '-') == mi : Bool}
) -> {t1.wopt(T.when.zone.sign(pl, mi, tt, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(t1.z.num(pl, mi, tt)), False{}),
    Laws.prose.zone_ok(Laws.g.dt.zone.pick(mi, False{}, tt))), T.WOff{date, clock, Laws.g.dt.zone.pick(mi, False{},
      tt)})
    : T1o}:
  match pl:
    case True{}:
      t1.z.plus(mi, tt, clock, date, Equal.trans(Bool, Char.is_eq('+', '-'), Char.is_eq(Chr{xx}, '-'), mi,
        Equal.cong(Char, Bool, cc => Char.is_eq(cc, '-'), '+', Chr{xx},
          Equal.sym(Char, Chr{xx}, '+', Eq.char_eq_true(Chr{xx}, '+', hp))), hm))
    case False{}:
      match mi:
        case True{}:
          t1.z.off(T.Minus{}, tt, clock, date)
        case False{}:
          {==}

# Z (or z) ends the word, and otherwise a sign starts a numeric offset
def t1.z.go(
  zee: Bool,
  +pl: Bool,
  +mi: Bool,
  +xx: U32,
  tt: List<&2, Char>,
  +clock: T.Clock,
  +date: T.Date,
  hp: {Char.is_eq(Chr{xx}, '+') == pl : Bool},
  hm: {Char.is_eq(Chr{xx}, '-') == mi : Bool}
) -> {t1.wopt(T.when.zone.go(zee, pl, mi, tt, clock, date))
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.or_r(Laws.abnf.keep(zee, tt), t1.z.num(pl, mi, tt))), False{}),
    Laws.prose.zone_ok(Laws.g.dt.zone.pick(mi, zee, tt))), T.WOff{date, clock, Laws.g.dt.zone.pick(mi, zee,
      tt)}) : T1o}:
  match zee:
    case True{}:
      match tt:
        case []:
          {==}
        case _h <> _t:
          {==}
    case False{}:
      t1.z.sign(pl, mi, xx, tt, clock, date, hp, hm)

# a zone, or the end, after a partial-time: the scan reads exactly what the
# grammar says, Z or z included
def t1.z(
  zz: List<&2, Char>,
  +clock: T.Clock,
  +date: T.Date
) -> {t1.wopt(T.when.zone(zz, clock, date)) == t1.zn(zz, clock, date) : T1o}:
  match zz:
    case []:
      {==}
    case hh <> +tt:
      match hh:
        case Chr{+xx}:
          t1.z.go(Bool.or(Char.is_eq(Chr{xx}, 'Z'), Char.is_eq(Chr{xx}, 'z')), Char.is_eq(Chr{xx}, '+'),
            Char.is_eq(Chr{xx}, '-'), xx, tt, clock, date, {==}, {==})

# what is observed of a datetime scan's outcome: the datetime (md), or the
# local time the scan keeps of it when it read a time with no date
def t1.obs(md: Bool, ww: T.WhenOut) -> T1o:
  match md:
    case True{}:
      t1.wopt(ww)
    case False{}:
      t1.wopt(T.when.time.only(ww))

# a failed scan is observed as none
def t1.obs.fail(md: Bool, +why: String) -> {t1.obs(md, T.WFail{why}) == T1none{} : T1o}:
  match md:
    case True{}:
      {==}
    case False{}:
      {==}

# A fraction. The scan keeps its digits reversed and turns them back at the
# end; the grammar takes them from the front.

# a list reversed onto more, then reversed again, is the more reversed onto
# the list
def t1.revrev(
  ds: List<&2, Char>,
  +acc: List<&2, Char>
) -> {List.reverse.go(&2, Char, List.reverse.go(&2, Char, ds, acc), []) == List.reverse.go(&2, Char, acc, ds)
  : List<&2, Char>}:
  match ds:
    case []:
      {==}
    case +dd <> +dt:
      t1.revrev(dt, dd <> acc)

# a list reversed onto a list with a character has a character
def t1.somerev(
  xs: List<&2, Char>,
  +hh: Char,
  +acc: List<&2, Char>
) -> {T.cs.some(List.reverse.go(&2, Char, xs, hh <> acc)) == True{} : Bool}:
  match xs:
    case []:
      {==}
    case +xh <> +xt:
      t1.somerev(xt, xh, hh <> acc)

# the scan's fraction digits are the word's leading digits, and what follows
# them is the word after its leading digits
def t1.Fl(+tt: List<&2, Char>, +rv: List<&2, Char>, +clock: T.Clock, +date: T.Date) -> Type:
  {T.when.frac.digits(tt, rv, clock, date) == T.when.frac.end(List.reverse.go(&2, Char, Laws.g.take_digits(tt), rv),
    clock, date, Laws.abnf.drop_digits(tt)) : T.WhenOut}

# one character of the fraction's digits: a digit is kept, and anything else
# ends them
def t1.fl.d(
  dg: Bool,
  +yy: U32,
  +uu: List<&2, Char>,
  +rv: List<&2, Char>,
  +clock: T.Clock,
  +date: T.Date,
  ih: t1.Fl(uu, Chr{yy} <> rv, clock, date)
) -> {T.when.frac.digit(dg, Chr{yy}, uu, rv, clock, date, _u => T.when.frac.digits(uu, Chr{yy} <> rv, clock, date))
  == T.when.frac.end(List.reverse.go(&2, Char, Laws.g.take_digits.pick(dg, Chr{yy}, Laws.g.take_digits(uu)), rv), clock,
    date, Laws.abnf.drop_digits.pick(dg, Chr{yy}, uu, Laws.abnf.drop_digits(uu))) : T.WhenOut}:
  match dg:
    case True{}:
      ih
    case False{}:
      {==}

# the fraction's digits are the word's leading digits, and what follows them
# is the word after its leading digits
def t1.fl(
  tt: List<&2, Char>,
  +rv: List<&2, Char>,
  +clock: T.Clock,
  +date: T.Date
) -> {T.when.frac.digits(tt, rv, clock, date) == T.when.frac.end(List.reverse.go(&2, Char, Laws.g.take_digits(tt), rv),
  clock, date, Laws.abnf.drop_digits(tt)) : T.WhenOut}:
  match tt:
    case []:
      {==}
    case hh <> +uu:
      match hh:
        case Chr{+yy}:
          t1.fl.d(Char.is_digit(Chr{yy}), yy, uu, rv, clock, date, t1.fl(uu, Chr{yy} <> rv, clock, date))

# a match of the grammar's rest handed to what follows it, or none
def t1.ofz(
  pp: Laws.ARest,
  fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  clk: T.Clock,
  aa: List<&2, Char>
) -> T1o:
  match pp:
    case Laws.ALeft{zz}:
      fin(zz, clk, aa)
    case Laws.ANone{}:
      T1none{}

# the fraction's digits end: there is one, and the zone follows
def t1.F.end(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  +yy: U32,
  +uu: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.frac.end(List.reverse.go(&2, Char, Laws.g.take_digits(uu), [Chr{yy}]), T.Clock{hh, mi, ss,
  ""}, date,
  Laws.abnf.drop_digits(uu))) == fin(Laws.abnf.drop_digits(uu), T.Clock{hh, mi, ss, String.from_list(Chr{yy}
  <> Laws.g.take_digits(uu))}, Laws.abnf.drop_digits(uu)) : T1o}:
  %Equal.sym(Bool, T.cs.some(List.reverse.go(&2, Char, Laws.g.take_digits(uu), [Chr{yy}])), True{},
    t1.somerev(Laws.g.take_digits(uu), Chr{yy}, [])) : {t1.obs(md, T.when.frac.end.go(_, List.reverse.go(&2, Char,
    Laws.g.take_digits(uu), [Chr{yy}]), T.Clock{hh, mi, ss, ""}, date, Laws.abnf.drop_digits(uu)))
    == fin(Laws.abnf.drop_digits(uu), T.Clock{hh, mi, ss, String.from_list(Chr{yy} <> Laws.g.take_digits(uu))},
    Laws.abnf.drop_digits(uu)) : T1o}
  %Equal.sym(List<&2, Char>, List.reverse.go(&2, Char, List.reverse.go(&2, Char, Laws.g.take_digits(uu), [Chr{yy}]),
    []),
    Chr{yy} <> Laws.g.take_digits(uu), t1.revrev(Laws.g.take_digits(uu), [Chr{yy}])) :
    {t1.obs(md, T.when.zone(Laws.abnf.drop_digits(uu), T.Clock{hh, mi, ss, String.from_list(_)}, date))
    == fin(Laws.abnf.drop_digits(uu), T.Clock{hh, mi, ss, String.from_list(Chr{yy} <> Laws.g.take_digits(uu))},
    Laws.abnf.drop_digits(uu)) : T1o}
  hz(Laws.abnf.drop_digits(uu), T.Clock{hh, mi, ss, String.from_list(Chr{yy} <> Laws.g.take_digits(uu))})

# the fraction's first digit, and the rest of its digits
def t1.F.d1(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  dg: Bool,
  +yy: U32,
  +uu: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.frac.digit(dg, Chr{yy}, uu, [], T.Clock{hh, mi, ss, ""}, date, _u => T.when.frac.digits(uu,
  [Chr{yy}],
  T.Clock{hh, mi, ss, ""}, date))) == t1.ofz(Laws.abnf.keep(dg, Laws.abnf.drop_digits(uu)), fin, T.Clock{hh, mi, ss,
  String.from_list(Laws.g.take_digits.pick(dg, Chr{yy}, Laws.g.take_digits(uu)))},
  Laws.abnf.drop_digits.pick(dg, Chr{yy}, uu, Laws.abnf.drop_digits(uu))) : T1o}:
  match dg:
    case False{}:
      t1.obs.fail(md, "invalid fraction")
    case True{}:
      Equal.trans(T1o, t1.obs(md, T.when.frac.digits(uu, [Chr{yy}], T.Clock{hh, mi, ss, ""}, date)),
        t1.obs(md, T.when.frac.end(List.reverse.go(&2, Char, Laws.g.take_digits(uu), [Chr{yy}]), T.Clock{hh, mi, ss,
          ""}, date,
          Laws.abnf.drop_digits(uu))),
        fin(Laws.abnf.drop_digits(uu), T.Clock{hh, mi, ss, String.from_list(Chr{yy} <> Laws.g.take_digits(uu))},
          Laws.abnf.drop_digits(uu)),
        Equal.cong(T.WhenOut, T1o, ww => t1.obs(md, ww), T.when.frac.digits(uu, [Chr{yy}], T.Clock{hh, mi, ss, ""},
          date),
          T.when.frac.end(List.reverse.go(&2, Char, Laws.g.take_digits(uu), [Chr{yy}]), T.Clock{hh, mi, ss, ""}, date,
          Laws.abnf.drop_digits(uu)), t1.fl(uu, [Chr{yy}], T.Clock{hh, mi, ss, ""}, date)),
        t1.F.end(md, fin, yy, uu, hh, mi, ss, date, hz))

# the fraction's digits after its dot: at least one
def t1.F.dig(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  tt: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.frac.digits(tt, [], T.Clock{hh, mi, ss, ""},
  date)) == t1.ofz(Laws.abnf.digits1_r(Laws.ALeft{tt}), fin,
  T.Clock{hh, mi, ss, String.from_list(Laws.g.take_digits(tt))}, Laws.abnf.drop_digits(tt)) : T1o}:
  match tt:
    case []:
      t1.obs.fail(md, "invalid fraction")
    case yh <> +uu:
      match yh:
        case Chr{+yy}:
          t1.F.d1(md, fin, Char.is_digit(Chr{yy}), yy, uu, hh, mi, ss, date, hz)

# a dot starts a fraction, and anything else is the zone
def t1.F.go(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  dot: Bool,
  +xx: U32,
  +tt: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +date: T.Date,
  hd: {Char.is_eq(Chr{xx}, '.') == dot : Bool},
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.frac.go(dot, tt, T.Clock{hh, mi, ss, ""}, date,
  Chr{xx})) == t1.ofz(Laws.abnf.opt_secfrac.pick(dot,
  Chr{xx} <> tt), fin, T.Clock{hh, mi, ss, Laws.g.dt.frac.pick(dot, tt)}, Laws.g.dt.after_frac.pick(dot, Chr{xx}, tt))
  : T1o}:
  match dot:
    case False{}:
      hz(Chr{xx} <> tt, T.Clock{hh, mi, ss, ""})
    case True{}:
      %Equal.sym(Char, Chr{xx}, '.', Eq.char_eq_true(Chr{xx}, '.', hd)) : {t1.obs(md, T.when.frac.digits(tt, [],
        T.Clock{hh, mi,
        ss, ""}, date)) == t1.ofz(Laws.abnf.time_secfrac(Laws.ALeft{_ <> tt}), fin, T.Clock{hh, mi, ss,
        String.from_list(Laws.g.take_digits(tt))}, Laws.abnf.drop_digits(tt)) : T1o}
      t1.F.dig(md, fin, tt, hh, mi, ss, date, hz)

# after a partial-time's seconds: an optional fraction, and then the zone or
# the end, read by the scan as the grammar's [ time-secfrac ] and then
# whatever follows it (fin), with the clock's fraction the digits after the
# dot. O is what is observed of the scan's outcome
def t1.F(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  rr: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.frac(rr, T.Clock{hh, mi, ss, ""}, date)) == t1.ofz(Laws.abnf.opt_secfrac(Laws.ALeft{rr}), fin,
  T.Clock{hh, mi, ss, Laws.g.dt.frac(List.drop(&2, Char, rr, 0n))}, Laws.g.dt.after_frac(List.drop(&2, Char, rr, 0n)))
  : T1o}:
  match rr:
    case []:
      hz([], T.Clock{hh, mi, ss, ""})
    case xh <> +tt:
      match xh:
        case Chr{+xx}:
          t1.F.go(md, fin, Char.is_eq(Chr{xx}, '.'), xx, tt, hh, mi, ss, date, {==}, hz)

# A partial-time's minutes and seconds, after its hour and colon, and then
# the fraction and zone. The scan checks the clock's ranges once it has the
# seconds; the grammar's are prose.clock_ok.

# a result when the test holds, and none otherwise
def t1.gate(bb: Bool, oo: T1o) -> T1o:
  match bb:
    case True{}:
      oo
    case False{}:
      T1none{}

# a match of the grammar's rest handed on when the clock is in range
def t1.ofg(
  pp: Laws.ARest,
  ck: Bool,
  fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  clk: T.Clock,
  aa: List<&2, Char>
) -> T1o:
  match pp:
    case Laws.ALeft{zz}:
      t1.gate(ck, fin(zz, clk, aa))
    case Laws.ANone{}:
      T1none{}

# a range check before the rest is the rest's match with the check
def t1.gofz(
  ck: Bool,
  pp: Laws.ARest,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  +clk: T.Clock,
  +aa: List<&2, Char>
) -> {t1.gate(ck, t1.ofz(pp, fin, clk, aa)) == t1.ofg(pp, ck, fin, clk, aa) : T1o}:
  match ck:
    case True{}:
      match pp:
        case Laws.ALeft{_z}:
          {==}
        case Laws.ANone{}:
          {==}
    case False{}:
      match pp:
        case Laws.ALeft{_z}:
          {==}
        case Laws.ANone{}:
          {==}

# what the grammar says of the text after a partial-time's hour and colon:
# minutes, colon and seconds (qq is the grammar's rest after them), the clock
# in range, and then the fraction and what follows it
def t1.ofc(
  qq: Laws.ARest,
  fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +r5: List<&2, Char>
) -> T1o:
  t1.ofg(Laws.abnf.opt_secfrac(qq), Laws.prose.clock_ok(T.Clock{hh, mi, ss, ""}), fin,
    T.Clock{hh, mi, ss, Laws.g.dt.frac(r5)}, Laws.g.dt.after_frac(r5))

# the scan's three range checks are the clock's ranges
def t1.C.ck(
  +hh: U32,
  +mi: U32,
  +ss: U32
) -> {Bool.and(T.bound.rng(hh, 0, 23), Bool.and(T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60))) ==
  Laws.prose.clock_ok(T.Clock{hh, mi, ss, ""}) : Bool}:
  %t1.rng0(hh, 23) : {Bool.and(T.bound.rng(hh, 0, 23), Bool.and(T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60)))
    == Bool.and(_, Bool.and(U32.is_le(mi, 59), U32.is_le(ss, 60))) : Bool}
  %t1.rng0(mi, 59) : {Bool.and(T.bound.rng(hh, 0, 23), Bool.and(T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60)))
    == Bool.and(T.bound.rng(hh, 0, 23), Bool.and(_, U32.is_le(ss, 60))) : Bool}
  %t1.rng0(ss, 60) : {Bool.and(T.bound.rng(hh, 0, 23), Bool.and(T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60)))
    == Bool.and(T.bound.rng(hh, 0, 23), Bool.and(T.bound.rng(mi, 0, 59), _)) : Bool}
  {==}

# the scan's range checks gate the fraction
def t1.C.rng(
  +md: Bool,
  hk: Bool,
  mk: Bool,
  sk: Bool,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +rr: List<&2, Char>,
  +date: T.Date,
) -> {t1.obs(md, T.when.clock.range(hk, mk, sk, hh, mi, ss, rr, date)) == t1.gate(Bool.and(hk, Bool.and(mk, sk)),
  t1.obs(md, T.when.frac(rr, T.Clock{hh, mi, ss, ""}, date))) : T1o}:
  match hk:
    case False{}:
      t1.obs.fail(md, "hour is out of range")
    case True{}:
      match mk:
        case False{}:
          t1.obs.fail(md, "minute is out of range")
        case True{}:
          match sk:
            case False{}:
              t1.obs.fail(md, "second is out of range")
            case True{}:
              {==}

# the seconds taken: the ranges, then the fraction and the zone
def t1.C.fin(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  +rr: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.clock.range(T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60), hh, mi,
  ss, rr,
  date)) == t1.ofc(Laws.ALeft{rr}, fin, hh, mi, ss, List.drop(&2, Char, rr, 0n)) : T1o}:
  Equal.trans(T1o, t1.obs(md, T.when.clock.range(T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0,
    60), hh, mi,
    ss, rr, date)),
    t1.gate(Bool.and(T.bound.rng(hh, 0, 23), Bool.and(T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60))),
      t1.obs(md, T.when.frac(rr, T.Clock{hh, mi, ss, ""}, date))),
    t1.ofc(Laws.ALeft{rr}, fin, hh, mi, ss, List.drop(&2, Char, rr, 0n)),
    t1.C.rng(md, T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60), hh, mi, ss, rr, date),
    %Equal.sym(Bool, Bool.and(T.bound.rng(hh, 0, 23), Bool.and(T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60))),
      Laws.prose.clock_ok(T.Clock{hh, mi, ss, ""}), t1.C.ck(hh, mi, ss)) : {t1.gate(_, t1.obs(md, T.when.frac(rr,
        T.Clock{hh,
      mi, ss, ""}, date))) == t1.ofc(Laws.ALeft{rr}, fin, hh, mi, ss, List.drop(&2, Char, rr, 0n)) : T1o}
    %Equal.sym(T1o, t1.obs(md, T.when.frac(rr, T.Clock{hh, mi, ss, ""}, date)),
      t1.ofz(Laws.abnf.opt_secfrac(Laws.ALeft{rr}), fin,
      T.Clock{hh, mi, ss, Laws.g.dt.frac(List.drop(&2, Char, rr, 0n))}, Laws.g.dt.after_frac(List.drop(&2, Char, rr,
      0n))), t1.F(md, fin, rr, hh, mi, ss, date, hz)) : {t1.gate(Laws.prose.clock_ok(T.Clock{hh, mi, ss, ""}), _)
      == t1.ofc(Laws.ALeft{rr}, fin, hh, mi, ss, List.drop(&2, Char, rr, 0n)) : T1o}
    t1.gofz(Laws.prose.clock_ok(T.Clock{hh, mi, ss, ""}), Laws.abnf.opt_secfrac(Laws.ALeft{rr}), fin,
      T.Clock{hh, mi, ss, Laws.g.dt.frac(List.drop(&2, Char, rr, 0n))},
      Laws.g.dt.after_frac(List.drop(&2, Char, rr, 0n))))

# the seconds, after the colon that follows the minutes
def t1.C.ss(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  hit: Bool,
  +uu: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.clock.ss(hit, T.take.n(2n, uu, 0, True{}), hh, mi, date)) == t1.ofc(Laws.abnf.time_second(
  Laws.abnf.keep(hit, uu)), fin, hh, mi, Laws.g.two(List.drop(&2, Char, uu, 0n)), List.drop(&2, Char, uu, 2n)) : T1o}:
  match hit:
    case False{}:
      t1.obs.fail(md, "invalid time")
    case True{}:
      t1.tk2(xs => dd => r => {t1.obs(md, T.when.clock.ss.go(dd, hh, mi, date)) == t1.ofc(r, fin, hh, mi,
        Laws.g.two(List.drop(&2, Char, xs, 0n)), List.drop(&2, Char, xs, 2n)) : T1o}, uu,
        _xs => t1.obs.fail(md, "invalid time"),
        +s1 => +s2 => +rr => _e1 => _e2 => t1.C.fin(md, fin, rr, hh, mi, Laws.g.two(s1 <> s2 <> rr), date, hz))

# the colon after the minutes
def t1.C.col(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  rr: List<&2, Char>,
  +hh: U32,
  +mi: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.clock.mm.colon(rr, hh, mi, date)) == t1.ofc(Laws.abnf.time_second(Laws.abnf.char_r(
  Laws.ALeft{rr}, 58)), fin, hh, mi, Laws.g.two(List.drop(&2, Char, rr, 1n)), List.drop(&2, Char, rr, 3n)) : T1o}:
  match rr:
    case []:
      t1.obs.fail(md, "invalid time")
    case qh <> +uu:
      match qh:
        case Chr{+qq}:
          t1.C.ss(md, fin, Char.is_eq(Chr{qq}, ':'), uu, hh, mi, date, hz)

# a partial-time after its hour and colon, then the fraction and what
# follows: the scan reads the minutes and seconds as the grammar's two
# DIGITs each, checks the clock's ranges, and reads the rest (t1.F)
def t1.C(
  +md: Bool,
  -fin: List<&2, Char> -> T.Clock -> List<&2, Char> -> T1o,
  tt: List<&2, Char>,
  +hh: U32,
  +date: T.Date,
  hz: @zz: List<&2, Char> -> @ck: T.Clock -> {t1.obs(md, T.when.zone(zz, ck, date)) == fin(zz, ck, zz) : T1o}
) -> {t1.obs(md, T.when.clock.mm(T.take.n(2n, tt, 0, True{}), hh, date)) == t1.ofc(Laws.abnf.time_second(
  Laws.abnf.char_r(Laws.abnf.time_minute(Laws.ALeft{tt}), 58)), fin, hh, Laws.g.two(List.drop(&2, Char, tt, 0n)),
  Laws.g.two(List.drop(&2, Char, tt, 3n)), List.drop(&2, Char, tt, 5n)) : T1o}:
  t1.tk2(xs => dd => r => {t1.obs(md, T.when.clock.mm(dd, hh, date)) == t1.ofc(Laws.abnf.time_second(
    Laws.abnf.char_r(r, 58)), fin, hh, Laws.g.two(List.drop(&2, Char, xs, 0n)), Laws.g.two(List.drop(&2, Char, xs, 3n)),
    List.drop(&2, Char, xs, 5n)) : T1o}, tt,
    _xs => t1.obs.fail(md, "invalid time"),
    +m1 => +m2 => +rr => _e1 => _e2 => t1.C.col(md, fin, rr, hh, Laws.g.two(m1 <> m2 <> rr), date, hz))


# The date's day check: the code's days of a month are the table's for every
# number, a month's or not. Each month's number is tested in turn; a number
# no month has is read by both as January's 31 days.

# the claim for a month's number
def t1.Dm(+yy: U32, +mo: U32) -> Type:
  {T.when.days(yy, mo) == Laws.days_in(yy, Laws.prose.month(mo)) : U32}

# a number that is a month's number k, or one tested and found not to be
def t1.dd(
  ee: Bool,
  +kk: U32,
  +mo: U32,
  +yy: U32,
  he: {U32.is_eq(mo, kk) == ee : Bool},
  yes: t1.Dm(yy, kk),
  no: {ee == False{} : Bool} -> t1.Dm(yy, mo)
) -> t1.Dm(yy, mo):
  match ee:
    case True{}:
      %Equal.sym(U32, mo, kk, Equal.cong(Char, U32, cc => Char.to_u32(cc), Chr{mo}, Chr{kk}, Eq.u32_eq(mo, kk, he))) :
        {T.when.days(yy, _) == Laws.days_in(yy, Laws.prose.month(_)) : U32}
      yes
    case False{}:
      no({==})

# a number no month has is January to the table
def t1.jan(
  e2: Bool,
  e3: Bool,
  e4: Bool,
  e5: Bool,
  e6: Bool,
  e7: Bool,
  e8: Bool,
  e9: Bool,
  e10: Bool,
  e11: Bool,
  e12: Bool,
  h2: {e2 == False{} : Bool},
  h3: {e3 == False{} : Bool},
  h4: {e4 == False{} : Bool},
  h5: {e5 == False{} : Bool},
  h6: {e6 == False{} : Bool},
  h7: {e7 == False{} : Bool},
  h8: {e8 == False{} : Bool},
  h9: {e9 == False{} : Bool},
  h10: {e10 == False{} : Bool},
  h11: {e11 == False{} : Bool},
  h12: {e12 == False{} : Bool}
) -> {Laws.prose.month.pick(e2, Laws.Feb{}, Laws.prose.month.pick(e3, Laws.Mar{}, Laws.prose.month.pick(e4, Laws.Apr{},
  Laws.prose.month.pick(e5, Laws.May{}, Laws.prose.month.pick(e6, Laws.Jun{}, Laws.prose.month.pick(e7, Laws.Jul{},
  Laws.prose.month.pick(e8, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
  Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{}))))))))))) == Laws.Jan{}
  : Laws.Month}:
  %Equal.sym(Bool, e2, False{}, h2) : {Laws.prose.month.pick(_, Laws.Feb{}, Laws.prose.month.pick(e3, Laws.Mar{},
    Laws.prose.month.pick(e4, Laws.Apr{},
    Laws.prose.month.pick(e5, Laws.May{}, Laws.prose.month.pick(e6, Laws.Jun{}, Laws.prose.month.pick(e7, Laws.Jul{},
    Laws.prose.month.pick(e8, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{}))))))))))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e3, False{}, h3) : {Laws.prose.month.pick(_, Laws.Mar{}, Laws.prose.month.pick(e4, Laws.Apr{},
    Laws.prose.month.pick(e5, Laws.May{}, Laws.prose.month.pick(e6, Laws.Jun{}, Laws.prose.month.pick(e7, Laws.Jul{},
    Laws.prose.month.pick(e8, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{})))))))))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e4, False{}, h4) : {Laws.prose.month.pick(_, Laws.Apr{},
    Laws.prose.month.pick(e5, Laws.May{}, Laws.prose.month.pick(e6, Laws.Jun{}, Laws.prose.month.pick(e7, Laws.Jul{},
    Laws.prose.month.pick(e8, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{}))))))))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e5, False{}, h5) : {Laws.prose.month.pick(_, Laws.May{}, Laws.prose.month.pick(e6, Laws.Jun{},
    Laws.prose.month.pick(e7, Laws.Jul{},
    Laws.prose.month.pick(e8, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{})))))))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e6, False{}, h6) : {Laws.prose.month.pick(_, Laws.Jun{}, Laws.prose.month.pick(e7, Laws.Jul{},
    Laws.prose.month.pick(e8, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{}))))))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e7, False{}, h7) : {Laws.prose.month.pick(_, Laws.Jul{},
    Laws.prose.month.pick(e8, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{})))))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e8, False{}, h8) : {Laws.prose.month.pick(_, Laws.Aug{}, Laws.prose.month.pick(e9, Laws.Sep{},
    Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{}))))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e9, False{}, h9) : {Laws.prose.month.pick(_, Laws.Sep{}, Laws.prose.month.pick(e10, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{})))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e10, False{}, h10) : {Laws.prose.month.pick(_, Laws.Oct{},
    Laws.prose.month.pick(e11, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{}, Laws.Jan{}))) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e11, False{}, h11) : {Laws.prose.month.pick(_, Laws.Nov{}, Laws.prose.month.pick(e12, Laws.Dec{},
    Laws.Jan{})) == Laws.Jan{}
    : Laws.Month}
  %Equal.sym(Bool, e12, False{}, h12) : {Laws.prose.month.pick(_, Laws.Dec{}, Laws.Jan{}) == Laws.Jan{} : Laws.Month}
  {==}

# and 31 days to the code
def t1.d31(
  +yy: U32,
  e2: Bool,
  e4: Bool,
  e6: Bool,
  e9: Bool,
  e11: Bool,
  h2: {e2 == False{} : Bool},
  h4: {e4 == False{} : Bool},
  h6: {e6 == False{} : Bool},
  h9: {e9 == False{} : Bool},
  h11: {e11 == False{} : Bool}
) -> {T.when.days.go(e2, Bool.or(Bool.or(e4, e6), Bool.or(e9, e11)), yy) == 31 : U32}:
  %Equal.sym(Bool, e2, False{}, h2) : {T.when.days.go(_, Bool.or(Bool.or(e4, e6), Bool.or(e9, e11)), yy) == 31 : U32}
  %Equal.sym(Bool, e4, False{}, h4) : {T.when.days.go(False{}, Bool.or(Bool.or(_, e6), Bool.or(e9, e11)),
    yy) == 31 : U32}
  %Equal.sym(Bool, e6, False{}, h6) : {T.when.days.go(False{}, Bool.or(Bool.or(False{}, _), Bool.or(e9, e11)),
    yy) == 31 : U32}
  %Equal.sym(Bool, e9, False{}, h9) : {T.when.days.go(False{}, Bool.or(False{}, Bool.or(_, e11)), yy) == 31 : U32}
  %Equal.sym(Bool, e11, False{}, h11) : {T.when.days.go(False{}, Bool.or(False{}, Bool.or(False{}, _)), yy) == 31 : U32}
  {==}

# a number that is no month's
def t1.dlast(
  +mo: U32,
  +yy: U32,
  h2: {U32.is_eq(mo, 2) == False{} : Bool},
  h3: {U32.is_eq(mo, 3) == False{} : Bool},
  +h4: {U32.is_eq(mo, 4) == False{} : Bool},
  h5: {U32.is_eq(mo, 5) == False{} : Bool},
  +h6: {U32.is_eq(mo, 6) == False{} : Bool},
  h7: {U32.is_eq(mo, 7) == False{} : Bool},
  h8: {U32.is_eq(mo, 8) == False{} : Bool},
  +h9: {U32.is_eq(mo, 9) == False{} : Bool},
  h10: {U32.is_eq(mo, 10) == False{} : Bool},
  +h11: {U32.is_eq(mo, 11) == False{} : Bool},
  h12: {U32.is_eq(mo, 12) == False{} : Bool},
  +g2: {U32.is_eq(mo, 2) == False{} : Bool}
) -> t1.Dm(yy, mo):
  Equal.trans(U32, T.when.days(yy, mo), 31, Laws.days_in(yy, Laws.prose.month(mo)),
    t1.d31(yy, U32.is_eq(mo, 2), U32.is_eq(mo, 4), U32.is_eq(mo, 6), U32.is_eq(mo, 9), U32.is_eq(mo, 11), g2, h4, h6,
      h9, h11),
    Equal.cong(Laws.Month, U32, mm => Laws.days_in(yy, mm), Laws.Jan{}, Laws.prose.month(mo),
      Equal.sym(Laws.Month, Laws.prose.month(mo), Laws.Jan{}, t1.jan(U32.is_eq(mo, 2), U32.is_eq(mo, 3),
        U32.is_eq(mo, 4), U32.is_eq(mo, 5), U32.is_eq(mo, 6), U32.is_eq(mo, 7), U32.is_eq(mo, 8), U32.is_eq(mo, 9),
        U32.is_eq(mo, 10), U32.is_eq(mo, 11), U32.is_eq(mo, 12), h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12))))

# the code's days of a month are the table's, for every number
def t1.days(+yy: U32, +mo: U32) -> t1.Dm(yy, mo):
  t1.dd(U32.is_eq(mo, 2), 2, mo, yy, {==}, days.same(yy, Laws.Feb{}), +h2 =>
  t1.dd(U32.is_eq(mo, 3), 3, mo, yy, {==}, days.same(yy, Laws.Mar{}), h3 =>
  t1.dd(U32.is_eq(mo, 4), 4, mo, yy, {==}, days.same(yy, Laws.Apr{}), +h4 =>
  t1.dd(U32.is_eq(mo, 5), 5, mo, yy, {==}, days.same(yy, Laws.May{}), h5 =>
  t1.dd(U32.is_eq(mo, 6), 6, mo, yy, {==}, days.same(yy, Laws.Jun{}), +h6 =>
  t1.dd(U32.is_eq(mo, 7), 7, mo, yy, {==}, days.same(yy, Laws.Jul{}), h7 =>
  t1.dd(U32.is_eq(mo, 8), 8, mo, yy, {==}, days.same(yy, Laws.Aug{}), h8 =>
  t1.dd(U32.is_eq(mo, 9), 9, mo, yy, {==}, days.same(yy, Laws.Sep{}), +h9 =>
  t1.dd(U32.is_eq(mo, 10), 10, mo, yy, {==}, days.same(yy, Laws.Oct{}), h10 =>
  t1.dd(U32.is_eq(mo, 11), 11, mo, yy, {==}, days.same(yy, Laws.Nov{}), +h11 =>
  t1.dd(U32.is_eq(mo, 12), 12, mo, yy, {==}, days.same(yy, Laws.Dec{}), h12 =>
  t1.dlast(mo, yy, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h2))))))))))))

# an and with False on its right is False
def t1.andf(aa: Bool) -> {Bool.and(aa, False{}) == False{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      {==}

# the date's range check is the scan's two checks, with the code's days of
# the month
def t1.dok(
  +yy: U32,
  +mo: U32,
  +dd: U32
) -> {Laws.prose.date_ok(T.Date{yy, mo, dd}) == Bool.and(T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy,
  mo))) : Bool}:
  %t1.days(yy, mo) : {Bool.and(Laws.abnf.range(mo, 1, 12), Bool.and(U32.is_ge(dd, 1), U32.is_le(dd, _)))
    == Bool.and(T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy, mo))) : Bool}
  {==}

# a datetime with a date out of range is out of range, whatever its zone
def t1.wkz(
  +date: T.Date,
  +clk: T.Clock,
  zz: List<&2, Char>,
  +hd: {Laws.prose.date_ok(date) == False{} : Bool}
) -> {Laws.prose.when_ok(Laws.g.dt.zoned(date, clk, zz)) == False{} : Bool}:
  match zz:
    case []:
      %Equal.sym(Bool, Laws.prose.date_ok(date), False{}, hd) : {Bool.and(_,
        Laws.prose.clock_ok(clk)) == False{} : Bool}
      {==}
    case +zh <> +zt:
      %Equal.sym(Bool, Laws.prose.date_ok(date), False{}, hd) : {Bool.and(_, Bool.and(Laws.prose.clock_ok(clk),
        Laws.prose.zone_ok(Laws.g.dt.zone(zh <> zt)))) == False{} : Bool}
      {==}

# and so is a date alone, or a date with a time after it
def t1.wk(
  +cs: List<&2, Char>,
  +tm: List<&2, Char>,
  ee: Bool,
  +hd: {Laws.prose.date_ok(Laws.g.dt.date(cs)) == False{} : Bool}
) -> {Laws.prose.when_ok(Laws.g.dt.when.pick(False{}, cs, tm, ee)) == False{} : Bool}:
  match ee:
    case True{}:
      hd
    case False{}:
      t1.wkz(Laws.g.dt.date(cs), Laws.g.dt.clock(tm), Laws.g.dt.after_frac(List.drop(&2, Char, tm, 8n)), hd)

# so a word with a date out of range denotes nothing the grammar allows
def t1.dbad(
  +xx: Bool,
  +cs: List<&2, Char>,
  +tm: List<&2, Char>,
  +ee: Bool,
  +hd: {Laws.prose.date_ok(Laws.g.dt.date(cs)) == False{} : Bool}
) -> {t1.pk(Bool.and(xx, Laws.prose.when_ok(Laws.g.dt.when.pick(False{}, cs, tm, ee))),
  Laws.g.dt.when.pick(False{}, cs, tm, ee)) == T1none{} : T1o}:
  %Equal.sym(Bool, Laws.prose.when_ok(Laws.g.dt.when.pick(False{}, cs, tm, ee)), False{}, t1.wk(cs, tm, ee, hd)) :
    {t1.pk(Bool.and(xx, _), Laws.g.dt.when.pick(False{}, cs, tm, ee)) == T1none{} : T1o}
  %Equal.sym(Bool, Bool.and(xx, False{}), False{}, t1.andf(xx)) : {t1.pk(_, Laws.g.dt.when.pick(False{}, cs, tm, ee))
    == T1none{} : T1o}
  {==}

# Finishing a partial-time: after a date and a delimiter, the scan's zone is
# the grammar's time-offset or the end (t1.fdt); after a time alone, the
# scan reads a zone too and then keeps only a local time, and the grammar's
# local-time is the partial-time and nothing after it (t1.ftm).

# after a date: the end, or a time-offset in its range
def t1.fdt(+date: T.Date, +zz: List<&2, Char>, clk: T.Clock, +aa: List<&2, Char>) -> T1o:
  t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz})),
    t1.zok(aa)), Laws.g.dt.zoned(date, clk, aa))

# after a time alone: the end
def t1.ftm(zz: List<&2, Char>, clk: T.Clock, _aa: List<&2, Char>) -> T1o:
  t1.pk(Laws.abnf.all_r(Laws.ALeft{zz}), T.WTime{clk})

# a local datetime kept as its time, and nothing else
def t1.only(oo: T1o) -> T1o:
  match oo:
    case T1some{ww}:
      match ww:
        case T.WLocal{_d, clk}:
          T1some{T.WTime{clk}}
        case _:
          T1none{}
    case T1none{}:
      T1none{}

# what the scan keeps of a time alone
def t1.onlyw(ww: T.WhenOut) -> {t1.wopt(T.when.time.only(ww)) == t1.only(t1.wopt(ww)) : T1o}:
  match ww:
    case T.WSome{w}:
      match w:
        case T.WOff{_d, _c, _z}:
          {==}
        case T.WLocal{_d, _c}:
          {==}
        case T.WDate{_d}:
          {==}
        case T.WTime{_c}:
          {==}
    case T.WFail{_y}:
      {==}
    case T.WSkip{}:
      {==}

# a datetime with a zone is no time alone
def t1.only.off(
  bb: Bool,
  +date: T.Date,
  +clk: T.Clock,
  +zn: T.Zone
) -> {t1.only(t1.pk(bb, T.WOff{date, clk, zn})) == T1none{} : T1o}:
  match bb:
    case True{}:
      {==}
    case False{}:
      {==}

# a time alone: the end is kept, and a zone is refused
def t1.zt(
  zz: List<&2, Char>,
  +clk: T.Clock
) -> {t1.obs(False{}, T.when.zone(zz, clk, T.Date{0, 1, 1})) == t1.ftm(zz, clk, zz) : T1o}:
  match zz:
    case []:
      {==}
    case +zh <> +zt:
      Equal.trans(T1o, t1.wopt(T.when.time.only(T.when.zone(zh <> zt, clk, T.Date{0, 1, 1}))),
        t1.only(t1.wopt(T.when.zone(zh <> zt, clk, T.Date{0, 1, 1}))), T1none{},
        t1.onlyw(T.when.zone(zh <> zt, clk, T.Date{0, 1, 1})),
        Equal.trans(T1o, t1.only(t1.wopt(T.when.zone(zh <> zt, clk, T.Date{0, 1, 1}))),
          t1.only(t1.zn(zh <> zt, clk, T.Date{0, 1, 1})), T1none{},
          Equal.cong(T1o, T1o, oo => t1.only(oo), t1.wopt(T.when.zone(zh <> zt, clk, T.Date{0, 1, 1})),
            t1.zn(zh <> zt, clk, T.Date{0, 1, 1}), t1.z(zh <> zt, clk, T.Date{0, 1, 1})),
          t1.only.off(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zh <> zt})), False{}),
            t1.zok(zh <> zt)), T.Date{0, 1, 1}, clk, Laws.g.dt.zone(zh <> zt))))

# a time alone, its clock gated by its range: the partial-time and nothing
# after it, with the clock in range
def t1.algt(
  pp: Laws.ARest,
  ck: Bool,
  +clk: T.Clock,
  +aa: List<&2, Char>
) -> {t1.ofg(pp, ck, zz => cc => ab => t1.ftm(zz, cc, ab), clk, aa)
  == t1.pk(Bool.and(Laws.abnf.all_r(pp), ck), T.WTime{clk}) : T1o}:
  match pp:
    case Laws.ALeft{zz}:
      match zz:
        case []:
          match ck:
            case True{}:
              {==}
            case False{}:
              {==}
        case _h <> _t:
          match ck:
            case True{}:
              {==}
            case False{}:
              {==}
    case Laws.ANone{}:
      {==}

# the scan's clock check gating the zone's, against the grammar's ranges,
# when the word ends after its partial-time
def t1.b4(
  ck: Bool,
  aa: Bool,
  bb: Bool,
  +ww: T.When
) -> {t1.gate(ck, t1.pk(Bool.and(Bool.or(aa, bb), True{}), ww)) == t1.pk(Bool.and(Bool.or(aa, Bool.or(bb, False{})),
  Bool.and(True{}, ck)), ww) : T1o}:
  match ck:
    case False{}:
      match aa:
        case True{}:
          {==}
        case False{}:
          match bb:
            case True{}:
              {==}
            case False{}:
              {==}
    case True{}:
      match aa:
        case True{}:
          {==}
        case False{}:
          match bb:
            case True{}:
              {==}
            case False{}:
              {==}

# and when a time-offset follows it
def t1.b5(
  ck: Bool,
  aa: Bool,
  bb: Bool,
  +zk: Bool,
  +ww: T.When
) -> {t1.gate(ck, t1.pk(Bool.and(Bool.or(aa, bb), zk), ww)) == t1.pk(Bool.and(Bool.or(aa, Bool.or(bb, False{})),
  Bool.and(True{}, Bool.and(ck, zk))), ww) : T1o}:
  match ck:
    case False{}:
      match aa:
        case True{}:
          match zk:
            case True{}:
              {==}
            case False{}:
              {==}
        case False{}:
          match bb:
            case True{}:
              match zk:
                case True{}:
                  {==}
                case False{}:
                  {==}
            case False{}:
              {==}
    case True{}:
      match aa:
        case True{}:
          {==}
        case False{}:
          match bb:
            case True{}:
              {==}
            case False{}:
              {==}

# a date and a time, its clock gated by its range, and then the end or a
# time-offset: the grammar's local-date-time or offset-date-time, with every
# field in range, when the date is in range
def t1.algd(
  pp: Laws.ARest,
  aa: List<&2, Char>,
  ck: Bool,
  +date: T.Date,
  +clk: T.Clock,
  hdo: {Laws.prose.date_ok(date) == True{} : Bool},
  hck: {Laws.prose.clock_ok(clk) == ck : Bool}
) -> {t1.ofg(pp, ck, zz => cc => ab => t1.fdt(date, zz, cc, ab), clk, aa)
  == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(pp)), Bool.or(Laws.abnf.all_r(pp), False{})),
    Laws.prose.when_ok(Laws.g.dt.zoned(date, clk, aa))), Laws.g.dt.zoned(date, clk, aa)) : T1o}:
  match pp:
    case Laws.ANone{}:
      {==}
    case Laws.ALeft{+zz}:
      match aa:
        case []:
          %Equal.sym(Bool, Laws.prose.date_ok(date), True{}, hdo) : {t1.gate(ck, t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(
            Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz})), True{}), T.WLocal{date, clk}))
            == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})),
            Bool.or(Laws.abnf.all_r(Laws.ALeft{zz}), False{})), Bool.and(_, Laws.prose.clock_ok(clk))),
            T.WLocal{date, clk}) : T1o}
          %Equal.sym(Bool, Laws.prose.clock_ok(clk), ck, hck) : {t1.gate(ck, t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(
            Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz})), True{}), T.WLocal{date, clk}))
            == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})),
            Bool.or(Laws.abnf.all_r(Laws.ALeft{zz}), False{})), Bool.and(True{}, _)),
            T.WLocal{date, clk}) : T1o}
          t1.b4(ck, Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz}),
            T.WLocal{date, clk})
        case +ah <> +at:
          %Equal.sym(Bool, Laws.prose.date_ok(date), True{}, hdo) : {t1.gate(ck, t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(
            Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz})), Laws.prose.zone_ok(
            Laws.g.dt.zone(ah <> at))), T.WOff{date, clk, Laws.g.dt.zone(ah <> at)}))
            == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})),
            Bool.or(Laws.abnf.all_r(Laws.ALeft{zz}), False{})), Bool.and(_, Bool.and(Laws.prose.clock_ok(clk),
            Laws.prose.zone_ok(Laws.g.dt.zone(ah <> at))))), T.WOff{date, clk, Laws.g.dt.zone(ah <> at)}) : T1o}
          %Equal.sym(Bool, Laws.prose.clock_ok(clk), ck, hck) : {t1.gate(ck, t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(
            Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz})), Laws.prose.zone_ok(
            Laws.g.dt.zone(ah <> at))), T.WOff{date, clk, Laws.g.dt.zone(ah <> at)}))
            == t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})),
            Bool.or(Laws.abnf.all_r(Laws.ALeft{zz}), False{})), Bool.and(True{}, Bool.and(_,
            Laws.prose.zone_ok(Laws.g.dt.zone(ah <> at))))), T.WOff{date, clk, Laws.g.dt.zone(ah <> at)}) : T1o}
          t1.b5(ck, Laws.abnf.all_r(Laws.abnf.time_offset(Laws.ALeft{zz})), Laws.abnf.all_r(Laws.ALeft{zz}),
            Laws.prose.zone_ok(Laws.g.dt.zone(ah <> at)), T.WOff{date, clk, Laws.g.dt.zone(ah <> at)})

# The whole word. toml.abnf's date-time is four alternatives; offset-date-time,
# local-date-time and local-date start with a full-date and local-time with a
# partial-time, and each of those starts with two DIGITs. The scan takes the
# same two digits and then goes by the third character: a colon is a time
# alone, and a digit a date.

# the four alternatives, from what full-date (fd) and partial-time (pt) left
# of the word
def t1.G(+fd: Laws.ARest, pt: Laws.ARest) -> Bool:
  Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(Laws.abnf.partial_time(Laws.abnf.time_delim(fd)))),
    Bool.or(Laws.abnf.all_r(Laws.abnf.partial_time(Laws.abnf.time_delim(fd))),
    Bool.or(Laws.abnf.all_r(fd), Laws.abnf.all_r(pt))))

# the datetime a word denotes, with its third character's colon test given
def t1.W3(colon: Bool, +cs: List<&2, Char>) -> T.When:
  Laws.g.dt.when.pick(colon, cs, List.drop(&2, Char, cs, 11n), List.is_empty(&2, Char, List.drop(&2, Char, cs, 10n)))

# what the grammar says of a word, from what full-date and partial-time left
# of it and its third character's colon test
def t1.S3(fd: Laws.ARest, pt: Laws.ARest, +colon: Bool, +cs: List<&2, Char>) -> T1o:
  t1.pk(Bool.and(t1.G(fd, pt), Laws.prose.when_ok(t1.W3(colon, cs))), t1.W3(colon, cs))

# full-date after its first two DIGITs
def t1.FDa(xx: Laws.ARest) -> Laws.ARest:
  Laws.abnf.date_mday(Laws.abnf.char_r(Laws.abnf.date_month(Laws.abnf.char_r(Laws.abnf.digit_r(Laws.abnf.digit_r(xx)),
    45)), 45))

# after three
def t1.FDb(xx: Laws.ARest) -> Laws.ARest:
  Laws.abnf.date_mday(Laws.abnf.char_r(Laws.abnf.date_month(Laws.abnf.char_r(Laws.abnf.digit_r(xx), 45)), 45))

# after the year
def t1.FDc(xx: Laws.ARest) -> Laws.ARest:
  Laws.abnf.date_mday(Laws.abnf.char_r(Laws.abnf.date_month(Laws.abnf.char_r(xx, 45)), 45))

# partial-time after its hour
def t1.PTa(xx: Laws.ARest) -> Laws.ARest:
  Laws.abnf.opt_secfrac(Laws.abnf.time_second(Laws.abnf.char_r(Laws.abnf.time_minute(Laws.abnf.char_r(xx, 58)), 58)))

# after its hour and colon
def t1.PTb(xx: Laws.ARest) -> Laws.ARest:
  Laws.abnf.opt_secfrac(Laws.abnf.time_second(Laws.abnf.char_r(Laws.abnf.time_minute(xx), 58)))

# what the grammar says after a full-date and a time-delim: the partial-time
# matched (pp) and what follows it, with the date and the time's text tm
def t1.SP(+pp: Laws.ARest, +date: T.Date, +tm: List<&2, Char>) -> T1o:
  t1.pk(Bool.and(Bool.or(Laws.abnf.all_r(Laws.abnf.time_offset(pp)), Bool.or(Laws.abnf.all_r(pp), False{})),
    Laws.prose.when_ok(Laws.g.dt.zoned(date, Laws.g.dt.clock(tm), Laws.g.dt.after_frac(List.drop(&2, Char, tm, 8n))))),
    Laws.g.dt.zoned(date, Laws.g.dt.clock(tm), Laws.g.dt.after_frac(List.drop(&2, Char, tm, 8n))))

# the time's colon after its hour, and the rest of the time
def t1.r17(
  hit: Bool,
  +h1: Char,
  +h2: Char,
  +qq: U32,
  +t3: List<&2, Char>,
  +date: T.Date,
  hdo: {Laws.prose.date_ok(date) == True{} : Bool}
) -> {t1.wopt(T.when.clock.colon.go(hit, Laws.g.two(h1 <> h2 <> Chr{qq} <> t3), t3, date))
  == t1.SP(t1.PTb(Laws.abnf.keep(hit, t3)), date, h1 <> h2 <> Chr{qq} <> t3) : T1o}:
  match hit:
    case False{}:
      {==}
    case True{}:
      Equal.trans(T1o, t1.wopt(T.when.clock.mm(T.take.n(2n, t3, 0, True{}), Laws.g.two(h1 <> h2 <> Chr{qq} <> t3),
        date)),
        t1.ofc(Laws.abnf.time_second(Laws.abnf.char_r(Laws.abnf.time_minute(Laws.ALeft{t3}), 58)),
          zz => cc => ab => t1.fdt(date, zz, cc, ab), Laws.g.two(h1 <> h2 <> Chr{qq} <> t3),
          Laws.g.two(List.drop(&2, Char, t3, 0n)), Laws.g.two(List.drop(&2, Char, t3, 3n)), List.drop(&2, Char, t3,
            5n)),
        t1.SP(t1.PTb(Laws.ALeft{t3}), date, h1 <> h2 <> Chr{qq} <> t3),
        t1.C(True{}, zz => cc => ab => t1.fdt(date, zz, cc, ab), t3, Laws.g.two(h1 <> h2 <> Chr{qq} <> t3), date,
          zz => ck => t1.z(zz, ck, date)),
        t1.algd(t1.PTb(Laws.ALeft{t3}), Laws.g.dt.after_frac(List.drop(&2, Char, t3, 5n)),
          Laws.prose.clock_ok(T.Clock{Laws.g.two(h1 <> h2 <> Chr{qq} <> t3), Laws.g.two(List.drop(&2, Char, t3, 0n)),
          Laws.g.two(List.drop(&2, Char, t3, 3n)), ""}), date, Laws.g.dt.clock(h1 <> h2 <> Chr{qq} <> t3), hdo, {==}))

# the character after the time's hour
def t1.r16(
  +h1: Char,
  +h2: Char,
  rr: List<&2, Char>,
  +date: T.Date,
  hdo: {Laws.prose.date_ok(date) == True{} : Bool}
) -> {t1.wopt(T.when.clock.colon(rr, Laws.g.two(h1 <> h2 <> rr), date))
  == t1.SP(t1.PTa(Laws.ALeft{rr}), date, h1 <> h2 <> rr) : T1o}:
  match rr:
    case []:
      {==}
    case qh <> +t3:
      match qh:
        case Chr{+qq}:
          t1.r17(Char.is_eq(Chr{qq}, ':'), h1, h2, qq, t3, date, hdo)

# the time's hour, after the delimiter
def t1.r15(
  +t2: List<&2, Char>,
  +date: T.Date,
  hdo: {Laws.prose.date_ok(date) == True{} : Bool}
) -> {t1.wopt(T.when.clock.of(T.take.n(2n, t2, 0, True{}), date))
  == t1.SP(Laws.abnf.partial_time(Laws.ALeft{t2}), date, List.drop(&2, Char, t2, 0n)) : T1o}:
  t1.tk2(xs => dd => r => {t1.wopt(T.when.clock.of(dd, date)) == t1.SP(t1.PTa(r), date, List.drop(&2, Char, xs, 0n))
    : T1o}, t2, _xs => {==}, +h1 => +h2 => +rr => _e1 => _e2 => t1.r16(h1, h2, rr, date, hdo))

# the delimiter after a date: T or t, or a space
def t1.r14(
  tee: Bool,
  sp: Bool,
  +t2: List<&2, Char>,
  +date: T.Date,
  hdo: {Laws.prose.date_ok(date) == True{} : Bool}
) -> {t1.wopt(T.when.after.sep(tee, sp, date, t2)) == t1.SP(Laws.abnf.partial_time(Laws.abnf.or_r(
  Laws.abnf.keep(tee, t2), Laws.abnf.keep(sp, t2))), date, List.drop(&2, Char, t2, 0n)) : T1o}:
  match tee:
    case True{}:
      t1.r15(t2, date, hdo)
    case False{}:
      match sp:
        case True{}:
          t1.r15(t2, date, hdo)
        case False{}:
          {==}

# the ten characters of a date, then the rest of a word
def t1.pre(
  +c1: Char,
  +c2: Char,
  +c3: Char,
  +c4: Char,
  +c5: Char,
  +c6: Char,
  +c7: Char,
  +c8: Char,
  +c9: Char,
  +c10: Char,
  +rest: List<&2, Char>
) -> List<&2, Char>:
  c1 <> c2 <> c3 <> c4 <> c5 <> c6 <> c7 <> c8 <> c9 <> c10 <> rest

# two tests that answered as two bits, joined
def t1.and2(
  +aa: Bool,
  +bb: Bool,
  +xx: Bool,
  +yy: Bool,
  ha: {aa == xx : Bool},
  hb: {bb == yy : Bool}
) -> {Bool.and(aa, bb) == Bool.and(xx, yy) : Bool}:
  Equal.trans(Bool, Bool.and(aa, bb), Bool.and(xx, bb), Bool.and(xx, yy),
    Equal.cong(Bool, Bool, zz => Bool.and(zz, bb), aa, xx, ha),
    Equal.cong(Bool, Bool, zz => Bool.and(xx, zz), bb, yy, hb))

# the number two digits write
def t1.two2(+c1: Char, +c2: Char) -> U32:
  Laws.g.two(c1 <> c2 <> [])

# the number four digits write
def t1.four4(+c1: Char, +c2: Char, +c3: Char, +c4: Char) -> U32:
  Laws.g.four(c1 <> c2 <> c3 <> c4 <> [])

# the scan's day check, of a year, a month and a day's digits
def t1.dayck(+yy: U32, +mo: U32, +c9: Char, +c10: Char) -> Bool:
  T.bound.rng(t1.two2(c9, c10), 1, T.when.days(yy, mo))

# the date's range, as the scan's two checks answered
def t1.dq(
  +yy: U32,
  +c6: Char,
  +c7: Char,
  +c9: Char,
  +c10: Char,
  +mo_ok: Bool,
  +d_ok: Bool,
  hmo: {T.bound.rng(t1.two2(c6, c7), 1, 12) == mo_ok : Bool},
  hdk: {t1.dayck(yy, t1.two2(c6, c7), c9, c10) == d_ok : Bool}
) -> {Laws.prose.date_ok(T.Date{yy, t1.two2(c6, c7), t1.two2(c9, c10)}) == Bool.and(mo_ok, d_ok) : Bool}:
  Equal.trans(Bool, Laws.prose.date_ok(T.Date{yy, t1.two2(c6, c7), t1.two2(c9, c10)}),
    Bool.and(T.bound.rng(t1.two2(c6, c7), 1, 12), t1.dayck(yy, t1.two2(c6, c7), c9, c10)), Bool.and(mo_ok, d_ok),
    t1.dok(yy, t1.two2(c6, c7), t1.two2(c9, c10)),
    t1.and2(T.bound.rng(t1.two2(c6, c7), 1, 12), t1.dayck(yy, t1.two2(c6, c7), c9, c10), mo_ok, d_ok, hmo, hdk))

# what follows a date: nothing, or a delimiter and a time
def t1.r13(
  rest: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +c3: Char,
  +c4: Char,
  +c5: Char,
  +c6: Char,
  +c7: Char,
  +c8: Char,
  +c9: Char,
  +c10: Char,
  hdo: {Laws.prose.date_ok(T.Date{t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), t1.two2(c9, c10)}) == True{} : Bool}
) -> {t1.wopt(T.when.after.date(T.Date{t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), t1.two2(c9, c10)}, rest))
  == t1.S3(Laws.ALeft{rest}, Laws.ANone{}, False{}, t1.pre(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, rest)) : T1o}:
  match rest:
    case []:
      %Equal.sym(Bool, Laws.prose.date_ok(T.Date{t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), t1.two2(c9, c10)}),
        True{}, hdo) : {T1some{T.WDate{T.Date{t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), t1.two2(c9, c10)}}}
        == t1.pk(Bool.and(True{}, _), T.WDate{T.Date{t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), t1.two2(c9, c10)}})
        : T1o}
      {==}
    case sh <> +t2:
      match sh:
        case Chr{+ss}:
          t1.r14(Bool.or(Char.is_eq(Chr{ss}, 'T'), Char.is_eq(Chr{ss}, 't')), Char.is_eq(Chr{ss}, ' '), t2,
            T.Date{t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), t1.two2(c9, c10)}, hdo)

# the date's two range checks: a date out of range denotes nothing
def t1.r12(
  mo_ok: Bool,
  d_ok: Bool,
  +rest: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +c3: Char,
  +c4: Char,
  +c5: Char,
  +c6: Char,
  +c7: Char,
  +c8: Char,
  +c9: Char,
  +c10: Char,
  +hmo: {T.bound.rng(t1.two2(c6, c7), 1, 12) == mo_ok : Bool},
  +hdk: {t1.dayck(t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), c9, c10) == d_ok : Bool}
) -> {t1.wopt(T.when.date.ok.go(mo_ok, d_ok, t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), t1.two2(c9, c10), rest))
  == t1.S3(Laws.ALeft{rest}, Laws.ANone{}, False{}, t1.pre(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, rest)) : T1o}:
  match mo_ok:
    case False{}:
      Equal.sym(T1o, t1.S3(Laws.ALeft{rest}, Laws.ANone{}, False{}, t1.pre(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10,
        rest)), T1none{}, t1.dbad(t1.G(Laws.ALeft{rest}, Laws.ANone{}), t1.pre(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10,
        rest), List.drop(&2, Char, rest, 1n), List.is_empty(&2, Char, List.drop(&2, Char, rest, 0n)),
        t1.dq(t1.four4(c1, c2, c3, c4), c6, c7, c9, c10, False{}, d_ok, hmo, hdk)))
    case True{}:
      match d_ok:
        case False{}:
          Equal.sym(T1o, t1.S3(Laws.ALeft{rest}, Laws.ANone{}, False{}, t1.pre(c1, c2, c3, c4, c5, c6, c7, c8, c9,
            c10, rest)), T1none{}, t1.dbad(t1.G(Laws.ALeft{rest}, Laws.ANone{}), t1.pre(c1, c2, c3, c4, c5, c6, c7,
            c8, c9, c10, rest), List.drop(&2, Char, rest, 1n), List.is_empty(&2, Char, List.drop(&2, Char, rest, 0n)),
            t1.dq(t1.four4(c1, c2, c3, c4), c6, c7, c9, c10, True{}, False{}, hmo, hdk)))
        case True{}:
          t1.r13(rest, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10,
            t1.dq(t1.four4(c1, c2, c3, c4), c6, c7, c9, c10, True{}, True{}, hmo, hdk))

# the day's two digits, after its dash
def t1.r10(
  hit: Bool,
  +v2: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +c3: Char,
  +c4: Char,
  +c5: Char,
  +c6: Char,
  +c7: Char,
  +c8: Char
) -> {t1.wopt(T.when.day.go(hit, T.take.n(2n, v2, 0, True{}), t1.four4(c1, c2, c3, c4), t1.two2(c6, c7)))
  == t1.S3(Laws.abnf.date_mday(Laws.abnf.keep(hit, v2)), Laws.ANone{}, False{}, c1 <> c2 <> c3 <> c4 <> c5 <> c6
  <> c7 <> c8 <> v2) : T1o}:
  match hit:
    case False{}:
      {==}
    case True{}:
      t1.tk2(xs => dd => r => {t1.wopt(T.when.day.end(dd, t1.four4(c1, c2, c3, c4), t1.two2(c6, c7)))
        == t1.S3(r, Laws.ANone{}, False{}, c1 <> c2 <> c3 <> c4 <> c5 <> c6 <> c7 <> c8 <> xs) : T1o}, v2, _xs => {==},
        +d1 => +d2 => +rest => _e1 => _e2 => t1.r12(T.bound.rng(t1.two2(c6, c7), 1, 12),
          t1.dayck(t1.four4(c1, c2, c3, c4), t1.two2(c6, c7), d1, d2), rest, c1, c2, c3, c4, c5, c6, c7, c8, d1, d2,
          {==}, {==}))

# the dash before the day
def t1.r9(
  ww: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +c3: Char,
  +c4: Char,
  +c5: Char,
  +c6: Char,
  +c7: Char
) -> {t1.wopt(T.when.day(ww, Laws.g.four(c1 <> c2 <> c3 <> c4 <> []), Laws.g.two(c6 <> c7 <> [])))
  == t1.S3(Laws.abnf.date_mday(Laws.abnf.char_r(Laws.ALeft{ww}, 45)), Laws.ANone{}, False{}, c1 <> c2 <> c3 <> c4
  <> c5 <> c6 <> c7 <> ww) : T1o}:
  match ww:
    case []:
      {==}
    case zh <> +v2:
      match zh:
        case Chr{+z2}:
          t1.r10(Char.is_eq(Chr{z2}, '-'), v2, c1, c2, c3, c4, c5, c6, c7, Chr{z2})

# the month's two digits, after its dash
def t1.r8(
  hit: Bool,
  +vv: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +c3: Char,
  +c4: Char,
  +c5: Char
) -> {t1.wopt(T.when.month(hit, T.take.n(2n, vv, 0, True{}), Laws.g.four(c1 <> c2 <> c3 <> c4 <> [])))
  == t1.S3(Laws.abnf.date_mday(Laws.abnf.char_r(Laws.abnf.date_month(Laws.abnf.keep(hit, vv)), 45)), Laws.ANone{},
  False{}, c1 <> c2 <> c3 <> c4 <> c5 <> vv) : T1o}:
  match hit:
    case False{}:
      {==}
    case True{}:
      t1.tk2(xs => dd => r => {t1.wopt(T.when.month.go(dd, Laws.g.four(c1 <> c2 <> c3 <> c4 <> [])))
        == t1.S3(Laws.abnf.date_mday(Laws.abnf.char_r(r, 45)), Laws.ANone{}, False{}, c1 <> c2 <> c3 <> c4 <> c5 <> xs)
        : T1o}, vv, _xs => {==},
        +m1 => +m2 => +ww => _e1 => _e2 => t1.r9(ww, c1, c2, c3, c4, c5, m1, m2))

# the dash after the year
def t1.r7(
  uu: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +c3: Char,
  +c4: Char
) -> {t1.wopt(T.when.year.dash(uu, Laws.g.four(c1 <> c2 <> c3 <> c4 <> [])))
  == t1.S3(t1.FDc(Laws.ALeft{uu}), Laws.ANone{}, False{}, c1 <> c2 <> c3 <> c4 <> uu) : T1o}:
  match uu:
    case []:
      {==}
    case zh <> +vv:
      match zh:
        case Chr{+zz}:
          t1.r8(Char.is_eq(Chr{zz}, '-'), vv, c1, c2, c3, c4, Chr{zz})

# the year's fourth digit
def t1.r6(
  dg: Bool,
  +yy: U32,
  +uu: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +xx: U32
) -> {t1.wopt(T.when.year4(T.take.fin(dg, T.take.acc.d(dg, U32.add(U32.mul(Laws.g.two(c1 <> c2 <> []), 10),
  U32.sub(xx, 48)), Chr{yy}), uu))) == t1.S3(t1.FDc(Laws.abnf.keep(dg, uu)), Laws.ANone{}, False{}, c1 <> c2 <> Chr{xx}
  <> Chr{yy} <> uu) : T1o}:
  match dg:
    case False{}:
      {==}
    case True{}:
      t1.r7(uu, c1, c2, Chr{xx}, Chr{yy})

# the character after the year's third digit
def t1.r5(
  tt: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +xx: U32
) -> {t1.wopt(T.when.year4(T.take.n(1n, tt, U32.add(U32.mul(Laws.g.two(c1 <> c2 <> []), 10), U32.sub(xx, 48)), True{})))
  == t1.S3(t1.FDb(Laws.ALeft{tt}), Laws.ANone{}, False{}, c1 <> c2 <> Chr{xx} <> tt) : T1o}:
  match tt:
    case []:
      {==}
    case yh <> +uu:
      match yh:
        case Chr{+yy}:
          t1.r6(Char.is_digit(Chr{yy}), yy, uu, c1, c2, xx)

# a digit's value is its code point less 48
def t1.dv(+xx: U32, hd: {Char.is_digit(Chr{xx}) == True{} : Bool}) -> {T.dig.val(Chr{xx}) == U32.sub(xx, 48) : U32}:
  %Equal.sym(Bool, Char.is_digit(Chr{xx}), True{}, hd) : {T.dig.dec(_, xx) == U32.sub(xx, 48) : U32}
  {==}

# a year: its third character is a digit
def t1.r4(
  +tt: List<&2, Char>,
  +c1: Char,
  +c2: Char,
  +xx: U32,
  +hd: {Char.is_digit(Chr{xx}) == True{} : Bool}
) -> {t1.wopt(T.when.year.more(True{}, Laws.g.two(c1 <> c2 <> Chr{xx} <> tt), Chr{xx}, tt))
  == t1.S3(t1.FDb(Laws.ALeft{tt}), Laws.ANone{}, False{}, c1 <> c2 <> Chr{xx} <> tt) : T1o}:
  %Equal.sym(U32, T.dig.val(Chr{xx}), U32.sub(xx, 48), t1.dv(xx, hd)) : {t1.wopt(T.when.year4(T.take.n(1n, tt,
    U32.add(U32.mul(Laws.g.two(c1 <> c2 <> Chr{xx} <> tt), 10), _), True{}))) == t1.S3(t1.FDb(Laws.ALeft{tt}),
    Laws.ANone{}, False{}, c1 <> c2 <> Chr{xx} <> tt) : T1o}
  t1.r5(tt, c1, c2, xx)

# no colon third: a date, when the third character is a digit
def t1.rd(
  digit: Bool,
  +c1: Char,
  +c2: Char,
  +xx: U32,
  +tt: List<&2, Char>,
  +hd: {Char.is_digit(Chr{xx}) == digit : Bool}
) -> {t1.wopt(T.when.branch(False{}, digit, Laws.g.two(c1 <> c2 <> Chr{xx} <> tt), Chr{xx}, tt))
  == t1.S3(t1.FDb(Laws.abnf.keep(digit, tt)), Laws.ANone{}, False{}, c1 <> c2 <> Chr{xx} <> tt) : T1o}:
  match digit:
    case False{}:
      {==}
    case True{}:
      t1.r4(tt, c1, c2, xx, hd)

# a colon third: a time alone, since a colon is no digit
def t1.rt(
  digit: Bool,
  +c1: Char,
  +c2: Char,
  +xx: U32,
  +tt: List<&2, Char>,
  hd: {Char.is_digit(':') == digit : Bool}
) -> {t1.wopt(T.when.branch(True{}, digit, Laws.g.two(c1 <> c2 <> Chr{xx} <> tt), Chr{xx}, tt))
  == t1.S3(t1.FDb(Laws.abnf.keep(digit, tt)), t1.PTb(Laws.ALeft{tt}), True{}, c1 <> c2 <> Chr{xx} <> tt) : T1o}:
  match digit:
    case True{}:
      Eq.bit.absurd(&2, {t1.wopt(T.when.branch(True{}, True{}, Laws.g.two(c1 <> c2 <> Chr{xx} <> tt), Chr{xx}, tt))
        == t1.S3(t1.FDb(Laws.ALeft{tt}), t1.PTb(Laws.ALeft{tt}), True{}, c1 <> c2 <> Chr{xx} <> tt) : T1o}, hd)
    case False{}:
      Equal.trans(T1o, t1.obs(False{}, T.when.clock.mm(T.take.n(2n, tt, 0, True{}),
        Laws.g.two(c1 <> c2 <> Chr{xx} <> tt),
        T.Date{0, 1, 1})),
        t1.ofc(Laws.abnf.time_second(Laws.abnf.char_r(Laws.abnf.time_minute(Laws.ALeft{tt}), 58)),
          zz => cc => ab => t1.ftm(zz, cc, ab), Laws.g.two(c1 <> c2 <> Chr{xx} <> tt),
          Laws.g.two(List.drop(&2, Char, tt, 0n)), Laws.g.two(List.drop(&2, Char, tt, 3n)), List.drop(&2, Char, tt,
            5n)),
        t1.S3(Laws.ANone{}, t1.PTb(Laws.ALeft{tt}), True{}, c1 <> c2 <> Chr{xx} <> tt),
        t1.C(False{}, zz => cc => ab => t1.ftm(zz, cc, ab), tt, Laws.g.two(c1 <> c2 <> Chr{xx} <> tt), T.Date{0, 1, 1},
          zz => ck => t1.zt(zz, ck)),
        t1.algt(t1.PTb(Laws.ALeft{tt}), Laws.prose.clock_ok(T.Clock{Laws.g.two(c1 <> c2 <> Chr{xx} <> tt),
          Laws.g.two(List.drop(&2, Char, tt, 0n)), Laws.g.two(List.drop(&2, Char, tt, 3n)), ""}),
          Laws.g.dt.clock(c1 <> c2 <> Chr{xx} <> tt), Laws.g.dt.after_frac(List.drop(&2, Char, tt, 5n))))

# the third character: a colon, a digit, or neither
def t1.r3(
  colon: Bool,
  +digit: Bool,
  +c1: Char,
  +c2: Char,
  +xx: U32,
  +tt: List<&2, Char>,
  hc: {Char.is_eq(Chr{xx}, ':') == colon : Bool},
  +hd: {Char.is_digit(Chr{xx}) == digit : Bool}
) -> {t1.wopt(T.when.branch(colon, digit, Laws.g.two(c1 <> c2 <> Chr{xx} <> tt), Chr{xx}, tt))
  == t1.S3(t1.FDb(Laws.abnf.keep(digit, tt)), t1.PTb(Laws.abnf.keep(colon, tt)), colon, c1 <> c2 <> Chr{xx} <> tt)
  : T1o}:
  match colon:
    case True{}:
      t1.rt(digit, c1, c2, xx, tt, Equal.trans(Bool, Char.is_digit(':'), Char.is_digit(Chr{xx}), digit,
        Equal.cong(Char, Bool, cc => Char.is_digit(cc), ':', Chr{xx},
          Equal.sym(Char, Chr{xx}, ':', Eq.char_eq_true(Chr{xx}, ':', hc))), hd))
    case False{}:
      t1.rd(digit, c1, c2, xx, tt, hd)

# after the first two digits
def t1.r2(
  +c1: Char,
  +c2: Char,
  rr: List<&2, Char>
) -> {t1.wopt(T.when.after2(T.DigOk{Laws.g.two(c1 <> c2 <> rr), rr})) == t1.S3(t1.FDa(Laws.ALeft{rr}),
  t1.PTa(Laws.ALeft{rr}), Laws.abnf.cp(Laws.g.dt.third(c1 <> c2 <> rr), 58), c1 <> c2 <> rr) : T1o}:
  match rr:
    case []:
      {==}
    case xh <> +tt:
      match xh:
        case Chr{+xx}:
          t1.r3(Char.is_eq(Chr{xx}, ':'), Char.is_digit(Chr{xx}), c1, c2, xx, tt, {==}, {==})

# the datetime scan reads a word exactly as the grammar says: the datetime a
# word denotes when it matches one of the four date-time rules with every
# field in range, and nothing otherwise
def t1.read(+cs: List<&2, Char>) -> {t1.wopt(T.when.read(cs)) == t1.spec(cs) : T1o}:
  t1.tk2(xs => dd => r => {t1.wopt(T.when.after2(dd)) == t1.S3(t1.FDa(r), t1.PTa(r),
    Laws.abnf.cp(Laws.g.dt.third(xs), 58), xs) : T1o}, cs, _xs => {==},
    +c1 => +c2 => +rr => _e1 => _e2 => t1.r2(c1, c2, rr))

# The route to the datetime scan. word.val sends a word to the datetime scan
# when it starts with no special's first character, holds a colon or a dash
# after its first character, and holds no e or E; a special word and a
# numeral are never datetimes.

# a bare word's value as a datetime, or none
def t1.gopt(gg: T.Got) -> T1o:
  match gg:
    case T.GotVal{vv}:
      match vv:
        case T.VWhen{ww}:
          T1some{ww}
        case _:
          T1none{}
    case T.GotBad{_w}:
      T1none{}

# the datetime scan's outcome as a bare word's value
def t1.gfw(ww: T.WhenOut) -> {t1.gopt(T.word.from.when(ww)) == t1.wopt(ww) : T1o}:
  match ww:
    case T.WSome{_w}:
      {==}
    case T.WFail{_y}:
      {==}
    case T.WSkip{}:
      {==}

# nan, signed or not, is no datetime
def t1.nw.nan(aa: Bool, bb: Bool, cc: Bool) -> {t1.gopt(T.word.spec.nan(aa, bb, cc)) == T1none{} : T1o}:
  match aa:
    case True{}:
      {==}
    case False{}:
      match bb:
        case True{}:
          {==}
        case False{}:
          match cc:
            case True{}:
              {==}
            case False{}:
              {==}

# nor is inf
def t1.nw.inf(
  aa: Bool,
  bb: Bool,
  cc: Bool,
  +ss: String
) -> {t1.gopt(T.word.spec.inf(aa, bb, cc, ss)) == T1none{} : T1o}:
  match aa:
    case True{}:
      {==}
    case False{}:
      match bb:
        case True{}:
          {==}
        case False{}:
          match cc:
            case True{}:
              {==}
            case False{}:
              t1.nw.nan(T.str.eq(ss, "nan"), T.str.eq(ss, "+nan"), T.str.eq(ss, "-nan"))

# nor true or false
def t1.nw.st(hit: Bool, other: Bool, +ss: String) -> {t1.gopt(T.word.spec.t(hit, other, ss)) == T1none{} : T1o}:
  match hit:
    case True{}:
      {==}
    case False{}:
      match other:
        case True{}:
          {==}
        case False{}:
          t1.nw.inf(T.str.eq(ss, "inf"), T.str.eq(ss, "+inf"), T.str.eq(ss, "-inf"), ss)

# a special word is no datetime
def t1.nw.spec(+ss: String) -> {t1.gopt(T.word.spec(ss)) == T1none{} : T1o}:
  t1.nw.st(T.str.eq(ss, "true"), T.str.eq(ss, "false"), ss)

# an integer checked for its range is no datetime
def t1.nw.rng(
  ok: Bool,
  +sign: T.Sign,
  +digits: String
) -> {t1.gopt(T.num.fin.range(ok, sign, digits)) == T1none{} : T1o}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# nor a finished integer
def t1.nw.int(
  saw: Bool,
  +sign: T.Sign,
  +digits: String
) -> {t1.gopt(T.num.fin.int(saw, sign, digits)) == T1none{} : T1o}:
  match saw:
    case False{}:
      {==}
    case True{}:
      t1.nw.rng(T.i64.fits(sign, digits), sign, digits)

# nor a prefixed integer
def t1.nw.base(
  signed: Bool,
  +saw: Bool,
  +sign: T.Sign,
  +ds: List<&2, U32>
) -> {t1.gopt(T.num.fin.base(signed, saw, sign, ds)) == T1none{} : T1o}:
  match signed:
    case True{}:
      {==}
    case False{}:
      t1.nw.int(saw, sign, T.dec.text(ds))

# nor a float
def t1.nw.saw(
  saw: Bool,
  +vv: T.Val,
  +ev: {t1.gopt(T.GotVal{vv}) == T1none{} : T1o}
) -> {t1.gopt(T.num.fin.saw(saw, vv)) == T1none{} : T1o}:
  match saw:
    case False{}:
      {==}
    case True{}:
      ev

# nor any numeral, by the kind the scan finished in
def t1.nw.nk(
  nk: T.NK,
  +sign: T.Sign,
  +ds: List<&2, U32>,
  +saw: Bool,
  +why: String,
  +cs: List<&2, Char>
) -> {t1.gopt(T.num.fin.nk(nk, sign, ds, saw, why, cs)) == T1none{} : T1o}:
  match nk:
    case T.NBad{}:
      {==}
    case T.NLead{}:
      {==}
    case T.NSign{}:
      {==}
    case T.NZero{}:
      {==}
    case T.NDig{}:
      t1.nw.int(saw, sign, T.dec.text(ds))
    case T.NBase{}:
      t1.nw.base(T.num.signed(cs), saw, sign, ds)
    case T.NFrac{}:
      t1.nw.saw(saw, T.VFlo{sign, T.word.body(cs)}, {==})
    case T.NExp{}:
      {==}
    case T.NEDig{}:
      t1.nw.saw(saw, T.VFlo{sign, T.word.body(cs)}, {==})

# nor a numeral with a trailing underscore
def t1.nw.us(
  us: Bool,
  +nk: T.NK,
  +sign: T.Sign,
  +ds: List<&2, U32>,
  +saw: Bool,
  +why: String,
  +cs: List<&2, Char>
) -> {t1.gopt(T.num.fin.us(us, nk, sign, ds, saw, why, cs)) == T1none{} : T1o}:
  match us:
    case True{}:
      {==}
    case False{}:
      t1.nw.nk(nk, sign, ds, saw, why, cs)

# a numeral is no datetime
def t1.nw.fin(st: T.Num, +cs: List<&2, Char>) -> {t1.gopt(T.num.fin(st, cs)) == T1none{} : T1o}:
  match st:
    case T.Num{+nk, +sign, _base, +ds, +us, +saw, +why}:
      t1.nw.us(us, nk, sign, ds, saw, why, cs)

# so a numeral token is no datetime
def t1.nw.num(+cs: List<&2, Char>) -> {t1.gopt(T.word.num(cs)) == T1none{} : T1o}:
  t1.nw.fin(T.num.go(cs, T.num.start()), cs)

# the route to the datetime scan or the numeral scan
def t1.rn.date(
  bb: Bool,
  +cs: List<&2, Char>,
  hn: {t1.wopt(T.when.read(cs)) == T1none{} : T1o}
) -> {t1.gopt(T.word.route.date(bb, cs)) == T1none{} : T1o}:
  match bb:
    case True{}:
      Equal.trans(T1o, t1.gopt(T.word.from.when(T.when.read(cs))), t1.wopt(T.when.read(cs)), T1none{},
        t1.gfw(T.when.read(cs)), hn)
    case False{}:
      t1.nw.num(cs)

# a special word's value, or the route
def t1.rn.route(
  gg: T.Got,
  +dd: Bool,
  +cs: List<&2, Char>,
  hn: {t1.wopt(T.when.read(cs)) == T1none{} : T1o},
  hg: {t1.gopt(gg) == T1none{} : T1o}
) -> {t1.gopt(T.word.route(gg, dd, cs)) == T1none{} : T1o}:
  match gg:
    case T.GotVal{_v}:
      hg
    case T.GotBad{_w}:
      t1.rn.date(T.word.as_date(dd, T.word.ee(cs)), cs, hn)

# a word the datetime scan refuses is no datetime, whatever route it takes
def t1.rn(
  sp: Bool,
  +cs: List<&2, Char>,
  hn: {t1.wopt(T.when.read(cs)) == T1none{} : T1o}
) -> {t1.gopt(T.word.val.pick(sp, cs)) == T1none{} : T1o}:
  match sp:
    case True{}:
      t1.rn.route(T.word.spec(String.from_list(cs)), T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs, hn,
        t1.nw.spec(String.from_list(cs)))
    case False{}:
      t1.rn.route(T.GotBad{""}, T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs, hn, {==})

# a digit is no special word's first character
def t1.dsp(cc: Char, hd: {Char.is_digit(cc) == True{} : Bool}) -> {T.word.special(cc) == False{} : Bool}:
  dg.elim(zz => {T.word.special(zz) == False{} : Bool}, cc, hd,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a digit is no colon
def t1.dnc(cc: Char, hd: {Char.is_digit(cc) == True{} : Bool}) -> {Char.is_eq(cc, ':') == False{} : Bool}:
  dg.elim(zz => {Char.is_eq(zz, ':') == False{} : Bool}, cc, hd,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a digit is no dash
def t1.dnd(cc: Char, hd: {Char.is_digit(cc) == True{} : Bool}) -> {Char.is_eq(cc, '-') == False{} : Bool}:
  dg.elim(zz => {Char.is_eq(zz, '-') == False{} : Bool}, cc, hd,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a digit is no exponent mark
def t1.dee(cc: Char, hd: {Char.is_digit(cc) == True{} : Bool}) -> {T.word.ee.hit(cc) == False{} : Bool}:
  dg.elim(zz => {T.word.ee.hit(zz) == False{} : Bool}, cc, hd,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# either flag, once the second is set
def t1.wort(aa: Bool) -> {T.word.or(aa, True{}) == True{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      {==}

# the route's flags: the word starts with no special's first character, and
# holds a colon, or a dash after its first character
def t1.flag(+cs: List<&2, Char>) -> Bool:
  Bool.and(Bool.not(T.word.lead(cs)), T.word.or(T.word.colon(cs), T.word.dash(cs, True{})))

# full-date after its first dash, with the dash's test given
def t1.FDd(hz: Bool, vv: List<&2, Char>) -> Laws.ARest:
  Laws.abnf.date_mday(Laws.abnf.char_r(Laws.abnf.date_month(Laws.abnf.keep(hz, vv)), 45))

# the date's second dash
def t1.p8(
  hz: Bool,
  +vv: List<&2, Char>,
  hh: {t1.G(t1.FDd(hz, vv), Laws.ANone{}) == True{} : Bool}
) -> {T.word.or(hz, T.word.dash(vv, False{})) == True{} : Bool}:
  match hz:
    case True{}:
      {==}
    case False{}:
      Eq.bit.absurd(&2, {T.word.or(False{}, T.word.dash(vv, False{})) == True{} : Bool}, hh)

# the character after the year
def t1.p7(
  uu: List<&2, Char>,
  hh: {t1.G(t1.FDc(Laws.ALeft{uu}), Laws.ANone{}) == True{} : Bool}
) -> {T.word.dash(uu, False{}) == True{} : Bool}:
  match uu:
    case []:
      Eq.bit.absurd(&2, {T.word.dash([], False{}) == True{} : Bool}, hh)
    case zh <> +vv:
      match zh:
        case Chr{+zz}:
          t1.p8(Char.is_eq(Chr{zz}, '-'), vv, hh)

# the year's fourth digit, which is no dash
def t1.p6(
  dy: Bool,
  +yy: U32,
  +uu: List<&2, Char>,
  hy: {Char.is_digit(Chr{yy}) == dy : Bool},
  hh: {t1.G(t1.FDc(Laws.abnf.keep(dy, uu)), Laws.ANone{}) == True{} : Bool}
) -> {T.word.or(Char.is_eq(Chr{yy}, '-'), T.word.dash(uu, False{})) == True{} : Bool}:
  match dy:
    case False{}:
      Eq.bit.absurd(&2, {T.word.or(Char.is_eq(Chr{yy}, '-'), T.word.dash(uu, False{})) == True{} : Bool}, hh)
    case True{}:
      %Equal.sym(Bool, Char.is_eq(Chr{yy}, '-'), False{}, t1.dnd(Chr{yy}, hy)) : {T.word.or(_, T.word.dash(uu, False{}))
        == True{} : Bool}
      t1.p7(uu, hh)

# the character after the year's third digit
def t1.p5(
  tt: List<&2, Char>,
  hh: {t1.G(t1.FDb(Laws.ALeft{tt}), Laws.ANone{}) == True{} : Bool}
) -> {T.word.dash(tt, False{}) == True{} : Bool}:
  match tt:
    case []:
      Eq.bit.absurd(&2, {T.word.dash([], False{}) == True{} : Bool}, hh)
    case yh <> +uu:
      match yh:
        case Chr{+yy}:
          t1.p6(Char.is_digit(Chr{yy}), yy, uu, {==}, hh)

# the third character: a colon, or a digit and then the year's dash
def t1.p4(
  col: Bool,
  dig: Bool,
  +xx: U32,
  +tt: List<&2, Char>,
  hd: {Char.is_digit(Chr{xx}) == dig : Bool},
  hh: {t1.G(t1.FDb(Laws.abnf.keep(dig, tt)), t1.PTb(Laws.abnf.keep(col, tt))) == True{} : Bool}
) -> {T.word.or(T.word.or(col, T.word.colon(tt)), T.word.or(Char.is_eq(Chr{xx}, '-'), T.word.dash(tt, False{})))
  == True{} : Bool}:
  match col:
    case True{}:
      {==}
    case False{}:
      match dig:
        case False{}:
          Eq.bit.absurd(&2, {T.word.or(T.word.or(False{}, T.word.colon(tt)), T.word.or(Char.is_eq(Chr{xx}, '-'),
            T.word.dash(tt, False{}))) == True{} : Bool}, hh)
        case True{}:
          %Equal.sym(Bool, Char.is_eq(Chr{xx}, '-'), False{}, t1.dnd(Chr{xx}, hd)) : {T.word.or(T.word.colon(tt),
            T.word.or(_, T.word.dash(tt, False{}))) == True{} : Bool}
          %Equal.sym(Bool, T.word.dash(tt, False{}), True{}, t1.p5(tt, hh)) : {T.word.or(T.word.colon(tt), _)
            == True{} : Bool}
          t1.wort(T.word.colon(tt))

# after the first two digits
def t1.p3(
  rr: List<&2, Char>,
  hh: {t1.G(t1.FDa(Laws.ALeft{rr}), t1.PTa(Laws.ALeft{rr})) == True{} : Bool}
) -> {T.word.or(T.word.colon(rr), T.word.dash(rr, False{})) == True{} : Bool}:
  match rr:
    case []:
      Eq.bit.absurd(&2, {T.word.or(T.word.colon([]), T.word.dash([], False{})) == True{} : Bool}, hh)
    case xh <> +tt:
      match xh:
        case Chr{+xx}:
          t1.p4(Char.is_eq(Chr{xx}, ':'), Char.is_digit(Chr{xx}), xx, tt, {==}, hh)

# the first two characters are digits: no special's, no colon and no dash
def t1.p2(
  +c1: Char,
  +c2: Char,
  +rr: List<&2, Char>,
  +e1: {Char.is_digit(c1) == True{} : Bool},
  +e2: {Char.is_digit(c2) == True{} : Bool},
  hh: {t1.G(t1.FDa(Laws.ALeft{rr}), t1.PTa(Laws.ALeft{rr})) == True{} : Bool}
) -> {t1.flag(c1 <> c2 <> rr) == True{} : Bool}:
  %Equal.sym(Bool, T.word.special(c1), False{}, t1.dsp(c1, e1)) : {Bool.and(Bool.not(_), T.word.or(T.word.or(
    Char.is_eq(c1, ':'), T.word.or(Char.is_eq(c2, ':'), T.word.colon(rr))), T.word.or(Char.is_eq(c2, '-'),
    T.word.dash(rr, False{})))) == True{} : Bool}
  %Equal.sym(Bool, Char.is_eq(c1, ':'), False{}, t1.dnc(c1, e1)) : {Bool.and(True{}, T.word.or(T.word.or(
    _, T.word.or(Char.is_eq(c2, ':'), T.word.colon(rr))), T.word.or(Char.is_eq(c2, '-'),
    T.word.dash(rr, False{})))) == True{} : Bool}
  %Equal.sym(Bool, Char.is_eq(c2, ':'), False{}, t1.dnc(c2, e2)) : {T.word.or(T.word.or(_, T.word.colon(rr)),
    T.word.or(Char.is_eq(c2, '-'), T.word.dash(rr, False{}))) == True{} : Bool}
  %Equal.sym(Bool, Char.is_eq(c2, '-'), False{}, t1.dnd(c2, e2)) : {T.word.or(T.word.colon(rr),
    T.word.or(_, T.word.dash(rr, False{}))) == True{} : Bool}
  t1.p3(rr, hh)

# a word that matches the grammar is routed to the datetime scan by its first
# characters
def t1.pfx(+cs: List<&2, Char>, hdt: {Laws.abnf.date_time(cs) == True{} : Bool}) -> {t1.flag(cs) == True{} : Bool}:
  t1.tk2(xs => _dd => r => ({t1.G(t1.FDa(r), t1.PTa(r)) == True{} : Bool} -> {t1.flag(xs) == True{} : Bool}), cs,
    +xs => hh => Eq.bit.absurd(&2, {t1.flag(xs) == True{} : Bool}, hh),
    +c1 => +c2 => +rr => +e1 => +e2 => hh => t1.p2(c1, c2, rr, e1, e2, hh))(hdt)

# No e or E. Every character a date-time rule takes is a digit or one of
# - : . + T t Z z and the space, none of them an exponent mark, so a word
# with one is left with one by every rule, and no rule matches it whole.

# what a rule left of a word still holds an exponent mark, or it matched
# nothing
def t1.ek(rr: Laws.ARest) -> Bool:
  match rr:
    case Laws.ALeft{cs}:
      T.word.ee(cs)
    case Laws.ANone{}:
      True{}

# a character that is no exponent mark leaves the mark in the rest
def t1.e.step(
  +cc: Char,
  +tt: List<&2, Char>,
  hc: {T.word.ee.hit(cc) == False{} : Bool},
  hh: {T.word.ee(cc <> tt) == True{} : Bool}
) -> {T.word.ee(tt) == True{} : Bool}:
  Equal.trans(Bool, T.word.ee(tt), T.word.or(T.word.ee.hit(cc), T.word.ee(tt)), True{},
    Equal.cong(Bool, Bool, bb => T.word.or(bb, T.word.ee(tt)), False{}, T.word.ee.hit(cc),
      Equal.sym(Bool, T.word.ee.hit(cc), False{}, hc)), hh)

# a DIGIT taken
def t1.e.dr0(
  dg: Bool,
  +xx: U32,
  +tt: List<&2, Char>,
  hd: {Char.is_digit(Chr{xx}) == dg : Bool},
  hh: {T.word.ee(Chr{xx} <> tt) == True{} : Bool}
) -> {t1.ek(Laws.abnf.keep(dg, tt)) == True{} : Bool}:
  match dg:
    case False{}:
      {==}
    case True{}:
      t1.e.step(Chr{xx}, tt, t1.dee(Chr{xx}, hd), hh)

# DIGIT keeps the mark
def t1.e.dr(rr: Laws.ARest, hh: {t1.ek(rr) == True{} : Bool}) -> {t1.ek(Laws.abnf.digit_r(rr)) == True{} : Bool}:
  match rr:
    case Laws.ANone{}:
      {==}
    case Laws.ALeft{cs}:
      match cs:
        case []:
          {==}
        case xh <> +tt:
          match xh:
            case Chr{+xx}:
              t1.e.dr0(Char.is_digit(Chr{xx}), xx, tt, {==}, hh)

# two DIGITs keep it
def t1.e.d2(
  +rr: Laws.ARest,
  hh: {t1.ek(rr) == True{} : Bool}
) -> {t1.ek(Laws.abnf.digit_r(Laws.abnf.digit_r(rr))) == True{} : Bool}:
  t1.e.dr(Laws.abnf.digit_r(rr), t1.e.dr(rr, hh))

# a character with code point n taken, n no exponent mark
def t1.e.cr0(
  bb: Bool,
  +xx: U32,
  +nn: U32,
  +tt: List<&2, Char>,
  hb: {U32.is_eq(xx, nn) == bb : Bool},
  hn: {T.word.ee.hit(Chr{nn}) == False{} : Bool},
  hh: {T.word.ee(Chr{xx} <> tt) == True{} : Bool}
) -> {t1.ek(Laws.abnf.keep(bb, tt)) == True{} : Bool}:
  match bb:
    case False{}:
      {==}
    case True{}:
      t1.e.step(Chr{xx}, tt, Equal.trans(Bool, T.word.ee.hit(Chr{xx}), T.word.ee.hit(Chr{nn}), False{},
        Equal.cong(Char, Bool, cc => T.word.ee.hit(cc), Chr{xx}, Chr{nn}, Eq.u32_eq(xx, nn, hb)), hn), hh)

# such a character keeps the mark
def t1.e.cr(
  rr: Laws.ARest,
  +nn: U32,
  hn: {T.word.ee.hit(Chr{nn}) == False{} : Bool},
  hh: {t1.ek(rr) == True{} : Bool}
) -> {t1.ek(Laws.abnf.char_r(rr, nn)) == True{} : Bool}:
  match rr:
    case Laws.ANone{}:
      {==}
    case Laws.ALeft{cs}:
      match cs:
        case []:
          {==}
        case xh <> +tt:
          match xh:
            case Chr{+xx}:
              t1.e.cr0(U32.is_eq(xx, nn), xx, nn, tt, {==}, hn, hh)

# a letter in either case taken
def t1.e.lr0(
  bu: Bool,
  bl: Bool,
  +xx: U32,
  +up: U32,
  +low: U32,
  +tt: List<&2, Char>,
  hbu: {U32.is_eq(xx, up) == bu : Bool},
  hbl: {U32.is_eq(xx, low) == bl : Bool},
  hu: {T.word.ee.hit(Chr{up}) == False{} : Bool},
  hl: {T.word.ee.hit(Chr{low}) == False{} : Bool},
  +hh: {T.word.ee(Chr{xx} <> tt) == True{} : Bool}
) -> {t1.ek(Laws.abnf.keep(Bool.or(bu, bl), tt)) == True{} : Bool}:
  match bu:
    case True{}:
      t1.e.cr0(True{}, xx, up, tt, hbu, hu, hh)
    case False{}:
      t1.e.cr0(bl, xx, low, tt, hbl, hl, hh)

# such a letter keeps the mark
def t1.e.lr(
  rr: Laws.ARest,
  +up: U32,
  +low: U32,
  hu: {T.word.ee.hit(Chr{up}) == False{} : Bool},
  hl: {T.word.ee.hit(Chr{low}) == False{} : Bool},
  hh: {t1.ek(rr) == True{} : Bool}
) -> {t1.ek(Laws.abnf.letter_r(rr, up, low)) == True{} : Bool}:
  match rr:
    case Laws.ANone{}:
      {==}
    case Laws.ALeft{cs}:
      match cs:
        case []:
          {==}
        case xh <> +tt:
          match xh:
            case Chr{+xx}:
              t1.e.lr0(U32.is_eq(xx, up), U32.is_eq(xx, low), xx, up, low, tt, {==}, {==}, hu, hl, hh)

# either of two alternatives keeps it
def t1.e.or(
  aa: Laws.ARest,
  +bb: Laws.ARest,
  ha: {t1.ek(aa) == True{} : Bool},
  hb: {t1.ek(bb) == True{} : Bool}
) -> {t1.ek(Laws.abnf.or_r(aa, bb)) == True{} : Bool}:
  match aa:
    case Laws.ALeft{_c}:
      ha
    case Laws.ANone{}:
      hb

# one of the leading digits dropped
def t1.e.dd0(
  dg: Bool,
  +yy: U32,
  +uu: List<&2, Char>,
  hd: {Char.is_digit(Chr{yy}) == dg : Bool},
  +hh: {T.word.ee(Chr{yy} <> uu) == True{} : Bool},
  ih: {T.word.ee(uu) == True{} : Bool} -> {T.word.ee(Laws.abnf.drop_digits(uu)) == True{} : Bool}
) -> {T.word.ee(Laws.abnf.drop_digits.pick(dg, Chr{yy}, uu, Laws.abnf.drop_digits(uu))) == True{} : Bool}:
  match dg:
    case True{}:
      ih(t1.e.step(Chr{yy}, uu, t1.dee(Chr{yy}, hd), hh))
    case False{}:
      hh

# dropping the leading digits keeps it
def t1.e.dd(
  tt: List<&2, Char>,
  +hh: {T.word.ee(tt) == True{} : Bool}
) -> {T.word.ee(Laws.abnf.drop_digits(tt)) == True{} : Bool}:
  match tt:
    case []:
      hh
    case yh <> +uu:
      match yh:
        case Chr{+yy}:
          t1.e.dd0(Char.is_digit(Chr{yy}), yy, uu, {==}, hh, hu => t1.e.dd(uu, hu))

# a fraction's first digit
def t1.e.d10(
  dg: Bool,
  +xx: U32,
  +tt: List<&2, Char>,
  hd: {Char.is_digit(Chr{xx}) == dg : Bool},
  hh: {T.word.ee(Chr{xx} <> tt) == True{} : Bool}
) -> {t1.ek(Laws.abnf.keep(dg, Laws.abnf.drop_digits(tt))) == True{} : Bool}:
  match dg:
    case False{}:
      {==}
    case True{}:
      t1.e.dd(tt, t1.e.step(Chr{xx}, tt, t1.dee(Chr{xx}, hd), hh))

# 1*DIGIT keeps it
def t1.e.d1(rr: Laws.ARest, hh: {t1.ek(rr) == True{} : Bool}) -> {t1.ek(Laws.abnf.digits1_r(rr)) == True{} : Bool}:
  match rr:
    case Laws.ANone{}:
      {==}
    case Laws.ALeft{cs}:
      match cs:
        case []:
          {==}
        case xh <> +tt:
          match xh:
            case Chr{+xx}:
              t1.e.d10(Char.is_digit(Chr{xx}), xx, tt, {==}, hh)

# a dot, or no fraction
def t1.e.os0(
  dot: Bool,
  +xx: U32,
  +tt: List<&2, Char>,
  +hh: {T.word.ee(Chr{xx} <> tt) == True{} : Bool}
) -> {t1.ek(Laws.abnf.opt_secfrac.pick(dot, Chr{xx} <> tt)) == True{} : Bool}:
  match dot:
    case False{}:
      hh
    case True{}:
      t1.e.d1(Laws.abnf.char_r(Laws.ALeft{Chr{xx} <> tt}, 46), t1.e.cr(Laws.ALeft{Chr{xx} <> tt}, 46, {==}, hh))

# [ time-secfrac ] keeps it
def t1.e.os(rr: Laws.ARest, hh: {t1.ek(rr) == True{} : Bool}) -> {t1.ek(Laws.abnf.opt_secfrac(rr)) == True{} : Bool}:
  match rr:
    case Laws.ANone{}:
      {==}
    case Laws.ALeft{cs}:
      match cs:
        case []:
          hh
        case xh <> +tt:
          match xh:
            case Chr{+xx}:
              t1.e.os0(Laws.abnf.cp(Chr{xx}, 46), xx, tt, hh)

# full-date keeps it
def t1.e.fd(+rr: Laws.ARest, hh: {t1.ek(rr) == True{} : Bool}) -> {t1.ek(Laws.abnf.full_date(rr)) == True{} : Bool}:
  t1.e.d2(Laws.abnf.char_r(Laws.abnf.date_month(Laws.abnf.char_r(Laws.abnf.date_fullyear(rr), 45)), 45),
    t1.e.cr(Laws.abnf.date_month(Laws.abnf.char_r(Laws.abnf.date_fullyear(rr), 45)), 45, {==},
    t1.e.d2(Laws.abnf.char_r(Laws.abnf.date_fullyear(rr), 45), t1.e.cr(Laws.abnf.date_fullyear(rr), 45, {==},
    t1.e.d2(Laws.abnf.digit_r(Laws.abnf.digit_r(rr)), t1.e.d2(rr, hh))))))

# partial-time keeps it
def t1.e.pt(+rr: Laws.ARest, hh: {t1.ek(rr) == True{} : Bool}) -> {t1.ek(Laws.abnf.partial_time(rr)) == True{} : Bool}:
  t1.e.os(Laws.abnf.time_second(Laws.abnf.char_r(Laws.abnf.time_minute(Laws.abnf.char_r(Laws.abnf.time_hour(rr), 58)),
    58)),
    t1.e.d2(Laws.abnf.char_r(Laws.abnf.time_minute(Laws.abnf.char_r(Laws.abnf.time_hour(rr), 58)), 58),
    t1.e.cr(Laws.abnf.time_minute(Laws.abnf.char_r(Laws.abnf.time_hour(rr), 58)), 58, {==},
    t1.e.d2(Laws.abnf.char_r(Laws.abnf.time_hour(rr), 58), t1.e.cr(Laws.abnf.time_hour(rr), 58, {==},
    t1.e.d2(rr, hh))))))

# time-delim keeps it
def t1.e.td(+rr: Laws.ARest, +hh: {t1.ek(rr) == True{} : Bool}) -> {t1.ek(Laws.abnf.time_delim(rr)) == True{} : Bool}:
  t1.e.or(Laws.abnf.letter_r(rr, 84, 116), Laws.abnf.char_r(rr, 32), t1.e.lr(rr, 84, 116, {==}, {==}, hh),
    t1.e.cr(rr, 32, {==}, hh))

# time-offset keeps it
def t1.e.to(+rr: Laws.ARest, +hh: {t1.ek(rr) == True{} : Bool}) -> {t1.ek(Laws.abnf.time_offset(rr)) == True{} : Bool}:
  t1.e.or(Laws.abnf.letter_r(rr, 90, 122), Laws.abnf.time_numoffset(rr), t1.e.lr(rr, 90, 122, {==}, {==}, hh),
    t1.e.d2(Laws.abnf.char_r(Laws.abnf.time_hour(Laws.abnf.or_r(Laws.abnf.char_r(rr, 43), Laws.abnf.char_r(rr, 45))),
      58),
      t1.e.cr(Laws.abnf.time_hour(Laws.abnf.or_r(Laws.abnf.char_r(rr, 43), Laws.abnf.char_r(rr, 45))), 58, {==},
      t1.e.d2(Laws.abnf.or_r(Laws.abnf.char_r(rr, 43), Laws.abnf.char_r(rr, 45)), t1.e.or(Laws.abnf.char_r(rr, 43),
      Laws.abnf.char_r(rr, 45), t1.e.cr(rr, 43, {==}, hh), t1.e.cr(rr, 45, {==}, hh))))))

# a rule's match that leaves an exponent mark is no whole-word match
def t1.e.all(rr: Laws.ARest, hh: {t1.ek(rr) == True{} : Bool}) -> {Laws.abnf.all_r(rr) == False{} : Bool}:
  match rr:
    case Laws.ANone{}:
      {==}
    case Laws.ALeft{cs}:
      match cs:
        case []:
          Eq.bit.absurd(&2, {Laws.abnf.all_r(Laws.ALeft{[]}) == False{} : Bool}, hh)
        case _h <> _t:
          {==}

# four alternatives that each answered False
def t1.or4f(
  +aa: Bool,
  +bb: Bool,
  +cc: Bool,
  +dd: Bool,
  ha: {aa == False{} : Bool},
  hb: {bb == False{} : Bool},
  hc: {cc == False{} : Bool},
  hd: {dd == False{} : Bool}
) -> {Bool.or(aa, Bool.or(bb, Bool.or(cc, dd))) == False{} : Bool}:
  %Equal.sym(Bool, aa, False{}, ha) : {Bool.or(_, Bool.or(bb, Bool.or(cc, dd))) == False{} : Bool}
  %Equal.sym(Bool, bb, False{}, hb) : {Bool.or(_, Bool.or(cc, dd)) == False{} : Bool}
  %Equal.sym(Bool, cc, False{}, hc) : {Bool.or(_, dd) == False{} : Bool}
  hd

# a word with an exponent mark matches no date-time rule
def t1.e.dt(+cs: List<&2, Char>, +hh: {T.word.ee(cs) == True{} : Bool}) -> {Laws.abnf.date_time(cs) == False{} : Bool}:
  t1.or4f(Laws.abnf.all_r(Laws.abnf.offset_date_time(Laws.ALeft{cs})),
    Laws.abnf.all_r(Laws.abnf.local_date_time(Laws.ALeft{cs})), Laws.abnf.all_r(Laws.abnf.local_date(Laws.ALeft{cs})),
    Laws.abnf.all_r(Laws.abnf.local_time(Laws.ALeft{cs})),
    t1.e.all(Laws.abnf.offset_date_time(Laws.ALeft{cs}), t1.e.to(Laws.abnf.partial_time(Laws.abnf.time_delim(
      Laws.abnf.full_date(Laws.ALeft{cs}))), t1.e.pt(Laws.abnf.time_delim(Laws.abnf.full_date(Laws.ALeft{cs})),
      t1.e.td(Laws.abnf.full_date(Laws.ALeft{cs}), t1.e.fd(Laws.ALeft{cs}, hh))))),
    t1.e.all(Laws.abnf.local_date_time(Laws.ALeft{cs}), t1.e.pt(Laws.abnf.time_delim(Laws.abnf.full_date(
      Laws.ALeft{cs})), t1.e.td(Laws.abnf.full_date(Laws.ALeft{cs}), t1.e.fd(Laws.ALeft{cs}, hh)))),
    t1.e.all(Laws.abnf.local_date(Laws.ALeft{cs}), t1.e.fd(Laws.ALeft{cs}, hh)),
    t1.e.all(Laws.abnf.local_time(Laws.ALeft{cs}), t1.e.pt(Laws.ALeft{cs}, hh)))

# so a word that matches holds no exponent mark
def t1.noe.go(
  ee: Bool,
  +cs: List<&2, Char>,
  he: {T.word.ee(cs) == ee : Bool},
  hdt: {Laws.abnf.date_time(cs) == True{} : Bool}
) -> {T.word.ee(cs) == False{} : Bool}:
  match ee:
    case False{}:
      he
    case True{}:
      Eq.bit.absurd(&2, {T.word.ee(cs) == False{} : Bool}, Equal.trans(Bool, False{}, Laws.abnf.date_time(cs), True{},
        Equal.sym(Bool, Laws.abnf.date_time(cs), False{}, t1.e.dt(cs, he)), hdt))

# a word that matches is routed to the datetime scan
def t1.rs(
  +cs: List<&2, Char>,
  +hdt: {Laws.abnf.date_time(cs) == True{} : Bool}
) -> {T.word.val(cs) == T.word.from.when(T.when.read(cs)) : T.Got}:
  %Equal.sym(Bool, T.word.lead(cs), False{}, Eq.not.true(T.word.lead(cs), Eq.and.left(Bool.not(T.word.lead(cs)),
    T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), t1.pfx(cs, hdt)))) : {T.word.val.pick(_, cs)
    == T.word.from.when(T.when.read(cs)) : T.Got}
  %Equal.sym(Bool, T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), True{}, Eq.and.right(Bool.not(T.word.lead(cs)),
    T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), t1.pfx(cs, hdt))) : {T.word.route.date(T.word.as_date(_,
    T.word.ee(cs)), cs) == T.word.from.when(T.when.read(cs)) : T.Got}
  %Equal.sym(Bool, T.word.ee(cs), False{}, t1.noe.go(T.word.ee(cs), cs, {==}, hdt)) : {T.word.route.date(
    T.word.as_date(True{}, _), cs) == T.word.from.when(T.when.read(cs)) : T.Got}
  {==}

# a bare word's value as a datetime is what the grammar says
def t1.fin(
  bb: Bool,
  +cs: List<&2, Char>,
  +hb: {Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)) == bb : Bool}
) -> {t1.gopt(T.word.val(cs)) == t1.spec(cs) : T1o}:
  match bb:
    case False{}:
      Equal.trans(T1o, t1.gopt(T.word.val(cs)), T1none{}, t1.spec(cs),
        t1.rn(T.word.lead(cs), cs, Equal.trans(T1o, t1.wopt(T.when.read(cs)), t1.spec(cs), T1none{}, t1.read(cs),
          Equal.cong(Bool, T1o, xx => t1.pk(xx, Laws.g.dt.when(cs)), Bool.and(Laws.abnf.date_time(cs),
          Laws.prose.date_time_in_range(cs)), False{}, hb))),
        Equal.sym(T1o, t1.spec(cs), T1none{}, Equal.cong(Bool, T1o, xx => t1.pk(xx, Laws.g.dt.when(cs)),
          Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)), False{}, hb)))
    case True{}:
      Equal.trans(T1o, t1.gopt(T.word.val(cs)), t1.gopt(T.word.from.when(T.when.read(cs))), t1.spec(cs),
        Equal.cong(T.Got, T1o, gg => t1.gopt(gg), T.word.val(cs), T.word.from.when(T.when.read(cs)),
          t1.rs(cs, Eq.and.left(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs), hb))),
        Equal.trans(T1o, t1.gopt(T.word.from.when(T.when.read(cs))), t1.wopt(T.when.read(cs)), t1.spec(cs),
          t1.gfw(T.when.read(cs)), t1.read(cs)))

# the classifier: a bare word reads as a datetime exactly as the grammar says
def t1.core(+cs: List<&2, Char>) -> {t1.gopt(T.word.val(cs)) == t1.spec(cs) : T1o}:
  t1.fin(Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)), cs, {==})

# The laws. The classifier compares the word's outcome with a datetime; both
# sides are options, the scan's (t1.gopt) and the grammar's (t1.spec).

# an option compared with a datetime
def t1.oeq(oo: T1o, ww: T.When) -> Bool:
  match oo:
    case T1some{vv}:
      Laws.when.eq(ww, vv)
    case T1none{}:
      False{}

# the law's comparison is the option's
def t1.go(gg: T.Got, +ww: T.When) -> {Laws.t1.got_when(gg, ww) == t1.oeq(t1.gopt(gg), ww) : Bool}:
  match gg:
    case T.GotVal{vv}:
      match vv:
        case T.VStr{_a}:
          {==}
        case T.VSpan{_a, _b}:
          {==}
        case T.VInt{_a, _b}:
          {==}
        case T.VFlo{_a, _b}:
          {==}
        case T.VBool{_a}:
          {==}
        case T.VWhen{_a}:
          {==}
        case T.VArr{_a}:
          {==}
        case T.VInl{_a}:
          {==}
        case T.VHead{_a, _b}:
          {==}
        case T.VAot{_a, _b}:
          {==}
        case T.VAots{_a, _b}:
          {==}
        case T.VPair{_a, _b}:
          {==}
    case T.GotBad{_w}:
      {==}

# the grammar's option compared with a datetime
def t1.op(
  bb: Bool,
  +vv: T.When,
  +ww: T.When
) -> {t1.oeq(t1.pk(bb, vv), ww) == Bool.and(bb, Laws.when.eq(ww, vv)) : Bool}:
  match bb:
    case True{}:
      {==}
    case False{}:
      {==}

# the scan and the grammar agree on every word (t1.core)
def Laws.date_time_word(cs, w):
  Equal.trans(Bool, Laws.t1.got_when(T.word.val(cs), w), t1.oeq(t1.gopt(T.word.val(cs)), w),
    Bool.and(Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)), Laws.when.eq(w, Laws.g.dt.when(cs))),
    t1.go(T.word.val(cs), w),
    Equal.trans(Bool, t1.oeq(t1.gopt(T.word.val(cs)), w), t1.oeq(t1.spec(cs), w),
      Bool.and(Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)), Laws.when.eq(w,
      Laws.g.dt.when(cs))),
      Equal.cong(T1o, Bool, oo => t1.oeq(oo, w), t1.gopt(T.word.val(cs)), t1.spec(cs), t1.core(cs)),
      t1.op(Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)), Laws.g.dt.when(cs), w)))

# none is not some datetime, as a type
def t1.dis(oo: T1o) -> Type:
  match oo:
    case T1some{_w}:
      Empty
    case T1none{}:
      Unit

# none is not some datetime
def t1.clash(-ww: T.When, hh: {T1none{} == T1some{ww} : T1o}) -> Empty:
  %hh : t1.dis(_)
  Unit{}

# the datetime an option holds, or the one given
def t1.ow(oo: T1o, dflt: T.When) -> T.When:
  match oo:
    case T1some{ww}:
      ww
    case T1none{}:
      dflt

# a scan observed as a datetime gave that datetime
def t1.wsome(
  ww: T.WhenOut,
  +vv: T.When,
  hh: {t1.wopt(ww) == T1some{vv} : T1o}
) -> {T.word.from.when(ww) == T.GotVal{T.VWhen{vv}} : T.Got}:
  match ww:
    case T.WSome{w}:
      Equal.cong(T1o, T.Got, oo => T.GotVal{T.VWhen{t1.ow(oo, vv)}}, T1some{w}, T1some{vv}, hh)
    case T.WFail{yy}:
      Eq.bit.gone(&2, {T.word.from.when(T.WFail{yy}) == T.GotVal{T.VWhen{vv}} : T.Got}, t1.clash(vv, hh))
    case T.WSkip{}:
      Eq.bit.gone(&2, {T.word.from.when(T.WSkip{}) == T.GotVal{T.VWhen{vv}} : T.Got}, t1.clash(vv, hh))

# a word that matches reads as what it denotes (t1.rs, t1.read)
def Laws.date_time_word_read(cs, h):
  Equal.trans(T.Got, T.word.val(cs), T.word.from.when(T.when.read(cs)), T.GotVal{T.VWhen{Laws.g.dt.when(cs)}},
    t1.rs(cs, Eq.and.left(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs), h)),
    t1.wsome(T.when.read(cs), Laws.g.dt.when(cs), Equal.trans(T1o, t1.wopt(T.when.read(cs)), t1.spec(cs),
      T1some{Laws.g.dt.when(cs)}, t1.read(cs), Equal.cong(Bool, T1o, xx => t1.pk(xx, Laws.g.dt.when(cs)),
      Bool.and(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs)), True{}, h))))

# render's text reads back as the datetime (when_word), so by the classifier
# it matches and denotes it
def Laws.date_time_render(w, h):
  Equal.trans(Bool, Bool.and(Laws.g.ok.val(Laws.GvDateTime{String.to_list(T.render.atom(T.VWhen{w}))}, Laws.RVal{}),
    Laws.g.val(Laws.GvDateTime{String.to_list(T.render.atom(T.VWhen{w}))}, T.VWhen{w})),
    Laws.t1.got_when(T.word.val(String.to_list(T.render.atom(T.VWhen{w}))), w), True{},
    Equal.sym(Bool, Laws.t1.got_when(T.word.val(String.to_list(T.render.atom(T.VWhen{w}))), w),
      Bool.and(Laws.g.ok.val(Laws.GvDateTime{String.to_list(T.render.atom(T.VWhen{w}))}, Laws.RVal{}),
      Laws.g.val(Laws.GvDateTime{String.to_list(T.render.atom(T.VWhen{w}))}, T.VWhen{w})),
      Laws.date_time_word(String.to_list(T.render.atom(T.VWhen{w})), w)),
    Equal.trans(Bool, Laws.t1.got_when(T.word.val(String.to_list(T.render.atom(T.VWhen{w}))), w),
      Laws.t1.got_when(T.GotVal{T.VWhen{w}}, w), True{},
      Equal.cong(T.Got, Bool, gg => Laws.t1.got_when(gg, w), T.word.val(String.to_list(T.render.atom(T.VWhen{w}))),
        T.GotVal{T.VWhen{w}}, Laws.when_word(w, h)),
      when.self(w)))

# WP-R: SIPR, the scan induction run backward, for TOML-TEXT-1's refusal
# direction (REVIEW-G5 (a)). sip.read carries an invariant of the state
# forward; sipr carries a motive of the mode and the text still to read,
# from the end of the text back to its start: from every mode, a text the
# text predicate allows and doc.read reads with no error has the motive,
# when each step's obligation turns the motive at the mode after a character
# into the motive before it, and the end's gives it for the empty text. The
# obligations mirror sip.read's split of doc.read's step, with its fast step
# folded into one: a scanning state with no held character and past the
# first takes the fast step, which sr.ff shows is the full step
# (read.fast.old) for every lex state and character, so the instance meets
# one obligation there, sr.OFull, and dispatches on the lex state itself; a
# held character (sr.OHeld), the first character (sr.OLead), the character
# after a carriage return (sr.OCr), an opening quote's (sr.OOpen), a span's
# (sr.OEat) and the end of the text (sr.ONil) are the others. A scanning
# state's step gives the mode sr.K names: a quote may open a string, and a
# carriage return waits for a line feed. Each obligation also gets the
# fact that the text after the character reads with no error, which is what
# closes every failing arm. As in sip.read, the motive, the predicates and
# the obligations are template parameters whose names start with `_`.

# after a carriage return, or not
def sr.K.cr(cr: Bool, st: T.St) -> T.Mode:
  match cr:
    case True{}:
      T.MCr{st}
    case False{}:
      T.MScan{st}

# after an apostrophe, or not
def sr.K.sq(sq: Bool, cr: Bool, st: T.St) -> T.Mode:
  match sq:
    case True{}:
      T.doc.wrap(st)
    case False{}:
      sr.K.cr(cr, st)

# the mode a scanning state's step gives, from the state after the step:
# after a quote or an apostrophe a string may open, after a carriage return
# a line feed is waited for
def sr.K(dq: Bool, sq: Bool, cr: Bool, st: T.St) -> T.Mode:
  match dq:
    case True{}:
      T.doc.wrap(st)
    case False{}:
      sr.K.sq(sq, cr, st)

# and with the character's own tests
def sr.Kc(+cc: Char, st: T.St) -> T.Mode:
  sr.K(Char.is_eq(cc, '"'), Char.is_eq(cc, '\''), U32.is_eq(Char.to_u32(cc), 13), st)

# a scanning state's step is the fast step, then sr.K
def sr.scan(
  dq: Bool,
  sq: Bool,
  cr: Bool,
  st: T.St,
  +cc: Char
) -> {T.doc.scan.q(dq, sq, cr, st, cc) == sr.K(dq, sq, cr, T.read.fast(st, cc)) : T.Mode}:
  match dq:
    case True{}:
      {==}
    case False{}:
      match sq:
        case True{}:
          {==}
        case False{}:
          match cr:
            case True{}:
              {==}
            case False{}:
              {==}

# by the two newlines' tests: each is a control
def sr.nlctl.go(
  +uu: U32,
  aa: Bool,
  bb: Bool,
  ea: {U32.is_eq(uu, 10) == aa : Bool},
  eb: {U32.is_eq(uu, 13) == bb : Bool},
  ee: {T.ch.ctl(Chr{uu}) == False{} : Bool}
) -> {Bool.or(aa, bb) == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.gone(&2, {Bool.or(True{}, bb) == False{} : Bool}, Eq.refute_char(Chr{uu}, Chr{10},
        cc => Bool.not(T.ch.ctl(cc)), ea, Equal.cong(Bool, Bool, xx => Bool.not(xx), T.ch.ctl(Chr{uu}), False{},
        ee), {==}))
    case False{}:
      match bb:
        case True{}:
          Eq.bit.gone(&2, {Bool.or(False{}, True{}) == False{} : Bool}, Eq.refute_char(Chr{uu}, Chr{13},
            cc => Bool.not(T.ch.ctl(cc)), eb, Equal.cong(Bool, Bool, xx => Bool.not(xx), T.ch.ctl(Chr{uu}),
            False{}, ee), {==}))
        case False{}:
          {==}

# a character that is no control is no newline
def sr.nlctl(+cc: Char, ee: {T.ch.ctl(cc) == False{} : Bool}) -> {T.ch.nl(cc) == False{} : Bool}:
  match cc:
    case Chr{+uu}:
      sr.nlctl.go(uu, U32.is_eq(uu, 10), U32.is_eq(uu, 13), {==}, {==}, ee)

# LStr's fast step, a basic string's character not a quote or a backslash
def sr.ff.bpush(
  bad: Bool,
  +cc: Char,
  ebad: {T.str.bad(Char.to_u32(cc), False{}) == bad : Bool},
  eq: {Char.is_eq(cc, '"') == False{} : Bool},
  eb: {Char.is_eq(cc, '\\') == False{} : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,

) -> {T.read.fast.push(bad, bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at, cc) : T.St}:
  match bad:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(Bool, Char.is_eq(cc, '"'), False{}, eq) : {T.read.fast.cons(bd, rw, hs, he, pt, bf, T.LStr{}, bk,
        T.QBasic{}, sk, un, lf, at, cc) == T.read.once2(T.lex.str.go(_, False{}, True{}, sip.S(bd, rw, hs, he, pt,
        bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at), cc, T.QBasic{})) : T.St}
      %Equal.sym(Bool, Char.is_eq(cc, '\\'), False{}, eb) : {T.read.fast.cons(bd, rw, hs, he, pt, bf, T.LStr{}, bk,
        T.QBasic{}, sk, un, lf, at, cc) == T.read.once2(T.lex.str.bs(_, False{}, sip.S(bd, rw, hs, he, pt, bf,
        T.LStr{}, bk, T.QBasic{}, sk, un, lf, at), cc, T.QBasic{})) : T.St}
      %Equal.sym(Bool, T.str.bad(Char.to_u32(cc), False{}), False{}, ebad) : {T.read.fast.cons(bd, rw, hs, he, pt,
        bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at, cc) == T.read.once2(T.lex.str.char.go(_, sip.S(bd, rw, hs,
        he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at), cc)) : T.St}
      {==}

# LStr's fast step in a basic string
def sr.ff.basic(
  qt: Bool,
  bs: Bool,
  +cc: Char,
  eq: {Char.is_eq(cc, '"') == qt : Bool},
  eb: {Char.is_eq(cc, '\\') == bs : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,

) -> {T.read.fast.basic(qt, bs, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at, cc) : T.St}:
  match qt:
    case True{}:
      {==}
    case False{}:
      match bs:
        case True{}:
          {==}
        case False{}:
          sr.ff.bpush(T.str.bad(Char.to_u32(cc), False{}), cc, {==}, eq, eb, bd, rw, hs, he, pt, bf, bk, sk, un, lf,
            at)

# LStr's fast step in a literal string, a character not an apostrophe
def sr.ff.lpush(
  bad: Bool,
  +cc: Char,
  ebad: {T.str.bad(Char.to_u32(cc), False{}) == bad : Bool},
  eq: {Char.is_eq(cc, '\'') == False{} : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,

) -> {T.read.fast.push(bad, bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at, cc) : T.St}:
  match bad:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(Bool, Char.is_eq(cc, '\''), False{}, eq) : {T.read.fast.cons(bd, rw, hs, he, pt, bf, T.LStr{}, bk,
        T.QLit{}, sk, un, lf, at, cc) == T.read.once2(T.lex.str.go(_, False{}, False{}, sip.S(bd, rw, hs, he, pt,
        bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at), cc, T.QLit{})) : T.St}
      %Equal.sym(Bool, T.str.bad(Char.to_u32(cc), False{}), False{}, ebad) : {T.read.fast.cons(bd, rw, hs, he, pt,
        bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at, cc) == T.read.once2(T.lex.str.char.go(_, sip.S(bd, rw, hs,
        he, pt, bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at), cc)) : T.St}
      {==}

# LStr's fast step in a literal string
def sr.ff.lit(
  qt: Bool,
  +cc: Char,
  eq: {Char.is_eq(cc, '\'') == qt : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,

) -> {T.read.fast.lit(qt, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at, cc) : T.St}:
  match qt:
    case True{}:
      {==}
    case False{}:
      sr.ff.lpush(T.str.bad(Char.to_u32(cc), False{}), cc, {==}, eq, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at)

# LStr's fast step, by the string's kind
def sr.ff.str(
  qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char
) -> {T.read.fast.str(qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LStr{}, bk, qk, sk, un, lf, at, cc) : T.St}:
  match qk:
    case T.QBasic{}:
      sr.ff.basic(Char.is_eq(cc, '"'), Char.is_eq(cc, '\\'), cc, {==}, {==}, bd, rw, hs, he, pt, bf, bk, sk, un, lf,
        at)
    case T.QLit{}:
      sr.ff.lit(Char.is_eq(cc, '\''), cc, {==}, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at)
    case T.QMulti{}:
      {==}
    case T.QMultiLit{}:
      {==}

# LKey's fast step: a bare character is pushed
def sr.ff.key(
  ok: Bool,
  +cc: Char,
  eo: {T.bare.at(cc) == ok : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,

) -> {T.read.fast.key(ok, bd, rw, hs, he, pt, bf, bk, qk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LKey{}, bk, qk, sk, un, lf, at, cc) : T.St}:
  match ok:
    case True{}:
      %Equal.sym(Bool, T.bare.at(cc), True{}, eo) : {T.read.fast.cons(bd, rw, hs, he, pt, bf, T.LKey{}, bk, qk, sk,
        un, lf, at, cc) == T.read.once2(T.lex.key.go(_, T.ch.sp(cc), Char.is_eq(cc, '.'), Char.is_eq(cc, '='),
        Char.is_eq(cc, '#'), T.ch.nl(cc), sip.S(bd, rw, hs, he, pt, bf, T.LKey{}, bk, qk, sk, un, lf, at), cc))
        : T.St}
      {==}
    case False{}:
      {==}

# LBare's fast step: a character that ends no word is pushed
def sr.ff.bare(
  dl: Bool,
  +cc: Char,
  ed: {T.ch.delim(cc) == dl : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,

) -> {T.read.fast.bare(dl, bd, rw, hs, he, pt, bf, bk, qk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LBare{}, bk, qk, sk, un, lf, at, cc) : T.St}:
  match dl:
    case False{}:
      %Equal.sym(Bool, T.ch.delim(cc), False{}, ed) : {T.read.fast.cons(bd, rw, hs, he, pt, bf, T.LBare{}, bk, qk,
        sk, un, lf, at, cc) == T.read.once2(T.lex.bare.go(_, T.ch.space(cc), sip.S(bd, rw, hs, he, pt, bf, T.LBare{},
        bk, qk, sk, un, lf, at), cc)) : T.St}
      {==}
    case True{}:
      {==}

# LCom's fast step: a character that is no control is passed over
def sr.ff.com(
  ct: Bool,
  +cc: Char,
  +ec: {T.ch.ctl(cc) == ct : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,

) -> {T.read.fast.com(ct, bd, rw, hs, he, pt, bf, bk, qk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LCom{}, bk, qk, sk, un, lf, at, cc) : T.St}:
  match ct:
    case False{}:
      %Equal.sym(Bool, T.ch.nl(cc), False{}, sr.nlctl(cc, ec)) : {sip.S(bd, rw, hs, he, pt, bf, T.LCom{}, bk, qk,
        sk, un, lf, at) == T.read.once2(T.lex.com.go(_, T.ch.ctl(cc), U32.is_eq(Char.to_u32(cc), 9), sip.S(bd, rw,
        hs, he, pt, bf, T.LCom{}, bk, qk, sk, un, lf, at), cc)) : T.St}
      %Equal.sym(Bool, T.ch.ctl(cc), False{}, ec) : {sip.S(bd, rw, hs, he, pt, bf, T.LCom{}, bk, qk, sk, un, lf, at)
        == T.read.once2(T.lex.com.go(False{}, _, U32.is_eq(Char.to_u32(cc), 9), sip.S(bd, rw, hs, he, pt, bf,
        T.LCom{}, bk, qk, sk, un, lf, at), cc)) : T.St}
      {==}
    case True{}:
      {==}

# LTop's fast step: blank space, and a newline, is passed over
def sr.ff.top(
  sp: Bool,
  nl: Bool,
  +cc: Char,
  es: {T.ch.sp(cc) == sp : Bool},
  en: {T.ch.nl(cc) == nl : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool
) -> {T.read.fast.ws(sp, nl, True{}, bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf, at, cc) : T.St}:
  match sp:
    case True{}:
      %Equal.sym(Bool, T.ch.sp(cc), True{}, es) : {sip.S(bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf, at) ==
        T.read.once2(T.lex.top.go(_, T.ch.nl(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, '['), Char.is_eq(cc, '"'),
        Char.is_eq(cc, '\''), T.bare.at(cc), sip.S(bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf, at), cc)) :
        T.St}
      {==}
    case False{}:
      match nl:
        case True{}:
          %Equal.sym(Bool, T.ch.sp(cc), False{}, es) : {sip.S(bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf,
            at) == T.read.once2(T.lex.top.go(_, T.ch.nl(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, '['), Char.is_eq(cc,
            '"'), Char.is_eq(cc, '\''), T.bare.at(cc), sip.S(bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf,
            at), cc)) : T.St}
          %Equal.sym(Bool, T.ch.nl(cc), True{}, en) : {sip.S(bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf, at)
            == T.read.once2(T.lex.top.go(False{}, _, Char.is_eq(cc, '#'), Char.is_eq(cc, '['), Char.is_eq(cc, '"'),
            Char.is_eq(cc, '\''), T.bare.at(cc), sip.S(bd, rw, hs, he, pt, bf, T.LTop{}, bk, qk, sk, un, lf, at), cc))
            : T.St}
          {==}
        case False{}:
          {==}

# LArr's fast step: blank space, and a newline, is passed over
def sr.ff.arr(
  sp: Bool,
  nl: Bool,
  +cc: Char,
  es: {T.ch.sp(cc) == sp : Bool},
  en: {T.ch.nl(cc) == nl : Bool},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool
) -> {T.read.fast.ws(sp, nl, True{}, bd, rw, hs, he, pt, bf, T.LArr{}, bk, qk, sk, un, lf, at, cc)
  == T.read.fast.old(bd, rw, hs, he, pt, bf, T.LArr{}, bk, qk, sk, un, lf, at, cc) : T.St}:
  match sp:
    case True{}:
      %Equal.sym(Bool, T.ch.sp(cc), True{}, es) : {sip.S(bd, rw, hs, he, pt, bf, T.LArr{}, bk, qk, sk, un, lf, at) ==
        T.read.once2(T.lex.arr.go(_, T.ch.nl(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, ']'), sip.S(bd, rw, hs, he, pt,
        bf, T.LArr{}, bk, qk, sk, un, lf, at), cc)) : T.St}
      {==}
    case False{}:
      match nl:
        case True{}:
          %Equal.sym(Bool, T.ch.sp(cc), False{}, es) : {sip.S(bd, rw, hs, he, pt, bf, T.LArr{}, bk, qk, sk, un, lf,
            at) == T.read.once2(T.lex.arr.go(_, T.ch.nl(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, ']'), sip.S(bd, rw,
            hs, he, pt, bf, T.LArr{}, bk, qk, sk, un, lf, at), cc)) : T.St}
          %Equal.sym(Bool, T.ch.nl(cc), True{}, en) : {sip.S(bd, rw, hs, he, pt, bf, T.LArr{}, bk, qk, sk, un, lf, at)
            == T.read.once2(T.lex.arr.go(False{}, _, Char.is_eq(cc, '#'), Char.is_eq(cc, ']'), sip.S(bd, rw, hs, he,
            pt, bf, T.LArr{}, bk, qk, sk, un, lf, at), cc)) : T.St}
          {==}
        case False{}:
          {==}

