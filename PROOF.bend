  +un: U32,
  +lf: U32,
  +at: Bool
) -> T.St:
  sip.S(bd, rw, hs, he, pt, bf, T.LHeadE{}, bk, T.QBasic{}, sk, un, lf, at)

# the mode r1.heb.l reads its text from
def r1.heb.lM(
  +mb: Bool,
  +mt: Bool,
  +mn: Bool,
  +mf: Bool,
  +mr: Bool,
  +mu: Bool,
  +mw: Bool,
  +lit: Bool,
  +cr: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
