    rr), 10n), Nat.add(Nat.mul(qq, 10n), mm)), Ar.nat_add_assoc(Nat.mul(Nat.mul(vv, rr), 10n), Nat.mul(qq, 10n),
    mm)) : {_ == Nat.add(Nat.mul(Nat.add(Nat.mul(vv, 10n), dd), rr), cc) : Nat}
