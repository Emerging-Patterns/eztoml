# LHead
def fz.x.head(
  +br: Bool,
  +bare: Bool,
  +sp: Bool,
  +dot: Bool,
  +end: Bool,
  +qq: Bool,
  +lit: Bool,
  +hash: Bool,
  +st: T.St,
  +cc: Char,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.head.go(br, bare, sp, dot, end, qq, lit, hash, st, cc), b0, bs, rr):
  match br:
    case True{}:
      fz.x.hbr(st, b0, bs, rr, h)
    case False{}:
      match bare:
        case True{}:
          fz.x.hch(st, cc, b0, bs, rr, h)
        case False{}:
          match sp:
            case True{}:
              fz.x.hgap0(st, b0, bs, rr, h)
            case False{}:
              match dot:
                case True{}:
                  fz.x.hdot2(st, b0, bs, rr, h)
                case False{}:
                  match end:
                    case True{}:
                      fz.x.hclose(st, b0, bs, rr, h)
                    case False{}:
                      match qq:
                        case True{}:
                          fz.x.hquote(st, T.QBasic{}, b0, bs, rr, h)
                        case False{}:
                          match lit:
                            case True{}:
                              fz.x.hquote(st, T.QLit{}, b0, bs, rr, h)
                            case False{}:
                              fz.x.hhash(hash, st, b0, bs, rr, h)

# LHeadGap
def fz.x.hg(
  +sp: Bool,
  +dot: Bool,
  +end: Bool,
  +hash: Bool,
  +st: T.St,
  +cc: Char,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.hgap(sp, dot, end, hash, st, cc), b0, bs, rr):
  match sp:
    case True{}:
      h
    case False{}:
      match dot:
        case True{}:
          match st:
            case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
              h
        case False{}:
          match end:
            case True{}:
              fz.x.hclose(st, b0, bs, rr, h)
            case False{}:
              fz.x.hhash(hash, st, b0, bs, rr, h)

# LHeadDot
def fz.x.hd(
  +sp: Bool,
  +bare: Bool,
  +qq: Bool,
  +lit: Bool,
  +st: T.St,
  +cc: Char,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.hdot(sp, bare, qq, lit, st, cc), b0, bs, rr):
  match sp:
    case True{}:
      h
    case False{}:
      match bare:
        case True{}:
          match st:
            case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
              h
        case False{}:
          match qq:
            case True{}:
              match st:
                case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
                  h
            case False{}:
              match lit:
                case True{}:
                  match st:
                    case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
                      h
                case False{}:
                  fz.err(st, "invalid header", b0, bs, rr, h)

