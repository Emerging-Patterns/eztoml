# LKeyQ's dispatch in a basic segment
def r1.kqb.go(
  qq: Bool,
  bs: Bool,
  nl: Bool,
  lit: Bool,
  cr: Bool,
  +cc: Char,
  +eqq: {Char.is_eq(cc, '"') == qq : Bool},
  +ebs: {Char.is_eq(cc, '\\') == bs : Bool},
  +_enl: {T.ch.nl(cc) == nl : Bool},
