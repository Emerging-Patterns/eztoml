# a keyval line, by its value node: only a keyval is one g.ok allows
def aq.xkv0(
  +w1: String,
  +kv: Laws.GVal,
  +w2: String,
  +com: Laws.GCom,
  +tail: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ls: List<&2, Laws.GLine>,
  +hx: {Laws.g.ok.expr(Laws.GxKeyval{w1, kv, w2, com}) == True{} : Bool},
  +es: {Laws.short(Laws.g.expr.text(Laws.GxKeyval{w1, kv, w2, com}, tail)) == True{} : Bool},
  +hft: {aq.fol(tail) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls)
) -> {Laws.own(T.doc.read(Laws.g.expr.text(Laws.GxKeyval{w1, kv, w2, com}, tail), T.MScan{ap.s(T.LTop{}, bk, rw, hs,
  he, [], qk, [], un, lf, False{})})) == ap.F(ls, Laws.replay.expr(Laws.GxKeyval{w1, kv, w2, com}, Laws.RpSt{"",
    Laws.own.rows(rw), hs, he})) : T.Doc}:
  match kv:
    case Laws.GKeyval{+key, +wa, +wb, +val}:
      aq.xkv(w1, key, wa, wb, val, w2, com, tail, rw, hs, he, bk, qk, un, lf, ls, hx, es, hft, kk, ee)
    case Laws.GvString{_a0}:
      Eq.bit.absurd(&2, {Laws.own(T.doc.read(Laws.g.expr.text(Laws.GxKeyval{w1, Laws.GvString{_a0}, w2, com}, tail),
        T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})})) == ap.F(ls,
