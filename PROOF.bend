def fz.x.trim2(
  +lf: Bool,
  +st: T.St,
  +cc: Char,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.trim2.go(lf, st, cc), b0, bs, rr):
  match lf:
    case True{}:
      match st:
        case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
          h
    case False{}:
      match st:
        case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
          h

# a bare word's space
