# a closing bracket
def fz.x.hclosego(
  +empty: Bool,
  +arr: Bool,
  +st: T.St,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.head.close.go(empty, arr, st), b0, bs, rr):
  match empty:
    case True{}:
      fz.x.hclose2(arr, st, b0, bs, rr, h)
    case False{}:
      fz.x.hclose2(arr, T.seg.push(st, T.LHead{}), b0, bs, rr, fz.segp(st, T.LHead{}, b0, bs, rr, h))

# a closing bracket
def fz.x.hclose(
