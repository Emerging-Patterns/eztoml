      gs.spec.p(hh, t1 <> ts, dg.noi(hh, hx), dg.non(hh, hx))),
    Equal.trans(T.Got, T.word.route(T.GotBad{""}, T.word.or(T.word.colon('+' <> hh <> t1 <> ts),
      T.word.dash('+' <> hh <> t1 <> ts, True{})), '+' <> hh <> t1 <> ts), T.word.num('+' <> hh <> t1 <> ts),
      n1.dw.G(T.Plus{}, SCon{hh, Laws.abnf.no_us(t1 <> ts)}),
      route.num('+' <> hh <> t1 <> ts, gs.hc(hh, t1 <> ts, hx, hr), gs.hd1(hh, t1 <> ts, hx, hr)),
      n1.dw.scan(T.Plus{}, hh, t1, ts, T.Num{T.NSign{}, T.Plus{}, 10, [], False{}, False{}, ""},
        nw.sign(T.Plus{}, hh, hx, hz), hx, hz, hr, '+' <> hh <> t1 <> ts)))

# a lone DIGIT, with no sign, a minus or a plus, is in range
def n1.dw.ou(
  hh: Char,
  hx: {Char.is_digit(hh) == True{} : Bool}
) -> {T.word.val([hh]) == n1.dw.G(T.Plus{}, Laws.abnf.no_us([hh])) : T.Got}:
  dg.elim(zz => {T.word.val([zz]) == n1.dw.G(T.Plus{}, Laws.abnf.no_us([zz])) : T.Got}, hh, hx,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# after a minus
def n1.dw.om(
  hh: Char,
  hx: {Char.is_digit(hh) == True{} : Bool}
) -> {T.word.val(['-', hh]) == n1.dw.G(T.Minus{}, Laws.abnf.no_us([hh])) : T.Got}:
  dg.elim(zz => {T.word.val(['-', zz]) == n1.dw.G(T.Minus{}, Laws.abnf.no_us([zz])) : T.Got}, hh, hx,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# after a plus
def n1.dw.op(
  hh: Char,
  hx: {Char.is_digit(hh) == True{} : Bool}
) -> {T.word.val(['+', hh]) == n1.dw.G(T.Plus{}, Laws.abnf.no_us([hh])) : T.Got}:
  dg.elim(zz => {T.word.val(['+', zz]) == n1.dw.G(T.Plus{}, Laws.abnf.no_us([zz])) : T.Got}, hh, hx,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# an unsigned-dec-int with no sign
def n1.dw.uns(
  +hh: Char,
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(hh <> tt) == True{} : Bool}
) -> {T.word.val(hh <> tt) == n1.dw.G(T.Plus{}, Laws.abnf.no_us(hh <> tt)) : T.Got}:
  match tt:
    case []:
      n1.dw.ou(hh, gs.body.one(hh, Laws.abnf.DIGIT(hh), {==}, hu))
    case +t1 <> +ts:
      n1.dw.mu(hh, t1, ts, gs.body.l(hh, t1, ts, hu), gs.body.r(hh, t1, ts, hu))

# after a minus
def n1.dw.neg.go(
  +hh: Char,
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(hh <> tt) == True{} : Bool}
) -> {T.word.val('-' <> hh <> tt) == n1.dw.G(T.Minus{}, Laws.abnf.no_us(hh <> tt)) : T.Got}:
  match tt:
    case []:
      n1.dw.om(hh, gs.body.one(hh, Laws.abnf.DIGIT(hh), {==}, hu))
    case +t1 <> +ts:
      n1.dw.mm(hh, t1, ts, gs.body.l(hh, t1, ts, hu), gs.body.r(hh, t1, ts, hu))

# a minus and an unsigned-dec-int
def n1.dw.neg(
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(tt) == True{} : Bool}
) -> {T.word.val('-' <> tt) == n1.dw.G(T.Minus{}, Laws.abnf.no_us(tt)) : T.Got}:
  match tt:
    case []:
      Eq.bit.absurd(&2, {T.word.val(['-']) == n1.dw.G(T.Minus{}, Laws.abnf.no_us([])) : T.Got}, hu)
    case +hh <> +tl:
      n1.dw.neg.go(hh, tl, hu)

# after a plus
def n1.dw.pos.go(
  +hh: Char,
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(hh <> tt) == True{} : Bool}
) -> {T.word.val('+' <> hh <> tt) == n1.dw.G(T.Plus{}, Laws.abnf.no_us(hh <> tt)) : T.Got}:
  match tt:
    case []:
      n1.dw.op(hh, gs.body.one(hh, Laws.abnf.DIGIT(hh), {==}, hu))
    case +t1 <> +ts:
      n1.dw.mp(hh, t1, ts, gs.body.l(hh, t1, ts, hu), gs.body.r(hh, t1, ts, hu))

# a plus and an unsigned-dec-int
def n1.dw.pos(
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(tt) == True{} : Bool}
) -> {T.word.val('+' <> tt) == n1.dw.G(T.Plus{}, Laws.abnf.no_us(tt)) : T.Got}:
  match tt:
    case []:
      Eq.bit.absurd(&2, {T.word.val(['+']) == n1.dw.G(T.Plus{}, Laws.abnf.no_us([])) : T.Got}, hu)
    case +hh <> +tl:
      n1.dw.pos.go(hh, tl, hu)

# what the dec-int reading claims of a word
def n1.dw.W(+cs: List<&2, Char>) -> Type:
  {T.word.val(cs) == n1.dw.G(Laws.abnf.dec_sign(cs), Laws.abnf.dec_digits(cs)) : T.Got}

# by the first character: a minus, a plus, or the first digit
def n1.dw.top(
  +hh: Char,
  +tt: List<&2, Char>,
  mm: Bool,
  +em: {Laws.abnf.minus(hh) == mm : Bool},
  pp: Bool,
  +ep: {Laws.abnf.plus(hh) == pp : Bool},
  +h: {Laws.abnf.dec_int(hh <> tt) == True{} : Bool}
) -> n1.dw.W(hh <> tt):
  match mm:
    case True{}:
      +ee = {Equal.sym(Char, hh, '-', gs.minus(hh, em)) : {'-' == hh : Char}}
      %ee : n1.dw.W(_ <> tt)
      n1.dw.neg(tt, or.fl(Laws.abnf.unsigned_dec_int(tt), Equal.trans(Bool, Laws.abnf.dec_int('-' <> tt),
        Laws.abnf.dec_int(hh <> tt), True{}, Equal.cong(Char, Bool, cc => Laws.abnf.dec_int(cc <> tt), '-', hh, ee),
        h)))
    case False{}:
      match pp:
        case True{}:
          +ee = {Equal.sym(Char, hh, '+', gs.plus(hh, ep)) : {'+' == hh : Char}}
          %ee : n1.dw.W(_ <> tt)
          n1.dw.pos(tt, or.fl(Laws.abnf.unsigned_dec_int(tt), Equal.trans(Bool, Laws.abnf.dec_int('+' <> tt),
            Laws.abnf.dec_int(hh <> tt), True{}, Equal.cong(Char, Bool, cc => Laws.abnf.dec_int(cc <> tt), '+', hh,
            ee), h)))
        case False{}:
          %Equal.sym(Bool, Laws.abnf.minus(hh), False{}, em) : {T.word.val(hh <> tt)
            == n1.dw.G(Laws.abnf.sign.pick(_), Laws.abnf.digits.pick(Bool.or(_, Laws.abnf.plus(hh)), hh, tt))
            : T.Got}
          %Equal.sym(Bool, Laws.abnf.plus(hh), False{}, ep) : {T.word.val(hh <> tt)
            == n1.dw.G(T.Plus{}, Laws.abnf.digits.pick(Bool.or(False{}, _), hh, tt)) : T.Got}
          n1.dw.uns(hh, tt, Equal.trans(Bool, Laws.abnf.unsigned_dec_int(hh <> tt), Laws.abnf.dec_int(hh <> tt),
            True{}, gs.top.hu(hh, tt, em, ep), h))

# a dec-int word is read as its sign and digits, tested for range
def n1.dw(+cs: List<&2, Char>, +h: {Laws.abnf.dec_int(cs) == True{} : Bool}) -> n1.dw.W(cs):
  match cs:
    case []:
      Eq.bit.absurd(&1, n1.dw.W([]), h)
    case +hh <> +tt:
      n1.dw.top(hh, tt, Laws.abnf.minus(hh), {==}, Laws.abnf.plus(hh), {==}, h)

# The integer law. An integer word read in range is its sign and its value's
# canonical digits, so a value matches the reading exactly when it is
# canonical and worth what the word's digits are; out of range, and outside
# the integer rule, a word is read as no integer.

# what an integer word denotes, by its sign, its digits and their radix
def n1.gi(vv: T.Val, +sg: T.Sign, +bd: List<&2, Char>, +rr: Nat) -> Bool:
  match vv:
    case T.VInt{sv, +dv}:
      Bool.and(Laws.sign.eq(sv, sg), Bool.and(Laws.g.dec.canon(dv), Nat.is_eq(Laws.g.num.nat(String.to_list(dv), 10n,
        0n), Laws.g.num.nat(bd, rr, 0n))))
    case _v:
      False{}

# which is what the grammar's value relation asks of an integer word
def n1.gv(
  vv: T.Val,
  +cs: List<&2, Char>
) -> {Laws.g.val(Laws.GvInteger{cs}, vv) == n1.gi(vv, Laws.abnf.dec_sign(cs), Laws.g.int.body(cs),
  Laws.g.int.radix(cs)) : Bool}:
  match vv:
    case T.VInt{_s, _d}:
      {==}
    case T.VStr{_t}:
      {==}
    case T.VSpan{_s, _n}:
      {==}
    case T.VFlo{_s, _t}:
      {==}
    case T.VBool{_b}:
      {==}
    case T.VWhen{_w}:
      {==}
    case T.VArr{_i}:
      {==}
    case T.VInl{_r}:
      {==}
    case T.VHead{_p, _r}:
      {==}
    case T.VAot{_p, _r}:
      {==}
    case T.VAots{_p, _e}:
      {==}
    case T.VPair{_n, _v}:
      {==}

# an integer, tested for range, is read as a value exactly when it is in
# range and the value is canonical and worth what its digits are
def n1.core(
  rg: Bool,
  vv: T.Val,
  +sg: T.Sign,
  +dd: String,
  +bd: List<&2, Char>,
  +rr: Nat,
  +hd: {Laws.g.dec.canon(dd) == True{} : Bool},
  +hv: {n1.h10(dd) == Laws.g.num.nat(bd, rr, 0n) : Nat}
) -> {Laws.n1.got.int(T.num.fin.range(rg, sg, dd), vv) == Bool.and(rg, n1.gi(vv, sg, bd, rr)) : Bool}:
  match rg:
    case True{}:
      match vv:
        case T.VInt{+sv, +dv}:
          %hv : {Bool.and(Laws.sign.eq(sv, sg), String.eq(dv, dd)) == Bool.and(Laws.sign.eq(sv, sg),
            Bool.and(Laws.g.dec.canon(dv), Nat.is_eq(n1.h10(dv), _))) : Bool}
          Equal.cong(Bool, Bool, bb => Bool.and(Laws.sign.eq(sv, sg), bb), String.eq(dv, dd),
            Bool.and(Laws.g.dec.canon(dv), Nat.is_eq(n1.h10(dv), n1.h10(dd))), n1.uq(dv, dd, hd))
        case T.VStr{_t}:
          {==}
        case T.VSpan{_s, _n}:
          {==}
        case T.VFlo{_s, _t}:
          {==}
        case T.VBool{_b}:
          {==}
        case T.VWhen{_w}:
          {==}
        case T.VArr{_i}:
          {==}
        case T.VInl{_r}:
          {==}
        case T.VHead{_p, _r}:
          {==}
        case T.VAot{_p, _r}:
          {==}
        case T.VAots{_p, _e}:
          {==}
        case T.VPair{_n, _v}:
          {==}
    case False{}:
      {==}

# the type of n1.px.v's es
def n1.px.v.P1(+rx: Laws.ARadix, +cx: Char, +rest: List<&2, Char>) -> Type:
  {T.num.go('0' <> cx <> rest, T.num.start()) == T.num.go(rest, T.Num{T.NBase{}, T.Plus{}, n1.rb(rx), [], False{},
    False{}, ""}) : T.Num}

# a prefixed integer's word is read as its numeral, tested for range
def n1.px.v(
  +uu: Unit,
  +rx: Laws.ARadix,
  +cx: Char,
  +rest: List<&2, Char>,
  +vv: T.Val,
  +hb: {n1.bg(rest, rx) == True{} : Bool},
  es: n1.px.v.P1(rx, cx, rest)
) -> {Laws.n1.got.int(T.word.val('0' <> cx <> rest), vv) == Bool.and(T.i64.fits(T.Plus{}, T.dec.text(n1.cv(rx, rest,
  []))), n1.gi(vv, T.Plus{}, rest, U32.to_nat(n1.rb(rx)))) : Bool}:
  +hr = {n1.rr.bg(rest, rx, hb) : {n1.rr(rx, rest) == True{} : Bool}}
  +ds = n1.cv(rx, rest, [])
  +hd = {n1.cvok(uu, rx, rest, [], {==}, hr) : {n1.d10(ds) == True{} : Bool}}
  +est = {Equal.trans(T.Num, T.num.go('0' <> cx <> rest, T.num.start()), T.num.go(rest, T.Num{T.NBase{}, T.Plus{},
    n1.rb(rx), [], False{}, False{}, ""}), n1.sb(T.Plus{}, rx, ds), es, n1.B0v(rest, T.Plus{}, rx, hb))
    : {T.num.go('0' <> cx <> rest, T.num.start()) == n1.sb(T.Plus{}, rx, ds) : T.Num}}
  %Equal.sym(T.Got, T.word.val('0' <> cx <> rest), T.num.fin(n1.sb(T.Plus{}, rx, ds), '0' <> cx <> rest),
    Equal.trans(T.Got, T.word.val('0' <> cx <> rest), T.word.num('0' <> cx <> rest), T.num.fin(n1.sb(T.Plus{}, rx,
    ds), '0' <> cx <> rest), n1.wv('0' <> cx <> rest, Equal.cong(T.Num, Bool, nn => n1.isbad(nn),
    T.num.go('0' <> cx <> rest, T.num.start()), n1.sb(T.Plus{}, rx, ds), est)), Equal.cong(T.Num, T.Got,
    nn => T.num.fin(nn, '0' <> cx <> rest), T.num.go('0' <> cx <> rest, T.num.start()), n1.sb(T.Plus{}, rx, ds),
    est))) : {Laws.n1.got.int(_, vv) == Bool.and(T.i64.fits(T.Plus{}, T.dec.text(ds)), n1.gi(vv, T.Plus{}, rest,
    U32.to_nat(n1.rb(rx)))) : Bool}
  n1.core(T.i64.fits(T.Plus{}, T.dec.text(ds)), vv, T.Plus{}, T.dec.text(ds), rest, U32.to_nat(n1.rb(rx)),
    n1.text.c(ds, hd), Equal.trans(Nat, n1.h10(T.dec.text(ds)), n1.W(ds), Laws.g.num.nat(rest, U32.to_nat(n1.rb(rx)),
    0n), n1.text.v(ds, hd), n1.cvW(uu, rx, rest, [], {==}, hr)))

# the prose's order and i64.ord agree
def n1.ordeq(aa: Cmp, +bb: Cmp) -> {Laws.prose.dec_le.ord(aa, bb) == T.i64.ord(aa, bb) : Cmp}:
  match aa:
    case EQ{}:
      {==}
    case LT{}:
      {==}
    case GT{}:
      {==}

# the prose's walk over a numeral against a limit is i64.step's
def n1.dle(aa: String, bb: String, +oo: Cmp) -> {Laws.prose.dec_le(aa, bb, oo) == T.i64.step(aa, bb, oo) : Bool}:
  match aa bb:
    case SNil{} SNil{}:
      {==}
    case SNil{} SCon{_h, _t}:
      {==}
    case SCon{_h, _t} SNil{}:
      {==}
    case SCon{+xx, +xt} SCon{+yy, +yt}:
      %Equal.sym(Cmp, Laws.prose.dec_le.ord(oo, U32.cmp(Char.to_u32(xx), Char.to_u32(yy))), T.i64.ord(oo,
        U32.cmp(Char.to_u32(xx), Char.to_u32(yy))), n1.ordeq(oo, U32.cmp(Char.to_u32(xx),
          Char.to_u32(yy)))) : {Laws.prose.dec_le(xt, yt, _) == T.i64.step(xt, yt,
        T.i64.ord(oo, U32.cmp(Char.to_u32(xx), Char.to_u32(yy)))) : Bool}
      n1.dle(xt, yt, T.i64.ord(oo, U32.cmp(Char.to_u32(xx), Char.to_u32(yy))))

# the prose's limits are the code's
def n1.dlim(sg: T.Sign) -> {Laws.prose.i64.limit(sg) == T.i64.limit(sg) : String}:
  match sg:
    case T.Plus{}:
      {==}
    case T.Minus{}:
      {==}

# so the prose's range of a dec-int is i64.fits
def n1.dfit(
  +sg: T.Sign,
  +dd: String
) -> {Laws.prose.dec_le(dd, Laws.prose.i64.limit(sg), EQ{}) == T.i64.fits(sg, dd) : Bool}:
  %Equal.sym(String, Laws.prose.i64.limit(sg), T.i64.limit(sg), n1.dlim(sg)) : {Laws.prose.dec_le(dd, _, EQ{})
    == T.i64.fits(sg, dd) : Bool}
  n1.dle(dd, T.i64.limit(sg), EQ{})

# a digit by the code is a DIGIT
def n1.dig.D(cc: Char, +hc: {Char.is_digit(cc) == True{} : Bool}) -> {Laws.abnf.DIGIT(cc) == True{} : Bool}:
  match cc:
    case Chr{_c}:
      hc

# digits by the code are DIGITs
def n1.wfall(ss: String, +hs: {T.wf.digits(ss) == True{} : Bool}) -> {Laws.g.dec.all(ss) == True{} : Bool}:
  match ss:
    case SNil{}:
      {==}
    case SCon{+hh, +tt}:
      and.tt(Laws.abnf.DIGIT(hh), Laws.g.dec.all(tt), n1.dig.D(hh, then.l(Char.is_digit(hh), tt, hs)), n1.wfall(tt,
        then.r(Char.is_digit(hh), tt, hs)))

# an unsigned-dec-int's digits, its underscores removed, are canonical
def n1.ucanon(
  +hh: Char,
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(hh <> tt) == True{} : Bool}
) -> {Laws.g.dec.canon(Laws.abnf.no_us(hh <> tt)) == True{} : Bool}:
  match tt:
    case []:
      dg.elim(zz => {Laws.g.dec.canon(Laws.abnf.no_us([zz])) == True{} : Bool}, hh, gs.body.one(hh,
        Laws.abnf.DIGIT(hh), {==}, hu), {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})
    case +t1 <> +ts:
      +hd = {gs.body.l(hh, t1, ts, hu) : {Laws.abnf.digit1_9(hh) == True{} : Bool}}
      +hx = {gs.d19(hh, hd) : {Char.is_digit(hh) == True{} : Bool}}
      %gs.nu(hh, t1 <> ts, gs.nous(hh, hx)) : {Laws.g.dec.canon(_) == True{} : Bool}
      %Equal.sym(Bool, Laws.abnf.DIGIT(hh), True{}, n1.dig.D(hh, hx)) : {Bool.and(_, Bool.or(Bool.and(
        Laws.abnf.cp(hh, 48), String.is_empty(Laws.abnf.no_us(t1 <> ts))), Bool.and(Laws.abnf.digit1_9(hh),
        Laws.g.dec.all(Laws.abnf.no_us(t1 <> ts))))) == True{} : Bool}
      %Equal.sym(Bool, Laws.abnf.cp(hh, 48), False{}, Equal.trans(Bool, Laws.abnf.cp(hh, 48), Char.is_eq(hh, '0'),
        False{}, Equal.sym(Bool, Char.is_eq(hh, Chr{48}), Laws.abnf.cp(hh, 48), n1.cp(hh, 48)), gs.d19z(hh, hd))) :
        {Bool.and(True{}, Bool.or(Bool.and(_, String.is_empty(Laws.abnf.no_us(t1 <> ts))),
        Bool.and(Laws.abnf.digit1_9(hh), Laws.g.dec.all(Laws.abnf.no_us(t1 <> ts))))) == True{} : Bool}
      %Equal.sym(Bool, Laws.abnf.digit1_9(hh), True{}, hd) : {Bool.and(True{}, Bool.or(Bool.and(False{},
        String.is_empty(Laws.abnf.no_us(t1 <> ts))), Bool.and(_, Laws.g.dec.all(Laws.abnf.no_us(t1 <> ts))))) ==
        True{} : Bool}
      n1.wfall(Laws.abnf.no_us(t1 <> ts), gs.digits(t1 <> ts, gs.body.r(hh, t1, ts, hu)))

# an unsigned-dec-int's digits are canonical
def n1.ucan(
  tt: List<&2, Char>,
  +hu: {Laws.abnf.unsigned_dec_int(tt) == True{} : Bool}
) -> {Laws.g.dec.canon( Laws.abnf.no_us(tt)) == True{} : Bool}:
  match tt:
    case []:
      Eq.bit.absurd(&2, {Laws.g.dec.canon(Laws.abnf.no_us([])) == True{} : Bool}, hu)
    case +hh <> +tl:
      n1.ucanon(hh, tl, hu)

# what the canonical lemma claims of a word
def n1.dcan.W(+cs: List<&2, Char>) -> Type:
  {Laws.g.dec.canon(Laws.abnf.dec_digits(cs)) == True{} : Bool}

# a dec-int's digits are canonical, by its first character: a minus, a plus,
# or the first digit
def n1.dcan.top(
  +hh: Char,
  +tt: List<&2, Char>,
  mm: Bool,
  +em: {Laws.abnf.minus(hh) == mm : Bool},
  pp: Bool,
  +ep: {Laws.abnf.plus(hh) == pp : Bool},
  +h: {Laws.abnf.dec_int(hh <> tt) == True{} : Bool}
) -> n1.dcan.W(hh <> tt):
  match mm:
    case True{}:
      +ee = {Equal.sym(Char, hh, '-', gs.minus(hh, em)) : {'-' == hh : Char}}
      %ee : n1.dcan.W(_ <> tt)
      n1.ucan(tt, or.fl(Laws.abnf.unsigned_dec_int(tt), Equal.trans(Bool, Laws.abnf.dec_int('-' <> tt),
        Laws.abnf.dec_int(hh <> tt), True{}, Equal.cong(Char, Bool, cc => Laws.abnf.dec_int(cc <> tt), '-', hh, ee),
        h)))
    case False{}:
      match pp:
        case True{}:
          +ee = {Equal.sym(Char, hh, '+', gs.plus(hh, ep)) : {'+' == hh : Char}}
          %ee : n1.dcan.W(_ <> tt)
          n1.ucan(tt, or.fl(Laws.abnf.unsigned_dec_int(tt), Equal.trans(Bool, Laws.abnf.dec_int('+' <> tt),
            Laws.abnf.dec_int(hh <> tt), True{}, Equal.cong(Char, Bool, cc => Laws.abnf.dec_int(cc <> tt), '+', hh,
            ee), h)))
        case False{}:
          %Equal.sym(Bool, Laws.abnf.minus(hh), False{}, em) : {Laws.g.dec.canon(Laws.abnf.digits.pick(Bool.or(_,
            Laws.abnf.plus(hh)), hh, tt)) == True{} : Bool}
          %Equal.sym(Bool, Laws.abnf.plus(hh), False{}, ep) : {Laws.g.dec.canon(Laws.abnf.digits.pick(Bool.or(False{},
            _), hh, tt)) == True{} : Bool}
          n1.ucan(hh <> tt, Equal.trans(Bool, Laws.abnf.unsigned_dec_int(hh <> tt), Laws.abnf.dec_int(hh <> tt),
            True{}, gs.top.hu(hh, tt, em, ep), h))

# a dec-int's digits are canonical
def n1.dcan(+cs: List<&2, Char>, +h: {Laws.abnf.dec_int(cs) == True{} : Bool}) -> n1.dcan.W(cs):
  match cs:
    case []:
      Eq.bit.absurd(&1, n1.dcan.W([]), h)
    case +hh <> +tt:
      n1.dcan.top(hh, tt, Laws.abnf.minus(hh), {==}, Laws.abnf.plus(hh), {==}, h)

# what the integer law claims of a word
def n1.int.G(+cs: List<&2, Char>, +vv: T.Val) -> Type:
  {Laws.n1.got.int(T.word.val(cs), vv) == Bool.and(Bool.and(Laws.abnf.integer(cs), Laws.prose.int_in_range(cs)),
    Laws.g.val(Laws.GvInteger{cs}, vv)) : Bool}

# no datetime is an integer
def n1.when.nint(ww: T.WhenOut, +vv: T.Val) -> {Laws.n1.got.int(T.word.from.when(ww), vv) == False{} : Bool}:
  match ww:
    case T.WSome{_w}:
      {==}
    case T.WFail{_y}:
      {==}
    case T.WSkip{}:
      {==}

# a finished scan with no integer's shape is read as no integer, by its
# fields
def n1.fin.nint.go(
  uz: Bool,
  nk: T.NK,
  saw: Bool,
  sd: Bool,
  +sn: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +esd: {T.num.signed(cs) == sd : Bool},
  +hh: {n1.ish.nk(nk, saw, uz, sd) == False{} : Bool}
) -> {Laws.n1.got.int(T.num.fin(T.Num{nk, sn, base, ds, uz, saw, why}, cs), vv) == False{} : Bool}:
  match uz:
    case True{}:
      {==}
    case False{}:
      match nk:
        case T.NZero{}:
          Eq.bit.absurd2(&2, {Laws.n1.got.int(T.num.fin(T.Num{T.NZero{}, sn, base, ds, False{}, saw, why}, cs), vv)
            == False{} : Bool}, hh)
        case T.NDig{}:
          match saw:
            case True{}:
              Eq.bit.absurd2(&2, {Laws.n1.got.int(T.num.fin(T.Num{T.NDig{}, sn, base, ds, False{}, True{}, why}, cs),
                vv) == False{} : Bool}, hh)
            case False{}:
              {==}
        case T.NBase{}:
          match saw sd:
            case True{} True{}:
              %Equal.sym(Bool, T.num.signed(cs), True{}, esd) : {Laws.n1.got.int(T.num.fin.base(_, True{}, sn, ds), vv)
                == False{} : Bool}
              {==}
            case True{} False{}:
              Eq.bit.absurd2(&2, {Laws.n1.got.int(T.num.fin(T.Num{T.NBase{}, sn, base, ds, False{}, True{}, why}, cs),
                vv) == False{} : Bool}, hh)
            case False{} True{}:
              %Equal.sym(Bool, T.num.signed(cs), True{}, esd) : {Laws.n1.got.int(T.num.fin.base(_, False{}, sn, ds),
                vv) == False{} : Bool}
              {==}
            case False{} False{}:
              %Equal.sym(Bool, T.num.signed(cs), False{}, esd) : {Laws.n1.got.int(T.num.fin.base(_, False{}, sn, ds),
                vv) == False{} : Bool}
              {==}
        case T.NFrac{}:
          match saw:
            case True{}:
              {==}
            case False{}:
              {==}
        case T.NEDig{}:
          match saw:
            case True{}:
              {==}
            case False{}:
              {==}
        case T.NLead{}:
          {==}
        case T.NSign{}:
          {==}
        case T.NExp{}:
          {==}
        case T.NBad{}:
          {==}

# a finished scan with no integer's shape is read as no integer
def n1.fin.nint(
  st: T.Num,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +hh: {n1.ish(st, T.num.signed(cs)) == False{} : Bool}
) -> {Laws.n1.got.int(T.num.fin(st, cs), vv) == False{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, us, saw, +why}:
      n1.fin.nint.go(us, nk, saw, T.num.signed(cs), sg, base, ds, why, cs, vv, {==}, hh)

# a word sent to the datetime reader, or to the numeral scan with no
# integer's shape, is read as no integer
def n1.int.ns.go(
  ad: Bool,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +hh: {n1.ish(T.num.go(cs, T.num.start()), T.num.signed(cs)) == False{} : Bool}
) -> {Laws.n1.got.int(T.word.route.date(ad, cs), vv) == False{} : Bool}:
  match ad:
    case True{}:
      n1.when.nint(T.when.read(cs), vv)
    case False{}:
      n1.fin.nint(T.num.go(cs, T.num.start()), cs, vv, hh)

# a word outside the integer rule, special or not, is read as no integer
def n1.int.out.go(
  sp: Bool,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +es: {n1.isspec(cs) == sp : Bool},
  +hh: {n1.ish(T.num.go(cs, T.num.start()), T.num.signed(cs)) == False{} : Bool}
) -> {Laws.n1.got.int(T.word.val(cs), vv) == False{} : Bool}:
  match sp:
    case True{}:
      n1.spec.split(xs => {Laws.n1.got.int(T.word.val(xs), vv) == False{} : Bool}, cs, es, {==}, {==}, {==}, {==},
        {==}, {==}, {==}, {==})
    case False{}:
      %Equal.sym(T.Got, T.word.val(cs), T.word.route.date(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs,
        True{})), T.word.ee(cs)), cs), n1.wv.ns(cs, es)) : {Laws.n1.got.int(_, vv) == False{} : Bool}
      n1.int.ns.go(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), cs, vv, hh)

# a word outside the integer rule is read as no integer, and matches none
def n1.int.out(+cs: List<&2, Char>, +vv: T.Val, +ei: {Laws.abnf.integer(cs) == False{} : Bool}) -> n1.int.G(cs, vv):
  %Equal.sym(Bool, Laws.abnf.integer(cs), False{}, ei) : {Laws.n1.got.int(T.word.val(cs), vv) == Bool.and(Bool.and(_,
    Laws.prose.int_in_range(cs)), Laws.g.val(Laws.GvInteger{cs}, vv)) : Bool}
  n1.int.out.go(n1.isspec(cs), cs, vv, {==}, Equal.trans(Bool, n1.ish(T.num.go(cs, T.num.start()), T.num.signed(cs)),
    Laws.abnf.integer(cs), False{}, n1.int.sh(cs), ei))

# what a hexadecimal integer word matches: the prose's range, and the value
# of its digits after the prefix in base 16
