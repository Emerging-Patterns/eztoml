# LArr
def fz.x.arr(
  +sp: Bool,
  +nl: Bool,
  +hash: Bool,
  +end: Bool,
  +st: T.St,
  +cc: Char,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.arr.go(sp, nl, hash, end, st, cc), b0, bs, rr):
  match sp:
    case True{}:
      h
    case False{}:
      match nl:
        case True{}:
          h
        case False{}:
          match hash:
            case True{}:
              match st:
                case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
                  h
            case False{}:
              match end:
                case True{}:
                  fz.aclose(st, b0, bs, rr, h)
                case False{}:
                  match st:
                    case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
                      h

