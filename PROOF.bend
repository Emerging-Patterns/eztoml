    U32.is_lt(aa, bb), Nat.is_lt(U32.to_nat(aa), U32.to_nat(bb)), u.lt(aa, bb)), hh)

# a digit below ten times a base and a carry below the base is below ten
# times the base
def n1.rs.bd(
  +rx: Laws.ARadix,
  +dd: U32,
  +cc: U32,
