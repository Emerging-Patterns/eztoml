# a string's character
def fz.x.strch(
  +bad: Bool,
  +st: T.St,
  +cc: Char,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.str.char.go(bad, st, cc), b0, bs, rr):
  match bad:
    case True{}:
      fz.err(st, "invalid control", b0, bs, rr, h)
    case False{}:
      match st:
        case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
          h

# a backslash in a basic string
def fz.x.strbs(
  +bsl: Bool,
  +multi: Bool,
  +st: T.St,
  +cc: Char,
  +kind: T.QKind,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.str.bs(bsl, multi, st, cc, kind), b0, bs, rr):
  match bsl:
    case True{}:
      match st:
        case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
          h
    case False{}:
      fz.x.strch(T.str.bad(Char.to_u32(cc), multi), st, cc, b0, bs, rr, h)

# LStr
def fz.x.strgo(
  +quote: Bool,
  +multi: Bool,
  +basic: Bool,
  +st: T.St,
  +cc: Char,
  +kind: T.QKind,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.str.go(quote, multi, basic, st, cc, kind), b0, bs, rr):
  match quote:
    case True{}:
      match multi:
        case True{}:
          match st:
            case T.St{_bd, _rw, _hs, _he, _pt, _bf, _lx, _bk, _qk, _sk, _hd, _un, _lf, _at, _ld}:
              h
        case False{}:
          fz.sfin(st, b0, bs, rr, h)
    case False{}:
      match basic:
        case True{}:
          fz.x.strbs(Char.is_eq(cc, '\\'), multi, st, cc, kind, b0, bs, rr, h)
        case False{}:
          fz.x.strch(T.str.bad(Char.to_u32(cc), multi), st, cc, b0, bs, rr, h)

