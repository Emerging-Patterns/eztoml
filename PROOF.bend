) -> T.St:
  sip.S(bd, rw, hs, he, pt, bf, T.LKeyE{}, bk, T.QBasic{}, sk, un, lf, at)

# the mode r1.keb.l reads its text from
def r1.keb.lM(
  +mb: Bool,
  +mt: Bool,
  +mn: Bool,
  +mf: Bool,
  +mr: Bool,
  +mu: Bool,
  +mw: Bool,
