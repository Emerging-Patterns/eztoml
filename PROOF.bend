    case False{}:
      fz.x.kbare(T.bare.at(cc), st, cc, b0, bs, rr, h)

# a key in an inline table
def fz.x.kq0(
  +qq: Bool,
  +st: T.St,
  +cc: Char,
  +b0: Char,
  +bs: String,
  +rr: List<&2, T.Val>,
  h: fz.K(st, b0, bs, rr)
) -> fz.K(T.lex.key.q(qq, st, cc), b0, bs, rr):
  match qq:
    case True{}:
