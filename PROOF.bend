) -> PP(T.doc.read(SCon{'\'', String.append(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})})},
  T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)})):
  %k3.hlopen(dt, rw, hs, he, ps, bk, qk, un, lf, ab) : PP(T.doc.read(String.append(name, SCon{'\'',
    String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})}), _))
  kx.tr( T.doc.read(String.append(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})}),
    T.MScan{k3.l(True{}, rw, hs, he, k3.ps0(dt, ps),
    [], ab, bk, un, lf, [])}), T.doc.read(SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})},
      T.MScan{k3.l(True{}, rw, hs, he, k3.ps0(dt, ps), [], ab, bk,
    un, lf, rev.onto(name, []))}), PP,
    k3.l.body(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})}, True{}, rw, hs, he, k3.ps0(dt,
      ps), [], ab, bk, un, lf, [], el),
    kx.hfin(name, rev.onto(name, []), k3.nm(name), gs, cl, rw, hs, he, k3.ps0(dt, ps), bk, T.QLit{}, un, lf, ab, rest,
      PP,
      ih))

# a header segment spelled any way toml.abnf allows, its blank space and a
# dot or the bracket
def kx.hseg(
  sg: Laws.KSeg,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  eo: {Laws.k3.seg.ok(sg) == True{} : Bool},
  ih: kx.HT(cl, rw, hs, he, Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), ab, rest, PP)
) -> PP(T.doc.read(Laws.k3.seg.text(sg, String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})), T.MScan{k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)})):
  match sg:
    case Laws.KsBare{name}:
      match name:
        case SNil{}:
          Eq.bit.absurd(&1, PP(T.doc.read(String.append(SNil{}, String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})),
            T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)})), eo)
        case SCon{hh, +tt}:
          match hh:
            case Chr{+xx}:
              kx.hbseg(xx, tt, gs, cl, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, PP, eo, ih)
    case Laws.KsBasic{+pl}:
      kx.hqseg(pl, gs, cl, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, PP, eo, ih)
    case Laws.KsLit{+name}:
      kx.hlseg(name, gs, cl, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, PP, eo, ih)

# a header's segments, then blank space and the bracket: the rest is read
# with every segment pushed onto parts, newest first
def kx.hkeys(
  ds: List<&2, Laws.KDot>,
  +last: Laws.KSeg,
  +g9: List<&2, Bool>,
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +eo: {Laws.k3.dk.ok(ds, last) == True{} : Bool},
  ih: kx.HT(True{}, rw, hs, he, k3.acc(ds, last, dt, ps), ab, rest, PP)
) -> PP(T.doc.read(Laws.k3.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', rest})), T.MScan{k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)})):
  match ds:
    case []:
      kx.hseg(last, g9, True{}, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, PP, eo, ih)
    case Laws.KDot{+sg, g1, +g2} <> +dr:
      kx.hseg(sg, g1, False{}, dt, rw, hs, he, ps, bk, qk, un, lf, ab, String.append(Laws.gap(g2),
        Laws.k3.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']', rest}))), PP, Eq.and.left(Laws.k3.seg.ok(sg),
        Laws.k3.dk.ok(dr, last), eo), +b2 => +q2 => +u2 => +l2 =>
        %k3.hdgap(g2, Laws.k3.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']', rest})), rw, hs, he,
          Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), b2, q2, u2, l2, ab) : PP(_)
        kx.hkeys(dr, last, g9, True{}, rw, hs, he, Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), b2, q2, u2, l2, ab, rest,
          PP,
          Eq.and.right(Laws.k3.seg.ok(sg), Laws.k3.dk.ok(dr, last), eo), ih))

# WP-A: own and the walk. The walk never reads a string's characters, only
# names and kinds, so reading every span out before a walk or after it gives
# the same rows: own.rows of what a walk returns is what the walk returns on
# own.rows of what it was given, a value to put read out as own.rows reads it
# in a pair (ow.v). The lookups (rows.find, rows.look, look.last) and
# rows.repl each commute with own, and so do the frames a walk keeps.

# a value as own.rows reads it where it is a pair's: every span read out
def ow.v(vv: T.Val) -> T.Val:
  match vv:
    case T.VSpan{src, +kk}:
      T.VStr{T.span.str(src, kk, U32.is_zero(kk))}
    case T.VArr{items}:
      T.VArr{Laws.own.rows(items)}
    case T.VInl{rows}:
      T.VInl{Laws.own.rows(rows)}
    case T.VHead{path, rows}:
      T.VHead{path, Laws.own.rows(rows)}
    case T.VAot{path, rows}:
      T.VAot{path, Laws.own.rows(rows)}
    case T.VAots{path, elems}:
      T.VAots{path, Laws.own.rows(elems)}
    case other:
      other

# a pair at the head of rows is read with its value read out
def ow.pair(
  +nn: String,
  vv: T.Val,
  +tt: List<&2, T.Val>
) -> {Laws.own.rows(T.VPair{nn, vv} <> tt) == T.VPair{nn, ow.v(vv)} <> Laws.own.rows(tt) : List<&2, T.Val>}:
  match vv:
    case T.VStr{_a0}:
      {==}
    case T.VSpan{_a0, _a1}:
      {==}
    case T.VInt{_a0, _a1}:
      {==}
    case T.VFlo{_a0, _a1}:
      {==}
    case T.VBool{_a0}:
      {==}
    case T.VWhen{_a0}:
      {==}
    case T.VArr{_a0}:
      {==}
    case T.VInl{_a0}:
      {==}
    case T.VHead{_a0, _a1}:
      {==}
    case T.VAot{_a0, _a1}:
      {==}
    case T.VAots{_a0, _a1}:
      {==}
    case T.VPair{_a0, _a1}:
      {==}

# a lookup's hit, read out
def ow.hit(hh: T.Hit) -> T.Hit:
  match hh:
    case T.Found{vv}:
      T.Found{ow.v(vv)}
    case T.Miss{}:
      T.Miss{}

# one pair of a lookup
def ow.fstep(
  eq: Bool,
  +vv: T.Val,
  +tt: List<&2, T.Val>,
  +name: String,
  ih: {T.rows.find(Laws.own.rows(tt), name) == ow.hit(T.rows.find(tt, name)) : T.Hit}
) -> {T.find.step(eq, ow.v(vv), _u => T.rows.find(Laws.own.rows(tt), name)) == ow.hit(T.find.step(eq, vv,
  _u => T.rows.find(tt, name))) : T.Hit}:
  match eq:
    case True{}:
      {==}
    case False{}:
      ih

# get reads out as own reads the rows
def ow.find(
  vs: List<&2, T.Val>,
  +name: String
) -> {T.rows.find(Laws.own.rows(vs), name) == ow.hit(T.rows.find(vs, name)) : T.Hit}:
  match vs:
    case []:
      {==}
    case +xx <> +tt:
      match xx:
        case T.VStr{_a0}:
          ow.find(tt, name)
        case T.VSpan{_a0, _a1}:
          ow.find(tt, name)
        case T.VInt{_a0, _a1}:
          ow.find(tt, name)
        case T.VFlo{_a0, _a1}:
          ow.find(tt, name)
        case T.VBool{_a0}:
          ow.find(tt, name)
        case T.VWhen{_a0}:
          ow.find(tt, name)
        case T.VArr{_a0}:
          ow.find(tt, name)
        case T.VInl{_a0}:
          ow.find(tt, name)
        case T.VHead{_a0, _a1}:
          ow.find(tt, name)
        case T.VAot{_a0, _a1}:
          ow.find(tt, name)
        case T.VAots{_a0, _a1}:
          ow.find(tt, name)
        case T.VPair{+nn, +vv}:
          %Equal.sym(List<&2, T.Val>, Laws.own.rows(T.VPair{nn, vv} <> tt), T.VPair{nn, ow.v(vv)} <> Laws.own.rows(tt),
            ow.pair(nn, vv, tt)) : {T.rows.find(_, name) == ow.hit(T.rows.find(T.VPair{nn, vv} <> tt, name)) : T.Hit}
          ow.fstep(T.str.eq(nn, name), vv, tt, name, ow.find(tt, name))

# a lookup's answer, read out
def ow.look(lk: T.Look) -> T.Look:
  match lk:
    case T.KHead{path, rows}:
      T.KHead{path, Laws.own.rows(rows)}
    case T.KAots{path, elems}:
      T.KAots{path, Laws.own.rows(elems)}
    case other:
      other

# what a value refers to, read out
def ow.lookof(vv: T.Val) -> {T.look.of(ow.v(vv)) == ow.look(T.look.of(vv)) : T.Look}:
  match vv:
    case T.VStr{_a0}:
      {==}
    case T.VSpan{_a0, _a1}:
      {==}
    case T.VInt{_a0, _a1}:
      {==}
    case T.VFlo{_a0, _a1}:
      {==}
    case T.VBool{_a0}:
      {==}
    case T.VWhen{_a0}:
      {==}
    case T.VArr{_a0}:
      {==}
    case T.VInl{_a0}:
      {==}
    case T.VHead{_a0, _a1}:
      {==}
    case T.VAot{_a0, _a1}:
      {==}
    case T.VAots{_a0, _a1}:
      {==}
    case T.VPair{_a0, _a1}:
      {==}

# one pair of rows.look
def ow.lstep(
  eq: Bool,
  +vv: T.Val,
  +tt: List<&2, T.Val>,
  +name: String,
  ih: {T.rows.look(Laws.own.rows(tt), name) == ow.look(T.rows.look(tt, name)) : T.Look}
) -> {T.look.step(eq, ow.v(vv), _u => T.rows.look(Laws.own.rows(tt), name)) == ow.look(T.look.step(eq, vv,
  _u => T.rows.look(tt, name))) : T.Look}:
  match eq:
    case True{}:
      ow.lookof(vv)
    case False{}:
      ih

# rows.look reads out as own reads the rows
def ow.rlook(
  vs: List<&2, T.Val>,
  +name: String
) -> {T.rows.look(Laws.own.rows(vs), name) == ow.look(T.rows.look(vs, name)) : T.Look}:
  match vs:
    case []:
      {==}
    case +xx <> +tt:
      match xx:
        case T.VStr{_a0}:
          ow.rlook(tt, name)
        case T.VSpan{_a0, _a1}:
          ow.rlook(tt, name)
        case T.VInt{_a0, _a1}:
          ow.rlook(tt, name)
        case T.VFlo{_a0, _a1}:
          ow.rlook(tt, name)
        case T.VBool{_a0}:
          ow.rlook(tt, name)
        case T.VWhen{_a0}:
          ow.rlook(tt, name)
        case T.VArr{_a0}:
          ow.rlook(tt, name)
        case T.VInl{_a0}:
          ow.rlook(tt, name)
        case T.VHead{_a0, _a1}:
          ow.rlook(tt, name)
        case T.VAot{_a0, _a1}:
          ow.rlook(tt, name)
        case T.VAots{_a0, _a1}:
          ow.rlook(tt, name)
        case T.VPair{+nn, +vv}:
          %Equal.sym(List<&2, T.Val>, Laws.own.rows(T.VPair{nn, vv} <> tt), T.VPair{nn, ow.v(vv)} <> Laws.own.rows(tt),
            ow.pair(nn, vv, tt)) : {T.rows.look(_, name) == ow.look(T.rows.look(T.VPair{nn, vv} <> tt, name)) : T.Look}
          ow.lstep(T.str.eq(nn, name), vv, tt, name, ow.rlook(tt, name))

# one pair of rows.repl
def ow.rstep(
  eq: Bool,
  +nn: String,
  +old: T.Val,
  +vv: T.Val,
  +tt: List<&2, T.Val>,
  +name: String,
  ih: {Laws.own.rows(T.rows.repl(tt, name, vv)) == T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)) : List<&2, T.Val>}
) -> {Laws.own.rows(T.rows.repl.step(eq, nn, old, vv, _u => T.rows.repl(tt, name, vv))) == T.rows.repl.step(eq, nn,
  ow.v(old), ow.v(vv), _u => T.rows.repl(Laws.own.rows(tt), name, ow.v(vv))) : List<&2, T.Val>}:
  match eq:
    case True{}:
      %Equal.sym(List<&2, T.Val>, Laws.own.rows(T.VPair{nn, vv} <> T.rows.repl(tt, name, vv)), T.VPair{nn, ow.v(vv)} <>
        Laws.own.rows(T.rows.repl(tt, name, vv)), ow.pair(nn, vv, T.rows.repl(tt, name, vv))) : {_ == T.VPair{nn,
        ow.v(vv)} <> T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)) : List<&2, T.Val>}
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => T.VPair{nn, ow.v(vv)} <> zs, Laws.own.rows(T.rows.repl(tt,
        name,
        vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ih)
    case False{}:
      %Equal.sym(List<&2, T.Val>, Laws.own.rows(T.VPair{nn, old} <> T.rows.repl(tt, name, vv)), T.VPair{nn,
        ow.v(old)} <>
        Laws.own.rows(T.rows.repl(tt, name, vv)), ow.pair(nn, old, T.rows.repl(tt, name, vv))) : {_ == T.VPair{nn,
        ow.v(old)} <> T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)) : List<&2, T.Val>}
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => T.VPair{nn, ow.v(old)} <> zs, Laws.own.rows(T.rows.repl(tt,
        name,
        vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ih)

# rows.repl reads out as own reads the rows and the value
def ow.repl(
  vs: List<&2, T.Val>,
  +name: String,
  +vv: T.Val
) -> {Laws.own.rows(T.rows.repl(vs, name, vv)) == T.rows.repl(Laws.own.rows(vs), name, ow.v(vv)) : List<&2, T.Val>}:
  match vs:
    case []:
      {==}
    case +xx <> +tt:
      match xx:
        case T.VStr{+a0}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VStr{a0}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VSpan{+a0, +a1}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VSpan{a0, a1}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VInt{+a0, +a1}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VInt{a0, a1}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VFlo{+a0, +a1}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VFlo{a0, a1}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VBool{+a0}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VBool{a0}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VWhen{+a0}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VWhen{a0}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VArr{+a0}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VArr{a0}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VInl{+a0}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VInl{a0}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VHead{+a0, +a1}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VHead{a0, a1}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VAot{+a0, +a1}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VAot{a0, a1}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VAots{+a0, +a1}:
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VAots{a0, a1}) <> zs,
            Laws.own.rows(T.rows.repl(tt, name,
            vv)), T.rows.repl(Laws.own.rows(tt), name, ow.v(vv)), ow.repl(tt, name, vv))
        case T.VPair{+nn, +old}:
          %Equal.sym(List<&2, T.Val>, Laws.own.rows(T.VPair{nn, old} <> tt), T.VPair{nn,
            ow.v(old)} <> Laws.own.rows(tt),
            ow.pair(nn, old, tt)) : {Laws.own.rows(T.rows.repl(T.VPair{nn, old} <> tt, name, vv)) == T.rows.repl(_,
              name,
            ow.v(vv)) : List<&2, T.Val>}
          ow.rstep(T.str.eq(nn, name), nn, old, vv, tt, name, ow.repl(tt, name, vv))

# the newest element found, read out
def ow.last(ll: T.Last) -> T.Last:
  match ll:
    case T.LastSome{path, pre, rows}:
      T.LastSome{path, Laws.own.rows(pre), Laws.own.rows(rows)}
    case T.LastNo{why}:
      T.LastNo{why}

# look.last reads out as own reads the elements
def ow.llast(
  elems: List<&2, T.Val>,
  +path: String
) -> {T.look.last(Laws.own.rows(elems), path) == ow.last(T.look.last(elems, path)) : T.Last}:
  match elems:
    case []:
      {==}
    case xx <> +tt:
      match xx:
        case T.VStr{_a0}:
          {==}
        case T.VSpan{_a0, _a1}:
          {==}
        case T.VInt{_a0, _a1}:
          {==}
        case T.VFlo{_a0, _a1}:
          {==}
        case T.VBool{_a0}:
          {==}
        case T.VWhen{_a0}:
          {==}
        case T.VArr{_a0}:
          {==}
        case T.VInl{_a0}:
          {==}
        case T.VHead{_a0, _a1}:
          {==}
        case T.VAot{_a0, _a1}:
          {==}
        case T.VAots{_a0, _a1}:
          {==}
        case T.VPair{+nn, +vv}:
          %Equal.sym(List<&2, T.Val>, Laws.own.rows(T.VPair{nn, vv} <> tt), T.VPair{nn, ow.v(vv)} <> Laws.own.rows(tt),
            ow.pair(nn, vv, tt)) : {T.look.last(_, path) == ow.last(T.look.last(T.VPair{nn, vv} <> tt, path)) : T.Last}
          {==}

# a frame, its parent rows read out
def ow.fr(fr: T.Fr) -> T.Fr:
  match fr:
    case T.FrNew{name, parent, path}:
      T.FrNew{name, Laws.own.rows(parent), path}
    case T.FrRep{name, parent, path}:
      T.FrRep{name, Laws.own.rows(parent), path}
    case T.FrAot{name, parent, pre, path}:
      T.FrAot{name, Laws.own.rows(parent), Laws.own.rows(pre), path}

# every frame read out
def ow.frs(frs: List<&2, T.Fr>) -> List<&2, T.Fr>:
  match frs:
    case []:
      []
    case fr <> rest:
      ow.fr(fr) <> ow.frs(rest)

# a walk's job, its value read out
def ow.job(job: T.Job) -> T.Job:
  match job:
    case T.JPut{vv}:
      T.JPut{ow.v(vv)}
    case T.JDef{}:
      T.JDef{}
    case T.JAot{}:
      T.JAot{}

# a walk's state read out
def ow.tw(tw: T.Tw) -> T.Tw:
  match tw:
    case T.Tw{vs, job, stack, bad, pre, heads, inl}:
      T.Tw{Laws.own.rows(vs), ow.job(job), ow.frs(stack), bad, pre, heads, inl}

# a walk's end read out
def ow.end(en: T.End) -> T.End:
  match en:
    case T.End{vs, bad, heads}:
      T.End{Laws.own.rows(vs), bad, heads}

# a frame put back reads out as own reads it and the child
def ow.wrap(
  fr: T.Fr,
  +child: List<&2, T.Val>
) -> {Laws.own.rows(T.tree.wrap(fr, child)) == T.tree.wrap(ow.fr(fr), Laws.own.rows(child)) : List<&2, T.Val>}:
  match fr:
    case T.FrNew{_nm, _pa, _pt}:
      {==}
    case T.FrRep{+nm, +pa, +pt}:
      ow.repl(pa, nm, T.VHead{pt, child})
    case T.FrAot{+nm, +pa, +pre, +pt}:
      ow.repl(pa, nm, T.VAots{pt, T.VAot{pt, child} <> pre})

# walking the frames back reads out as own reads them
def ow.rebuild(
  stack: List<&2, T.Fr>,
  +vs: List<&2, T.Val>,
  +bad: String,
  +heads: List<&2, String>
) -> {ow.end(T.tree.rebuild(stack, vs, bad, heads)) == T.tree.rebuild(ow.frs(stack), Laws.own.rows(vs), bad, heads)
  : T.End}:
  match stack:
    case []:
      {==}
    case +fr <> +rest:
      %ow.wrap(fr, vs) : {ow.end(T.tree.rebuild(rest, T.tree.wrap(fr, vs), bad,
        heads)) == T.tree.rebuild(ow.frs(rest), _,
        bad, heads) : T.End}
      ow.rebuild(rest, T.tree.wrap(fr, vs), bad, heads)

# a key that is found or not, at the end of a value's walk
def ow.put(
  hit: T.Hit,
  +name: String,
  +vs: List<&2, T.Val>,
  +vv: T.Val,
  +stack: List<&2, T.Fr>,
  +bad: String,
  +heads: List<&2, String>
) -> {ow.end(T.tree.leaf.put(hit, name, vs, vv, stack, bad, heads)) == T.tree.leaf.put(ow.hit(hit), name,
  Laws.own.rows(vs), ow.v(vv), ow.frs(stack), bad, heads) : T.End}:
  match hit:
    case T.Found{_v}:
      ow.rebuild(stack, vs, T.err.first(bad, "duplicate key"), heads)
    case T.Miss{}:
      %ow.pair(name, vv, vs) : {ow.end(T.tree.rebuild(stack, T.VPair{name, vv} <> vs, bad, heads))
        == T.tree.rebuild(ow.frs(stack), _, bad, heads) : T.End}
      ow.rebuild(stack, T.VPair{name, vv} <> vs, bad, heads)

# a header on a table that exists
def ow.dhead(
  seen: Bool,
  +name: String,
  +vs: List<&2, T.Val>,
  +rows: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +bad: String,
  +path: String,
  +heads: List<&2, String>
) -> {ow.end(T.tree.leaf.def.head(seen, name, vs, rows, stack, bad, path, heads)) == T.tree.leaf.def.head(seen, name,
  Laws.own.rows(vs), Laws.own.rows(rows), ow.frs(stack), bad, path, heads) : T.End}:
  match seen:
    case True{}:
      ow.rebuild(stack, vs, T.err.first(bad, "duplicate table"), heads)
    case False{}:
      %ow.repl(vs, name, T.VHead{path, rows}) : {ow.end(T.tree.rebuild(stack, T.rows.repl(vs, name, T.VHead{path,
        rows}),
        bad, T.heads.by.head(path) <> heads)) == T.tree.rebuild(ow.frs(stack), _, bad, T.heads.by.head(path) <> heads)
        : T.End}
      ow.rebuild(stack, T.rows.repl(vs, name, T.VHead{path, rows}), bad, T.heads.by.head(path) <> heads)

# a [table] header's last name
def ow.dhit(
  lk: T.Look,
  +name: String,
  +vs: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +bad: String,
  +path: String,
  +heads: List<&2, String>
) -> {ow.end(T.tree.leaf.def.hit(lk, name, vs, stack, bad, path, heads)) == T.tree.leaf.def.hit(ow.look(lk), name,
  Laws.own.rows(vs), ow.frs(stack), bad, path, heads) : T.End}:
  match lk:
    case T.KMiss{}:
      ow.rebuild(stack, T.VPair{name, T.VHead{path, []}} <> vs, bad, T.heads.by.head(path) <> heads)
    case T.KHead{_p, +rows}:
      ow.dhead(T.heads.has(heads, path), name, vs, rows, stack, bad, path, heads)
    case T.KInl{}:
      ow.rebuild(stack, vs, T.err.first(bad, "inline table is closed"), heads)
    case T.KAots{_p, _e}:
      ow.rebuild(stack, vs, T.err.first(bad, "not a table"), heads)
    case T.KNo{+why}:
      ow.rebuild(stack, vs, T.err.first(bad, why), heads)

# an [[array]] header's last name
def ow.ahit(
  lk: T.Look,
  +name: String,
  +vs: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +bad: String,
  +path: String,
  +heads: List<&2, String>
) -> {ow.end(T.tree.leaf.aot.hit(lk, name, vs, stack, bad, path, heads)) == T.tree.leaf.aot.hit(ow.look(lk), name,
  Laws.own.rows(vs), ow.frs(stack), bad, path, heads) : T.End}:
  match lk:
    case T.KMiss{}:
      ow.rebuild(stack, T.VPair{name, T.VAots{path, [T.VAot{path, []}]}} <> vs, bad, heads)
    case T.KAots{_p, +elems}:
      %ow.repl(vs, name, T.VAots{path, T.VAot{path, []} <> elems}) : {ow.end(T.tree.rebuild(stack, T.rows.repl(vs, name,
        T.VAots{path, T.VAot{path, []} <> elems}), bad, T.heads.drop(heads, String.append(path,
          ".")))) == T.tree.rebuild(
        ow.frs(stack), _, bad, T.heads.drop(heads, String.append(path, "."))) : T.End}
      ow.rebuild(stack, T.rows.repl(vs, name, T.VAots{path, T.VAot{path, []} <> elems}), bad, T.heads.drop(heads,
        String.append(path, ".")))
    case T.KHead{_p, _r}:
      ow.rebuild(stack, vs, T.err.first(bad, "not a table"), heads)
    case T.KInl{}:
      ow.rebuild(stack, vs, T.err.first(bad, "inline table is closed"), heads)
    case T.KNo{+why}:
      ow.rebuild(stack, vs, T.err.first(bad, why), heads)

# the key at the end of a walk, with the walk still well
def ow.ljob(
  job: T.Job,
  +name: String,
  +vs: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +bad: String,
  +pre: String,
  +heads: List<&2, String>
) -> {ow.end(T.tree.leaf.job(job, name, vs, stack, bad, pre, heads)) == T.tree.leaf.job(ow.job(job), name,
  Laws.own.rows(vs), ow.frs(stack), bad, pre, heads) : T.End}:
  match job:
    case T.JPut{+vv}:
      %Equal.sym(T.Hit, T.rows.find(Laws.own.rows(vs), name), ow.hit(T.rows.find(vs, name)), ow.find(vs,
        name)) : {ow.end(T.tree.leaf.put(T.get(vs, name), name, vs, vv, stack, bad, heads))
        == T.tree.leaf.put(_, name, Laws.own.rows(vs), ow.v(vv), ow.frs(stack), bad, heads) : T.End}
      ow.put(T.get(vs, name), name, vs, vv, stack, bad, heads)
    case T.JDef{}:
      %Equal.sym(T.Look, T.rows.look(Laws.own.rows(vs), name), ow.look(T.rows.look(vs, name)), ow.rlook(vs, name))
        : {ow.end(T.tree.leaf.def.hit(T.rows.look(vs, name), name, vs, stack, bad, T.tree.pre(pre,
        name), heads)) == T.tree.leaf.def.hit(_, name, Laws.own.rows(vs), ow.frs(stack), bad, T.tree.pre(pre, name),
        heads) : T.End}
      ow.dhit(T.rows.look(vs, name), name, vs, stack, bad, T.tree.pre(pre, name), heads)
    case T.JAot{}:
      %Equal.sym(T.Look, T.rows.look(Laws.own.rows(vs), name), ow.look(T.rows.look(vs, name)), ow.rlook(vs, name))
        : {ow.end(T.tree.leaf.aot.hit(T.rows.look(vs, name), name, vs, stack, bad, T.tree.pre(pre,
        name), heads)) == T.tree.leaf.aot.hit(_, name, Laws.own.rows(vs), ow.frs(stack), bad, T.tree.pre(pre, name),
        heads) : T.End}
      ow.ahit(T.rows.look(vs, name), name, vs, stack, bad, T.tree.pre(pre, name), heads)

# the key at the end of a walk
def ow.lbad(
  ok: Bool,
  +name: String,
  +vs: List<&2, T.Val>,
  +job: T.Job,
  +stack: List<&2, T.Fr>,
  +bad: String,
  +pre: String,
  +heads: List<&2, String>
) -> {ow.end(T.tree.leaf.bad(ok, name, vs, job, stack, bad, pre, heads)) == T.tree.leaf.bad(ok, name,
  Laws.own.rows(vs), ow.job(job), ow.frs(stack), bad, pre, heads) : T.End}:
  match ok:
    case False{}:
      ow.rebuild(stack, vs, bad, heads)
    case True{}:
      ow.ljob(job, name, vs, stack, bad, pre, heads)

# the key at the end of a walk
def ow.leaf(+name: String, tw: T.Tw) -> {ow.end(T.tree.leaf(name, tw)) == T.tree.leaf(name, ow.tw(tw)) : T.End}:
  match tw:
    case T.Tw{+vs, +job, +stack, +bad, +pre, +heads, _inl}:
      ow.lbad(String.is_empty(bad), name, vs, job, stack, bad, pre, heads)

# the step into the newest element of an array of tables
def ow.saots(
  last: T.Last,
  +name: String,
  +vs: List<&2, T.Val>,
  +job: T.Job,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool,
  +path: String
) -> {ow.tw(T.tree.sub.aots(last, name, vs, job, stack, pre, heads, inl, path)) == T.tree.sub.aots(ow.last(last), name,
  Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl, path) : T.Tw}:
  match last:
    case T.LastSome{_p, _prefix, _rows}:
      {==}
    case T.LastNo{_why}:
      {==}

# the step into an array of tables
def ow.sarr(
  dot: Bool,
  +path: String,
  +elems: List<&2, T.Val>,
  +name: String,
  +vs: List<&2, T.Val>,
  +job: T.Job,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool
) -> {ow.tw(T.tree.sub.arr(dot, path, elems, name, vs, job, stack, pre, heads, inl)) == T.tree.sub.arr(dot, path,
  Laws.own.rows(elems), name, Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl) : T.Tw}:
  match dot:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(T.Last, T.look.last(Laws.own.rows(elems), path), ow.last(T.look.last(elems, path)), ow.llast(elems,
        path)) : {ow.tw(T.tree.sub.aots(T.look.last(elems, path), name, vs, job, stack, pre, heads, inl,
        path)) == T.tree.sub.aots(_, name, Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl, path) : T.Tw}
      ow.saots(T.look.last(elems, path), name, vs, job, stack, pre, heads, inl, path)

# the step into a table, by the walk's job and whether it is a prefix
def ow.shgo(
  job: T.Job,
  mark: Bool,
  shut: Bool,
  +path: String,
  +rows: List<&2, T.Val>,
  +name: String,
  +vs: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool
) -> {ow.tw(T.tree.sub.head.go(shut, path, rows, name, vs, job, stack, pre, heads, inl, mark)) == T.tree.sub.head.go(
  shut, path, Laws.own.rows(rows), name, Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl, mark) : T.Tw}:
  match job mark shut:
    case T.JPut{+vv} True{} True{}:
      {==}
    case T.JPut{+vv} True{} False{}:
      {==}
    case T.JPut{+vv} False{} True{}:
      {==}
    case T.JPut{+vv} False{} False{}:
      {==}
    case T.JDef{} True{} True{}:
      {==}
    case T.JDef{} True{} False{}:
      {==}
    case T.JDef{} False{} True{}:
      {==}
    case T.JDef{} False{} False{}:
      {==}
    case T.JAot{} True{} True{}:
      {==}
    case T.JAot{} True{} False{}:
      {==}
    case T.JAot{} False{} True{}:
      {==}
    case T.JAot{} False{} False{}:
      {==}

# the step into a table
def ow.shead(
  job: T.Job,
  mark: Bool,
  +path: String,
  +rows: List<&2, T.Val>,
  +name: String,
  +vs: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool
) -> {ow.tw(T.tree.sub.head(T.tree.sub.dot(T.tree.sub.job(mark, job)), path, rows, name, vs, job, stack, pre, heads,
  inl, mark)) == T.tree.sub.head(T.tree.sub.dot(T.tree.sub.job(mark, ow.job(job))), path, Laws.own.rows(rows), name,
  Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl, mark) : T.Tw}:
  match job mark:
    case T.JPut{+vv} True{}:
      ow.shgo(T.JPut{vv}, True{}, T.heads.head(heads, T.tree.pre(pre, name)), path, rows, name, vs, stack, pre, heads,
        inl)
    case T.JPut{+vv} False{}:
      ow.shgo(T.JPut{vv}, False{}, False{}, path, rows, name, vs, stack, pre, heads, inl)
    case T.JDef{} True{}:
      ow.shgo(T.JDef{}, True{}, False{}, path, rows, name, vs, stack, pre, heads, inl)
    case T.JDef{} False{}:
      ow.shgo(T.JDef{}, False{}, False{}, path, rows, name, vs, stack, pre, heads, inl)
    case T.JAot{} True{}:
      ow.shgo(T.JAot{}, True{}, False{}, path, rows, name, vs, stack, pre, heads, inl)
    case T.JAot{} False{}:
      ow.shgo(T.JAot{}, False{}, False{}, path, rows, name, vs, stack, pre, heads, inl)

# the step into an array of tables, by the walk's job and whether it is a
# prefix
def ow.sdot(
  job: T.Job,
  mark: Bool,
  +path: String,
  +elems: List<&2, T.Val>,
  +name: String,
  +vs: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool
) -> {ow.tw(T.tree.sub.arr(T.tree.sub.dot(T.tree.sub.job(mark, job)), path, elems, name, vs, job, stack, pre, heads,
  inl)) == T.tree.sub.arr(T.tree.sub.dot(T.tree.sub.job(mark, ow.job(job))), path, Laws.own.rows(elems), name,
  Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl) : T.Tw}:
  match job mark:
    case T.JPut{+vv} True{}:
      ow.sarr(True{}, path, elems, name, vs, T.JPut{vv}, stack, pre, heads, inl)
    case T.JPut{+vv} False{}:
      ow.sarr(False{}, path, elems, name, vs, T.JPut{vv}, stack, pre, heads, inl)
    case T.JDef{} True{}:
      ow.sarr(False{}, path, elems, name, vs, T.JDef{}, stack, pre, heads, inl)
    case T.JDef{} False{}:
      ow.sarr(False{}, path, elems, name, vs, T.JDef{}, stack, pre, heads, inl)
    case T.JAot{} True{}:
      ow.sarr(False{}, path, elems, name, vs, T.JAot{}, stack, pre, heads, inl)
    case T.JAot{} False{}:
      ow.sarr(False{}, path, elems, name, vs, T.JAot{}, stack, pre, heads, inl)

# one step of a walk, by what the name refers to
def ow.slook(
  lk: T.Look,
  job: T.Job,
  mark: Bool,
  +name: String,
  +vs: List<&2, T.Val>,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool
) -> {ow.tw(T.tree.sub.look(lk, name, vs, job, stack, pre, heads, inl, mark)) == T.tree.sub.look(ow.look(lk), name,
  Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl, mark) : T.Tw}:
  match lk:
    case T.KMiss{}:
      match job mark:
        case T.JPut{+vv} True{}:
          {==}
        case T.JPut{+vv} False{}:
          {==}
        case T.JDef{} True{}:
          {==}
        case T.JDef{} False{}:
          {==}
        case T.JAot{} True{}:
          {==}
        case T.JAot{} False{}:
          {==}
    case T.KHead{+path, +rows}:
      ow.shead(job, mark, path, rows, name, vs, stack, pre, heads, inl)
    case T.KInl{}:
      {==}
    case T.KAots{+path, +elems}:
      ow.sdot(job, mark, path, elems, name, vs, stack, pre, heads, inl)
    case T.KNo{_why}:
      {==}

# one step of a walk, when the walk is still well
def ow.sbad(
  ok: Bool,
  +name: String,
  +vs: List<&2, T.Val>,
  +job: T.Job,
  +stack: List<&2, T.Fr>,
  +bad: String,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool,
  +mark: Bool
) -> {ow.tw(T.tree.sub.bad(ok, name, vs, job, stack, bad, pre, heads, inl, mark)) == T.tree.sub.bad(ok, name,
  Laws.own.rows(vs), ow.job(job), ow.frs(stack), bad, pre, heads, inl, mark) : T.Tw}:
  match ok:
    case False{}:
      {==}
    case True{}:
      %Equal.sym(T.Look, T.rows.look(Laws.own.rows(vs), name), ow.look(T.rows.look(vs, name)), ow.rlook(vs, name))
        : {ow.tw(T.tree.sub.look(T.rows.look(vs, name), name, vs, job, stack, pre, heads, inl, mark))
        == T.tree.sub.look(_, name, Laws.own.rows(vs), ow.job(job), ow.frs(stack), pre, heads, inl, mark) : T.Tw}
      ow.slook(T.rows.look(vs, name), job, mark, name, vs, stack, pre, heads, inl)

# one step of a walk
def ow.sub(
  +name: String,
  tw: T.Tw,
  +mark: Bool
) -> {ow.tw(T.tree.sub(name, tw, mark)) == T.tree.sub(name, ow.tw(tw), mark) : T.Tw}:
  match tw:
    case T.Tw{+vs, +job, +stack, +bad, +pre, +heads, +inl}:
      ow.sbad(String.is_empty(bad), name, vs, job, stack, bad, pre, heads, inl, mark)

# LAW-like: own of a walk's end is the walk on own of its state
def ow.walk(
  path: List<&2, String>,
  +tw: T.Tw,
  +skip: U32
) -> {ow.end(T.tree.walk(path, tw, skip)) == T.tree.walk(path, ow.tw(tw), skip) : T.End}:
  match path:
    case []:
      match tw:
        case T.Tw{+vs, _job, +stack, +bad, _pre, +heads, _inl}:
          ow.rebuild(stack, vs, T.err.first(bad, "empty key"), heads)
    case +name <> +rest:
      match rest:
        case []:
          ow.leaf(name, tw)
        case +r1 <> +r2:
          %ow.sub(name, tw, U32.is_zero(skip)) : {ow.end(T.tree.walk(r1 <> r2, T.tree.sub(name, tw, U32.is_zero(skip)),
            T.path.dec(skip))) == T.tree.walk(r1 <> r2, _, T.path.dec(skip)) : T.End}
          ow.walk(r1 <> r2, T.tree.sub(name, tw, U32.is_zero(skip)), T.path.dec(skip))

# WP-A: a refused word read to its document. WP-V shows that a bare word
# word.val refuses leaves an error (vl.blift); with error_stays in place of
# fail_stays the same steps give the document itself: the first error, the
# word's reason when there was none, and the rows as they were (wr.*).

# the document a refused word leaves: the first error, and the rows sealed
def wr.D(+fx: Laws.Vf, +why: String) -> T.Doc:
  match fx:
    case Laws.Vf{bad, rows, _heads, _here, _parts, _back, _qkind, _stack, _uni, _left, _arrtab}:
      T.Doc{T.err.first(bad, why), T.rows.seal(rows)}

# the document read from a mode is dd
def wr.Q(+tt: String, +md: T.Mode, +dd: T.Doc) -> Type:
  {T.doc.read(tt, md) == dd : T.Doc}

# and so is one read from a mode equal to it
def wr.tr(
  +tt: String,
  +m1: T.Mode,
  +m2: T.Mode,
  +dd: T.Doc,
  +ee: {m1 == m2 : T.Mode},
  hh: wr.Q(tt, m2, dd)
) -> wr.Q(tt, m1, dd):
  Equal.trans(T.Doc, T.doc.read(tt, m1), T.doc.read(tt, m2), dd, Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md), m1,
    m2, ee), hh)

# a failed scanner reads to its error and rows
def wr.sink(
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +hb: {String.is_empty(bd) == False{} : Bool},
  +tt: String
) -> wr.Q(tt, T.MScan{T.St{bd, rw, hs, he, ps, [], T.LSink{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}}, T.Doc{bd,
  T.rows.seal(rw)}):
  Laws.error_stays(bd, rw, hs, he, ps, [], T.LSink{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}, hb, tt)

# a refused word's scanner, in the scan mode
def wr.bs(
  +fx: Laws.Vf,
  +why: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +tt: String
) -> wr.Q(tt, T.MScan{vl.err(fx, why)}, wr.D(fx, why)):
  match fx:
    case Laws.Vf{+bad, +rows, +heads, +here, +parts, +back, +qkind, +stack, +uni, +left, +arrtab}:
      wr.sink(T.err.first(bad, why), rows, heads, here, parts, back, qkind, stack, uni, left, arrtab, vl.ef(bad, why,
        hw),
        tt)

# a character after a carriage return, from a failed scanner
def wr.bcr.at(
  +lf: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf2: U32,
  +ab: Bool,
  +hb: {String.is_empty(bd) == False{} : Bool},
  +cc: Char,
  +tt: String
) -> wr.Q(tt, T.doc.cr(lf, T.St{bd, rw, hs, he, ps, [], T.LSink{}, bk, qk, sk, T.HNone{}, un, lf2, ab, False{}}, cc),
  T.Doc{bd, T.rows.seal(rw)}):
  match lf:
    case True{}:
      wr.sink(bd, rw, hs, he, ps, bk, qk, sk, un, lf2, ab, hb, tt)
    case False{}:
      %Equal.sym(Bool, String.is_empty(bd), False{}, hb) : wr.Q(tt, T.MScan{T.St{T.err.first.go(_, bd,
        "carriage return without line feed"), rw, hs, he, ps, [], T.LSink{}, bk, qk, sk, T.HNone{}, un, lf2, ab,
        False{}}}, T.Doc{bd, T.rows.seal(rw)})
      wr.sink(bd, rw, hs, he, ps, bk, qk, sk, un, lf2, ab, hb, tt)

# and after a carriage return
def wr.bcr(
  +fx: Laws.Vf,
  +why: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +tt: String
) -> wr.Q(tt, T.MCr{vl.err(fx, why)}, wr.D(fx, why)):
  match fx:
    case Laws.Vf{+bad, +rows, +heads, +here, +parts, +back, +qkind, +stack, +uni, +left, +arrtab}:
      match tt:
        case SNil{}:
          %Equal.sym(Bool, String.is_empty(T.err.first(bad, why)), False{}, vl.ef(bad, why, hw)) : wr.Q(SNil{},
            T.MScan{T.St{T.err.first.go(_, T.err.first(bad, why), "carriage return without line feed"), rows, heads,
            here, parts, [], T.LSink{}, back, qkind, stack, T.HNone{}, uni, left, arrtab, False{}}},
              T.Doc{T.err.first(bad,
            why), T.rows.seal(rows)})
          wr.sink(T.err.first(bad, why), rows, heads, here, parts, back, qkind, stack, uni, left, arrtab, vl.ef(bad,
            why,
            hw), SNil{})
        case SCon{+hh, +t2}:
          wr.bcr.at(Char.is_eq(hh, '\n'), T.err.first(bad, why), rows, heads, here, parts, back, qkind, stack, uni,
            left,
            arrtab, vl.ef(bad, why, hw), hh, t2)

# and in a mode a quote may open
def wr.bwrap(
  +fx: Laws.Vf,
  +why: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +tt: String
) -> wr.Q(tt, T.doc.wrap(vl.err(fx, why)), wr.D(fx, why)):
  match fx:
    case Laws.Vf{+bad, +rows, +heads, +here, +parts, +back, +qkind, +stack, +uni, +left, +arrtab}:
      wr.sink(T.err.first(bad, why), rows, heads, here, parts, back, qkind, stack, uni, left, arrtab, vl.ef(bad, why,
        hw),
        tt)

# the step on any character, from a state the fast step fails
def wr.bq(
  +dq: Bool,
  +sq: Bool,
  +cr: Bool,
  +st: T.St,
  +cc: Char,
  +fx: Laws.Vf,
  +why: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +tt: String,
  +ee: {T.read.fast(st, cc) == vl.err(fx, why) : T.St}
) -> wr.Q(tt, T.doc.scan.q(dq, sq, cr, st, cc), wr.D(fx, why)):
  match dq:
    case True{}:
      wr.tr(tt, T.doc.wrap(T.read.fast(st, cc)), T.doc.wrap(vl.err(fx, why)), wr.D(fx, why), Equal.cong(T.St, T.Mode,
        ss => T.doc.wrap(ss), T.read.fast(st, cc), vl.err(fx, why), ee), wr.bwrap(fx, why, hw, tt))
    case False{}:
      match sq:
        case True{}:
          wr.tr(tt, T.doc.wrap(T.read.fast(st, cc)), T.doc.wrap(vl.err(fx, why)), wr.D(fx, why), Equal.cong(T.St,
            T.Mode, ss => T.doc.wrap(ss), T.read.fast(st, cc), vl.err(fx, why), ee), wr.bwrap(fx, why, hw, tt))
        case False{}:
          match cr:
            case True{}:
              wr.tr(tt, T.MCr{T.read.fast(st, cc)}, T.MCr{vl.err(fx, why)}, wr.D(fx, why), Equal.cong(T.St, T.Mode,
                ss => T.MCr{ss}, T.read.fast(st, cc), vl.err(fx, why), ee), wr.bcr(fx, why, hw, tt))
            case False{}:
              wr.tr(tt, T.MScan{T.read.fast(st, cc)}, T.MScan{vl.err(fx, why)}, wr.D(fx, why), Equal.cong(T.St, T.Mode,
                ss => T.MScan{ss}, T.read.fast(st, cc), vl.err(fx, why), ee), wr.bs(fx, why, hw, tt))

# the end of the text after a refused word in LBare
def wr.bnil.b(
  +fx: Laws.Vf,
  +bb: List<&2, Char>,
  +why: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +hv: {T.word.val(List.reverse(&2, Char, bb)) == T.GotBad{why} : T.Got}
) -> wr.Q(SNil{}, T.MScan{Laws.vst(fx, bb, T.LBare{})}, wr.D(fx, why)):
  match fx:
    case Laws.Vf{+bad, +rows, +heads, +here, +parts, +back, +qkind, +stack, +uni, +left, +arrtab}:
      Equal.trans(T.Doc, T.read.fin2(T.bare.got(T.word.val(List.reverse(&2, Char, bb)), T.St{bad, rows, heads, here,
        parts, [], T.LBare{}, back, qkind, stack, T.HNone{}, uni, left, arrtab, False{}}, ' ', False{})),
        T.read.fin2(T.bare.got(T.GotBad{why}, T.St{bad, rows, heads, here, parts, [], T.LBare{}, back, qkind, stack,
        T.HNone{}, uni, left, arrtab, False{}}, ' ', False{})), T.Doc{T.err.first(bad, why), T.rows.seal(rows)},
        Equal.cong(T.Got, T.Doc, gg => T.read.fin2(T.bare.got(gg, T.St{bad, rows, heads, here, parts, [], T.LBare{},
          back,
          qkind, stack, T.HNone{}, uni, left, arrtab, False{}}, ' ', False{})), T.word.val(List.reverse(&2, Char, bb)),
          T.GotBad{why}, hv),
        wr.bs(Laws.Vf{bad, rows, heads, here, parts, back, qkind, stack, uni, left, arrtab}, why, hw, SNil{}))

# the end of the text after a refused word in LDate
def wr.bnil.d(
  +fx: Laws.Vf,
  +bb: List<&2, Char>,
  +why: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +hv: {T.word.val(List.reverse(&2, Char, bb)) == T.GotBad{why} : T.Got}
) -> wr.Q(SNil{}, T.MScan{Laws.vst(fx, bb, T.LDate{})}, wr.D(fx, why)):
  match fx:
    case Laws.Vf{+bad, +rows, +heads, +here, +parts, +back, +qkind, +stack, +uni, +left, +arrtab}:
      Equal.trans(T.Doc, T.read.fin2(T.bare.got(T.word.val(List.reverse(&2, Char, bb)), T.St{bad, rows, heads, here,
        parts, [], T.LDate{}, back, qkind, stack, T.HNone{}, uni, left, arrtab, False{}}, ' ', False{})),
        T.read.fin2(T.bare.got(T.GotBad{why}, T.St{bad, rows, heads, here, parts, [], T.LDate{}, back, qkind, stack,
        T.HNone{}, uni, left, arrtab, False{}}, ' ', False{})), T.Doc{T.err.first(bad, why), T.rows.seal(rows)},
        Equal.cong(T.Got, T.Doc, gg => T.read.fin2(T.bare.got(gg, T.St{bad, rows, heads, here, parts, [], T.LDate{},
          back,
          qkind, stack, T.HNone{}, uni, left, arrtab, False{}}, ' ', False{})), T.word.val(List.reverse(&2, Char, bb)),
          T.GotBad{why}, hv),
        wr.bs(Laws.Vf{bad, rows, heads, here, parts, back, qkind, stack, uni, left, arrtab}, why, hw, SNil{}))

# the rest after a refused word's date space
def wr.bdate.rest(
  +fx: Laws.Vf,
  +bb: List<&2, Char>,
  +why: String,
  +tt: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +hv: {T.word.val(List.reverse(&2, Char, bb)) == T.GotBad{why} : T.Got},
  +hd: {Laws.bw.digit1(tt) == False{} : Bool}
) -> wr.Q(tt, T.MScan{Laws.vst(fx, bb, T.LDate{})}, wr.D(fx, why)):
  match tt:
    case SNil{}:
      wr.bnil.d(fx, bb, why, hw, hv)
    case SCon{+c2, +t2}:
      wr.bq(Char.is_eq(c2, '"'), Char.is_eq(c2, '\''), U32.is_eq(Char.to_u32(c2), 13), Laws.vst(fx, bb, T.LDate{}), c2,
        fx, why, hw, t2, vl.bdacc(fx, bb, why, c2, hv, hd))

# a space after a refused word: the date's, or one that ends it at once
def wr.bfin.sp(
  +ds: Bool,
  +fx: Laws.Vf,
  +bb: List<&2, Char>,
  +why: String,
  +tt: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +hv: {T.word.val(List.reverse(&2, Char, bb)) == T.GotBad{why} : T.Got},
  +es: {T.date.shaped(bb) == ds : Bool},
  +hn: {Bool.not(Bool.and(T.date.shaped(bb), Laws.bw.digit1(tt))) == True{} : Bool}
) -> wr.Q(SCon{' ', tt}, T.MScan{Laws.vst(fx, bb, T.LBare{})}, wr.D(fx, why)):
  match ds:
    case True{}:
      wr.tr(tt, T.doc.scan(Laws.vst(fx, bb, T.LBare{}), ' '), T.MScan{Laws.vst(fx, bb, T.LDate{})}, wr.D(fx, why),
        vl.sp(fx, bb, es), wr.bdate.rest(fx, bb, why, tt, hw, hv, vl.nd(T.date.shaped(bb), Laws.bw.digit1(tt), es, hn)))
    case False{}:
      wr.tr(tt, T.MScan{T.read.fast(Laws.vst(fx, bb, T.LBare{}), ' ')}, T.MScan{vl.err(fx, why)}, wr.D(fx, why),
        Equal.cong(T.St, T.Mode, ss => T.MScan{ss}, T.read.fast(Laws.vst(fx, bb, T.LBare{}), ' '), vl.err(fx, why),
        vl.bacc(fx, bb, why, ' ', False{}, hv, vl.rf.sp(fx, bb, es))), wr.bs(fx, why, hw, tt))

# a character other than a space that ends a refused word
def wr.bstp(
  +fx: Laws.Vf,
  +bb: List<&2, Char>,
  +why: String,
  +cc: Char,
  +tt: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +ee: {T.read.fast(Laws.vst(fx, bb, T.LBare{}), cc) == vl.err(fx, why) : T.St}
) -> wr.Q(tt, T.MScan{T.read.fast(Laws.vst(fx, bb, T.LBare{}), cc)}, wr.D(fx, why)):
  wr.tr(tt, T.MScan{T.read.fast(Laws.vst(fx, bb, T.LBare{}), cc)}, T.MScan{vl.err(fx, why)}, wr.D(fx, why),
    Equal.cong(T.St, T.Mode, ss => T.MScan{ss}, T.read.fast(Laws.vst(fx, bb, T.LBare{}), cc), vl.err(fx, why), ee),
    wr.bs(fx, why, hw, tt))

# the claim for a refused word's buffer and one ending character
def wr.Bp(+fx: Laws.Vf, +bb: List<&2, Char>, +why: String, +tt: String, +cc: Char) -> Type:
  {Bool.not(Laws.bw.dsp(cc, bb, tt)) == True{} : Bool} -> wr.Q(SCon{cc, tt}, T.MScan{Laws.vst(fx, bb, T.LBare{})},
    wr.D(fx, why))

# a text that ends a refused word reads to the document of the refusal
def wr.bfin(
  +fx: Laws.Vf,
  +bb: List<&2, Char>,
  +why: String,
  +rest: String,
  +hw: {String.is_empty(why) == False{} : Bool},
  +hv: {T.word.val(List.reverse(&2, Char, bb)) == T.GotBad{why} : T.Got},
  +ee: {Laws.bw.end(bb, rest) == True{} : Bool}
) -> wr.Q(rest, T.MScan{Laws.vst(fx, bb, T.LBare{})}, wr.D(fx, why)):
  match rest:
    case SNil{}:
      wr.bnil.b(fx, bb, why, hw, hv)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          vl.delim(ch => wr.Bp(fx, bb, why, tt, ch), xx, Eq.and.left(T.ch.delim(Chr{xx}),
            Bool.not(Laws.bw.dsp(Chr{xx}, bb, tt)), ee),
            hn => wr.bfin.sp(T.date.shaped(bb), fx, bb, why, tt, hw, hv, {==}, hn),
            _hn => wr.bstp(fx, bb, why, Chr{9}, tt, hw, vl.bacc(fx, bb, why, Chr{9}, False{}, hv, vl.rf.tab(fx, bb))),
            _hn => wr.bstp(fx, bb, why, '\n', tt, hw, vl.bacc(fx, bb, why, '\n', Laws.vf.inl(fx), hv, vl.rf.lf(fx,
              bb))),
            _hn => wr.tr(tt, T.MCr{T.read.fast(Laws.vst(fx, bb, T.LBare{}), Chr{13})}, T.MCr{vl.err(fx, why)},
              wr.D(fx, why), Equal.cong(T.St, T.Mode, ss => T.MCr{ss}, T.read.fast(Laws.vst(fx, bb, T.LBare{}),
              Chr{13}), vl.err(fx, why), vl.bacc(fx, bb, why, Chr{13}, Laws.vf.inl(fx), hv, vl.rf.cr(fx, bb))),
              wr.bcr(fx, why, hw, tt)),
            _hn => wr.bstp(fx, bb, why, '#', tt, hw, vl.bacc(fx, bb, why, '#', True{}, hv, vl.rf.hash(fx, bb))),
            _hn => wr.bstp(fx, bb, why, ',', tt, hw, vl.bacc(fx, bb, why, ',', True{}, hv, vl.rf.comma(fx, bb))),
            _hn => wr.bstp(fx, bb, why, ']', tt, hw, vl.bacc(fx, bb, why, ']', True{}, hv, vl.rf.rb(fx, bb))),
            _hn => wr.bstp(fx, bb, why, '}', tt, hw, vl.bacc(fx, bb, why, '}', True{}, hv, vl.rf.rc(fx, bb))))(
              Eq.and.right(T.ch.delim(Chr{xx}), Bool.not(Laws.bw.dsp(Chr{xx}, bb, tt)), ee))

# a bare word word.val refuses, read from a value state, then a text that
# ends it: the document is the refusal's
def wr.lift(
  +ww: String,
  +hw: {Laws.bw.word(ww) == True{} : Bool},
  +why: String,
  +hv: {T.word.val(String.to_list(ww)) == T.GotBad{why} : T.Got},
  +fx: Laws.Vf,
  +rest: String,
  +ee: {Laws.bw.end(Laws.bw.rev(ww, []), rest) == True{} : Bool}
) -> wr.Q(String.append(ww, rest), T.MScan{Laws.vst(fx, [], T.LVal{})}, wr.D(fx, why)):
  match ww:
    case SNil{}:
      Eq.bit.absurd(&1, wr.Q(String.append(SNil{}, rest), T.MScan{Laws.vst(fx, [], T.LVal{})}, wr.D(fx, why)), hw)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          +bb = {rev.onto(tt, [Chr{xx}]) : List<&2, Char>}
          +ho = {Equal.trans(T.Got, T.word.val(List.reverse(&2, Char, bb)), T.word.val(String.to_list(SCon{Chr{xx},
            tt})), T.GotBad{why}, Equal.cong(List<&2, Char>, T.Got, cs => T.word.val(cs), List.reverse(&2, Char, bb),
            String.to_list(SCon{Chr{xx}, tt}), wd.order(Chr{xx}, tt)), hv)
            : {T.word.val(List.reverse(&2, Char, bb)) == T.GotBad{why} : T.Got}}
          +he = {Equal.trans(Bool, Laws.bw.end(bb, rest), Laws.bw.end(Laws.bw.rev(tt, [Chr{xx}]), rest), True{},
            Equal.cong(List<&2, Char>, Bool, ys => Laws.bw.end(ys, rest), bb, Laws.bw.rev(tt, [Chr{xx}]),
            Equal.sym(List<&2, Char>, Laws.bw.rev(tt, [Chr{xx}]), bb, vl.rev(tt, [Chr{xx}]))), ee)
            : {Laws.bw.end(bb, rest) == True{} : Bool}}
          wr.tr(String.append(tt, rest), T.doc.scan(Laws.vst(fx, [], T.LVal{}), Chr{xx}), T.MScan{Laws.vst(fx,
            [Chr{xx}], T.LBare{})}, wr.D(fx, why), wd.first(fx, xx, Eq.and.left(Laws.word.first(Chr{xx}),
            Laws.bw.more(tt, [Chr{xx}]), hw)),
            Equal.trans(T.Doc, T.doc.read(String.append(tt, rest), T.MScan{Laws.vst(fx, [Chr{xx}], T.LBare{})}),
              T.doc.read(rest, T.MScan{Laws.vst(fx, bb, T.LBare{})}), wr.D(fx, why),
              vl.run(tt, rest, fx, [Chr{xx}], Eq.and.right(Laws.word.first(Chr{xx}), Laws.bw.more(tt, [Chr{xx}]), hw)),
              wr.bfin(fx, bb, why, rest, vl.why(String.to_list(SCon{Chr{xx}, tt}), why, hv), ho, he)))

# WP-A: keyval lines. A keyval's key is read by KEY-3's reader over a motive
# (kx.keys), its value by WP-S1's and WP-V's readers, and the value's walk
# is the replay's once own reads the rows (ow.walk). What follows a value is
# a follower (aq.fol): blank space, then the end, a comment, a newline, a
# comma or a closing bracket, which ends a bare word and starts no string.

# the rest of a short text is short
def aq.sh(
  pre: String,
  +ss: String,
  +hh: {Laws.short(String.append(pre, ss)) == True{} : Bool}
) -> {Laws.short(ss) == True{} : Bool}:
  match pre:
    case SNil{}:
      hh
    case SCon{+c0, +pt}:
      aq.sh(pt, ss, gd.short.tail(c0, String.append(pt, ss), hh))

# a text is short when a text equal to it is
def aq.shq(
  +aa: String,
  +bb: String,
  ee: {aa == bb : String},
  hh: {Laws.short(aa) == True{} : Bool}
) -> {Laws.short(bb) == True{} : Bool}:
  %ee : {Laws.short(_) == True{} : Bool}
  hh

# a string value holding ss reads out as the owned string ss
def aq.holds(
  vv: T.Val,
  +ss: String,
  hh: Laws.s1.holds(vv, ss)
) -> {ow.v(vv) == T.VStr{ss} : T.Val}:
  match vv:
    case T.VStr{+tt}:
      Equal.cong(String, T.Val, xx => T.VStr{xx}, tt, ss, hh)
    case T.VSpan{+src, +nn}:
      Equal.cong(String, T.Val, xx => T.VStr{xx}, T.span.str(src, nn, U32.is_zero(nn)), ss, hh)
    case T.VInt{_a, _b}:
      match hh:
    case T.VFlo{_a, _b}:
      match hh:
    case T.VBool{_a}:
      match hh:
    case T.VWhen{_a}:
      match hh:
    case T.VArr{_a}:
      match hh:
    case T.VInl{_a}:
      match hh:
    case T.VHead{_a, _b}:
      match hh:
    case T.VAot{_a, _b}:
      match hh:
    case T.VAots{_a, _b}:
      match hh:
    case T.VPair{_a, _b}:
      match hh:

# whether a value is an owned string
def aq.iss(vv: T.Val) -> Bool:
  match vv:
    case T.VStr{_a0}:
      True{}
    case _:
      False{}

# a value own reads as an owned string reads so as an item of a list as well
def aq.holdsc(
  vv: T.Val,
  +ss: String,
  +hv: {ow.v(vv) == T.VStr{ss} : T.Val}
) -> {Laws.cv.own1(vv) == T.VStr{ss} : T.Val}:
  match vv:
    case T.VStr{_a0}:
      hv
    case T.VSpan{_a0, _a1}:
      hv
    case T.VInt{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VInt{_a0, _a1}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx =>
        aq.iss(xx), ow.v(T.VInt{_a0, _a1}),
        T.VStr{ss}, hv))
    case T.VFlo{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VFlo{_a0, _a1}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx =>
        aq.iss(xx), ow.v(T.VFlo{_a0, _a1}),
        T.VStr{ss}, hv))
    case T.VBool{_a0}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VBool{_a0}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx => aq.iss(xx),
        ow.v(T.VBool{_a0}),
        T.VStr{ss}, hv))
    case T.VWhen{_a0}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VWhen{_a0}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx => aq.iss(xx),
        ow.v(T.VWhen{_a0}),
        T.VStr{ss}, hv))
    case T.VArr{_a0}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VArr{_a0}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx => aq.iss(xx),
        ow.v(T.VArr{_a0}),
        T.VStr{ss}, hv))
    case T.VInl{_a0}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VInl{_a0}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx => aq.iss(xx),
        ow.v(T.VInl{_a0}),
        T.VStr{ss}, hv))
    case T.VHead{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VHead{_a0, _a1}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx =>
        aq.iss(xx), ow.v(T.VHead{_a0, _a1}),
        T.VStr{ss}, hv))
    case T.VAot{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VAot{_a0, _a1}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx =>
        aq.iss(xx), ow.v(T.VAot{_a0, _a1}),
        T.VStr{ss}, hv))
    case T.VAots{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VAots{_a0, _a1}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx =>
        aq.iss(xx), ow.v(T.VAots{_a0, _a1}),
        T.VStr{ss}, hv))
    case T.VPair{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VPair{_a0, _a1}) == T.VStr{ss} : T.Val}, Equal.cong(T.Val, Bool, xx =>
        aq.iss(xx), ow.v(T.VPair{_a0, _a1}),
        T.VStr{ss}, hv))

# a scalar word.val reads reads out as itself
def aq.scv(vv: T.Val, hh: {vl.sc(T.GotVal{vv}) == True{} : Bool}) -> {ow.v(vv) == vv : T.Val}:
  match vv:
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VStr{_a}:
      Eq.bit.absurd(&2, {ow.v(T.VStr{_a}) == T.VStr{_a} : T.Val}, hh)
    case T.VSpan{_a, _b}:
      Eq.bit.absurd(&2, {ow.v(T.VSpan{_a, _b}) == T.VSpan{_a, _b} : T.Val}, hh)
    case T.VArr{_a}:
      Eq.bit.absurd(&2, {ow.v(T.VArr{_a}) == T.VArr{_a} : T.Val}, hh)
    case T.VInl{_a}:
      Eq.bit.absurd(&2, {ow.v(T.VInl{_a}) == T.VInl{_a} : T.Val}, hh)
    case T.VHead{_a, _b}:
      Eq.bit.absurd(&2, {ow.v(T.VHead{_a, _b}) == T.VHead{_a, _b} : T.Val}, hh)
    case T.VAot{_a, _b}:
      Eq.bit.absurd(&2, {ow.v(T.VAot{_a, _b}) == T.VAot{_a, _b} : T.Val}, hh)
    case T.VAots{_a, _b}:
      Eq.bit.absurd(&2, {ow.v(T.VAots{_a, _b}) == T.VAots{_a, _b} : T.Val}, hh)
    case T.VPair{_a, _b}:
      Eq.bit.absurd(&2, {ow.v(T.VPair{_a, _b}) == T.VPair{_a, _b} : T.Val}, hh)

# and so does it as an item of a list
def aq.scvc(vv: T.Val, hh: {vl.sc(T.GotVal{vv}) == True{} : Bool}) -> {Laws.cv.own1(vv) == vv : T.Val}:
  match vv:
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VStr{_a}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VStr{_a}) == T.VStr{_a} : T.Val}, hh)
    case T.VSpan{_a, _b}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VSpan{_a, _b}) == T.VSpan{_a, _b} : T.Val}, hh)
    case T.VArr{_a}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VArr{_a}) == T.VArr{_a} : T.Val}, hh)
    case T.VInl{_a}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VInl{_a}) == T.VInl{_a} : T.Val}, hh)
    case T.VHead{_a, _b}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VHead{_a, _b}) == T.VHead{_a, _b} : T.Val}, hh)
    case T.VAot{_a, _b}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VAot{_a, _b}) == T.VAot{_a, _b} : T.Val}, hh)
    case T.VAots{_a, _b}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VAots{_a, _b}) == T.VAots{_a, _b} : T.Val}, hh)
    case T.VPair{_a, _b}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VPair{_a, _b}) == T.VPair{_a, _b} : T.Val}, hh)

# a character that ends a value at once: #, a newline's first character, a
# comma, or a closing bracket (%x23, %x0A, %x0D, %x2C, %x5D, %x7D)
def aq.stop(+cc: Char) -> Bool:
  Bool.or(Laws.abnf.cp(cc, 35), Bool.or(Laws.abnf.cp(cc, 10), Bool.or(Laws.abnf.cp(cc, 13), Bool.or(Laws.abnf.cp(cc,
    44), Bool.or(Laws.abnf.cp(cc, 93), Laws.abnf.cp(cc, 125))))))

# a text that may follow a value: blank space, then the end of the text or a
# character that ends a value at once
def aq.fol(ss: String) -> Bool:
  match ss:
    case SNil{}:
      True{}
    case SCon{+hh, tt}:
      Bool.or(Bool.and(Laws.abnf.wschar(hh), aq.fol(tt)), aq.stop(hh))

# the right half of an or that holds, when the left half does not
def aq.orr(
  uu: Bool,
  +vv: Bool,
  hu: {uu == False{} : Bool},
  hh: {Bool.or(uu, vv) == True{} : Bool}
) -> {vv == True{} : Bool}:
  match uu:
    case False{}:
      hh
    case True{}:
      Eq.bit.absurd2(&2, {vv == True{} : Bool}, hu)

# whether a character is one of aq.stop's from 125 on
def aq.st125(+cc: Char) -> Bool:
  Laws.abnf.cp(cc, 125)

# whether a character is one of aq.stop's from 93 on
def aq.st93(+cc: Char) -> Bool:
  Bool.or(Laws.abnf.cp(cc, 93), aq.st125(cc))

# whether a character is one of aq.stop's from 44 on
def aq.st44(+cc: Char) -> Bool:
  Bool.or(Laws.abnf.cp(cc, 44), aq.st93(cc))

# whether a character is one of aq.stop's from 13 on
def aq.st13(+cc: Char) -> Bool:
  Bool.or(Laws.abnf.cp(cc, 13), aq.st44(cc))

# whether a character is one of aq.stop's from 10 on
def aq.st10(+cc: Char) -> Bool:
  Bool.or(Laws.abnf.cp(cc, 10), aq.st13(cc))

# the last of aq.stop's characters
def aq.stop.e6(
  -QQ: Char -> Type,
  +uu: U32,
  hs: {Laws.abnf.cp(Chr{uu}, 125) == True{} : Bool},
  _q35: QQ('#'),
  _q10: QQ('\n'),
  _q13: QQ(Chr{13}),
  _q44: QQ(','),
  _q93: QQ(']'),
  q125: QQ('}')
) -> QQ(Chr{uu}):
  %Equal.sym(U32, uu, 125, s1.isk(uu, 125, hs)) : QQ(Chr{_})
  q125

# aq.stop's characters from 93 on
def aq.stop.e5(
  ek: Bool,
  -QQ: Char -> Type,
  +uu: U32,
  +hk: {U32.is_eq(uu, 93) == ek : Bool},
  +hs: {aq.st93(Chr{uu}) == True{} : Bool},
  q35: QQ('#'),
  q10: QQ('\n'),
  q13: QQ(Chr{13}),
  q44: QQ(','),
  q93: QQ(']'),
  q125: QQ('}')
) -> QQ(Chr{uu}):
  match ek:
    case True{}:
      %Equal.sym(U32, uu, 93, s1.isk(uu, 93, hk)) : QQ(Chr{_})
      q93
    case False{}:
      aq.stop.e6(QQ, uu, aq.orr(U32.is_eq(uu, 93), Laws.abnf.cp(Chr{uu}, 125), hk, hs), q35, q10, q13, q44, q93, q125)

# aq.stop's characters from 44 on
def aq.stop.e4(
  ek: Bool,
  -QQ: Char -> Type,
  +uu: U32,
  +hk: {U32.is_eq(uu, 44) == ek : Bool},
  +hs: {aq.st44(Chr{uu}) == True{} : Bool},
  q35: QQ('#'),
  q10: QQ('\n'),
  q13: QQ(Chr{13}),
  q44: QQ(','),
  q93: QQ(']'),
  q125: QQ('}')
) -> QQ(Chr{uu}):
  match ek:
    case True{}:
      %Equal.sym(U32, uu, 44, s1.isk(uu, 44, hk)) : QQ(Chr{_})
      q44
    case False{}:
      aq.stop.e5(U32.is_eq(uu, 93), QQ, uu, {==}, aq.orr(U32.is_eq(uu, 44), aq.st93(Chr{uu}), hk, hs), q35, q10, q13,
        q44, q93, q125)

# aq.stop's characters from 13 on
def aq.stop.e3(
  ek: Bool,
  -QQ: Char -> Type,
  +uu: U32,
  +hk: {U32.is_eq(uu, 13) == ek : Bool},
  +hs: {aq.st13(Chr{uu}) == True{} : Bool},
  q35: QQ('#'),
  q10: QQ('\n'),
  q13: QQ(Chr{13}),
  q44: QQ(','),
  q93: QQ(']'),
  q125: QQ('}')
) -> QQ(Chr{uu}):
  match ek:
    case True{}:
      %Equal.sym(U32, uu, 13, s1.isk(uu, 13, hk)) : QQ(Chr{_})
      q13
    case False{}:
      aq.stop.e4(U32.is_eq(uu, 44), QQ, uu, {==}, aq.orr(U32.is_eq(uu, 13), aq.st44(Chr{uu}), hk, hs), q35, q10, q13,
        q44, q93, q125)

# aq.stop's characters from 10 on
def aq.stop.e2(
  ek: Bool,
  -QQ: Char -> Type,
  +uu: U32,
  +hk: {U32.is_eq(uu, 10) == ek : Bool},
  +hs: {aq.st10(Chr{uu}) == True{} : Bool},
  q35: QQ('#'),
  q10: QQ('\n'),
  q13: QQ(Chr{13}),
  q44: QQ(','),
  q93: QQ(']'),
  q125: QQ('}')
) -> QQ(Chr{uu}):
  match ek:
    case True{}:
      %Equal.sym(U32, uu, 10, s1.isk(uu, 10, hk)) : QQ(Chr{_})
      q10
    case False{}:
      aq.stop.e3(U32.is_eq(uu, 13), QQ, uu, {==}, aq.orr(U32.is_eq(uu, 10), aq.st13(Chr{uu}), hk, hs), q35, q10, q13,
        q44, q93, q125)

# aq.stop's characters from 35 on
def aq.stop.e1(
  ek: Bool,
  -QQ: Char -> Type,
  +uu: U32,
  +hk: {U32.is_eq(uu, 35) == ek : Bool},
  +hs: {aq.stop(Chr{uu}) == True{} : Bool},
  q35: QQ('#'),
  q10: QQ('\n'),
  q13: QQ(Chr{13}),
  q44: QQ(','),
  q93: QQ(']'),
  q125: QQ('}')
) -> QQ(Chr{uu}):
  match ek:
    case True{}:
      %Equal.sym(U32, uu, 35, s1.isk(uu, 35, hk)) : QQ(Chr{_})
      q35
    case False{}:
      aq.stop.e2(U32.is_eq(uu, 10), QQ, uu, {==}, aq.orr(U32.is_eq(uu, 35), aq.st10(Chr{uu}), hk, hs), q35, q10, q13,
        q44, q93, q125)

# a follower's first character: blank space before a follower, or one that
# ends a value at once
def aq.fol.e1(
  ws: Bool,
  -QQ: String -> Type,
  +hh: Char,
  +tt: String,
  +hw: {Bool.and(Laws.abnf.wschar(hh), aq.fol(tt)) == ws : Bool},
  hf: {Bool.or(ws, aq.stop(hh)) == True{} : Bool},
  sp: @t2: String -> {aq.fol(t2) == True{} : Bool} -> QQ(SCon{' ', t2}),
  tab: @t2: String -> {aq.fol(t2) == True{} : Bool} -> QQ(SCon{'\t', t2}),
  stop: @cc: Char -> @t2: String -> {aq.stop(cc) == True{} : Bool} -> QQ(SCon{cc, t2})
) -> QQ(SCon{hh, tt}):
  match ws:
    case True{}:
      ap.wc(cc => QQ(SCon{cc, tt}), hh, Eq.and.left(Laws.abnf.wschar(hh), aq.fol(tt), hw), sp(tt,
        Eq.and.right(Laws.abnf.wschar(hh), aq.fol(tt), hw)), tab(tt, Eq.and.right(Laws.abnf.wschar(hh), aq.fol(tt),
          hw)))
    case False{}:
      stop(hh, tt, hf)

# what holds of the six characters holds of every one aq.stop takes
def aq.stop.elim(
  -QQ: Char -> Type,
  +uu: U32,
  hs: {aq.stop(Chr{uu}) == True{} : Bool},
  q35: QQ('#'),
  q10: QQ('\n'),
  q13: QQ(Chr{13}),
  q44: QQ(','),
  q93: QQ(']'),
  q125: QQ('}')
) -> QQ(Chr{uu}):
  aq.stop.e1(U32.is_eq(uu, 35), QQ, uu, {==}, hs, q35, q10, q13, q44, q93, q125)

# a follower's shapes: a claim about each holds of every follower
def aq.fol.elim(
  -QQ: String -> Type,
  ss: String,
  hf: {aq.fol(ss) == True{} : Bool},
  nil: QQ(""),
  sp: @tt: String -> {aq.fol(tt) == True{} : Bool} -> QQ(SCon{' ', tt}),
  tab: @tt: String -> {aq.fol(tt) == True{} : Bool} -> QQ(SCon{'\t', tt}),
  stop: @cc: Char -> @tt: String -> {aq.stop(cc) == True{} : Bool} -> QQ(SCon{cc, tt})
) -> QQ(ss):
  match ss:
    case SNil{}:
      nil
    case SCon{+hh, +tt}:
      aq.fol.e1(Bool.and(Laws.abnf.wschar(hh), aq.fol(tt)), QQ, hh, tt, {==}, hf, sp, tab, stop)

# a character that ends a value at once starts no string
def aq.free.stop(
  cc: Char,
  +t2: String,
  hs: {aq.stop(cc) == True{} : Bool}
) -> {Laws.s1.free(SCon{cc, t2}) == True{} : Bool}:
  match cc:
    case Chr{+uu}:
      aq.stop.elim(c => {Laws.s1.free(SCon{c, t2}) == True{} : Bool}, uu, hs, {==}, {==}, {==}, {==}, {==}, {==})

# a follower starts no string
def aq.free(+ss: String, +hf: {aq.fol(ss) == True{} : Bool}) -> {Laws.s1.free(ss) == True{} : Bool}:
  aq.fol.elim(s => {Laws.s1.free(s) == True{} : Bool}, ss, hf, {==}, _t => _h => {==}, _t => _h => {==},
    cc => t2 => hs => aq.free.stop(cc, t2, hs))

# a character that ends a value at once is no digit
def aq.nod.stop(
  cc: Char,
  +t2: String,
  hs: {aq.stop(cc) == True{} : Bool}
) -> {Laws.bw.digit1(SCon{cc, t2}) == False{} : Bool}:
  match cc:
    case Chr{+uu}:
      aq.stop.elim(c => {Laws.bw.digit1(SCon{c, t2}) == False{} : Bool}, uu, hs, {==}, {==}, {==}, {==}, {==}, {==})

# a follower starts with no digit
def aq.nod(+ss: String, +hf: {aq.fol(ss) == True{} : Bool}) -> {Laws.bw.digit1(ss) == False{} : Bool}:
  aq.fol.elim(s => {Laws.bw.digit1(s) == False{} : Bool}, ss, hf, {==}, _t => _h => {==}, _t => _h => {==},
    cc => t2 => hs => aq.nod.stop(cc, t2, hs))

# an and with a false right half is false
def aq.andf(+aa: Bool) -> {Bool.and(aa, False{}) == False{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      {==}

# a space before a follower ends a bare word, the date's space included
def aq.bwe.sp(
  +buf: List<&2, Char>,
  +tt: String,
  +ht: {aq.fol(tt) == True{} : Bool}
) -> {Laws.bw.end(buf, SCon{' ', tt}) == True{} : Bool}:
  %Equal.sym(Bool, Laws.bw.digit1(tt), False{}, aq.nod(tt, ht)) : {Bool.not(Bool.and(True{},
    Bool.and(T.date.shaped(buf),
    _))) == True{} : Bool}
  %Equal.sym(Bool, Bool.and(T.date.shaped(buf), False{}), False{}, aq.andf(T.date.shaped(buf)))
    : {Bool.not(Bool.and(True{}, _)) == True{} : Bool}
  {==}

# a character that ends a value at once ends a bare word
def aq.bwe.stop(
  +buf: List<&2, Char>,
  cc: Char,
  +t2: String,
  hs: {aq.stop(cc) == True{} : Bool}
) -> {Laws.bw.end(buf, SCon{cc, t2}) == True{} : Bool}:
  match cc:
    case Chr{+uu}:
      aq.stop.elim(c => {Laws.bw.end(buf, SCon{c, t2}) == True{} : Bool}, uu, hs, {==}, {==}, {==}, {==}, {==}, {==})

# a follower ends a bare word
def aq.bwe(
  +buf: List<&2, Char>,
  +ss: String,
  +hf: {aq.fol(ss) == True{} : Bool}
) -> {Laws.bw.end(buf, ss) == True{} : Bool}:
  aq.fol.elim(s => {Laws.bw.end(buf, s) == True{} : Bool}, ss, hf, {==}, t2 => h2 => aq.bwe.sp(buf, t2, h2),
    _t => _h => {==}, cc => t2 => hs => aq.bwe.stop(buf, cc, t2, hs))

# one blank before a follower
def aq.fol.ws1(
  +hh: Char,
  +tt: String,
  hw: {Laws.abnf.wschar(hh) == True{} : Bool},
  +ht: {aq.fol(tt) == True{} : Bool}
) -> {aq.fol(SCon{hh, tt}) == True{} : Bool}:
  %Equal.sym(Bool, aq.fol(tt), True{}, ht) : {Bool.or(Bool.and(Laws.abnf.wschar(hh), _), aq.stop(hh)) == True{} : Bool}
  %Equal.sym(Bool, Laws.abnf.wschar(hh), True{}, hw) : {Bool.or(Bool.and(_, True{}), aq.stop(hh)) == True{} : Bool}
  {==}

# blank space before a follower is one
def aq.fol.ws(
  ww: String,
  +xx: String,
  +hw: {Laws.abnf.ws(ww) == True{} : Bool},
  +hx: {aq.fol(xx) == True{} : Bool}
) -> {aq.fol(String.append(ww, xx)) == True{} : Bool}:
  match ww:
    case SNil{}:
      hx
    case SCon{+hh, +tt}:
      aq.fol.ws1(hh, String.append(tt, xx), Eq.and.left(Laws.abnf.wschar(hh), Laws.abnf.ws(tt), hw), aq.fol.ws(tt, xx,
        Eq.and.right(Laws.abnf.wschar(hh), Laws.abnf.ws(tt), hw), hx))

# a comment, or the text after it
def aq.fol.com(
  +com: Laws.GCom,
  +xx: String,
  +hx: {aq.fol(xx) == True{} : Bool}
) -> {aq.fol(Laws.g.com.text(com, xx)) == True{} : Bool}:
  match com:
    case Laws.GcNone{}:
      hx
    case Laws.GcSome{_body}:
      {==}

# a newline
def aq.fol.nl(
  nl: String,
  +xx: String,
  +hn: {Laws.abnf.newline(nl) == True{} : Bool}
) -> {aq.fol(String.append(nl, xx)) == True{} : Bool}:
  s1.nl.elim(n2 => {aq.fol(String.append(n2, xx)) == True{} : Bool}, nl, hn, {==}, {==})

# the lines after an expression
def aq.fol.lines(
  +ls: List<&2, Laws.GLine>,
  +hl: {Laws.g.ok.lines(ls) == True{} : Bool}
) -> {aq.fol(Laws.g.lines.text(ls, "")) == True{} : Bool}:
  match ls:
    case []:
      {==}
    case Laws.GLine{+nl, +ex} <> +rest:
      aq.fol.nl(nl, Laws.g.expr.text(ex, Laws.g.lines.text(rest, "")), Eq.and.left(Laws.abnf.newline(nl),
        Bool.and(Laws.g.ok.expr(ex), Laws.g.ok.lines(rest)), hl))

# What a value reads as: the continuation a value reader is given. With the
# replay's value v and no error, the rest is read from the state with a
# value that own reads as v put where the stack puts values, whatever back,
# qkind, uni and left the value leaves; with an error bd, the document is bd
# and the rows as they were.

# the continuation, by the replay's error
def aq.vk2(
  +bd: String,
  +_vv: T.Val,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  PP: T.Doc -> Type
) -> Type:
  match bd:
    case SNil{}:
      @xv: T.Val -> @bk: T.Lex -> @qk: T.QKind -> @un: U32 -> @lf: U32 -> @hv: {ow.v(xv) == _vv : T.Val} ->
        @hc: {Laws.cv.own1(xv) == _vv : T.Val} ->
        PP(T.doc.read(rest, T.MScan{T.take.top(sk, xv, "", rw, hs, he, ps, bk, qk, un, lf, ab, False{})}))
    case SCon{+c0, +cs}:
      PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)})

# the continuation, by the replay's reading
def aq.vk(
  +rr: Laws.RpAcc,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  PP: T.Doc -> Type
) -> Type:
  match rr:
    case Laws.RaVal{vv, bd}:
      aq.vk2(bd, vv, rw, hs, he, ps, sk, ab, rest, PP)
    case Laws.RaItems{_i, _b}:
      Unit
    case Laws.RaRows{_r, _b}:
      Unit

# the continuation of a value node, from no error
def aq.VK(
  +val: Laws.GVal,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  PP: T.Doc -> Type
) -> Type:
  aq.vk(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), rw, hs, he, ps, sk, ab, rest, PP)

# a string value's continuation applied, with both readings of the value
def aq.kstr(
  +xv: T.Val,
  +ss: String,
  +b2: T.Lex,
  +q2: T.QKind,
  +u2: U32,
  +l2: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hv: {ow.v(xv) == T.VStr{ss} : T.Val},
  kk: aq.vk2("", T.VStr{ss}, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(rest, T.MScan{T.take.top(sk, xv, "", rw, hs, he, ps, b2, q2, u2, l2, ab, False{})})):
  kk(xv, b2, q2, u2, l2, hv, aq.holdsc(xv, ss, hv))

# a string of any form, from a value state
def aq.str(
  +st: Laws.GString,
  +rest: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  +ok: {Laws.g.ok.str(st) == True{} : Bool},
  +es: {Laws.short(Laws.g.str.text(st, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  kk: aq.VK(Laws.GvString{st}, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.str.text(st, rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  Laws.string_reads_as_denoted(st, ok, Laws.string_short_in_document("", st, rest, es), rw, hs, he, ps, bk, qk, sk, un,
    lf, ab, rest, aq.free(rest, hf), PP, +xv => b2 => q2 => u2 => l2 => hh => aq.kstr(xv, Laws.g.str.chars(st), b2,
      q2, u2, l2, rw, hs, he, ps, sk,
    ab, rest, PP, aq.holds(xv, Laws.g.str.chars(st), hh), kk))

# a refused bare word: the document is its reason and the rows
def aq.wbad(
  why: String,
  +ww: String,
  +rest: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  +hw: {Laws.bw.word(ww) == True{} : Bool},
  +eg: {T.word.val(String.to_list(ww)) == T.GotBad{why} : T.Got},
  +hf: {aq.fol(rest) == True{} : Bool},
  +hy: {String.is_empty(why) == False{} : Bool},
  kk: aq.vk(Laws.replay.got(T.GotBad{why}, ""), rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(ww, rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  match why:
    case SNil{}:
      Eq.bit.absurd2(&1, PP(T.doc.read(String.append(ww, rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf,
        ab)})), hy)
    case SCon{+c0, +cs}:
      %Equal.sym(T.Doc, T.doc.read(String.append(ww, rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)}),
        T.Doc{SCon{c0, cs}, T.rows.seal(rw)}, wr.lift(ww, hw, SCon{c0, cs}, eg, Laws.Vf{"", rw, hs, he, ps, bk, qk, sk,
        un, lf, ab}, rest, aq.bwe(Laws.bw.rev(ww, []), rest, hf))) : PP(_)
      kk

# a bare word by what word.val reads it as
def aq.wgot(
  gg: T.Got,
  +ww: String,
  +rest: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  +hw: {Laws.bw.word(ww) == True{} : Bool},
  +eg: {T.word.val(String.to_list(ww)) == gg : T.Got},
  +hf: {aq.fol(rest) == True{} : Bool},
  kk: aq.vk(Laws.replay.got(gg, ""), rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(ww, rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  match gg:
    case T.GotVal{+vv}:
      %Equal.sym(T.Doc, T.doc.read(String.append(ww, rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)}),
        T.doc.read(rest, T.MScan{Laws.bw.put(sk, vv, rw, hs, he, ps, bk, qk, un, lf, ab)}), Laws.bare_word_reads_on(ww,
        hw, vv, eg, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, aq.bwe(Laws.bw.rev(ww, []), rest, hf))) : PP(_)
      +hsc = {Equal.trans(Bool, vl.sc(T.GotVal{vv}), vl.sc(T.word.val(String.to_list(ww))), True{}, Equal.cong(T.Got,
        Bool,
        g2 => vl.sc(g2), T.GotVal{vv}, T.word.val(String.to_list(ww)), Equal.sym(T.Got, T.word.val(String.to_list(ww)),
        T.GotVal{vv}, eg)), vl.sc.word(String.to_list(ww))) : {vl.sc(T.GotVal{vv}) == True{} : Bool}}
      kk(vv, bk, qk, un, lf, aq.scv(vv, hsc), aq.scvc(vv, hsc))
    case T.GotBad{+why}:
      aq.wbad(why, ww, rest, rw, hs, he, ps, bk, qk, sk, un, lf, ab, PP, hw, eg, hf, vl.why(String.to_list(ww), why,
        eg), kk)

# WP-A: values and keyvals read from an error. Replay keeps an error it has:
# a value node read from an error keeps it (aq.gobad), however deep its
# arrays and inline tables go, since every walk a keyval of an inline table
# runs starts from it and fails (failed_walk_changes_nothing), and a word
# word.val refuses keeps the first error. A keyval's walk from the root fails
# as well (aq.rootst), so every expression replayed from an error keeps it,
# the rows and the definitions (aq.stays).

# the first error is the one there was
def aq.efirst(
  bd: String,
  +why: String,
  +eb: {String.is_empty(bd) == False{} : Bool}
) -> {T.err.first(bd, why) == bd : String}:
  match bd:
    case SNil{}:
      Eq.bit.absurd2(&2, {T.err.first("", why) == "" : String}, eb)
    case SCon{_c0, _cs}:
      {==}

# a bare word read from an error keeps it
def aq.gotbad(
  gg: T.Got,
  +b0: String,
  +bd: String,
  +eb: {String.is_empty(bd) == False{} : Bool},
  +hb: {b0 == bd : String}
) -> {Laws.replay.bad(Laws.replay.got(gg, b0)) == bd : String}:
  match gg:
    case T.GotVal{_vv}:
      hb
    case T.GotBad{+why}:
      %Equal.sym(String, b0, bd, hb) : {T.err.first(_, why) == bd : String}
      aq.efirst(bd, why, eb)

# an array closed keeps the error of its items
def aq.arrbad(
  xx: Laws.RpAcc,
  +bd: String,
  +hx: {Laws.replay.bad(xx) == bd : String}
) -> {Laws.replay.bad(Laws.replay.arr(xx)) == bd : String}:
  match xx:
    case Laws.RaVal{_v, _b}:
      hx
    case Laws.RaItems{_i, _b}:
      hx
    case Laws.RaRows{_r, _b}:
      hx

# and so does an inline table closed
def aq.inlbad(
  xx: Laws.RpAcc,
  +bd: String,
  +hx: {Laws.replay.bad(xx) == bd : String}
) -> {Laws.replay.bad(Laws.replay.inl(xx)) == bd : String}:
  match xx:
    case Laws.RaVal{_v, _b}:
      hx
    case Laws.RaItems{_i, _b}:
      hx
    case Laws.RaRows{_r, _b}:
      hx

# an item put on the items keeps the error both have
def aq.itembad(
  got: Laws.RpAcc,
  acc: Laws.RpAcc,
  +bd: String,
  +hg: {Laws.replay.bad(got) == bd : String},
  +ha: {Laws.replay.bad(acc) == bd : String}
) -> {Laws.replay.bad(Laws.replay.item(got, acc)) == bd : String}:
  match got:
    case Laws.RaVal{_v, _b}:
      match acc:
        case Laws.RaVal{_v2, _b2}:
          ha
        case Laws.RaItems{_i, _b2}:
          hg
        case Laws.RaRows{_r, _b2}:
          ha
    case Laws.RaItems{_i, _b}:
      ha
    case Laws.RaRows{_r, _b}:
      ha

# a keyval of an inline table walked from an error keeps it
def aq.kvbad(
  +names: List<&2, String>,
  got: Laws.RpAcc,
  acc: Laws.RpAcc,
  +bd: String,
  +eb: {String.is_empty(bd) == False{} : Bool},
  +hg: {Laws.replay.bad(got) == bd : String},
  +ha: {Laws.replay.bad(acc) == bd : String}
) -> {Laws.replay.bad(Laws.replay.kv(names, got, acc)) == bd : String}:
  match got:
    case Laws.RaVal{+vv, +b}:
      match acc:
        case Laws.RaVal{_v2, _b2}:
          ha
        case Laws.RaItems{_i, _b2}:
          ha
        case Laws.RaRows{+rows, _b2}:
          %Equal.sym(String, b, bd, hg) : {Laws.replay.bad(Laws.replay.end.rows(T.tree.walk(names, T.Tw{rows,
            T.JPut{vv}, [], _, "", [], True{}}, 0))) == bd : String}
          %Equal.sym(T.End, T.tree.walk(names, T.Tw{rows, T.JPut{vv}, [], bd, "", [], True{}}, 0), T.End{rows, bd,
            []}, Laws.failed_walk_changes_nothing(names, rows, T.JPut{vv}, bd, "", [], True{}, 0,
              eb)) : {Laws.replay.bad(Laws.replay.end.rows(_)) == bd : String}
          {==}
    case Laws.RaItems{_i, _b}:
      ha
    case Laws.RaRows{_r, _b}:
      ha

# a value node read from an error keeps it
def aq.gobad(
  vv: Laws.GVal,
  +acc: Laws.RpAcc,
  +bd: String,
  +eb: {String.is_empty(bd) == False{} : Bool},
  +ha: {Laws.replay.bad(acc) == bd : String}
) -> {Laws.replay.bad(Laws.replay.go(vv, acc)) == bd : String}:
  match vv:
    case Laws.GvString{_st}:
      ha
    case Laws.GvBoolean{+cs}:
      aq.gotbad(T.word.val(cs), Laws.replay.bad(acc), bd, eb, ha)
    case Laws.GvArrayEmpty{_wn}:
      ha
    case Laws.GvArray{+vals, _wn}:
      aq.arrbad(Laws.replay.go(vals, Laws.RaItems{[], Laws.replay.bad(acc)}), bd, aq.gobad(vals, Laws.RaItems{[],
        Laws.replay.bad(acc)}, bd, eb, ha))
    case Laws.GvInlineTableEmpty{_w1, _w2}:
      ha
    case Laws.GvInlineTable{_w1, +kvs, _w2}:
      aq.inlbad(Laws.replay.go(kvs, Laws.RaRows{[], Laws.replay.bad(acc)}), bd, aq.gobad(kvs, Laws.RaRows{[],
        Laws.replay.bad(acc)}, bd, eb, ha))
    case Laws.GvDateTime{+cs}:
      aq.gotbad(T.word.val(cs), Laws.replay.bad(acc), bd, eb, ha)
    case Laws.GvFloat{+cs}:
      aq.gotbad(T.word.val(cs), Laws.replay.bad(acc), bd, eb, ha)
    case Laws.GvInteger{+cs}:
      aq.gotbad(T.word.val(cs), Laws.replay.bad(acc), bd, eb, ha)
    case Laws.GArrayValues{_wa, +val, _wb, +rest}:
      aq.gobad(rest, Laws.replay.item(Laws.replay.go(val, acc), acc), bd, eb, aq.itembad(Laws.replay.go(val, acc),
        acc, bd, aq.gobad(val, acc, bd, eb, ha), ha))
    case Laws.GArrayValuesLast{_wa, +val, _wb, _sep}:
      aq.itembad(Laws.replay.go(val, acc), acc, bd, aq.gobad(val, acc, bd, eb, ha), ha)
    case Laws.GInlineTableKeyvals{+kv, _w1, _w2, +rest}:
      aq.gobad(rest, Laws.replay.go(kv, acc), bd, eb, aq.gobad(kv, acc, bd, eb, ha))
    case Laws.GInlineTableKeyvalsLast{+kv}:
      aq.gobad(kv, acc, bd, eb, ha)
    case Laws.GKeyval{+key, _w1, _w2, +val}:
      aq.kvbad(Laws.g.key.names(key), Laws.replay.go(val, acc), acc, bd, eb, aq.gobad(val, acc, bd, eb, ha), ha)

# a keyval's walk from the root, from an error, keeps it, the rows and the
# definitions
def aq.rootst(
  rr: Laws.RpAcc,
  +names: List<&2, String>,
  +bd: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +eb: {String.is_empty(bd) == False{} : Bool},
  +hr: {Laws.replay.bad(rr) == bd : String}
) -> {Laws.replay.root(names, rr, Laws.RpSt{bd, rows, heads, here}) == Laws.RpSt{bd, rows, heads, here} : Laws.RpSt}:
  match rr:
    case Laws.RaVal{+vv, +b}:
      %Equal.sym(String, b, bd, hr) : {Laws.replay.end(T.tree.walk(List.append(&2, String, here, names), T.Tw{rows,
        T.JPut{vv}, [], _, "", heads, False{}}, T.path.len(here, 0)), here) == Laws.RpSt{bd, rows, heads,
          here} : Laws.RpSt}
      %Equal.sym(T.End, T.tree.walk(List.append(&2, String, here, names), T.Tw{rows, T.JPut{vv}, [], bd, "", heads,
        False{}}, T.path.len(here, 0)), T.End{rows, bd, heads}, Laws.failed_walk_changes_nothing(List.append(&2,
          String, here, names), rows, T.JPut{vv}, bd, "", heads, False{}, T.path.len(here, 0),
            eb)) : {Laws.replay.end(_, here) == Laws.RpSt{bd, rows, heads, here} : Laws.RpSt}
      {==}
    case Laws.RaItems{_i, _b}:
      {==}
    case Laws.RaRows{_r, _b}:
      {==}

# an expression replayed from an error keeps it, the rows and the
# definitions
def aq.stays.x(
  +ex: Laws.GExpr,
  +bd: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +eb: {String.is_empty(bd) == False{} : Bool}
) -> {Laws.replay.expr(ex, Laws.RpSt{bd, rows, heads, here}) == Laws.RpSt{bd, rows, heads, ap.xhere(ex,
  here)} : Laws.RpSt}:
  match ex:
    case Laws.GxBlank{_w1, _com}:
      {==}
    case Laws.GxKeyval{_w1, +kv, _w2, _com}:
      match kv:
        case Laws.GKeyval{+key, _a, _b, +val}:
          aq.rootst(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, bd}), Laws.g.key.names(key), bd, rows, heads, here, eb,
            aq.gobad(val, Laws.RaVal{T.VArr{[]}, bd}, bd, eb, {==}))
        case Laws.GvString{_a0}:
          {==}
        case Laws.GvBoolean{_a0}:
          {==}
        case Laws.GvArrayEmpty{_a0}:
          {==}
        case Laws.GvArray{_a0, _a1}:
          {==}
        case Laws.GvInlineTableEmpty{_a0, _a1}:
          {==}
        case Laws.GvInlineTable{_a0, _a1, _a2}:
          {==}
        case Laws.GvDateTime{_a0}:
          {==}
        case Laws.GvFloat{_a0}:
          {==}
        case Laws.GvInteger{_a0}:
          {==}
        case Laws.GArrayValues{_a0, _a1, _a2, _a3}:
          {==}
        case Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}:
          {==}
        case Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}:
          {==}
        case Laws.GInlineTableKeyvalsLast{_a0}:
          {==}
    case Laws.GxTable{_w1, Laws.GStdTable{_a, +key, _b}, _w2, _com}:
      %Equal.sym(T.End, T.tree.walk(Laws.g.key.names(key), T.Tw{rows, T.JDef{}, [], bd, "", heads, False{}}, 0),
        T.End{rows, bd, heads}, Laws.failed_walk_changes_nothing(Laws.g.key.names(key), rows, T.JDef{}, bd, "", heads,
          False{}, 0, eb)) : {Laws.replay.end(_, Laws.g.key.names(key)) == Laws.RpSt{bd, rows, heads,
            Laws.g.key.names(key)} : Laws.RpSt}
      {==}
    case Laws.GxTable{_w1, Laws.GArrayTable{_a, +key, _b}, _w2, _com}:
      %Equal.sym(T.End, T.tree.walk(Laws.g.key.names(key), T.Tw{rows, T.JAot{}, [], bd, "", heads, False{}}, 0),
        T.End{rows, bd, heads}, Laws.failed_walk_changes_nothing(Laws.g.key.names(key), rows, T.JAot{}, bd, "", heads,
          False{}, 0, eb)) : {Laws.replay.end(_, Laws.g.key.names(key)) == Laws.RpSt{bd, rows, heads,
            Laws.g.key.names(key)} : Laws.RpSt}
      {==}

# the lines replayed from an error keep it and the rows to the end
def aq.stays(
  +ls: List<&2, Laws.GLine>,
  +bd: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +eb: {String.is_empty(bd) == False{} : Bool}
) -> {Laws.replay.doc(Laws.replay.lines(ls, Laws.RpSt{bd, rows, heads, here})) == T.Doc{bd, T.rows.seal(rows)} : T.Doc}:
  match ls:
    case []:
      {==}
    case Laws.GLine{_nl, +ex} <> +rest:
      %Equal.sym(Laws.RpSt, Laws.replay.expr(ex, Laws.RpSt{bd, rows, heads, here}), Laws.RpSt{bd, rows, heads,
        ap.xhere(ex, here)}, aq.stays.x(ex, bd, rows, heads, here, eb)) : {Laws.replay.doc(Laws.replay.lines(rest,
          _)) == T.Doc{bd, T.rows.seal(rows)} : T.Doc}
      aq.stays(rest, bd, rows, heads, ap.xhere(ex, here), eb)

# and so the lines' replay from an error gives the document of the error and
# the rows
def aq.E(+ls: List<&2, Laws.GLine>) -> ap.E(ls):
  +bd => +eb => +rows => +heads => +here => aq.stays(ls, bd, rows, heads, here, eb)

# WP-A: the line invariant, own-level. The rows the scanner keeps hold spans
# where the replay holds owned strings, so a state with rows rw stands for
# the replay's own.rows(rw): the rest of the text after an expression reads
# to a document that own reads as the replay's (aq.K). A walk commutes with
# own (ow.walk), so a header's walk on rw ends where the replay's on
# own.rows(rw) does, read out; and an error the scanner keeps is the
# replay's, with the rows read out after they are sealed as before (cv.osl).
# KEY-3's header reader runs as before, with its continuation any claim
# about the document (aq.hcore, from kx.hkeys).

# the rest of the text read after a walk from a line, in the table path,
# with the walk's error, rows and definitions, from every back, qkind, uni
# and left
def aq.HLP(
  +bd2: String,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +path: List<&2, String>,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    PP(T.doc.read(rest, T.MScan{ap.ln(bd2, rows2, heads2, path, b2, q2, u2, l2)}))

# the rest of the text after an expression, as the reader of the lines ls
# after it gives it: from the state a [ comment ] leaves at the start of a
# line or after a header or a keyval, with no error, the rest reads to a
# document own reads as the lines' replay from the rows read out
def aq.K(+ls: List<&2, Laws.GLine>, +tail: String) -> Type:
  @com: Laws.GCom -> @lx: T.Lex -> {ap.tll(lx) == True{} : Bool} -> @bk: T.Lex -> @rw: List<&2, T.Val> ->
    @hs: List<&2, String> -> @he: List<&2, String> -> @qk: T.QKind -> @un: U32 -> @lf: U32 ->
    {Laws.own(T.doc.read(tail, T.MScan{ap.aft(com, lx, bk, rw, hs, he, [], qk, [], un, lf, False{})}))
    == ap.F(ls, Laws.RpSt{"", Laws.own.rows(rw), hs, he}) : T.Doc}

# an error the scanner keeps with its rows is the replay's, read out
def aq.err(
  +bd: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +ls: List<&2, Laws.GLine>,
  +eb: {String.is_empty(bd) == False{} : Bool},
  ee: ap.E(ls)
) -> {Laws.own(T.Doc{bd, T.rows.seal(rows)}) == ap.F(ls, Laws.RpSt{bd, Laws.own.rows(rows), heads, here}) : T.Doc}:
  Equal.trans(T.Doc, Laws.own(T.Doc{bd, T.rows.seal(rows)}), T.Doc{bd, T.rows.seal(Laws.own.rows(rows))}, ap.F(ls,
    Laws.RpSt{bd, Laws.own.rows(rows), heads, here}), Equal.cong(List<&2, T.Val>, T.Doc, zs => T.Doc{bd, zs},
      Laws.own.rows(T.rows.seal(rows)), T.rows.seal(Laws.own.rows(rows)), cv.osl(rows)), Equal.sym(T.Doc, ap.F(ls,
        Laws.RpSt{bd, Laws.own.rows(rows), heads, here}), T.Doc{bd, T.rows.seal(Laws.own.rows(rows))}, ee(bd, eb,
          Laws.own.rows(rows), heads, here)))

# after a walk from a line, however it ended: the blank space, the comment
# and the rest read to a document own reads as the replay's
def aq.hl(
  +bd2: String,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +names: List<&2, String>,
  +w2: String,
  +com: Laws.GCom,
  +tail: String,
  +ls: List<&2, Laws.GLine>,
  +hw: {Laws.abnf.ws(w2) == True{} : Bool},
  +hc: {Laws.g.ok.com(com) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls)
) -> aq.HLP(bd2, rows2, heads2, names, String.append(w2, Laws.g.com.text(com, tail)), dd => {Laws.own(dd) == ap.F(ls,
  Laws.RpSt{bd2, Laws.own.rows(rows2), heads2, names}) : T.Doc}):
  match bd2:
    case SNil{}:
      +b2 => +q2 => +u2 => +l2 => Equal.trans(T.Doc, Laws.own(T.doc.read(String.append(w2, Laws.g.com.text(com,
        tail)), T.MScan{ap.ln("", rows2, heads2, names, b2, q2, u2, l2)})), Laws.own(T.doc.read(tail,
          T.MScan{ap.aft(com, T.LLine{}, b2, rows2, heads2, names, [], q2, [], u2, l2, False{})})), ap.F(ls,
            Laws.RpSt{"", Laws.own.rows(rows2), heads2, names}), Equal.cong(T.Doc, T.Doc, dd => Laws.own(dd),
              T.doc.read(String.append(w2, Laws.g.com.text(com, tail)), T.MScan{ap.ln("", rows2, heads2, names, b2,
                q2, u2, l2)}), T.doc.read(tail, T.MScan{ap.aft(com, T.LLine{}, b2, rows2, heads2, names, [], q2, [],
                  u2, l2, False{})}), ap.tail(w2, com, tail, T.LLine{}, b2, rows2, heads2, names, [], q2, [], u2, l2,
                    False{}, {==}, {==}, hw, hc)), kk(com, T.LLine{}, {==}, b2, rows2, heads2, names, q2, u2, l2))
    case SCon{+c0, +cs}:
      +b2 => +q2 => +u2 => +l2 => Equal.trans(T.Doc, Laws.own(T.doc.read(String.append(w2, Laws.g.com.text(com,
        tail)), T.MScan{ap.ln(SCon{c0, cs}, rows2, heads2, names, b2, q2, u2, l2)})), Laws.own(T.Doc{SCon{c0, cs},
          T.rows.seal(rows2)}), ap.F(ls, Laws.RpSt{SCon{c0, cs}, Laws.own.rows(rows2), heads2, names}),
            Equal.cong(T.Doc, T.Doc, dd => Laws.own(dd), T.doc.read(String.append(w2, Laws.g.com.text(com, tail)),
              T.MScan{ap.ln(SCon{c0, cs}, rows2, heads2, names, b2, q2, u2, l2)}), T.Doc{SCon{c0, cs},
                T.rows.seal(rows2)}, Laws.error_stays(SCon{c0, cs}, rows2, heads2, names, [], [], T.LLine{}, b2, q2,
                  [], T.HNone{}, u2, l2, False{}, False{}, {==}, String.append(w2, Laws.g.com.text(com, tail)))),
                    aq.err(SCon{c0, cs}, rows2, heads2, names, ls, {==}, ee))

# a whole header, from the start of a line in any table, whatever its walk
# returns, with any claim about the document the rest reads to
def aq.hcore(
  +arr: Bool,
  +g0: List<&2, Bool>,
  +ds: List<&2, Laws.KDot>,
  +last: Laws.KSeg,
  +g9: List<&2, Bool>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +a0: Bool,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +rows2: List<&2, T.Val>,
  +bd2: String,
  +heads2: List<&2, String>,
  +rest: String,
  -PP: T.Doc -> Type,
  +eo: {Laws.k3.dk.ok(ds, last) == True{} : Bool},
  +ew: ap.Wk(Laws.k3.dk.names(ds, last), rw, Laws.header_job(arr), hs, T.End{rows2, bd2, heads2}),
  ih: aq.HLP(bd2, rows2, heads2, Laws.k3.dk.names(ds, last), rest, PP)
) -> PP(T.doc.read(Laws.k3.hd.text(arr, g0, ds, last, g9, rest), T.MScan{Laws.k3.at(Laws.AtLine{}, rw, hs, he, [], a0,
  bk, qk, un, lf)})):
  match arr:
    case False{}:
      %k3.hlead(g0, Laws.k3.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', rest})), rw, hs, he, bk, qk, un,
        lf, False{}) : PP(_)
      kx.hkeys(ds, last, g9, k3.nz(g0), rw, hs, he, [], bk, qk, un, lf, False{}, rest, PP, eo, +b2 => +q2 => +u2 =>
        +l2 =>
        %ap.hend(False{}, rw, hs, he, k3.acc(ds, last, k3.nz(g0), []), b2, q2, u2, l2, Laws.k3.dk.names(ds, last),
          rows2, bd2, heads2, rest, k3.ne(ds, last, k3.ps0(k3.nz(g0), [])), k3.path(k3.nz(g0), ds, last), ew) : PP(_)
        ih(b2, q2, u2, l2))
    case True{}:
      %k3.hlead(g0, Laws.k3.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', SCon{']', rest}})), rw, hs, he,
        bk, qk, un, lf, True{}) : PP(_)
      kx.hkeys(ds, last, g9, k3.nz(g0), rw, hs, he, [], bk, qk, un, lf, True{}, SCon{']', rest}, PP, eo, +b2 => +q2 =>
        +u2 => +l2 =>
        %ap.hend(True{}, rw, hs, he, k3.acc(ds, last, k3.nz(g0), []), b2, q2, u2, l2, Laws.k3.dk.names(ds, last),
          rows2, bd2, heads2, rest, k3.ne(ds, last, k3.ps0(k3.nz(g0), [])), k3.path(k3.nz(g0), ds, last), ew) : PP(_)
        ih(b2, q2, u2, l2))

# a table header of the grammar, from the start of a line in any table,
# whatever its walk returns, with any claim about the document the rest
# reads to in its table
def aq.table(
  +tb: Laws.GTable,
  +tail: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ab: Bool,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +rows2: List<&2, T.Val>,
  +bd2: String,
  +heads2: List<&2, String>,
  -PP: T.Doc -> Type,
  +hok: {Laws.g.ok.table(tb) == True{} : Bool},
  ew: ap.Wk(Laws.g.key.names(ap.tkey(tb)), rw, Laws.header_job(ap.tarr(tb)), hs, T.End{rows2, bd2, heads2}),
  ih: aq.HLP(bd2, rows2, heads2, Laws.g.key.names(ap.tkey(tb)), tail, PP)
) -> PP(T.doc.read(Laws.g.table.text(tb, tail), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, ab)})):
  %Equal.sym(String, Laws.g.table.text(tb, tail), Laws.k3.hd.text(ap.tarr(tb), ap.gs(ap.tw1(tb)), ap.kds(ap.tkey(tb)),
    ap.klast(ap.tkey(tb)), ap.gs(ap.tw2(tb)), tail), ap.tbl.text(tb, tail, hok)) : PP(T.doc.read(_,
      T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, ab)}))
  aq.hcore(ap.tarr(tb), ap.gs(ap.tw1(tb)), ap.kds(ap.tkey(tb)), ap.klast(ap.tkey(tb)), ap.gs(ap.tw2(tb)), rw, hs, he,
    ab, bk, qk, un, lf, rows2, bd2, heads2, tail, PP, ap.key.ok(ap.tkey(tb), ap.tbl.hk(tb, hok)), ap.tp(ns =>
      ap.Wk(ns, rw, Laws.header_job(ap.tarr(tb)), hs, T.End{rows2, bd2, heads2}), Laws.g.key.names(ap.tkey(tb)),
        Laws.k3.dk.names(ap.kds(ap.tkey(tb)), ap.klast(ap.tkey(tb))), ap.key.names(ap.tkey(tb)), ew), ap.tp(ns =>
          aq.HLP(bd2, rows2, heads2, ns, tail, PP), Laws.g.key.names(ap.tkey(tb)),
            Laws.k3.dk.names(ap.kds(ap.tkey(tb)), ap.klast(ap.tkey(tb))), ap.key.names(ap.tkey(tb)), ih))

# a header and what follows it, with its walk's result named: own reads the
# document as the replay from the walk's end read out
def aq.xtab(
  +tb: Laws.GTable,
  +w2: String,
  +com: Laws.GCom,
  +tail: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ls: List<&2, Laws.GLine>,
  +en: T.End,
  +hen: ap.Wk(Laws.g.key.names(ap.tkey(tb)), rw, Laws.header_job(ap.tarr(tb)), hs, en),
  +hok: {Laws.g.ok.table(tb) == True{} : Bool},
  +hw: {Laws.abnf.ws(w2) == True{} : Bool},
  +hc: {Laws.g.ok.com(com) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls)
) -> {Laws.own(T.doc.read(Laws.g.table.text(tb, String.append(w2, Laws.g.com.text(com, tail))), T.MScan{ap.s(T.LTop{},
  bk, rw, hs, he, [], qk, [], un, lf, False{})})) == ap.F(ls, Laws.replay.end(ow.end(en),
    Laws.g.key.names(ap.tkey(tb)))) : T.Doc}:
  match en:
    case T.End{+rows2, +bd2, +heads2}:
      aq.table(tb, String.append(w2, Laws.g.com.text(com, tail)), rw, hs, he, False{}, bk, qk, un, lf, rows2, bd2,
        heads2, dd => {Laws.own(dd) == ap.F(ls, Laws.RpSt{bd2, Laws.own.rows(rows2), heads2,
          Laws.g.key.names(ap.tkey(tb))}) : T.Doc}, hok, hen, aq.hl(bd2, rows2, heads2, Laws.g.key.names(ap.tkey(tb)),
            w2, com, tail, ls, hw, hc, kk, ee))

# a header and what follows it, as its walk replays on the rows read out
def aq.xtb2(
  +tb: Laws.GTable,
  +w1: String,
  +w2: String,
  +com: Laws.GCom,
  +tail: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ls: List<&2, Laws.GLine>,
  +hok: {Laws.g.ok.table(tb) == True{} : Bool},
  +hw: {Laws.abnf.ws(w2) == True{} : Bool},
  +hc: {Laws.g.ok.com(com) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls)
) -> {Laws.own(T.doc.read(Laws.g.table.text(tb, String.append(w2, Laws.g.com.text(com, tail))), T.MScan{ap.s(T.LTop{},
  bk, rw, hs, he, [], qk, [], un, lf, False{})})) == ap.F(ls, Laws.replay.expr(Laws.GxTable{w1, tb, w2, com},
    Laws.RpSt{"", Laws.own.rows(rw), hs, he})) : T.Doc}:
  match tb:
    case Laws.GStdTable{+v1, +key, +v2}:
      %ow.walk(Laws.g.key.names(key), T.Tw{rw, T.JDef{}, [], "", "", hs, False{}},
        0) : {Laws.own(T.doc.read(Laws.g.table.text(Laws.GStdTable{v1, key, v2}, String.append(w2,
          Laws.g.com.text(com, tail))), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf,
            False{})})) == ap.F(ls, Laws.replay.end(_, Laws.g.key.names(key))) : T.Doc}
      aq.xtab(Laws.GStdTable{v1, key, v2}, w2, com, tail, rw, hs, he, bk, qk, un, lf, ls,
        T.tree.walk(Laws.g.key.names(key), T.Tw{rw, T.JDef{}, [], "", "", hs, False{}}, 0), {==}, hok, hw, hc, kk, ee)
    case Laws.GArrayTable{+v1, +key, +v2}:
      %ow.walk(Laws.g.key.names(key), T.Tw{rw, T.JAot{}, [], "", "", hs, False{}},
        0) : {Laws.own(T.doc.read(Laws.g.table.text(Laws.GArrayTable{v1, key, v2}, String.append(w2,
          Laws.g.com.text(com, tail))), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf,
            False{})})) == ap.F(ls, Laws.replay.end(_, Laws.g.key.names(key))) : T.Doc}
      aq.xtab(Laws.GArrayTable{v1, key, v2}, w2, com, tail, rw, hs, he, bk, qk, un, lf, ls,
        T.tree.walk(Laws.g.key.names(key), T.Tw{rw, T.JAot{}, [], "", "", hs, False{}}, 0), {==}, hok, hw, hc, kk, ee)

# a header line: its blank space, the header and what follows it
def aq.xtb(
  +tb: Laws.GTable,
  +w1: String,
  +w2: String,
  +com: Laws.GCom,
  +tail: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ls: List<&2, Laws.GLine>,
  +hx: {Laws.g.ok.expr(Laws.GxTable{w1, tb, w2, com}) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls)
) -> {Laws.own(T.doc.read(Laws.g.expr.text(Laws.GxTable{w1, tb, w2, com}, tail), T.MScan{ap.s(T.LTop{}, bk, rw, hs,
  he, [], qk, [], un, lf, False{})})) == ap.F(ls, Laws.replay.expr(Laws.GxTable{w1, tb, w2, com}, Laws.RpSt{"",
    Laws.own.rows(rw), hs, he})) : T.Doc}:
  +hr = {Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.g.ok.table(tb), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))),
    hx) : {Bool.and(Laws.g.ok.table(tb), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))) == True{} : Bool}}
  +hr2 = {Eq.and.right(Laws.g.ok.table(tb), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com)),
    hr) : {Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com)) == True{} : Bool}}
  Equal.trans(T.Doc, Laws.own(T.doc.read(Laws.g.expr.text(Laws.GxTable{w1, tb, w2, com}, tail), T.MScan{ap.s(T.LTop{},
    bk, rw, hs, he, [], qk, [], un, lf, False{})})), Laws.own(T.doc.read(Laws.g.table.text(tb, String.append(w2,
      Laws.g.com.text(com, tail))), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})})), ap.F(ls,
        Laws.replay.expr(Laws.GxTable{w1, tb, w2, com}, Laws.RpSt{"", Laws.own.rows(rw), hs, he})), Equal.cong(T.Doc,
          T.Doc, dd => Laws.own(dd), T.doc.read(Laws.g.expr.text(Laws.GxTable{w1, tb, w2, com}, tail),
            T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})}), T.doc.read(Laws.g.table.text(tb,
              String.append(w2, Laws.g.com.text(com, tail))), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un,
                lf, False{})}), ap.ws(w1, Laws.g.table.text(tb, String.append(w2, Laws.g.com.text(com, tail))),
                  T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{}, {==}, Eq.and.left(Laws.abnf.ws(w1),
                    Bool.and(Laws.g.ok.table(tb), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com))), hx))), aq.xtb2(tb,
                      w1, w2, com, tail, rw, hs, he, bk, qk, un, lf, ls, Eq.and.left(Laws.g.ok.table(tb),
                        Bool.and(Laws.abnf.ws(w2), Laws.g.ok.com(com)), hr), Eq.and.left(Laws.abnf.ws(w2),
                          Laws.g.ok.com(com), hr2), Eq.and.right(Laws.abnf.ws(w2), Laws.g.ok.com(com), hr2), kk, ee))

# a list a claim holds of, spelled out and back
def aq.tlp(
  -QQ: List<&2, Char> -> Type,
  +cs: List<&2, Char>,
  hh: QQ(cs)
) -> QQ(String.to_list(String.from_list(cs))):
  %Equal.sym(List<&2, Char>, String.to_list(String.from_list(cs)), cs, gd.tlfl(cs)) : QQ(_)
  hh

# a bare word of the grammar, the characters a value node holds
def aq.word(
  +cs: List<&2, Char>,
  +rest: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  +hw: {Laws.bw.word(String.from_list(cs)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  kk: aq.vk(Laws.replay.got(T.word.val(cs), ""), rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(String.from_list(cs), rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf,
  ab)})):
  aq.wgot(T.word.val(cs), String.from_list(cs), rest, rw, hs, he, ps, bk, qk, sk, un, lf, ab, PP, hw,
    Equal.cong(List<&2, Char>, T.Got, xs => T.word.val(xs), String.to_list(String.from_list(cs)), cs, gd.tlfl(cs)),
      hf, kk)

# the names pushed while reading a key, reversed, are the key's
def aq.kpath(
  +key: Laws.GKey
) -> {List.reverse(&2, String, k3.acc(ap.kds(key), ap.klast(key), False{}, [])) == Laws.g.key.names(key) : List<&2,
  String>}:
  Equal.trans(List<&2, String>, List.reverse(&2, String, k3.acc(ap.kds(key), ap.klast(key), False{}, [])),
    Laws.k3.dk.names(ap.kds(key), ap.klast(key)), Laws.g.key.names(key), k3.path(False{}, ap.kds(key), ap.klast(key)),
      Equal.sym(List<&2, String>, Laws.g.key.names(key), Laws.k3.dk.names(ap.kds(key), ap.klast(key)),
        ap.key.names(key)))

# WP-A: arrays and inline tables, the steps. An array opens with a frame
# for its items (aq.aopen), passes blank space, comments and newlines over
# in LArr and LArrC (aq.wcn), takes each item into the frame (take.top),
# waits for another after a comma, and closes into the value of its items in
# order (aq.aclose). An inline table opens with a frame for its rows
# (aq.iopen), walks each keyval into them (take.inl), and closes into the
# value of its rows sealed (aq.iclose). An item's value is read as in a
# keyval once its first character is held (aq.vst, vl.arr.eq). own reads
# items in a list (cv.own1), and commutes with inl.seal (aq.oinl).

# the scanner waiting for a value: as an array's item (m) or after `=`
def aq.vst(
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> T.St:
  match m:
    case True{}:
      Laws.s1.apos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)
    case False{}:
      Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)

# the back state an item's first character leaves: LVal, as it is held
def aq.bk0(+m: Bool, +bk: T.Lex) -> T.Lex:
  match m:
    case True{}:
      T.LVal{}
    case False{}:
      bk

# where an array waits after its items: for another (LArr, after a comma)
# or for a comma or the end (LArrC)
def aq.alx(+sp: Bool) -> T.Lex:
  match sp:
    case True{}:
      T.LArr{}
    case False{}:
      T.LArrC{}

# where an inline table's keyval starts: after the brace, or after a comma
def aq.kpos(+pos: Bool) -> Laws.KPos:
  match pos:
    case True{}:
      Laws.AtInlK{}
    case False{}:
      Laws.AtInl{}

# where an inline table closes: empty (LInl), or after a keyval (LInlC)
def aq.ilx(+cl: Bool) -> T.Lex:
  match cl:
    case True{}:
      T.LInlC{}
    case False{}:
      T.LInl{}

# an array's lex states pass blank space over
def aq.alx.wsl(+sp: Bool) -> {ap.wsl(aq.alx(sp)) == True{} : Bool}:
  match sp:
    case True{}:
      {==}
    case False{}:
      {==}

# and take a comment
def aq.alx.coml(+sp: Bool) -> {ap.coml(aq.alx(sp)) == True{} : Bool}:
  match sp:
    case True{}:
      {==}
    case False{}:
      {==}

# and stay after a newline
def aq.alx.nlx(+sp: Bool) -> {ap.nlx(aq.alx(sp)) == aq.alx(sp) : T.Lex}:
  match sp:
    case True{}:
      {==}
    case False{}:
      {==}

# a value placed in a table leaves nothing held
def aq.once.r(
  en: T.End,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.read.once2(T.take.root(en, he, bk, qk, un, lf, ab, False{})) == T.take.root(en, he, bk, qk, un, lf, ab,
  False{}) : T.St}:
  match en:
    case T.End{_rows, _bad, _heads}:
      {==}

# nor does one placed in an inline table
def aq.once.i(
  en: T.End,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.read.once2(T.take.inl(en, rw, hs, at, sv, sk, bk, qk, un, lf, ab, False{})) == T.take.inl(en, rw, hs, at, sv,
  sk, bk, qk, un, lf, ab, False{}) : T.St}:
  match en:
    case T.End{_rows, _bad, _heads}:
      {==}

# a value placed anywhere leaves nothing held
def aq.once(
  sk: List<&2, T.Ctx>,
  +xv: T.Val,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.read.once2(T.take.top(sk, xv, "", rw, hs, he, ps, bk, qk, un, lf, ab, False{})) == T.take.top(sk, xv, "", rw,
  hs, he, ps, bk, qk, un, lf, ab, False{}) : T.St}:
  match sk:
    case []:
      aq.once.r(T.tree.walk(T.path.cat(he, ps), T.Tw{rw, T.JPut{xv}, [], "", "", hs, False{}}, T.path.len(he, 0)), he,
        bk, qk, un, lf, ab)
    case T.CArr{_its, _sv, _at} <> _rest:
      {==}
    case T.CInl{+inl, +sv, +at} <> +rest:
      aq.once.i(T.tree.walk(List.reverse(&2, String, ps), T.Tw{inl, T.JPut{xv}, [], "", "", [], True{}}, 0), rw, hs,
        at, sv, rest, bk, qk, un, lf, ab)

# `[` opens an array: a frame for its items, the key's parts kept in it
def aq.aopen(
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.scan(aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf, ab), '[') == T.MScan{ap.s(T.LArr{}, aq.bk0(m, bk), rw,
  hs, he, [], qk, T.CArr{[], ps, he} <> sk, un, lf, ab)} : T.Mode}:
  match m:
    case True{}:
      {==}
    case False{}:
      {==}

# `{` opens an inline table: a frame for its rows
def aq.iopen(
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.scan(aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf, ab), '{') == T.MScan{ap.s(T.LInl{}, aq.bk0(m, bk), rw,
  hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)} : T.Mode}:
  match m:
    case True{}:
      {==}
    case False{}:
      {==}

# `]` closes an array: its items in order are placed as the frame's value
def aq.aclose(
  +sp: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +its: List<&2, T.Val>,
  +sv: List<&2, String>,
  +at: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.scan(ap.s(aq.alx(sp), bk, rw, hs, he, ps, qk, T.CArr{its, sv, at} <> sk, un, lf, ab),
  ']') == T.MScan{T.take.top(sk, T.VArr{List.reverse(&2, T.Val, its)}, "", rw, hs, at, sv, bk, qk, un, lf, ab,
    False{})} : T.Mode}:
  match sp:
    case True{}:
      Equal.cong(T.St, T.Mode, st => T.MScan{st}, T.read.once2(T.take.top(sk, T.VArr{List.reverse(&2, T.Val, its)},
        "", rw, hs, at, sv, bk, qk, un, lf, ab, False{})), T.take.top(sk, T.VArr{List.reverse(&2, T.Val, its)}, "",
          rw, hs, at, sv, bk, qk, un, lf, ab, False{}), aq.once(sk, T.VArr{List.reverse(&2, T.Val, its)}, rw, hs, at,
            sv, bk, qk, un, lf, ab))
    case False{}:
      Equal.cong(T.St, T.Mode, st => T.MScan{st}, T.read.once2(T.take.top(sk, T.VArr{List.reverse(&2, T.Val, its)},
        "", rw, hs, at, sv, bk, qk, un, lf, ab, False{})), T.take.top(sk, T.VArr{List.reverse(&2, T.Val, its)}, "",
          rw, hs, at, sv, bk, qk, un, lf, ab, False{}), aq.once(sk, T.VArr{List.reverse(&2, T.Val, its)}, rw, hs, at,
            sv, bk, qk, un, lf, ab))

# `}` closes an inline table: its rows sealed are placed as the frame's value
def aq.iclose(
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +inl: List<&2, T.Val>,
  +sv: List<&2, String>,
  +at: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.scan(ap.s(aq.ilx(cl), bk, rw, hs, he, ps, qk, T.CInl{inl, sv, at} <> sk, un, lf, ab),
  '}') == T.MScan{T.take.top(sk, T.VInl{T.inl.seal(inl)}, "", rw, hs, at, sv, bk, qk, un, lf, ab, False{})} : T.Mode}:
  match cl:
    case True{}:
      Equal.cong(T.St, T.Mode, st => T.MScan{st}, T.read.once2(T.take.top(sk, T.VInl{T.inl.seal(inl)}, "", rw, hs, at,
        sv, bk, qk, un, lf, ab, False{})), T.take.top(sk, T.VInl{T.inl.seal(inl)}, "", rw, hs, at, sv, bk, qk, un, lf,
          ab, False{}), aq.once(sk, T.VInl{T.inl.seal(inl)}, rw, hs, at, sv, bk, qk, un, lf, ab))
    case False{}:
      Equal.cong(T.St, T.Mode, st => T.MScan{st}, T.read.once2(T.take.top(sk, T.VInl{T.inl.seal(inl)}, "", rw, hs, at,
        sv, bk, qk, un, lf, ab, False{})), T.take.top(sk, T.VInl{T.inl.seal(inl)}, "", rw, hs, at, sv, bk, qk, un, lf,
          ab, False{}), aq.once(sk, T.VInl{T.inl.seal(inl)}, rw, hs, at, sv, bk, qk, un, lf, ab))

# ws-comment-newline in a state that passes blank space over and takes a
# comment, and stays after a newline: the rest is read from the same state,
# with the back state a comment leaves
def aq.wcn(
  ws: List<&2, Laws.GWcn>,
  +rest: String,
  +lx: T.Lex,
  +bk: T.Lex,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +hl: {ap.wsl(lx) == True{} : Bool},
  +hm: {ap.coml(lx) == True{} : Bool},
  +hn: {ap.nlx(lx) == lx : T.Lex},
  +hw: {Laws.g.ok.wcn(ws) == True{} : Bool},
  -PP: T.Doc -> Type,
  ih: @b2: T.Lex -> PP(T.doc.read(rest, T.MScan{ap.s(lx, b2, rw, hs, he, pt, qk, sk, un, lf, ab)}))
) -> PP(T.doc.read(Laws.g.wcn.text(ws, rest), T.MScan{ap.s(lx, bk, rw, hs, he, pt, qk, sk, un, lf, ab)})):
  match ws:
    case []:
      ih(bk)
    case Laws.GwWschar{+cc} <> +wr:
      %Equal.sym(T.Mode, T.doc.scan(ap.s(lx, bk, rw, hs, he, pt, qk, sk, un, lf, ab), cc), T.MScan{ap.s(lx, bk, rw,
        hs, he, pt, qk, sk, un, lf, ab)}, ap.wsc(lx, cc, bk, rw, hs, he, pt, qk, sk, un, lf, ab, hl,
          Eq.and.left(Laws.abnf.wschar(cc), Laws.g.ok.wcn(wr), hw))) : PP(T.doc.read(Laws.g.wcn.text(wr, rest), _))
      aq.wcn(wr, rest, lx, bk, rw, hs, he, pt, qk, sk, un, lf, ab, hl, hm, hn, Eq.and.right(Laws.abnf.wschar(cc),
        Laws.g.ok.wcn(wr), hw), PP, ih)
    case Laws.GwNewline{+com, +nl} <> +wr:
      +hr = {Eq.and.right(Laws.g.ok.com(com), Bool.and(Laws.abnf.newline(nl), Laws.g.ok.wcn(wr)),
        hw) : {Bool.and(Laws.abnf.newline(nl), Laws.g.ok.wcn(wr)) == True{} : Bool}}
      %Equal.sym(T.Doc, T.doc.read(Laws.g.com.text(com, String.append(nl, Laws.g.wcn.text(wr, rest))),
        T.MScan{ap.s(lx, bk, rw, hs, he, pt, qk, sk, un, lf, ab)}), T.doc.read(String.append(nl, Laws.g.wcn.text(wr,
          rest)), T.MScan{ap.aft(com, lx, bk, rw, hs, he, pt, qk, sk, un, lf, ab)}), ap.tail("", com,
            String.append(nl, Laws.g.wcn.text(wr, rest)), lx, bk, rw, hs, he, pt, qk, sk, un, lf, ab, hl, hm, {==},
              Eq.and.left(Laws.g.ok.com(com), Bool.and(Laws.abnf.newline(nl), Laws.g.ok.wcn(wr)), hw))) : PP(_)
      %Equal.sym(T.Doc, T.doc.read(String.append(nl, Laws.g.wcn.text(wr, rest)), T.MScan{ap.aft(com, lx, bk, rw, hs,
        he, pt, qk, sk, un, lf, ab)}), T.doc.read(Laws.g.wcn.text(wr, rest), T.MScan{ap.s(ap.nlx(lx), ap.abk(com, lx,
          bk), rw, hs, he, pt, qk, sk, un, lf, ab)}), ap.eol(com, lx, nl, Laws.g.wcn.text(wr, rest), bk, rw, hs, he,
            pt, qk, sk, un, lf, ab, hm, Eq.and.left(Laws.abnf.newline(nl), Laws.g.ok.wcn(wr), hr))) : PP(_)
      %Equal.sym(T.Lex, ap.nlx(lx), lx, hn) : PP(T.doc.read(Laws.g.wcn.text(wr, rest), T.MScan{ap.s(_, ap.abk(com, lx,
        bk), rw, hs, he, pt, qk, sk, un, lf, ab)}))
      aq.wcn(wr, rest, lx, ap.abk(com, lx, bk), rw, hs, he, pt, qk, sk, un, lf, ab, hl, hm, hn,
        Eq.and.right(Laws.abnf.newline(nl), Laws.g.ok.wcn(wr), hr), PP, ih)

# a follower after ws-comment-newline is one
def aq.fol.wcn(
  ws: List<&2, Laws.GWcn>,
  +xx: String,
  +hw: {Laws.g.ok.wcn(ws) == True{} : Bool},
  +hx: {aq.fol(xx) == True{} : Bool}
) -> {aq.fol(Laws.g.wcn.text(ws, xx)) == True{} : Bool}:
  match ws:
    case []:
      hx
    case Laws.GwWschar{+cc} <> +wr:
      aq.fol.ws1(cc, Laws.g.wcn.text(wr, xx), Eq.and.left(Laws.abnf.wschar(cc), Laws.g.ok.wcn(wr), hw), aq.fol.wcn(wr,
        xx, Eq.and.right(Laws.abnf.wschar(cc), Laws.g.ok.wcn(wr), hw), hx))
    case Laws.GwNewline{+com, +nl} <> +wr:
      aq.fol.com(com, String.append(nl, Laws.g.wcn.text(wr, xx)), aq.fol.nl(nl, Laws.g.wcn.text(wr, xx),
        Eq.and.left(Laws.abnf.newline(nl), Laws.g.ok.wcn(wr), Eq.and.right(Laws.g.ok.com(com),
          Bool.and(Laws.abnf.newline(nl), Laws.g.ok.wcn(wr)), hw))))

# a follower, or a comma before any text
def aq.fol.sep(
  +sep: Bool,
  +xx: String,
  +hx: {aq.fol(xx) == True{} : Bool}
) -> {aq.fol(Laws.g.sep.text(sep, xx)) == True{} : Bool}:
  match sep:
    case True{}:
      {==}
    case False{}:
      hx

# the text after ws-comment-newline in a short text is short
def aq.sh.wcn(
  +ws: List<&2, Laws.GWcn>,
  +xx: String,
  +hh: {Laws.short(Laws.g.wcn.text(ws, xx)) == True{} : Bool}
) -> {Laws.short(xx) == True{} : Bool}:
  aq.sh(Laws.g.wcn.text(ws, ""), xx, aq.shq(Laws.g.wcn.text(ws, xx), String.append(Laws.g.wcn.text(ws, ""), xx),
    gt.wcn(ws, xx), hh))

# and so is the text after a value
def aq.sh.val(
  +vv: Laws.GVal,
  +xx: String,
  +hh: {Laws.short(Laws.g.val.text(vv, xx)) == True{} : Bool}
) -> {Laws.short(xx) == True{} : Bool}:
  aq.sh(Laws.g.val.text(vv, ""), xx, aq.shq(Laws.g.val.text(vv, xx), String.append(Laws.g.val.text(vv, ""), xx),
    Laws.g_val_text_tail(vv, xx), hh))

# own reads an inline table's rows sealed as the seal of what it reads
def aq.oinl(
  xs: List<&2, T.Val>
) -> {Laws.own.rows(T.inl.seal(xs)) == T.inl.seal(Laws.own.rows(xs)) : List<&2, T.Val>}:
  match xs:
    case []:
      {==}
    case T.VPair{+nn, T.VHead{+pp, +rr}} <> +tt:
      Equal.trans(List<&2, T.Val>, T.VPair{nn,
        T.VInl{Laws.own.rows(T.inl.seal(rr))}} <> Laws.own.rows(T.inl.seal(tt)), T.VPair{nn,
          T.VInl{T.inl.seal(Laws.own.rows(rr))}} <> Laws.own.rows(T.inl.seal(tt)), T.VPair{nn,
            T.VInl{T.inl.seal(Laws.own.rows(rr))}} <> T.inl.seal(Laws.own.rows(tt)), Equal.cong(List<&2, T.Val>,
              List<&2, T.Val>, zs => T.VPair{nn, T.VInl{zs}} <> Laws.own.rows(T.inl.seal(tt)),
                Laws.own.rows(T.inl.seal(rr)), T.inl.seal(Laws.own.rows(rr)), aq.oinl(rr)), Equal.cong(List<&2,
                  T.Val>, List<&2, T.Val>, zs => T.VPair{nn, T.VInl{T.inl.seal(Laws.own.rows(rr))}} <> zs,
                    Laws.own.rows(T.inl.seal(tt)), T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt)))
    case T.VStr{+a0} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VStr{a0}) <> zs, Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VSpan{+a0, +a1} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VSpan{a0, a1}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VInt{+a0, +a1} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VInt{a0, a1}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VFlo{+a0, +a1} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VFlo{a0, a1}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VBool{+a0} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VBool{a0}) <> zs, Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VWhen{+a0} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VWhen{a0}) <> zs, Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VArr{+a0} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VArr{a0}) <> zs, Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VInl{+a0} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VInl{a0}) <> zs, Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VHead{+a0, +a1} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VHead{a0, a1}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VAot{+a0, +a1} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VAot{a0, a1}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VAots{+a0, +a1} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VAots{a0, a1}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VStr{+b0}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VStr{b0}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VSpan{+b0, +b1}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VSpan{b0, b1}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VInt{+b0, +b1}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VInt{b0, b1}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VFlo{+b0, +b1}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VFlo{b0, b1}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VBool{+b0}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VBool{b0}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VWhen{+b0}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VWhen{b0}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VArr{+b0}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VArr{b0}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VInl{+b0}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VInl{b0}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VAot{+b0, +b1}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VAot{b0, b1}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VAots{+b0, +b1}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VAots{b0, b1}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))
    case T.VPair{+nn, T.VPair{+b0, +b1}} <> +tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => Laws.cv.own1(T.VPair{nn, T.VPair{b0, b1}}) <> zs,
        Laws.own.rows(T.inl.seal(tt)),
        T.inl.seal(Laws.own.rows(tt)), aq.oinl(tt))

# a value own reads as vv in a list, and the rest as ri: the list with it in
# front as vv in front of ri
def aq.cons2(
  +xv: T.Val,
  +its: List<&2, T.Val>,
  +vv: T.Val,
  +ri: List<&2, T.Val>,
  +hc: {Laws.cv.own1(xv) == vv : T.Val},
  +hi: {Laws.own.rows(its) == ri : List<&2, T.Val>}
) -> {Laws.own.rows(xv <> its) == vv <> ri : List<&2, T.Val>}:
  %Equal.sym(List<&2, T.Val>, Laws.own.rows(xv <> its), Laws.cv.own1(xv) <> Laws.own.rows(its), cv.own.cons(xv, its))
    : {_ == vv <> ri : List<&2, T.Val>}
  %Equal.sym(T.Val, Laws.cv.own1(xv), vv, hc) : {_ <> Laws.own.rows(its) == vv <> ri : List<&2, T.Val>}
  %Equal.sym(List<&2, T.Val>, Laws.own.rows(its), ri, hi) : {vv <> _ == vv <> ri : List<&2, T.Val>}
  {==}

# WP-A: values of every kind, nested to any depth. One induction over the
# value nodes (aq.rd) proves three claims of each: as a value from a value
# state or an array's item (aq.VT), as an array's items from where the
# array waits for one (aq.IT), and as an inline table's keyvals from where
# it waits for a key (aq.KT); the claims a node's rule rules out hold as g.ok
# refuses it (aq.nov, aq.noi, aq.nok). Each is taken over its continuation:
# the rest of the text read, own-level, to a document G, from the state the
# node leaves: a value placed (aq.vk), the frame's items (aq.ik), or the
# frame's rows (aq.rk); or, from an error the node sets, the document of the
# error and the rows as they were, which the replay keeps from then on.

# the rest after an array's items, by the replay's error: with none, from
# where the array waits after its items, with items own reads as the
# replay's; with one, the document of the error and the rows
def aq.ik2(
  +bd: String,
  +_ri: List<&2, T.Val>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  PP: T.Doc -> Type
) -> Type:
  match bd:
    case SNil{}:
      @its: List<&2, T.Val> -> @sp: Bool -> @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
        @hi: {Laws.own.rows(its) == _ri : List<&2, T.Val>} ->
        PP(T.doc.read(rest, T.MScan{ap.s(aq.alx(sp), b2, rw, hs, at, sv, q2, T.CArr{its, sv, at} <> sk0, u2, l2, ab)}))
    case SCon{+c0, +cs}:
      PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)})

# the rest after an array's items, by the replay's reading of them
def aq.ik(
  +rr: Laws.RpAcc,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  PP: T.Doc -> Type
) -> Type:
  match rr:
    case Laws.RaItems{ri, bd}:
      aq.ik2(bd, ri, rw, hs, at, sv, sk0, ab, rest, PP)
    case Laws.RaVal{_v, _b}:
      Unit
    case Laws.RaRows{_r, _b}:
      Unit

# the rest after an inline table's keyvals, by the replay's error: with
# none, from where the table waits after a keyval, with rows own reads as
# the replay's; with one, the document of the error and the rows
def aq.rk2(
  +bd: String,
  +_ri: List<&2, T.Val>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  PP: T.Doc -> Type
) -> Type:
  match bd:
    case SNil{}:
      @inl: List<&2, T.Val> -> @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
        @hi: {Laws.own.rows(inl) == _ri : List<&2, T.Val>} ->
        PP(T.doc.read(rest, T.MScan{ap.s(T.LInlC{}, b2, rw, hs, at, [], q2, T.CInl{inl, sv, at} <> sk0, u2, l2, ab)}))
    case SCon{+c0, +cs}:
      PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)})

# the rest after an inline table's keyvals, by the replay's reading of them
def aq.rk(
  +rr: Laws.RpAcc,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  PP: T.Doc -> Type
) -> Type:
  match rr:
    case Laws.RaRows{ri, bd}:
      aq.rk2(bd, ri, rw, hs, at, sv, sk0, ab, rest, PP)
    case Laws.RaVal{_v, _b}:
      Unit
    case Laws.RaItems{_i, _b}:
      Unit

# the continuations over the claim that own reads the document as G
def aq.VKG(
  +rr: Laws.RpAcc,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc
) -> Type:
  aq.vk(rr, rw, hs, he, ps, sk, ab, rest, dd => {Laws.own(dd) == G : T.Doc})

# of the items
def aq.IKG(
  +rr: Laws.RpAcc,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc
) -> Type:
  aq.ik(rr, rw, hs, at, sv, sk0, ab, rest, dd => {Laws.own(dd) == G : T.Doc})

# and of the rows
def aq.RKG(
  +rr: Laws.RpAcc,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc
) -> Type:
  aq.rk(rr, rw, hs, at, sv, sk0, ab, rest, dd => {Laws.own(dd) == G : T.Doc})

# the continuation of a value node read from no error
def aq.VKV(
  +val: Laws.GVal,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc
) -> Type:
  aq.VKG(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), rw, hs, he, ps, sk, ab, rest, G)

# the items continuation of a node read from the items ri
def aq.IKN(
  +nd: Laws.GVal,
  +ri: List<&2, T.Val>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc
) -> Type:
  aq.IKG(Laws.replay.go(nd, Laws.RaItems{ri, ""}), rw, hs, at, sv, sk0, ab, rest, G)

# and the rows continuation of one read from the rows ri
def aq.RKN(
  +nd: Laws.GVal,
  +ri: List<&2, T.Val>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc
) -> Type:
  aq.RKG(Laws.replay.go(nd, Laws.RaRows{ri, ""}), rw, hs, at, sv, sk0, ab, rest, G)

# the items after an error, from any items read so far, to the document of
# the error and the rows
def aq.IKE(
  +_rv: Laws.GVal,
  +c0: Char,
  +cs: String,
  +rw: List<&2, T.Val>,
  +_hs: List<&2, String>,
  +_at: List<&2, String>,
  +_sv: List<&2, String>,
  +_sk0: List<&2, T.Ctx>,
  +_ab: Bool,
  +_rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @x2: List<&2, T.Val> -> aq.ik(Laws.replay.go(_rv, Laws.RaItems{x2, SCon{c0, cs}}), rw, _hs, _at, _sv, _sk0, _ab,
    _rest, PP) ->
    PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)})

# a continuation over one reading holds over an equal one
def aq.vkt(
  +r1: Laws.RpAcc,
  +r2: Laws.RpAcc,
  +ee: {r1 == r2 : Laws.RpAcc},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  kk: aq.vk(r1, rw, hs, he, ps, sk, ab, rest, PP)
) -> aq.vk(r2, rw, hs, he, ps, sk, ab, rest, PP):
  %ee : aq.vk(_, rw, hs, he, ps, sk, ab, rest, PP)
  kk

# and so does one over the items
def aq.ikt(
  +r1: Laws.RpAcc,
  +r2: Laws.RpAcc,
  +ee: {r1 == r2 : Laws.RpAcc},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  kk: aq.ik(r1, rw, hs, at, sv, sk0, ab, rest, PP)
) -> aq.ik(r2, rw, hs, at, sv, sk0, ab, rest, PP):
  %ee : aq.ik(_, rw, hs, at, sv, sk0, ab, rest, PP)
  kk

# and one over the rows
def aq.rkt(
  +r1: Laws.RpAcc,
  +r2: Laws.RpAcc,
  +ee: {r1 == r2 : Laws.RpAcc},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  kk: aq.rk(r1, rw, hs, at, sv, sk0, ab, rest, PP)
) -> aq.rk(r2, rw, hs, at, sv, sk0, ab, rest, PP):
  %ee : aq.rk(_, rw, hs, at, sv, sk0, ab, rest, PP)
  kk

# whether a node is an inline table's keyvals or one keyval, as its rule
# allows
def aq.kvok(nd: Laws.GVal) -> Bool:
  match nd:
    case Laws.GKeyval{k, a, b, v}:
      Laws.g.ok.val(Laws.GKeyval{k, a, b, v}, Laws.RKeyval{})
    case Laws.GInlineTableKeyvals{kv, a, b, r}:
      Laws.g.ok.val(Laws.GInlineTableKeyvals{kv, a, b, r}, Laws.RInlineTableKeyvals{})
    case Laws.GInlineTableKeyvalsLast{kv}:
      Laws.g.ok.val(Laws.GInlineTableKeyvalsLast{kv}, Laws.RInlineTableKeyvals{})
    case _:
      False{}

# a keyval of the grammar is one aq.kvok takes
def aq.kvok.k(
  nd: Laws.GVal,
  +hh: {Laws.g.ok.val(nd, Laws.RKeyval{}) == True{} : Bool}
) -> {aq.kvok(nd) == True{} : Bool}:
  match nd:
    case Laws.GvString{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvString{_a0}) == True{} : Bool}, hh)
    case Laws.GvBoolean{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvBoolean{_a0}) == True{} : Bool}, hh)
    case Laws.GvArrayEmpty{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvArrayEmpty{_a0}) == True{} : Bool}, hh)
    case Laws.GvArray{_a0, _a1}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvArray{_a0, _a1}) == True{} : Bool}, hh)
    case Laws.GvInlineTableEmpty{_a0, _a1}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvInlineTableEmpty{_a0, _a1}) == True{} : Bool}, hh)
    case Laws.GvInlineTable{_a0, _a1, _a2}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvInlineTable{_a0, _a1, _a2}) == True{} : Bool}, hh)
    case Laws.GvDateTime{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvDateTime{_a0}) == True{} : Bool}, hh)
    case Laws.GvFloat{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvFloat{_a0}) == True{} : Bool}, hh)
    case Laws.GvInteger{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvInteger{_a0}) == True{} : Bool}, hh)
    case Laws.GArrayValues{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GArrayValues{_a0, _a1, _a2, _a3}) == True{} : Bool}, hh)
    case Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}) == True{} : Bool}, hh)
    case Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}) == True{} : Bool}, hh)
    case Laws.GInlineTableKeyvalsLast{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GInlineTableKeyvalsLast{_a0}) == True{} : Bool}, hh)
    case Laws.GKeyval{_a0, _a1, _a2, _a3}:
      hh

# and so are an inline table's keyvals
def aq.kvok.i(
  nd: Laws.GVal,
  +hh: {Laws.g.ok.val(nd, Laws.RInlineTableKeyvals{}) == True{} : Bool}
) -> {aq.kvok(nd) == True{} : Bool}:
  match nd:
    case Laws.GvString{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvString{_a0}) == True{} : Bool}, hh)
    case Laws.GvBoolean{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvBoolean{_a0}) == True{} : Bool}, hh)
    case Laws.GvArrayEmpty{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvArrayEmpty{_a0}) == True{} : Bool}, hh)
    case Laws.GvArray{_a0, _a1}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvArray{_a0, _a1}) == True{} : Bool}, hh)
    case Laws.GvInlineTableEmpty{_a0, _a1}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvInlineTableEmpty{_a0, _a1}) == True{} : Bool}, hh)
    case Laws.GvInlineTable{_a0, _a1, _a2}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvInlineTable{_a0, _a1, _a2}) == True{} : Bool}, hh)
    case Laws.GvDateTime{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvDateTime{_a0}) == True{} : Bool}, hh)
    case Laws.GvFloat{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvFloat{_a0}) == True{} : Bool}, hh)
    case Laws.GvInteger{_a0}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GvInteger{_a0}) == True{} : Bool}, hh)
    case Laws.GArrayValues{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GArrayValues{_a0, _a1, _a2, _a3}) == True{} : Bool}, hh)
    case Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}) == True{} : Bool}, hh)
    case Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}:
      hh
    case Laws.GInlineTableKeyvalsLast{_a0}:
      hh
    case Laws.GKeyval{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {aq.kvok(Laws.GKeyval{_a0, _a1, _a2, _a3}) == True{} : Bool}, hh)

# a value node reads the same from every reading with the same error
def aq.goval(
  vv: Laws.GVal,
  +acc: Laws.RpAcc,
  +ok: {Laws.g.ok.val(vv, Laws.RVal{}) == True{} : Bool}
) -> {Laws.replay.go(vv, acc) == Laws.replay.go(vv, Laws.RaVal{T.VArr{[]}, Laws.replay.bad(acc)}) : Laws.RpAcc}:
  match vv:
    case Laws.GvString{_a0}:
      {==}
    case Laws.GvBoolean{_a0}:
      {==}
    case Laws.GvArrayEmpty{_a0}:
      {==}
    case Laws.GvArray{_a0, _a1}:
      {==}
    case Laws.GvInlineTableEmpty{_a0, _a1}:
      {==}
    case Laws.GvInlineTable{_a0, _a1, _a2}:
      {==}
    case Laws.GvDateTime{_a0}:
      {==}
    case Laws.GvFloat{_a0}:
      {==}
    case Laws.GvInteger{_a0}:
      {==}
    case Laws.GArrayValues{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GArrayValues{_a0, _a1, _a2, _a3},
        acc) == Laws.replay.go(Laws.GArrayValues{_a0, _a1, _a2, _a3}, Laws.RaVal{T.VArr{[]},
          Laws.replay.bad(acc)}) : Laws.RpAcc}, ok)
    case Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GArrayValuesLast{_a0, _a1, _a2, _a3},
        acc) == Laws.replay.go(Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}, Laws.RaVal{T.VArr{[]},
          Laws.replay.bad(acc)}) : Laws.RpAcc}, ok)
    case Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3},
        acc) == Laws.replay.go(Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}, Laws.RaVal{T.VArr{[]},
          Laws.replay.bad(acc)}) : Laws.RpAcc}, ok)
    case Laws.GInlineTableKeyvalsLast{_a0}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GInlineTableKeyvalsLast{_a0},
        acc) == Laws.replay.go(Laws.GInlineTableKeyvalsLast{_a0}, Laws.RaVal{T.VArr{[]},
          Laws.replay.bad(acc)}) : Laws.RpAcc}, ok)
    case Laws.GKeyval{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GKeyval{_a0, _a1, _a2, _a3}, acc) == Laws.replay.go(Laws.GKeyval{_a0,
        _a1, _a2, _a3}, Laws.RaVal{T.VArr{[]}, Laws.replay.bad(acc)}) : Laws.RpAcc}, ok)

# a value read from an array's item or after `=`, then the rest: own reads
# the document as G, given the continuation
def aq.VT(+val: Laws.GVal) -> Type:
  @m: Bool -> @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @he: List<&2, String> -> @ps: List<&2, String> ->
    @bk: T.Lex -> @qk: T.QKind -> @sk: List<&2, T.Ctx> -> @un: U32 -> @lf: U32 -> @ab: Bool -> @rest: String ->
    @G: T.Doc -> @ok: {Laws.g.ok.val(val, Laws.RVal{}) == True{} : Bool} ->
    @es: {Laws.short(Laws.g.val.text(val, rest)) == True{} : Bool} -> @hf: {aq.fol(rest) == True{} : Bool} ->
    @kk: aq.vk(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), rw, hs, he, ps, sk, ab, rest, dd =>
      {Laws.own(dd) == G : T.Doc}) ->
    {Laws.own(T.doc.read(Laws.g.val.text(val, rest), T.MScan{aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf,
      ab)})) == G : T.Doc}

# an array's items read from where it waits for one, then the rest
def aq.IT(+nd: Laws.GVal) -> Type:
  @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @at: List<&2, String> -> @p: List<&2, String> ->
    @sv: List<&2, String> -> @sk0: List<&2, T.Ctx> -> @its: List<&2, T.Val> -> @ri: List<&2, T.Val> -> @bk: T.Lex ->
    @qk: T.QKind -> @un: U32 -> @lf: U32 -> @ab: Bool -> @rest: String -> @G: T.Doc ->
    @ok: {Laws.g.ok.val(nd, Laws.RArrayValues{}) == True{} : Bool} ->
    @es: {Laws.short(Laws.g.val.text(nd, rest)) == True{} : Bool} -> @hf: {aq.fol(rest) == True{} : Bool} ->
    @hi: {Laws.own.rows(its) == ri : List<&2, T.Val>} ->
    @kk: aq.ik(Laws.replay.go(nd, Laws.RaItems{ri, ""}), rw, hs, at, sv, sk0, ab, rest, dd =>
      {Laws.own(dd) == G : T.Doc}) ->
    {Laws.own(T.doc.read(Laws.g.val.text(nd, rest), T.MScan{ap.s(T.LArr{}, bk, rw, hs, at, p, qk, T.CArr{its, sv,
      at} <> sk0, un, lf, ab)})) == G : T.Doc}

# an inline table's keyvals read from where it waits for a key, then the
# rest
def aq.KT(+nd: Laws.GVal) -> Type:
  @pos: Bool -> @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @at: List<&2, String> -> @sv: List<&2, String> ->
    @sk0: List<&2, T.Ctx> -> @inl: List<&2, T.Val> -> @ri: List<&2, T.Val> -> @bk: T.Lex -> @qk: T.QKind -> @un: U32 ->
    @lf: U32 -> @ab: Bool -> @rest: String -> @G: T.Doc -> @ok: {aq.kvok(nd) == True{} : Bool} ->
    @es: {Laws.short(Laws.g.val.text(nd, rest)) == True{} : Bool} -> @hf: {aq.fol(rest) == True{} : Bool} ->
    @hi: {Laws.own.rows(inl) == ri : List<&2, T.Val>} ->
    @kk: aq.rk(Laws.replay.go(nd, Laws.RaRows{ri, ""}), rw, hs, at, sv, sk0, ab, rest, dd =>
      {Laws.own(dd) == G : T.Doc}) ->
    {Laws.own(T.doc.read(Laws.g.val.text(nd, rest), T.MScan{ap.s(Laws.k3.pos.lex(aq.kpos(pos)), bk, rw, hs, at, [],
      qk, T.CInl{inl, sv, at} <> sk0, un, lf, ab)})) == G : T.Doc}

# one of the three claims: a value (a), the items (b), or the keyvals
def aq.RDW(+a: Bool, +b: Bool, +nd: Laws.GVal) -> Type:
  match a:
    case True{}:
      aq.VT(nd)
    case False{}:
      match b:
        case True{}:
          aq.IT(nd)
        case False{}:
          aq.KT(nd)

# the three claims of a node
def aq.RD(+_nd: Laws.GVal) -> Type:
  @a: Bool -> @b: Bool -> aq.RDW(a, b, _nd)

# the claim asked for, from the three
def aq.pick(
  +a: Bool,
  +b: Bool,
  +_nd: Laws.GVal,
  pv: aq.VT(_nd),
  pi: aq.IT(_nd),
  pk: aq.KT(_nd)
) -> aq.RDW(a, b, _nd):
  match a:
    case True{}:
      pv
    case False{}:
      match b:
        case True{}:
          pi
        case False{}:
          pk

# a node the value rule refuses: the value claim holds as g.ok refuses it
def aq.nov(
  +nd: Laws.GVal,
  +hh: {Laws.g.ok.val(nd, Laws.RVal{}) == False{} : Bool}
) -> aq.VT(nd):
  +m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => ok => _es => _hf => _kk =>
    Eq.bit.absurd(&2, {Laws.own(T.doc.read(Laws.g.val.text(nd, rest), T.MScan{aq.vst(m, rw, hs, he, ps, bk, qk, sk,
      un, lf, ab)})) == G : T.Doc}, Equal.trans(Bool, False{}, Laws.g.ok.val(nd, Laws.RVal{}), True{}, Equal.sym(Bool,
        Laws.g.ok.val(nd, Laws.RVal{}), False{}, hh), ok))

# a node the array-values rule refuses: the items claim holds so
def aq.noi(
  +nd: Laws.GVal,
  +hh: {Laws.g.ok.val(nd, Laws.RArrayValues{}) == False{} : Bool}
) -> aq.IT(nd):
  +rw => +hs => +at => +p => +sv => +sk0 => +its => +_ri => +bk => +qk => +un => +lf => +ab => +rest => +G => ok =>
    _es => _hf => _hi => _kk =>
    Eq.bit.absurd(&2, {Laws.own(T.doc.read(Laws.g.val.text(nd, rest), T.MScan{ap.s(T.LArr{}, bk, rw, hs, at, p, qk,
      T.CArr{its, sv, at} <> sk0, un, lf, ab)})) == G : T.Doc}, Equal.trans(Bool, False{}, Laws.g.ok.val(nd,
        Laws.RArrayValues{}), True{}, Equal.sym(Bool, Laws.g.ok.val(nd, Laws.RArrayValues{}), False{}, hh), ok))

# a node that is no inline table's keyvals: the keyvals claim holds so
def aq.nok(
  +nd: Laws.GVal,
  +hh: {aq.kvok(nd) == False{} : Bool}
) -> aq.KT(nd):
  +pos => +rw => +hs => +at => +sv => +sk0 => +inl => +_ri => +bk => +qk => +un => +lf => +ab => +rest => +G => ok =>
    _es => _hf => _hi => _kk =>
    Eq.bit.absurd(&2, {Laws.own(T.doc.read(Laws.g.val.text(nd, rest), T.MScan{ap.s(Laws.k3.pos.lex(aq.kpos(pos)), bk,
      rw, hs, at, [], qk, T.CInl{inl, sv, at} <> sk0, un, lf, ab)})) == G : T.Doc}, Equal.trans(Bool, False{},
        aq.kvok(nd), True{}, Equal.sym(Bool, aq.kvok(nd), False{}, hh), ok))

# an error an array's items reach keeps the document at the error and the
# rows: the items after one are read from it (aq.gobad)
def aq.ike.av(
  g0: Laws.RpAcc,
  +rv: Laws.GVal,
  +x: List<&2, T.Val>,
  +c0: Char,
  +cs: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hg: {Laws.replay.bad(g0) == SCon{c0, cs} : String},
  ih: aq.IKE(rv, c0, cs, rw, hs, at, sv, sk0, ab, rest, PP),
  kk: aq.ik(Laws.replay.go(rv, Laws.replay.item(g0, Laws.RaItems{x, SCon{c0, cs}})), rw, hs, at, sv, sk0, ab, rest, PP)
) -> PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}):
  match g0:
    case Laws.RaVal{+v, +b}:
      ih(v <> x, aq.ikt(Laws.replay.go(rv, Laws.RaItems{v <> x, b}), Laws.replay.go(rv, Laws.RaItems{v <> x, SCon{c0,
        cs}}), Equal.cong(String, Laws.RpAcc, bb => Laws.replay.go(rv, Laws.RaItems{v <> x, bb}), b, SCon{c0, cs},
          hg), rw, hs, at, sv, sk0, ab, rest, PP, kk))
    case Laws.RaItems{_i, _b}:
      ih(x, kk)
    case Laws.RaRows{_r, _b}:
      ih(x, kk)

# the last item read from an error
def aq.ike.avl(
  g0: Laws.RpAcc,
  +x: List<&2, T.Val>,
  +c0: Char,
  +cs: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hg: {Laws.replay.bad(g0) == SCon{c0, cs} : String},
  kk: aq.ik(Laws.replay.item(g0, Laws.RaItems{x, SCon{c0, cs}}), rw, hs, at, sv, sk0, ab, rest, PP)
) -> PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}):
  match g0:
    case Laws.RaVal{+v, +b}:
      aq.ikt(Laws.RaItems{v <> x, b}, Laws.RaItems{v <> x, SCon{c0, cs}}, Equal.cong(String, Laws.RpAcc, bb =>
        Laws.RaItems{v <> x, bb}, b, SCon{c0, cs}, hg), rw, hs, at, sv, sk0, ab, rest, PP, kk)
    case Laws.RaItems{_i, _b}:
      kk
    case Laws.RaRows{_r, _b}:
      kk

# an array's items read from an error: the document of the error and the
# rows
def aq.ike(
  nd: Laws.GVal,
  +x: List<&2, T.Val>,
  +c0: Char,
  +cs: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +ok: {Laws.g.ok.val(nd, Laws.RArrayValues{}) == True{} : Bool},
  kk: aq.ik(Laws.replay.go(nd, Laws.RaItems{x, SCon{c0, cs}}), rw, hs, at, sv, sk0, ab, rest, PP)
) -> PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}):
  match nd:
    case Laws.GArrayValues{+wa, +val, +wb, +rv}:
      aq.ike.av(Laws.replay.go(val, Laws.RaItems{x, SCon{c0, cs}}), rv, x, c0, cs, rw, hs, at, sv, sk0, ab, rest, PP,
        aq.gobad(val, Laws.RaItems{x, SCon{c0, cs}}, SCon{c0, cs}, {==}, {==}), +x2 => k2 => aq.ike(rv, x2, c0, cs,
          rw, hs, at, sv, sk0, ab, rest, PP, Eq.and.right(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv, Laws.RArrayValues{}),
            Eq.and.right(Laws.g.ok.val(val, Laws.RVal{}), Bool.and(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv,
              Laws.RArrayValues{})), Eq.and.right(Laws.g.ok.wcn(wa), Bool.and(Laws.g.ok.val(val, Laws.RVal{}),
                Bool.and(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv, Laws.RArrayValues{}))), ok))), k2), kk)
    case Laws.GArrayValuesLast{_wa, +val, _wb, _sep}:
      aq.ike.avl(Laws.replay.go(val, Laws.RaItems{x, SCon{c0, cs}}), x, c0, cs, rw, hs, at, sv, sk0, ab, rest, PP,
        aq.gobad(val, Laws.RaItems{x, SCon{c0, cs}}, SCon{c0, cs}, {==}, {==}), kk)
    case Laws.GvString{_a0}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvBoolean{_a0}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvArrayEmpty{_a0}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvArray{_a0, _a1}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvInlineTableEmpty{_a0, _a1}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvInlineTable{_a0, _a1, _a2}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvDateTime{_a0}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvFloat{_a0}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GvInteger{_a0}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GInlineTableKeyvals{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GInlineTableKeyvalsLast{_a0}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)
    case Laws.GKeyval{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&1, PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}), ok)

# a keyval of an inline table walked from an error leaves its rows
def aq.kvst.kv(
  +names: List<&2, String>,
  g0: Laws.RpAcc,
  +x: List<&2, T.Val>,
  +c0: Char,
  +cs: String,
  +hg: {Laws.replay.bad(g0) == SCon{c0, cs} : String}
) -> {Laws.replay.kv(names, g0, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}:
  match g0:
    case Laws.RaVal{+v, +b}:
      %Equal.sym(String, b, SCon{c0, cs}, hg) : {Laws.replay.end.rows(T.tree.walk(names, T.Tw{x, T.JPut{v}, [], _, "",
        [], True{}}, 0)) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}
      %Equal.sym(T.End, T.tree.walk(names, T.Tw{x, T.JPut{v}, [], SCon{c0, cs}, "", [], True{}}, 0), T.End{x, SCon{c0,
        cs}, []}, Laws.failed_walk_changes_nothing(names, x, T.JPut{v}, SCon{c0, cs}, "", [], True{}, 0,
          {==})) : {Laws.replay.end.rows(_) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}
      {==}
    case Laws.RaItems{_i, _b}:
      {==}
    case Laws.RaRows{_r, _b}:
      {==}

# an inline table's keyvals read from an error leave its rows
def aq.kvst(
  nd: Laws.GVal,
  +x: List<&2, T.Val>,
  +c0: Char,
  +cs: String,
  +ok: {aq.kvok(nd) == True{} : Bool}
) -> {Laws.replay.go(nd, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}:
  match nd:
    case Laws.GKeyval{+key, _wa, _wb, +val}:
      aq.kvst.kv(Laws.g.key.names(key), Laws.replay.go(val, Laws.RaRows{x, SCon{c0, cs}}), x, c0, cs, aq.gobad(val,
        Laws.RaRows{x, SCon{c0, cs}}, SCon{c0, cs}, {==}, {==}))
    case Laws.GInlineTableKeyvals{+kv, +w1, +w2, +rv}:
      Equal.trans(Laws.RpAcc, Laws.replay.go(rv, Laws.replay.go(kv, Laws.RaRows{x, SCon{c0, cs}})), Laws.replay.go(rv,
        Laws.RaRows{x, SCon{c0, cs}}), Laws.RaRows{x, SCon{c0, cs}}, Equal.cong(Laws.RpAcc, Laws.RpAcc, aa =>
          Laws.replay.go(rv, aa), Laws.replay.go(kv, Laws.RaRows{x, SCon{c0, cs}}), Laws.RaRows{x, SCon{c0, cs}},
            aq.kvst(kv, x, c0, cs, aq.kvok.k(kv, Eq.and.left(Laws.g.ok.val(kv, Laws.RKeyval{}),
              Bool.and(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{}))),
                ok)))), aq.kvst(rv, x, c0, cs, aq.kvok.i(rv, Eq.and.right(Laws.abnf.ws(w2), Laws.g.ok.val(rv,
                  Laws.RInlineTableKeyvals{}), Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2),
                    Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{})), Eq.and.right(Laws.g.ok.val(kv, Laws.RKeyval{}),
                      Bool.and(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.val(rv,
                        Laws.RInlineTableKeyvals{}))), ok))))))
    case Laws.GInlineTableKeyvalsLast{+kv}:
      aq.kvst(kv, x, c0, cs, aq.kvok.k(kv, ok))
    case Laws.GvString{_a0}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvString{_a0}, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x, SCon{c0,
        cs}} : Laws.RpAcc}, ok)
    case Laws.GvBoolean{_a0}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvBoolean{_a0}, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x, SCon{c0,
        cs}} : Laws.RpAcc}, ok)
    case Laws.GvArrayEmpty{_a0}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvArrayEmpty{_a0}, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x,
        SCon{c0, cs}} : Laws.RpAcc}, ok)
    case Laws.GvArray{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvArray{_a0, _a1}, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x,
        SCon{c0, cs}} : Laws.RpAcc}, ok)
    case Laws.GvInlineTableEmpty{_a0, _a1}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvInlineTableEmpty{_a0, _a1}, Laws.RaRows{x, SCon{c0,
        cs}}) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}, ok)
    case Laws.GvInlineTable{_a0, _a1, _a2}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvInlineTable{_a0, _a1, _a2}, Laws.RaRows{x, SCon{c0,
        cs}}) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}, ok)
    case Laws.GvDateTime{_a0}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvDateTime{_a0}, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x, SCon{c0,
        cs}} : Laws.RpAcc}, ok)
    case Laws.GvFloat{_a0}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvFloat{_a0}, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x, SCon{c0,
        cs}} : Laws.RpAcc}, ok)
    case Laws.GvInteger{_a0}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GvInteger{_a0}, Laws.RaRows{x, SCon{c0, cs}}) == Laws.RaRows{x, SCon{c0,
        cs}} : Laws.RpAcc}, ok)
    case Laws.GArrayValues{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GArrayValues{_a0, _a1, _a2, _a3}, Laws.RaRows{x, SCon{c0,
        cs}}) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}, ok)
    case Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}:
      Eq.bit.absurd(&2, {Laws.replay.go(Laws.GArrayValuesLast{_a0, _a1, _a2, _a3}, Laws.RaRows{x, SCon{c0,
        cs}}) == Laws.RaRows{x, SCon{c0, cs}} : Laws.RpAcc}, ok)

# an inline table's keyvals read from an error: the document of the error
# and the rows
def aq.rke(
  +nd: Laws.GVal,
  +x: List<&2, T.Val>,
  +c0: Char,
  +cs: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +ok: {aq.kvok(nd) == True{} : Bool},
  kk: aq.rk(Laws.replay.go(nd, Laws.RaRows{x, SCon{c0, cs}}), rw, hs, at, sv, sk0, ab, rest, PP)
) -> PP(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}):
  aq.rkt(Laws.replay.go(nd, Laws.RaRows{x, SCon{c0, cs}}), Laws.RaRows{x, SCon{c0, cs}}, aq.kvst(nd, x, c0, cs, ok),
    rw, hs, at, sv, sk0, ab, rest, PP, kk)

# a string of any form as an array's item
def aq.stra(
  +st: Laws.GString,
  +rest: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  +ok: {Laws.g.ok.str(st) == True{} : Bool},
  +es: {Laws.short(Laws.g.str.text(st, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  kk: aq.VK(Laws.GvString{st}, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.str.text(st, rest), T.MScan{Laws.s1.apos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  Laws.string_reads_as_denoted_in_array(st, ok, Laws.string_short_in_document("", st, rest, es), rw, hs, he, ps, bk,
    qk, sk, un, lf, ab, rest, aq.free(rest, hf), PP, +xv => b2 => q2 => u2 => l2 => hh => aq.kstr(xv,
      Laws.g.str.chars(st), b2, q2, u2, l2, rw, hs, he, ps, sk, ab, rest, PP, aq.holds(xv, Laws.g.str.chars(st), hh),
        kk))

# a string, from either value state
def aq.v.str(
  +st: Laws.GString,
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +ok: {Laws.g.ok.str(st) == True{} : Bool},
  +es: {Laws.short(Laws.g.str.text(st, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  kk: aq.VKG(Laws.replay.go(Laws.GvString{st}, Laws.RaVal{T.VArr{[]}, ""}), rw, hs, he, ps, sk, ab, rest, G)
) -> {Laws.own(T.doc.read(Laws.g.str.text(st, rest), T.MScan{aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf,
  ab)})) == G : T.Doc}:
  match m:
    case True{}:
      aq.stra(st, rest, rw, hs, he, ps, bk, qk, sk, un, lf, ab, dd => {Laws.own(dd) == G : T.Doc}, ok, es, hf, kk)
    case False{}:
      aq.str(st, rest, rw, hs, he, ps, bk, qk, sk, un, lf, ab, dd => {Laws.own(dd) == G : T.Doc}, ok, es, hf, kk)

# a bare word, from either value state: an item's is read as after `=` once
# its first character is held (vl.arr.eq)
def aq.v.word(
  +cs: List<&2, Char>,
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +hw: {Laws.bw.word(String.from_list(cs)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  kk: aq.VKG(Laws.replay.got(T.word.val(cs), ""), rw, hs, he, ps, sk, ab, rest, G)
) -> {Laws.own(T.doc.read(String.append(String.from_list(cs), rest), T.MScan{aq.vst(m, rw, hs, he, ps, bk, qk, sk, un,
  lf, ab)})) == G : T.Doc}:
  match m:
    case True{}:
      %Equal.sym(T.Doc, T.doc.read(String.append(String.from_list(cs), rest), T.MScan{Laws.s1.apos(rw, hs, he, ps, bk,
        qk, sk, un, lf, ab)}), T.doc.read(String.append(String.from_list(cs), rest), T.MScan{Laws.vpos(rw, hs, he, ps,
          T.LVal{}, qk, sk, un, lf, ab)}), vl.arr.eq(String.from_list(cs), hw, rest, rw, hs, he, ps, bk, qk, sk, un,
            lf, ab)) : {Laws.own(_) == G : T.Doc}
      aq.word(cs, rest, rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab, dd => {Laws.own(dd) == G : T.Doc}, hw, hf, kk)
    case False{}:
      aq.word(cs, rest, rw, hs, he, ps, bk, qk, sk, un, lf, ab, dd => {Laws.own(dd) == G : T.Doc}, hw, hf, kk)

# `]` after an array's items: the array of the items in order is placed
def aq.arrk2(
  +sp: Bool,
  +its: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +b3: T.Lex,
  +q2: T.QKind,
  +u2: U32,
  +l2: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +hi: {Laws.own.rows(its) == ri : List<&2, T.Val>},
  kk: aq.VKG(Laws.RaVal{T.VArr{List.reverse(&2, T.Val, ri)}, ""}, rw, hs, he, ps, sk, ab, rest, G)
) -> {Laws.own(T.doc.read(SCon{']', rest}, T.MScan{ap.s(aq.alx(sp), b3, rw, hs, he, ps, q2, T.CArr{its, ps, he} <> sk,
  u2, l2, ab)})) == G : T.Doc}:
  %Equal.sym(T.Mode, T.doc.scan(ap.s(aq.alx(sp), b3, rw, hs, he, ps, q2, T.CArr{its, ps, he} <> sk, u2, l2, ab), ']'),
    T.MScan{T.take.top(sk, T.VArr{List.reverse(&2, T.Val, its)}, "", rw, hs, he, ps, b3, q2, u2, l2, ab, False{})},
      aq.aclose(sp, rw, hs, he, ps, its, ps, he, b3, q2, sk, u2, l2, ab)) : {Laws.own(T.doc.read(rest, _)) == G : T.Doc}
  +hv = {Equal.cong(List<&2, T.Val>, T.Val, zs => T.VArr{zs}, Laws.own.rows(List.reverse(&2, T.Val, its)),
    List.reverse(&2, T.Val, ri), cv.own.rs(its, ri, hi)) : {T.VArr{Laws.own.rows(List.reverse(&2, T.Val,
      its))} == T.VArr{List.reverse(&2, T.Val, ri)} : T.Val}}
  kk(T.VArr{List.reverse(&2, T.Val, its)}, b3, q2, u2, l2, hv, hv)

# an array's items read: ws-comment-newline and `]` close it, by the
# replay's reading of the items
def aq.arrk(
  +rr: Laws.RpAcc,
  +wn: List<&2, Laws.GWcn>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +okw: {Laws.g.ok.wcn(wn) == True{} : Bool},
  kk: aq.VKG(Laws.replay.arr(rr), rw, hs, he, ps, sk, ab, rest, G)
) -> aq.ik(rr, rw, hs, he, ps, sk, ab, Laws.g.wcn.text(wn, SCon{']', rest}), dd => {Laws.own(dd) == G : T.Doc}):
  match rr:
    case Laws.RaItems{+ri, +bd}:
      match bd:
        case SNil{}:
          +its => +sp => +b2 => +q2 => +u2 => +l2 => +hi =>
            aq.wcn(wn, SCon{']', rest}, aq.alx(sp), b2, rw, hs, he, ps, q2, T.CArr{its, ps, he} <> sk, u2, l2, ab,
              aq.alx.wsl(sp), aq.alx.coml(sp), aq.alx.nlx(sp), okw, dd => {Laws.own(dd) == G : T.Doc}, +b3 =>
                aq.arrk2(sp, its, ri, b3, q2, u2, l2, rw, hs, he, ps, sk, ab, rest, G, hi, kk))
        case SCon{_c0, _cs}:
          kk
    case Laws.RaVal{_v, _b}:
      Unit{}
    case Laws.RaRows{_r, _b}:
      Unit{}

# an empty array
def aq.v.arr0(
  +wn: List<&2, Laws.GWcn>,
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +okw: {Laws.g.ok.wcn(wn) == True{} : Bool},
  kk: aq.VKG(Laws.RaVal{T.VArr{[]}, ""}, rw, hs, he, ps, sk, ab, rest, G)
) -> {Laws.own(T.doc.read(SCon{'[', Laws.g.wcn.text(wn, SCon{']', rest})}, T.MScan{aq.vst(m, rw, hs, he, ps, bk, qk,
  sk, un, lf, ab)})) == G : T.Doc}:
  %Equal.sym(T.Mode, T.doc.scan(aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf, ab), '['), T.MScan{ap.s(T.LArr{},
    aq.bk0(m, bk), rw, hs, he, [], qk, T.CArr{[], ps, he} <> sk, un, lf, ab)}, aq.aopen(m, rw, hs, he, ps, bk, qk, sk,
      un, lf, ab)) : {Laws.own(T.doc.read(Laws.g.wcn.text(wn, SCon{']', rest}), _)) == G : T.Doc}
  aq.wcn(wn, SCon{']', rest}, T.LArr{}, aq.bk0(m, bk), rw, hs, he, [], qk, T.CArr{[], ps, he} <> sk, un, lf, ab, {==},
    {==}, {==}, okw, dd => {Laws.own(dd) == G : T.Doc}, +b2 => aq.arrk2(True{}, [], [], b2, qk, un, lf, rw, hs, he,
      ps, sk, ab, rest, G, {==}, kk))

# an array with items
def aq.v.arr(
  +vals: Laws.GVal,
  +wn: List<&2, Laws.GWcn>,
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +okv: {Laws.g.ok.val(vals, Laws.RArrayValues{}) == True{} : Bool},
  +okw: {Laws.g.ok.wcn(wn) == True{} : Bool},
  +es: {Laws.short(Laws.g.val.text(Laws.GvArray{vals, wn}, rest)) == True{} : Bool},
  kk: aq.VKG(Laws.replay.arr(Laws.replay.go(vals, Laws.RaItems{[], ""})), rw, hs, he, ps, sk, ab, rest, G),
  ih: aq.IT(vals)
) -> {Laws.own(T.doc.read(SCon{'[', Laws.g.val.text(vals, Laws.g.wcn.text(wn, SCon{']', rest}))}, T.MScan{aq.vst(m,
  rw, hs, he, ps, bk, qk, sk, un, lf, ab)})) == G : T.Doc}:
  %Equal.sym(T.Mode, T.doc.scan(aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf, ab), '['), T.MScan{ap.s(T.LArr{},
    aq.bk0(m, bk), rw, hs, he, [], qk, T.CArr{[], ps, he} <> sk, un, lf, ab)}, aq.aopen(m, rw, hs, he, ps, bk, qk, sk,
      un, lf, ab)) : {Laws.own(T.doc.read(Laws.g.val.text(vals, Laws.g.wcn.text(wn, SCon{']', rest})), _)) == G : T.Doc}
  ih(rw, hs, he, [], ps, sk, [], [], aq.bk0(m, bk), qk, un, lf, ab, Laws.g.wcn.text(wn, SCon{']', rest}), G, okv,
    gd.short.tail('[', Laws.g.val.text(vals, Laws.g.wcn.text(wn, SCon{']', rest})), es), aq.fol.wcn(wn, SCon{']',
      rest}, okw, {==}), {==}, aq.arrk(Laws.replay.go(vals, Laws.RaItems{[], ""}), wn, rw, hs, he, ps, sk, ab, rest,
        G, okw, kk))

# an empty inline table
def aq.v.inl0(
  +w1: String,
  +w2: String,
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +h1: {Laws.abnf.ws(w1) == True{} : Bool},
  +h2: {Laws.abnf.ws(w2) == True{} : Bool},
  kk: aq.VKG(Laws.RaVal{T.VInl{[]}, ""}, rw, hs, he, ps, sk, ab, rest, G)
) -> {Laws.own(T.doc.read(SCon{'{', String.append(w1, String.append(w2, SCon{'}', rest}))}, T.MScan{aq.vst(m, rw, hs,
  he, ps, bk, qk, sk, un, lf, ab)})) == G : T.Doc}:
  %Equal.sym(T.Mode, T.doc.scan(aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf, ab), '{'), T.MScan{ap.s(T.LInl{},
    aq.bk0(m, bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}, aq.iopen(m, rw, hs, he, ps, bk, qk, sk,
      un, lf, ab)) : {Laws.own(T.doc.read(String.append(w1, String.append(w2, SCon{'}', rest})), _)) == G : T.Doc}
  %Equal.sym(T.Doc, T.doc.read(String.append(w1, String.append(w2, SCon{'}', rest})), T.MScan{ap.s(T.LInl{}, aq.bk0(m,
    bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}), T.doc.read(String.append(w2, SCon{'}', rest}),
      T.MScan{ap.s(T.LInl{}, aq.bk0(m, bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}), ap.ws(w1,
        String.append(w2, SCon{'}', rest}), T.LInl{}, aq.bk0(m, bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un,
          lf, ab, {==}, h1)) : {Laws.own(_) == G : T.Doc}
  %Equal.sym(T.Doc, T.doc.read(String.append(w2, SCon{'}', rest}), T.MScan{ap.s(T.LInl{}, aq.bk0(m, bk), rw, hs, he,
    [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}), T.doc.read(SCon{'}', rest}, T.MScan{ap.s(T.LInl{}, aq.bk0(m, bk),
      rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}), ap.ws(w2, SCon{'}', rest}, T.LInl{}, aq.bk0(m, bk),
        rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab, {==}, h2)) : {Laws.own(_) == G : T.Doc}
  %Equal.sym(T.Mode, T.doc.scan(ap.s(aq.ilx(False{}), aq.bk0(m, bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un,
    lf, ab), '}'), T.MScan{T.take.top(sk, T.VInl{T.inl.seal([])}, "", rw, hs, he, ps, aq.bk0(m, bk), qk, un, lf, ab,
      False{})}, aq.iclose(False{}, rw, hs, he, [], [], ps, he, aq.bk0(m, bk), qk, sk, un, lf,
        ab)) : {Laws.own(T.doc.read(rest, _)) == G : T.Doc}
  kk(T.VInl{T.inl.seal([])}, aq.bk0(m, bk), qk, un, lf, {==}, {==})

# `}` after an inline table's keyvals: the table of its rows sealed is
# placed
def aq.inlk2(
  +inl: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +b2: T.Lex,
  +q2: T.QKind,
  +u2: U32,
  +l2: U32,
  +w2: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +h2: {Laws.abnf.ws(w2) == True{} : Bool},
  +hi: {Laws.own.rows(inl) == ri : List<&2, T.Val>},
  kk: aq.VKG(Laws.RaVal{T.VInl{T.inl.seal(ri)}, ""}, rw, hs, he, ps, sk, ab, rest, G)
) -> {Laws.own(T.doc.read(String.append(w2, SCon{'}', rest}), T.MScan{ap.s(T.LInlC{}, b2, rw, hs, he, [], q2,
  T.CInl{inl, ps, he} <> sk, u2, l2, ab)})) == G : T.Doc}:
  %Equal.sym(T.Doc, T.doc.read(String.append(w2, SCon{'}', rest}), T.MScan{ap.s(T.LInlC{}, b2, rw, hs, he, [], q2,
    T.CInl{inl, ps, he} <> sk, u2, l2, ab)}), T.doc.read(SCon{'}', rest}, T.MScan{ap.s(T.LInlC{}, b2, rw, hs, he, [],
      q2, T.CInl{inl, ps, he} <> sk, u2, l2, ab)}), ap.ws(w2, SCon{'}', rest}, T.LInlC{}, b2, rw, hs, he, [], q2,
        T.CInl{inl, ps, he} <> sk, u2, l2, ab, {==}, h2)) : {Laws.own(_) == G : T.Doc}
  %Equal.sym(T.Mode, T.doc.scan(ap.s(aq.ilx(True{}), b2, rw, hs, he, [], q2, T.CInl{inl, ps, he} <> sk, u2, l2, ab),
    '}'), T.MScan{T.take.top(sk, T.VInl{T.inl.seal(inl)}, "", rw, hs, he, ps, b2, q2, u2, l2, ab, False{})},
      aq.iclose(True{}, rw, hs, he, [], inl, ps, he, b2, q2, sk, u2, l2, ab)) : {Laws.own(T.doc.read(rest,
        _)) == G : T.Doc}
  +hv = {Equal.cong(List<&2, T.Val>, T.Val, zs => T.VInl{zs}, Laws.own.rows(T.inl.seal(inl)), T.inl.seal(ri),
    Equal.trans(List<&2, T.Val>, Laws.own.rows(T.inl.seal(inl)), T.inl.seal(Laws.own.rows(inl)), T.inl.seal(ri),
      aq.oinl(inl), Equal.cong(List<&2, T.Val>, List<&2, T.Val>, zs => T.inl.seal(zs), Laws.own.rows(inl), ri,
        hi))) : {T.VInl{Laws.own.rows(T.inl.seal(inl))} == T.VInl{T.inl.seal(ri)} : T.Val}}
  kk(T.VInl{T.inl.seal(inl)}, b2, q2, u2, l2, hv, hv)

# an inline table's keyvals read: blank space and `}` close it, by the
# replay's reading of the keyvals
def aq.inlk(
  +rr: Laws.RpAcc,
  +w2: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +h2: {Laws.abnf.ws(w2) == True{} : Bool},
  kk: aq.VKG(Laws.replay.inl(rr), rw, hs, he, ps, sk, ab, rest, G)
) -> aq.rk(rr, rw, hs, he, ps, sk, ab, String.append(w2, SCon{'}', rest}), dd => {Laws.own(dd) == G : T.Doc}):
  match rr:
    case Laws.RaRows{+ri, +bd}:
      match bd:
        case SNil{}:
          +inl => +b2 => +q2 => +u2 => +l2 => +hi => aq.inlk2(inl, ri, b2, q2, u2, l2, w2, rw, hs, he, ps, sk, ab,
            rest, G, h2, hi, kk)
        case SCon{_c0, _cs}:
          kk
    case Laws.RaVal{_v, _b}:
      Unit{}
    case Laws.RaItems{_i, _b}:
      Unit{}

# an inline table with keyvals
def aq.v.inl(
  +w1: String,
  +kvs: Laws.GVal,
  +w2: String,
  +m: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +h1: {Laws.abnf.ws(w1) == True{} : Bool},
  +okk: {Laws.g.ok.val(kvs, Laws.RInlineTableKeyvals{}) == True{} : Bool},
  +h2: {Laws.abnf.ws(w2) == True{} : Bool},
  +es: {Laws.short(Laws.g.val.text(Laws.GvInlineTable{w1, kvs, w2}, rest)) == True{} : Bool},
  kk: aq.VKG(Laws.replay.inl(Laws.replay.go(kvs, Laws.RaRows{[], ""})), rw, hs, he, ps, sk, ab, rest, G),
  ih: aq.KT(kvs)
) -> {Laws.own(T.doc.read(SCon{'{', String.append(w1, Laws.g.val.text(kvs, String.append(w2, SCon{'}', rest})))},
  T.MScan{aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf, ab)})) == G : T.Doc}:
  %Equal.sym(T.Mode, T.doc.scan(aq.vst(m, rw, hs, he, ps, bk, qk, sk, un, lf, ab), '{'), T.MScan{ap.s(T.LInl{},
    aq.bk0(m, bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}, aq.iopen(m, rw, hs, he, ps, bk, qk, sk,
      un, lf, ab)) : {Laws.own(T.doc.read(String.append(w1, Laws.g.val.text(kvs, String.append(w2, SCon{'}', rest}))),
        _)) == G : T.Doc}
  %Equal.sym(T.Doc, T.doc.read(String.append(w1, Laws.g.val.text(kvs, String.append(w2, SCon{'}', rest}))),
    T.MScan{ap.s(T.LInl{}, aq.bk0(m, bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}),
      T.doc.read(Laws.g.val.text(kvs, String.append(w2, SCon{'}', rest})), T.MScan{ap.s(T.LInl{}, aq.bk0(m, bk), rw,
        hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab)}), ap.ws(w1, Laws.g.val.text(kvs, String.append(w2,
          SCon{'}', rest})), T.LInl{}, aq.bk0(m, bk), rw, hs, he, [], qk, T.CInl{[], ps, he} <> sk, un, lf, ab, {==},
            h1)) : {Laws.own(_) == G : T.Doc}
  ih(False{}, rw, hs, he, ps, sk, [], [], aq.bk0(m, bk), qk, un, lf, ab, String.append(w2, SCon{'}', rest}), G,
    aq.kvok.i(kvs, okk), aq.sh(w1, Laws.g.val.text(kvs, String.append(w2, SCon{'}', rest})), gd.short.tail('{',
      String.append(w1, Laws.g.val.text(kvs, String.append(w2, SCon{'}', rest}))), es)), aq.fol.ws(w2, SCon{'}',
        rest}, h2, {==}), {==}, aq.inlk(Laws.replay.go(kvs, Laws.RaRows{[], ""}), w2, rw, hs, he, ps, sk, ab, rest, G,
          h2, kk))

# an array's item read: ws-comment-newline, a comma and the next items, by
# the replay's reading of the item
def aq.itemk(
  +rr: Laws.RpAcc,
  +wb: List<&2, Laws.GWcn>,
  +rv: Laws.GVal,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +p: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +its: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +hwb: {Laws.g.ok.wcn(wb) == True{} : Bool},
  +hrv: {Laws.g.ok.val(rv, Laws.RArrayValues{}) == True{} : Bool},
  +er: {Laws.short(Laws.g.val.text(rv, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  +hi: {Laws.own.rows(its) == ri : List<&2, T.Val>},
  kk: aq.IKG(Laws.replay.go(rv, Laws.replay.item(rr, Laws.RaItems{ri, ""})), rw, hs, at, sv, sk0, ab, rest, G),
  ihr: aq.IT(rv)
) -> aq.vk(rr, rw, hs, at, p, T.CArr{its, sv, at} <> sk0, ab, Laws.g.wcn.text(wb, SCon{',', Laws.g.val.text(rv,
  rest)}), dd => {Laws.own(dd) == G : T.Doc}):
  match rr:
    case Laws.RaVal{+vv, +bd}:
      match bd:
        case SNil{}:
          +xv => +b2 => +q2 => +u2 => +l2 => _hv => +hc =>
            aq.wcn(wb, SCon{',', Laws.g.val.text(rv, rest)}, T.LArrC{}, b2, rw, hs, at, sv, q2, T.CArr{xv <> its, sv,
              at} <> sk0, u2, l2, ab, {==}, {==}, {==}, hwb, dd => {Laws.own(dd) == G : T.Doc}, +b3 => ihr(rw, hs, at,
                sv, sv, sk0, xv <> its, vv <> ri, b3, q2, u2, l2, ab, rest, G, hrv, er, hf, aq.cons2(xv, its, vv, ri,
                  hc, hi), kk))
        case SCon{+c0, +cs}:
          aq.ike(rv, vv <> ri, c0, cs, rw, hs, at, sv, sk0, ab, rest, dd => {Laws.own(dd) == G : T.Doc}, hrv, kk)
    case Laws.RaItems{_i, _b}:
      Unit{}
    case Laws.RaRows{_r, _b}:
      Unit{}

# an array's items: blank space, comments and newlines, a value, more, a
# comma and the items after it
def aq.i.av(
  +wa: List<&2, Laws.GWcn>,
  +val: Laws.GVal,
  +wb: List<&2, Laws.GWcn>,
  +rv: Laws.GVal,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +p: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +its: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +ok: {Laws.g.ok.val(Laws.GArrayValues{wa, val, wb, rv}, Laws.RArrayValues{}) == True{} : Bool},
  +es: {Laws.short(Laws.g.val.text(Laws.GArrayValues{wa, val, wb, rv}, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  +hi: {Laws.own.rows(its) == ri : List<&2, T.Val>},
  kk: aq.IKN(Laws.GArrayValues{wa, val, wb, rv}, ri, rw, hs, at, sv, sk0, ab, rest, G),
  ihv: aq.VT(val),
  ihr: aq.IT(rv)
) -> {Laws.own(T.doc.read(Laws.g.val.text(Laws.GArrayValues{wa, val, wb, rv}, rest), T.MScan{ap.s(T.LArr{}, bk, rw,
  hs, at, p, qk, T.CArr{its, sv, at} <> sk0, un, lf, ab)})) == G : T.Doc}:
  +h2 = {Eq.and.right(Laws.g.ok.wcn(wa), Bool.and(Laws.g.ok.val(val, Laws.RVal{}), Bool.and(Laws.g.ok.wcn(wb),
    Laws.g.ok.val(rv, Laws.RArrayValues{}))), ok) : {Bool.and(Laws.g.ok.val(val, Laws.RVal{}),
      Bool.and(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv, Laws.RArrayValues{}))) == True{} : Bool}}
  +h3 = {Eq.and.right(Laws.g.ok.val(val, Laws.RVal{}), Bool.and(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv,
    Laws.RArrayValues{})), h2) : {Bool.and(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv, Laws.RArrayValues{})) == True{} : Bool}}
  +hv0 = {Eq.and.left(Laws.g.ok.val(val, Laws.RVal{}), Bool.and(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv,
    Laws.RArrayValues{})), h2) : {Laws.g.ok.val(val, Laws.RVal{}) == True{} : Bool}}
  +hwb = {Eq.and.left(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv, Laws.RArrayValues{}),
    h3) : {Laws.g.ok.wcn(wb) == True{} : Bool}}
  +e1 = {aq.sh.wcn(wa, Laws.g.val.text(val, Laws.g.wcn.text(wb, SCon{',', Laws.g.val.text(rv, rest)})),
    es) : {Laws.short(Laws.g.val.text(val, Laws.g.wcn.text(wb, SCon{',', Laws.g.val.text(rv,
      rest)}))) == True{} : Bool}}
  +e4 = {gd.short.tail(',', Laws.g.val.text(rv, rest), aq.sh.wcn(wb, SCon{',', Laws.g.val.text(rv, rest)},
    aq.sh.val(val, Laws.g.wcn.text(wb, SCon{',', Laws.g.val.text(rv, rest)}), e1))) : {Laws.short(Laws.g.val.text(rv,
      rest)) == True{} : Bool}}
  aq.wcn(wa, Laws.g.val.text(val, Laws.g.wcn.text(wb, SCon{',', Laws.g.val.text(rv, rest)})), T.LArr{}, bk, rw, hs,
    at, p, qk, T.CArr{its, sv, at} <> sk0, un, lf, ab, {==}, {==}, {==}, Eq.and.left(Laws.g.ok.wcn(wa),
      Bool.and(Laws.g.ok.val(val, Laws.RVal{}), Bool.and(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv, Laws.RArrayValues{}))),
        ok), dd => {Laws.own(dd) == G : T.Doc}, +b2 => ihv(True{}, rw, hs, at, p, b2, qk, T.CArr{its, sv, at} <> sk0,
          un, lf, ab, Laws.g.wcn.text(wb, SCon{',', Laws.g.val.text(rv, rest)}), G, hv0, e1, aq.fol.wcn(wb, SCon{',',
            Laws.g.val.text(rv, rest)}, hwb, {==}), aq.itemk(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), wb, rv,
              rw, hs, at, p, sv, sk0, its, ri, ab, rest, G, hwb, Eq.and.right(Laws.g.ok.wcn(wb), Laws.g.ok.val(rv,
                Laws.RArrayValues{}), h3), e4, hf, hi, aq.ikt(Laws.replay.go(rv, Laws.replay.item(Laws.replay.go(val,
                  Laws.RaItems{ri, ""}), Laws.RaItems{ri, ""})), Laws.replay.go(rv,
                    Laws.replay.item(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), Laws.RaItems{ri, ""})),
                      Equal.cong(Laws.RpAcc, Laws.RpAcc, aa => Laws.replay.go(rv, Laws.replay.item(aa,
                        Laws.RaItems{ri, ""})), Laws.replay.go(val, Laws.RaItems{ri, ""}), Laws.replay.go(val,
                          Laws.RaVal{T.VArr{[]}, ""}), aq.goval(val, Laws.RaItems{ri, ""}, hv0)), rw, hs, at, sv, sk0,
                            ab, rest, dd => {Laws.own(dd) == G : T.Doc}, kk), ihr)))

# after the last item: a comma or none, with what the continuation takes
def aq.sepk(
  +sep: Bool,
  +its: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +b3: T.Lex,
  +q2: T.QKind,
  +u2: U32,
  +l2: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +hi: {Laws.own.rows(its) == ri : List<&2, T.Val>},
  kk: aq.ik2("", ri, rw, hs, at, sv, sk0, ab, rest, dd => {Laws.own(dd) == G : T.Doc})
) -> {Laws.own(T.doc.read(Laws.g.sep.text(sep, rest), T.MScan{ap.s(T.LArrC{}, b3, rw, hs, at, sv, q2, T.CArr{its, sv,
  at} <> sk0, u2, l2, ab)})) == G : T.Doc}:
  match sep:
    case True{}:
      kk(its, True{}, b3, q2, u2, l2, hi)
    case False{}:
      kk(its, False{}, b3, q2, u2, l2, hi)

# the last item read: ws-comment-newline and the separator, by the replay's
# reading of the item
def aq.itemkl(
  +rr: Laws.RpAcc,
  +wb: List<&2, Laws.GWcn>,
  +sep: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +p: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +its: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +hwb: {Laws.g.ok.wcn(wb) == True{} : Bool},
  +hi: {Laws.own.rows(its) == ri : List<&2, T.Val>},
  kk: aq.IKG(Laws.replay.item(rr, Laws.RaItems{ri, ""}), rw, hs, at, sv, sk0, ab, rest, G)
) -> aq.vk(rr, rw, hs, at, p, T.CArr{its, sv, at} <> sk0, ab, Laws.g.wcn.text(wb, Laws.g.sep.text(sep, rest)), dd =>
  {Laws.own(dd) == G : T.Doc}):
  match rr:
    case Laws.RaVal{+vv, +bd}:
      match bd:
        case SNil{}:
          +xv => +b2 => +q2 => +u2 => +l2 => _hv => +hc =>
            aq.wcn(wb, Laws.g.sep.text(sep, rest), T.LArrC{}, b2, rw, hs, at, sv, q2, T.CArr{xv <> its, sv,
              at} <> sk0, u2, l2, ab, {==}, {==}, {==}, hwb, dd => {Laws.own(dd) == G : T.Doc}, +b3 => aq.sepk(sep,
                xv <> its, vv <> ri, b3, q2, u2, l2, rw, hs, at, sv, sk0, ab, rest, G, aq.cons2(xv, its, vv, ri, hc,
                  hi), kk))
        case SCon{_c0, _cs}:
          kk
    case Laws.RaItems{_i, _b}:
      Unit{}
    case Laws.RaRows{_r, _b}:
      Unit{}

# an array's last item: blank space, comments and newlines, a value, more,
# and a comma or none
def aq.i.avl(
  +wa: List<&2, Laws.GWcn>,
  +val: Laws.GVal,
  +wb: List<&2, Laws.GWcn>,
  +sep: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +p: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +its: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +ok: {Laws.g.ok.val(Laws.GArrayValuesLast{wa, val, wb, sep}, Laws.RArrayValues{}) == True{} : Bool},
  +es: {Laws.short(Laws.g.val.text(Laws.GArrayValuesLast{wa, val, wb, sep}, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  +hi: {Laws.own.rows(its) == ri : List<&2, T.Val>},
  kk: aq.IKN(Laws.GArrayValuesLast{wa, val, wb, sep}, ri, rw, hs, at, sv, sk0, ab, rest, G),
  ihv: aq.VT(val)
) -> {Laws.own(T.doc.read(Laws.g.val.text(Laws.GArrayValuesLast{wa, val, wb, sep}, rest), T.MScan{ap.s(T.LArr{}, bk,
  rw, hs, at, p, qk, T.CArr{its, sv, at} <> sk0, un, lf, ab)})) == G : T.Doc}:
  +h2 = {Eq.and.right(Laws.g.ok.wcn(wa), Bool.and(Laws.g.ok.val(val, Laws.RVal{}), Laws.g.ok.wcn(wb)),
    ok) : {Bool.and(Laws.g.ok.val(val, Laws.RVal{}), Laws.g.ok.wcn(wb)) == True{} : Bool}}
  +hv0 = {Eq.and.left(Laws.g.ok.val(val, Laws.RVal{}), Laws.g.ok.wcn(wb), h2) : {Laws.g.ok.val(val,
    Laws.RVal{}) == True{} : Bool}}
  +hwb = {Eq.and.right(Laws.g.ok.val(val, Laws.RVal{}), Laws.g.ok.wcn(wb), h2) : {Laws.g.ok.wcn(wb) == True{} : Bool}}
  aq.wcn(wa, Laws.g.val.text(val, Laws.g.wcn.text(wb, Laws.g.sep.text(sep, rest))), T.LArr{}, bk, rw, hs, at, p, qk,
    T.CArr{its, sv, at} <> sk0, un, lf, ab, {==}, {==}, {==}, Eq.and.left(Laws.g.ok.wcn(wa),
      Bool.and(Laws.g.ok.val(val, Laws.RVal{}), Laws.g.ok.wcn(wb)), ok), dd => {Laws.own(dd) == G : T.Doc}, +b2 =>
        ihv(True{}, rw, hs, at, p, b2, qk, T.CArr{its, sv, at} <> sk0, un, lf, ab, Laws.g.wcn.text(wb,
          Laws.g.sep.text(sep, rest)), G, hv0, aq.sh.wcn(wa, Laws.g.val.text(val, Laws.g.wcn.text(wb,
            Laws.g.sep.text(sep, rest))), es), aq.fol.wcn(wb, Laws.g.sep.text(sep, rest), hwb, aq.fol.sep(sep, rest,
              hf)), aq.itemkl(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), wb, sep, rw, hs, at, p, sv, sk0, its,
                ri, ab, rest, G, hwb, hi, aq.ikt(Laws.replay.item(Laws.replay.go(val, Laws.RaItems{ri, ""}),
                  Laws.RaItems{ri, ""}), Laws.replay.item(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}),
                    Laws.RaItems{ri, ""}), Equal.cong(Laws.RpAcc, Laws.RpAcc, aa => Laws.replay.item(aa,
                      Laws.RaItems{ri, ""}), Laws.replay.go(val, Laws.RaItems{ri, ""}), Laws.replay.go(val,
                        Laws.RaVal{T.VArr{[]}, ""}), aq.goval(val, Laws.RaItems{ri, ""}, hv0)), rw, hs, at, sv, sk0,
                          ab, rest, dd => {Laws.own(dd) == G : T.Doc}, kk))))

# the walk of an inline table's keyval, however it ends: the rest read from
# where the table waits after a keyval, or the error it sets stays
def aq.ikw(
  en: T.End,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +b2: T.Lex,
  +q2: T.QKind,
  +u2: U32,
  +l2: U32,
  kk: aq.RKG(Laws.replay.end.rows(ow.end(en)), rw, hs, at, sv, sk0, ab, rest, G)
) -> {Laws.own(T.doc.read(rest, T.MScan{T.take.inl(en, rw, hs, at, sv, sk0, b2, q2, u2, l2, ab,
  False{})})) == G : T.Doc}:
  match en:
    case T.End{+inl2, +bad2, _h2}:
      match bad2:
        case SNil{}:
          kk(inl2, b2, q2, u2, l2, {==})
        case SCon{+c0, +cs}:
          %Equal.sym(T.Doc, T.doc.read(rest, T.MScan{T.St{SCon{c0, cs}, rw, hs, at, [], [], T.LInlC{}, b2, q2,
            T.CInl{inl2, sv, at} <> sk0, T.HNone{}, u2, l2, ab, False{}}}), T.Doc{SCon{c0, cs}, T.rows.seal(rw)},
              Laws.error_stays(SCon{c0, cs}, rw, hs, at, [], [], T.LInlC{}, b2, q2, T.CInl{inl2, sv, at} <> sk0,
                T.HNone{}, u2, l2, ab, False{}, {==}, rest)) : {Laws.own(_) == G : T.Doc}
          kk

# a keyval's walk into an inline table's rows is the replay's, read out
def aq.e1(
  +names: List<&2, String>,
  +racc: List<&2, String>,
  +ri: List<&2, T.Val>,
  +oinl: List<&2, T.Val>,
  +vv: T.Val,
  +ovx: T.Val,
  +hp: {racc == names : List<&2, String>},
  +hi: {oinl == ri : List<&2, T.Val>},
  +hv: {ovx == vv : T.Val}
) -> {T.tree.walk(names, T.Tw{ri, T.JPut{vv}, [], "", "", [], True{}}, 0) == T.tree.walk(racc, T.Tw{oinl, T.JPut{ovx},
  [], "", "", [], True{}}, 0) : T.End}:
  %hp : {T.tree.walk(_, T.Tw{ri, T.JPut{vv}, [], "", "", [], True{}}, 0) == T.tree.walk(racc, T.Tw{oinl, T.JPut{ovx},
    [], "", "", [], True{}}, 0) : T.End}
  %hi : {T.tree.walk(racc, T.Tw{_, T.JPut{vv}, [], "", "", [], True{}}, 0) == T.tree.walk(racc, T.Tw{oinl,
    T.JPut{ovx}, [], "", "", [], True{}}, 0) : T.End}
  %hv : {T.tree.walk(racc, T.Tw{oinl, T.JPut{_}, [], "", "", [], True{}}, 0) == T.tree.walk(racc, T.Tw{oinl,
    T.JPut{ovx}, [], "", "", [], True{}}, 0) : T.End}
  {==}

# an inline table's keyval's value read: it is walked into the table's rows
# along the key's names, by the replay's reading of the value
def aq.ikv(
  +rr: Laws.RpAcc,
  +names: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +inl: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +acc: List<&2, String>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +hp: {List.reverse(&2, String, acc) == names : List<&2, String>},
  +hi: {Laws.own.rows(inl) == ri : List<&2, T.Val>},
  kk: aq.RKG(Laws.replay.kv(names, rr, Laws.RaRows{ri, ""}), rw, hs, at, sv, sk0, ab, rest, G)
) -> aq.vk(rr, rw, hs, at, acc, T.CInl{inl, sv, at} <> sk0, ab, rest, dd => {Laws.own(dd) == G : T.Doc}):
  match rr:
    case Laws.RaVal{+vv, +bd}:
      match bd:
        case SNil{}:
          +xv => +b2 => +q2 => +u2 => +l2 => +hv => _hc =>
            aq.ikw(T.tree.walk(List.reverse(&2, String, acc), T.Tw{inl, T.JPut{xv}, [], "", "", [], True{}}, 0), rw,
              hs, at, sv, sk0, ab, rest, G, b2, q2, u2, l2, aq.rkt(Laws.replay.end.rows(T.tree.walk(names, T.Tw{ri,
                T.JPut{vv}, [], "", "", [], True{}}, 0)), Laws.replay.end.rows(ow.end(T.tree.walk(List.reverse(&2,
                  String, acc), T.Tw{inl, T.JPut{xv}, [], "", "", [], True{}}, 0))), Equal.cong(T.End, Laws.RpAcc,
                    en => Laws.replay.end.rows(en), T.tree.walk(names, T.Tw{ri, T.JPut{vv}, [], "", "", [], True{}},
                      0), ow.end(T.tree.walk(List.reverse(&2, String, acc), T.Tw{inl, T.JPut{xv}, [], "", "", [],
                        True{}}, 0)), Equal.trans(T.End, T.tree.walk(names, T.Tw{ri, T.JPut{vv}, [], "", "", [],
                          True{}}, 0), T.tree.walk(List.reverse(&2, String, acc), T.Tw{Laws.own.rows(inl),
                            T.JPut{ow.v(xv)}, [], "", "", [], True{}}, 0), ow.end(T.tree.walk(List.reverse(&2, String,
                              acc), T.Tw{inl, T.JPut{xv}, [], "", "", [], True{}}, 0)), aq.e1(names, List.reverse(&2,
                                String, acc), ri, Laws.own.rows(inl), vv, ow.v(xv), hp, hi, hv), Equal.sym(T.End,
                                  ow.end(T.tree.walk(List.reverse(&2, String, acc), T.Tw{inl, T.JPut{xv}, [], "", "",
                                    [], True{}}, 0)), T.tree.walk(List.reverse(&2, String, acc),
                                      T.Tw{Laws.own.rows(inl), T.JPut{ow.v(xv)}, [], "", "", [], True{}}, 0),
                                        ow.walk(List.reverse(&2, String, acc), T.Tw{inl, T.JPut{xv}, [], "", "", [],
                                          True{}}, 0)))), rw, hs, at, sv, sk0, ab, rest, dd =>
                                            {Laws.own(dd) == G : T.Doc}, kk))
        case SCon{+c0, +cs}:
          aq.rkt(Laws.replay.end.rows(T.tree.walk(names, T.Tw{ri, T.JPut{vv}, [], SCon{c0, cs}, "", [], True{}}, 0)),
            Laws.RaRows{ri, SCon{c0, cs}}, Equal.cong(T.End, Laws.RpAcc, en => Laws.replay.end.rows(en),
              T.tree.walk(names, T.Tw{ri, T.JPut{vv}, [], SCon{c0, cs}, "", [], True{}}, 0), T.End{ri, SCon{c0, cs},
                []}, Laws.failed_walk_changes_nothing(names, ri, T.JPut{vv}, SCon{c0, cs}, "", [], True{}, 0, {==})),
                  rw, hs, at, sv, sk0, ab, rest, dd => {Laws.own(dd) == G : T.Doc}, kk)
    case Laws.RaItems{_i, _b}:
      Unit{}
    case Laws.RaRows{_r, _b}:
      Unit{}

# a keyval of an inline table: its key from where the table waits for one,
# `=`, its value, and its walk into the table's rows
def aq.k.kv(
  +key: Laws.GKey,
  +wa: String,
  +wb: String,
  +val: Laws.GVal,
  +pos: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +inl: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +ok: {aq.kvok(Laws.GKeyval{key, wa, wb, val}) == True{} : Bool},
  +es: {Laws.short(Laws.g.val.text(Laws.GKeyval{key, wa, wb, val}, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  +hi: {Laws.own.rows(inl) == ri : List<&2, T.Val>},
  kk: aq.RKG(Laws.replay.go(Laws.GKeyval{key, wa, wb, val}, Laws.RaRows{ri, ""}), rw, hs, at, sv, sk0, ab, rest, G),
  ihv: aq.VT(val)
) -> {Laws.own(T.doc.read(Laws.g.val.text(Laws.GKeyval{key, wa, wb, val}, rest),
  T.MScan{ap.s(Laws.k3.pos.lex(aq.kpos(pos)), bk, rw, hs, at, [], qk, T.CInl{inl, sv, at} <> sk0, un, lf,
    ab)})) == G : T.Doc}:
  +ha2 = {Eq.and.right(Laws.g.ok.key(key), Bool.and(Laws.abnf.ws(wa), Bool.and(Laws.abnf.ws(wb), Laws.g.ok.val(val,
    Laws.RVal{}))), ok) : {Bool.and(Laws.abnf.ws(wa), Bool.and(Laws.abnf.ws(wb), Laws.g.ok.val(val,
      Laws.RVal{}))) == True{} : Bool}}
  +ha3 = {Eq.and.right(Laws.abnf.ws(wa), Bool.and(Laws.abnf.ws(wb), Laws.g.ok.val(val, Laws.RVal{})),
    ha2) : {Bool.and(Laws.abnf.ws(wb), Laws.g.ok.val(val, Laws.RVal{})) == True{} : Bool}}
  +hk = {Eq.and.left(Laws.g.ok.key(key), Bool.and(Laws.abnf.ws(wa), Bool.and(Laws.abnf.ws(wb), Laws.g.ok.val(val,
    Laws.RVal{}))), ok) : {Laws.g.ok.key(key) == True{} : Bool}}
  +hv0 = {Eq.and.right(Laws.abnf.ws(wb), Laws.g.ok.val(val, Laws.RVal{}), ha3) : {Laws.g.ok.val(val,
    Laws.RVal{}) == True{} : Bool}}
  +s2 = {aq.sh(Laws.g.key.text(key, ""), String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val, rest))}),
    aq.shq(Laws.g.key.text(key, String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val, rest))})),
      String.append(Laws.g.key.text(key, ""), String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val,
        rest))})), gt.key(key, String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val, rest))})),
          es)) : {Laws.short(String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val,
            rest))})) == True{} : Bool}}
  +s5 = {aq.sh(wb, Laws.g.val.text(val, rest), gd.short.tail('=', String.append(wb, Laws.g.val.text(val, rest)),
    aq.sh(wa, SCon{'=', String.append(wb, Laws.g.val.text(val, rest))}, s2))) : {Laws.short(Laws.g.val.text(val,
      rest)) == True{} : Bool}}
  %Equal.sym(String, Laws.g.key.text(key, String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val,
    rest))})), Laws.k3.dk.text(ap.kds(key), ap.klast(key), String.append(wa, SCon{'=', String.append(wb,
      Laws.g.val.text(val, rest))})), ap.key.text(key, String.append(wa, SCon{'=', String.append(wb,
        Laws.g.val.text(val, rest))}), hk)) : {Laws.own(T.doc.read(_, T.MScan{ap.s(Laws.k3.pos.lex(aq.kpos(pos)), bk,
          rw, hs, at, [], qk, T.CInl{inl, sv, at} <> sk0, un, lf, ab)})) == G : T.Doc}
  %ap.gap(wa, Eq.and.left(Laws.abnf.ws(wa), Bool.and(Laws.abnf.ws(wb), Laws.g.ok.val(val, Laws.RVal{})),
    ha2)) : {Laws.own(T.doc.read(Laws.k3.dk.text(ap.kds(key), ap.klast(key), String.append(_, SCon{'=',
      String.append(wb, Laws.g.val.text(val, rest))})), T.MScan{ap.s(Laws.k3.pos.lex(aq.kpos(pos)), bk, rw, hs, at,
        [], qk, T.CInl{inl, sv, at} <> sk0, un, lf, ab)})) == G : T.Doc}
  kx.keys(ap.kds(key), ap.klast(key), ap.gs(wa), False{}, aq.kpos(pos), rw, hs, at, [], bk, qk, T.CInl{inl, sv,
    at} <> sk0, un, lf, ab, String.append(wb, Laws.g.val.text(val, rest)), dd => {Laws.own(dd) == G : T.Doc},
      ap.key.ok(key, hk), +b2 => +q2 => +u2 => +l2 =>
    %Equal.sym(T.Doc, T.doc.read(String.append(wb, Laws.g.val.text(val, rest)), T.MScan{ap.s(T.LVal{}, b2, rw, hs, at,
      k3.acc(ap.kds(key), ap.klast(key), False{}, []), q2, T.CInl{inl, sv, at} <> sk0, u2, l2, ab)}),
        T.doc.read(Laws.g.val.text(val, rest), T.MScan{ap.s(T.LVal{}, b2, rw, hs, at, k3.acc(ap.kds(key),
          ap.klast(key), False{}, []), q2, T.CInl{inl, sv, at} <> sk0, u2, l2, ab)}), ap.ws(wb, Laws.g.val.text(val,
            rest), T.LVal{}, b2, rw, hs, at, k3.acc(ap.kds(key), ap.klast(key), False{}, []), q2, T.CInl{inl, sv,
              at} <> sk0, u2, l2, ab, {==}, Eq.and.left(Laws.abnf.ws(wb), Laws.g.ok.val(val, Laws.RVal{}),
                ha3))) : {Laws.own(_) == G : T.Doc}
    ihv(False{}, rw, hs, at, k3.acc(ap.kds(key), ap.klast(key), False{}, []), b2, q2, T.CInl{inl, sv, at} <> sk0, u2,
      l2, ab, rest, G, hv0, s5, hf, aq.ikv(Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), Laws.g.key.names(key), rw,
        hs, at, sv, sk0, inl, ri, k3.acc(ap.kds(key), ap.klast(key), False{}, []), ab, rest, G, aq.kpath(key), hi,
          aq.rkt(Laws.replay.kv(Laws.g.key.names(key), Laws.replay.go(val, Laws.RaRows{ri, ""}), Laws.RaRows{ri, ""}),
            Laws.replay.kv(Laws.g.key.names(key), Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}), Laws.RaRows{ri,
              ""}), Equal.cong(Laws.RpAcc, Laws.RpAcc, aa => Laws.replay.kv(Laws.g.key.names(key), aa, Laws.RaRows{ri,
                ""}), Laws.replay.go(val, Laws.RaRows{ri, ""}), Laws.replay.go(val, Laws.RaVal{T.VArr{[]}, ""}),
                  aq.goval(val, Laws.RaRows{ri, ""}, hv0)), rw, hs, at, sv, sk0, ab, rest, dd =>
                    {Laws.own(dd) == G : T.Doc}, kk))))

# a keyval read: blank space, a comma, blank space and the keyvals after it,
# by the replay's reading of the keyval
def aq.kvsk(
  +rr: Laws.RpAcc,
  +w1: String,
  +w2: String,
  +rv: Laws.GVal,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +h1: {Laws.abnf.ws(w1) == True{} : Bool},
  +h2: {Laws.abnf.ws(w2) == True{} : Bool},
  +hrv: {Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{}) == True{} : Bool},
  +er: {Laws.short(Laws.g.val.text(rv, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  kk: aq.RKG(Laws.replay.go(rv, rr), rw, hs, at, sv, sk0, ab, rest, G),
  ihr: aq.KT(rv)
) -> aq.rk(rr, rw, hs, at, sv, sk0, ab, String.append(w1, SCon{',', String.append(w2, Laws.g.val.text(rv, rest))}),
  dd => {Laws.own(dd) == G : T.Doc}):
  match rr:
    case Laws.RaRows{+ri2, +bd}:
      match bd:
        case SNil{}:
          +inl2 => +b2 => +q2 => +u2 => +l2 => +hi2 =>
            %Equal.sym(T.Doc, T.doc.read(String.append(w1, SCon{',', String.append(w2, Laws.g.val.text(rv, rest))}),
              T.MScan{ap.s(T.LInlC{}, b2, rw, hs, at, [], q2, T.CInl{inl2, sv, at} <> sk0, u2, l2, ab)}),
                T.doc.read(SCon{',', String.append(w2, Laws.g.val.text(rv, rest))}, T.MScan{ap.s(T.LInlC{}, b2, rw,
                  hs, at, [], q2, T.CInl{inl2, sv, at} <> sk0, u2, l2, ab)}), ap.ws(w1, SCon{',', String.append(w2,
                    Laws.g.val.text(rv, rest))}, T.LInlC{}, b2, rw, hs, at, [], q2, T.CInl{inl2, sv, at} <> sk0, u2,
                      l2, ab, {==}, h1)) : {Laws.own(_) == G : T.Doc}
            %Equal.sym(T.Doc, T.doc.read(String.append(w2, Laws.g.val.text(rv, rest)), T.MScan{ap.s(T.LInlK{}, b2, rw,
              hs, at, [], q2, T.CInl{inl2, sv, at} <> sk0, u2, l2, ab)}), T.doc.read(Laws.g.val.text(rv, rest),
                T.MScan{ap.s(T.LInlK{}, b2, rw, hs, at, [], q2, T.CInl{inl2, sv, at} <> sk0, u2, l2, ab)}), ap.ws(w2,
                  Laws.g.val.text(rv, rest), T.LInlK{}, b2, rw, hs, at, [], q2, T.CInl{inl2, sv, at} <> sk0, u2, l2,
                    ab, {==}, h2)) : {Laws.own(_) == G : T.Doc}
            ihr(True{}, rw, hs, at, sv, sk0, inl2, ri2, b2, q2, u2, l2, ab, rest, G, aq.kvok.i(rv, hrv), er, hf, hi2,
              kk)
        case SCon{+c0, +cs}:
          aq.rke(rv, ri2, c0, cs, rw, hs, at, sv, sk0, ab, rest, dd => {Laws.own(dd) == G : T.Doc}, aq.kvok.i(rv,
            hrv), kk)
    case Laws.RaVal{_v, _b}:
      Unit{}
    case Laws.RaItems{_i, _b}:
      Unit{}

# an inline table's keyvals: a keyval, a comma and the keyvals after it
def aq.k.kvs(
  +kv: Laws.GVal,
  +w1: String,
  +w2: String,
  +rv: Laws.GVal,
  +pos: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +at: List<&2, String>,
  +sv: List<&2, String>,
  +sk0: List<&2, T.Ctx>,
  +inl: List<&2, T.Val>,
  +ri: List<&2, T.Val>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +G: T.Doc,
  +ok: {aq.kvok(Laws.GInlineTableKeyvals{kv, w1, w2, rv}) == True{} : Bool},
  +es: {Laws.short(Laws.g.val.text(Laws.GInlineTableKeyvals{kv, w1, w2, rv}, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  +hi: {Laws.own.rows(inl) == ri : List<&2, T.Val>},
  kk: aq.RKN(Laws.GInlineTableKeyvals{kv, w1, w2, rv}, ri, rw, hs, at, sv, sk0, ab, rest, G),
  ihk: aq.KT(kv),
  ihr: aq.KT(rv)
) -> {Laws.own(T.doc.read(Laws.g.val.text(Laws.GInlineTableKeyvals{kv, w1, w2, rv}, rest),
  T.MScan{ap.s(Laws.k3.pos.lex(aq.kpos(pos)), bk, rw, hs, at, [], qk, T.CInl{inl, sv, at} <> sk0, un, lf,
    ab)})) == G : T.Doc}:
  +h1r = {Eq.and.right(Laws.g.ok.val(kv, Laws.RKeyval{}), Bool.and(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2),
    Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{}))), ok) : {Bool.and(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2),
      Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{}))) == True{} : Bool}}
  +h2r = {Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{})),
    h1r) : {Bool.and(Laws.abnf.ws(w2), Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{})) == True{} : Bool}}
  +h1 = {Eq.and.left(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{})),
    h1r) : {Laws.abnf.ws(w1) == True{} : Bool}}
  +er = {aq.sh(w2, Laws.g.val.text(rv, rest), gd.short.tail(',', String.append(w2, Laws.g.val.text(rv, rest)),
    aq.sh(w1, SCon{',', String.append(w2, Laws.g.val.text(rv, rest))}, aq.sh.val(kv, String.append(w1, SCon{',',
      String.append(w2, Laws.g.val.text(rv, rest))}), es)))) : {Laws.short(Laws.g.val.text(rv, rest)) == True{} : Bool}}
  ihk(pos, rw, hs, at, sv, sk0, inl, ri, bk, qk, un, lf, ab, String.append(w1, SCon{',', String.append(w2,
    Laws.g.val.text(rv, rest))}), G, aq.kvok.k(kv, Eq.and.left(Laws.g.ok.val(kv, Laws.RKeyval{}),
      Bool.and(Laws.abnf.ws(w1), Bool.and(Laws.abnf.ws(w2), Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{}))), ok)), es,
        aq.fol.ws(w1, SCon{',', String.append(w2, Laws.g.val.text(rv, rest))}, h1, {==}), hi,
          aq.kvsk(Laws.replay.go(kv, Laws.RaRows{ri, ""}), w1, w2, rv, rw, hs, at, sv, sk0, ab, rest, G, h1,
            Eq.and.left(Laws.abnf.ws(w2), Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{}), h2r),
              Eq.and.right(Laws.abnf.ws(w2), Laws.g.ok.val(rv, Laws.RInlineTableKeyvals{}), h2r), er, hf, kk, ihr))

# every value node, as a value, as an array's items and as an inline table's
# keyvals, each claim by the rule its node spells
def aq.rd(
  nd: Laws.GVal
) -> aq.RD(nd):
  match nd:
    case Laws.GvString{+st}:
      +a => +b => aq.pick(a, b, Laws.GvString{st},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +es =>
          +hf => kk =>
          aq.v.str(st, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G, ok, es, hf, kk)),
        aq.noi(Laws.GvString{st}, {==}),
        aq.nok(Laws.GvString{st}, {==}))
    case Laws.GvBoolean{+cs}:
      +a => +b => aq.pick(a, b, Laws.GvBoolean{cs},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +_es =>
          +hf => kk =>
          aq.v.word(cs, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G,
            Laws.boolean_is_bare_word(String.from_list(cs), aq.tlp(xs => {Laws.abnf.boolean(xs) == True{} : Bool}, cs,
              ok)), hf, kk)),
        aq.noi(Laws.GvBoolean{cs}, {==}),
        aq.nok(Laws.GvBoolean{cs}, {==}))
    case Laws.GvArrayEmpty{+wn}:
      +a => +b => aq.pick(a, b, Laws.GvArrayEmpty{wn},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +_es =>
          +_hf => kk =>
          aq.v.arr0(wn, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G, ok, kk)),
        aq.noi(Laws.GvArrayEmpty{wn}, {==}),
        aq.nok(Laws.GvArrayEmpty{wn}, {==}))
    case Laws.GvArray{+vals, +wn}:
      +a => +b => aq.pick(a, b, Laws.GvArray{vals, wn},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +es =>
          +_hf => kk =>
          aq.v.arr(vals, wn, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G, Eq.and.left(Laws.g.ok.val(vals,
            Laws.RArrayValues{}), Laws.g.ok.wcn(wn), ok), Eq.and.right(Laws.g.ok.val(vals, Laws.RArrayValues{}),
              Laws.g.ok.wcn(wn), ok), es, kk, aq.rd(vals)(False{}, True{}))),
        aq.noi(Laws.GvArray{vals, wn}, {==}),
        aq.nok(Laws.GvArray{vals, wn}, {==}))
    case Laws.GvInlineTableEmpty{+w1, +w2}:
      +a => +b => aq.pick(a, b, Laws.GvInlineTableEmpty{w1, w2},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +_es =>
          +_hf => kk =>
          aq.v.inl0(w1, w2, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G, Eq.and.left(Laws.abnf.ws(w1),
            Laws.abnf.ws(w2), ok), Eq.and.right(Laws.abnf.ws(w1), Laws.abnf.ws(w2), ok), kk)),
        aq.noi(Laws.GvInlineTableEmpty{w1, w2}, {==}),
        aq.nok(Laws.GvInlineTableEmpty{w1, w2}, {==}))
    case Laws.GvInlineTable{+w1, +kvs, +w2}:
      +a => +b => aq.pick(a, b, Laws.GvInlineTable{w1, kvs, w2},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +es =>
          +_hf => kk =>
          aq.v.inl(w1, kvs, w2, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G, Eq.and.left(Laws.abnf.ws(w1),
            Bool.and(Laws.g.ok.val(kvs, Laws.RInlineTableKeyvals{}), Laws.abnf.ws(w2)), ok),
              Eq.and.left(Laws.g.ok.val(kvs, Laws.RInlineTableKeyvals{}), Laws.abnf.ws(w2),
                Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.g.ok.val(kvs, Laws.RInlineTableKeyvals{}),
                  Laws.abnf.ws(w2)), ok)), Eq.and.right(Laws.g.ok.val(kvs, Laws.RInlineTableKeyvals{}),
                    Laws.abnf.ws(w2), Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.g.ok.val(kvs,
                      Laws.RInlineTableKeyvals{}), Laws.abnf.ws(w2)), ok)), es, kk, aq.rd(kvs)(False{}, False{}))),
        aq.noi(Laws.GvInlineTable{w1, kvs, w2}, {==}),
        aq.nok(Laws.GvInlineTable{w1, kvs, w2}, {==}))
    case Laws.GvDateTime{+cs}:
      +a => +b => aq.pick(a, b, Laws.GvDateTime{cs},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +_es =>
          +hf => kk =>
          aq.v.word(cs, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G,
            Laws.date_time_is_bare_word(String.from_list(cs), aq.tlp(xs => {Laws.abnf.date_time(xs) == True{} : Bool},
              cs, Eq.and.left(Laws.abnf.date_time(cs), Laws.prose.date_time_in_range(cs), ok))), hf, kk)),
        aq.noi(Laws.GvDateTime{cs}, {==}),
        aq.nok(Laws.GvDateTime{cs}, {==}))
    case Laws.GvFloat{+cs}:
      +a => +b => aq.pick(a, b, Laws.GvFloat{cs},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +_es =>
          +hf => kk =>
          aq.v.word(cs, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G,
            Laws.float_is_bare_word(String.from_list(cs), aq.tlp(xs => {Laws.abnf.float(xs) == True{} : Bool}, cs,
              ok)), hf, kk)),
        aq.noi(Laws.GvFloat{cs}, {==}),
        aq.nok(Laws.GvFloat{cs}, {==}))
    case Laws.GvInteger{+cs}:
      +a => +b => aq.pick(a, b, Laws.GvInteger{cs},
        (+m => +rw => +hs => +he => +ps => +bk => +qk => +sk => +un => +lf => +ab => +rest => +G => +ok => +_es =>
          +hf => kk =>
          aq.v.word(cs, m, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, G,
            Laws.integer_is_bare_word(String.from_list(cs), aq.tlp(xs => {Laws.abnf.integer(xs) == True{} : Bool}, cs,
              Eq.and.left(Laws.abnf.integer(cs), Laws.prose.int_in_range(cs), ok))), hf, kk)),
        aq.noi(Laws.GvInteger{cs}, {==}),
        aq.nok(Laws.GvInteger{cs}, {==}))
    case Laws.GArrayValues{+wa, +val, +wb, +rv}:
      +a => +b => aq.pick(a, b, Laws.GArrayValues{wa, val, wb, rv},
        aq.nov(Laws.GArrayValues{wa, val, wb, rv}, {==}),
        (+rw => +hs => +at => +p => +sv => +sk0 => +its => +ri => +bk => +qk => +un => +lf => +ab => +rest => +G =>
          +ok => +es => +hf => +hi => kk =>
          aq.i.av(wa, val, wb, rv, rw, hs, at, p, sv, sk0, its, ri, bk, qk, un, lf, ab, rest, G, ok, es, hf, hi, kk,
            aq.rd(val)(True{}, True{}), aq.rd(rv)(False{}, True{}))),
        aq.nok(Laws.GArrayValues{wa, val, wb, rv}, {==}))
    case Laws.GArrayValuesLast{+wa, +val, +wb, +sep}:
      +a => +b => aq.pick(a, b, Laws.GArrayValuesLast{wa, val, wb, sep},
        aq.nov(Laws.GArrayValuesLast{wa, val, wb, sep}, {==}),
        (+rw => +hs => +at => +p => +sv => +sk0 => +its => +ri => +bk => +qk => +un => +lf => +ab => +rest => +G =>
          +ok => +es => +hf => +hi => kk =>
          aq.i.avl(wa, val, wb, sep, rw, hs, at, p, sv, sk0, its, ri, bk, qk, un, lf, ab, rest, G, ok, es, hf, hi, kk,
            aq.rd(val)(True{}, True{}))),
        aq.nok(Laws.GArrayValuesLast{wa, val, wb, sep}, {==}))
    case Laws.GInlineTableKeyvals{+kv, +w1, +w2, +rv}:
      +a => +b => aq.pick(a, b, Laws.GInlineTableKeyvals{kv, w1, w2, rv},
        aq.nov(Laws.GInlineTableKeyvals{kv, w1, w2, rv}, {==}),
        aq.noi(Laws.GInlineTableKeyvals{kv, w1, w2, rv}, {==}),
        (+pos => +rw => +hs => +at => +sv => +sk0 => +inl => +ri => +bk => +qk => +un => +lf => +ab => +rest => +G =>
          +ok => +es => +hf => +hi => kk =>
          aq.k.kvs(kv, w1, w2, rv, pos, rw, hs, at, sv, sk0, inl, ri, bk, qk, un, lf, ab, rest, G, ok, es, hf, hi, kk,
            aq.rd(kv)(False{}, False{}), aq.rd(rv)(False{}, False{}))))
    case Laws.GInlineTableKeyvalsLast{+kv}:
      +a => +b => aq.pick(a, b, Laws.GInlineTableKeyvalsLast{kv},
        aq.nov(Laws.GInlineTableKeyvalsLast{kv}, {==}),
        aq.noi(Laws.GInlineTableKeyvalsLast{kv}, {==}),
        (+pos => +rw => +hs => +at => +sv => +sk0 => +inl => +ri => +bk => +qk => +un => +lf => +ab => +rest => +G =>
          +ok => +es => +hf => +hi => kk =>
          aq.rd(kv)(False{}, False{})(pos, rw, hs, at, sv, sk0, inl, ri, bk, qk, un, lf, ab, rest, G, aq.kvok.k(kv,
            ok), es, hf, hi, kk)))
    case Laws.GKeyval{+key, +wa, +wb, +val}:
      +a => +b => aq.pick(a, b, Laws.GKeyval{key, wa, wb, val},
        aq.nov(Laws.GKeyval{key, wa, wb, val}, {==}),
        aq.noi(Laws.GKeyval{key, wa, wb, val}, {==}),
        (+pos => +rw => +hs => +at => +sv => +sk0 => +inl => +ri => +bk => +qk => +un => +lf => +ab => +rest => +G =>
          +ok => +es => +hf => +hi => kk =>
          aq.k.kv(key, wa, wb, val, pos, rw, hs, at, sv, sk0, inl, ri, bk, qk, un, lf, ab, rest, G, ok, es, hf, hi,
            kk, aq.rd(val)(True{}, True{}))))

# WP-A: a keyval line. Its blank space is passed over (ap.ws); KEY-3's key
# reader (kx.keys) reads the key and `=` from the start of a line with the
# segments pushed onto parts, from every back, qkind, uni and left; the
# blank space after `=` is passed over in LVal; the value, of any kind, is
# read by aq.rd, and put at the key's path in the lines' table (take.top). That walk commutes with own
# (ow.walk), so it ends where the replay's walk on the rows read out does,
# read out, and the rest of the line reads on as after a header (aq.hl). A
# word word.val refuses sets the error, which stays (wr.lift, error_stays).

# the keyval's walk has ended: the rest of the line and the text after it
# read, owned, to the replay from the walk's end read out
def aq.kvw(
  +en: T.End,
  +he: List<&2, String>,
  +w2: String,
  +com: Laws.GCom,
  +tail: String,
  +ls: List<&2, Laws.GLine>,
  +hw: {Laws.abnf.ws(w2) == True{} : Bool},
  +hc: {Laws.g.ok.com(com) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls),
  +b2: T.Lex,
  +q2: T.QKind,
  +u2: U32,
  +l2: U32
) -> {Laws.own(T.doc.read(String.append(w2, Laws.g.com.text(com, tail)), T.MScan{T.take.root(en, he, b2, q2, u2, l2,
  False{}, False{})})) == ap.F(ls, Laws.replay.end(ow.end(en), he)) : T.Doc}:
  match en:
    case T.End{+rows2, +bd2, +heads2}:
      aq.hl(bd2, rows2, heads2, he, w2, com, tail, ls, hw, hc, kk, ee)(b2, q2, u2, l2)

# a refused word's error: the document is the replay's, whose walk fails
def aq.kverr(
  +c0: Char,
  +cs: String,
  +vv: T.Val,
  +names: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ls: List<&2, Laws.GLine>,
  ee: ap.E(ls)
) -> {Laws.own(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}) == ap.F(ls, Laws.replay.root(names, Laws.RaVal{vv, SCon{c0, cs}},
  Laws.RpSt{"", Laws.own.rows(rw), hs, he})) : T.Doc}:
  %Equal.sym(T.End, T.tree.walk(List.append(&2, String, he, names), T.Tw{Laws.own.rows(rw), T.JPut{vv}, [], SCon{c0,
    cs}, "", hs, False{}}, T.path.len(he, 0)), T.End{Laws.own.rows(rw), SCon{c0, cs}, hs},
      Laws.failed_walk_changes_nothing(List.append(&2, String, he, names), Laws.own.rows(rw), T.JPut{vv}, SCon{c0,
        cs}, "", hs, False{}, T.path.len(he, 0), {==})) : {Laws.own(T.Doc{SCon{c0, cs}, T.rows.seal(rw)}) == ap.F(ls,
          Laws.replay.end(_, he)) : T.Doc}
  aq.err(SCon{c0, cs}, rw, hs, he, ls, {==}, ee)

# a root keyval's value, however the replay reads it: the value put at the
# key's path, and the rest read, owned, to the replay's walk and the lines
# after it
def aq.kvk(
  +rr: Laws.RpAcc,
  +names: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +acc: List<&2, String>,
  +w2: String,
  +com: Laws.GCom,
  +tail: String,
  +ls: List<&2, Laws.GLine>,
  +hp: {List.reverse(&2, String, acc) == names : List<&2, String>},
  +hw: {Laws.abnf.ws(w2) == True{} : Bool},
  +hc: {Laws.g.ok.com(com) == True{} : Bool},
  kk: aq.K(ls, tail),
  ee: ap.E(ls)
) -> aq.vk(rr, rw, hs, he, acc, [], False{}, String.append(w2, Laws.g.com.text(com, tail)), dd =>
  {Laws.own(dd) == ap.F(ls, Laws.replay.root(names, rr, Laws.RpSt{"", Laws.own.rows(rw), hs, he})) : T.Doc}):
  match rr:
    case Laws.RaVal{+vv, +bd}:
      match bd:
        case SNil{}:
          +xv => +b2 => +q2 => +u2 => +l2 => hv => _hc =>
            %hv : {Laws.own(T.doc.read(String.append(w2, Laws.g.com.text(com, tail)), T.MScan{T.take.top([], xv, "",
              rw, hs, he, acc, b2, q2, u2, l2, False{}, False{})})) == ap.F(ls,
                Laws.replay.end(T.tree.walk(List.append(&2, String, he, names), T.Tw{Laws.own.rows(rw), T.JPut{_}, [],
                  "", "", hs, False{}}, T.path.len(he, 0)), he)) : T.Doc}
            %hp : {Laws.own(T.doc.read(String.append(w2, Laws.g.com.text(com, tail)), T.MScan{T.take.top([], xv, "",
              rw, hs, he, acc, b2, q2, u2, l2, False{}, False{})})) == ap.F(ls,
                Laws.replay.end(T.tree.walk(List.append(&2, String, he, _), T.Tw{Laws.own.rows(rw), T.JPut{ow.v(xv)},
                  [], "", "", hs, False{}}, T.path.len(he, 0)), he)) : T.Doc}
            %ow.walk(List.append(&2, String, he, List.reverse(&2, String, acc)), T.Tw{rw, T.JPut{xv}, [], "", "", hs,
              False{}}, T.path.len(he, 0)) : {Laws.own(T.doc.read(String.append(w2, Laws.g.com.text(com, tail)),
                T.MScan{T.take.top([], xv, "", rw, hs, he, acc, b2, q2, u2, l2, False{}, False{})})) == ap.F(ls,
                  Laws.replay.end(_, he)) : T.Doc}
            aq.kvw(T.tree.walk(T.path.cat(he, acc), T.Tw{rw, T.JPut{xv}, [], "", "", hs, False{}}, T.path.len(he, 0)),
              he, w2, com, tail, ls, hw, hc, kk, ee, b2, q2, u2, l2)
        case SCon{+c0, +cs}:
          aq.kverr(c0, cs, vv, names, rw, hs, he, ls, ee)
    case Laws.RaItems{_i, _b}:
      Unit{}
    case Laws.RaRows{_r, _b}:
      Unit{}

# a keyval's key, `=` and value, from the start of a line in any table: the
# rest is read as the value's continuation gives it
def aq.kvl(
  +key: Laws.GKey,
  +wa: String,
  +wb: String,
  +val: Laws.GVal,
  +rest: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +G: T.Doc,
  +hk: {Laws.g.ok.key(key) == True{} : Bool},
  +hwa: {Laws.abnf.ws(wa) == True{} : Bool},
  +hwb: {Laws.abnf.ws(wb) == True{} : Bool},
  +ok: {Laws.g.ok.val(val, Laws.RVal{}) == True{} : Bool},
  +es: {Laws.short(Laws.g.val.text(val, rest)) == True{} : Bool},
  +hf: {aq.fol(rest) == True{} : Bool},
  kv: aq.VKV(val, rw, hs, he, k3.acc(ap.kds(key), ap.klast(key), False{}, []), [], False{}, rest, G)
) -> {Laws.own(T.doc.read(Laws.g.key.text(key, String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val,
  rest))})), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf, False{})})) == G : T.Doc}:
  %Equal.sym(String, Laws.g.key.text(key, String.append(wa, SCon{'=', String.append(wb, Laws.g.val.text(val,
    rest))})), Laws.k3.dk.text(ap.kds(key), ap.klast(key), String.append(wa, SCon{'=', String.append(wb,
      Laws.g.val.text(val, rest))})), ap.key.text(key, String.append(wa, SCon{'=', String.append(wb,
        Laws.g.val.text(val, rest))}), hk)) : {Laws.own(T.doc.read(_, T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk,
          [], un, lf, False{})})) == G : T.Doc}
  %ap.gap(wa, hwa) : {Laws.own(T.doc.read(Laws.k3.dk.text(ap.kds(key), ap.klast(key), String.append(_, SCon{'=',
    String.append(wb, Laws.g.val.text(val, rest))})), T.MScan{ap.s(T.LTop{}, bk, rw, hs, he, [], qk, [], un, lf,
      False{})})) == G : T.Doc}
  kx.keys(ap.kds(key), ap.klast(key), ap.gs(wa), False{}, Laws.AtLine{}, rw, hs, he, [], bk, qk, [], un, lf, False{},
    String.append(wb, Laws.g.val.text(val, rest)), dd => {Laws.own(dd) == G : T.Doc}, ap.key.ok(key, hk), +b2 =>
      +q2 => +u2 => +l2 =>
    %Equal.sym(T.Doc, T.doc.read(String.append(wb, Laws.g.val.text(val, rest)), T.MScan{ap.s(T.LVal{}, b2, rw, hs, he,
      k3.acc(ap.kds(key), ap.klast(key), False{}, []), q2, [], u2, l2, False{})}), T.doc.read(Laws.g.val.text(val,
