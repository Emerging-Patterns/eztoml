# The dec-int word, in or out of range. The spike's scan (gs.*) reads a
# dec-int's digits; here its reading is finished with the range test left
# open, so a word out of range is refused.

# what the dec-int reading claims: the scan's integer, tested for range
def n1.dw.G(+sg: T.Sign, +ds: String) -> T.Got:
  T.num.fin.range(T.i64.fits(sg, ds), sg, ds)

# the finished numeral is the integer, tested for range
def n1.dw.fin(
  +sg: T.Sign,
  +hh: Char,
  +tt: String,
  +hx: {Char.is_digit(hh) == True{} : Bool},
  +hz: {Char.is_eq(hh, '0') == False{} : Bool},
  +ht: {T.wf.digits(tt) == True{} : Bool},
  +cs: List<&2, Char>
) -> {T.num.fin(ndig(sg, vals(rev.onto(tt, [hh]))), cs) == n1.dw.G(sg, SCon{hh, tt}) : T.Got}:
  Equal.cong(String, T.Got, ss => T.num.fin.range(T.i64.fits(sg, ss), sg, ss), T.dec.text(vals(rev.onto(tt, [hh]))),
    SCon{hh, tt}, dtext(hh, tt, hx, hz, ht))

# after a first digit that is not 0, the scan reads the repetition and
# finishes as the integer, tested for range
def n1.dw.scan(
  +sg: T.Sign,
  +hh: Char,
  +t1: Char,
  +ts: List<&2, Char>,
  +st0: T.Num,
  +e0: {T.num.step(st0, hh) == ndig(sg, vals([hh])) : T.Num},
  +hx: {Char.is_digit(hh) == True{} : Bool},
  +hz: {Char.is_eq(hh, '0') == False{} : Bool},
  +hr: {Laws.abnf.dec_rep(t1 <> ts) == True{} : Bool},
  +cs: List<&2, Char>
) -> {T.num.fin(T.num.go(t1 <> ts, T.num.step(st0, hh)), cs) == n1.dw.G(sg, SCon{hh, Laws.abnf.no_us(t1 <> ts)})
  : T.Got}:
  Equal.trans(T.Got, T.num.fin(T.num.go(t1 <> ts, T.num.step(st0, hh)), cs),
    T.num.fin(ndig(sg, vals(rev.onto(Laws.abnf.no_us(t1 <> ts), [hh]))), cs),
    n1.dw.G(sg, SCon{hh, Laws.abnf.no_us(t1 <> ts)}),
    Equal.cong(T.Num, T.Got, nn => T.num.fin(nn, cs), T.num.go(t1 <> ts, T.num.step(st0, hh)),
      ndig(sg, vals(rev.onto(Laws.abnf.no_us(t1 <> ts), [hh]))),
      Equal.trans(T.Num, T.num.go(t1 <> ts, T.num.step(st0, hh)), T.num.go(t1 <> ts, ndig(sg, vals([hh]))),
        ndig(sg, vals(rev.onto(Laws.abnf.no_us(t1 <> ts), [hh]))),
        Equal.cong(T.Num, T.Num, nn => T.num.go(t1 <> ts, nn), T.num.step(st0, hh), ndig(sg, vals([hh])), e0),
        gs.scan(t1 <> ts, [hh], sg, hr, nzl.one(hh, hx, hz)))),
    n1.dw.fin(sg, hh, Laws.abnf.no_us(t1 <> ts), hx, hz, gs.digits(t1 <> ts, hr), cs))

