# the step dlit
def kg.dlit(
  +gg: K3G,
  lit: Bool,
  dot: Bool,
  nl: Bool,
  +st: T.St,
  +cc: Char,
  +eg: {kk.K(gg, st) == True{} : Bool},
  +ecl: {kk.cl(st) == KcO{} : KC}
) -> {kk.K(gg, T.lex.kdot.lit(lit, dot, nl, st, cc)) == True{} : Bool}:
