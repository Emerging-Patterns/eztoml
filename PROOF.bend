    case False{}:
      kg.hold(gg, T.st.lex(st, T.LStr{}), T.LStr{}, cc, kg.lex(gg, st, T.LStr{}, eg, KcV{}, ecl, {==}), KcV{},
        kk.clst(st, T.LStr{}), {==})

