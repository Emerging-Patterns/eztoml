          e1 => kk.kroot.pend(gg, parts, here, rows, vv, bad, heads, eo, eb, e1),
          e1 => Eq.bit.absurd(&2, {Laws.k3.has(kw.evs(T.tree.walk(T.path.cat(here, parts), T.Tw{rows, T.JPut{vv}, [],
