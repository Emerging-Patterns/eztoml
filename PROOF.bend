# the bundle for every state and every character of a live step
def fb.at(
  fl: T.Fl,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +cc: Char,
  +hl: {fl.live(T.wf.flo.step(fl, cc)) == True{} : Bool}
) -> fb(fl, sg, ds, cc):
  match fl:
    case T.FlStart{}:
      fb.start(sg, ds, cc, fch.go(T.FlStart{}, cc, fch(cc), {==}, hl), hl)
    case T.FlZero{}:
      fb.zero(sg, ds, cc, fch.go(T.FlZero{}, cc, fch(cc), {==}, hl), hl)
    case T.FlInt{}:
      fb.int(sg, ds, cc, fch.go(T.FlInt{}, cc, fch(cc), {==}, hl), hl)
    case T.FlDot{}:
      fb.dot(sg, ds, cc, fch.go(T.FlDot{}, cc, fch(cc), {==}, hl), hl)
    case T.FlFrac{}:
      fb.frac(sg, ds, cc, fch.go(T.FlFrac{}, cc, fch(cc), {==}, hl), hl)
    case T.FlE{}:
      fb.e(sg, ds, cc, fch.go(T.FlE{}, cc, fch(cc), {==}, hl), hl)
    case T.FlESign{}:
      fb.esign(sg, ds, cc, fch.go(T.FlESign{}, cc, fch(cc), {==}, hl), hl)
    case T.FlExp{}:
      fb.exp(sg, ds, cc, fch.go(T.FlExp{}, cc, fch(cc), {==}, hl), hl)
    case T.FlNo{}:
      Eq.bit.absurd(&1, fb(T.FlNo{}, sg, ds, cc), hl)

# a walk from the dead state stays there
def go.no(cs: List<&2, Char>) -> {T.wf.flo.go(cs, T.FlNo{}) == T.FlNo{} : T.Fl}:
  match cs:
    case []:
      {==}
    case _c <> tt:
      go.no(tt)

# a walk that ends accepting starts from a live state
def live.of(
  fl: T.Fl,
  cs: List<&2, Char>,
  hh: {T.wf.flo.end(T.wf.flo.go(cs, fl)) == True{} : Bool}
) -> {fl.live(fl) == True{} : Bool}:
  match fl:
    case T.FlNo{}:
      Eq.bit.absurd(&2, {False{} == True{} : Bool}, Equal.trans(Bool, False{},
        T.wf.flo.end(T.wf.flo.go(cs, T.FlNo{})), True{},
        Equal.cong(T.Fl, Bool, ff => T.wf.flo.end(ff), T.FlNo{}, T.wf.flo.go(cs, T.FlNo{}),
          Equal.sym(T.Fl, T.wf.flo.go(cs, T.FlNo{}), T.FlNo{}, go.no(cs))), hh))
    case T.FlStart{}:
      {==}
    case T.FlZero{}:
      {==}
    case T.FlInt{}:
      {==}
    case T.FlDot{}:
      {==}
    case T.FlFrac{}:
      {==}
    case T.FlE{}:
      {==}
    case T.FlESign{}:
      {==}
    case T.FlExp{}:
      {==}

# the facts of a step on a walk that ends accepting
def ffacts(
  +fl: T.Fl,
  +cc: Char,
  tt: List<&2, Char>,
  hh: {T.wf.flo.end(T.wf.flo.go(tt, T.wf.flo.step(fl, cc))) == True{} : Bool}
) -> {fl.facts(fl, cc) == True{} : Bool}:
  Equal.cong(Fs, Bool, fs => fs.b(fs),
    Fs{T.num.step(nm(fl, T.Plus{}, []), cc), fl.facts(fl, cc)},
    Fs{nm(T.wf.flo.step(fl, cc), T.Plus{}, T.dec.go(nm.ds(fl, []), 10, T.dig.val(cc))), True{}},
    fb.at(fl, T.Plus{}, [], cc, live.of(T.wf.flo.step(fl, cc), tt, hh)))

# the numeral scan walks a float's spelling as the automaton does
def fw.num(
  cs: List<&2, Char>,
  +fl: T.Fl,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +hh: {T.wf.flo.end(T.wf.flo.go(cs, fl)) == True{} : Bool}
) -> {T.num.go(cs, nm(fl, sg, ds)) == nm(T.wf.flo.go(cs, fl), sg, nds(cs, fl, ds)) : T.Num}:
  match cs:
    case []:
      {==}
    case +cc <> +tt:
      Equal.trans(T.Num, T.num.go(tt, T.num.step(nm(fl, sg, ds), cc)),
        T.num.go(tt, nm(T.wf.flo.step(fl, cc), sg, T.dec.go(nm.ds(fl, ds), 10, T.dig.val(cc)))),
        nm(T.wf.flo.go(tt, T.wf.flo.step(fl, cc)), sg, nds(tt, T.wf.flo.step(fl, cc),
          T.dec.go(nm.ds(fl, ds), 10, T.dig.val(cc)))),
        Equal.cong(T.Num, T.Num, nn => T.num.go(tt, nn), T.num.step(nm(fl, sg, ds), cc),
          nm(T.wf.flo.step(fl, cc), sg, T.dec.go(nm.ds(fl, ds), 10, T.dig.val(cc))),
          Equal.cong(Fs, T.Num, fs => fs.n(fs), Fs{T.num.step(nm(fl, sg, ds), cc), fl.facts(fl, cc)},
            Fs{nm(T.wf.flo.step(fl, cc), sg, T.dec.go(nm.ds(fl, ds), 10, T.dig.val(cc))), True{}},
            fb.at(fl, sg, ds, cc, live.of(T.wf.flo.step(fl, cc), tt, hh)))),
        fw.num(tt, T.wf.flo.step(fl, cc), sg, T.dec.go(nm.ds(fl, ds), 10, T.dig.val(cc)), hh))

# a float's spelling is characters a bare value keeps
def fw.rest(
  tt: String,
  +fl: T.Fl,
  +hh: {T.wf.flo.end(T.wf.flo.go(String.to_list(tt), fl)) == True{} : Bool}
) -> {Laws.word.rest(tt) == True{} : Bool}:
  match tt:
    case SNil{}:
      {==}
    case SCon{+cc, +ts}:
      and.tt(Laws.word.char(cc), Laws.word.rest(ts), Eq.and.left(Laws.word.char(cc), fa2(fl, cc),
        ffacts(fl, cc, String.to_list(ts), hh)), fw.rest(ts, T.wf.flo.step(fl, cc), hh))

# a float's spelling holds no underscore, so its body is itself
def fw.body(
  cs: List<&2, Char>,
  +fl: T.Fl,
  +out: List<&2, Char>,
  +hh: {T.wf.flo.end(T.wf.flo.go(cs, fl)) == True{} : Bool}
) -> {T.word.body.go(cs, False{}, out) == List.reverse.go(&2, Char, out, cs) : List<&2, Char>}:
  match cs:
    case []:
      {==}
    case +cc <> +tt:
      +f2 = {Eq.and.right(Laws.word.char(cc), fa2(fl, cc), ffacts(fl, cc, tt, hh)) : {fa2(fl, cc) == True{} : Bool}}
      Equal.trans(List<&2, Char>, T.word.body.go(tt, False{}, T.word.body.put.us(Char.is_eq(cc, '_'), cc, out)),
        T.word.body.go(tt, False{}, cc <> out), List.reverse.go(&2, Char, cc <> out, tt),
        Equal.cong(Bool, List<&2, Char>, bb => T.word.body.go(tt, False{}, T.word.body.put.us(bb, cc, out)),
          Char.is_eq(cc, '_'), False{}, Eq.not.true(Char.is_eq(cc, '_'), Eq.and.left(Bool.not(Char.is_eq(cc, '_')),
          fa3(fl, cc), f2))),
        fw.body(tt, T.wf.flo.step(fl, cc), cc <> out, hh))

# a float's spelling holds no colon
def fw.colon(
  cs: List<&2, Char>,
  +fl: T.Fl,
  +hh: {T.wf.flo.end(T.wf.flo.go(cs, fl)) == True{} : Bool}
) -> {T.word.colon(cs) == False{} : Bool}:
  match cs:
    case []:
      {==}
    case +cc <> +tt:
      +f3 = {Eq.and.right(Bool.not(Char.is_eq(cc, '_')), fa3(fl, cc), Eq.and.right(Laws.word.char(cc), fa2(fl, cc),
        ffacts(fl, cc, tt, hh))) : {fa3(fl, cc) == True{} : Bool}}
      Equal.trans(Bool, T.word.or(Char.is_eq(cc, ':'), T.word.colon(tt)), T.word.or(False{}, T.word.colon(tt)),
        False{},
        Equal.cong(Bool, Bool, bb => T.word.or(bb, T.word.colon(tt)), Char.is_eq(cc, ':'), False{},
          Eq.not.true(Char.is_eq(cc, ':'), Eq.and.left(Bool.not(Char.is_eq(cc, ':')), fa4(fl, cc), f3))),
        fw.colon(tt, T.wf.flo.step(fl, cc), hh))

# the left flag of a word.or that answered False
def wor.l(aa: Bool, bb: Bool, ee: {T.word.or(aa, bb) == False{} : Bool}) -> {aa == False{} : Bool}:
  match aa:
    case True{}:
      ee
    case False{}:
      {==}

# and the right one
def wor.r(aa: Bool, bb: Bool, ee: {T.word.or(aa, bb) == False{} : Bool}) -> {bb == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd2(&2, {bb == False{} : Bool}, ee)
    case False{}:
      ee

# a character that is no minus is no dash, first or not
def dhit(
  ff: Bool,
  cc: Char,
  hm: {Char.is_eq(cc, '-') == False{} : Bool}
) -> {T.word.dash.hit(ff, cc) == False{} : Bool}:
  match ff:
    case True{}:
      {==}
    case False{}:
      hm

# before the exponent, a spelling with no exponent mark holds no minus, and
# its walk stays before the exponent
def fw.dash(
  cs: List<&2, Char>,
  +fl: T.Fl,
  ff: Bool,
  +hh: {T.wf.flo.end(T.wf.flo.go(cs, fl)) == True{} : Bool},
  +hp: {fl.pre(fl) == True{} : Bool},
  +he: {T.word.ee(cs) == False{} : Bool}
) -> {T.word.dash(cs, ff) == False{} : Bool}:
  match cs:
    case []:
      {==}
    case +cc <> +tt:
      +f4 = {Eq.and.right(Bool.not(Char.is_eq(cc, ':')), fa4(fl, cc), Eq.and.right(Bool.not(Char.is_eq(cc, '_')),
        fa3(fl, cc), Eq.and.right(Laws.word.char(cc), fa2(fl, cc), ffacts(fl, cc, tt, hh))))
        : {fa4(fl, cc) == True{} : Bool}}
      +f5 = {Eq.and.right(Bool.not(Bool.and(fl.pre(fl), Char.is_eq(cc, '-'))), fa5(fl, cc), f4)
        : {fa5(fl, cc) == True{} : Bool}}
      +hx = {wor.l(T.word.ee.hit(cc), T.word.ee(tt), he) : {T.word.ee.hit(cc) == False{} : Bool}}
      +hm = {Equal.trans(Bool, Char.is_eq(cc, '-'), Bool.and(fl.pre(fl), Char.is_eq(cc, '-')), False{},
        Equal.cong(Bool, Bool, bb => Bool.and(bb, Char.is_eq(cc, '-')), True{}, fl.pre(fl),
          Equal.sym(Bool, fl.pre(fl), True{}, hp)),
        Eq.not.true(Bool.and(fl.pre(fl), Char.is_eq(cc, '-')), Eq.and.left(Bool.not(Bool.and(fl.pre(fl),
          Char.is_eq(cc, '-'))), fa5(fl, cc), f4))) : {Char.is_eq(cc, '-') == False{} : Bool}}
      +hq = {Equal.trans(Bool, fl.pre(T.wf.flo.step(fl, cc)), Bool.and(fl.pre(fl), Bool.not(T.word.ee.hit(cc))),
        True{},
        beq.eq(fl.pre(T.wf.flo.step(fl, cc)), Bool.and(fl.pre(fl), Bool.not(T.word.ee.hit(cc))),
          Eq.and.right(Bool.or(Bool.not(fl.start(fl)), Char.is_digit(cc)), fa6(fl, cc), f5)),
        Equal.trans(Bool, Bool.and(fl.pre(fl), Bool.not(T.word.ee.hit(cc))),
          Bool.and(True{}, Bool.not(T.word.ee.hit(cc))), True{},
          Equal.cong(Bool, Bool, bb => Bool.and(bb, Bool.not(T.word.ee.hit(cc))), fl.pre(fl), True{}, hp),
          Equal.cong(Bool, Bool, bb => Bool.and(True{}, Bool.not(bb)), T.word.ee.hit(cc), False{}, hx)))
        : {fl.pre(T.wf.flo.step(fl, cc)) == True{} : Bool}}
      Equal.trans(Bool, T.word.or(T.word.dash.hit(ff, cc), T.word.dash(tt, False{})),
        T.word.or(False{}, T.word.dash(tt, False{})), False{},
        Equal.cong(Bool, Bool, bb => T.word.or(bb, T.word.dash(tt, False{})), T.word.dash.hit(ff, cc), False{},
          dhit(ff, cc, hm)),
        fw.dash(tt, T.wf.flo.step(fl, cc), False{}, hh, hq, wor.r(T.word.ee.hit(cc), T.word.ee(tt), he)))

# a finished walk that accepts is a float, spelled by the body of the word
def fin.end(
  fl: T.Fl,
  +sg: T.Sign,
  ds: List<&2, U32>,
  cs: List<&2, Char>,
  hh: {T.wf.flo.end(fl) == True{} : Bool}
) -> {T.num.fin(nm(fl, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got}:
  match fl:
    case T.FlFrac{}:
      {==}
    case T.FlExp{}:
      {==}
    case T.FlStart{}:
      Eq.bit.absurd(&2, {T.num.fin(nm(T.FlStart{}, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got}, hh)
    case T.FlZero{}:
      Eq.bit.absurd(&2, {T.num.fin(nm(T.FlZero{}, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got}, hh)
    case T.FlInt{}:
      Eq.bit.absurd(&2, {T.num.fin(nm(T.FlInt{}, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got}, hh)
    case T.FlDot{}:
      Eq.bit.absurd(&2, {T.num.fin(nm(T.FlDot{}, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got}, hh)
    case T.FlE{}:
      Eq.bit.absurd(&2, {T.num.fin(nm(T.FlE{}, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got}, hh)
    case T.FlESign{}:
      Eq.bit.absurd(&2, {T.num.fin(nm(T.FlESign{}, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got},
        hh)
    case T.FlNo{}:
      Eq.bit.absurd(&2, {T.num.fin(nm(T.FlNo{}, sg, ds), cs) == T.GotVal{T.VFlo{sg, T.word.body(cs)}} : T.Got}, hh)

# a word the datetime route could take only by a dash in its exponent: an
# exponent mark keeps it a numeral, and with none it has no dash
def flo.route(
  +cs: List<&2, Char>,
  ex: Bool,
  eex: {T.word.ee(cs) == ex : Bool},
  hc: {T.word.colon(cs) == False{} : Bool},
  hd: {T.word.ee(cs) == False{} : Bool} -> {T.word.dash(cs, True{}) == False{} : Bool}
) -> {T.word.route(T.GotBad{""}, T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs) == T.word.num(cs) : T.Got}:
  match ex:
    case True{}:
      %Equal.sym(Bool, T.word.ee(cs), True{}, eex) :
        {T.word.route.date(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), _), cs)
          == T.word.num(cs) : T.Got}
      {==}
    case False{}:
      route.num(cs, hc, hd(eex))

# a digit is no sign
def dg.nosign(
  cc: Char,
  hc: {Char.is_digit(cc) == True{} : Bool}
) -> {Bool.or(Char.is_eq(cc, '+'), Char.is_eq(cc, '-')) == False{} : Bool}:
  dg.elim(zz => {Bool.or(Char.is_eq(zz, '+'), Char.is_eq(zz, '-')) == False{} : Bool}, cc, hc,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# after a minus, a digit is read as the first character of an unsigned
# numeral with the minus kept
def sign.skip(
  cc: Char,
  hc: {Char.is_digit(cc) == True{} : Bool}
) -> {T.num.step(T.Num{T.NSign{}, T.Minus{}, 10, [], False{}, False{}, ""}, cc) == T.num.step(nm(T.FlStart{}, T.Minus{},
  []), cc) : T.Num}:
  dg.elim(zz => {T.num.step(T.Num{T.NSign{}, T.Minus{}, 10, [], False{}, False{}, ""}, zz)
    == T.num.step(nm(T.FlStart{}, T.Minus{}, []), zz) : T.Num}, cc, hc,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# what flo_word claims
def flo.Goal(+sg: T.Sign, +text: String) -> Type:
  {T.word.val(String.to_list(T.render.atom(T.VFlo{sg, text}))) == T.GotVal{T.VFlo{sg, text}} : T.Got}

# a float's spelling starts with a digit
def fl.dig(
  +hh: Char,
  tt: String,
  hw: {T.wf.flo.end(T.wf.flo.go(hh <> String.to_list(tt), T.FlStart{})) == True{} : Bool}
) -> {Char.is_digit(hh) == True{} : Bool}:
  Eq.and.left(Char.is_digit(hh), fa6(T.FlStart{}, hh), Eq.and.right(Bool.not(Bool.and(True{},
    Char.is_eq(hh, '-'))), fa5(T.FlStart{}, hh), Eq.and.right(Bool.not(Char.is_eq(hh, ':')), fa4(T.FlStart{}, hh),
    Eq.and.right(Bool.not(Char.is_eq(hh, '_')), fa3(T.FlStart{}, hh), Eq.and.right(Laws.word.char(hh),
    fa2(T.FlStart{}, hh), ffacts(T.FlStart{}, hh, String.to_list(tt), hw))))))

# a positive float spelled by the automaton
def flo.plus(
  +hh: Char,
  +tt: String,
  +hw: {T.wf.flo.end(T.wf.flo.go(hh <> String.to_list(tt), T.FlStart{})) == True{} : Bool}
) -> flo.Goal(T.Plus{}, SCon{hh, tt}):
  +hd = {fl.dig(hh, tt, hw) : {Char.is_digit(hh) == True{} : Bool}}
  +cs = {hh <> String.to_list(tt) : List<&2, Char>}
  Equal.trans(T.Got, T.word.val.pick(T.word.special(hh), cs), T.word.val.pick(False{}, cs),
    T.GotVal{T.VFlo{T.Plus{}, SCon{hh, tt}}},
    Equal.cong(Bool, T.Got, bb => T.word.val.pick(bb, cs), T.word.special(hh), False{}, dg.nospec(hh, hd)),
    Equal.trans(T.Got, T.word.route(T.GotBad{""}, T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs),
      T.word.num(cs), T.GotVal{T.VFlo{T.Plus{}, SCon{hh, tt}}},
      flo.route(cs, T.word.ee(cs), {==}, fw.colon(cs, T.FlStart{}, hw),
        ee => fw.dash(cs, T.FlStart{}, True{}, hw, {==}, ee)),
      Equal.trans(T.Got, T.num.fin(T.num.go(cs, nm(T.FlStart{}, T.Plus{}, [])), cs),
        T.num.fin(nm(T.wf.flo.go(cs, T.FlStart{}), T.Plus{}, nds(cs, T.FlStart{}, [])), cs),
        T.GotVal{T.VFlo{T.Plus{}, SCon{hh, tt}}},
        Equal.cong(T.Num, T.Got, nn => T.num.fin(nn, cs), T.num.go(cs, nm(T.FlStart{}, T.Plus{}, [])),
          nm(T.wf.flo.go(cs, T.FlStart{}), T.Plus{}, nds(cs, T.FlStart{}, [])),
          fw.num(cs, T.FlStart{}, T.Plus{}, [], hw)),
        Equal.trans(T.Got, T.num.fin(nm(T.wf.flo.go(cs, T.FlStart{}), T.Plus{}, nds(cs, T.FlStart{}, [])), cs),
          T.GotVal{T.VFlo{T.Plus{}, T.word.body(cs)}}, T.GotVal{T.VFlo{T.Plus{}, SCon{hh, tt}}},
          fin.end(T.wf.flo.go(cs, T.FlStart{}), T.Plus{}, nds(cs, T.FlStart{}, []), cs, hw),
          Equal.cong(String, T.Got, ss => T.GotVal{T.VFlo{T.Plus{}, ss}}, T.word.body(cs), SCon{hh, tt},
            Equal.trans(String, String.from_list(T.word.body.go(String.to_list(tt), False{},
              T.word.body.put.sign(Bool.or(Char.is_eq(hh, '+'), Char.is_eq(hh, '-')), hh, []))),
              String.from_list(T.word.body.go(String.to_list(tt), False{}, [hh])), SCon{hh, tt},
              Equal.cong(Bool, String, bb => String.from_list(T.word.body.go(String.to_list(tt), False{},
                T.word.body.put.sign(bb, hh, []))), Bool.or(Char.is_eq(hh, '+'), Char.is_eq(hh, '-')), False{},
                dg.nosign(hh, hd)),
              Equal.trans(String, String.from_list(T.word.body.go(String.to_list(tt), False{}, [hh])),
                String.from_list(hh <> String.to_list(tt)), SCon{hh, tt},
                Equal.cong(List<&2, Char>, String, ls => String.from_list(ls),
                  T.word.body.go(String.to_list(tt), False{}, [hh]), hh <> String.to_list(tt),
                  fw.body(String.to_list(tt), T.wf.flo.step(T.FlStart{}, hh), [hh], hw)),
                ftl(SCon{hh, tt}))))))))

# a negative float spelled by the automaton: the minus makes the word a
# special candidate, which it is not, and the scan keeps the minus as the sign
def flo.minus(
  +hh: Char,
  +tt: String,
  +hw: {T.wf.flo.end(T.wf.flo.go(hh <> String.to_list(tt), T.FlStart{})) == True{} : Bool}
) -> flo.Goal(T.Minus{}, SCon{hh, tt}):
  +hd = {fl.dig(hh, tt, hw) : {Char.is_digit(hh) == True{} : Bool}}
  +cs = {hh <> String.to_list(tt) : List<&2, Char>}
  Equal.trans(T.Got, T.word.route(T.word.spec(String.from_list('-' <> cs)),
    T.word.or(T.word.colon('-' <> cs), T.word.dash('-' <> cs, True{})), '-' <> cs),
    T.word.route(T.GotBad{""}, T.word.or(T.word.colon('-' <> cs), T.word.dash('-' <> cs, True{})), '-' <> cs),
    T.GotVal{T.VFlo{T.Minus{}, SCon{hh, tt}}},
    Equal.cong(T.Got, T.Got, gg => T.word.route(gg, T.word.or(T.word.colon('-' <> cs),
      T.word.dash('-' <> cs, True{})), '-' <> cs), T.word.spec(String.from_list('-' <> cs)), T.GotBad{""},
      spec.m(hh, String.to_list(tt), dg.noi(hh, hd), dg.non(hh, hd))),
    Equal.trans(T.Got, T.word.route(T.GotBad{""}, T.word.or(T.word.colon('-' <> cs), T.word.dash('-' <> cs,
      True{})), '-' <> cs), T.word.num('-' <> cs), T.GotVal{T.VFlo{T.Minus{}, SCon{hh, tt}}},
      flo.route('-' <> cs, T.word.ee(cs), {==}, fw.colon(cs, T.FlStart{}, hw),
        ee => fw.dash(cs, T.FlStart{}, False{}, hw, {==}, ee)),
      Equal.trans(T.Got, T.num.fin(T.num.go(String.to_list(tt), T.num.step(T.Num{T.NSign{}, T.Minus{}, 10, [],
        False{}, False{}, ""}, hh)), '-' <> cs),
        T.num.fin(nm(T.wf.flo.go(cs, T.FlStart{}), T.Minus{}, nds(cs, T.FlStart{}, [])), '-' <> cs),
        T.GotVal{T.VFlo{T.Minus{}, SCon{hh, tt}}},
        Equal.cong(T.Num, T.Got, nn => T.num.fin(nn, '-' <> cs),
          T.num.go(String.to_list(tt), T.num.step(T.Num{T.NSign{}, T.Minus{}, 10, [], False{}, False{}, ""}, hh)),
          nm(T.wf.flo.go(cs, T.FlStart{}), T.Minus{}, nds(cs, T.FlStart{}, [])),
          Equal.trans(T.Num,
            T.num.go(String.to_list(tt), T.num.step(T.Num{T.NSign{}, T.Minus{}, 10, [], False{}, False{}, ""}, hh)),
            T.num.go(cs, nm(T.FlStart{}, T.Minus{}, [])),
            nm(T.wf.flo.go(cs, T.FlStart{}), T.Minus{}, nds(cs, T.FlStart{}, [])),
            Equal.cong(T.Num, T.Num, nn => T.num.go(String.to_list(tt), nn),
              T.num.step(T.Num{T.NSign{}, T.Minus{}, 10, [], False{}, False{}, ""}, hh),
              T.num.step(nm(T.FlStart{}, T.Minus{}, []), hh), sign.skip(hh, hd)),
            fw.num(cs, T.FlStart{}, T.Minus{}, [], hw))),
        Equal.trans(T.Got, T.num.fin(nm(T.wf.flo.go(cs, T.FlStart{}), T.Minus{}, nds(cs, T.FlStart{}, [])),
          '-' <> cs),
          T.GotVal{T.VFlo{T.Minus{}, T.word.body('-' <> cs)}}, T.GotVal{T.VFlo{T.Minus{}, SCon{hh, tt}}},
          fin.end(T.wf.flo.go(cs, T.FlStart{}), T.Minus{}, nds(cs, T.FlStart{}, []), '-' <> cs, hw),
          Equal.cong(String, T.Got, ss => T.GotVal{T.VFlo{T.Minus{}, ss}}, T.word.body('-' <> cs), SCon{hh, tt},
            Equal.trans(String, String.from_list(T.word.body.go(cs, False{}, [])), String.from_list(cs),
              SCon{hh, tt},
              Equal.cong(List<&2, Char>, String, ls => String.from_list(ls), T.word.body.go(cs, False{}, []), cs,
                fw.body(cs, T.FlStart{}, [], hw)),
              ftl(SCon{hh, tt})))))))


# a spelling the automaton accepts, with its first character, by the sign
def flo.auto.sg(
  +sg: T.Sign,
  +hh: Char,
  +tt: String,
  +hw: {T.wf.flo.end(T.wf.flo.go(hh <> String.to_list(tt), T.FlStart{})) == True{} : Bool}
) -> flo.Goal(sg, SCon{hh, tt}):
  match sg:
    case T.Plus{}:
      flo.plus(hh, tt, hw)
    case T.Minus{}:
      flo.minus(hh, tt, hw)

# a spelling the automaton accepts
def flo.auto(
  text: String,
  +sg: T.Sign,
  +hw: {T.wf.flo.end(T.wf.flo.go(String.to_list(text), T.FlStart{})) == True{} : Bool}
) -> flo.Goal(sg, text):
  match text:
    case SNil{}:
      Eq.bit.absurd(&1, flo.Goal(sg, SNil{}), hw)
    case SCon{+hh, +tt}:
      flo.auto.sg(sg, hh, tt, hw)

# inf or nan
def flo.name(aa: Bool) -> String:
  match aa:
    case True{}:
      "inf"
    case False{}:
      "nan"

# inf and nan, by the sign
def flo.fixed(+sg: T.Sign, aa: Bool) -> flo.Goal(sg, flo.name(aa)):
  match sg:
    case T.Plus{}:
      match aa:
        case True{}:
          {==}
        case False{}:
          {==}
    case T.Minus{}:
      match aa:
        case True{}:
          {==}
        case False{}:
          {==}

# a well-formed float: inf, nan, or a spelling the automaton accepts
def flo.spec(
  +sg: T.Sign,
  +text: String,
  aa: Bool,
  ea: {T.str.eq(text, "inf") == aa : Bool},
  bb: Bool,
  eb: {T.str.eq(text, "nan") == bb : Bool},
  +hw: {Bool.or(aa, Bool.or(bb, T.wf.flo.end(T.wf.flo.go(String.to_list(text), T.FlStart{})))) == True{} : Bool}
) -> flo.Goal(sg, text):
  match aa:
    case True{}:
      %Equal.sym(String, text, "inf", str.eq.true(text, "inf", ea)) : flo.Goal(sg, _)
      flo.fixed(sg, True{})
    case False{}:
      match bb:
        case True{}:
          %Equal.sym(String, text, "nan", str.eq.true(text, "nan", eb)) : flo.Goal(sg, _)
          flo.fixed(sg, False{})
        case False{}:
          flo.auto(text, sg, hw)

def Laws.flo_word(sg, text, w):
  flo.spec(sg, text, T.str.eq(text, "inf"), {==}, T.str.eq(text, "nan"), {==}, w)

# what flo.chars claims
def flo.Chars(+sg: T.Sign, +text: String) -> Type:
  {Laws.word.chars(T.render.atom(T.VFlo{sg, text})) == True{} : Bool}

# a spelling the automaton accepts is a bare value, by the sign
def flo.chars.sg(
  +sg: T.Sign,
  +hh: Char,
  +tt: String,
  +hw: {T.wf.flo.end(T.wf.flo.go(hh <> String.to_list(tt), T.FlStart{})) == True{} : Bool}
) -> flo.Chars(sg, SCon{hh, tt}):
  match sg:
    case T.Plus{}:
      and.tt(Laws.word.first(hh), Laws.word.rest(tt), dg.first(hh, fl.dig(hh, tt, hw)),
        fw.rest(tt, T.wf.flo.step(T.FlStart{}, hh), hw))
    case T.Minus{}:
      and.tt(Laws.word.first('-'), Laws.word.rest(SCon{hh, tt}), {==}, fw.rest(SCon{hh, tt}, T.FlStart{}, hw))

# a spelling the automaton accepts is a bare value
def flo.chars.auto(
  text: String,
  +sg: T.Sign,
  +hw: {T.wf.flo.end(T.wf.flo.go(String.to_list(text), T.FlStart{})) == True{} : Bool}
) -> flo.Chars(sg, text):
  match text:
    case SNil{}:
      Eq.bit.absurd(&1, flo.Chars(sg, SNil{}), hw)
    case SCon{+hh, +tt}:
      flo.chars.sg(sg, hh, tt, hw)

# inf and nan are bare values, with either sign
def flo.chars.fixed(+sg: T.Sign, aa: Bool) -> flo.Chars(sg, flo.name(aa)):
  match sg:
    case T.Plus{}:
      match aa:
        case True{}:
          {==}
        case False{}:
          {==}
    case T.Minus{}:
      match aa:
        case True{}:
          {==}
        case False{}:
          {==}

# a well-formed float is a bare value
def flo.chars(
  +sg: T.Sign,
  +text: String,
  aa: Bool,
  ea: {T.str.eq(text, "inf") == aa : Bool},
  bb: Bool,
  eb: {T.str.eq(text, "nan") == bb : Bool},
  +hw: {Bool.or(aa, Bool.or(bb, T.wf.flo.end(T.wf.flo.go(String.to_list(text), T.FlStart{})))) == True{} : Bool}
) -> flo.Chars(sg, text):
  match aa:
    case True{}:
      %Equal.sym(String, text, "inf", str.eq.true(text, "inf", ea)) : flo.Chars(sg, _)
      flo.chars.fixed(sg, True{})
    case False{}:
      match bb:
        case True{}:
          %Equal.sym(String, text, "nan", str.eq.true(text, "nan", eb)) : flo.Chars(sg, _)
          flo.chars.fixed(sg, False{})
        case False{}:
          flo.chars.auto(text, sg, hw)

def Laws.flo_reads_back(sg, text, w, fx, rest):
  Laws.word_reads_back(T.VFlo{sg, text}, T.render.atom(T.VFlo{sg, text}),
    flo.chars(sg, text, T.str.eq(text, "inf"), {==}, T.str.eq(text, "nan"), {==}, w), Laws.flo_word(sg, text, w),
    fx, rest)

# Datetimes. render writes each field with text.pad2 or text.pad4, which pad
# U32.show with zeros; U32.show writes the remainders of repeated division by
# ten, and the scan multiplies by ten and adds them back. The arithmetic is
# src/arith.bend's, ported from ezjson: a U32 is its quotient by ten times ten
# plus its remainder, as U32s, and a U32 below ten times k has a quotient below
# k. Each digit character is one of ten, so what the scan tests of it computes.

# a Nat compares equal to itself
def ncmp.refl(xx: Nat) -> {Nat.cmp(xx, xx) == EQ{} : Cmp}:
  match xx:
    case 0n:
      {==}
    case 1n+pp:
      ncmp.refl(pp)

# the words of two U32s that compare equal
def u.inj.go(aa: U32, bb: U32, ee: {U32.cmp(aa, bb) == EQ{} : Cmp}) -> {aa == bb : U32}:
  match aa bb:
    case U32{+wa} U32{+wb}:
      Equal.cong(Word(32n), U32, ww => U32{ww}, wa, wb, Eq.word_eq(32n, wa, wb, ee))

# two U32s with one count are one U32
def u.inj(+aa: U32, +bb: U32, ee: {U32.to_nat(aa) == U32.to_nat(bb) : Nat}) -> {aa == bb : U32}:
  u.inj.go(aa, bb, Equal.trans(Cmp, U32.cmp(aa, bb), Nat.cmp(U32.to_nat(aa), U32.to_nat(bb)), EQ{},
    Ar.u_cmp(aa, bb),
    Equal.trans(Cmp, Nat.cmp(U32.to_nat(aa), U32.to_nat(bb)), Nat.cmp(U32.to_nat(bb), U32.to_nat(bb)), EQ{},
      Equal.cong(Nat, Cmp, xx => Nat.cmp(xx, U32.to_nat(bb)), U32.to_nat(aa), U32.to_nat(bb), ee),
      ncmp.refl(U32.to_nat(bb)))))

# a U32 is ten times its quotient by ten plus its remainder
def dm(+uu: Unit, +nn: U32) -> {nn == U32.add(U32.mul(U32.div(nn, 10), 10), U32.mod(nn, 10)) : U32}:
  Equal.sym(U32, U32.add(U32.mul(U32.div(nn, 10), 10), U32.mod(nn, 10)), nn,
    u.inj(U32.add(U32.mul(U32.div(nn, 10), 10), U32.mod(nn, 10)), nn,
      Ar.nat_mod_small(Ar.step_ks(U32.div(nn, 10), U32.mod(nn, 10)),
        U32.to_nat(U32.add(U32.mul(U32.div(nn, 10), 10), U32.mod(nn, 10))), U32.to_nat(nn),
        Ar.pow2u(32n, uu),
        Equal.trans(Nat, Nat.add(U32.to_nat(U32.add(U32.mul(U32.div(nn, 10), 10), U32.mod(nn, 10))),
          Nat.mul(Ar.step_ks(U32.div(nn, 10), U32.mod(nn, 10)), Ar.pow2u(32n, uu))),
          Nat.add(Nat.mul(U32.to_nat(U32.div(nn, 10)), 10n), U32.to_nat(U32.mod(nn, 10))), U32.to_nat(nn),
          Ar.step_k(uu, U32.div(nn, 10), U32.mod(nn, 10)), Ar.u_div(Unit{}, nn)),
        Ar.u_bound(uu, nn))))

# a remainder by ten is below ten
def md(+nn: U32) -> {U32.is_lt(U32.mod(nn, 10), 10) == True{} : Bool}:
  Equal.trans(Bool, Cmp.is_lt(U32.cmp(U32.mod(nn, 10), 10)), Cmp.is_lt(Nat.cmp(U32.to_nat(U32.mod(nn, 10)), 10n)),
    True{},
    Equal.cong(Cmp, Bool, cc => Cmp.is_lt(cc), U32.cmp(U32.mod(nn, 10), 10),
      Nat.cmp(U32.to_nat(U32.mod(nn, 10)), 10n), Ar.u_cmp(U32.mod(nn, 10), 10)),
    Ar.u_mod(Unit{}, nn))


# below a bound is below any bound more than it
def lt.add(
  rr: Nat,
  aa: Nat,
  +kk: Nat,
  hh: {Nat.is_lt(rr, aa) == True{} : Bool}
) -> {Nat.is_lt(rr, Nat.add(aa, kk)) == True{} : Bool}:
  match rr aa:
    case 0n 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(0n, Nat.add(0n, kk)) == True{} : Bool}, hh)
    case 0n 1n+_a:
      {==}
    case 1n+r1 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(1n+r1, Nat.add(0n, kk)) == True{} : Bool}, hh)
    case 1n+r1 1n+a1:
      lt.add(r1, a1, kk, hh)

# nothing is below zero
def nlt.zero(xx: Nat) -> {Nat.is_lt(xx, 0n) == False{} : Bool}:
  match xx:
    case 0n:
      {==}
    case 1n+_p:
      {==}

# ten times q plus a digit is below ten times k exactly when q is below k
def ltm(
  qq: Nat,
  kk: Nat,
  +rr: Nat,
  +hr: {Nat.is_lt(rr, 10n) == True{} : Bool}
) -> {Nat.is_lt(Nat.add(Nat.mul(qq, 10n), rr), Nat.mul(kk, 10n)) == Nat.is_lt(qq, kk) : Bool}:
  match qq kk:
    case 0n 0n:
      nlt.zero(rr)
    case 0n 1n+k1:
      lt.add(rr, 10n, Nat.mul(k1, 10n), hr)
    case 1n+_q 0n:
      {==}
    case 1n+q1 1n+k1:
      ltm(q1, k1, rr, hr)

# at most k is below one more than k
def le.lt(xx: Nat, kk: Nat) -> {Cmp.is_le(Nat.cmp(xx, kk)) == Cmp.is_lt(Nat.cmp(xx, 1n+kk)) : Bool}:
  match xx kk:
    case 0n 0n:
      {==}
    case 0n 1n+_k:
      {==}
    case 1n+x1 0n:
      Equal.sym(Bool, Cmp.is_lt(Nat.cmp(x1, 0n)), False{}, nlt.zero(x1))
    case 1n+x1 1n+k1:
      le.lt(x1, k1)

# at most a, and a below b: below b
def nle(
  xx: Nat,
  aa: Nat,
  bb: Nat,
  h1: {Cmp.is_le(Nat.cmp(xx, aa)) == True{} : Bool},
  h2: {Nat.is_lt(aa, bb) == True{} : Bool}
) -> {Nat.is_lt(xx, bb) == True{} : Bool}:
  match xx aa bb:
    case 0n _a 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(0n, 0n) == True{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(aa, 0n), True{},
        Equal.sym(Bool, Nat.is_lt(aa, 0n), False{}, nlt.zero(aa)), h2))
    case 0n _a 1n+_b:
      {==}
    case 1n+x1 0n _b:
      Eq.bit.absurd(&2, {Nat.is_lt(1n+x1, bb) == True{} : Bool}, h1)
    case 1n+x1 1n+a1 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(1n+x1, 0n) == True{} : Bool}, h2)
    case 1n+x1 1n+a1 1n+b1:
      nle(x1, a1, b1, h1, h2)

# zero is exactly what is below one
def nz(xx: Nat) -> {Cmp.is_eq(Nat.cmp(xx, 0n)) == Cmp.is_lt(Nat.cmp(xx, 1n)) : Bool}:
  match xx:
    case 0n:
      {==}
    case 1n+x1:
      Equal.sym(Bool, Cmp.is_lt(Nat.cmp(x1, 0n)), False{}, nlt.zero(x1))

# a U32 comparison below is the Nat one
def u.lt(+aa: U32, +bb: U32) -> {U32.is_lt(aa, bb) == Nat.is_lt(U32.to_nat(aa), U32.to_nat(bb)) : Bool}:
  Equal.cong(Cmp, Bool, cc => Cmp.is_lt(cc), U32.cmp(aa, bb), Nat.cmp(U32.to_nat(aa), U32.to_nat(bb)),
    Ar.u_cmp(aa, bb))

# and at most
def u.le(+aa: U32, +bb: U32) -> {U32.is_le(aa, bb) == Cmp.is_le(Nat.cmp(U32.to_nat(aa), U32.to_nat(bb))) : Bool}:
  Equal.cong(Cmp, Bool, cc => Cmp.is_le(cc), U32.cmp(aa, bb), Nat.cmp(U32.to_nat(aa), U32.to_nat(bb)),
    Ar.u_cmp(aa, bb))

# a U32 is below ten times k exactly when its quotient by ten is below k
def lt10(
  +nn: U32,
  +kk: U32,
  +k10: U32,
  +kn: Nat,
  ek: {U32.to_nat(kk) == kn : Nat},
  ek10: {U32.to_nat(k10) == Nat.mul(kn, 10n) : Nat}
) -> {U32.is_lt(nn, k10) == U32.is_lt(U32.div(nn, 10), kk) : Bool}:
  Equal.trans(Bool, U32.is_lt(nn, k10), Nat.is_lt(U32.to_nat(nn), U32.to_nat(k10)), U32.is_lt(U32.div(nn, 10), kk),
    u.lt(nn, k10),
    Equal.trans(Bool, Nat.is_lt(U32.to_nat(nn), U32.to_nat(k10)),
      Nat.is_lt(Nat.add(Nat.mul(U32.to_nat(U32.div(nn, 10)), 10n), U32.to_nat(U32.mod(nn, 10))), Nat.mul(kn, 10n)),
      U32.is_lt(U32.div(nn, 10), kk),
      Equal.trans(Bool, Nat.is_lt(U32.to_nat(nn), U32.to_nat(k10)), Nat.is_lt(U32.to_nat(nn), Nat.mul(kn, 10n)),
        Nat.is_lt(Nat.add(Nat.mul(U32.to_nat(U32.div(nn, 10)), 10n), U32.to_nat(U32.mod(nn, 10))), Nat.mul(kn, 10n)),
        Equal.cong(Nat, Bool, xx => Nat.is_lt(U32.to_nat(nn), xx), U32.to_nat(k10), Nat.mul(kn, 10n), ek10),
        Equal.cong(Nat, Bool, xx => Nat.is_lt(xx, Nat.mul(kn, 10n)), U32.to_nat(nn),
          Nat.add(Nat.mul(U32.to_nat(U32.div(nn, 10)), 10n), U32.to_nat(U32.mod(nn, 10))),
          Equal.sym(Nat, Nat.add(Nat.mul(U32.to_nat(U32.div(nn, 10)), 10n), U32.to_nat(U32.mod(nn, 10))),
            U32.to_nat(nn), Ar.u_div(Unit{}, nn)))),
      Equal.trans(Bool,
        Nat.is_lt(Nat.add(Nat.mul(U32.to_nat(U32.div(nn, 10)), 10n), U32.to_nat(U32.mod(nn, 10))), Nat.mul(kn, 10n)),
        Nat.is_lt(U32.to_nat(U32.div(nn, 10)), kn), U32.is_lt(U32.div(nn, 10), kk),
        ltm(U32.to_nat(U32.div(nn, 10)), kn, U32.to_nat(U32.mod(nn, 10)), Ar.u_mod(Unit{}, nn)),
        Equal.trans(Bool, Nat.is_lt(U32.to_nat(U32.div(nn, 10)), kn),
          Nat.is_lt(U32.to_nat(U32.div(nn, 10)), U32.to_nat(kk)), U32.is_lt(U32.div(nn, 10), kk),
          Equal.cong(Nat, Bool, xx => Nat.is_lt(U32.to_nat(U32.div(nn, 10)), xx), kn, U32.to_nat(kk),
            Equal.sym(Nat, U32.to_nat(kk), kn, ek)),
          Equal.sym(Bool, U32.is_lt(U32.div(nn, 10), kk), Nat.is_lt(U32.to_nat(U32.div(nn, 10)), U32.to_nat(kk)),
            u.lt(U32.div(nn, 10), kk))))))

# a U32 is zero exactly when it is below one
def zlt(+qq: U32) -> {U32.is_zero(qq) == U32.is_lt(qq, 1) : Bool}:
  Equal.trans(Bool, Cmp.is_eq(U32.cmp(qq, 0)), Cmp.is_eq(Nat.cmp(U32.to_nat(qq), 0n)), U32.is_lt(qq, 1),
    Equal.cong(Cmp, Bool, cc => Cmp.is_eq(cc), U32.cmp(qq, 0), Nat.cmp(U32.to_nat(qq), 0n), Ar.u_cmp(qq, 0)),
    Equal.trans(Bool, Cmp.is_eq(Nat.cmp(U32.to_nat(qq), 0n)), Cmp.is_lt(Nat.cmp(U32.to_nat(qq), 1n)),
      U32.is_lt(qq, 1), nz(U32.to_nat(qq)), Equal.sym(Bool, U32.is_lt(qq, 1), Cmp.is_lt(Nat.cmp(U32.to_nat(qq), 1n)),
        u.lt(qq, 1))))

# a U32 is below ten exactly when its quotient by ten is zero
def qz(+nn: U32) -> {U32.is_lt(nn, 10) == U32.is_zero(U32.div(nn, 10)) : Bool}:
  Equal.trans(Bool, U32.is_lt(nn, 10), U32.is_lt(U32.div(nn, 10), 1), U32.is_zero(U32.div(nn, 10)),
    lt10(nn, 1, 10, 1n, {==}, {==}), Equal.sym(Bool, U32.is_zero(U32.div(nn, 10)), U32.is_lt(U32.div(nn, 10), 1),
      zlt(U32.div(nn, 10))))

# The ten values below ten. A U32 below ten has zeros above its four low bits,
# so a claim made of each of 0 to 9 is made of every U32 below ten.

# the U32 of four low bits and zeros above them
def sm.u(b0: Bool, b1: Bool, b2: Bool, b3: Bool) -> U32:
  U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, Eq.zw(28n)}}}}}

# a U32's comparison with 10, bit by bit, the bits above the fourth comparing
# as cc with zero
def sm.cp(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +cc: Cmp) -> Bool:
  Cmp.is_lt(Word.cmp.fin(b0, False{}, Word.cmp.fin(b1, True{}, Word.cmp.fin(b2, False{},
    Word.cmp.fin(b3, True{}, cc)))))

# the four low bits of a U32 below ten, highest first
def sm.bits(
  -P: U32 -> Type,
  +b3: Bool,
  +b2: Bool,
  +b1: Bool,
  +b0: Bool,
  h: {sm.cp(b0, b1, b2, b3, EQ{}) == True{} : Bool},
  p0: P(0),
  p1: P(1),
  p2: P(2),
  p3: P(3),
  p4: P(4),
  p5: P(5),
  p6: P(6),
  p7: P(7),
  p8: P(8),
  p9: P(9)
) -> P(sm.u(b0, b1, b2, b3)):
  match b3:
    case False{}:
      match b2 b1 b0:
        case False{} False{} False{}:
          p0
        case False{} False{} True{}:
          p1
        case False{} True{} False{}:
          p2
        case False{} True{} True{}:
          p3
        case True{} False{} False{}:
          p4
        case True{} False{} True{}:
          p5
        case True{} True{} False{}:
          p6
        case True{} True{} True{}:
          p7
    case True{}:
      match b2:
        case True{}:
          Eq.bit.absurd(&1, P(sm.u(b0, b1, True{}, True{})), h)
        case False{}:
          match b1:
            case True{}:
              match b0:
                case False{}:
                  Eq.bit.absurd(&1, P(sm.u(False{}, True{}, False{}, True{})), h)
                case True{}:
                  Eq.bit.absurd(&1, P(sm.u(True{}, True{}, False{}, True{})), h)
            case False{}:
              match b0:
                case False{}:
                  p8
                case True{}:
                  p9

# the bits above the fourth are zero, or the U32 is not below ten
def sm.at(
  -P: U32 -> Type,
  cc: Cmp,
  +b3: Bool,
  +b2: Bool,
  +b1: Bool,
  +b0: Bool,
  +rest: Word(28n),
  ec: {Word.cmp(28n, rest, Eq.zw(28n)) == cc : Cmp},
  h: {sm.cp(b0, b1, b2, b3, cc) == True{} : Bool},
  p0: P(0),
  p1: P(1),
  p2: P(2),
  p3: P(3),
  p4: P(4),
  p5: P(5),
  p6: P(6),
  p7: P(7),
  p8: P(8),
  p9: P(9)
) -> P(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, rest}}}}}):
  match cc:
    case LT{}:
      Eq.bit.gone(&1, P(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, rest}}}}}),
        Eq.bit.clash2(Equal.trans(Bool, True{}, Cmp.is_lt(Word.cmp(28n, rest, Eq.zw(28n))), False{},
          Equal.sym(Bool, Cmp.is_lt(Word.cmp(28n, rest, Eq.zw(28n))), True{},
            Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Word.cmp(28n, rest, Eq.zw(28n)), LT{}, ec)),
          Eq.zw_nlt(28n, rest))))
    case GT{}:
      Eq.bit.absurd(&1, P(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, rest}}}}}), h)
    case EQ{}:
      er = Equal.sym(Word(28n), rest, Eq.zw(28n), Eq.word_eq(28n, rest, Eq.zw(28n), ec))
      %er : P(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, _}}}}})
      sm.bits(P, b3, b2, b1, b0, h, p0, p1, p2, p3, p4, p5, p6, p7, p8, p9)

# a claim made of each of 0 to 9 is made of every U32 below ten
def sm.elim(
  -P: U32 -> Type,
  rr: U32,
  h: {U32.is_lt(rr, 10) == True{} : Bool},
  p0: P(0),
  p1: P(1),
  p2: P(2),
  p3: P(3),
  p4: P(4),
  p5: P(5),
  p6: P(6),
  p7: P(7),
  p8: P(8),
  p9: P(9)
) -> P(rr):
  match rr:
    case U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, +rest}}}}}:
      sm.at(P, Word.cmp(28n, rest, Eq.zw(28n)), b3, b2, b1, b0, rest, {==}, h,
        p0, p1, p2, p3, p4, p5, p6, p7, p8, p9)

# The digit U32.show writes for a remainder, and what the scan and the
# classifier ask of it.

# the digit of a value below ten, as U32.show writes it
def dch(+rr: U32) -> Char:
  Chr{U32.add(48, rr)}

# a character a datetime's text keeps in a bare value, with no exponent mark
def dtc(+cc: Char) -> Bool:
  Bool.and(Laws.word.char(cc), Bool.not(T.word.ee.hit(cc)))

# what the scan and the classifier ask of a digit: a digit, no colon, no dash,
# no special, a character that starts a bare value, and dtc
def df5(+cc: Char) -> Bool:
  Bool.and(Laws.word.first(cc), dtc(cc))

# no special, and the rest
def df4(+cc: Char) -> Bool:
  Bool.and(Bool.not(T.word.special(cc)), df5(cc))

# no dash, and the rest
def df3(+cc: Char) -> Bool:
  Bool.and(Bool.not(Char.is_eq(cc, '-')), df4(cc))

# no colon, and the rest
def df2(+cc: Char) -> Bool:
  Bool.and(Bool.not(Char.is_eq(cc, ':')), df3(cc))

# a digit, and the rest
def dfl(+cc: Char) -> Bool:
  Bool.and(Char.is_digit(cc), df2(cc))

# a step of the digit scan, a digit value and a bit
type Dt is Data:
  Dt{acc: U32, ok: Bool, val: U32, fl: Bool}

# the digit of a remainder by ten: the scan adds its value, and the facts hold
def dd(
  +nn: U32,
  +xx: U32
) -> {Dt{T.take.acc(True{}, nn, dch(U32.mod(xx, 10))), T.take.ok(True{}, dch(U32.mod(xx, 10))),
  T.dig.val(dch(U32.mod(xx, 10))), dfl(dch(U32.mod(xx, 10)))} == Dt{U32.add(U32.mul(nn, 10), U32.mod(xx, 10)), True{},
  U32.mod(xx, 10), True{}} : Dt}:
  sm.elim(rr => {Dt{T.take.acc(True{}, nn, dch(rr)), T.take.ok(True{}, dch(rr)), T.dig.val(dch(rr)), dfl(dch(rr))}
    == Dt{U32.add(U32.mul(nn, 10), rr), True{}, rr, True{}} : Dt}, U32.mod(xx, 10), md(xx),
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# the scan's accumulator
def dt.acc(dt: Dt) -> U32:
  match dt:
    case Dt{aa, _o, _v, _f}:
      aa

# the scan's flag
def dt.ok(dt: Dt) -> Bool:
  match dt:
    case Dt{_a, oo, _v, _f}:
      oo

# the digit's value
def dt.val(dt: Dt) -> U32:
  match dt:
    case Dt{_a, _o, vv, _f}:
      vv

# the facts
def dt.fl(dt: Dt) -> Bool:
  match dt:
    case Dt{_a, _o, _v, ff}:
      ff

# the scan adds the digit's value
def dd.acc(
  +nn: U32,
  +xx: U32
) -> {T.take.acc(True{}, nn, dch(U32.mod(xx, 10))) == U32.add(U32.mul(nn, 10), U32.mod(xx, 10)) : U32}:
  Equal.cong(Dt, U32, dt => dt.acc(dt), Dt{T.take.acc(True{}, nn, dch(U32.mod(xx, 10))),
    T.take.ok(True{}, dch(U32.mod(xx, 10))), T.dig.val(dch(U32.mod(xx, 10))), dfl(dch(U32.mod(xx, 10)))},
    Dt{U32.add(U32.mul(nn, 10), U32.mod(xx, 10)), True{}, U32.mod(xx, 10), True{}}, dd(nn, xx))

# and stays well
def dd.ok(+xx: U32) -> {T.take.ok(True{}, dch(U32.mod(xx, 10))) == True{} : Bool}:
  Equal.cong(Dt, Bool, dt => dt.ok(dt), Dt{T.take.acc(True{}, 0, dch(U32.mod(xx, 10))),
    T.take.ok(True{}, dch(U32.mod(xx, 10))), T.dig.val(dch(U32.mod(xx, 10))), dfl(dch(U32.mod(xx, 10)))},
    Dt{U32.add(U32.mul(0, 10), U32.mod(xx, 10)), True{}, U32.mod(xx, 10), True{}}, dd(0, xx))

# the digit's value
def dd.val(+xx: U32) -> {T.dig.val(dch(U32.mod(xx, 10))) == U32.mod(xx, 10) : U32}:
  Equal.cong(Dt, U32, dt => dt.val(dt), Dt{T.take.acc(True{}, 0, dch(U32.mod(xx, 10))),
    T.take.ok(True{}, dch(U32.mod(xx, 10))), T.dig.val(dch(U32.mod(xx, 10))), dfl(dch(U32.mod(xx, 10)))},
    Dt{U32.add(U32.mul(0, 10), U32.mod(xx, 10)), True{}, U32.mod(xx, 10), True{}}, dd(0, xx))

# the facts hold
def dd.fl(+xx: U32) -> {dfl(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Equal.cong(Dt, Bool, dt => dt.fl(dt), Dt{T.take.acc(True{}, 0, dch(U32.mod(xx, 10))),
    T.take.ok(True{}, dch(U32.mod(xx, 10))), T.dig.val(dch(U32.mod(xx, 10))), dfl(dch(U32.mod(xx, 10)))},
    Dt{U32.add(U32.mul(0, 10), U32.mod(xx, 10)), True{}, U32.mod(xx, 10), True{}}, dd(0, xx))

# the digit of a remainder is a digit
def dd.digit(+xx: U32) -> {Char.is_digit(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.left(Char.is_digit(dch(U32.mod(xx, 10))), df2(dch(U32.mod(xx, 10))), dd.fl(xx))

# the facts after the digit test
def dd.f2(+xx: U32) -> {df2(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.right(Char.is_digit(dch(U32.mod(xx, 10))), df2(dch(U32.mod(xx, 10))), dd.fl(xx))

# no colon
def dd.nocolon(+xx: U32) -> {Char.is_eq(dch(U32.mod(xx, 10)), ':') == False{} : Bool}:
  Eq.not.true(Char.is_eq(dch(U32.mod(xx, 10)), ':'), Eq.and.left(Bool.not(Char.is_eq(dch(U32.mod(xx, 10)), ':')),
    df3(dch(U32.mod(xx, 10))), dd.f2(xx)))

# the facts after the colon test
def dd.f3(+xx: U32) -> {df3(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.right(Bool.not(Char.is_eq(dch(U32.mod(xx, 10)), ':')), df3(dch(U32.mod(xx, 10))), dd.f2(xx))

# no dash
def dd.nodash(+xx: U32) -> {Char.is_eq(dch(U32.mod(xx, 10)), '-') == False{} : Bool}:
  Eq.not.true(Char.is_eq(dch(U32.mod(xx, 10)), '-'), Eq.and.left(Bool.not(Char.is_eq(dch(U32.mod(xx, 10)), '-')),
    df4(dch(U32.mod(xx, 10))), dd.f3(xx)))

# the facts after the dash test
def dd.f4(+xx: U32) -> {df4(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.right(Bool.not(Char.is_eq(dch(U32.mod(xx, 10)), '-')), df4(dch(U32.mod(xx, 10))), dd.f3(xx))

# no special
def dd.nospec(+xx: U32) -> {T.word.special(dch(U32.mod(xx, 10))) == False{} : Bool}:
  Eq.not.true(T.word.special(dch(U32.mod(xx, 10))), Eq.and.left(Bool.not(T.word.special(dch(U32.mod(xx, 10)))),
    df5(dch(U32.mod(xx, 10))), dd.f4(xx)))

# the facts after the special test
def dd.f5(+xx: U32) -> {df5(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.right(Bool.not(T.word.special(dch(U32.mod(xx, 10)))), df5(dch(U32.mod(xx, 10))), dd.f4(xx))

# a character that starts a bare value
def dd.first(+xx: U32) -> {Laws.word.first(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.left(Laws.word.first(dch(U32.mod(xx, 10))), dtc(dch(U32.mod(xx, 10))), dd.f5(xx))

# what a datetime keeps
def dd.dtc(+xx: U32) -> {dtc(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.right(Laws.word.first(dch(U32.mod(xx, 10))), dtc(dch(U32.mod(xx, 10))), dd.f5(xx))

# a character a bare value keeps
def dd.char(+xx: U32) -> {Laws.word.char(dch(U32.mod(xx, 10))) == True{} : Bool}:
  Eq.and.left(Laws.word.char(dch(U32.mod(xx, 10))), Bool.not(T.word.ee.hit(dch(U32.mod(xx, 10)))), dd.dtc(xx))

# no exponent mark
def dd.noe(+xx: U32) -> {T.word.ee.hit(dch(U32.mod(xx, 10))) == False{} : Bool}:
  Eq.not.true(T.word.ee.hit(dch(U32.mod(xx, 10))), Eq.and.right(Laws.word.char(dch(U32.mod(xx, 10))),
    Bool.not(T.word.ee.hit(dch(U32.mod(xx, 10)))), dd.dtc(xx)))

# A datetime's text as tokens: a digit of a remainder by ten, or a character
# written as itself (a separator, a zone mark, or a digit of the fraction).
type Tk is Data:
  TD{x: U32}
  TC{c: Char}

# the character of a token: TD{x} is the digit of x modulo ten
def tch(tk: Tk) -> Char:
  match tk:
    case TD{xx}:
      dch(U32.mod(xx, 10))
    case TC{cc}:
      cc

# the text of tokens
def tstr(ts: List<&2, Tk>) -> String:
  match ts:
    case []:
      SNil{}
    case tk <> tt:
      SCon{tch(tk), tstr(tt)}

# every character written as itself is one a datetime keeps; a digit always is
def tok(ts: List<&2, Tk>) -> Bool:
  match ts:
    case []:
      True{}
    case TD{_x} <> tt:
      tok(tt)
    case TC{+cc} <> tt:
      Bool.and(dtc(cc), tok(tt))

# the tokens' text holds no exponent mark
def tk.ee(ts: List<&2, Tk>, +hh: {tok(ts) == True{} : Bool}) -> {T.word.ee(String.to_list(tstr(ts))) == False{} : Bool}:
  match ts:
    case []:
      {==}
    case TD{+xx} <> +tt:
      Equal.trans(Bool, T.word.or(T.word.ee.hit(dch(U32.mod(xx, 10))), T.word.ee(String.to_list(tstr(tt)))),
        T.word.or(False{}, T.word.ee(String.to_list(tstr(tt)))), False{},
        Equal.cong(Bool, Bool, bb => T.word.or(bb, T.word.ee(String.to_list(tstr(tt)))),
          T.word.ee.hit(dch(U32.mod(xx, 10))), False{}, dd.noe(xx)),
        tk.ee(tt, hh))
    case TC{+cc} <> +tt:
      Equal.trans(Bool, T.word.or(T.word.ee.hit(cc), T.word.ee(String.to_list(tstr(tt)))),
        T.word.or(False{}, T.word.ee(String.to_list(tstr(tt)))), False{},
        Equal.cong(Bool, Bool, bb => T.word.or(bb, T.word.ee(String.to_list(tstr(tt)))), T.word.ee.hit(cc), False{},
          Eq.not.true(T.word.ee.hit(cc), Eq.and.right(Laws.word.char(cc), Bool.not(T.word.ee.hit(cc)),
          Eq.and.left(dtc(cc), tok(tt), hh)))),
        tk.ee(tt, Eq.and.right(dtc(cc), tok(tt), hh)))

# the tokens' text is characters a bare value keeps
def tk.rest(ts: List<&2, Tk>, +hh: {tok(ts) == True{} : Bool}) -> {Laws.word.rest(tstr(ts)) == True{} : Bool}:
  match ts:
    case []:
      {==}
    case TD{+xx} <> +tt:
      and.tt(Laws.word.char(dch(U32.mod(xx, 10))), Laws.word.rest(tstr(tt)), dd.char(xx), tk.rest(tt, hh))
    case TC{+cc} <> +tt:
      and.tt(Laws.word.char(cc), Laws.word.rest(tstr(tt)), Eq.and.left(Laws.word.char(cc),
        Bool.not(T.word.ee.hit(cc)), Eq.and.left(dtc(cc), tok(tt), hh)),
        tk.rest(tt, Eq.and.right(dtc(cc), tok(tt), hh)))

# the quotient of a U32 by ten
def q10(+nn: U32) -> U32:
  U32.div(nn, 10)

# a U32 that is zero is 0
def zero.eq(+xx: U32, hh: {U32.is_zero(xx) == True{} : Bool}) -> {xx == 0 : U32}:
  u.inj(xx, 0, Eq.u32_zero_nat(xx, hh))

# a U32 not below ten is not zero
def nzero.go(
  zz: Bool,
  +nn: U32,
  ez: {U32.is_zero(nn) == zz : Bool},
  es: {U32.is_lt(nn, 10) == False{} : Bool}
) -> {zz == False{} : Bool}:
  match zz:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {True{} == False{} : Bool}, Equal.trans(Bool, True{}, U32.is_lt(nn, 10), False{},
        Equal.cong(U32, Bool, xx => U32.is_lt(xx, 10), 0, nn, Equal.sym(U32, nn, 0, zero.eq(nn, ez))), es))

# a U32 not below ten is not zero
def nzero(+nn: U32, es: {U32.is_lt(nn, 10) == False{} : Bool}) -> {U32.is_zero(nn) == False{} : Bool}:
  nzero.go(U32.is_zero(nn), nn, {==}, es)

# a U32 below one hundred has a quotient below ten
def l100(+nn: U32) -> {U32.is_lt(nn, 100) == U32.is_lt(U32.div(nn, 10), 10) : Bool}:
  lt10(nn, 10, 100, 10n, {==}, {==})

# a U32 below ten is zero after one division by ten
def q.zero(+nn: U32, hh: {U32.is_lt(nn, 10) == True{} : Bool}) -> {U32.div(nn, 10) == 0 : U32}:
  zero.eq(U32.div(nn, 10), Equal.trans(Bool, U32.is_zero(U32.div(nn, 10)), U32.is_lt(nn, 10), True{},
    Equal.sym(Bool, U32.is_lt(nn, 10), U32.is_zero(U32.div(nn, 10)), qz(nn)), hh))

# its quotient by ten is not zero when it is not below ten
def q.nz(+nn: U32, hh: {U32.is_lt(nn, 10) == False{} : Bool}) -> {U32.is_zero(U32.div(nn, 10)) == False{} : Bool}:
  Equal.trans(Bool, U32.is_zero(U32.div(nn, 10)), U32.is_lt(nn, 10), False{},
    Equal.sym(Bool, U32.is_lt(nn, 10), U32.is_zero(U32.div(nn, 10)), qz(nn)), hh)

# the two digits pad2 writes for a value below one hundred
def d2(+nn: U32) -> List<&2, Tk>:
  [TD{U32.div(nn, 10)}, TD{nn}]

# pad2 of a value below ten: a zero, and the value itself or the digit of 0
def p2.small(
  zz: Bool,
  +nn: U32,
  ez: {U32.is_zero(nn) == zz : Bool},
  q0: {U32.div(nn, 10) == 0 : U32}
) -> {SCon{'0', U32.show.if(nn, zz)} == tstr(d2(nn)) : String}:
  match zz:
    case True{}:
      %Equal.sym(U32, nn, 0, zero.eq(nn, ez)) : {SCon{'0', U32.show.if(_, True{})} == tstr(d2(_)) : String}
      {==}
    case False{}:
      %Equal.sym(Bool, U32.is_zero(nn), False{}, ez) :
        {SCon{'0', U32.show.fin(9n, SNil{}, nn, _)} == tstr(d2(nn)) : String}
      %Equal.sym(U32, U32.div(nn, 10), 0, q0) :
        {SCon{'0', U32.show.go(9n, _, SCon{Chr{U32.add(48, U32.mod(nn, 10))}, SNil{}})}
          == tstr([TD{_}, TD{nn}]) : String}
      {==}

# pad2 by whether the value is below ten
def p2.go(
  small: Bool,
  +nn: U32,
  +es: {U32.is_lt(nn, 10) == small : Bool},
  hl: {U32.is_lt(nn, 100) == True{} : Bool}
) -> {T.pad2.go(small, nn) == tstr(d2(nn)) : String}:
  match small:
    case True{}:
      p2.small(U32.is_zero(nn), nn, {==}, q.zero(nn, es))
    case False{}:
      %Equal.sym(Bool, U32.is_zero(nn), False{}, nzero(nn, es)) : {U32.show.if(nn, _) == tstr(d2(nn)) : String}
      %Equal.sym(Bool, U32.is_zero(nn), False{}, nzero(nn, es)) :
        {U32.show.fin(9n, SNil{}, nn, _) == tstr(d2(nn)) : String}
      %Equal.sym(Bool, U32.is_zero(U32.div(nn, 10)), False{}, q.nz(nn, es)) :
        {U32.show.fin(8n, SCon{Chr{U32.add(48, U32.mod(nn, 10))}, SNil{}}, U32.div(nn, 10), _)
          == tstr(d2(nn)) : String}
      %Equal.sym(U32, U32.div(U32.div(nn, 10), 10), 0, q.zero(U32.div(nn, 10),
        Equal.trans(Bool, U32.is_lt(U32.div(nn, 10), 10), U32.is_lt(nn, 100), True{},
          Equal.sym(Bool, U32.is_lt(nn, 100), U32.is_lt(U32.div(nn, 10), 10), l100(nn)), hl))) :
        {U32.show.go(8n, _, SCon{Chr{U32.add(48, U32.mod(U32.div(nn, 10), 10))},
          SCon{Chr{U32.add(48, U32.mod(nn, 10))}, SNil{}}}) == tstr(d2(nn)) : String}
      {==}

# pad2 of a value below one hundred is its two digits
def pad2.eq(+nn: U32, hl: {U32.is_lt(nn, 100) == True{} : Bool}) -> {T.text.pad2(nn) == tstr(d2(nn)) : String}:
  p2.go(U32.is_lt(nn, 10), nn, {==}, hl)

# the four digits pad4 writes for a value below ten thousand
def d4(+yy: U32) -> List<&2, Tk>:
  [TD{U32.div(U32.div(U32.div(yy, 10), 10), 10)}, TD{U32.div(U32.div(yy, 10), 10)}, TD{U32.div(yy, 10)}, TD{yy}]

# below a thousand is a quotient below a hundred
def l1000(+nn: U32) -> {U32.is_lt(nn, 1000) == U32.is_lt(U32.div(nn, 10), 100) : Bool}:
  lt10(nn, 100, 1000, 100n, {==}, {==})

# a U32 is below ten times k exactly when its quotient by ten is below k,
# when ten times k does not overflow
def lt10m(
  +uu: Unit,
  +nn: U32,
  +kk: U32,
  hk: {Ar.umk(kk) == 0n : Nat}
) -> {U32.is_lt(nn, U32.mul(kk, 10)) == U32.is_lt(U32.div(nn, 10), kk) : Bool}:
  lt10(nn, kk, U32.mul(kk, 10), U32.to_nat(kk), {==}, Equal.trans(Nat, U32.to_nat(U32.mul(kk, 10)),
    Nat.add(U32.to_nat(U32.mul(kk, 10)), 0n), Nat.mul(U32.to_nat(kk), 10n),
    Equal.sym(Nat, Nat.add(U32.to_nat(U32.mul(kk, 10)), 0n), U32.to_nat(U32.mul(kk, 10)),
      Ar.nat_add_zero(U32.to_nat(U32.mul(kk, 10)))),
    Equal.trans(Nat, Nat.add(U32.to_nat(U32.mul(kk, 10)), 0n),
      Nat.add(U32.to_nat(U32.mul(kk, 10)), Nat.mul(Ar.umk(kk), Ar.pow2u(32n, uu))), Nat.mul(U32.to_nat(kk), 10n),
      Equal.cong(Nat, Nat, zz => Nat.add(U32.to_nat(U32.mul(kk, 10)), Nat.mul(zz, Ar.pow2u(32n, uu))), 0n,
        Ar.umk(kk), Equal.sym(Nat, Ar.umk(kk), 0n, hk)),
      Ar.u_mul10(uu, kk))))

# below ten thousand is a quotient below a thousand
def l10000(+uu: Unit, +nn: U32) -> {U32.is_lt(nn, 10000) == U32.is_lt(U32.div(nn, 10), 1000) : Bool}:
  lt10m(uu, nn, 1000, {==})

# below a thousand is a second quotient below ten
def lq2(+yy: U32) -> {U32.is_lt(yy, 1000) == U32.is_lt(U32.div(U32.div(yy, 10), 10), 10) : Bool}:
  Equal.trans(Bool, U32.is_lt(yy, 1000), U32.is_lt(U32.div(yy, 10), 100),
    U32.is_lt(U32.div(U32.div(yy, 10), 10), 10), l1000(yy), l100(U32.div(yy, 10)))

# below ten thousand is a third quotient below ten
def lq3(
  +uu: Unit,
  +yy: U32
) -> {U32.is_lt(yy, 10000) == U32.is_lt(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10) : Bool}:
  Equal.trans(Bool, U32.is_lt(yy, 10000), U32.is_lt(U32.div(yy, 10), 1000),
    U32.is_lt(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10), l10000(uu, yy),
    Equal.trans(Bool, U32.is_lt(U32.div(yy, 10), 1000), U32.is_lt(U32.div(U32.div(yy, 10), 10), 100),
      U32.is_lt(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10), l1000(U32.div(yy, 10)),
      l100(U32.div(U32.div(yy, 10), 10))))

# a truth read through an equation of bits
def bt(aa: Bool, bb: Bool, cc: Bool, ee: {aa == bb : Bool}, hh: {aa == cc : Bool}) -> {bb == cc : Bool}:
  Equal.trans(Bool, bb, aa, cc, Equal.sym(Bool, aa, bb, ee), hh)

# pad4 of a value below ten: three zeros, and the value or the digit of 0
def p4.small(
  zz: Bool,
  +yy: U32,
  ez: {U32.is_zero(yy) == zz : Bool},
  q0: {U32.div(yy, 10) == 0 : U32}
) -> {SCon{'0', SCon{'0', SCon{'0', U32.show.if(yy, zz)}}} == tstr(d4(yy)) : String}:
  match zz:
    case True{}:
      %Equal.sym(U32, yy, 0, zero.eq(yy, ez)) :
        {SCon{'0', SCon{'0', SCon{'0', U32.show.if(_, True{})}}} == tstr(d4(_)) : String}
      {==}
    case False{}:
      %Equal.sym(Bool, U32.is_zero(yy), False{}, ez) :
        {SCon{'0', SCon{'0', SCon{'0', U32.show.fin(9n, SNil{}, yy, _)}}} == tstr(d4(yy)) : String}
      %Equal.sym(U32, U32.div(yy, 10), 0, q0) :
        {SCon{'0', SCon{'0', SCon{'0', U32.show.go(9n, _, SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}})}}}
          == tstr([TD{U32.div(U32.div(_, 10), 10)}, TD{U32.div(_, 10)}, TD{_}, TD{yy}]) : String}
      {==}

# pad4 of a value from 10 to 99
def p4.mid(
  +yy: U32,
  +es: {U32.is_lt(yy, 10) == False{} : Bool},
  em: {U32.is_lt(yy, 100) == True{} : Bool}
) -> {SCon{'0', SCon{'0', U32.show(yy)}} == tstr(d4(yy)) : String}:
  %Equal.sym(Bool, U32.is_zero(yy), False{}, nzero(yy, es)) :
    {SCon{'0', SCon{'0', U32.show.if(yy, _)}} == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(yy), False{}, nzero(yy, es)) :
    {SCon{'0', SCon{'0', U32.show.fin(9n, SNil{}, yy, _)}} == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(U32.div(yy, 10)), False{}, q.nz(yy, es)) :
    {SCon{'0', SCon{'0', U32.show.fin(8n, SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}, U32.div(yy, 10), _)}}
      == tstr(d4(yy)) : String}
  %Equal.sym(U32, U32.div(U32.div(yy, 10), 10), 0, q.zero(U32.div(yy, 10), bt(U32.is_lt(yy, 100),
    U32.is_lt(U32.div(yy, 10), 10), True{}, l100(yy), em))) :
    {SCon{'0', SCon{'0', U32.show.go(8n, _, SCon{Chr{U32.add(48, U32.mod(U32.div(yy, 10), 10))},
      SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}})}}
      == tstr([TD{U32.div(_, 10)}, TD{_}, TD{U32.div(yy, 10)}, TD{yy}]) : String}
  {==}

# pad4 of a value from 100 to 999
def p4.big(
  +yy: U32,
  +es: {U32.is_lt(yy, 10) == False{} : Bool},
  +em: {U32.is_lt(yy, 100) == False{} : Bool},
  eb: {U32.is_lt(yy, 1000) == True{} : Bool}
) -> {SCon{'0', U32.show(yy)} == tstr(d4(yy)) : String}:
  %Equal.sym(Bool, U32.is_zero(yy), False{}, nzero(yy, es)) : {SCon{'0', U32.show.if(yy, _)} == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(yy), False{}, nzero(yy, es)) :
    {SCon{'0', U32.show.fin(9n, SNil{}, yy, _)} == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(U32.div(yy, 10)), False{}, q.nz(yy, es)) :
    {SCon{'0', U32.show.fin(8n, SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}, U32.div(yy, 10), _)}
      == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(U32.div(U32.div(yy, 10), 10)), False{}, q.nz(U32.div(yy, 10),
    bt(U32.is_lt(yy, 100), U32.is_lt(U32.div(yy, 10), 10), False{}, l100(yy), em))) :
    {SCon{'0', U32.show.fin(7n, SCon{Chr{U32.add(48, U32.mod(U32.div(yy, 10), 10))},
      SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}}, U32.div(U32.div(yy, 10), 10), _)} == tstr(d4(yy)) : String}
  %Equal.sym(U32, U32.div(U32.div(U32.div(yy, 10), 10), 10), 0, q.zero(U32.div(U32.div(yy, 10), 10),
    bt(U32.is_lt(yy, 1000), U32.is_lt(U32.div(U32.div(yy, 10), 10), 10), True{}, lq2(yy), eb))) :
    {SCon{'0', U32.show.go(7n, _, SCon{Chr{U32.add(48, U32.mod(U32.div(U32.div(yy, 10), 10), 10))},
      SCon{Chr{U32.add(48, U32.mod(U32.div(yy, 10), 10))}, SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}}})}
      == tstr([TD{_}, TD{U32.div(U32.div(yy, 10), 10)}, TD{U32.div(yy, 10)}, TD{yy}]) : String}
  {==}

# pad4 of a value from 1000 to 9999
def p4.full(
  +uu: Unit,
  +yy: U32,
  +es: {U32.is_lt(yy, 10) == False{} : Bool},
  +em: {U32.is_lt(yy, 100) == False{} : Bool},
  +eb: {U32.is_lt(yy, 1000) == False{} : Bool},
  hl: {U32.is_lt(yy, 10000) == True{} : Bool}
) -> {U32.show(yy) == tstr(d4(yy)) : String}:
  %Equal.sym(Bool, U32.is_zero(yy), False{}, nzero(yy, es)) : {U32.show.if(yy, _) == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(yy), False{}, nzero(yy, es)) :
    {U32.show.fin(9n, SNil{}, yy, _) == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(U32.div(yy, 10)), False{}, q.nz(yy, es)) :
    {U32.show.fin(8n, SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}, U32.div(yy, 10), _) == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(U32.div(U32.div(yy, 10), 10)), False{}, q.nz(U32.div(yy, 10),
    bt(U32.is_lt(yy, 100), U32.is_lt(U32.div(yy, 10), 10), False{}, l100(yy), em))) :
    {U32.show.fin(7n, SCon{Chr{U32.add(48, U32.mod(U32.div(yy, 10), 10))},
      SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}}, U32.div(U32.div(yy, 10), 10), _) == tstr(d4(yy)) : String}
  %Equal.sym(Bool, U32.is_zero(U32.div(U32.div(U32.div(yy, 10), 10), 10)), False{},
    q.nz(U32.div(U32.div(yy, 10), 10), bt(U32.is_lt(yy, 1000), U32.is_lt(U32.div(U32.div(yy, 10), 10), 10), False{},
    lq2(yy), eb))) :
    {U32.show.fin(6n, SCon{Chr{U32.add(48, U32.mod(U32.div(U32.div(yy, 10), 10), 10))},
      SCon{Chr{U32.add(48, U32.mod(U32.div(yy, 10), 10))}, SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}}},
      U32.div(U32.div(U32.div(yy, 10), 10), 10), _) == tstr(d4(yy)) : String}
  %Equal.sym(U32, U32.div(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10), 0,
    q.zero(U32.div(U32.div(U32.div(yy, 10), 10), 10), bt(U32.is_lt(yy, 10000),
    U32.is_lt(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10), True{}, lq3(uu, yy), hl))) :
    {U32.show.go(6n, _, SCon{Chr{U32.add(48, U32.mod(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10))},
      SCon{Chr{U32.add(48, U32.mod(U32.div(U32.div(yy, 10), 10), 10))},
      SCon{Chr{U32.add(48, U32.mod(U32.div(yy, 10), 10))}, SCon{Chr{U32.add(48, U32.mod(yy, 10))}, SNil{}}}}})
      == tstr(d4(yy)) : String}
  {==}

# pad4 by its three tests
def p4.go(
  small: Bool,
  mid: Bool,
  big: Bool,
  +uu: Unit,
  +yy: U32,
  +es: {U32.is_lt(yy, 10) == small : Bool},
  em: {U32.is_lt(yy, 100) == mid : Bool},
  eb: {U32.is_lt(yy, 1000) == big : Bool},
  hl: {U32.is_lt(yy, 10000) == True{} : Bool}
) -> {T.pad4.go(yy, small, mid, big) == tstr(d4(yy)) : String}:
  match small:
    case True{}:
      p4.small(U32.is_zero(yy), yy, {==}, q.zero(yy, es))
    case False{}:
      match mid:
        case True{}:
          p4.mid(yy, es, em)
        case False{}:
          match big:
            case True{}:
              p4.big(yy, es, em, eb)
            case False{}:
              p4.full(uu, yy, es, em, eb, hl)

# pad4 of a value below ten thousand is its four digits
def pad4.eq(
  +uu: Unit,
  +yy: U32,
  hl: {U32.is_lt(yy, 10000) == True{} : Bool}
) -> {T.text.pad4(yy) == tstr(d4(yy)) : String}:
  p4.go(U32.is_lt(yy, 10), U32.is_lt(yy, 100), U32.is_lt(yy, 1000), uu, yy, {==}, {==}, {==}, hl)

# the remainder by ten
def m10(+xx: U32) -> U32:
  U32.mod(xx, 10)

# the digit of a remainder by ten
def dx(+xx: U32) -> Char:
  dch(U32.mod(xx, 10))

# the digit scan takes the digit of a remainder and adds it
def tk1(
  kk: Nat,
  +xx: U32,
  tt: List<&2, Char>,
  +nn: U32
) -> {T.take.n(1n+kk, dx(xx) <> tt, nn, True{}) == T.take.n(kk, tt, U32.add(U32.mul(nn, 10), U32.mod(xx, 10)), True{}) :
  T.Dig}:
  Equal.trans(T.Dig, T.take.n(kk, tt, T.take.acc(True{}, nn, dx(xx)), T.take.ok(True{}, dx(xx))),
    T.take.n(kk, tt, U32.add(U32.mul(nn, 10), U32.mod(xx, 10)), T.take.ok(True{}, dx(xx))),
    T.take.n(kk, tt, U32.add(U32.mul(nn, 10), U32.mod(xx, 10)), True{}),
    Equal.cong(U32, T.Dig, aa => T.take.n(kk, tt, aa, T.take.ok(True{}, dx(xx))), T.take.acc(True{}, nn, dx(xx)),
      U32.add(U32.mul(nn, 10), U32.mod(xx, 10)), dd.acc(nn, xx)),
    Equal.cong(Bool, T.Dig, bb => T.take.n(kk, tt, U32.add(U32.mul(nn, 10), U32.mod(xx, 10)), bb),
      T.take.ok(True{}, dx(xx)), True{}, dd.ok(xx)))

# two digits of remainders, taken as a two-digit field
def tk2(
  +x1: U32,
  +x2: U32,
  +tt: List<&2, Char>
) -> {T.take.n(2n, dx(x1) <> dx(x2) <> tt, 0, True{}) == T.DigOk{U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(x1,
  10)), 10), U32.mod(x2, 10)), tt} : T.Dig}:
  Equal.trans(T.Dig, T.take.n(2n, dx(x1) <> dx(x2) <> tt, 0, True{}),
    T.take.n(1n, dx(x2) <> tt, U32.add(U32.mul(0, 10), U32.mod(x1, 10)), True{}),
    T.DigOk{U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(x1, 10)), 10), U32.mod(x2, 10)), tt},
    tk1(1n, x1, dx(x2) <> tt, 0), tk1(0n, x2, tt, U32.add(U32.mul(0, 10), U32.mod(x1, 10))))

# a value whose quotient by ten is below ten reads back from its two digits
def v2(
  +uu: Unit,
  +nn: U32,
  hq: {U32.div(U32.div(nn, 10), 10) == 0 : U32}
) -> {U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(nn, 10), 10)), 10), U32.mod(nn, 10)) == nn : U32}:
  Equal.sym(U32, nn, U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(nn, 10), 10)), 10), U32.mod(nn, 10)),
    Equal.trans(U32, nn, U32.add(U32.mul(U32.div(nn, 10), 10), U32.mod(nn, 10)),
      U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(nn, 10), 10)), 10), U32.mod(nn, 10)),
      dm(uu, nn),
      Equal.cong(U32, U32, zz => U32.add(U32.mul(zz, 10), U32.mod(nn, 10)), U32.div(nn, 10),
        U32.add(U32.mul(0, 10), U32.mod(U32.div(nn, 10), 10)),
        Equal.trans(U32, U32.div(nn, 10), U32.add(U32.mul(U32.div(U32.div(nn, 10), 10), 10),
          U32.mod(U32.div(nn, 10), 10)), U32.add(U32.mul(0, 10), U32.mod(U32.div(nn, 10), 10)),
          dm(uu, U32.div(nn, 10)),
          Equal.cong(U32, U32, zz => U32.add(U32.mul(zz, 10), U32.mod(U32.div(nn, 10), 10)),
            U32.div(U32.div(nn, 10), 10), 0, hq)))))

# a value below one hundred reads back from its two digits
def v2.lt(
  +uu: Unit,
  +nn: U32,
  hl: {U32.is_lt(nn, 100) == True{} : Bool}
) -> {U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(nn, 10), 10)), 10), U32.mod(nn, 10)) == nn : U32}:
  v2(uu, nn, q.zero(U32.div(nn, 10), bt(U32.is_lt(nn, 100), U32.is_lt(U32.div(nn, 10), 10), True{}, l100(nn), hl)))

# a value below ten thousand reads back from its four digits, as the year's
# scan takes them: two, then one, then one
def v4(
  +uu: Unit,
  +yy: U32,
  hl: {U32.is_lt(yy, 10000) == True{} : Bool}
) -> {U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(U32.div(U32.div(yy, 10),
  10), 10), 10)), 10), U32.mod(U32.div(U32.div(yy, 10), 10), 10)), 10), U32.mod(U32.div(yy, 10), 10)), 10), U32.mod(yy,
  10)) == yy : U32}:
  Equal.sym(U32, yy, U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(0, 10),
    U32.mod(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10)), 10), U32.mod(U32.div(U32.div(yy, 10), 10), 10)), 10),
    U32.mod(U32.div(yy, 10), 10)), 10), U32.mod(yy, 10)),
    Equal.trans(U32, yy, U32.add(U32.mul(U32.div(yy, 10), 10), U32.mod(yy, 10)),
      U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(0, 10),
        U32.mod(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10)), 10), U32.mod(U32.div(U32.div(yy, 10), 10), 10)), 10),
        U32.mod(U32.div(yy, 10), 10)), 10), U32.mod(yy, 10)),
      dm(uu, yy),
      Equal.cong(U32, U32, zz => U32.add(U32.mul(zz, 10), U32.mod(yy, 10)), U32.div(yy, 10),
        U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10)),
          10), U32.mod(U32.div(U32.div(yy, 10), 10), 10)), 10), U32.mod(U32.div(yy, 10), 10)),
        Equal.trans(U32, U32.div(yy, 10), U32.add(U32.mul(U32.div(U32.div(yy, 10), 10), 10), U32.mod(U32.div(yy, 10),
          10)),
          U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(U32.div(U32.div(yy, 10), 10), 10),
            10)), 10), U32.mod(U32.div(U32.div(yy, 10), 10), 10)), 10), U32.mod(U32.div(yy, 10), 10)),
          dm(uu, U32.div(yy, 10)),
          Equal.cong(U32, U32, zz => U32.add(U32.mul(zz, 10), U32.mod(U32.div(yy, 10), 10)),
            U32.div(U32.div(yy, 10), 10), U32.add(U32.mul(U32.add(U32.mul(0, 10),
            U32.mod(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10)), 10), U32.mod(U32.div(U32.div(yy, 10), 10), 10)),
            Equal.sym(U32, U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(U32.div(U32.div(U32.div(yy, 10), 10), 10),
              10)), 10), U32.mod(U32.div(U32.div(yy, 10), 10), 10)), U32.div(U32.div(yy, 10), 10),
              v2(uu, U32.div(U32.div(yy, 10), 10), q.zero(U32.div(U32.div(U32.div(yy, 10), 10), 10),
              bt(U32.is_lt(yy, 10000), U32.is_lt(U32.div(U32.div(U32.div(yy, 10), 10), 10), 10), True{},
              lq3(uu, yy), hl)))))))))

# the quotient by ten
def dq(+xx: U32) -> U32:
  U32.div(xx, 10)

# the tokens of a date, then more
def tdate(+yy: U32, +mo: U32, +dd: U32, rest: List<&2, Tk>) -> List<&2, Tk>:
  TD{dq(dq(dq(yy)))} <> TD{dq(dq(yy))} <> TD{dq(yy)} <> TD{yy} <> TC{'-'} <> TD{dq(mo)} <> TD{mo} <> TC{'-'} <>
    TD{dq(dd)} <> TD{dd} <> rest

# the tokens of a time of day, then more
def tclock(+hh: U32, +mi: U32, +ss: U32, rest: List<&2, Tk>) -> List<&2, Tk>:
  TD{dq(hh)} <> TD{hh} <> TC{':'} <> TD{dq(mi)} <> TD{mi} <> TC{':'} <> TD{dq(ss)} <> TD{ss} <> rest

# the characters of a text as tokens, then more
def tcs(ss: String, rest: List<&2, Tk>) -> List<&2, Tk>:
  match ss:
    case SNil{}:
      rest
    case SCon{cc, tt}:
      TC{cc} <> tcs(tt, rest)

# the tokens of a fraction: nothing, or a dot and its digits
def tfr(ss: String, rest: List<&2, Tk>) -> List<&2, Tk>:
  match ss:
    case SNil{}:
      rest
    case SCon{cc, tt}:
      TC{'.'} <> tcs(SCon{cc, tt}, rest)

# the character of a zone offset's sign
def zmark(sg: T.Sign) -> Char:
  match sg:
    case T.Plus{}:
      '+'
    case T.Minus{}:
      '-'

# the tokens of a zone
def tzone(zz: T.Zone) -> List<&2, Tk>:
  match zz:
    case T.Zulu{}:
      [TC{'Z'}]
    case T.Shift{sg, +hh, +mi}:
      TC{zmark(sg)} <> TD{dq(hh)} <> TD{hh} <> TC{':'} <> TD{dq(mi)} <> TD{mi} <> []

# the tokens of a datetime
def tks(ww: T.When) -> List<&2, Tk>:
  match ww:
    case T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz}:
      tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, tfr(fr, tzone(zz))))
    case T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}}:
      tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, tfr(fr, [])))
    case T.WDate{T.Date{yy, mo, dd}}:
      tdate(yy, mo, dd, [])
    case T.WTime{T.Clock{hh, mi, ss, fr}}:
      tclock(hh, mi, ss, tfr(fr, []))

# a text, then tokens, is the text's tokens then those
def tcs.eq(ss: String, rest: List<&2, Tk>) -> {String.append(ss, tstr(rest)) == tstr(tcs(ss, rest)) : String}:
  match ss:
    case SNil{}:
      {==}
    case SCon{+cc, tt}:
      Equal.cong(String, String, zz => SCon{cc, zz}, String.append(tt, tstr(rest)), tstr(tcs(tt, rest)),
        tcs.eq(tt, rest))

# the fraction clock.text writes, then tokens
def fr.eq(
  ss: String,
  rest: List<&2, Tk>
) -> {String.append(T.clock.frac(ss), tstr(rest)) == tstr(tfr(ss, rest)) : String}:
  match ss:
    case SNil{}:
      {==}
    case SCon{+cc, +tt}:
      Equal.cong(String, String, zz => SCon{'.', zz}, String.append(SCon{cc, tt}, tstr(rest)),
        tstr(tcs(SCon{cc, tt}, rest)), tcs.eq(SCon{cc, tt}, rest))

# the text of a date
def date.eq(
  +uu: Unit,
  +yy: U32,
  +mo: U32,
  +dd: U32,
  hy: {U32.is_lt(yy, 10000) == True{} : Bool},
  hm: {U32.is_lt(mo, 100) == True{} : Bool},
  hd: {U32.is_lt(dd, 100) == True{} : Bool}
) -> {T.date.text(T.Date{yy, mo, dd}) == tstr(tdate(yy, mo, dd, [])) : String}:
  Equal.trans(String, T.text.pad4(yy) ++ "-" ++ T.text.pad2(mo) ++ "-" ++ T.text.pad2(dd),
    tstr(d4(yy)) ++ "-" ++ T.text.pad2(mo) ++ "-" ++ T.text.pad2(dd), tstr(tdate(yy, mo, dd, [])),
    Equal.cong(String, String, zz => zz ++ "-" ++ T.text.pad2(mo) ++ "-" ++ T.text.pad2(dd), T.text.pad4(yy),
      tstr(d4(yy)), pad4.eq(uu, yy, hy)),
    Equal.trans(String, tstr(d4(yy)) ++ "-" ++ T.text.pad2(mo) ++ "-" ++ T.text.pad2(dd),
      tstr(d4(yy)) ++ "-" ++ tstr(d2(mo)) ++ "-" ++ T.text.pad2(dd), tstr(tdate(yy, mo, dd, [])),
      Equal.cong(String, String, zz => tstr(d4(yy)) ++ "-" ++ zz ++ "-" ++ T.text.pad2(dd), T.text.pad2(mo),
        tstr(d2(mo)), pad2.eq(mo, hm)),
      Equal.cong(String, String, zz => tstr(d4(yy)) ++ "-" ++ tstr(d2(mo)) ++ "-" ++ zz, T.text.pad2(dd),
        tstr(d2(dd)), pad2.eq(dd, hd))))

# the text of a time of day, before its fraction
def clock.eq(
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  h1: {U32.is_lt(hh, 100) == True{} : Bool},
  h2: {U32.is_lt(mi, 100) == True{} : Bool},
  h3: {U32.is_lt(ss, 100) == True{} : Bool}
) -> {T.clock.text(T.Clock{hh, mi, ss, fr}) == String.append(tstr(tclock(hh, mi, ss, [])), T.clock.frac(fr)) : String}:
  Equal.trans(String, T.text.pad2(hh) ++ ":" ++ T.text.pad2(mi) ++ ":" ++ T.text.pad2(ss) ++ T.clock.frac(fr),
    tstr(d2(hh)) ++ ":" ++ T.text.pad2(mi) ++ ":" ++ T.text.pad2(ss) ++ T.clock.frac(fr),
    String.append(tstr(tclock(hh, mi, ss, [])), T.clock.frac(fr)),
    Equal.cong(String, String, zz => zz ++ ":" ++ T.text.pad2(mi) ++ ":" ++ T.text.pad2(ss) ++ T.clock.frac(fr),
      T.text.pad2(hh), tstr(d2(hh)), pad2.eq(hh, h1)),
    Equal.trans(String, tstr(d2(hh)) ++ ":" ++ T.text.pad2(mi) ++ ":" ++ T.text.pad2(ss) ++ T.clock.frac(fr),
      tstr(d2(hh)) ++ ":" ++ tstr(d2(mi)) ++ ":" ++ T.text.pad2(ss) ++ T.clock.frac(fr),
      String.append(tstr(tclock(hh, mi, ss, [])), T.clock.frac(fr)),
      Equal.cong(String, String, zz => tstr(d2(hh)) ++ ":" ++ zz ++ ":" ++ T.text.pad2(ss) ++ T.clock.frac(fr),
        T.text.pad2(mi), tstr(d2(mi)), pad2.eq(mi, h2)),
      Equal.cong(String, String, zz => tstr(d2(hh)) ++ ":" ++ tstr(d2(mi)) ++ ":" ++ zz ++ T.clock.frac(fr),
        T.text.pad2(ss), tstr(d2(ss)), pad2.eq(ss, h3))))

# a zone's hour, 0 for Z
def zh(zz: T.Zone) -> U32:
  match zz:
    case T.Zulu{}:
      0
    case T.Shift{_s, hh, _m}:
      hh

# a zone's minute, 0 for Z
def zm(zz: T.Zone) -> U32:
  match zz:
    case T.Zulu{}:
      0
    case T.Shift{_s, _h, mi}:
      mi

# the sign written as its character
def zone.mark.eq(
  sg: T.Sign,
  +hh: U32,
  +mi: U32
) -> {T.zone.mark(sg) ++ tstr(d2(hh)) ++ ":" ++ tstr(d2(mi)) == tstr(tzone(T.Shift{sg, hh, mi})) : String}:
  match sg:
    case T.Plus{}:
      {==}
    case T.Minus{}:
      {==}

# the text of a zone
def zone.eq(
  zz: T.Zone,
  +hz: {Bool.and(U32.is_lt(zh(zz), 100), U32.is_lt(zm(zz), 100)) == True{} : Bool}
) -> {T.zone.text(zz) == tstr(tzone(zz)) : String}:
  match zz:
    case T.Zulu{}:
      {==}
    case T.Shift{sg, +hh, +mi}:
      Equal.trans(String, T.zone.mark(sg) ++ T.text.pad2(hh) ++ ":" ++ T.text.pad2(mi),
        T.zone.mark(sg) ++ tstr(d2(hh)) ++ ":" ++ T.text.pad2(mi), tstr(tzone(T.Shift{sg, hh, mi})),
        Equal.cong(String, String, xx => T.zone.mark(sg) ++ xx ++ ":" ++ T.text.pad2(mi), T.text.pad2(hh),
          tstr(d2(hh)), pad2.eq(hh, Eq.and.left(U32.is_lt(hh, 100), U32.is_lt(mi, 100), hz))),
        Equal.trans(String, T.zone.mark(sg) ++ tstr(d2(hh)) ++ ":" ++ T.text.pad2(mi),
          T.zone.mark(sg) ++ tstr(d2(hh)) ++ ":" ++ tstr(d2(mi)), tstr(tzone(T.Shift{sg, hh, mi})),
          Equal.cong(String, String, xx => T.zone.mark(sg) ++ tstr(d2(hh)) ++ ":" ++ xx, T.text.pad2(mi),
            tstr(d2(mi)), pad2.eq(mi, Eq.and.right(U32.is_lt(hh, 100), U32.is_lt(mi, 100), hz))),
          zone.mark.eq(sg, hh, mi)))

# at most k is below k and one, when k and one does not wrap
def le2lt(
  +xx: U32,
  +kk: U32,
  ez: {U32.is_zero(U32.add(kk, 1)) == False{} : Bool}
) -> {U32.is_le(xx, kk) == U32.is_lt(xx, U32.add(kk, 1)) : Bool}:
  Equal.trans(Bool, U32.is_le(xx, kk), Cmp.is_le(Nat.cmp(U32.to_nat(xx), U32.to_nat(kk))),
    U32.is_lt(xx, U32.add(kk, 1)), u.le(xx, kk),
    Equal.trans(Bool, Cmp.is_le(Nat.cmp(U32.to_nat(xx), U32.to_nat(kk))),
      Cmp.is_lt(Nat.cmp(U32.to_nat(xx), 1n+U32.to_nat(kk))), U32.is_lt(xx, U32.add(kk, 1)),
      le.lt(U32.to_nat(xx), U32.to_nat(kk)),
      Equal.trans(Bool, Cmp.is_lt(Nat.cmp(U32.to_nat(xx), 1n+U32.to_nat(kk))),
        Cmp.is_lt(Nat.cmp(U32.to_nat(xx), U32.to_nat(U32.add(kk, 1)))), U32.is_lt(xx, U32.add(kk, 1)),
        Equal.cong(Nat, Bool, nn => Cmp.is_lt(Nat.cmp(U32.to_nat(xx), nn)), 1n+U32.to_nat(kk),
          U32.to_nat(U32.add(kk, 1)), Equal.sym(Nat, U32.to_nat(U32.add(kk, 1)), 1n+U32.to_nat(kk), Eq.inc.nat(kk,
            ez))),
        Equal.sym(Bool, U32.is_lt(xx, U32.add(kk, 1)), Cmp.is_lt(Nat.cmp(U32.to_nat(xx),
          U32.to_nat(U32.add(kk, 1)))), u.lt(xx, U32.add(kk, 1))))))

# at most a bound below one hundred is below one hundred
def lt100(
  +xx: U32,
  +kk: U32,
  hh: {U32.is_le(xx, kk) == True{} : Bool},
  hk: {Nat.is_lt(U32.to_nat(kk), 100n) == True{} : Bool}
) -> {U32.is_lt(xx, 100) == True{} : Bool}:
  Equal.trans(Bool, U32.is_lt(xx, 100), Nat.is_lt(U32.to_nat(xx), 100n), True{}, u.lt(xx, 100),
    nle(U32.to_nat(xx), U32.to_nat(kk), 100n, Equal.trans(Bool, Cmp.is_le(Nat.cmp(U32.to_nat(xx), U32.to_nat(kk))),
      U32.is_le(xx, kk), True{}, Equal.sym(Bool, U32.is_le(xx, kk), Cmp.is_le(Nat.cmp(U32.to_nat(xx),
      U32.to_nat(kk))), u.le(xx, kk)), hh), hk))

# February has fewer than one hundred days
def dl.feb(
  four: Bool,
  hundred: Bool,
  fh: Bool
) -> {Nat.is_lt(U32.to_nat(T.when.feb.go(four, hundred, fh)), 100n) == True{} : Bool}:
  match four hundred fh:
    case True{} True{} True{}:
      {==}
    case True{} True{} False{}:
      {==}
    case True{} False{} _f:
      {==}
    case False{} _h _f:
      {==}

# every month has fewer than one hundred days
def dl.go(
  feb: Bool,
  short: Bool,
  +yy: U32
) -> {Nat.is_lt(U32.to_nat(T.when.days.go(feb, short, yy)), 100n) == True{} : Bool}:
  match feb:
    case True{}:
      dl.feb(U32.is_eq(U32.mod(yy, 4), 0), U32.is_eq(U32.mod(yy, 100), 0), U32.is_eq(U32.mod(yy, 400), 0))
    case False{}:
      match short:
        case True{}:
          {==}
        case False{}:
          {==}

# every month has fewer than one hundred days
def days.lt(+yy: U32, +mo: U32) -> {Nat.is_lt(U32.to_nat(T.when.days(yy, mo)), 100n) == True{} : Bool}:
  dl.go(U32.is_eq(mo, 2), T.when.short(mo), yy)

# nothing is below zero, as a comparison
def ge0n(nn: Nat) -> {Cmp.is_ge(Nat.cmp(nn, 0n)) == True{} : Bool}:
  match nn:
    case 0n:
      {==}
    case 1n+_p:
      {==}

# every U32 is at least 0
def ge0(+xx: U32) -> {U32.is_ge(xx, 0) == True{} : Bool}:
  Equal.trans(Bool, U32.is_ge(xx, 0), Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 0n)), True{},
    Equal.cong(Cmp, Bool, cc => Cmp.is_ge(cc), U32.cmp(xx, 0), Nat.cmp(U32.to_nat(xx), 0n), Ar.u_cmp(xx, 0)),
    ge0n(U32.to_nat(xx)))

# at most hi is in the range from 0 to hi
def rng0(+xx: U32, +hi: U32, hh: {U32.is_le(xx, hi) == True{} : Bool}) -> {T.bound.rng(xx, 0, hi) == True{} : Bool}:
  and.tt(U32.is_ge(xx, 0), U32.is_le(xx, hi), ge0(xx), hh)

# the upper half of a range
def rng.le(
  +xx: U32,
  +lo: U32,
  +hi: U32,
  hh: {T.bound.rng(xx, lo, hi) == True{} : Bool}
) -> {U32.is_le(xx, hi) == True{} : Bool}:
  Eq.and.right(U32.is_ge(xx, lo), U32.is_le(xx, hi), hh)

# a well-formed date's year is below ten thousand
def wd.y(
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hw: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}
) -> {U32.is_lt(yy, 10000) == True{} : Bool}:
  Equal.trans(Bool, U32.is_lt(yy, U32.add(9999, 1)), U32.is_le(yy, 9999), True{},
    Equal.sym(Bool, U32.is_le(yy, 9999), U32.is_lt(yy, U32.add(9999, 1)), le2lt(yy, 9999, {==})),
    Eq.and.left(U32.is_le(yy, 9999), Bool.and(T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy, mo))), hw))

# a well-formed date's month and day ranges
def wd.md(
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hw: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}
) -> {Bool.and( T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy, mo))) == True{} : Bool}:
  Eq.and.right(U32.is_le(yy, 9999), Bool.and(T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy, mo))), hw)

# a well-formed date's month range
def wd.mo(
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hw: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}
) -> {T.bound.rng(mo, 1, 12) == True{} : Bool}:
  Eq.and.left(T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy, mo)), wd.md(yy, mo, dd, hw))

# a well-formed date's day range
def wd.dd(
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hw: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}
) -> {T.bound.rng(dd, 1, T.when.days(yy, mo)) == True{} : Bool}:
  Eq.and.right(T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy, mo)), wd.md(yy, mo, dd, hw))

# a well-formed date's month is below one hundred
def wd.mo100(
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hw: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}
) -> {U32.is_lt(mo, 100) == True{} : Bool}:
  lt100(mo, 12, rng.le(mo, 1, 12, wd.mo(yy, mo, dd, hw)), {==})

# a well-formed date's day is below one hundred
def wd.dd100(
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hw: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}
) -> {U32.is_lt(dd, 100) == True{} : Bool}:
  lt100(dd, T.when.days(yy, mo), rng.le(dd, 1, T.when.days(yy, mo), wd.dd(yy, mo, dd, hw)), days.lt(yy, mo))

# a well-formed clock's hour bound
def wc.h(
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +hw: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {U32.is_le(hh, 23) == True{} : Bool}:
  Eq.and.left(U32.is_le(hh, 23), Bool.and(U32.is_le(mi, 59), Bool.and(U32.is_le(ss, 60), T.wf.digits(fr))), hw)

# the rest of a well-formed clock
def wc.r(
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +hw: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {Bool.and(U32.is_le(mi, 59), Bool.and(U32.is_le(ss, 60), T.wf.digits(fr))) == True{} : Bool}:
  Eq.and.right(U32.is_le(hh, 23), Bool.and(U32.is_le(mi, 59), Bool.and(U32.is_le(ss, 60), T.wf.digits(fr))), hw)

# a well-formed clock's minute bound
def wc.mi(
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +hw: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {U32.is_le(mi, 59) == True{} : Bool}:
  Eq.and.left(U32.is_le(mi, 59), Bool.and(U32.is_le(ss, 60), T.wf.digits(fr)), wc.r(hh, mi, ss, fr, hw))

# the second and the fraction of a well-formed clock
def wc.r2(
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +hw: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {Bool.and(U32.is_le(ss, 60), T.wf.digits(fr)) == True{} : Bool}:
  Eq.and.right(U32.is_le(mi, 59), Bool.and(U32.is_le(ss, 60), T.wf.digits(fr)), wc.r(hh, mi, ss, fr, hw))

# a well-formed clock's second bound
def wc.s(
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +hw: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {U32.is_le(ss, 60) == True{} : Bool}:
  Eq.and.left(U32.is_le(ss, 60), T.wf.digits(fr), wc.r2(hh, mi, ss, fr, hw))

# a well-formed clock's fraction is digits
def wc.fr(
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +hw: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {T.wf.digits(fr) == True{} : Bool}:
  Eq.and.right(U32.is_le(ss, 60), T.wf.digits(fr), wc.r2(hh, mi, ss, fr, hw))

# a well-formed zone's fields are below one hundred
def wz.100(
  zz: T.Zone,
  +hw: {T.wf.zone(zz) == True{} : Bool}
) -> {Bool.and(U32.is_lt(zh(zz), 100), U32.is_lt(zm(zz), 100)) == True{} : Bool}:
  match zz:
    case T.Zulu{}:
      {==}
    case T.Shift{_s, +hh, +mi}:
      and.tt(U32.is_lt(hh, 100), U32.is_lt(mi, 100), lt100(hh, 23, Eq.and.left(U32.is_le(hh, 23), U32.is_le(mi, 59),
        hw), {==}), lt100(mi, 59, Eq.and.right(U32.is_le(hh, 23), U32.is_le(mi, 59), hw), {==}))

# the text of a date and a clock: the date, T, the clock, and what follows
def dc.eq(
  +uu: Unit,
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +zt: String,
  +hd: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool},
  +hc: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++ zt ==
  String.append(tstr(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, []))), String.append(T.clock.frac(fr), zt)) :
  String}:
  Equal.trans(String, T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++ zt,
    tstr(tdate(yy, mo, dd, [])) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++ zt,
    String.append(tstr(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, []))), String.append(T.clock.frac(fr), zt)),
    Equal.cong(String, String, xx => xx ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++ zt,
      T.date.text(T.Date{yy, mo, dd}), tstr(tdate(yy, mo, dd, [])), date.eq(uu, yy, mo, dd, wd.y(yy, mo, dd, hd),
      wd.mo100(yy, mo, dd, hd), wd.dd100(yy, mo, dd, hd))),
    Equal.cong(String, String, xx => tstr(tdate(yy, mo, dd, [])) ++ "T" ++ xx ++ zt,
      T.clock.text(T.Clock{hh, mi, ss, fr}), String.append(tstr(tclock(hh, mi, ss, [])), T.clock.frac(fr)),
      clock.eq(hh, mi, ss, fr, lt100(hh, 23, wc.h(hh, mi, ss, fr, hc), {==}), lt100(mi, 59, wc.mi(hh, mi, ss, fr, hc),
      {==}), lt100(ss, 60, wc.s(hh, mi, ss, fr, hc), {==}))))

# the text of a well-formed datetime is its tokens'
def when.eq(
  +uu: Unit,
  ww: T.When,
  +hw: {T.wf.when(ww) == True{} : Bool}
) -> {T.when.text(ww) == tstr(tks(ww)) : String}:
  match ww:
    case T.WOff{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}, +zz}:
      +hd = {Eq.and.left(T.wf.date(T.Date{yy, mo, dd}), Bool.and(T.wf.clock(T.Clock{hh, mi, ss, fr}), T.wf.zone(zz)),
        hw) : {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}}
      +hr = {Eq.and.right(T.wf.date(T.Date{yy, mo, dd}), Bool.and(T.wf.clock(T.Clock{hh, mi, ss, fr}),
        T.wf.zone(zz)), hw) : {Bool.and(T.wf.clock(T.Clock{hh, mi, ss, fr}), T.wf.zone(zz)) == True{} : Bool}}
      Equal.trans(String, T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++
        T.zone.text(zz), T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++
        tstr(tzone(zz)), tstr(tks(T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz})),
        Equal.cong(String, String, xx => T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss,
          fr}) ++ xx, T.zone.text(zz), tstr(tzone(zz)), zone.eq(zz, wz.100(zz, Eq.and.right(T.wf.clock(T.Clock{hh, mi,
          ss, fr}), T.wf.zone(zz), hr)))),
        Equal.trans(String, T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++
          tstr(tzone(zz)), String.append(tstr(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, []))),
          String.append(T.clock.frac(fr), tstr(tzone(zz)))),
          tstr(tks(T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz})),
          dc.eq(uu, yy, mo, dd, hh, mi, ss, fr, tstr(tzone(zz)), hd, Eq.and.left(T.wf.clock(T.Clock{hh, mi, ss, fr}),
            T.wf.zone(zz), hr)),
          Equal.cong(String, String, xx => String.append(tstr(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, []))),
            xx), String.append(T.clock.frac(fr), tstr(tzone(zz))), tstr(tfr(fr, tzone(zz))), fr.eq(fr, tzone(zz)))))
    case T.WLocal{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}}:
      Equal.trans(String, T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}),
        T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++ "",
        tstr(tks(T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}})),
        Equal.cong(String, String, xx => T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ xx,
          T.clock.text(T.Clock{hh, mi, ss, fr}), T.clock.text(T.Clock{hh, mi, ss, fr}) ++ "",
          Equal.sym(String, T.clock.text(T.Clock{hh, mi, ss, fr}) ++ "", T.clock.text(T.Clock{hh, mi, ss, fr}),
          Eq.append_nil(T.clock.text(T.Clock{hh, mi, ss, fr})))),
      Equal.trans(String, T.date.text(T.Date{yy, mo, dd}) ++ "T" ++ T.clock.text(T.Clock{hh, mi, ss, fr}) ++ "",
        String.append(tstr(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, []))), String.append(T.clock.frac(fr), "")),
        tstr(tks(T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}})),
        dc.eq(uu, yy, mo, dd, hh, mi, ss, fr, "", Eq.and.left(T.wf.date(T.Date{yy, mo, dd}),
          T.wf.clock(T.Clock{hh, mi, ss, fr}), hw), Eq.and.right(T.wf.date(T.Date{yy, mo, dd}),
          T.wf.clock(T.Clock{hh, mi, ss, fr}), hw)),
        Equal.cong(String, String, xx => String.append(tstr(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, []))), xx),
          String.append(T.clock.frac(fr), ""), tstr(tfr(fr, [])), fr.eq(fr, []))))
    case T.WDate{T.Date{+yy, +mo, +dd}}:
      date.eq(uu, yy, mo, dd, wd.y(yy, mo, dd, hw), wd.mo100(yy, mo, dd, hw), wd.dd100(yy, mo, dd, hw))
    case T.WTime{T.Clock{+hh, +mi, +ss, +fr}}:
      Equal.trans(String, T.clock.text(T.Clock{hh, mi, ss, fr}), String.append(tstr(tclock(hh, mi, ss, [])),
        T.clock.frac(fr)), tstr(tclock(hh, mi, ss, tfr(fr, []))),
        clock.eq(hh, mi, ss, fr, lt100(hh, 23, wc.h(hh, mi, ss, fr, hw), {==}), lt100(mi, 59, wc.mi(hh, mi, ss, fr, hw),
          {==}), lt100(ss, 60, wc.s(hh, mi, ss, fr, hw), {==})),
        Equal.trans(String, String.append(tstr(tclock(hh, mi, ss, [])), T.clock.frac(fr)),
          String.append(tstr(tclock(hh, mi, ss, [])), String.append(T.clock.frac(fr), "")),
          tstr(tclock(hh, mi, ss, tfr(fr, []))),
          Equal.cong(String, String, xx => String.append(tstr(tclock(hh, mi, ss, [])), xx), T.clock.frac(fr),
            String.append(T.clock.frac(fr), ""), Equal.sym(String, String.append(T.clock.frac(fr), ""),
            T.clock.frac(fr), Eq.append_nil(T.clock.frac(fr)))),
          Equal.cong(String, String, xx => String.append(tstr(tclock(hh, mi, ss, [])), xx),
            String.append(T.clock.frac(fr), ""), tstr(tfr(fr, [])), fr.eq(fr, []))))

# The scan of a datetime's text, field by field.

# the characters of tokens
def tl(ts: List<&2, Tk>) -> List<&2, Char>:
  String.to_list(tstr(ts))

# the value of a two-digit field
def vA(+x1: U32, +x2: U32) -> U32:
  U32.add(U32.mul(U32.add(U32.mul(0, 10), U32.mod(x1, 10)), 10), U32.mod(x2, 10))

# the year's first two digits, as a field
def yA(+yy: U32) -> U32:
  vA(dq(dq(dq(yy))), dq(dq(yy)))

# and the third
def yB(+yy: U32) -> U32:
  U32.add(U32.mul(yA(yy), 10), U32.mod(dq(yy), 10))

# and the fourth
def yV(+yy: U32) -> U32:
  U32.add(U32.mul(yB(yy), 10), U32.mod(yy, 10))

# the year: two digits, a third that is no colon, and a fourth
def yr(
  +uu: Unit,
  +yy: U32,
  +rr: List<&2, Char>,
  +hl: {U32.is_lt(yy, 10000) == True{} : Bool}
) -> {T.when.after2(T.take.n(2n, dx(dq(dq(dq(yy)))) <> dx(dq(dq(yy))) <> dx(dq(yy)) <> dx(yy) <> rr, 0, True{})) ==
  T.when.year.dash(rr, yy) : T.WhenOut}:
  Equal.trans(T.WhenOut,
    T.when.after2(T.take.n(2n, dx(dq(dq(dq(yy)))) <> dx(dq(dq(yy))) <> dx(dq(yy)) <> dx(yy) <> rr, 0, True{})),
    T.when.branch(Char.is_eq(dx(dq(yy)), ':'), Char.is_digit(dx(dq(yy))), yA(yy), dx(dq(yy)), dx(yy) <> rr),
    T.when.year.dash(rr, yy),
    Equal.cong(T.Dig, T.WhenOut, dg => T.when.after2(dg),
      T.take.n(2n, dx(dq(dq(dq(yy)))) <> dx(dq(dq(yy))) <> dx(dq(yy)) <> dx(yy) <> rr, 0, True{}),
      T.DigOk{yA(yy), dx(dq(yy)) <> dx(yy) <> rr}, tk2(dq(dq(dq(yy))), dq(dq(yy)), dx(dq(yy)) <> dx(yy) <> rr)),
    Equal.trans(T.WhenOut,
      T.when.branch(Char.is_eq(dx(dq(yy)), ':'), Char.is_digit(dx(dq(yy))), yA(yy), dx(dq(yy)), dx(yy) <> rr),
      T.when.branch(False{}, True{}, yA(yy), dx(dq(yy)), dx(yy) <> rr),
      T.when.year.dash(rr, yy),
      Equal.trans(T.WhenOut,
        T.when.branch(Char.is_eq(dx(dq(yy)), ':'), Char.is_digit(dx(dq(yy))), yA(yy), dx(dq(yy)), dx(yy) <> rr),
        T.when.branch(False{}, Char.is_digit(dx(dq(yy))), yA(yy), dx(dq(yy)), dx(yy) <> rr),
        T.when.branch(False{}, True{}, yA(yy), dx(dq(yy)), dx(yy) <> rr),
        Equal.cong(Bool, T.WhenOut, bb => T.when.branch(bb, Char.is_digit(dx(dq(yy))), yA(yy), dx(dq(yy)),
          dx(yy) <> rr),
          Char.is_eq(dx(dq(yy)), ':'), False{}, dd.nocolon(dq(yy))),
        Equal.cong(Bool, T.WhenOut, bb => T.when.branch(False{}, bb, yA(yy), dx(dq(yy)), dx(yy) <> rr),
          Char.is_digit(dx(dq(yy))), True{}, dd.digit(dq(yy)))),
      Equal.trans(T.WhenOut,
        T.when.year4(T.take.n(1n, dx(yy) <> rr, U32.add(U32.mul(yA(yy), 10), T.dig.val(dx(dq(yy)))), True{})),
        T.when.year4(T.take.n(1n, dx(yy) <> rr, yB(yy), True{})),
        T.when.year.dash(rr, yy),
        Equal.cong(U32, T.WhenOut, vv => T.when.year4(T.take.n(1n, dx(yy) <> rr, U32.add(U32.mul(yA(yy), 10), vv),
          True{})), T.dig.val(dx(dq(yy))), U32.mod(dq(yy), 10), dd.val(dq(yy))),
        Equal.trans(T.WhenOut,
          T.when.year4(T.take.n(1n, dx(yy) <> rr, yB(yy), True{})),
          T.when.year.dash(rr, yV(yy)),
          T.when.year.dash(rr, yy),
          Equal.cong(T.Dig, T.WhenOut, dg => T.when.year4(dg), T.take.n(1n, dx(yy) <> rr, yB(yy), True{}),
            T.take.n(0n, rr, yV(yy), True{}), tk1(0n, yy, rr, yB(yy))),
          Equal.cong(U32, T.WhenOut, vv => T.when.year.dash(rr, vv), yV(yy), yy, v4(uu, yy, hl))))))

# the month and the day
def dmd(
  +uu: Unit,
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +rr: List<&2, Char>,
  +hm: {U32.is_lt(mo, 100) == True{} : Bool},
  +hd: {U32.is_lt(dd, 100) == True{} : Bool}
) -> {T.when.year.dash('-' <> dx(dq(mo)) <> dx(mo) <> '-' <> dx(dq(dd)) <> dx(dd) <> rr, yy) == T.when.date.ok(yy, mo,
  dd, rr) : T.WhenOut}:
  Equal.trans(T.WhenOut,
    T.when.month.go(T.take.n(2n, dx(dq(mo)) <> dx(mo) <> '-' <> dx(dq(dd)) <> dx(dd) <> rr, 0, True{}), yy),
    T.when.day.go(True{}, T.take.n(2n, dx(dq(dd)) <> dx(dd) <> rr, 0, True{}), yy, vA(dq(mo), mo)),
    T.when.date.ok(yy, mo, dd, rr),
    Equal.cong(T.Dig, T.WhenOut, dg => T.when.month.go(dg, yy),
      T.take.n(2n, dx(dq(mo)) <> dx(mo) <> '-' <> dx(dq(dd)) <> dx(dd) <> rr, 0, True{}),
      T.DigOk{vA(dq(mo), mo), '-' <> dx(dq(dd)) <> dx(dd) <> rr}, tk2(dq(mo), mo, '-' <> dx(dq(dd)) <> dx(dd) <> rr)),
    Equal.trans(T.WhenOut,
      T.when.day.go(True{}, T.take.n(2n, dx(dq(dd)) <> dx(dd) <> rr, 0, True{}), yy, vA(dq(mo), mo)),
      T.when.date.ok(yy, vA(dq(mo), mo), vA(dq(dd), dd), rr),
      T.when.date.ok(yy, mo, dd, rr),
      Equal.cong(T.Dig, T.WhenOut, dg => T.when.day.go(True{}, dg, yy, vA(dq(mo), mo)),
        T.take.n(2n, dx(dq(dd)) <> dx(dd) <> rr, 0, True{}), T.DigOk{vA(dq(dd), dd), rr}, tk2(dq(dd), dd, rr)),
      Equal.trans(T.WhenOut,
        T.when.date.ok(yy, vA(dq(mo), mo), vA(dq(dd), dd), rr),
        T.when.date.ok(yy, mo, vA(dq(dd), dd), rr),
        T.when.date.ok(yy, mo, dd, rr),
        Equal.cong(U32, T.WhenOut, vv => T.when.date.ok(yy, vv, vA(dq(dd), dd), rr), vA(dq(mo), mo), mo,
          v2.lt(uu, mo, hm)),
        Equal.cong(U32, T.WhenOut, vv => T.when.date.ok(yy, mo, vv, rr), vA(dq(dd), dd), dd, v2.lt(uu, dd, hd)))))

# a date whose fields are in range goes on to what follows it
def dok(
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +rr: List<&2, Char>,
  +h1: {T.bound.rng(mo, 1, 12) == True{} : Bool},
  +h2: {T.bound.rng(dd, 1, T.when.days(yy, mo)) == True{} : Bool}
) -> {T.when.date.ok(yy, mo, dd, rr) == T.when.after.date(T.Date{yy, mo, dd}, rr) : T.WhenOut}:
  Equal.trans(T.WhenOut,
    T.when.date.ok.go(T.bound.rng(mo, 1, 12), T.bound.rng(dd, 1, T.when.days(yy, mo)), yy, mo, dd, rr),
    T.when.date.ok.go(True{}, T.bound.rng(dd, 1, T.when.days(yy, mo)), yy, mo, dd, rr),
    T.when.after.date(T.Date{yy, mo, dd}, rr),
    Equal.cong(Bool, T.WhenOut, bb => T.when.date.ok.go(bb, T.bound.rng(dd, 1, T.when.days(yy, mo)), yy, mo, dd, rr),
      T.bound.rng(mo, 1, 12), True{}, h1),
    Equal.cong(Bool, T.WhenOut, bb => T.when.date.ok.go(True{}, bb, yy, mo, dd, rr),
      T.bound.rng(dd, 1, T.when.days(yy, mo)), True{}, h2))

# the minutes and seconds of a clock whose hour is read
def clk.mm(
  +uu: Unit,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +rr: List<&2, Char>,
  +dt: T.Date,
  +h2: {U32.is_le(mi, 59) == True{} : Bool},
  +h3: {U32.is_le(ss, 60) == True{} : Bool},
  +hr: {T.bound.rng(hh, 0, 23) == True{} : Bool}
) -> {T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr, 0, True{}), hh, dt) ==
  T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt) : T.WhenOut}:
  Equal.trans(T.WhenOut,
    T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr, 0, True{}), hh, dt),
    T.when.clock.ss(True{}, T.take.n(2n, dx(dq(ss)) <> dx(ss) <> rr, 0, True{}), hh, vA(dq(mi), mi), dt),
    T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt),
    Equal.cong(T.Dig, T.WhenOut, dg => T.when.clock.mm(dg, hh, dt),
      T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr, 0, True{}),
      T.DigOk{vA(dq(mi), mi), ':' <> dx(dq(ss)) <> dx(ss) <> rr}, tk2(dq(mi), mi, ':' <> dx(dq(ss)) <> dx(ss) <> rr)),
    Equal.trans(T.WhenOut,
      T.when.clock.ss(True{}, T.take.n(2n, dx(dq(ss)) <> dx(ss) <> rr, 0, True{}), hh, vA(dq(mi), mi), dt),
      T.when.clock.ss(True{}, T.DigOk{vA(dq(ss), ss), rr}, hh, vA(dq(mi), mi), dt),
      T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt),
      Equal.cong(T.Dig, T.WhenOut, dg => T.when.clock.ss(True{}, dg, hh, vA(dq(mi), mi), dt),
        T.take.n(2n, dx(dq(ss)) <> dx(ss) <> rr, 0, True{}), T.DigOk{vA(dq(ss), ss), rr}, tk2(dq(ss), ss, rr)),
      Equal.trans(T.WhenOut,
        T.when.clock.ss(True{}, T.DigOk{vA(dq(ss), ss), rr}, hh, vA(dq(mi), mi), dt),
        T.when.clock.ss(True{}, T.DigOk{ss, rr}, hh, mi, dt),
        T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt),
        Equal.trans(T.WhenOut,
          T.when.clock.ss(True{}, T.DigOk{vA(dq(ss), ss), rr}, hh, vA(dq(mi), mi), dt),
          T.when.clock.ss(True{}, T.DigOk{vA(dq(ss), ss), rr}, hh, mi, dt),
          T.when.clock.ss(True{}, T.DigOk{ss, rr}, hh, mi, dt),
          Equal.cong(U32, T.WhenOut, vv => T.when.clock.ss(True{}, T.DigOk{vA(dq(ss), ss), rr}, hh, vv, dt),
            vA(dq(mi), mi), mi, v2.lt(uu, mi, lt100(mi, 59, h2, {==}))),
          Equal.cong(U32, T.WhenOut, vv => T.when.clock.ss(True{}, T.DigOk{vv, rr}, hh, mi, dt), vA(dq(ss), ss), ss,
            v2.lt(uu, ss, lt100(ss, 60, h3, {==})))),
        Equal.trans(T.WhenOut,
          T.when.clock.range(T.bound.rng(hh, 0, 23), T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60), hh, mi, ss, rr,
            dt),
          T.when.clock.range(True{}, T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60), hh, mi, ss, rr, dt),
          T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt),
          Equal.cong(Bool, T.WhenOut, bb => T.when.clock.range(bb, T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60), hh,
            mi, ss, rr, dt), T.bound.rng(hh, 0, 23), True{}, hr),
          Equal.trans(T.WhenOut,
            T.when.clock.range(True{}, T.bound.rng(mi, 0, 59), T.bound.rng(ss, 0, 60), hh, mi, ss, rr, dt),
            T.when.clock.range(True{}, True{}, T.bound.rng(ss, 0, 60), hh, mi, ss, rr, dt),
            T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt),
            Equal.cong(Bool, T.WhenOut, bb => T.when.clock.range(True{}, bb, T.bound.rng(ss, 0, 60), hh, mi, ss, rr,
              dt), T.bound.rng(mi, 0, 59), True{}, rng0(mi, 59, h2)),
            Equal.cong(Bool, T.WhenOut, bb => T.when.clock.range(True{}, True{}, bb, hh, mi, ss, rr, dt),
              T.bound.rng(ss, 0, 60), True{}, rng0(ss, 60, h3)))))))

# a clock after a date: the hour, then the rest
def clk.of(
  +uu: Unit,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +rr: List<&2, Char>,
  +dt: T.Date,
  +h1: {U32.is_le(hh, 23) == True{} : Bool},
  +h2: {U32.is_le(mi, 59) == True{} : Bool},
  +h3: {U32.is_le(ss, 60) == True{} : Bool}
) -> {T.when.clock.of(T.take.n(2n, dx(dq(hh)) <> dx(hh) <> ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <>
  rr, 0, True{}), dt) == T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt) : T.WhenOut}:
  Equal.trans(T.WhenOut,
    T.when.clock.of(T.take.n(2n, dx(dq(hh)) <> dx(hh) <> ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <>
      dx(ss) <> rr, 0, True{}), dt),
    T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr, 0, True{}), hh, dt),
    T.when.frac(rr, T.Clock{hh, mi, ss, ""}, dt),
    Equal.trans(T.WhenOut,
      T.when.clock.of(T.take.n(2n, dx(dq(hh)) <> dx(hh) <> ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <>
        dx(ss) <> rr, 0, True{}), dt),
      T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr, 0, True{}),
        vA(dq(hh), hh), dt),
      T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr, 0, True{}), hh, dt),
      Equal.cong(T.Dig, T.WhenOut, dg => T.when.clock.of(dg, dt),
        T.take.n(2n, dx(dq(hh)) <> dx(hh) <> ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr, 0,
        True{}), T.DigOk{vA(dq(hh), hh), ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr},
        tk2(dq(hh), hh, ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr)),
      Equal.cong(U32, T.WhenOut, vv => T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <>
        dx(ss) <> rr, 0, True{}), vv, dt), vA(dq(hh), hh), hh, v2.lt(uu, hh, lt100(hh, 23, h1, {==})))),
    clk.mm(uu, hh, mi, ss, rr, dt, h2, h3, rng0(hh, 23, h1)))

# what may follow a fraction: nothing, or a character that is no digit and no
# dot
def zok(ts: List<&2, Tk>) -> Bool:
  match ts:
    case []:
      True{}
    case TD{_x} <> _t:
      False{}
    case TC{+cc} <> _t:
      Bool.and(Bool.not(Char.is_digit(cc)), Bool.not(Char.is_eq(cc, '.')))

# a zone may follow a fraction
def zok.z(zz: T.Zone) -> {zok(tzone(zz)) == True{} : Bool}:
  match zz:
    case T.Zulu{}:
      {==}
    case T.Shift{sg, _h, _m}:
      match sg:
        case T.Plus{}:
          {==}
        case T.Minus{}:
          {==}

# the fraction's digits end at what follows them
def fend(
  zs: List<&2, Tk>,
  +rev: List<&2, Char>,
  +clk: T.Clock,
  +dt: T.Date,
  hz: {zok(zs) == True{} : Bool}
) -> {T.when.frac.digits(tl(zs), rev, clk, dt) == T.when.frac.end(rev, clk, dt, tl(zs)) : T.WhenOut}:
  match zs:
    case []:
      {==}
    case TD{xx} <> tt:
      Eq.bit.absurd(&2, {T.when.frac.digits(tl(TD{xx} <> tt), rev, clk, dt) == T.when.frac.end(rev, clk, dt,
        tl(TD{xx} <> tt)) : T.WhenOut}, hz)
    case TC{+cc} <> +tt:
      Equal.cong(Bool, T.WhenOut, bb => T.when.frac.digit(bb, cc, tl(tt), rev, clk, dt,
        _u => T.when.frac.digits(tl(tt), cc <> rev, clk, dt)), Char.is_digit(cc), False{},
        Eq.not.true(Char.is_digit(cc), Eq.and.left(Bool.not(Char.is_digit(cc)), Bool.not(Char.is_eq(cc, '.')), hz)))

# the fraction's digits are pushed, then end at what follows them
def fdig(
  fr: String,
  +rev: List<&2, Char>,
  +zs: List<&2, Tk>,
  +clk: T.Clock,
  +dt: T.Date,
  +hd: {T.wf.digits(fr) == True{} : Bool},
  +hz: {zok(zs) == True{} : Bool}
) -> {T.when.frac.digits(tl(tcs(fr, zs)), rev, clk, dt) == T.when.frac.end(rev.onto(fr, rev), clk, dt, tl(zs)) :
  T.WhenOut}:
  match fr:
    case SNil{}:
      fend(zs, rev, clk, dt, hz)
    case SCon{+cc, +tt}:
      Equal.trans(T.WhenOut,
        T.when.frac.digit(Char.is_digit(cc), cc, tl(tcs(tt, zs)), rev, clk, dt,
          _u => T.when.frac.digits(tl(tcs(tt, zs)), cc <> rev, clk, dt)),
        T.when.frac.digits(tl(tcs(tt, zs)), cc <> rev, clk, dt),
        T.when.frac.end(rev.onto(tt, cc <> rev), clk, dt, tl(zs)),
        Equal.cong(Bool, T.WhenOut, bb => T.when.frac.digit(bb, cc, tl(tcs(tt, zs)), rev, clk, dt,
          _u => T.when.frac.digits(tl(tcs(tt, zs)), cc <> rev, clk, dt)), Char.is_digit(cc), True{},
          then.l(Char.is_digit(cc), tt, hd)),
        fdig(tt, cc <> rev, zs, clk, dt, then.r(Char.is_digit(cc), tt, hd), hz))

# a buffer something was pushed onto has a character
def some.rev(tt: String, +cc: Char, +acc: List<&2, Char>) -> {T.cs.some(rev.onto(tt, cc <> acc)) == True{} : Bool}:
  match tt:
    case SNil{}:
      {==}
    case SCon{hh, ts}:
      some.rev(ts, hh, cc <> acc)

# no fraction: the zone is read
def frac.none(
  zs: List<&2, Tk>,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +dt: T.Date,
  hz: {zok(zs) == True{} : Bool}
) -> {T.when.frac(tl(zs), T.Clock{hh, mi, ss, ""}, dt) == T.when.zone(tl(zs), T.Clock{hh, mi, ss, ""}, dt) : T.WhenOut}:
  match zs:
    case []:
      {==}
    case TD{xx} <> tt:
      Eq.bit.absurd(&2, {T.when.frac(tl(TD{xx} <> tt), T.Clock{hh, mi, ss, ""}, dt) == T.when.zone(tl(TD{xx} <> tt),
        T.Clock{hh, mi, ss, ""}, dt) : T.WhenOut}, hz)
    case TC{+cc} <> +tt:
      Equal.cong(Bool, T.WhenOut, bb => T.when.frac.go(bb, tl(tt), T.Clock{hh, mi, ss, ""}, dt, cc),
        Char.is_eq(cc, '.'), False{}, Eq.not.true(Char.is_eq(cc, '.'), Eq.and.right(Bool.not(Char.is_digit(cc)),
        Bool.not(Char.is_eq(cc, '.')), hz)))

# a fraction then what follows it: the clock takes the fraction's digits, and
# the zone is read
def frac.all(
  fr: String,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +zs: List<&2, Tk>,
  +dt: T.Date,
  +hd: {T.wf.digits(fr) == True{} : Bool},
  +hz: {zok(zs) == True{} : Bool}
) -> {T.when.frac(tl(tfr(fr, zs)), T.Clock{hh, mi, ss, ""}, dt) == T.when.zone(tl(zs), T.Clock{hh, mi, ss, fr}, dt) :
  T.WhenOut}:
  match fr:
    case SNil{}:
      frac.none(zs, hh, mi, ss, dt, hz)
    case SCon{+cc, +tt}:
      Equal.trans(T.WhenOut,
        T.when.frac.digits(tl(tcs(SCon{cc, tt}, zs)), [], T.Clock{hh, mi, ss, ""}, dt),
        T.when.frac.end(rev.onto(tt, [cc]), T.Clock{hh, mi, ss, ""}, dt, tl(zs)),
        T.when.zone(tl(zs), T.Clock{hh, mi, ss, SCon{cc, tt}}, dt),
        fdig(SCon{cc, tt}, [], zs, T.Clock{hh, mi, ss, ""}, dt, hd, hz),
        Equal.trans(T.WhenOut,
          T.when.frac.end.go(T.cs.some(rev.onto(tt, [cc])), rev.onto(tt, [cc]), T.Clock{hh, mi, ss, ""}, dt, tl(zs)),
          T.when.zone(tl(zs), T.clock.with(T.Clock{hh, mi, ss, ""}, String.from_list(List.reverse(&2, Char,
            rev.onto(tt, [cc])))), dt),
          T.when.zone(tl(zs), T.Clock{hh, mi, ss, SCon{cc, tt}}, dt),
          Equal.cong(Bool, T.WhenOut, bb => T.when.frac.end.go(bb, rev.onto(tt, [cc]), T.Clock{hh, mi, ss, ""}, dt,
            tl(zs)), T.cs.some(rev.onto(tt, [cc])), True{}, some.rev(tt, cc, [])),
          Equal.cong(String, T.WhenOut, fs => T.when.zone(tl(zs), T.Clock{hh, mi, ss, fs}, dt),
            String.from_list(List.reverse(&2, Char, rev.onto(tt, [cc]))), SCon{cc, tt},
            Equal.trans(String, String.from_list(List.reverse(&2, Char, rev.onto(tt, [cc]))),
              String.from_list(String.to_list(SCon{cc, tt})), SCon{cc, tt},
              Equal.cong(List<&2, Char>, String, ls => String.from_list(ls), List.reverse(&2, Char, rev.onto(tt, [cc])),
                String.to_list(SCon{cc, tt}), wd.order(cc, tt)), ftl(SCon{cc, tt})))))

# a numeric offset, after its sign
def zoff(
  +uu: Unit,
  +sg: T.Sign,
  +zh: U32,
  +zi: U32,
  +clk: T.Clock,
  +dt: T.Date,
  +h1: {U32.is_le(zh, 23) == True{} : Bool},
  +h2: {U32.is_le(zi, 59) == True{} : Bool}
) -> {T.when.zone.hh(T.take.n(2n, dx(dq(zh)) <> dx(zh) <> ':' <> dx(dq(zi)) <> dx(zi) <> [], 0, True{}), sg, clk, dt) ==
  T.WSome{T.WOff{dt, clk, T.Shift{sg, zh, zi}}} : T.WhenOut}:
  Equal.trans(T.WhenOut,
    T.when.zone.hh(T.take.n(2n, dx(dq(zh)) <> dx(zh) <> ':' <> dx(dq(zi)) <> dx(zi) <> [], 0, True{}), sg, clk, dt),
    T.when.zone.mm(True{}, T.take.n(2n, dx(dq(zi)) <> dx(zi) <> [], 0, True{}), sg, vA(dq(zh), zh), clk, dt),
    T.WSome{T.WOff{dt, clk, T.Shift{sg, zh, zi}}},
    Equal.cong(T.Dig, T.WhenOut, dg => T.when.zone.hh(dg, sg, clk, dt),
      T.take.n(2n, dx(dq(zh)) <> dx(zh) <> ':' <> dx(dq(zi)) <> dx(zi) <> [], 0, True{}),
      T.DigOk{vA(dq(zh), zh), ':' <> dx(dq(zi)) <> dx(zi) <> []}, tk2(dq(zh), zh, ':' <> dx(dq(zi)) <> dx(zi) <> [])),
    Equal.trans(T.WhenOut,
      T.when.zone.mm(True{}, T.take.n(2n, dx(dq(zi)) <> dx(zi) <> [], 0, True{}), sg, vA(dq(zh), zh), clk, dt),
      T.when.zone.mm.ok(T.bound.rng(vA(dq(zh), zh), 0, 23), T.bound.rng(vA(dq(zi), zi), 0, 59), sg, vA(dq(zh), zh),
        vA(dq(zi), zi), clk, dt),
      T.WSome{T.WOff{dt, clk, T.Shift{sg, zh, zi}}},
      Equal.cong(T.Dig, T.WhenOut, dg => T.when.zone.mm(True{}, dg, sg, vA(dq(zh), zh), clk, dt),
        T.take.n(2n, dx(dq(zi)) <> dx(zi) <> [], 0, True{}), T.DigOk{vA(dq(zi), zi), []}, tk2(dq(zi), zi, [])),
      Equal.trans(T.WhenOut,
        T.when.zone.mm.ok(T.bound.rng(vA(dq(zh), zh), 0, 23), T.bound.rng(vA(dq(zi), zi), 0, 59), sg, vA(dq(zh), zh),
          vA(dq(zi), zi), clk, dt),
        T.when.zone.mm.ok(T.bound.rng(zh, 0, 23), T.bound.rng(zi, 0, 59), sg, zh, zi, clk, dt),
        T.WSome{T.WOff{dt, clk, T.Shift{sg, zh, zi}}},
        Equal.trans(T.WhenOut,
          T.when.zone.mm.ok(T.bound.rng(vA(dq(zh), zh), 0, 23), T.bound.rng(vA(dq(zi), zi), 0, 59), sg,
            vA(dq(zh), zh), vA(dq(zi), zi), clk, dt),
          T.when.zone.mm.ok(T.bound.rng(zh, 0, 23), T.bound.rng(vA(dq(zi), zi), 0, 59), sg, zh, vA(dq(zi), zi), clk,
            dt),
          T.when.zone.mm.ok(T.bound.rng(zh, 0, 23), T.bound.rng(zi, 0, 59), sg, zh, zi, clk, dt),
          Equal.cong(U32, T.WhenOut, vv => T.when.zone.mm.ok(T.bound.rng(vv, 0, 23), T.bound.rng(vA(dq(zi), zi), 0,
            59), sg, vv, vA(dq(zi), zi), clk, dt), vA(dq(zh), zh), zh, v2.lt(uu, zh, lt100(zh, 23, h1, {==}))),
          Equal.cong(U32, T.WhenOut, vv => T.when.zone.mm.ok(T.bound.rng(zh, 0, 23), T.bound.rng(vv, 0, 59), sg, zh,
            vv, clk, dt), vA(dq(zi), zi), zi, v2.lt(uu, zi, lt100(zi, 59, h2, {==})))),
        Equal.trans(T.WhenOut,
          T.when.zone.mm.ok(T.bound.rng(zh, 0, 23), T.bound.rng(zi, 0, 59), sg, zh, zi, clk, dt),
          T.when.zone.mm.ok(True{}, T.bound.rng(zi, 0, 59), sg, zh, zi, clk, dt),
          T.WSome{T.WOff{dt, clk, T.Shift{sg, zh, zi}}},
          Equal.cong(Bool, T.WhenOut, bb => T.when.zone.mm.ok(bb, T.bound.rng(zi, 0, 59), sg, zh, zi, clk, dt),
            T.bound.rng(zh, 0, 23), True{}, rng0(zh, 23, h1)),
          Equal.cong(Bool, T.WhenOut, bb => T.when.zone.mm.ok(True{}, bb, sg, zh, zi, clk, dt),
            T.bound.rng(zi, 0, 59), True{}, rng0(zi, 59, h2))))))

# a numeric offset, by its sign
def zn.s(
  +uu: Unit,
  sg: T.Sign,
  +zh: U32,
  +zi: U32,
  +clk: T.Clock,
  +dt: T.Date,
  h1: {U32.is_le(zh, 23) == True{} : Bool},
  h2: {U32.is_le(zi, 59) == True{} : Bool}
) -> {T.when.zone(tl(tzone(T.Shift{sg, zh, zi})), clk, dt) == T.WSome{T.WOff{dt, clk, T.Shift{sg, zh, zi}}} :
  T.WhenOut}:
  match sg:
    case T.Plus{}:
      zoff(uu, T.Plus{}, zh, zi, clk, dt, h1, h2)
    case T.Minus{}:
      zoff(uu, T.Minus{}, zh, zi, clk, dt, h1, h2)

# a well-formed zone is read as itself
def zn(
  +uu: Unit,
  zz: T.Zone,
  +clk: T.Clock,
  +dt: T.Date,
  +hw: {T.wf.zone(zz) == True{} : Bool}
) -> {T.when.zone(tl(tzone(zz)), clk, dt) == T.WSome{T.WOff{dt, clk, zz}} : T.WhenOut}:
  match zz:
    case T.Zulu{}:
      {==}
    case T.Shift{sg, +zh, +zi}:
      zn.s(uu, sg, zh, zi, clk, dt, Eq.and.left(U32.is_le(zh, 23), U32.is_le(zi, 59), hw),
        Eq.and.right(U32.is_le(zh, 23), U32.is_le(zi, 59), hw))

# the characters of a date's tokens, then more
def cdate(+yy: U32, +mo: U32, +dd: U32, rr: List<&2, Char>) -> List<&2, Char>:
  dx(dq(dq(dq(yy)))) <> dx(dq(dq(yy))) <> dx(dq(yy)) <> dx(yy) <> '-' <> dx(dq(mo)) <> dx(mo) <> '-' <> dx(dq(dd)) <>
    dx(dd) <> rr

# a well-formed date's text, then more, is read as the date, then the more
def rd.date(
  +uu: Unit,
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +rr: List<&2, Char>,
  +hw: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}
) -> {T.when.read(cdate(yy, mo, dd, rr)) == T.when.after.date(T.Date{yy, mo, dd}, rr) : T.WhenOut}:
  Equal.trans(T.WhenOut, T.when.read(cdate(yy, mo, dd, rr)),
    T.when.year.dash('-' <> dx(dq(mo)) <> dx(mo) <> '-' <> dx(dq(dd)) <> dx(dd) <> rr, yy),
    T.when.after.date(T.Date{yy, mo, dd}, rr),
    yr(uu, yy, '-' <> dx(dq(mo)) <> dx(mo) <> '-' <> dx(dq(dd)) <> dx(dd) <> rr, wd.y(yy, mo, dd, hw)),
    Equal.trans(T.WhenOut, T.when.year.dash('-' <> dx(dq(mo)) <> dx(mo) <> '-' <> dx(dq(dd)) <> dx(dd) <> rr, yy),
      T.when.date.ok(yy, mo, dd, rr), T.when.after.date(T.Date{yy, mo, dd}, rr),
      dmd(uu, yy, mo, dd, rr, wd.mo100(yy, mo, dd, hw), wd.dd100(yy, mo, dd, hw)),
      dok(yy, mo, dd, rr, wd.mo(yy, mo, dd, hw), wd.dd(yy, mo, dd, hw))))

# the characters of a clock's tokens, then more
def cclock(+hh: U32, +mi: U32, +ss: U32, rr: List<&2, Char>) -> List<&2, Char>:
  dx(dq(hh)) <> dx(hh) <> ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> rr

# a date and a clock, then what follows the clock's fraction
def rd.dc(
  +uu: Unit,
  +yy: U32,
  +mo: U32,
  +dd: U32,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +zs: List<&2, Tk>,
  +hd: {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool},
  +hc: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool},
  +hz: {zok(zs) == True{} : Bool}
) -> {T.when.read(tl(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, tfr(fr, zs))))) == T.when.zone(tl(zs), T.Clock{hh,
  mi, ss, fr}, T.Date{yy, mo, dd}) : T.WhenOut}:
  Equal.trans(T.WhenOut, T.when.read(cdate(yy, mo, dd, 'T' <> cclock(hh, mi, ss, tl(tfr(fr, zs))))),
    T.when.after.date(T.Date{yy, mo, dd}, 'T' <> cclock(hh, mi, ss, tl(tfr(fr, zs)))),
    T.when.zone(tl(zs), T.Clock{hh, mi, ss, fr}, T.Date{yy, mo, dd}),
    rd.date(uu, yy, mo, dd, 'T' <> cclock(hh, mi, ss, tl(tfr(fr, zs))), hd),
    Equal.trans(T.WhenOut, T.when.clock.of(T.take.n(2n, cclock(hh, mi, ss, tl(tfr(fr, zs))), 0, True{}),
      T.Date{yy, mo, dd}),
      T.when.frac(tl(tfr(fr, zs)), T.Clock{hh, mi, ss, ""}, T.Date{yy, mo, dd}),
      T.when.zone(tl(zs), T.Clock{hh, mi, ss, fr}, T.Date{yy, mo, dd}),
      clk.of(uu, hh, mi, ss, tl(tfr(fr, zs)), T.Date{yy, mo, dd}, wc.h(hh, mi, ss, fr, hc), wc.mi(hh, mi, ss, fr, hc),
        wc.s(hh, mi, ss, fr, hc)),
      frac.all(fr, hh, mi, ss, zs, T.Date{yy, mo, dd}, wc.fr(hh, mi, ss, fr, hc), hz)))

# a local time: the hour, a colon, and the rest of the clock, on a placeholder
# date that only the clock is kept from
def rd.time(
  +uu: Unit,
  +hh: U32,
  +mi: U32,
  +ss: U32,
  +fr: String,
  +hc: {T.wf.clock(T.Clock{hh, mi, ss, fr}) == True{} : Bool}
) -> {T.when.read(tl(tclock(hh, mi, ss, tfr(fr, [])))) == T.WSome{T.WTime{T.Clock{hh, mi, ss, fr}}} : T.WhenOut}:
  Equal.trans(T.WhenOut, T.when.after2(T.take.n(2n, cclock(hh, mi, ss, tl(tfr(fr, []))), 0, True{})),
    T.when.time.only(T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <>
      tl(tfr(fr, [])), 0, True{}), vA(dq(hh), hh), T.Date{0, 1, 1})),
    T.WSome{T.WTime{T.Clock{hh, mi, ss, fr}}},
    Equal.cong(T.Dig, T.WhenOut, dg => T.when.after2(dg), T.take.n(2n, cclock(hh, mi, ss, tl(tfr(fr, []))), 0, True{}),
      T.DigOk{vA(dq(hh), hh), ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> tl(tfr(fr, []))},
      tk2(dq(hh), hh, ':' <> dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <> tl(tfr(fr, [])))),
    Equal.trans(T.WhenOut,
      T.when.time.only(T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <>
        tl(tfr(fr, [])), 0, True{}), vA(dq(hh), hh), T.Date{0, 1, 1})),
      T.when.time.only(T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <>
        tl(tfr(fr, [])), 0, True{}), hh, T.Date{0, 1, 1})),
      T.WSome{T.WTime{T.Clock{hh, mi, ss, fr}}},
      Equal.cong(U32, T.WhenOut, vv => T.when.time.only(T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <>
        dx(dq(ss)) <> dx(ss) <> tl(tfr(fr, [])), 0, True{}), vv, T.Date{0, 1, 1})), vA(dq(hh), hh), hh,
        v2.lt(uu, hh, lt100(hh, 23, wc.h(hh, mi, ss, fr, hc), {==}))),
      Equal.cong(T.WhenOut, T.WhenOut, ww => T.when.time.only(ww), T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <>
        ':' <> dx(dq(ss)) <> dx(ss) <> tl(tfr(fr, [])), 0, True{}), hh, T.Date{0, 1, 1}),
        T.WSome{T.WLocal{T.Date{0, 1, 1}, T.Clock{hh, mi, ss, fr}}},
        Equal.trans(T.WhenOut, T.when.clock.mm(T.take.n(2n, dx(dq(mi)) <> dx(mi) <> ':' <> dx(dq(ss)) <> dx(ss) <>
          tl(tfr(fr, [])), 0, True{}), hh, T.Date{0, 1, 1}),
          T.when.frac(tl(tfr(fr, [])), T.Clock{hh, mi, ss, ""}, T.Date{0, 1, 1}),
          T.WSome{T.WLocal{T.Date{0, 1, 1}, T.Clock{hh, mi, ss, fr}}},
          clk.mm(uu, hh, mi, ss, tl(tfr(fr, [])), T.Date{0, 1, 1}, wc.mi(hh, mi, ss, fr, hc), wc.s(hh, mi, ss, fr, hc),
            rng0(hh, 23, wc.h(hh, mi, ss, fr, hc))),
          frac.all(fr, hh, mi, ss, [], T.Date{0, 1, 1}, wc.fr(hh, mi, ss, fr, hc), {==})))))

# a well-formed datetime's tokens are read as the datetime
def read.all(
  +uu: Unit,
  ww: T.When,
  +hw: {T.wf.when(ww) == True{} : Bool}
) -> {T.when.read(tl(tks(ww))) == T.WSome{ww} : T.WhenOut}:
  match ww:
    case T.WOff{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}, +zz}:
      +hd = {Eq.and.left(T.wf.date(T.Date{yy, mo, dd}), Bool.and(T.wf.clock(T.Clock{hh, mi, ss, fr}), T.wf.zone(zz)),
        hw) : {T.wf.date(T.Date{yy, mo, dd}) == True{} : Bool}}
      +hr = {Eq.and.right(T.wf.date(T.Date{yy, mo, dd}), Bool.and(T.wf.clock(T.Clock{hh, mi, ss, fr}),
        T.wf.zone(zz)), hw) : {Bool.and(T.wf.clock(T.Clock{hh, mi, ss, fr}), T.wf.zone(zz)) == True{} : Bool}}
      Equal.trans(T.WhenOut, T.when.read(tl(tdate(yy, mo, dd, TC{'T'} <> tclock(hh, mi, ss, tfr(fr, tzone(zz)))))),
        T.when.zone(tl(tzone(zz)), T.Clock{hh, mi, ss, fr}, T.Date{yy, mo, dd}),
        T.WSome{T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz}},
        rd.dc(uu, yy, mo, dd, hh, mi, ss, fr, tzone(zz), hd, Eq.and.left(T.wf.clock(T.Clock{hh, mi, ss, fr}),
          T.wf.zone(zz), hr), zok.z(zz)),
        zn(uu, zz, T.Clock{hh, mi, ss, fr}, T.Date{yy, mo, dd}, Eq.and.right(T.wf.clock(T.Clock{hh, mi, ss, fr}),
          T.wf.zone(zz), hr)))
    case T.WLocal{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}}:
      rd.dc(uu, yy, mo, dd, hh, mi, ss, fr, [], Eq.and.left(T.wf.date(T.Date{yy, mo, dd}),
        T.wf.clock(T.Clock{hh, mi, ss, fr}), hw), Eq.and.right(T.wf.date(T.Date{yy, mo, dd}),
        T.wf.clock(T.Clock{hh, mi, ss, fr}), hw), {==})
    case T.WDate{T.Date{+yy, +mo, +dd}}:
      rd.date(uu, yy, mo, dd, [], hw)
    case T.WTime{T.Clock{+hh, +mi, +ss, +fr}}:
      rd.time(uu, hh, mi, ss, fr, hw)

# The classifier routes a datetime's text to the datetime scan: its first
# character is a digit, so no special; a dash after its year, or a colon
# after its hour, makes it a datetime; and it holds no exponent mark.

# an `or` with a True right half
def wor.t(aa: Bool) -> {T.word.or(aa, True{}) == True{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      {==}

# a text that starts with four digits and a dash is routed to the datetime scan
def dsh(
  +x1: U32,
  +x2: U32,
  +x3: U32,
  +x4: U32,
  +rest: List<&2, Char>
) -> {T.word.or(T.word.colon(dx(x1) <> dx(x2) <> dx(x3) <> dx(x4) <> '-' <> rest), T.word.dash(dx(x1) <> dx(x2) <>
  dx(x3) <> dx(x4) <> '-' <> rest, True{})) == True{} : Bool}:
  Equal.trans(Bool, T.word.or(T.word.colon(dx(x1) <> dx(x2) <> dx(x3) <> dx(x4) <> '-' <> rest),
    T.word.dash(dx(x1) <> dx(x2) <> dx(x3) <> dx(x4) <> '-' <> rest, True{})),
    T.word.or(T.word.colon(dx(x1) <> dx(x2) <> dx(x3) <> dx(x4) <> '-' <> rest), True{}), True{},
    Equal.cong(Bool, Bool, bb => T.word.or(T.word.colon(dx(x1) <> dx(x2) <> dx(x3) <> dx(x4) <> '-' <> rest), bb),
      T.word.dash(dx(x1) <> dx(x2) <> dx(x3) <> dx(x4) <> '-' <> rest, True{}), True{},
      Equal.trans(Bool, T.word.or(Char.is_eq(dx(x2), '-'), T.word.dash(dx(x3) <> dx(x4) <> '-' <> rest, False{})),
        T.word.or(Char.is_eq(dx(x2), '-'), True{}), True{},
        Equal.cong(Bool, Bool, bb => T.word.or(Char.is_eq(dx(x2), '-'), bb),
          T.word.dash(dx(x3) <> dx(x4) <> '-' <> rest, False{}), True{},
          Equal.trans(Bool, T.word.or(Char.is_eq(dx(x3), '-'), T.word.dash(dx(x4) <> '-' <> rest, False{})),
            T.word.or(Char.is_eq(dx(x3), '-'), True{}), True{},
            Equal.cong(Bool, Bool, bb => T.word.or(Char.is_eq(dx(x3), '-'), bb),
              T.word.dash(dx(x4) <> '-' <> rest, False{}), True{}, wor.t(Char.is_eq(dx(x4), '-'))),
            wor.t(Char.is_eq(dx(x3), '-')))),
        wor.t(Char.is_eq(dx(x2), '-')))),
    wor.t(T.word.colon(dx(x1) <> dx(x2) <> dx(x3) <> dx(x4) <> '-' <> rest)))

# a text that starts with two digits and a colon is routed to the datetime
# scan
def tcl(
  +x1: U32,
  +x2: U32,
  +rest: List<&2, Char>
) -> {T.word.or(T.word.colon(dx(x1) <> dx(x2) <> ':' <> rest), T.word.dash(dx(x1) <> dx(x2) <> ':' <> rest, True{})) ==
  True{} : Bool}:
  Equal.cong(Bool, Bool, bb => T.word.or(bb, T.word.dash(dx(x1) <> dx(x2) <> ':' <> rest, True{})),
    T.word.colon(dx(x1) <> dx(x2) <> ':' <> rest), True{},
    Equal.trans(Bool, T.word.or(Char.is_eq(dx(x1), ':'), T.word.colon(dx(x2) <> ':' <> rest)),
      T.word.or(Char.is_eq(dx(x1), ':'), True{}), True{},
      Equal.cong(Bool, Bool, bb => T.word.or(Char.is_eq(dx(x1), ':'), bb), T.word.colon(dx(x2) <> ':' <> rest), True{},
        wor.t(Char.is_eq(dx(x2), ':'))),
      wor.t(Char.is_eq(dx(x1), ':'))))

# a digit is a character a datetime keeps
def dg.dtc(cc: Char, hc: {Char.is_digit(cc) == True{} : Bool}) -> {dtc(cc) == True{} : Bool}:
  dg.elim(zz => {dtc(zz) == True{} : Bool}, cc, hc, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a fraction's digits are characters a datetime keeps
def tok.tcs(
  fr: String,
  +zs: List<&2, Tk>,
  +hd: {T.wf.digits(fr) == True{} : Bool},
  +hz: {tok(zs) == True{} : Bool}
) -> {tok(tcs(fr, zs)) == True{} : Bool}:
  match fr:
    case SNil{}:
      hz
    case SCon{+cc, +tt}:
      and.tt(dtc(cc), tok(tcs(tt, zs)), dg.dtc(cc, then.l(Char.is_digit(cc), tt, hd)),
        tok.tcs(tt, zs, then.r(Char.is_digit(cc), tt, hd), hz))

# and so is its dot
def tok.fr(
  fr: String,
  +zs: List<&2, Tk>,
  +hd: {T.wf.digits(fr) == True{} : Bool},
  +hz: {tok(zs) == True{} : Bool}
) -> {tok(tfr(fr, zs)) == True{} : Bool}:
  match fr:
    case SNil{}:
      hz
    case SCon{+cc, +tt}:
      tok.tcs(SCon{cc, tt}, zs, hd, hz)

# a zone is characters a datetime keeps
def tok.z(zz: T.Zone) -> {tok(tzone(zz)) == True{} : Bool}:
  match zz:
    case T.Zulu{}:
      {==}
    case T.Shift{sg, _h, _m}:
      match sg:
        case T.Plus{}:
          {==}
        case T.Minus{}:
          {==}

# a well-formed datetime's tokens are characters a datetime keeps
def tok.all(ww: T.When, +hw: {T.wf.when(ww) == True{} : Bool}) -> {tok(tks(ww)) == True{} : Bool}:
  match ww:
    case T.WOff{T.Date{yy, mo, dd}, T.Clock{+hh, +mi, +ss, +fr}, +zz}:
      tok.fr(fr, tzone(zz), wc.fr(hh, mi, ss, fr, Eq.and.left(T.wf.clock(T.Clock{hh, mi, ss, fr}), T.wf.zone(zz),
        Eq.and.right(T.wf.date(T.Date{yy, mo, dd}), Bool.and(T.wf.clock(T.Clock{hh, mi, ss, fr}), T.wf.zone(zz)), hw))),
        tok.z(zz))
    case T.WLocal{T.Date{yy, mo, dd}, T.Clock{+hh, +mi, +ss, +fr}}:
      tok.fr(fr, [], wc.fr(hh, mi, ss, fr, Eq.and.right(T.wf.date(T.Date{yy, mo, dd}),
        T.wf.clock(T.Clock{hh, mi, ss, fr}), hw)), {==})
    case T.WDate{T.Date{_y, _m, _d}}:
      {==}
    case T.WTime{T.Clock{+hh, +mi, +ss, +fr}}:
      tok.fr(fr, [], wc.fr(hh, mi, ss, fr, hw), {==})

# a text routed to the datetime scan, read as a datetime, is classified as it
def wv.gen(
  +x0: U32,
  +rest: List<&2, Char>,
  +ww: T.When,
  hdate: {T.word.or(T.word.colon(dx(x0) <> rest), T.word.dash(dx(x0) <> rest, True{})) == True{} : Bool},
  hee: {T.word.ee(dx(x0) <> rest) == False{} : Bool},
  hrd: {T.when.read(dx(x0) <> rest) == T.WSome{ww} : T.WhenOut}
) -> {T.word.val(dx(x0) <> rest) == T.GotVal{T.VWhen{ww}} : T.Got}:
  Equal.trans(T.Got, T.word.val.pick(T.word.special(dx(x0)), dx(x0) <> rest),
    T.word.route(T.GotBad{""}, T.word.or(T.word.colon(dx(x0) <> rest), T.word.dash(dx(x0) <> rest, True{})),
      dx(x0) <> rest), T.GotVal{T.VWhen{ww}},
    Equal.cong(Bool, T.Got, bb => T.word.val.pick(bb, dx(x0) <> rest), T.word.special(dx(x0)), False{},
      dd.nospec(x0)),
    Equal.trans(T.Got,
      T.word.route(T.GotBad{""}, T.word.or(T.word.colon(dx(x0) <> rest), T.word.dash(dx(x0) <> rest, True{})),
        dx(x0) <> rest),
      T.word.route.date(T.word.as_date(True{}, T.word.ee(dx(x0) <> rest)), dx(x0) <> rest), T.GotVal{T.VWhen{ww}},
      Equal.cong(Bool, T.Got, bb => T.word.route(T.GotBad{""}, bb, dx(x0) <> rest),
        T.word.or(T.word.colon(dx(x0) <> rest), T.word.dash(dx(x0) <> rest, True{})), True{}, hdate),
      Equal.trans(T.Got, T.word.route.date(T.word.as_date(True{}, T.word.ee(dx(x0) <> rest)), dx(x0) <> rest),
        T.word.from.when(T.when.read(dx(x0) <> rest)), T.GotVal{T.VWhen{ww}},
        Equal.cong(Bool, T.Got, bb => T.word.route.date(T.word.as_date(True{}, bb), dx(x0) <> rest),
          T.word.ee(dx(x0) <> rest), False{}, hee),
        Equal.cong(T.WhenOut, T.Got, wo => T.word.from.when(wo), T.when.read(dx(x0) <> rest), T.WSome{ww}, hrd))))

# a well-formed datetime's tokens are classified as the datetime
def wv.tks(
  ww: T.When,
  +hw: {T.wf.when(ww) == True{} : Bool}
) -> {T.word.val(tl(tks(ww))) == T.GotVal{T.VWhen{ww}} : T.Got}:
  match ww:
    case T.WOff{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}, +zz}:
      wv.gen(dq(dq(dq(yy))), tl(TD{dq(dq(yy))} <> TD{dq(yy)} <> TD{yy} <> TC{'-'} <> TD{dq(mo)} <> TD{mo} <> TC{'-'} <>
        TD{dq(dd)} <> TD{dd} <> TC{'T'} <> tclock(hh, mi, ss, tfr(fr, tzone(zz)))),
        T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz},
        dsh(dq(dq(dq(yy))), dq(dq(yy)), dq(yy), yy, tl(TD{dq(mo)} <> TD{mo} <> TC{'-'} <> TD{dq(dd)} <> TD{dd} <>
          TC{'T'} <> tclock(hh, mi, ss, tfr(fr, tzone(zz))))),
        tk.ee(tks(T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz}),
          tok.all(T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz}, hw)),
        read.all(Unit{}, T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz}, hw))
    case T.WLocal{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}}:
      wv.gen(dq(dq(dq(yy))), tl(TD{dq(dq(yy))} <> TD{dq(yy)} <> TD{yy} <> TC{'-'} <> TD{dq(mo)} <> TD{mo} <> TC{'-'} <>
        TD{dq(dd)} <> TD{dd} <> TC{'T'} <> tclock(hh, mi, ss, tfr(fr, []))),
        T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}},
        dsh(dq(dq(dq(yy))), dq(dq(yy)), dq(yy), yy, tl(TD{dq(mo)} <> TD{mo} <> TC{'-'} <> TD{dq(dd)} <> TD{dd} <>
          TC{'T'} <> tclock(hh, mi, ss, tfr(fr, [])))),
        tk.ee(tks(T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}}),
          tok.all(T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}}, hw)),
        read.all(Unit{}, T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}}, hw))
    case T.WDate{T.Date{+yy, +mo, +dd}}:
      wv.gen(dq(dq(dq(yy))), tl(TD{dq(dq(yy))} <> TD{dq(yy)} <> TD{yy} <> TC{'-'} <> TD{dq(mo)} <> TD{mo} <> TC{'-'} <>
        TD{dq(dd)} <> TD{dd} <> []), T.WDate{T.Date{yy, mo, dd}},
        dsh(dq(dq(dq(yy))), dq(dq(yy)), dq(yy), yy, tl(TD{dq(mo)} <> TD{mo} <> TC{'-'} <> TD{dq(dd)} <> TD{dd} <> [])),
        tk.ee(tks(T.WDate{T.Date{yy, mo, dd}}), {==}), read.all(Unit{}, T.WDate{T.Date{yy, mo, dd}}, hw))
    case T.WTime{T.Clock{+hh, +mi, +ss, +fr}}:
      wv.gen(dq(hh), tl(TD{hh} <> TC{':'} <> TD{dq(mi)} <> TD{mi} <> TC{':'} <> TD{dq(ss)} <> TD{ss} <> tfr(fr, [])),
        T.WTime{T.Clock{hh, mi, ss, fr}},
        tcl(dq(hh), hh, tl(TD{dq(mi)} <> TD{mi} <> TC{':'} <> TD{dq(ss)} <> TD{ss} <> tfr(fr, []))),
        tk.ee(tks(T.WTime{T.Clock{hh, mi, ss, fr}}), tok.all(T.WTime{T.Clock{hh, mi, ss, fr}}, hw)),
        read.all(Unit{}, T.WTime{T.Clock{hh, mi, ss, fr}}, hw))

def Laws.when_word(w, h):
  Equal.trans(T.Got, T.word.val(String.to_list(T.when.text(w))), T.word.val(tl(tks(w))), T.GotVal{T.VWhen{w}},
    Equal.cong(String, T.Got, ss => T.word.val(String.to_list(ss)), T.when.text(w), tstr(tks(w)),
      when.eq(Unit{}, w, h)), wv.tks(w, h))

# tokens that start with a digit are a bare value
def wch.gen(
  +x0: U32,
  +ts: List<&2, Tk>,
  +hh: {tok(ts) == True{} : Bool}
) -> {Laws.word.chars(tstr(TD{x0} <> ts)) == True{} : Bool}:
  and.tt(Laws.word.first(dx(x0)), Laws.word.rest(tstr(ts)), dd.first(x0), tk.rest(ts, hh))

# a well-formed datetime's tokens are a bare value
def wch.all(ww: T.When, +hw: {T.wf.when(ww) == True{} : Bool}) -> {Laws.word.chars(tstr(tks(ww))) == True{} : Bool}:
  match ww:
    case T.WOff{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}, +zz}:
      wch.gen(dq(dq(dq(yy))), TD{dq(dq(yy))} <> TD{dq(yy)} <> TD{yy} <> TC{'-'} <> TD{dq(mo)} <> TD{mo} <> TC{'-'} <>
        TD{dq(dd)} <> TD{dd} <> TC{'T'} <> tclock(hh, mi, ss, tfr(fr, tzone(zz))),
        tok.all(T.WOff{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}, zz}, hw))
    case T.WLocal{T.Date{+yy, +mo, +dd}, T.Clock{+hh, +mi, +ss, +fr}}:
      wch.gen(dq(dq(dq(yy))), TD{dq(dq(yy))} <> TD{dq(yy)} <> TD{yy} <> TC{'-'} <> TD{dq(mo)} <> TD{mo} <> TC{'-'} <>
        TD{dq(dd)} <> TD{dd} <> TC{'T'} <> tclock(hh, mi, ss, tfr(fr, [])),
        tok.all(T.WLocal{T.Date{yy, mo, dd}, T.Clock{hh, mi, ss, fr}}, hw))
    case T.WDate{T.Date{+yy, +mo, +dd}}:
      wch.gen(dq(dq(dq(yy))), TD{dq(dq(yy))} <> TD{dq(yy)} <> TD{yy} <> TC{'-'} <> TD{dq(mo)} <> TD{mo} <> TC{'-'} <>
        TD{dq(dd)} <> TD{dd} <> [], {==})
    case T.WTime{T.Clock{+hh, +mi, +ss, +fr}}:
      wch.gen(dq(hh), TD{hh} <> TC{':'} <> TD{dq(mi)} <> TD{mi} <> TC{':'} <> TD{dq(ss)} <> TD{ss} <> tfr(fr, []),
        tok.all(T.WTime{T.Clock{hh, mi, ss, fr}}, hw))

def Laws.when_reads_back(w, h, fx, rest):
  Laws.word_reads_back(T.VWhen{w}, T.when.text(w), Equal.trans(Bool, Laws.word.chars(T.when.text(w)),
    Laws.word.chars(tstr(tks(w))), True{}, Equal.cong(String, Bool, ss => Laws.word.chars(ss), T.when.text(w),
    tstr(tks(w)), when.eq(Unit{}, w, h)), wch.all(w, h)), Laws.when_word(w, h), fx, rest)

def Laws.scalar_reads_back(v, w, fx, rest):
  match v:
    case T.VInt{+sg, +ds}:
      Laws.int_reads_back(sg, ds, w, fx, rest)
    case T.VFlo{+sg, +text}:
      Laws.flo_reads_back(sg, text, w, fx, rest)
    case T.VBool{+bb}:
      Laws.bool_reads_back(bb, fx, rest)
    case T.VWhen{+ww}:
      Laws.when_reads_back(ww, w, fx, rest)
    case T.VStr{tx}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VStr{tx}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VStr{tx}, rest) : T.Doc}, w)
    case T.VSpan{src, nn}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VSpan{src, nn}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VSpan{src, nn}, rest) : T.Doc}, w)
    case T.VArr{it}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VArr{it}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VArr{it}, rest) : T.Doc}, w)
    case T.VInl{rs}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VInl{rs}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VInl{rs}, rest) : T.Doc}, w)
    case T.VHead{pp, rs}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VHead{pp, rs}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VHead{pp, rs}, rest) : T.Doc}, w)
    case T.VAot{pp, rs}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VAot{pp, rs}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VAot{pp, rs}, rest) : T.Doc}, w)
    case T.VAots{pp, es}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VAots{pp, es}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VAots{pp, es}, rest) : T.Doc}, w)
    case T.VPair{nm, vv}:
      Eq.bit.absurd(&2, {Laws.from_val(fx, String.append(T.render.atom(T.VPair{nm, vv}), SCon{'\n', rest}))
        == Laws.after_val(fx, T.VPair{nm, vv}, rest) : T.Doc}, w)

# WP-K3: keys however they are written. A literal quoted segment is read one
# character at a time in the segment's state (LKeyQ for a key, LHeadQ for a
# header, as WP0's qs family takes it by the bit hd) with qkind QLit: every
# character but the apostrophe is pushed as it is, and back never moves, so
# unlike qs these lemmas are plain equations.

# a scanner inside a literal quoted segment, its characters so far reversed
# in buf
def ql(
  hd: Bool,
  rows: List<&2, T.Val>,
  heads: List<&2, String>,
  here: List<&2, String>,
  parts: List<&2, String>,
  arrtab: Bool,
  back: T.Lex,
  buf: List<&2, Char>
) -> T.St:
  T.St{"", rows, heads, here, parts, buf, qs.lex(hd), back, T.QLit{}, [], T.HNone{}, 0, 0,
    arrtab, False{}}

# a character read from a literal segment is pushed
def ql.Step(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>
) -> Type:
  {T.doc.scan(ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu})
    == T.MScan{ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf)} : T.Mode}

# a quotation mark, a backslash and a tab: their steps compute
def ql.s34(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>
) -> ql.Step(34, hd, rw, hs, he, ps, ab, back, buf):
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# a backslash
def ql.s92(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>
) -> ql.Step(92, hd, rw, hs, he, ps, ab, back, buf):
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# a tab
def ql.s9(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>
) -> ql.Step(9, hd, rw, hs, he, ps, ab, back, buf):
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# the fast step of a character in a literal segment is the segment's full step
def ql.fast(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>
) -> {T.read.fast(ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu}) == T.read.once2(T.lex.kq.go(
  U32.is_eq(uu, 39), U32.is_eq(uu, 92), False{}, Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)),
  ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) : T.St}:
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# a character that is no control is pushed: str.bad passes it
def ql.char(
  ctl: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  hc: {ctl == False{} : Bool}
) -> {T.read.once2(T.lex.kq.char.go(T.str.bad.go(ctl, U32.is_eq(uu, 9),
  Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), False{}), ql(hd, rw, hs, he, ps, ab, back, buf),
  Chr{uu}, qs.lex(hd))) == ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf) : T.St}:
  match ctl:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.char.go(T.str.bad.go(True{}, U32.is_eq(uu, 9),
        Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), False{}), ql(hd, rw, hs, he, ps, ab, back,
        buf), Chr{uu}, qs.lex(hd))) == ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf) : T.St}, hc)

# a character that is no apostrophe, no backslash and no newline is no closer
# and no backslash
def ql.go(
  quote: Bool,
  bs: Bool,
  nl: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool},
  hb: {bs == False{} : Bool},
  hn: {nl == False{} : Bool},
  hc: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool}
) -> {T.read.once2(T.lex.kq.go(quote, bs, False{}, nl, ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu},
  qs.close(hd), qs.lex(hd))) == ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf) : T.St}:
  match quote:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(True{}, bs, False{}, nl, ql(hd, rw, hs, he, ps, ab,
        back, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == ql(hd, rw, hs, he, ps, ab, back,
        Chr{uu} <> buf) : T.St}, hq)
    case False{}:
      match bs:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, True{}, False{}, nl, ql(hd, rw, hs, he,
            ps, ab, back, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == ql(hd, rw, hs, he, ps, ab,
            back, Chr{uu} <> buf) : T.St}, hb)
        case False{}:
          match nl:
            case True{}:
              Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, False{}, False{}, True{}, ql(hd,
                rw, hs, he, ps, ab, back, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == ql(hd, rw, hs,
                he, ps, ab, back, Chr{uu} <> buf) : T.St}, hn)
            case False{}:
              ql.char(Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), uu, hd, rw, hs, he, ps, ab,
                back, buf, hc)

# the fast step pushes a character
def ql.Fast(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>
) -> Type:
  {T.read.fast(ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu})
    == ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf) : T.St}

# the scan mode sends such a character to the fast step
def ql.q(
  dq: Bool,
  sq: Bool,
  cr: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  hq: {dq == False{} : Bool},
  hs1: {sq == False{} : Bool},
  hr: {cr == False{} : Bool},
  fast: ql.Fast(uu, hd, rw, hs, he, ps, ab, back, buf)
) -> {T.doc.scan.q(dq, sq, cr, ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu})
  == T.MScan{ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf)} : T.Mode}:
  match dq:
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.scan.q(True{}, sq, cr, ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu})
        == T.MScan{ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf)} : T.Mode}, hq)
    case False{}:
      match sq:
        case True{}:
          Eq.bit.absurd2(&2, {T.doc.scan.q(False{}, True{}, cr, ql(hd, rw, hs, he, ps, ab, back, buf),
            Chr{uu}) == T.MScan{ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf)} : T.Mode}, hs1)
        case False{}:
          match cr:
            case True{}:
              Eq.bit.absurd2(&2, {T.doc.scan.q(False{}, False{}, True{}, ql(hd, rw, hs, he, ps, ab,
                back, buf), Chr{uu}) == T.MScan{ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf)}
                : T.Mode}, hr)
            case False{}:
              Equal.cong(T.St, T.Mode, st => T.MScan{st},
                T.read.fast(ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu}),
                ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf), fast)

# a literal character is no apostrophe
def lit.q(
  q39: Bool,
  ctl: Bool,
  t9: Bool,
  e: {Bool.not(Bool.or(q39, Bool.and(ctl, Bool.not(t9)))) == True{} : Bool}
) -> {q39 == False{} : Bool}:
  match q39:
    case True{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, e)
    case False{}:
      {==}

# and a literal character that is no tab is no control
def lit.c(
  q39: Bool,
  ctl: Bool,
  t9: Bool,
  e9: {t9 == False{} : Bool},
  e: {Bool.not(Bool.or(q39, Bool.and(ctl, Bool.not(t9)))) == True{} : Bool}
) -> {ctl == False{} : Bool}:
  match q39:
    case True{}:
      Eq.bit.absurd(&2, {ctl == False{} : Bool}, e)
    case False{}:
      match ctl:
        case False{}:
          {==}
        case True{}:
          match t9:
            case True{}:
              Eq.bit.absurd2(&2, {True{} == False{} : Bool}, e9)
            case False{}:
              Eq.bit.absurd(&2, {True{} == False{} : Bool}, e)

# any other literal character goes through the dispatch and is pushed
def ql.gen(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  e34: {U32.is_eq(uu, 34) == False{} : Bool},
  e92: {U32.is_eq(uu, 92) == False{} : Bool},
  +e9: {U32.is_eq(uu, 9) == False{} : Bool},
  +el: {Laws.lit.char(Chr{uu}) == True{} : Bool}
) -> ql.Step(uu, hd, rw, hs, he, ps, ab, back, buf):
  +e39 = {lit.q(U32.is_eq(uu, 39), Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9),
    el) : {U32.is_eq(uu, 39) == False{} : Bool}}
  +ec = {lit.c(U32.is_eq(uu, 39), Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9),
    e9, el) : {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool}}
  +e10 = {ctl.off(uu, 10, ec, {==}) : {U32.is_eq(uu, 10) == False{} : Bool}}
  +e13 = {ctl.off(uu, 13, ec, {==}) : {U32.is_eq(uu, 13) == False{} : Bool}}
  ql.q(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13), uu, hd, rw, hs, he, ps, ab, back, buf,
    e34, e39, e13,
    Equal.trans(T.St, T.read.fast(ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu}),
      T.read.once2(T.lex.kq.go(U32.is_eq(uu, 39), U32.is_eq(uu, 92), False{},
        Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu},
        qs.close(hd), qs.lex(hd))),
      ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf),
      ql.fast(uu, hd, rw, hs, he, ps, ab, back, buf),
      ql.go(U32.is_eq(uu, 39), U32.is_eq(uu, 92), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), uu, hd,
        rw, hs, he, ps, ab, back, buf, e39, e92, or.ff(U32.is_eq(uu, 10), U32.is_eq(uu, 13), e10, e13),
        ec)))

# one code point k that the test found: its step is the character's
def ql.is(
  +uu: U32,
  +kk: U32,
  ee: {U32.is_eq(uu, kk) == True{} : Bool},
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  at: ql.Step(kk, hd, rw, hs, he, ps, ab, back, buf)
) -> ql.Step(uu, hd, rw, hs, he, ps, ab, back, buf):
  eu = Equal.cong(Char, U32, cc => Char.to_u32(cc), Chr{uu}, Chr{kk}, Eq.u32_eq(uu, kk, ee))
  %Equal.sym(U32, uu, kk, eu) : ql.Step(_, hd, rw, hs, he, ps, ab, back, buf)
  at

# every literal character: a quotation mark, a backslash, a tab, or another
def ql.split(
  +uu: U32,
  d34: Bool,
  b92: Bool,
  t9: Bool,
  e34: {U32.is_eq(uu, 34) == d34 : Bool},
  e92: {U32.is_eq(uu, 92) == b92 : Bool},
  e9: {U32.is_eq(uu, 9) == t9 : Bool},
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  el: {Laws.lit.char(Chr{uu}) == True{} : Bool}
) -> ql.Step(uu, hd, rw, hs, he, ps, ab, back, buf):
  match d34:
    case True{}:
      ql.is(uu, 34, e34, hd, rw, hs, he, ps, ab, back, buf, ql.s34(hd, rw, hs, he, ps, ab, back, buf))
    case False{}:
      match b92:
        case True{}:
          ql.is(uu, 92, e92, hd, rw, hs, he, ps, ab, back, buf, ql.s92(hd, rw, hs, he, ps, ab, back, buf))
        case False{}:
          match t9:
            case True{}:
              ql.is(uu, 9, e9, hd, rw, hs, he, ps, ab, back, buf, ql.s9(hd, rw, hs, he, ps, ab, back,
                buf))
            case False{}:
              ql.gen(uu, hd, rw, hs, he, ps, ab, back, buf, e34, e92, e9, el)

# one character of a literal segment
def ql.one(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  el: {Laws.lit.char(Chr{uu}) == True{} : Bool}
) -> ql.Step(uu, hd, rw, hs, he, ps, ab, back, buf):
  ql.split(uu, U32.is_eq(uu, 34), U32.is_eq(uu, 92), U32.is_eq(uu, 9), {==}, {==}, {==}, hd, rw, hs,
    he, ps, ab, back, buf, el)

# every character of a literal text is pushed, whatever follows it
def ql.body(
  ss: String,
  +rr: String,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +back: T.Lex,
  +buf: List<&2, Char>,
  +ee: {Laws.lit.text(ss) == True{} : Bool}
) -> {T.doc.read(String.append(ss, rr), T.MScan{ql(hd, rw, hs, he, ps, ab, back, buf)})
  == T.doc.read(rr, T.MScan{ql(hd, rw, hs, he, ps, ab, back, rev.onto(ss, buf))}) : T.Doc}:
  match ss:
    case SNil{}:
      {==}
    case SCon{hh, +tt}:
      match hh:
        case Chr{+uu}:
          Equal.trans(T.Doc,
            T.doc.read(String.append(tt, rr), T.doc.scan(ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu})),
            T.doc.read(String.append(tt, rr), T.MScan{ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf)}),
            T.doc.read(rr, T.MScan{ql(hd, rw, hs, he, ps, ab, back, rev.onto(tt, Chr{uu} <> buf))}),
            Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, rr), md),
              T.doc.scan(ql(hd, rw, hs, he, ps, ab, back, buf), Chr{uu}),
              T.MScan{ql(hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf)},
              ql.one(uu, hd, rw, hs, he, ps, ab, back, buf,
                Eq.and.left(Laws.lit.char(Chr{uu}), Laws.lit.text(tt), ee))),
            ql.body(tt, rr, hd, rw, hs, he, ps, ab, back, Chr{uu} <> buf,
              Eq.and.right(Laws.lit.char(Chr{uu}), Laws.lit.text(tt), ee)))

def Laws.literal_key_reads_back(s, e):
  Equal.trans(T.Doc,
    T.doc.read(String.append(s, "' = 1"), T.MScan{ql(False{}, [], [], [], [], False{}, T.LTop{}, [])}),
    T.doc.read("' = 1", T.MScan{ql(False{}, [], [], [], [], False{}, T.LTop{}, rev.onto(s, []))}),
    T.Doc{"", [T.VPair{s, T.VInt{T.Plus{}, "1"}}]},
    ql.body(s, "' = 1", False{}, [], [], [], [], False{}, T.LTop{}, [], e),
    Equal.trans(T.Doc,
      T.doc.read("' = 1", T.MScan{ql(False{}, [], [], [], [], False{}, T.LTop{}, rev.onto(s, []))}),
      kq.doc(rev.onto(s, [])),
      T.Doc{"", [T.VPair{s, T.VInt{T.Plus{}, "1"}}]},
      {==},
      kq.name(s)))

# WP-K3: a dotted key on a key/value line. Each segment starts at the start of
# the line (LTop, no parts yet) or after a dot (LKeyDot); a bare one is
# pushed in LKey and ended by blank space (to LAfter), a dot or `=`; a basic
# one is read by WP0's qs family and a literal one by ql, each ending in
# LAfter; blank space in LAfter and after a dot is skipped. The segment's
# name joins parts, newest first, and the last `=` leaves the scanner waiting
# for the value. The states are WP-H's wh.st, with the same fields.

# where a key segment starts: at the start of a line, or after a dot
def kl.lex0(dt: Bool) -> T.Lex:
  match dt:
    case False{}:
      T.LTop{}
    case True{}:
      T.LKeyDot{}

# what ends a segment and its blank space: a dot, or `=` when cl
def kl.dl(cl: Bool) -> Char:
  match cl:
    case False{}:
      '.'
    case True{}:
      '='

# the state after it: waiting for the next segment, or for the value
def kl.aft(cl: Bool) -> T.Lex:
  match cl:
    case False{}:
      T.LKeyDot{}
    case True{}:
      T.LVal{}

# the rest of the text after a segment and what ends it, read from every
# back and qkind
def kl.Then(
  cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc
) -> Type:
  @bk: T.Lex -> @qk: T.QKind ->
    {T.doc.read(rest, T.MScan{wh.st(rows, heads, here, parts, [], kl.aft(cl), bk, qk, arrtab)}) == goal
      : T.Doc}

# blank space after a segment stays in LAfter
def kl.agap(
  gs: List<&2, Bool>,
  +rr: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{wh.st(rows, heads, here, parts, [], T.LAfter{},
  back, qkind, arrtab)}) == T.doc.read(rr, T.MScan{wh.st(rows, heads, here, parts, [], T.LAfter{}, back,
  qkind, arrtab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          kl.agap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)
        case False{}:
          kl.agap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)

# and blank space after a dot stays in LKeyDot
def kl.dgap(
  gs: List<&2, Bool>,
  +rr: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{wh.st(rows, heads, here, parts, [], T.LKeyDot{},
  back, qkind, arrtab)}) == T.doc.read(rr, T.MScan{wh.st(rows, heads, here, parts, [], T.LKeyDot{}, back,
  qkind, arrtab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          kl.dgap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)
        case False{}:
          kl.dgap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)

# a dot or `=` after a segment's blank space
def kl.adl(
  cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String
) -> {T.doc.read(SCon{kl.dl(cl), rest}, T.MScan{wh.st(rows, heads, here, parts, [], T.LAfter{}, back, qkind,
  arrtab)}) == T.doc.read(rest, T.MScan{wh.st(rows, heads, here, parts, [], kl.aft(cl), back, qkind,
  arrtab)}) : T.Doc}:
  match cl:
    case False{}:
      {==}
    case True{}:
      {==}

# blank space, then a dot or `=`, after a segment pushed onto parts
def kl.atail(
  gs: List<&2, Bool>,
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here, parts,
  [], T.LAfter{}, back, qkind, arrtab)}) == T.doc.read(rest, T.MScan{wh.st(rows, heads, here, parts, [],
  kl.aft(cl), back, qkind, arrtab)}) : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here, parts,
      [], T.LAfter{}, back, qkind, arrtab)}),
    T.doc.read(SCon{kl.dl(cl), rest}, T.MScan{wh.st(rows, heads, here, parts, [], T.LAfter{}, back, qkind,
      arrtab)}),
    T.doc.read(rest, T.MScan{wh.st(rows, heads, here, parts, [], kl.aft(cl), back, qkind, arrtab)}),
    kl.agap(gs, SCon{kl.dl(cl), rest}, rows, heads, here, parts, back, qkind, arrtab),
    kl.adl(cl, rows, heads, here, parts, back, qkind, arrtab, rest))

# the segment's buffer reads as its name, and the rest is read
def kl.nm(
  +nm: String,
  +bf: List<&2, Char>,
  en: {T.buf.str(bf) == nm : String},
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: kl.Then(cl, rows, heads, here, nm <> parts, arrtab, rest, goal)
) -> {T.doc.read(rest, T.MScan{wh.st(rows, heads, here, T.buf.str(bf) <> parts, [], kl.aft(cl), bk, qk,
  arrtab)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(rest, T.MScan{wh.st(rows, heads, here, T.buf.str(bf) <> parts, [], kl.aft(cl), bk, qk,
      arrtab)}),
    T.doc.read(rest, T.MScan{wh.st(rows, heads, here, nm <> parts, [], kl.aft(cl), bk, qk, arrtab)}),
    goal,
    Equal.cong(String, T.Doc, xx => T.doc.read(rest, T.MScan{wh.st(rows, heads, here, xx <> parts, [],
      kl.aft(cl), bk, qk, arrtab)}), T.buf.str(bf), nm, en),
    ih(bk, qk))

# after a quoted segment's closing quote: blank space, a dot or `=`, and the rest
def kl.fin(
  +nm: String,
  +bf: List<&2, Char>,
  en: {T.buf.str(bf) == nm : String},
  +gs: List<&2, Bool>,
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: kl.Then(cl, rows, heads, here, nm <> parts, arrtab, rest, goal)
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
  T.buf.str(bf) <> parts, [], T.LAfter{}, bk, qk, arrtab)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
      T.buf.str(bf) <> parts, [], T.LAfter{}, bk, qk, arrtab)}),
    T.doc.read(rest, T.MScan{wh.st(rows, heads, here, T.buf.str(bf) <> parts, [], kl.aft(cl), bk, qk,
      arrtab)}),
    goal,
    kl.atail(gs, cl, rows, heads, here, T.buf.str(bf) <> parts, bk, qk, arrtab, rest),
    kl.nm(nm, bf, en, cl, rows, heads, here, parts, bk, qk, arrtab, rest, goal, ih))

# a code point one of two others' is not, when a predicate tells it apart
def kl.no2(
  bb: Bool,
  +xx: U32,
  +k1: U32,
  +k2: U32,
  eb: {Bool.or(U32.is_eq(xx, k1), U32.is_eq(xx, k2)) == bb : Bool},
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool},
  n1: {T.bare.at(Chr{k1}) == False{} : Bool},
  n2: {T.bare.at(Chr{k2}) == False{} : Bool}
) -> {Bool.or(U32.is_eq(xx, k1), U32.is_eq(xx, k2)) == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.gone(&2, {Bool.or(U32.is_eq(xx, k1), U32.is_eq(xx, k2)) == False{} : Bool},
        or2.no(xx, k1, k2, U32.is_eq(xx, k1), U32.is_eq(xx, k2), {==}, {==}, eb, ch => T.bare.at(ch), ee,
          n1, n2))
    case False{}:
      eb

# at the start of a line, a character that is no blank and no newline takes
# the full step
def kl.ws(
  sp: Bool,
  nl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +cc: Char,
  hs: {sp == False{} : Bool},
  hn: {nl == False{} : Bool}
) -> {T.read.fast.ws(sp, nl, True{}, "", rows, heads, here, parts, buf, lex, back, qkind, [], 0, 0, arrtab, cc)
  == T.read.fast.old("", rows, heads, here, parts, buf, lex, back, qkind, [], 0, 0, arrtab, cc) : T.St}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.fast.ws(True{}, nl, True{}, "", rows, heads, here, parts, buf, lex, back,
        qkind, [], 0, 0, arrtab, cc) == T.read.fast.old("", rows, heads, here, parts, buf, lex, back, qkind,
        [], 0, 0, arrtab, cc) : T.St}, hs)
    case False{}:
      match nl:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.fast.ws(False{}, True{}, True{}, "", rows, heads, here, parts, buf, lex,
            back, qkind, [], 0, 0, arrtab, cc) == T.read.fast.old("", rows, heads, here, parts, buf, lex,
            back, qkind, [], 0, 0, arrtab, cc) : T.St}, hn)
        case False{}:
          {==}

# after a dot, a bare character is no blank and no quote, so it starts a
# bare segment
def kd.bare(
  sp: Bool,
  qq: Bool,
  lit: Bool,
  dot: Bool,
  nl: Bool,
  st: T.St,
  +xx: U32,
  esp: {T.ch.sp(Chr{xx}) == sp : Bool},
  eqq: {Char.is_eq(Chr{xx}, '"') == qq : Bool},
  elit: {Char.is_eq(Chr{xx}, '\'') == lit : Bool},
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.lex.kdot.go(sp, qq, lit, dot, nl, st, Chr{xx}) == T.st.push(st, Chr{xx}, T.LKey{}) : T.St}:
  match sp:
    case True{}:
      Eq.bit.gone(&2, {T.lex.kdot.go(True{}, qq, lit, dot, nl, st, Chr{xx})
        == T.st.push(st, Chr{xx}, T.LKey{}) : T.St},
        or2.no(xx, 32, 9, U32.is_eq(xx, 32), U32.is_eq(xx, 9), {==}, {==}, esp,
          ch => T.bare.at(ch), ee, {==}, {==}))
    case False{}:
      match qq:
        case True{}:
          Eq.bit.gone(&2, {T.lex.kdot.go(False{}, True{}, lit, dot, nl, st, Chr{xx})
            == T.st.push(st, Chr{xx}, T.LKey{}) : T.St},
            Eq.refute_char(Chr{xx}, '"', ch => T.bare.at(ch), eqq, ee, {==}))
        case False{}:
          match lit:
            case True{}:
              Eq.bit.gone(&2, {T.lex.kdot.go(False{}, False{}, True{}, dot, nl, st, Chr{xx})
                == T.st.push(st, Chr{xx}, T.LKey{}) : T.St},
                Eq.refute_char(Chr{xx}, '\'', ch => T.bare.at(ch), elit, ee, {==}))
            case False{}:
              Equal.cong(Bool, T.St, bb => T.lex.kdot.bare(bb, dot, nl, st, Chr{xx}), T.bare.at(Chr{xx}),
                True{}, ee)

# the first character of a bare segment starts its buffer
def kl.b1.fast(
  dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.read.fast(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), Chr{xx})
  == wh.st(rows, heads, here, wh.ps(dt, parts), [Chr{xx}], T.LKey{}, back, qkind, arrtab) : T.St}:
  match dt:
    case False{}:
      Equal.trans(T.St,
        T.read.fast(wh.st(rows, heads, here, [], [], T.LTop{}, back, qkind, arrtab), Chr{xx}),
        T.read.fast.old("", rows, heads, here, [], [], T.LTop{}, back, qkind, [], 0, 0, arrtab, Chr{xx}),
        wh.st(rows, heads, here, [], [Chr{xx}], T.LKey{}, back, qkind, arrtab),
        kl.ws(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), rows, heads, here, [], [], T.LTop{}, back, qkind, arrtab,
          Chr{xx}, kl.no2(T.ch.sp(Chr{xx}), xx, 32, 9, {==}, ee, {==}, {==}),
          kl.no2(T.ch.nl(Chr{xx}), xx, 10, 13, {==}, ee, {==}, {==})),
        Equal.cong(T.St, T.St, st => T.read.once2(st),
          T.lex.top.go(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), Char.is_eq(Chr{xx}, '#'),
            Char.is_eq(Chr{xx}, '['), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''),
            T.bare.at(Chr{xx}), wh.st(rows, heads, here, [], [], T.LTop{}, back, qkind, arrtab), Chr{xx}),
          T.st.push(wh.st(rows, heads, here, [], [], T.LTop{}, back, qkind, arrtab), Chr{xx}, T.LKey{}),
          key.top(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), Char.is_eq(Chr{xx}, '#'),
            Char.is_eq(Chr{xx}, '['), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''),
            T.bare.at(Chr{xx}), wh.st(rows, heads, here, [], [], T.LTop{}, back, qkind, arrtab), xx,
            {==}, {==}, {==}, {==}, {==}, {==}, {==}, ee)))
    case True{}:
      Equal.cong(T.St, T.St, st => T.read.once2(st),
        T.lex.kdot.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''),
          Char.is_eq(Chr{xx}, '.'), T.ch.nl(Chr{xx}), wh.st(rows, heads, here, parts, [], T.LKeyDot{}, back,
          qkind, arrtab), Chr{xx}),
        T.st.push(wh.st(rows, heads, here, parts, [], T.LKeyDot{}, back, qkind, arrtab), Chr{xx}, T.LKey{}),
        kd.bare(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''),
          Char.is_eq(Chr{xx}, '.'), T.ch.nl(Chr{xx}), wh.st(rows, heads, here, parts, [], T.LKeyDot{}, back,
          qkind, arrtab), xx, {==}, {==}, {==}, ee))

# and the scan mode sends it there
def kl.b1(
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), Chr{xx})
  == T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [Chr{xx}], T.LKey{}, back, qkind, arrtab)} : T.Mode}:
  Equal.trans(T.Mode,
    T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), Chr{xx}),
    T.MScan{T.read.fast(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab),
      Chr{xx})},
    T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [Chr{xx}], T.LKey{}, back, qkind, arrtab)},
    scan.other(Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), U32.is_eq(xx, 13),
      wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), Chr{xx}, {==}, {==},
      {==}, ch => T.bare.at(ch), ee, {==}, {==}, {==}),
    Equal.cong(T.St, T.Mode, st => T.MScan{st},
      T.read.fast(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), Chr{xx}),
      wh.st(rows, heads, here, wh.ps(dt, parts), [Chr{xx}], T.LKey{}, back, qkind, arrtab),
      kl.b1.fast(dt, rows, heads, here, parts, back, qkind, arrtab, xx, ee)))

# a later bare character stays on the key's fast path
def kl.kfast(
  ok: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +xx: U32,
  eok: {T.bare.at(Chr{xx}) == ok : Bool},
  ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.read.fast.key(ok, "", rows, heads, here, parts, buf, back, qkind, [], 0, 0, arrtab, Chr{xx})
  == wh.st(rows, heads, here, parts, Chr{xx} <> buf, T.LKey{}, back, qkind, arrtab) : T.St}:
  match ok:
    case True{}:
      {==}
    case False{}:
      clash(&2, {T.read.fast.key(False{}, "", rows, heads, here, parts, buf, back, qkind, [], 0, 0, arrtab,
        Chr{xx}) == wh.st(rows, heads, here, parts, Chr{xx} <> buf, T.LKey{}, back, qkind, arrtab) : T.St},
        Equal.trans(Bool, False{}, T.bare.at(Chr{xx}), True{},
          Equal.sym(Bool, T.bare.at(Chr{xx}), False{}, eok), ee))

# a later character of a bare segment, from the scan mode
def kl.b2(
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.doc.scan(wh.st(rows, heads, here, parts, buf, T.LKey{}, back, qkind, arrtab), Chr{xx})
  == T.MScan{wh.st(rows, heads, here, parts, Chr{xx} <> buf, T.LKey{}, back, qkind, arrtab)} : T.Mode}:
  Equal.trans(T.Mode,
    T.doc.scan(wh.st(rows, heads, here, parts, buf, T.LKey{}, back, qkind, arrtab), Chr{xx}),
    T.MScan{T.read.fast(wh.st(rows, heads, here, parts, buf, T.LKey{}, back, qkind, arrtab), Chr{xx})},
    T.MScan{wh.st(rows, heads, here, parts, Chr{xx} <> buf, T.LKey{}, back, qkind, arrtab)},
    scan.other(Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), U32.is_eq(xx, 13),
      wh.st(rows, heads, here, parts, buf, T.LKey{}, back, qkind, arrtab), Chr{xx}, {==}, {==}, {==},
      ch => T.bare.at(ch), ee, {==}, {==}, {==}),
    Equal.cong(T.St, T.Mode, st => T.MScan{st},
      T.read.fast(wh.st(rows, heads, here, parts, buf, T.LKey{}, back, qkind, arrtab), Chr{xx}),
      wh.st(rows, heads, here, parts, Chr{xx} <> buf, T.LKey{}, back, qkind, arrtab),
      kl.kfast(T.bare.at(Chr{xx}), rows, heads, here, parts, buf, back, qkind, arrtab, xx, {==}, ee)))

# the rest of a bare segment is pushed onto its buffer, whatever follows it
def kl.bbody(
  ks: String,
  +rr: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +ee: {T.bare.all(String.to_list(ks)) == True{} : Bool}
) -> {T.doc.read(String.append(ks, rr), T.MScan{wh.st(rows, heads, here, parts, buf, T.LKey{}, back, qkind,
  arrtab)}) == T.doc.read(rr, T.MScan{wh.st(rows, heads, here, parts, rev.onto(ks, buf), T.LKey{}, back,
  qkind, arrtab)}) : T.Doc}:
  match ks:
    case SNil{}:
      {==}
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          Equal.trans(T.Doc,
            T.doc.read(String.append(tt, rr), T.doc.scan(wh.st(rows, heads, here, parts, buf, T.LKey{}, back,
              qkind, arrtab), Chr{xx})),
            T.doc.read(String.append(tt, rr), T.MScan{wh.st(rows, heads, here, parts, Chr{xx} <> buf,
              T.LKey{}, back, qkind, arrtab)}),
            T.doc.read(rr, T.MScan{wh.st(rows, heads, here, parts, rev.onto(tt, Chr{xx} <> buf), T.LKey{},
              back, qkind, arrtab)}),
            Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, rr), md),
              T.doc.scan(wh.st(rows, heads, here, parts, buf, T.LKey{}, back, qkind, arrtab), Chr{xx}),
              T.MScan{wh.st(rows, heads, here, parts, Chr{xx} <> buf, T.LKey{}, back, qkind, arrtab)},
              kl.b2(rows, heads, here, parts, buf, back, qkind, arrtab, xx,
                ball.head(T.bare.at(Chr{xx}), String.to_list(tt), ee))),
            kl.bbody(tt, rr, rows, heads, here, parts, Chr{xx} <> buf, back, qkind, arrtab,
              ball.tail(T.bare.at(Chr{xx}), String.to_list(tt), ee)))

# a blank ends an open bare segment: it is pushed, and the scanner waits in
# LAfter
def kl.bsp(
  tab: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rr: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(SCon{Laws.blank_char(tab), rr}, T.MScan{wh.st(rows, heads, here, parts, bf, T.LKey{}, back,
  qkind, arrtab)}) == T.doc.read(rr, T.MScan{wh.st(rows, heads, here, T.buf.str(bf) <> parts, [], T.LAfter{},
  back, qkind, arrtab)}) : T.Doc}:
  match tab:
    case True{}:
      Equal.cong(Bool, T.Doc, bt => T.doc.read(rr, T.MScan{T.read.once2(T.lex.key.end.go(bt, wh.st(rows,
        heads, here, parts, bf, T.LKey{}, back, qkind, arrtab), T.LAfter{}))}),
        List.is_empty(&2, Char, bf), False{}, full)
    case False{}:
      Equal.cong(Bool, T.Doc, bt => T.doc.read(rr, T.MScan{T.read.once2(T.lex.key.end.go(bt, wh.st(rows,
        heads, here, parts, bf, T.LKey{}, back, qkind, arrtab), T.LAfter{}))}),
        List.is_empty(&2, Char, bf), False{}, full)

# a dot or `=` right after an open bare segment pushes it
def kl.bdl(
  cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(SCon{kl.dl(cl), rest}, T.MScan{wh.st(rows, heads, here, parts, bf, T.LKey{}, back, qkind,
  arrtab)}) == T.doc.read(rest, T.MScan{wh.st(rows, heads, here, T.buf.str(bf) <> parts, [], kl.aft(cl), back,
  qkind, arrtab)}) : T.Doc}:
  match cl:
    case False{}:
      Equal.cong(Bool, T.Doc, bt => T.doc.read(rest, T.MScan{T.read.once2(T.lex.key.end.go(bt, wh.st(rows,
        heads, here, parts, bf, T.LKey{}, back, qkind, arrtab), T.LKeyDot{}))}),
        List.is_empty(&2, Char, bf), False{}, full)
    case True{}:
      Equal.cong(Bool, T.Doc, bt => T.doc.read(rest, T.MScan{T.read.once2(T.lex.key.end.go(bt, wh.st(rows,
        heads, here, parts, bf, T.LKey{}, back, qkind, arrtab), T.LVal{}))}),
        List.is_empty(&2, Char, bf), False{}, full)

# blank space and a dot or `=` after an open bare segment push it
def kl.bend(
  gs: List<&2, Bool>,
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here, parts,
  bf, T.LKey{}, back, qkind, arrtab)}) == T.doc.read(rest, T.MScan{wh.st(rows, heads, here,
  T.buf.str(bf) <> parts, [], kl.aft(cl), back, qkind, arrtab)}) : T.Doc}:
  match gs:
    case []:
      kl.bdl(cl, rows, heads, here, parts, bf, back, qkind, arrtab, rest, full)
    case tab <> +gr:
      Equal.trans(T.Doc,
        T.doc.read(SCon{Laws.blank_char(tab), String.append(Laws.gap(gr), SCon{kl.dl(cl), rest})},
          T.MScan{wh.st(rows, heads, here, parts, bf, T.LKey{}, back, qkind, arrtab)}),
        T.doc.read(String.append(Laws.gap(gr), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
          T.buf.str(bf) <> parts, [], T.LAfter{}, back, qkind, arrtab)}),
        T.doc.read(rest, T.MScan{wh.st(rows, heads, here, T.buf.str(bf) <> parts, [], kl.aft(cl), back,
          qkind, arrtab)}),
        kl.bsp(tab, rows, heads, here, parts, bf, back, qkind, arrtab, String.append(Laws.gap(gr),
          SCon{kl.dl(cl), rest}), full),
        kl.atail(gr, cl, rows, heads, here, T.buf.str(bf) <> parts, back, qkind, arrtab, rest))

# a bare segment, its blank space and a dot or `=`: the rest is read with the
# segment pushed, and back and qkind as they were
def kl.bseg(
  +xx: U32,
  +tt: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  +ee: {T.bare.all.step(T.bare.at(Chr{xx}), _u => T.bare.all(String.to_list(tt))) == True{} : Bool},
  ih: kl.Then(cl, rows, heads, here, SCon{Chr{xx}, tt} <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(SCon{Chr{xx}, tt}, String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})),
  T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab)}) == goal
  : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})), T.doc.scan(wh.st(rows,
      heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), Chr{xx})),
    T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})), T.MScan{wh.st(rows,
      heads, here, wh.ps(dt, parts), [Chr{xx}], T.LKey{}, back, qkind, arrtab)}),
    goal,
    Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, String.append(Laws.gap(gs),
      SCon{kl.dl(cl), rest})), md),
      T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), Chr{xx}),
      T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [Chr{xx}], T.LKey{}, back, qkind, arrtab)},
      kl.b1(dt, rows, heads, here, parts, back, qkind, arrtab, xx,
        ball.head(T.bare.at(Chr{xx}), String.to_list(tt), ee))),
    Equal.trans(T.Doc,
      T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})), T.MScan{wh.st(rows,
        heads, here, wh.ps(dt, parts), [Chr{xx}], T.LKey{}, back, qkind, arrtab)}),
      T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
        wh.ps(dt, parts), rev.onto(tt, [Chr{xx}]), T.LKey{}, back, qkind, arrtab)}),
      goal,
      kl.bbody(tt, String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), rows, heads, here, wh.ps(dt, parts),
        [Chr{xx}], back, qkind, arrtab, ball.tail(T.bare.at(Chr{xx}), String.to_list(tt), ee)),
      Equal.trans(T.Doc,
        T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
          wh.ps(dt, parts), rev.onto(tt, [Chr{xx}]), T.LKey{}, back, qkind, arrtab)}),
        T.doc.read(rest, T.MScan{wh.st(rows, heads, here, T.buf.str(rev.onto(tt, [Chr{xx}])) <>
          wh.ps(dt, parts), [], kl.aft(cl), back, qkind, arrtab)}),
        goal,
        kl.bend(gs, cl, rows, heads, here, wh.ps(dt, parts), rev.onto(tt, [Chr{xx}]), back, qkind, arrtab,
          rest, rev.full(tt, Chr{xx}, [])),
        kl.nm(SCon{Chr{xx}, tt}, rev.onto(tt, [Chr{xx}]), wh.bname(xx, tt), cl, rows, heads, here,
          wh.ps(dt, parts), back, qkind, arrtab, rest, goal, ih))))

# a quotation mark where a segment starts opens a basic segment
def kl.qopen(
  dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), '"')
  == T.MScan{qs(False{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [])} : T.Mode}:
  match dt:
    case False{}:
      {==}
    case True{}:
      {==}

# and an apostrophe a literal one
def kl.lopen(
  dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), '\'')
  == T.MScan{ql(False{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])} : T.Mode}:
  match dt:
    case False{}:
      {==}
    case True{}:
      {==}

# a basic segment, its blank space and a dot or `=`: the rest is read with the
# segment pushed under its name, from wherever the last escape left back
def kl.qseg(
  +ss: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: kl.Then(cl, rows, heads, here, ss <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(T.key.basic(ss), String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})),
  T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab)}) == goal
  : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(T.key.basic(ss), String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})),
      T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab)}),
    T.doc.read(String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs),
      SCon{kl.dl(cl), rest})), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back,
      qkind, arrtab), '"')),
    goal,
    Equal.cong(String, T.Doc, zz => T.doc.read(String.append(zz, String.append(Laws.gap(gs),
      SCon{kl.dl(cl), rest})), T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back,
      qkind, arrtab)}),
      T.key.basic(ss), "\"" ++ Laws.escs(ss) ++ "\"", Laws.basic_escs(ss)),
    Equal.trans(T.Doc,
      T.doc.read(String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs),
        SCon{kl.dl(cl), rest})), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back,
        qkind, arrtab), '"')),
      T.doc.read(String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}),
        T.MScan{qs(False{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [])}),
      goal,
      Equal.trans(T.Doc,
        T.doc.read(String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs),
          SCon{kl.dl(cl), rest})), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt),
          back, qkind, arrtab), '"')),
        T.doc.read(String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{kl.dl(cl),
          rest})}), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind,
          arrtab), '"')),
        T.doc.read(String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{kl.dl(cl),
          rest})}), T.MScan{qs(False{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [])}),
        Equal.cong(String, T.Doc, zz => T.doc.read(zz, T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts),
          [], kl.lex0(dt), back, qkind, arrtab), '"')),
          String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs), SCon{kl.dl(cl),
            rest})),
          String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}),
          Eq.append_assoc(Laws.escs(ss), "\"", String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}))),
        Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(Laws.escs(ss), SCon{'"',
          String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}), md),
          T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), '"'),
          T.MScan{qs(False{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [])},
          kl.qopen(dt, rows, heads, here, parts, back, qkind, arrtab))),
      qs.escs(ss, False{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [],
        SCon{'"', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}, goal,
        +bk => Equal.trans(T.Doc,
          T.doc.read(SCon{'"', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}, T.MScan{qs(False{}, rows,
            heads, here, wh.ps(dt, parts), [], arrtab, bk, rev.onto(ss, []))}),
          T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
            T.buf.str(rev.onto(ss, [])) <> wh.ps(dt, parts), [], T.LAfter{}, bk, T.QBasic{}, arrtab)}),
          goal,
          {==},
          kl.fin(ss, rev.onto(ss, []), wh.qname(ss), gs, cl, rows, heads, here, wh.ps(dt, parts), bk,
            T.QBasic{}, arrtab, rest, goal, ih)))))

# a literal segment, its blank space and a dot or `=`: the rest is read with
# the segment pushed under its characters, and back as it was
def kl.lseg(
  +ss: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  el: {Laws.lit.text(ss) == True{} : Bool},
  ih: kl.Then(cl, rows, heads, here, ss <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(SCon{'\'', String.append(ss, "'")}, String.append(Laws.gap(gs),
  SCon{kl.dl(cl), rest})), T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind,
  arrtab)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(String.append(ss, "'"), String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})),
      T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), '\'')),
    T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}),
      T.MScan{ql(False{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])}),
    goal,
    Equal.trans(T.Doc,
      T.doc.read(String.append(String.append(ss, "'"), String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})),
        T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), '\'')),
      T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}),
        T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), '\'')),
      T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}),
        T.MScan{ql(False{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])}),
      Equal.cong(String, T.Doc, zz => T.doc.read(zz, T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [],
        kl.lex0(dt), back, qkind, arrtab), '\'')),
        String.append(String.append(ss, "'"), String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})),
        String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}),
        Eq.append_assoc(ss, "'", String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}))),
      Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs),
        SCon{kl.dl(cl), rest})}), md),
        T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab), '\''),
        T.MScan{ql(False{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])},
        kl.lopen(dt, rows, heads, here, parts, back, qkind, arrtab))),
    Equal.trans(T.Doc,
      T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}),
        T.MScan{ql(False{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])}),
      T.doc.read(SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})},
        T.MScan{ql(False{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, rev.onto(ss, []))}),
      goal,
      ql.body(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})}, False{}, rows, heads, here,
        wh.ps(dt, parts), arrtab, back, [], el),
      Equal.trans(T.Doc,
        T.doc.read(SCon{'\'', String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})},
          T.MScan{ql(False{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, rev.onto(ss, []))}),
        T.doc.read(String.append(Laws.gap(gs), SCon{kl.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
          T.buf.str(rev.onto(ss, [])) <> wh.ps(dt, parts), [], T.LAfter{}, back, T.QLit{}, arrtab)}),
        goal,
        {==},
        kl.fin(ss, rev.onto(ss, []), wh.qname(ss), gs, cl, rows, heads, here, wh.ps(dt, parts), back,
          T.QLit{}, arrtab, rest, goal, ih))))

# a segment spelled any way it can be, its blank space and a dot or `=`
def kl.seg(
  sg: Laws.Seg,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.seg.ok(sg) == True{} : Bool},
  ih: kl.Then(cl, rows, heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(Laws.seg.text(sg), String.append(Laws.gap(gs), SCon{kl.dl(cl), rest})),
  T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab)}) == goal
  : T.Doc}:
  match sg:
    case Laws.Seg{sp, +name}:
      match sp:
        case Laws.SpBare{}:
          match name:
            case SNil{}:
              Eq.bit.absurd(&2, {T.doc.read(String.append(SNil{}, String.append(Laws.gap(gs), SCon{kl.dl(cl),
                rest})), T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind,
                arrtab)}) == goal : T.Doc}, eo)
            case SCon{hh, +tt}:
              match hh:
                case Chr{+xx}:
                  kl.bseg(xx, tt, gs, cl, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, eo, ih)
        case Laws.SpBasic{}:
          kl.qseg(name, gs, cl, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, ih)
        case Laws.SpLit{}:
          kl.lseg(name, gs, cl, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, eo, ih)

# the key's segments pushed onto the parts before them, newest first
def kl.acc(ds: List<&2, Laws.Dot>, last: Laws.Seg, dt: Bool, parts: List<&2, String>) -> List<&2, String>:
  List.reverse.go(&2, String, Laws.dk.names(ds, last), wh.ps(dt, parts))

# a dotted key's segments, then blank space and `=`: the rest is read with
# every segment pushed onto parts, newest first
def kl.keys(
  ds: List<&2, Laws.Dot>,
  +last: Laws.Seg,
  +g: List<&2, Bool>,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  +eo: {Laws.dk.ok(ds, last) == True{} : Bool},
  ih: kl.Then(True{}, rows, heads, here, kl.acc(ds, last, dt, parts), arrtab, rest, goal)
) -> {T.doc.read(Laws.dk.text(ds, last, String.append(Laws.gap(g), SCon{'=', rest})), T.MScan{wh.st(rows,
  heads, here, wh.ps(dt, parts), [], kl.lex0(dt), back, qkind, arrtab)}) == goal : T.Doc}:
  match ds:
    case []:
      kl.seg(last, g, True{}, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, eo, ih)
    case Laws.Dot{+sg, g1, +g2} <> +dr:
      kl.seg(sg, g1, False{}, dt, rows, heads, here, parts, back, qkind, arrtab,
        String.append(Laws.gap(g2), Laws.dk.text(dr, last, String.append(Laws.gap(g), SCon{'=', rest}))), goal,
        Eq.and.left(Laws.seg.ok(sg), Laws.dk.ok(dr, last), eo),
        +bk => +qk => Equal.trans(T.Doc,
          T.doc.read(String.append(Laws.gap(g2), Laws.dk.text(dr, last, String.append(Laws.gap(g), SCon{'=',
            rest}))), T.MScan{wh.st(rows, heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), [], T.LKeyDot{},
            bk, qk, arrtab)}),
          T.doc.read(Laws.dk.text(dr, last, String.append(Laws.gap(g), SCon{'=', rest})), T.MScan{wh.st(rows,
            heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), [], T.LKeyDot{}, bk, qk, arrtab)}),
          goal,
          kl.dgap(g2, Laws.dk.text(dr, last, String.append(Laws.gap(g), SCon{'=', rest})), rows, heads, here,
            Laws.seg.name(sg) <> wh.ps(dt, parts), bk, qk, arrtab),
          kl.keys(dr, last, g, True{}, rows, heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), bk, qk, arrtab,
            rest, goal, Eq.and.right(Laws.seg.ok(sg), Laws.dk.ok(dr, last), eo), ih)))

def Laws.dotted_key_reads_back(ds, last, ok, g, rows, heads, here, back, qkind, arrtab, rest, goal, ih):
  kl.keys(ds, last, g, False{}, rows, heads, here, [], back, qkind, arrtab, rest, goal, ok, ih)

# WP-K3: a dotted key's value put by the walk. Each step is WP-W's
# navigation step (sub.step) while skip counts down, and once it reaches zero
# a dotted key's step: it enters a table no header defined, or makes an
# implicit one, and records the path behind `.`. The frames pushed are the
# same as navigation's (tb.fr), so WP-W's nav.rebuild puts every table back.

# where a put's step leaves the walk
def dsub.Goal(
  +look: T.Look,
  +seg: String,
  +vs: List<&2, T.Val>,
  +v: T.Val,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool,
  +mark: Bool
) -> Type:
  {T.tree.sub.look(look, seg, vs, T.JPut{v}, stack, pre, heads, inl, mark)
    == T.Tw{Laws.tb.into(look), T.JPut{v}, tb.fr(look, seg, vs, pre) <> stack, "", T.tree.pre(pre, seg),
      Laws.dk.mark(mark, T.tree.pre(pre, seg), heads), inl} : T.Tw}

# the code records a dotted key's table as the law says: behind `.`, once
def dk.mark.eq(
  seen: Bool,
  +path: String,
  +heads: List<&2, String>
) -> {T.heads.define.new(seen, path, heads) == Laws.dk.mark.new(seen, path, heads) : List<&2, String>}:
  match seen:
    case True{}:
      {==}
    case False{}:
      {==}

# a dotted key's step enters a table no header defined, or makes a new one
def dsub.dot(
  +look: T.Look,
  +seg: String,
  +vs: List<&2, T.Val>,
  +v: T.Val,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool,
  ec: {Laws.dk.can.dot(look, heads, T.tree.pre(pre, seg)) == True{} : Bool}
) -> dsub.Goal(look, seg, vs, v, stack, pre, heads, inl, True{}):
  match look:
    case T.KMiss{}:
      Equal.cong(List<&2, String>, T.Tw, hh => T.Tw{[], T.JPut{v}, T.FrNew{seg, vs, T.tree.pre(pre, seg)} <> stack,
        "", T.tree.pre(pre, seg), hh, inl},
        T.heads.define.new(T.heads.has(heads, T.tree.pre(pre, seg)), T.tree.pre(pre, seg), heads),
        Laws.dk.mark.new(T.heads.has(heads, T.tree.pre(pre, seg)), T.tree.pre(pre, seg), heads),
        dk.mark.eq(T.heads.has(heads, T.tree.pre(pre, seg)), T.tree.pre(pre, seg), heads))
    case T.KHead{+p, +rr}:
      Equal.trans(T.Tw,
        T.tree.sub.head.go(T.heads.head(heads, T.tree.pre(pre, seg)), p, rr, seg, vs, T.JPut{v}, stack, pre, heads,
          inl, True{}),
        T.tree.sub.head.go(False{}, p, rr, seg, vs, T.JPut{v}, stack, pre, heads, inl, True{}),
        T.Tw{rr, T.JPut{v}, T.FrRep{seg, vs, p} <> stack, "", T.tree.pre(pre, seg),
          Laws.dk.mark(True{}, T.tree.pre(pre, seg), heads), inl},
        Equal.cong(Bool, T.Tw, bb => T.tree.sub.head.go(bb, p, rr, seg, vs, T.JPut{v}, stack, pre, heads, inl,
          True{}), T.heads.head(heads, T.tree.pre(pre, seg)), False{},
          Eq.not.true(T.heads.head(heads, T.tree.pre(pre, seg)), ec)),
        Equal.cong(List<&2, String>, T.Tw, hh => T.Tw{rr, T.JPut{v}, T.FrRep{seg, vs, p} <> stack, "",
          T.tree.pre(pre, seg), hh, inl},
          T.heads.define.new(T.heads.has(heads, T.tree.pre(pre, seg)), T.tree.pre(pre, seg), heads),
          Laws.dk.mark.new(T.heads.has(heads, T.tree.pre(pre, seg)), T.tree.pre(pre, seg), heads),
          dk.mark.eq(T.heads.has(heads, T.tree.pre(pre, seg)), T.tree.pre(pre, seg), heads)))
    case T.KInl{}:
      Eq.bit.absurd(&1, dsub.Goal(T.KInl{}, seg, vs, v, stack, pre, heads, inl, True{}), ec)
    case T.KAots{p, es}:
      Eq.bit.absurd(&1, dsub.Goal(T.KAots{p, es}, seg, vs, v, stack, pre, heads, inl, True{}), ec)
    case T.KNo{why}:
      Eq.bit.absurd(&1, dsub.Goal(T.KNo{why}, seg, vs, v, stack, pre, heads, inl, True{}), ec)

# a put's step: navigation, or a dotted key's segment
def dsub.step(
  mark: Bool,
  +look: T.Look,
  +seg: String,
  +vs: List<&2, T.Val>,
  +v: T.Val,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool,
  ec: {Laws.dk.can(mark, look, heads, T.tree.pre(pre, seg)) == True{} : Bool}
) -> dsub.Goal(look, seg, vs, v, stack, pre, heads, inl, mark):
  match mark:
    case False{}:
      sub.step(look, seg, vs, T.JPut{v}, stack, pre, heads, inl, False{}, ec, {==})
    case True{}:
      dsub.dot(look, seg, vs, v, stack, pre, heads, inl, ec)

# by induction on the path: each segment is one step of the put's walk
def dk.walk(
  path: List<&2, String>,
  +kk: String,
  +vs: List<&2, T.Val>,
  +v: T.Val,
  +stack: List<&2, T.Fr>,
  +pre: String,
  +heads: List<&2, String>,
  +inl: Bool,
  +skip: U32,
  +eo: {Laws.dk.open(path, pre, vs, heads, skip) == True{} : Bool}
) -> {T.tree.walk(List.append(&2, String, path, [kk]), T.Tw{vs, T.JPut{v}, stack, "", pre, heads, inl}, skip)
  == T.tree.leaf(kk, T.Tw{Laws.tb.rows(path, vs), T.JPut{v}, nav.frs(path, pre, vs, stack), "",
    Laws.tb.join(path, pre), Laws.dk.heads(path, pre, heads, skip), inl}) : T.End}:
  match path:
    case []:
      {==}
    case +seg <> +rest:
      Equal.trans(T.End,
        T.tree.walk(seg <> List.append(&2, String, rest, [kk]), T.Tw{vs, T.JPut{v}, stack, "", pre, heads, inl},
          skip),
        T.tree.walk(List.append(&2, String, rest, [kk]), T.Tw{Laws.tb.into(T.rows.look(vs, seg)), T.JPut{v},
          tb.fr(T.rows.look(vs, seg), seg, vs, pre) <> stack, "", T.tree.pre(pre, seg),
          Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), inl}, T.path.dec(skip)),
        T.tree.leaf(kk, T.Tw{Laws.tb.rows(rest, Laws.tb.into(T.rows.look(vs, seg))), T.JPut{v},
          nav.frs(rest, T.tree.pre(pre, seg), Laws.tb.into(T.rows.look(vs, seg)),
            tb.fr(T.rows.look(vs, seg), seg, vs, pre) <> stack), "",
          Laws.tb.join(rest, T.tree.pre(pre, seg)), Laws.dk.heads(rest, T.tree.pre(pre, seg),
            Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), T.path.dec(skip)), inl}),
        Equal.trans(T.End,
          T.tree.walk(seg <> List.append(&2, String, rest, [kk]), T.Tw{vs, T.JPut{v}, stack, "", pre, heads,
            inl}, skip),
          T.tree.walk(List.append(&2, String, rest, [kk]), T.tree.sub(seg, T.Tw{vs, T.JPut{v}, stack, "",
            pre, heads, inl}, U32.is_zero(skip)), T.path.dec(skip)),
          T.tree.walk(List.append(&2, String, rest, [kk]), T.Tw{Laws.tb.into(T.rows.look(vs, seg)), T.JPut{v},
            tb.fr(T.rows.look(vs, seg), seg, vs, pre) <> stack, "", T.tree.pre(pre, seg),
            Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), inl}, T.path.dec(skip)),
          walk.cons(seg, rest, kk, T.Tw{vs, T.JPut{v}, stack, "", pre, heads, inl}, skip),
          Equal.cong(T.Tw, T.End,
            tw => T.tree.walk(List.append(&2, String, rest, [kk]), tw, T.path.dec(skip)),
            T.tree.sub(seg, T.Tw{vs, T.JPut{v}, stack, "", pre, heads, inl}, U32.is_zero(skip)),
            T.Tw{Laws.tb.into(T.rows.look(vs, seg)), T.JPut{v}, tb.fr(T.rows.look(vs, seg), seg, vs, pre)
              <> stack, "", T.tree.pre(pre, seg), Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg),
              heads), inl},
            dsub.step(U32.is_zero(skip), T.rows.look(vs, seg), seg, vs, v, stack, pre, heads, inl,
              Eq.and.left(Laws.dk.can(U32.is_zero(skip), T.rows.look(vs, seg), heads, T.tree.pre(pre, seg)),
                Laws.dk.open(rest, T.tree.pre(pre, seg), Laws.tb.into(T.rows.look(vs, seg)),
                  Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), T.path.dec(skip)), eo)))),
        dk.walk(rest, kk, Laws.tb.into(T.rows.look(vs, seg)), v, tb.fr(T.rows.look(vs, seg), seg, vs, pre)
          <> stack, T.tree.pre(pre, seg), Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), inl,
          T.path.dec(skip),
          Eq.and.right(Laws.dk.can(U32.is_zero(skip), T.rows.look(vs, seg), heads, T.tree.pre(pre, seg)),
            Laws.dk.open(rest, T.tree.pre(pre, seg), Laws.tb.into(T.rows.look(vs, seg)),
              Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), T.path.dec(skip)), eo)))

# a step a put goes on through is one a walk can go on through
def dk.can.tb(
  zz: Bool,
  look: T.Look,
  heads: List<&2, String>,
  path: String,
  ee: {Laws.dk.can(zz, look, heads, path) == True{} : Bool}
) -> {Laws.tb.can(look) == True{} : Bool}:
  match zz:
    case False{}:
      ee
    case True{}:
      match look:
        case T.KMiss{}:
          {==}
        case T.KHead{_p, _r}:
          {==}
        case T.KInl{}:
          Eq.bit.absurd(&2, {Laws.tb.can(T.KInl{}) == True{} : Bool}, ee)
        case T.KAots{p, es}:
          Eq.bit.absurd(&2, {Laws.tb.can(T.KAots{p, es}) == True{} : Bool}, ee)
        case T.KNo{why}:
          Eq.bit.absurd(&2, {Laws.tb.can(T.KNo{why}) == True{} : Bool}, ee)

# both halves of an `and` answered True
def dk.and(
  aa: Bool,
  bb: Bool,
  ea: {aa == True{} : Bool},
  eb: {bb == True{} : Bool}
) -> {Bool.and(aa, bb) == True{} : Bool}:
  match aa:
    case True{}:
      eb
    case False{}:
      Eq.bit.absurd(&2, {Bool.and(False{}, bb) == True{} : Bool}, ea)

# a path a put goes on through is one a walk goes on through
def dk.tb(
  path: List<&2, String>,
  +pre: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +skip: U32,
  +eo: {Laws.dk.open(path, pre, rows, heads, skip) == True{} : Bool}
) -> {Laws.tb.open(path, rows) == True{} : Bool}:
  match path:
    case []:
      {==}
    case +seg <> +rest:
      dk.and(Laws.tb.can(T.rows.look(rows, seg)), Laws.tb.open(rest, Laws.tb.into(T.rows.look(rows, seg))),
        dk.can.tb(U32.is_zero(skip), T.rows.look(rows, seg), heads, T.tree.pre(pre, seg),
          Eq.and.left(Laws.dk.can(U32.is_zero(skip), T.rows.look(rows, seg), heads, T.tree.pre(pre, seg)),
            Laws.dk.open(rest, T.tree.pre(pre, seg), Laws.tb.into(T.rows.look(rows, seg)),
              Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), T.path.dec(skip)), eo)),
        dk.tb(rest, T.tree.pre(pre, seg), Laws.tb.into(T.rows.look(rows, seg)),
          Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), T.path.dec(skip),
          Eq.and.right(Laws.dk.can(U32.is_zero(skip), T.rows.look(rows, seg), heads, T.tree.pre(pre, seg)),
            Laws.dk.open(rest, T.tree.pre(pre, seg), Laws.tb.into(T.rows.look(rows, seg)),
              Laws.dk.mark(U32.is_zero(skip), T.tree.pre(pre, seg), heads), T.path.dec(skip)), eo)))

def Laws.dotted_put_at_head(path, k, v, rows, heads, skip, inl, eo, em):
  Equal.trans(T.End,
    T.tree.walk(List.append(&2, String, path, [k]), T.Tw{rows, T.JPut{v}, [], "", "", heads, inl}, skip),
    T.tree.leaf(k, T.Tw{Laws.tb.rows(path, rows), T.JPut{v}, nav.frs(path, "", rows, []), "",
      Laws.tb.join(path, ""), Laws.dk.heads(path, "", heads, skip), inl}),
    T.End{Laws.tb.set(path, "", rows, T.VPair{k, v} <> Laws.tb.rows(path, rows)), "",
      Laws.dk.heads(path, "", heads, skip)},
    dk.walk(path, k, rows, v, [], "", heads, inl, skip, eo),
    Equal.trans(T.End,
      T.tree.leaf(k, T.Tw{Laws.tb.rows(path, rows), T.JPut{v}, nav.frs(path, "", rows, []), "",
        Laws.tb.join(path, ""), Laws.dk.heads(path, "", heads, skip), inl}),
      T.tree.rebuild(nav.frs(path, "", rows, []), T.VPair{k, v} <> Laws.tb.rows(path, rows), "",
        Laws.dk.heads(path, "", heads, skip)),
      T.End{Laws.tb.set(path, "", rows, T.VPair{k, v} <> Laws.tb.rows(path, rows)), "",
        Laws.dk.heads(path, "", heads, skip)},
      Equal.cong(T.Hit, T.End,
        hh => T.tree.leaf.put(hh, k, Laws.tb.rows(path, rows), v, nav.frs(path, "", rows, []), "",
          Laws.dk.heads(path, "", heads, skip)),
        T.get(Laws.tb.rows(path, rows), k), T.Miss{}, em),
      nav.rebuild(path, "", rows, [], T.VPair{k, v} <> Laws.tb.rows(path, rows), "",
        Laws.dk.heads(path, "", heads, skip), dk.tb(path, "", rows, heads, skip, eo))))

# WP-K3: the whole key/value line. After `=`, " 1" and a newline read the
# value, and the newline that ends it runs the put's walk along the current
# table and the key's parts; the laws take that walk as a premise or, with
# dotted_put_at_head, discharge it.

# a list reversed twice is itself
def kv.rr(
  +xs: List<&2, String>
) -> {List.reverse(&2, String, List.reverse(&2, String, xs)) == xs : List<&2, String>}:
  Equal.trans(List<&2, String>,
    List.reverse.go(&2, String, List.reverse.go(&2, String, xs, []), []),
    List.append(&2, String, xs, []),
    xs,
    wh.rr(xs, [], []),
    wh.lnil(xs))

# the put's walk of the value 1 along the path, from the table here, returns
# these rows and definitions
def kv.Walk(
  path: List<&2, String>,
  rows: List<&2, T.Val>,
  heads: List<&2, String>,
  here: List<&2, String>,
  rows2: List<&2, T.Val>,
  heads2: List<&2, String>
) -> Type:
  {T.tree.walk(path, T.Tw{rows, T.JPut{Laws.one()}, [], "", "", heads, False{}}, T.path.len(here, 0))
    == T.End{rows2, "", heads2} : T.End}

# " 1" and a newline after `=`: the value is put by the walk, and the next line
# starts in the same table
def kv.line(
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +arrtab: Bool,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +rest: String,
  ew: kv.Walk(T.path.cat(here, parts), rows, heads, here, rows2, heads2)
) -> {T.doc.read(SCon{' ', SCon{'1', SCon{'\n', rest}}}, T.MScan{Laws.kb.val(rows, heads, here, parts, bk, qk,
  arrtab)}) == T.doc.read(rest, T.MScan{Laws.hb.line(rows2, heads2, here, bk, qk, arrtab)}) : T.Doc}:
  Equal.cong(T.End, T.Doc,
    en => T.doc.read(rest, T.MScan{T.read.once2(T.bare.line.go(T.take.root(en, here, bk, qk, 0, 0, arrtab,
      False{})))}),
    T.tree.walk(T.path.cat(here, parts), T.Tw{rows, T.JPut{Laws.one()}, [], "", "", heads, False{}},
      T.path.len(here, 0)),
    T.End{rows2, "", heads2}, ew)

# the walk the line runs is along here and the key's names
def kv.walk(
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +names: List<&2, String>,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  ew: kv.Walk(List.append(&2, String, here, names), rows, heads, here, rows2, heads2)
) -> kv.Walk(T.path.cat(here, List.reverse(&2, String, names)), rows, heads, here, rows2, heads2):
  Equal.trans(T.End,
    T.tree.walk(List.append(&2, String, here, List.reverse(&2, String, List.reverse(&2, String, names))),
      T.Tw{rows, T.JPut{Laws.one()}, [], "", "", heads, False{}}, T.path.len(here, 0)),
    T.tree.walk(List.append(&2, String, here, names), T.Tw{rows, T.JPut{Laws.one()}, [], "", "", heads,
      False{}}, T.path.len(here, 0)),
    T.End{rows2, "", heads2},
    Equal.cong(List<&2, String>, T.End, xs => T.tree.walk(List.append(&2, String, here, xs), T.Tw{rows,
      T.JPut{Laws.one()}, [], "", "", heads, False{}}, T.path.len(here, 0)),
      List.reverse(&2, String, List.reverse(&2, String, names)), names, kv.rr(names)),
    ew)

def Laws.dotted_key_pair_reads_back(
  ds,
  last,
  ok,
  g,
  rows,
  heads,
  here,
  back,
  qkind,
  arrtab,
  rows2,
  heads2,
  ew,
  rest,
  goal,
  ih
):
  Laws.dotted_key_reads_back(ds, last, ok, g, rows, heads, here, back, qkind, arrtab, String.append(" 1\n", rest),
    goal,
    +bk => +qk => Equal.trans(T.Doc,
      T.doc.read(String.append(" 1\n", rest), T.MScan{Laws.kb.val(rows, heads, here, List.reverse(&2, String,
        Laws.dk.names(ds, last)), bk, qk, arrtab)}),
      T.doc.read(rest, T.MScan{Laws.hb.line(rows2, heads2, here, bk, qk, arrtab)}),
      goal,
      kv.line(rows, heads, here, List.reverse(&2, String, Laws.dk.names(ds, last)), bk, qk, arrtab, rows2,
        heads2, rest, kv.walk(rows, heads, here, Laws.dk.names(ds, last), rows2, heads2, ew)),
      ih(bk, qk)))

# appending lists is associative
def la.assoc(
  xs: List<&2, String>,
  +ys: List<&2, String>,
  +zs: List<&2, String>
) -> {List.append(&2, String, List.append(&2, String, xs, ys), zs)
  == List.append(&2, String, xs, List.append(&2, String, ys, zs)) : List<&2, String>}:
  match xs:
    case []:
      {==}
    case +xx <> rest:
      Equal.cong(List<&2, String>, List<&2, String>, tt => xx <> tt,
        List.append(&2, String, List.append(&2, String, rest, ys), zs),
        List.append(&2, String, rest, List.append(&2, String, ys, zs)), la.assoc(rest, ys, zs))

# a dotted key's names are the names a dot follows, then the last
def dk.split(
  ds: List<&2, Laws.Dot>,
  +last: Laws.Seg
) -> {Laws.dk.names(ds, last) == List.append(&2, String, Laws.dk.init(ds), [Laws.seg.name(last)])
  : List<&2, String>}:
  match ds:
    case []:
      {==}
    case Laws.Dot{+sg, _g1, _g2} <> rest:
      Equal.cong(List<&2, String>, List<&2, String>, tt => Laws.seg.name(sg) <> tt, Laws.dk.names(rest, last),
        List.append(&2, String, Laws.dk.init(rest), [Laws.seg.name(last)]), dk.split(rest, last))

# so the walk's path is here and the names a dot follows, then the last
def dk.path(
  +here: List<&2, String>,
  +ds: List<&2, Laws.Dot>,
  +last: Laws.Seg
) -> {List.append(&2, String, here, Laws.dk.names(ds, last)) == List.append(&2, String, List.append(&2,
  String, here, Laws.dk.init(ds)), [Laws.seg.name(last)]) : List<&2, String>}:
  Equal.trans(List<&2, String>,
    List.append(&2, String, here, Laws.dk.names(ds, last)),
    List.append(&2, String, here, List.append(&2, String, Laws.dk.init(ds), [Laws.seg.name(last)])),
    List.append(&2, String, List.append(&2, String, here, Laws.dk.init(ds)), [Laws.seg.name(last)]),
    Equal.cong(List<&2, String>, List<&2, String>, xs => List.append(&2, String, here, xs),
      Laws.dk.names(ds, last), List.append(&2, String, Laws.dk.init(ds), [Laws.seg.name(last)]),
      dk.split(ds, last)),
    Equal.sym(List<&2, String>,
      List.append(&2, String, List.append(&2, String, here, Laws.dk.init(ds)), [Laws.seg.name(last)]),
      List.append(&2, String, here, List.append(&2, String, Laws.dk.init(ds), [Laws.seg.name(last)])),
      la.assoc(here, Laws.dk.init(ds), [Laws.seg.name(last)])))

def Laws.dotted_key_pair_puts_value(ds, last, ok, g, rows, heads, here, eo, em, back, qkind, arrtab, rest, goal, ih):
  Laws.dotted_key_pair_reads_back(ds, last, ok, g, rows, heads, here, back, qkind, arrtab,
    Laws.tb.set(List.append(&2, String, here, Laws.dk.init(ds)), "", rows, T.VPair{Laws.seg.name(last), Laws.one()}
      <> Laws.tb.rows(List.append(&2, String, here, Laws.dk.init(ds)), rows)),
    Laws.dk.heads(List.append(&2, String, here, Laws.dk.init(ds)), "", heads, T.path.len(here, 0)),
    Equal.trans(T.End,
      T.tree.walk(List.append(&2, String, here, Laws.dk.names(ds, last)), T.Tw{rows, T.JPut{Laws.one()}, [], "",
        "", heads, False{}}, T.path.len(here, 0)),
      T.tree.walk(List.append(&2, String, List.append(&2, String, here, Laws.dk.init(ds)), [Laws.seg.name(last)]),
        T.Tw{rows, T.JPut{Laws.one()}, [], "", "", heads, False{}}, T.path.len(here, 0)),
      T.End{Laws.tb.set(List.append(&2, String, here, Laws.dk.init(ds)), "", rows, T.VPair{Laws.seg.name(last),
        Laws.one()} <> Laws.tb.rows(List.append(&2, String, here, Laws.dk.init(ds)), rows)), "",
        Laws.dk.heads(List.append(&2, String, here, Laws.dk.init(ds)), "", heads, T.path.len(here, 0))},
      Equal.cong(List<&2, String>, T.End, xs => T.tree.walk(xs, T.Tw{rows, T.JPut{Laws.one()}, [], "", "", heads,
        False{}}, T.path.len(here, 0)),
        List.append(&2, String, here, Laws.dk.names(ds, last)),
        List.append(&2, String, List.append(&2, String, here, Laws.dk.init(ds)), [Laws.seg.name(last)]),
        dk.path(here, ds, last)),
      Laws.dotted_put_at_head(List.append(&2, String, here, Laws.dk.init(ds)), Laws.seg.name(last), Laws.one(),
        rows, heads, T.path.len(here, 0), False{}, eo, em)),
    rest, goal, ih)

# WP-K3: a document of one key/value line. Its first character goes through
# the byte-order-mark check; for a segment's first character that is the
# line-start step. The walk from the empty root misses every name, so each
# segment makes a new table, and at finds the value through them.

# a document's first segment starts as one at the start of a line does
def kl.start1(
  sg: Laws.Seg,
  +xs: String,
  +eo: {Laws.seg.ok(sg) == True{} : Bool}
) -> {T.doc.read(String.append(Laws.seg.text(sg), xs), T.MScan{T.st.start()})
  == T.doc.read(String.append(Laws.seg.text(sg), xs), T.MScan{Laws.hb.line([], [], [], T.LTop{}, T.QBasic{},
    False{})}) : T.Doc}:
  match sg:
    case Laws.Seg{sp, +name}:
      match sp:
        case Laws.SpBare{}:
          match name:
            case SNil{}:
              Eq.bit.absurd(&2, {T.doc.read(String.append(SNil{}, xs), T.MScan{T.st.start()})
                == T.doc.read(String.append(SNil{}, xs), T.MScan{Laws.hb.line([], [], [], T.LTop{}, T.QBasic{},
                False{})}) : T.Doc}, eo)
            case SCon{hh, +tt}:
              match hh:
                case Chr{+xx}:
                  Equal.trans(T.Doc,
                    T.doc.read(String.append(tt, xs), T.doc.scan(T.st.start(), Chr{xx})),
                    T.doc.read(String.append(tt, xs), T.MScan{ky([Chr{xx}])}),
                    T.doc.read(String.append(tt, xs), T.doc.scan(Laws.hb.line([], [], [], T.LTop{}, T.QBasic{},
                      False{}), Chr{xx})),
                    Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, xs), md),
                      T.doc.scan(T.st.start(), Chr{xx}), T.MScan{ky([Chr{xx}])},
                      key.first(xx, ball.head(T.bare.at(Chr{xx}), String.to_list(tt), eo))),
                    Equal.sym(T.Doc,
                      T.doc.read(String.append(tt, xs), T.doc.scan(Laws.hb.line([], [], [], T.LTop{}, T.QBasic{},
                        False{}), Chr{xx})),
                      T.doc.read(String.append(tt, xs), T.MScan{ky([Chr{xx}])}),
                      Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, xs), md),
                        T.doc.scan(Laws.hb.line([], [], [], T.LTop{}, T.QBasic{}, False{}), Chr{xx}),
                        T.MScan{ky([Chr{xx}])},
                        kl.b1(False{}, [], [], [], [], T.LTop{}, T.QBasic{}, False{}, xx,
                          ball.head(T.bare.at(Chr{xx}), String.to_list(tt), eo)))))
        case Laws.SpBasic{}:
          {==}
        case Laws.SpLit{}:
          {==}

# and so does a dotted key's
def kl.start(
  ds: List<&2, Laws.Dot>,
  +last: Laws.Seg,
  +tail: String,
  eo: {Laws.dk.ok(ds, last) == True{} : Bool}
) -> {T.doc.read(Laws.dk.text(ds, last, tail), T.MScan{T.st.start()})
  == T.doc.read(Laws.dk.text(ds, last, tail), T.MScan{Laws.hb.line([], [], [], T.LTop{}, T.QBasic{}, False{})})
  : T.Doc}:
  match ds:
    case []:
      kl.start1(last, tail, eo)
    case Laws.Dot{+sg, +g1, +g2} <> +rest:
      kl.start1(sg, String.append(Laws.gap(g1), SCon{'.', String.append(Laws.gap(g2), Laws.dk.text(rest, last,
        tail))}), Eq.and.left(Laws.seg.ok(sg), Laws.dk.ok(rest, last), eo))

# from the empty root every step makes a new table
def dk.open.nil(
  path: List<&2, String>,
  +pre: String,
  +heads: List<&2, String>
) -> {Laws.dk.open(path, pre, [], heads, 0) == True{} : Bool}:
  match path:
    case []:
      {==}
    case +seg <> rest:
      dk.open.nil(rest, T.tree.pre(pre, seg), Laws.dk.mark(True{}, T.tree.pre(pre, seg), heads))

# and the table at the end is empty
def tb.rows.nil(path: List<&2, String>) -> {Laws.tb.rows(path, []) == [] : List<&2, T.Val>}:
  match path:
    case []:
      {==}
    case _seg <> rest:
      tb.rows.nil(rest)

# a longer path goes on in the rows of the table get found
def ka.hd(
  rest: List<&2, String>,
  +kk: String,
  +sub: List<&2, T.Val>,
  +pp: String
) -> {T.at.step(List.append(&2, String, rest, [kk]), T.Found{T.VHead{pp, sub}})
  == T.at(sub, List.append(&2, String, rest, [kk])) : T.Hit}:
  match rest:
    case []:
      {==}
    case _r <> _rr:
      {==}

# at finds the value through the tables made from the empty root, for a
# value sealing leaves alone
def ka.nest(
  path: List<&2, String>,
  +kk: String,
  +pre: String,
  +v: T.Val,
  es: {T.rows.seal([T.VPair{kk, v}]) == [T.VPair{kk, v}] : List<&2, T.Val>}
) -> {T.at(T.rows.seal(Laws.tb.set(path, pre, [], [T.VPair{kk, v}])), List.append(&2, String, path, [kk]))
  == T.Found{v} : T.Hit}:
  match path:
    case []:
      Equal.trans(T.Hit, T.get(T.rows.seal([T.VPair{kk, v}]), kk), T.get([T.VPair{kk, v}], kk), T.Found{v},
        Equal.cong(List<&2, T.Val>, T.Hit, xs => T.get(xs, kk), T.rows.seal([T.VPair{kk, v}]), [T.VPair{kk, v}],
          es),
        Laws.get_first(kk, v, []))
    case +seg <> +rest:
      Equal.trans(T.Hit,
        T.at.step(List.append(&2, String, rest, [kk]), T.get([T.VPair{seg, T.VHead{T.tree.pre(pre, seg),
          T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg), [], [T.VPair{kk, v}]))}}], seg)),
        T.at.step(List.append(&2, String, rest, [kk]), T.Found{T.VHead{T.tree.pre(pre, seg),
          T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg), [], [T.VPair{kk, v}]))}}),
        T.Found{v},
        Equal.cong(T.Hit, T.Hit, hh => T.at.step(List.append(&2, String, rest, [kk]), hh),
          T.get([T.VPair{seg, T.VHead{T.tree.pre(pre, seg), T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg),
            [], [T.VPair{kk, v}]))}}], seg),
          T.Found{T.VHead{T.tree.pre(pre, seg), T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg), [],
            [T.VPair{kk, v}]))}},
          Laws.get_first(seg, T.VHead{T.tree.pre(pre, seg), T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg),
            [], [T.VPair{kk, v}]))}, [])),
        Equal.trans(T.Hit,
          T.at.step(List.append(&2, String, rest, [kk]), T.Found{T.VHead{T.tree.pre(pre, seg),
            T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg), [], [T.VPair{kk, v}]))}}),
          T.at(T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg), [], [T.VPair{kk, v}])),
            List.append(&2, String, rest, [kk])),
          T.Found{v},
          ka.hd(rest, kk, T.rows.seal(Laws.tb.set(rest, T.tree.pre(pre, seg), [], [T.VPair{kk, v}])),
            T.tree.pre(pre, seg)),
          ka.nest(rest, kk, T.tree.pre(pre, seg), v, es)))

def Laws.dotted_key_line_reads_back(ds, last, ok, g):
  Equal.trans(T.Doc,
    T.doc.read(Laws.dk.text(ds, last, String.append(Laws.gap(g), "= 1\n")), T.MScan{T.st.start()}),
    T.doc.read(Laws.dk.text(ds, last, String.append(Laws.gap(g), "= 1\n")), T.MScan{Laws.hb.line([], [], [],
      T.LTop{}, T.QBasic{}, False{})}),
    T.Doc{"", T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), Laws.one()}]))},
    kl.start(ds, last, String.append(Laws.gap(g), "= 1\n"), ok),
    Laws.dotted_key_pair_puts_value(ds, last, ok, g, [], [], [], dk.open.nil(Laws.dk.init(ds), "", []),
      Equal.cong(List<&2, T.Val>, T.Hit, xs => T.get(xs, Laws.seg.name(last)), Laws.tb.rows(Laws.dk.init(ds), []),
        [], tb.rows.nil(Laws.dk.init(ds))),
      T.LTop{}, T.QBasic{}, False{}, "",
      T.Doc{"", T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), Laws.one()}]))},
      +_bk => +_qk => Equal.cong(List<&2, T.Val>, T.Doc,
        xs => T.Doc{"", T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], T.VPair{Laws.seg.name(last), Laws.one()}
          <> xs))}, Laws.tb.rows(Laws.dk.init(ds), []), [], tb.rows.nil(Laws.dk.init(ds)))))

def Laws.dotted_key_line_found_by_at(ds, last, ok, g):
  Equal.trans(T.Hit,
    T.at(T.root(T.parse(Laws.dk.text(ds, last, String.append(Laws.gap(g), "= 1\n")))), Laws.dk.names(ds, last)),
    T.at(T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), Laws.one()}])),
      Laws.dk.names(ds, last)),
    T.Found{Laws.one()},
    Equal.cong(T.Doc, T.Hit, dd => T.at(T.root(dd), Laws.dk.names(ds, last)),
      T.parse(Laws.dk.text(ds, last, String.append(Laws.gap(g), "= 1\n"))),
      T.Doc{"", T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), Laws.one()}]))},
      Laws.dotted_key_line_reads_back(ds, last, ok, g)),
    Equal.trans(T.Hit,
      T.at(T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), Laws.one()}])),
        Laws.dk.names(ds, last)),
      T.at(T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), Laws.one()}])),
        List.append(&2, String, Laws.dk.init(ds), [Laws.seg.name(last)])),
      T.Found{Laws.one()},
      Equal.cong(List<&2, String>, T.Hit, ns => T.at(T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [],
        [T.VPair{Laws.seg.name(last), Laws.one()}])), ns), Laws.dk.names(ds, last),
        List.append(&2, String, Laws.dk.init(ds), [Laws.seg.name(last)]), dk.split(ds, last)),
      ka.nest(Laws.dk.init(ds), Laws.seg.name(last), "", Laws.one(), {==})))

# WP-K3: header segments spelled any way, with blank space. Blank space after
# the bracket leaves the header waiting for a segment in LHeadDot, as after a
# dot; a bare segment is read by WP-H's wh.b1 and wh.bbody and ended by a
# blank (to LHeadGap), a dot or the bracket; a basic one by WP0's qs and a
# literal one by ql at hd = True, each closing into LHeadGap, where blank
# space stays until a dot or the bracket. The states are WP-H's wh.st.

# whether there is any blank space
def hg.nz(gs: List<&2, Bool>) -> Bool:
  match gs:
    case []:
      False{}
    case _t <> _r:
      True{}

# blank space after a dot stays in LHeadDot
def hg.dgap(
  gs: List<&2, Bool>,
  +rr: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{wh.st(rows, heads, here, parts, [], T.LHeadDot{},
  back, qkind, arrtab)}) == T.doc.read(rr, T.MScan{wh.st(rows, heads, here, parts, [], T.LHeadDot{}, back,
  qkind, arrtab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          hg.dgap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)
        case False{}:
          hg.dgap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)

# and after a segment in LHeadGap
def hg.hgap(
  gs: List<&2, Bool>,
  +rr: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{wh.st(rows, heads, here, parts, [], T.LHeadGap{},
  back, qkind, arrtab)}) == T.doc.read(rr, T.MScan{wh.st(rows, heads, here, parts, [], T.LHeadGap{}, back,
  qkind, arrtab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          hg.hgap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)
        case False{}:
          hg.hgap(rest, rr, rows, heads, here, parts, back, qkind, arrtab)

# blank space right after the bracket waits for the first segment in LHeadDot
def hg.lead(
  g0: List<&2, Bool>,
  +xx: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.read(String.append(Laws.gap(g0), xx), T.MScan{wh.st(rows, heads, here, [], [], T.LHead{}, back, qkind,
  arrtab)}) == T.doc.read(xx, T.MScan{wh.st(rows, heads, here, wh.ps(hg.nz(g0), []), [], wh.lex0(hg.nz(g0)), back,
  qkind, arrtab)}) : T.Doc}:
  match g0:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          hg.dgap(rest, xx, rows, heads, here, [], back, qkind, arrtab)
        case False{}:
          hg.dgap(rest, xx, rows, heads, here, [], back, qkind, arrtab)

# a dot or the bracket after a segment's blank space
def hg.gdl(
  cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String
) -> {T.doc.read(SCon{wh.dl(cl), rest}, T.MScan{wh.st(rows, heads, here, parts, [], T.LHeadGap{}, back, qkind,
  arrtab)}) == T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, parts, back, qkind, arrtab)}) : T.Doc}:
  match cl:
    case False{}:
      {==}
    case True{}:
      {==}

# blank space, then a dot or the bracket, after a segment pushed onto parts
def hg.gtail(
  gs: List<&2, Bool>,
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here, parts, [],
  T.LHeadGap{}, back, qkind, arrtab)}) == T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, parts, back,
  qkind, arrtab)}) : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here, parts, [],
      T.LHeadGap{}, back, qkind, arrtab)}),
    T.doc.read(SCon{wh.dl(cl), rest}, T.MScan{wh.st(rows, heads, here, parts, [], T.LHeadGap{}, back, qkind,
      arrtab)}),
    T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, parts, back, qkind, arrtab)}),
    hg.hgap(gs, SCon{wh.dl(cl), rest}, rows, heads, here, parts, back, qkind, arrtab),
    hg.gdl(cl, rows, heads, here, parts, back, qkind, arrtab, rest))

# a blank ends an open bare segment: it is pushed, and the header waits in
# LHeadGap
def hg.bsp(
  tab: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rr: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(SCon{Laws.blank_char(tab), rr}, T.MScan{wh.st(rows, heads, here, parts, bf, T.LHead{}, back,
  qkind, arrtab)}) == T.doc.read(rr, T.MScan{wh.st(rows, heads, here, T.buf.str(bf) <> parts, [], T.LHeadGap{},
  back, qkind, arrtab)}) : T.Doc}:
  match tab:
    case True{}:
      Equal.cong(Bool, T.Doc, bt => T.doc.read(rr, T.MScan{T.read.once2(T.lex.head.gap.go(bt, wh.st(rows, heads,
        here, parts, bf, T.LHead{}, back, qkind, arrtab)))}), List.is_empty(&2, Char, bf), False{}, full)
    case False{}:
      Equal.cong(Bool, T.Doc, bt => T.doc.read(rr, T.MScan{T.read.once2(T.lex.head.gap.go(bt, wh.st(rows, heads,
        here, parts, bf, T.LHead{}, back, qkind, arrtab)))}), List.is_empty(&2, Char, bf), False{}, full)

# blank space and a dot or the bracket after an open bare segment push it
def hg.bend(
  gs: List<&2, Bool>,
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here, parts, bf,
  T.LHead{}, back, qkind, arrtab)}) == T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here,
  T.buf.str(bf) <> parts, back, qkind, arrtab)}) : T.Doc}:
  match gs:
    case []:
      wh.bdl(cl, rows, heads, here, parts, bf, back, qkind, arrtab, rest, full)
    case tab <> +gr:
      Equal.trans(T.Doc,
        T.doc.read(SCon{Laws.blank_char(tab), String.append(Laws.gap(gr), SCon{wh.dl(cl), rest})},
          T.MScan{wh.st(rows, heads, here, parts, bf, T.LHead{}, back, qkind, arrtab)}),
        T.doc.read(String.append(Laws.gap(gr), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
          T.buf.str(bf) <> parts, [], T.LHeadGap{}, back, qkind, arrtab)}),
        T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, T.buf.str(bf) <> parts, back, qkind, arrtab)}),
        hg.bsp(tab, rows, heads, here, parts, bf, back, qkind, arrtab, String.append(Laws.gap(gr),
          SCon{wh.dl(cl), rest}), full),
        hg.gtail(gr, cl, rows, heads, here, T.buf.str(bf) <> parts, back, qkind, arrtab, rest))

# the segment's buffer reads as its name, and the rest is read
def hg.nm(
  +nm: String,
  +bf: List<&2, Char>,
  en: {T.buf.str(bf) == nm : String},
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: wh.Then(cl, rows, heads, here, nm <> parts, arrtab, rest, goal)
) -> {T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, T.buf.str(bf) <> parts, bk, qk, arrtab)}) == goal
  : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, T.buf.str(bf) <> parts, bk, qk, arrtab)}),
    T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, nm <> parts, bk, qk, arrtab)}),
    goal,
    Equal.cong(String, T.Doc, xx => T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, xx <> parts, bk, qk,
      arrtab)}), T.buf.str(bf), nm, en),
    ih(bk, qk))

# after a quoted segment's closing quote: blank space, a dot or the bracket,
# and the rest
def hg.fin(
  +nm: String,
  +bf: List<&2, Char>,
  en: {T.buf.str(bf) == nm : String},
  +gs: List<&2, Bool>,
  +cl: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: wh.Then(cl, rows, heads, here, nm <> parts, arrtab, rest, goal)
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
  T.buf.str(bf) <> parts, [], T.LHeadGap{}, bk, qk, arrtab)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
      T.buf.str(bf) <> parts, [], T.LHeadGap{}, bk, qk, arrtab)}),
    T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, T.buf.str(bf) <> parts, bk, qk, arrtab)}),
    goal,
    hg.gtail(gs, cl, rows, heads, here, T.buf.str(bf) <> parts, bk, qk, arrtab, rest),
    hg.nm(nm, bf, en, cl, rows, heads, here, parts, bk, qk, arrtab, rest, goal, ih))

# a bare header segment, its blank space and a dot or the bracket
def hg.bseg(
  +xx: U32,
  +tt: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  +ee: {T.bare.all.step(T.bare.at(Chr{xx}), _u => T.bare.all(String.to_list(tt))) == True{} : Bool},
  ih: wh.Then(cl, rows, heads, here, SCon{Chr{xx}, tt} <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(SCon{Chr{xx}, tt}, String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})),
  T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})), T.doc.scan(wh.st(rows,
      heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), Chr{xx})),
    T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})), T.MScan{wh.st(rows,
      heads, here, wh.ps(dt, parts), [Chr{xx}], T.LHead{}, back, qkind, arrtab)}),
    goal,
    Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{wh.dl(cl),
      rest})), md),
      T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), Chr{xx}),
      T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [Chr{xx}], T.LHead{}, back, qkind, arrtab)},
      wh.b1(dt, rows, heads, here, parts, back, qkind, arrtab, xx,
        ball.head(T.bare.at(Chr{xx}), String.to_list(tt), ee))),
    Equal.trans(T.Doc,
      T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})), T.MScan{wh.st(rows,
        heads, here, wh.ps(dt, parts), [Chr{xx}], T.LHead{}, back, qkind, arrtab)}),
      T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
        wh.ps(dt, parts), rev.onto(tt, [Chr{xx}]), T.LHead{}, back, qkind, arrtab)}),
      goal,
      wh.bbody(tt, String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), rows, heads, here, wh.ps(dt, parts),
        Chr{xx}, [], back, qkind, arrtab, ball.tail(T.bare.at(Chr{xx}), String.to_list(tt), ee)),
      Equal.trans(T.Doc,
        T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
          wh.ps(dt, parts), rev.onto(tt, [Chr{xx}]), T.LHead{}, back, qkind, arrtab)}),
        T.doc.read(rest, T.MScan{wh.aft(cl, rows, heads, here, T.buf.str(rev.onto(tt, [Chr{xx}])) <>
          wh.ps(dt, parts), back, qkind, arrtab)}),
        goal,
        hg.bend(gs, cl, rows, heads, here, wh.ps(dt, parts), rev.onto(tt, [Chr{xx}]), back, qkind, arrtab, rest,
          rev.full(tt, Chr{xx}, [])),
        hg.nm(SCon{Chr{xx}, tt}, rev.onto(tt, [Chr{xx}]), wh.bname(xx, tt), cl, rows, heads, here,
          wh.ps(dt, parts), back, qkind, arrtab, rest, goal, ih))))

# an apostrophe where a header segment starts opens a literal segment
def hs.lopen(
  dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool
) -> {T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), '\'')
  == T.MScan{ql(True{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])} : T.Mode}:
  match dt:
    case False{}:
      {==}
    case True{}:
      {==}

# a basic header segment, its blank space and a dot or the bracket
def hg.qseg(
  +ss: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: wh.Then(cl, rows, heads, here, ss <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(T.key.basic(ss), String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})),
  T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(T.key.basic(ss), String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})),
      T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab)}),
    T.doc.read(String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs),
      SCon{wh.dl(cl), rest})), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back,
      qkind, arrtab), '"')),
    goal,
    Equal.cong(String, T.Doc, zz => T.doc.read(String.append(zz, String.append(Laws.gap(gs),
      SCon{wh.dl(cl), rest})), T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back,
      qkind, arrtab)}),
      T.key.basic(ss), "\"" ++ Laws.escs(ss) ++ "\"", Laws.basic_escs(ss)),
    Equal.trans(T.Doc,
      T.doc.read(String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs),
        SCon{wh.dl(cl), rest})), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back,
        qkind, arrtab), '"')),
      T.doc.read(String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}),
        T.MScan{qs(True{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [])}),
      goal,
      Equal.trans(T.Doc,
        T.doc.read(String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs),
          SCon{wh.dl(cl), rest})), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt),
          back, qkind, arrtab), '"')),
        T.doc.read(String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{wh.dl(cl),
          rest})}), T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind,
          arrtab), '"')),
        T.doc.read(String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{wh.dl(cl),
          rest})}), T.MScan{qs(True{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [])}),
        Equal.cong(String, T.Doc, zz => T.doc.read(zz, T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts),
          [], wh.lex0(dt), back, qkind, arrtab), '"')),
          String.append(String.append(Laws.escs(ss), "\""), String.append(Laws.gap(gs), SCon{wh.dl(cl),
            rest})),
          String.append(Laws.escs(ss), SCon{'"', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}),
          Eq.append_assoc(Laws.escs(ss), "\"", String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}))),
        Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(Laws.escs(ss), SCon{'"',
          String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}), md),
          T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), '"'),
          T.MScan{qs(True{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [])},
          wh.qopen(dt, rows, heads, here, parts, back, qkind, arrtab))),
      qs.escs(ss, True{}, rows, heads, here, wh.ps(dt, parts), [], arrtab, back, [],
        SCon{'"', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}, goal,
        +bk => Equal.trans(T.Doc,
          T.doc.read(SCon{'"', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}, T.MScan{qs(True{}, rows,
            heads, here, wh.ps(dt, parts), [], arrtab, bk, rev.onto(ss, []))}),
          T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
            T.buf.str(rev.onto(ss, [])) <> wh.ps(dt, parts), [], T.LHeadGap{}, bk, T.QBasic{}, arrtab)}),
          goal,
          {==},
          hg.fin(ss, rev.onto(ss, []), wh.qname(ss), gs, cl, rows, heads, here, wh.ps(dt, parts), bk,
            T.QBasic{}, arrtab, rest, goal, ih)))))

# a literal header segment, its blank space and a dot or the bracket
def hg.lseg(
  +ss: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  el: {Laws.lit.text(ss) == True{} : Bool},
  ih: wh.Then(cl, rows, heads, here, ss <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(SCon{'\'', String.append(ss, "'")}, String.append(Laws.gap(gs),
  SCon{wh.dl(cl), rest})), T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind,
  arrtab)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(String.append(String.append(ss, "'"), String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})),
      T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), '\'')),
    T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}),
      T.MScan{ql(True{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])}),
    goal,
    Equal.trans(T.Doc,
      T.doc.read(String.append(String.append(ss, "'"), String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})),
        T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), '\'')),
      T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}),
        T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), '\'')),
      T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}),
        T.MScan{ql(True{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])}),
      Equal.cong(String, T.Doc, zz => T.doc.read(zz, T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [],
        wh.lex0(dt), back, qkind, arrtab), '\'')),
        String.append(String.append(ss, "'"), String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})),
        String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}),
        Eq.append_assoc(ss, "'", String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}))),
      Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs),
        SCon{wh.dl(cl), rest})}), md),
        T.doc.scan(wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab), '\''),
        T.MScan{ql(True{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])},
        hs.lopen(dt, rows, heads, here, parts, back, qkind, arrtab))),
    Equal.trans(T.Doc,
      T.doc.read(String.append(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}),
        T.MScan{ql(True{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, [])}),
      T.doc.read(SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})},
        T.MScan{ql(True{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, rev.onto(ss, []))}),
      goal,
      ql.body(ss, SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})}, True{}, rows, heads, here,
        wh.ps(dt, parts), arrtab, back, [], el),
      Equal.trans(T.Doc,
        T.doc.read(SCon{'\'', String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})},
          T.MScan{ql(True{}, rows, heads, here, wh.ps(dt, parts), arrtab, back, rev.onto(ss, []))}),
        T.doc.read(String.append(Laws.gap(gs), SCon{wh.dl(cl), rest}), T.MScan{wh.st(rows, heads, here,
          T.buf.str(rev.onto(ss, [])) <> wh.ps(dt, parts), [], T.LHeadGap{}, back, T.QLit{}, arrtab)}),
        goal,
        {==},
        hg.fin(ss, rev.onto(ss, []), wh.qname(ss), gs, cl, rows, heads, here, wh.ps(dt, parts), back,
          T.QLit{}, arrtab, rest, goal, ih))))

# a header segment spelled any way it can be, its blank space and a dot or
# the bracket
def hg.seg(
  sg: Laws.Seg,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.seg.ok(sg) == True{} : Bool},
  ih: wh.Then(cl, rows, heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), arrtab, rest, goal)
) -> {T.doc.read(String.append(Laws.seg.text(sg), String.append(Laws.gap(gs), SCon{wh.dl(cl), rest})),
  T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab)}) == goal : T.Doc}:
  match sg:
    case Laws.Seg{sp, +name}:
      match sp:
        case Laws.SpBare{}:
          match name:
            case SNil{}:
              Eq.bit.absurd(&2, {T.doc.read(String.append(SNil{}, String.append(Laws.gap(gs), SCon{wh.dl(cl),
                rest})), T.MScan{wh.st(rows, heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind,
                arrtab)}) == goal : T.Doc}, eo)
            case SCon{hh, +tt}:
              match hh:
                case Chr{+xx}:
                  hg.bseg(xx, tt, gs, cl, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, eo, ih)
        case Laws.SpBasic{}:
          hg.qseg(name, gs, cl, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, ih)
        case Laws.SpLit{}:
          hg.lseg(name, gs, cl, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, eo, ih)

# a header's segments, then blank space and the bracket: the rest is read
# with every segment pushed onto parts, newest first
def hg.keys(
  ds: List<&2, Laws.Dot>,
  +last: Laws.Seg,
  +g9: List<&2, Bool>,
  +dt: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +arrtab: Bool,
  +rest: String,
  +goal: T.Doc,
  +eo: {Laws.dk.ok(ds, last) == True{} : Bool},
  ih: wh.Then(True{}, rows, heads, here, kl.acc(ds, last, dt, parts), arrtab, rest, goal)
) -> {T.doc.read(Laws.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', rest})), T.MScan{wh.st(rows,
  heads, here, wh.ps(dt, parts), [], wh.lex0(dt), back, qkind, arrtab)}) == goal : T.Doc}:
  match ds:
    case []:
      hg.seg(last, g9, True{}, dt, rows, heads, here, parts, back, qkind, arrtab, rest, goal, eo, ih)
    case Laws.Dot{+sg, g1, +g2} <> +dr:
      hg.seg(sg, g1, False{}, dt, rows, heads, here, parts, back, qkind, arrtab,
        String.append(Laws.gap(g2), Laws.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']', rest}))), goal,
        Eq.and.left(Laws.seg.ok(sg), Laws.dk.ok(dr, last), eo),
        +bk => +qk => Equal.trans(T.Doc,
          T.doc.read(String.append(Laws.gap(g2), Laws.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']',
            rest}))), T.MScan{wh.st(rows, heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), [],
            T.LHeadDot{}, bk, qk, arrtab)}),
          T.doc.read(Laws.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']', rest})), T.MScan{wh.st(rows,
            heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), [], T.LHeadDot{}, bk, qk, arrtab)}),
          goal,
          hg.dgap(g2, Laws.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']', rest})), rows, heads, here,
            Laws.seg.name(sg) <> wh.ps(dt, parts), bk, qk, arrtab),
          hg.keys(dr, last, g9, True{}, rows, heads, here, Laws.seg.name(sg) <> wh.ps(dt, parts), bk, qk, arrtab,
            rest, goal, Eq.and.right(Laws.seg.ok(sg), Laws.dk.ok(dr, last), eo), ih)))

# the names pushed are never none
def hg.ne(
  ds: List<&2, Laws.Dot>,
  +last: Laws.Seg,
  +acc: List<&2, String>
) -> {List.is_empty(&2, String, List.reverse.go(&2, String, Laws.dk.names(ds, last), acc)) == False{} : Bool}:
  match ds:
    case []:
      {==}
    case Laws.Dot{sg, _g1, _g2} <> rest:
      hg.ne(rest, last, Laws.seg.name(sg) <> acc)

# no segment before the first
def hg.ps0(dt: Bool) -> {wh.ps(dt, []) == [] : List<&2, String>}:
  match dt:
    case False{}:
      {==}
    case True{}:
      {==}

# so the names pushed, reversed, are the header's path
def hg.path(
  +dt: Bool,
  +ds: List<&2, Laws.Dot>,
  +last: Laws.Seg
) -> {List.reverse(&2, String, List.reverse.go(&2, String, Laws.dk.names(ds, last), wh.ps(dt, [])))
  == Laws.hd.path(ds, last) : List<&2, String>}:
  Equal.trans(List<&2, String>,
    List.reverse(&2, String, List.reverse.go(&2, String, Laws.dk.names(ds, last), wh.ps(dt, []))),
    List.reverse(&2, String, List.reverse(&2, String, Laws.dk.names(ds, last))),
    Laws.hd.path(ds, last),
    Equal.cong(List<&2, String>, List<&2, String>, xs => List.reverse(&2, String, List.reverse.go(&2, String,
      Laws.dk.names(ds, last), xs)), wh.ps(dt, []), [], hg.ps0(dt)),
    Equal.trans(List<&2, String>,
      List.reverse(&2, String, List.reverse(&2, String, Laws.dk.names(ds, last))),
      Laws.dk.names(ds, last),
      Laws.hd.path(ds, last),
      kv.rr(Laws.dk.names(ds, last)),
      dk.split(ds, last)))

# after the path and the bracket: the header's walk, and the next line
def hg.end(
  arr: Bool,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +dt: Bool,
  +ds: List<&2, Laws.Dot>,
  +last: Laws.Seg,
  +bk: T.Lex,
  +qk: T.QKind,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +rest: String,
  +goal: T.Doc,
  ew: wh.Walk(arr, Laws.hd.path(ds, last), rows, heads, rows2, heads2),
  ih: wh.Line(rows2, heads2, Laws.hd.path(ds, last), rest, goal)
) -> {T.doc.read(wh.tail(arr, rest), T.MScan{wh.aft(True{}, rows, heads, here, kl.acc(ds, last, dt, []), bk, qk,
  arr)}) == goal : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(wh.tail(arr, rest), T.MScan{wh.aft(True{}, rows, heads, here, kl.acc(ds, last, dt, []), bk, qk,
      arr)}),
    T.doc.read(rest, T.MScan{Laws.hb.line(rows2, heads2, Laws.hd.path(ds, last), bk, qk, False{})}),
    goal,
    wh.fin(arr, rows, heads, here, kl.acc(ds, last, dt, []), bk, qk, Laws.hd.path(ds, last), rows2, heads2, rest,
      hg.ne(ds, last, wh.ps(dt, [])), hg.path(dt, ds, last), ew),
    ih(bk, qk))

# a whole header line, from the start of a line
def hg.core(
  arr: Bool,
  +g0: List<&2, Bool>,
  +ds: List<&2, Laws.Dot>,
  +last: Laws.Seg,
  +g9: List<&2, Bool>,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +back: T.Lex,
  +qkind: T.QKind,
  +a0: Bool,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +rest: String,
  +goal: T.Doc,
  +eo: {Laws.dk.ok(ds, last) == True{} : Bool},
  ew: wh.Walk(arr, Laws.hd.path(ds, last), rows, heads, rows2, heads2),
  ih: wh.Line(rows2, heads2, Laws.hd.path(ds, last), rest, goal)
) -> {T.doc.read(Laws.hd.line(arr, g0, ds, last, g9, rest), T.MScan{Laws.hb.line(rows, heads, here, back, qkind,
  a0)}) == goal : T.Doc}:
  match arr:
    case False{}:
      Equal.trans(T.Doc,
        T.doc.read(String.append(Laws.gap(g0), Laws.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']',
          wh.tail(False{}, rest)}))), T.MScan{wh.st(rows, heads, here, [], [], T.LHead{}, back, qkind, False{})}),
        T.doc.read(Laws.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', wh.tail(False{}, rest)})),
          T.MScan{wh.st(rows, heads, here, wh.ps(hg.nz(g0), []), [], wh.lex0(hg.nz(g0)), back, qkind, False{})}),
        goal,
        hg.lead(g0, Laws.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', wh.tail(False{}, rest)})), rows,
          heads, here, back, qkind, False{}),
        hg.keys(ds, last, g9, hg.nz(g0), rows, heads, here, [], back, qkind, False{}, wh.tail(False{}, rest), goal,
          eo, +bk => +qk => hg.end(False{}, rows, heads, here, hg.nz(g0), ds, last, bk, qk, rows2, heads2, rest,
            goal, ew, ih)))
    case True{}:
      Equal.trans(T.Doc,
        T.doc.read(String.append(Laws.gap(g0), Laws.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']',
          wh.tail(True{}, rest)}))), T.MScan{wh.st(rows, heads, here, [], [], T.LHead{}, back, qkind, True{})}),
        T.doc.read(Laws.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', wh.tail(True{}, rest)})),
          T.MScan{wh.st(rows, heads, here, wh.ps(hg.nz(g0), []), [], wh.lex0(hg.nz(g0)), back, qkind, True{})}),
        goal,
        hg.lead(g0, Laws.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', wh.tail(True{}, rest)})), rows,
          heads, here, back, qkind, True{}),
        hg.keys(ds, last, g9, hg.nz(g0), rows, heads, here, [], back, qkind, True{}, wh.tail(True{}, rest), goal,
          eo, +bk => +qk => hg.end(True{}, rows, heads, here, hg.nz(g0), ds, last, bk, qk, rows2, heads2, rest,
            goal, ew, ih)))

def Laws.header_segments_read_back(
  arr,
  g0,
  ds,
  last,
  ok,
  g9,
  rows,
  heads,
  here,
  back,
  qkind,
  arrtab,
  rows2,
  heads2,
  ew,
  rest,
  goal,
  ih
):
  hg.core(arr, g0, ds, last, g9, rows, heads, here, back, qkind, arrtab, rows2, heads2, rest, goal, ok, ew, ih)

# from the empty root a walk goes on through every segment
def tb.open.nil(path: List<&2, String>) -> {Laws.tb.open(path, []) == True{} : Bool}:
  match path:
    case []:
      {==}
    case _seg <> rest:
      tb.open.nil(rest)

# the table a one-line header defines
def hg.new(ds: List<&2, Laws.Dot>, last: Laws.Seg) -> T.Val:
  T.VHead{T.tree.pre(Laws.tb.join(Laws.dk.init(ds), ""), Laws.seg.name(last)), []}

def Laws.header_line_reads_back(g0, ds, last, ok, g9):
  Laws.header_segments_read_back(False{}, g0, ds, last, ok, g9, [], [], [], T.LTop{}, T.QBasic{}, False{},
    Laws.tb.set(Laws.dk.init(ds), "", [], T.VPair{Laws.seg.name(last), hg.new(ds, last)}
      <> Laws.tb.rows(Laws.dk.init(ds), [])),
    T.heads.by.head(T.tree.pre(Laws.tb.join(Laws.dk.init(ds), ""), Laws.seg.name(last))) <> [],
    Laws.header_defines_new_table(Laws.dk.init(ds), Laws.seg.name(last), [], [], tb.open.nil(Laws.dk.init(ds)),
      Equal.cong(List<&2, T.Val>, T.Hit, xs => T.get(xs, Laws.seg.name(last)), Laws.tb.rows(Laws.dk.init(ds), []),
        [], tb.rows.nil(Laws.dk.init(ds)))),
    "",
    T.Doc{"", T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), hg.new(ds, last)}]))},
    +_bk => +_qk => Equal.cong(List<&2, T.Val>, T.Doc,
      xs => T.Doc{"", T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], T.VPair{Laws.seg.name(last),
        hg.new(ds, last)} <> xs))}, Laws.tb.rows(Laws.dk.init(ds), []), [], tb.rows.nil(Laws.dk.init(ds))))

def Laws.header_line_found_by_at(g0, ds, last, ok, g9):
  Equal.trans(T.Hit,
    T.at(T.root(T.parse(Laws.hd.line(False{}, g0, ds, last, g9, ""))), Laws.hd.path(ds, last)),
    T.at(T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), hg.new(ds, last)}])),
      Laws.hd.path(ds, last)),
    T.Found{hg.new(ds, last)},
    Equal.cong(T.Doc, T.Hit, dd => T.at(T.root(dd), Laws.hd.path(ds, last)),
      T.parse(Laws.hd.line(False{}, g0, ds, last, g9, "")),
      T.Doc{"", T.rows.seal(Laws.tb.set(Laws.dk.init(ds), "", [], [T.VPair{Laws.seg.name(last), hg.new(ds,
        last)}]))},
      Laws.header_line_reads_back(g0, ds, last, ok, g9)),
    ka.nest(Laws.dk.init(ds), Laws.seg.name(last), "", hg.new(ds, last), {==}))

# WP-C: arrays and inline tables read back. A value in a value position is
# read from the value state (LVal) up to the character after it, a newline,
# a comma or a closer, which ends it; the value is then put where the stack
# of open arrays and inline tables puts values (take.top). The lemmas below
# state that in premise form: the rest of the walk is a function of the value
# put and of the fields the value may change (back, qkind, uni and left), as
# in WP-S; the value is known through own (Laws.cv.own1 of it is Laws.cv.raw1
# of the value render wrote). A scalar ends at any of those characters (WP-N
# read it only up to a newline); a string is WP-S's; an array and an inline
# table go by induction on the value and its shape together, as ezjson's pv.

# the scanner waiting for a value, with no error and nothing in its buffer
def cv.vp(
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.St:
  T.St{"", rw, hs, he, ps, [], T.LVal{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}

# the scanner once a value is put where the stack puts values
def cv.put(
  sk: List<&2, T.Ctx>,
  vv: T.Val,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  +he: List<&2, String>,
  ps: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.St:
  T.take.top(sk, vv, "", rw, hs, he, ps, bk, qk, un, lf, ab, False{})

# the rest of the walk, for the value v: reading rest from the scanner with a
# value vv put that own reads as the scanner's form of v, and any back, qkind,
# uni and left, gives a document PP holds of
def cv.Then(
  +v: T.Val,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @vv: T.Val -> @bk: T.Lex -> @qk: T.QKind -> @un: U32 -> @lf: U32 ->
    {Laws.cv.own1(vv) == Laws.cv.raw1(v) : T.Val} ->
    PP(T.doc.read(rest, T.MScan{cv.put(sk, vv, rw, hs, he, ps, bk, qk, un, lf, ab)}))

# a character that may end a value is a newline, a comma or a closer: a claim
# made of each of the four is made of it
def cv.ech(
  -P: Char -> Type,
  +cc: Char,
  b1: Bool,
  b2: Bool,
  b3: Bool,
  b4: Bool,
  e1: {Char.is_eq(cc, '\n') == b1 : Bool},
  e2: {Char.is_eq(cc, ',') == b2 : Bool},
  e3: {Char.is_eq(cc, ']') == b3 : Bool},
  e4: {Char.is_eq(cc, '}') == b4 : Bool},
  hh: {Bool.or(b1, Bool.or(b2, Bool.or(b3, b4))) == True{} : Bool},
  p1: P('\n'),
  p2: P(','),
  p3: P(']'),
  p4: P('}')
) -> P(cc):
  match b1:
    case True{}:
      %Equal.sym(Char, cc, '\n', Eq.char_eq_true(cc, '\n', e1)) : P(_)
      p1
    case False{}:
      match b2:
        case True{}:
          %Equal.sym(Char, cc, ',', Eq.char_eq_true(cc, ',', e2)) : P(_)
          p2
        case False{}:
          match b3:
            case True{}:
              %Equal.sym(Char, cc, ']', Eq.char_eq_true(cc, ']', e3)) : P(_)
              p3
            case False{}:
              match b4:
                case True{}:
                  %Equal.sym(Char, cc, '}', Eq.char_eq_true(cc, '}', e4)) : P(_)
                  p4
                case False{}:
                  Eq.bit.absurd(&1, P(cc), hh)

# a text that starts with such a character is one for each of the four
def cv.eall(
  -P: String -> Type,
  rest: String,
  hn: {Laws.cv.end(rest) == True{} : Bool},
  p1: @tt: String -> P(SCon{'\n', tt}),
  p2: @tt: String -> P(SCon{',', tt}),
  p3: @tt: String -> P(SCon{']', tt}),
  p4: @tt: String -> P(SCon{'}', tt})
) -> P(rest):
  match rest:
    case SNil{}:
      Eq.bit.absurd(&1, P(SNil{}), hn)
    case SCon{+cc, +tt}:
      cv.ech(ch => P(SCon{ch, tt}), cc, Char.is_eq(cc, '\n'), Char.is_eq(cc, ','), Char.is_eq(cc, ']'),
        Char.is_eq(cc, '}'), {==}, {==}, {==}, {==}, hn, p1(tt), p2(tt), p3(tt), p4(tt))

# The scalar ends. A comma or a closer ends a bare value as a newline does,
# but is held and read again once the value is put; reading it again is the
# fast step from the state with the value put (fs.held). A newline is read
# again only inside an inline table; elsewhere the value's step already
# consumed it, as the fast step would.

# a comma ends a bare value, and is held
def wd.endc(
  +fx: Laws.Vf,
  +buf: List<&2, Char>
) -> {T.doc.scan(Laws.vst(fx, buf, T.LBare{}), ',') == T.MScan{T.read.once2(T.bare.got(T.word.val(List.reverse(&2,
  Char, buf)), Laws.vst(fx, [], T.LBare{}), ',', True{}))} : T.Mode}:
  match fx:
    case Laws.Vf{_bad, _rows, _heads, _here, _parts, _back, _qkind, _stack, _uni, _left, _arrtab}:
      {==}

# and so does a bracket
def wd.endb(
  +fx: Laws.Vf,
  +buf: List<&2, Char>
) -> {T.doc.scan(Laws.vst(fx, buf, T.LBare{}), ']') == T.MScan{T.read.once2(T.bare.got(T.word.val(List.reverse(&2,
  Char, buf)), Laws.vst(fx, [], T.LBare{}), ']', True{}))} : T.Mode}:
  match fx:
    case Laws.Vf{_bad, _rows, _heads, _here, _parts, _back, _qkind, _stack, _uni, _left, _arrtab}:
      {==}

# and a brace
def wd.endr(
  +fx: Laws.Vf,
  +buf: List<&2, Char>
) -> {T.doc.scan(Laws.vst(fx, buf, T.LBare{}), '}') == T.MScan{T.read.once2(T.bare.got(T.word.val(List.reverse(&2,
  Char, buf)), Laws.vst(fx, [], T.LBare{}), '}', True{}))} : T.Mode}:
  match fx:
    case Laws.Vf{_bad, _rows, _heads, _here, _parts, _back, _qkind, _stack, _uni, _left, _arrtab}:
      {==}

# a held character is read as the fast step reads it, wherever the value went
def cw.held(
  +fx: Laws.Vf,
  +vv: T.Val,
  +cc: Char
) -> {T.read.once2(T.bare.hold.on(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), cc))
  == T.read.fast(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), cc) : T.St}:
  match fx:
    case Laws.Vf{+bad, +rows, +heads, +here, +parts, +back, +qkind, +stack, +uni, +left, +arrtab}:
      fs.held(stack, vv, cc, bad, rows, heads, here, parts, back, qkind, uni, left, arrtab)

# a newline after a root value is consumed with it, as the fast step would
def cw.nl.root(
  end: T.End,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.read.once2(T.bare.line.go(T.take.root(end, he, bk, qk, un, lf, ab, False{})))
  == T.read.fast(T.take.root(end, he, bk, qk, un, lf, ab, False{}), '\n') : T.St}:
  match end:
    case T.End{_vs, _bad, _heads}:
      {==}

# a newline after a bare value, wherever the value went
def cw.nl(
  +fx: Laws.Vf,
  +vv: T.Val
) -> {T.read.once2(T.bare.hold(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), '\n', Laws.vf.inl(fx)))
  == T.read.fast(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), '\n') : T.St}:
  match fx:
    case Laws.Vf{+bad, +rows, +heads, +here, +parts, +back, +qkind, stack, +uni, +left, +arrtab}:
      match stack:
        case []:
          cw.nl.root(T.tree.walk(T.path.cat(here, parts), T.Tw{rows, T.JPut{vv}, [], bad, "", heads, False{}},
            T.path.len(here, 0)), here, back, qkind, uni, left, arrtab)
        case T.CArr{_items, _saved, _at} <> _rest:
          {==}
        case T.CInl{+inl, +saved, +at} <> +rest:
          fs.held(T.CInl{inl, saved, at} <> rest, vv, '\n', bad, rows, heads, here, parts, back, qkind, uni, left,
            arrtab)

# the scanner once a bare value's buffer is classified and put, and the
# character that ended it is read again or not, as hold says
def cw.got(+fx: Laws.Vf, bb: List<&2, Char>, +cc: Char, +hold: Bool) -> T.Mode:
  T.MScan{T.read.once2(T.bare.got(T.word.val(List.reverse(&2, Char, bb)), Laws.vst(fx, [], T.LBare{}), cc, hold))}

# the character cc ends a bare value, whatever it holds, and hold says
# whether it is read again
def cw.Ew(+fx: Laws.Vf, +cc: Char, +hold: Bool) -> Type:
  @bb: List<&2, Char> ->
    {T.doc.scan(Laws.vst(fx, bb, T.LBare{}), cc) == cw.got(fx, bb, cc, hold) : T.Mode}

# the character read again after the value put, or consumed with it
def cw.Eh(+fx: Laws.Vf, +vv: T.Val, +cc: Char, +hold: Bool) -> Type:
  {T.read.once2(T.bare.hold(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), cc, hold))
    == T.read.fast(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), cc) : T.St}

# the character is read by the fast step from the state with the value put
def cw.Es(+fx: Laws.Vf, +vv: T.Val, +cc: Char) -> Type:
  {T.doc.scan(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), cc)
    == T.MScan{T.read.fast(T.val.take(Laws.vst(fx, [], T.LBare{}), vv), cc)} : T.Mode}

# a bare value, then a character that ends it: the rest is read with the
# value put, once the word, its end and the step after it are named
def cw.gen(
  +vv: T.Val,
  ss: String,
  +hc: {Laws.word.chars(ss) == True{} : Bool},
  +hv: {T.word.val(String.to_list(ss)) == T.GotVal{vv} : T.Got},
  +fx: Laws.Vf,
  +cc: Char,
  +hold: Bool,
  +rest: String,
  ew: cw.Ew(fx, cc, hold),
  eh: cw.Eh(fx, vv, cc, hold),
  es: cw.Es(fx, vv, cc)
) -> {T.doc.read(String.append(ss, SCon{cc, rest}), T.MScan{Laws.vst(fx, [], T.LVal{})})
  == T.doc.read(SCon{cc, rest}, T.MScan{T.val.take(Laws.vst(fx, [], T.LBare{}), vv)}) : T.Doc}:
  match ss:
    case SNil{}:
      Eq.bit.absurd(&2, {T.doc.read(String.append(SNil{}, SCon{cc, rest}), T.MScan{Laws.vst(fx, [], T.LVal{})})
        == T.doc.read(SCon{cc, rest}, T.MScan{T.val.take(Laws.vst(fx, [], T.LBare{}), vv)}) : T.Doc}, hc)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          +h1 = {Eq.and.left(Laws.word.first(Chr{xx}), Laws.word.rest(tt), hc)
            : {Laws.word.first(Chr{xx}) == True{} : Bool}}
          +hr = {Eq.and.right(Laws.word.first(Chr{xx}), Laws.word.rest(tt), hc) : {Laws.word.rest(tt) == True{} : Bool}}
          +bb = {rev.onto(tt, [Chr{xx}]) : List<&2, Char>}
          +ho = {Equal.trans(T.Got, T.word.val(List.reverse(&2, Char, bb)),
            T.word.val(String.to_list(SCon{Chr{xx}, tt})), T.GotVal{vv},
            Equal.cong(List<&2, Char>, T.Got, cs => T.word.val(cs), List.reverse(&2, Char, bb),
              String.to_list(SCon{Chr{xx}, tt}), wd.order(Chr{xx}, tt)), hv)
            : {T.word.val(List.reverse(&2, Char, bb)) == T.GotVal{vv} : T.Got}}
          +st = {T.val.take(Laws.vst(fx, [], T.LBare{}), vv) : T.St}
          Equal.trans(T.Doc,
            T.doc.read(String.append(tt, SCon{cc, rest}), T.doc.scan(Laws.vst(fx, [], T.LVal{}), Chr{xx})),
            T.doc.read(String.append(tt, SCon{cc, rest}), T.MScan{Laws.vst(fx, [Chr{xx}], T.LBare{})}),
            T.doc.read(SCon{cc, rest}, T.MScan{st}),
            Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, SCon{cc, rest}), md),
              T.doc.scan(Laws.vst(fx, [], T.LVal{}), Chr{xx}), T.MScan{Laws.vst(fx, [Chr{xx}], T.LBare{})},
              wd.first(fx, xx, h1)),
            Equal.trans(T.Doc,
              T.doc.read(String.append(tt, SCon{cc, rest}), T.MScan{Laws.vst(fx, [Chr{xx}], T.LBare{})}),
              T.doc.read(SCon{cc, rest}, T.MScan{Laws.vst(fx, bb, T.LBare{})}),
              T.doc.read(SCon{cc, rest}, T.MScan{st}),
              wd.run(tt, SCon{cc, rest}, fx, [Chr{xx}], hr),
              Equal.trans(T.Doc,
                T.doc.read(rest, T.doc.scan(Laws.vst(fx, bb, T.LBare{}), cc)),
                T.doc.read(rest, T.MScan{T.read.once2(T.bare.got(T.GotVal{vv}, Laws.vst(fx, [], T.LBare{}), cc,
                  hold))}),
                T.doc.read(rest, T.doc.scan(st, cc)),
                Equal.trans(T.Doc,
                  T.doc.read(rest, T.doc.scan(Laws.vst(fx, bb, T.LBare{}), cc)),
                  T.doc.read(rest, T.MScan{T.read.once2(T.bare.got(T.word.val(List.reverse(&2, Char, bb)),
                    Laws.vst(fx, [], T.LBare{}), cc, hold))}),
                  T.doc.read(rest, T.MScan{T.read.once2(T.bare.got(T.GotVal{vv}, Laws.vst(fx, [], T.LBare{}), cc,
                    hold))}),
                  Equal.cong(T.Mode, T.Doc, md => T.doc.read(rest, md),
                    T.doc.scan(Laws.vst(fx, bb, T.LBare{}), cc),
                    T.MScan{T.read.once2(T.bare.got(T.word.val(List.reverse(&2, Char, bb)),
                      Laws.vst(fx, [], T.LBare{}), cc, hold))}, ew(bb)),
                  Equal.cong(T.Got, T.Doc, gg => T.doc.read(rest, T.MScan{T.read.once2(T.bare.got(gg,
                    Laws.vst(fx, [], T.LBare{}), cc, hold))}), T.word.val(List.reverse(&2, Char, bb)),
                    T.GotVal{vv}, ho)),
                Equal.cong(T.Mode, T.Doc, md => T.doc.read(rest, md),
                  T.MScan{T.read.once2(T.bare.hold(st, cc, hold))}, T.doc.scan(st, cc),
                  Equal.trans(T.Mode, T.MScan{T.read.once2(T.bare.hold(st, cc, hold))},
                    T.MScan{T.read.fast(st, cc)}, T.doc.scan(st, cc),
                    Equal.cong(T.St, T.Mode, sx => T.MScan{sx}, T.read.once2(T.bare.hold(st, cc, hold)),
                      T.read.fast(st, cc), eh),
                    Equal.sym(T.Mode, T.doc.scan(st, cc), T.MScan{T.read.fast(st, cc)}, es))))))

# the word's text, as the claim cw.word makes
def cw.Word(+fx: Laws.Vf, +vv: T.Val, +ss: String, +rest: String) -> Type:
  {T.doc.read(String.append(ss, rest), T.MScan{Laws.vst(fx, [], T.LVal{})})
    == T.doc.read(rest, T.MScan{T.val.take(Laws.vst(fx, [], T.LBare{}), vv)}) : T.Doc}

# a bare value then any character that may end a value: the rest, that
# character first, is read with the value put
def cw.word(
  +vv: T.Val,
  +ss: String,
  +hc: {Laws.word.chars(ss) == True{} : Bool},
  +hv: {T.word.val(String.to_list(ss)) == T.GotVal{vv} : T.Got},
  +fx: Laws.Vf,
  rest: String,
  hn: {Laws.cv.end(rest) == True{} : Bool}
) -> cw.Word(fx, vv, ss, rest):
  cv.eall(rr => cw.Word(fx, vv, ss, rr), rest, hn,
    tt => cw.gen(vv, ss, hc, hv, fx, '\n', Laws.vf.inl(fx), tt, bb => wd.end(fx, bb), cw.nl(fx, vv), {==}),
    tt => cw.gen(vv, ss, hc, hv, fx, ',', True{}, tt, bb => wd.endc(fx, bb), cw.held(fx, vv, ','), {==}),
    tt => cw.gen(vv, ss, hc, hv, fx, ']', True{}, tt, bb => wd.endb(fx, bb), cw.held(fx, vv, ']'), {==}),
    tt => cw.gen(vv, ss, hc, hv, fx, '}', True{}, tt, bb => wd.endr(fx, bb), cw.held(fx, vv, '}'), {==}))

# a well-formed scalar render writes as a bare value is a word of the
# characters a bare value keeps
def cv.wch(
  vv: T.Val,
  +w: {Laws.bare_val(vv) == True{} : Bool}
) -> {Laws.word.chars(T.render.atom(vv)) == True{} : Bool}:
  match vv:
    case T.VInt{+sg, +ds}:
      int.chars(sg, ds, Eq.and.left(T.wf.dec(ds), T.i64.fits(sg, ds), w))
    case T.VFlo{+sg, +text}:
      flo.chars(sg, text, T.str.eq(text, "inf"), {==}, T.str.eq(text, "nan"), {==}, w)
    case T.VBool{bb}:
      match bb:
        case True{}:
          {==}
        case False{}:
          {==}
    case T.VWhen{+ww}:
      Equal.trans(Bool, Laws.word.chars(T.when.text(ww)), Laws.word.chars(tstr(tks(ww))), True{},
        Equal.cong(String, Bool, ss => Laws.word.chars(ss), T.when.text(ww), tstr(tks(ww)),
          when.eq(Unit{}, ww, w)), wch.all(ww, w))
    case T.VStr{tx}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VStr{tx})) == True{} : Bool}, w)
    case T.VSpan{src, nn}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VSpan{src, nn})) == True{} : Bool}, w)
    case T.VArr{it}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VArr{it})) == True{} : Bool}, w)
    case T.VInl{rs}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VInl{rs})) == True{} : Bool}, w)
    case T.VHead{pp, rs}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VHead{pp, rs})) == True{} : Bool}, w)
    case T.VAot{pp, rs}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VAot{pp, rs})) == True{} : Bool}, w)
    case T.VAots{pp, es}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VAots{pp, es})) == True{} : Bool}, w)
    case T.VPair{nm, pv}:
      Eq.bit.absurd(&2, {Laws.word.chars(T.render.atom(T.VPair{nm, pv})) == True{} : Bool}, w)

# and word.val classifies it as the scalar
def cv.wvl(
  vv: T.Val,
  +w: {Laws.bare_val(vv) == True{} : Bool}
) -> {T.word.val(String.to_list(T.render.atom(vv))) == T.GotVal{vv} : T.Got}:
  match vv:
    case T.VInt{+sg, +ds}:
      Laws.int_word(sg, ds, w)
    case T.VFlo{+sg, +text}:
      Laws.flo_word(sg, text, w)
    case T.VBool{bb}:
      Laws.bool_word(bb)
    case T.VWhen{+ww}:
      Laws.when_word(ww, w)
    case T.VStr{tx}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VStr{tx}))) == T.GotVal{T.VStr{tx}} : T.Got}, w)
    case T.VSpan{src, nn}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VSpan{src, nn}))) == T.GotVal{T.VSpan{src, nn}}
        : T.Got}, w)
    case T.VArr{it}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VArr{it}))) == T.GotVal{T.VArr{it}} : T.Got}, w)
    case T.VInl{rs}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VInl{rs}))) == T.GotVal{T.VInl{rs}} : T.Got}, w)
    case T.VHead{pp, rs}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VHead{pp, rs}))) == T.GotVal{T.VHead{pp, rs}}
        : T.Got}, w)
    case T.VAot{pp, rs}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VAot{pp, rs}))) == T.GotVal{T.VAot{pp, rs}}
        : T.Got}, w)
    case T.VAots{pp, es}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VAots{pp, es}))) == T.GotVal{T.VAots{pp, es}}
        : T.Got}, w)
    case T.VPair{nm, pv}:
      Eq.bit.absurd(&2, {T.word.val(String.to_list(T.render.atom(T.VPair{nm, pv}))) == T.GotVal{T.VPair{nm, pv}}
        : T.Got}, w)

# a scalar holds no span, so own reads it as itself
def cv.own.sc(
  vv: T.Val,
  w: {Laws.bare_val(vv) == True{} : Bool}
) -> {Laws.cv.own1(vv) == Laws.cv.raw1(vv) : T.Val}:
  match vv:
    case T.VInt{_sg, _ds}:
      {==}
    case T.VFlo{_sg, _text}:
      {==}
    case T.VBool{_bb}:
      {==}
    case T.VWhen{_ww}:
      {==}
    case T.VStr{tx}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VStr{tx}) == Laws.cv.raw1(T.VStr{tx}) : T.Val}, w)
    case T.VSpan{src, nn}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VSpan{src, nn}) == Laws.cv.raw1(T.VSpan{src, nn}) : T.Val}, w)
    case T.VArr{it}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VArr{it}) == Laws.cv.raw1(T.VArr{it}) : T.Val}, w)
    case T.VInl{rs}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VInl{rs}) == Laws.cv.raw1(T.VInl{rs}) : T.Val}, w)
    case T.VHead{pp, rs}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VHead{pp, rs}) == Laws.cv.raw1(T.VHead{pp, rs}) : T.Val}, w)
    case T.VAot{pp, rs}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VAot{pp, rs}) == Laws.cv.raw1(T.VAot{pp, rs}) : T.Val}, w)
    case T.VAots{pp, es}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VAots{pp, es}) == Laws.cv.raw1(T.VAots{pp, es}) : T.Val}, w)
    case T.VPair{nm, pv}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VPair{nm, pv}) == Laws.cv.raw1(T.VPair{nm, pv}) : T.Val}, w)

# a well-formed scalar render writes as a bare value, then a character that
# ends it: the rest is read with the scalar put
def cv.scalar(
  +vv: T.Val,
  +w: {Laws.bare_val(vv) == True{} : Bool},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  hn: {Laws.cv.end(rest) == True{} : Bool},
  ih: cv.Then(vv, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(T.render.atom(vv), rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  pp.step(PP, T.doc.read(String.append(T.render.atom(vv), rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf,
    ab)}), T.doc.read(rest, T.MScan{cv.put(sk, vv, rw, hs, he, ps, bk, qk, un, lf, ab)}),
    cw.word(vv, T.render.atom(vv), cv.wch(vv, w), cv.wvl(vv, w), Laws.Vf{"", rw, hs, he, ps, bk, qk, sk, un, lf,
      ab}, rest, hn),
    ih(vv, bk, qk, un, lf, cv.own.sc(vv, w)))

# no text that starts with a character that ends a value starts with a quote
def cv.free(
  rest: String,
  hn: {Laws.cv.end(rest) == True{} : Bool}
) -> {sv.free(rest) == True{} : Bool}:
  cv.eall(rr => {sv.free(rr) == True{} : Bool}, rest, hn, _tt => {==}, _tt => {==}, _tt => {==}, _tt => {==})

# a string value holding ss is one own reads as the owned string ss
def cv.isstr(
  vv: T.Val,
  +ss: String,
  hv: sv.Is(vv, ss)
) -> {Laws.cv.own1(vv) == T.VStr{ss} : T.Val}:
  match vv:
    case T.VStr{st}:
      Equal.cong(String, T.Val, xs => T.VStr{xs}, st, ss, hv)
    case T.VSpan{src, +nn}:
      Equal.cong(String, T.Val, xs => T.VStr{xs}, T.span.str(src, nn, U32.is_zero(nn)), ss, hv)
    case T.VInt{_sign, _digits}:
      match hv:
    case T.VFlo{_sign, _text}:
      match hv:
    case T.VBool{_bit}:
      match hv:
    case T.VWhen{_when}:
      match hv:
    case T.VArr{_items}:
      match hv:
    case T.VInl{_rows}:
      match hv:
    case T.VHead{_path, _rows}:
      match hv:
    case T.VAot{_path, _rows}:
      match hv:
    case T.VAots{_path, _elems}:
      match hv:
    case T.VPair{_name, _val}:
      match hv:

# a string, as key.basic writes it, then a character that ends a value: the
# rest is read with a string value holding it put (WP-S)
def cv.str(
  +ss: String,
  es: {Laws.short(ss) == True{} : Bool},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  hn: {Laws.cv.end(rest) == True{} : Bool},
  ih: cv.Then(T.VStr{ss}, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(T.key.basic(ss), rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  sv.val(ss, "", rw, hs, he, ps, [], bk, qk, sk, un, lf, ab, rest, PP, es, cv.free(rest, hn),
    +vv => b2 => u2 => l2 => hv => ih(vv, b2, T.QBasic{}, u2, l2, cv.isstr(vv, ss, hv)))

# a span is written as its characters are, so it reads back as they do
def cv.span(
  +src: String,
  +nn: U32,
  es: {Laws.short(T.span.str(src, nn, U32.is_zero(nn))) == True{} : Bool},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  hn: {Laws.cv.end(rest) == True{} : Bool},
  ih: cv.Then(T.VSpan{src, nn}, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(T.render.atom(T.VSpan{src, nn}), rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk,
  un, lf, ab)})):
  %Equal.sym(String, T.span.quote(src, nn), T.key.basic(T.string(T.VSpan{src, nn})), Laws.span_quote_basic(src, nn)) :
    PP(T.doc.read(String.append(_, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf, ab)}))
  cv.str(T.span.str(src, nn, U32.is_zero(nn)), es, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)

# every well-formed scalar with short strings, then a character that ends a
# value: the rest is read with the scalar put
def cv.atom(
  vv: T.Val,
  hw: {T.wf.atom(vv) == True{} : Bool},
  hs2: {Laws.cv.short1(vv) == True{} : Bool},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  hn: {Laws.cv.end(rest) == True{} : Bool},
  ih: cv.Then(vv, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.cv.tx(vv, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  match vv:
    case T.VStr{+ss}:
      cv.str(ss, hs2, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VSpan{+src, +nn}:
      cv.span(src, nn, hs2, rw, hs, he, ps,
        bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VInt{+sg, +ds}:
      cv.scalar(T.VInt{sg, ds}, hw, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VFlo{+sg, +text}:
      cv.scalar(T.VFlo{sg, text}, hw, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VBool{+bb}:
      cv.scalar(T.VBool{bb}, hw, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VWhen{+ww}:
      cv.scalar(T.VWhen{ww}, hw, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VArr{it}:
      Eq.bit.absurd(&1, PP(T.doc.read(Laws.cv.tx(T.VArr{it}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf,
        ab)})), hw)
    case T.VInl{rs}:
      Eq.bit.absurd(&1, PP(T.doc.read(Laws.cv.tx(T.VInl{rs}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf,
        ab)})), hw)
    case T.VHead{pp, rs}:
      Eq.bit.absurd(&1, PP(T.doc.read(Laws.cv.tx(T.VHead{pp, rs}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un,
        lf, ab)})), hw)
    case T.VAot{pp, rs}:
      Eq.bit.absurd(&1, PP(T.doc.read(Laws.cv.tx(T.VAot{pp, rs}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un,
        lf, ab)})), hw)
    case T.VAots{pp, es}:
      Eq.bit.absurd(&1, PP(T.doc.read(Laws.cv.tx(T.VAots{pp, es}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un,
        lf, ab)})), hw)
    case T.VPair{nm, pv}:
      Eq.bit.absurd(&1, PP(T.doc.read(Laws.cv.tx(T.VPair{nm, pv}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un,
        lf, ab)})), hw)

# Arrays. `[` opens a frame and waits in LArr; an item's first character is
# held there and read again in LVal, with back at LVal; the item is put onto
# the frame's items, newest first, and the scanner waits in LArrC, where
# ", " goes back to LArr and `]` closes the array: its items, reversed, are
# put where the stack puts values. The items read so far are known through
# own: own.rows of them is the scanner's form of the items read, pushed onto
# what was there (cv.ThenA).

# the scanner in an open array, waiting for an item or `]`: the frame holds
# the items so far (acc, newest first) and the parts and path to put the
# array at
def cv.ar(
  acc: List<&2, T.Val>,
  ps0: List<&2, String>,
  he0: List<&2, String>,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.St:
  T.St{"", rw, hs, he, ps, [], T.LArr{}, bk, qk, T.CArr{acc, ps0, he0} <> sk, T.HNone{}, un, lf, ab, False{}}

# the scanner in an open inline table after `, `, waiting for a key: the frame
# holds the pairs so far (newest first) and the parts and path to put the
# table at
def cv.ik(
  inl: List<&2, T.Val>,
  ps0: List<&2, String>,
  +he0: List<&2, String>,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.St:
  T.St{"", rw, hs, he0, [], [], T.LInlK{}, bk, qk, T.CInl{inl, ps0, he0} <> sk, T.HNone{}, un, lf, ab, False{}}

# what follows an item or a pair render wrote: the closer when it is the
# last, and ", " and the rest otherwise
def cv.tl(vs: List<&2, T.Val>, +close: Char, xx: String) -> String:
  match vs:
    case []:
      SCon{close, xx}
    case +hh <> +tt:
      SCon{',', SCon{' ', String.append(T.render.go(hh <> tt, ", ", False{}), SCon{close, xx})}}

# the separator and the rest render writes after an item or a pair
def cv.S(+vs: List<&2, T.Val>) -> String:
  String.append(T.render.suf(", ", False{}, List.is_empty(&2, T.Val, vs)), T.render.go(vs, ", ", False{}))

# the rest of the walk once an array is closed: its items, reversed, are put,
# and own reads what the scanner pushed as the items read pushed onto what
# the frame held
def cv.ThenA(
  +items: List<&2, T.Val>,
  +acc: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @ac2: List<&2, T.Val> -> @bk: T.Lex -> @qk: T.QKind -> @un: U32 -> @lf: U32 ->
    {Laws.own.rows(ac2) == List.reverse.go(&2, T.Val, Laws.cv.raw(items), Laws.own.rows(acc)) : List<&2, T.Val>} ->
    PP(T.doc.read(rest, T.MScan{cv.put(sk, T.VArr{List.reverse(&2, T.Val, ac2)}, rw, hs, he0, ps0, bk, qk, un, lf,
      ab)}))

# the rest of the walk once an inline table is closed: its pairs, sealed,
# are put, and own reads them as the pairs read pushed onto what the frame
# held; sealing leaves them as they are
def cv.ThenI(
  +rows: List<&2, T.Val>,
  +inl: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @in2: List<&2, T.Val> -> @bk: T.Lex -> @qk: T.QKind -> @un: U32 -> @lf: U32 ->
    {Laws.own.rows(in2) == List.reverse.go(&2, T.Val, Laws.cv.raw(rows), Laws.own.rows(inl)) : List<&2, T.Val>} ->
    {T.inl.seal(in2) == in2 : List<&2, T.Val>} ->
    PP(T.doc.read(rest, T.MScan{cv.put(sk, T.VInl{T.inl.seal(in2)}, rw, hs, he0, ps0, bk, qk, un, lf, ab)}))

# every pair's name in rows is missing from inl
def cv.fr(+inl: List<&2, T.Val>, rows: List<&2, T.Val>) -> Bool:
  match rows:
    case []:
      True{}
    case T.VPair{+kk, _vv} <> tt:
      Bool.and(Laws.is_miss(T.get(inl, kk)), cv.fr(inl, tt))
    case _hh <> tt:
      cv.fr(inl, tt)

# what the induction claims of a list: an array's items (rows false) read
# from LArr up to `]` and the rest, or an inline table's pairs (rows true),
# at least one, read from LInlK up to `}` and the rest
def cv.G(
  +vs: List<&2, T.Val>,
  rows: Bool,
  +acc: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  match rows:
    case False{}:
      {T.wf.go(vs, T.WfItems{}) == True{} : Bool} -> {Laws.cv.shorts(vs) == True{} : Bool} ->
        {Laws.cv.end(rest) == True{} : Bool} -> cv.ThenA(vs, acc, ps0, he0, rw, hs, sk, ab, rest, PP) ->
        PP(T.doc.read(String.append(T.render.go(vs, ", ", False{}), SCon{']', rest}), T.MScan{cv.ar(acc, ps0, he0,
          rw, hs, he, ps, bk, qk, sk, un, lf, ab)}))
    case True{}:
      {List.is_empty(&2, T.Val, vs) == False{} : Bool} -> {T.wf.go(vs, T.WfInl{}) == True{} : Bool} ->
        {Laws.cv.shorts(vs) == True{} : Bool} -> {Laws.cv.end(rest) == True{} : Bool} ->
        {cv.fr(acc, vs) == True{} : Bool} -> {T.inl.seal(acc) == acc : List<&2, T.Val>} ->
        cv.ThenI(vs, acc, ps0, he0, rw, hs, sk, ab, rest, PP) ->
        PP(T.doc.read(String.append(T.render.go(vs, ", ", False{}), SCon{'}', rest}), T.MScan{cv.ik(acc, ps0, he0,
          rw, hs, bk, qk, sk, un, lf, ab)}))

# reading a value from a value position, once its well-formedness and its
# strings' lengths are known: the claim the induction proves of each value
def cv.Rd(
  +vv: T.Val,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  {Laws.cv.end(rest) == True{} : Bool} -> cv.Then(vv, rw, hs, he, ps, sk, ab, rest, PP) ->
    PP(T.doc.read(Laws.cv.tx(vv, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un, lf, ab)}))

# Lists. own and the scanner's form both read a list one value at a time.

# own reads a list's head by itself
def cv.own.cons(
  xx: T.Val,
  +tt: List<&2, T.Val>
) -> {Laws.own.rows(xx <> tt) == Laws.cv.own1(xx) <> Laws.own.rows(tt) : List<&2, T.Val>}:
  match xx:
    case T.VPair{nn, yy}:
      match yy:
        case T.VStr{_a}:
          {==}
        case T.VSpan{_a, _b}:
          {==}
        case T.VInt{_a, _b}:
          {==}
        case T.VFlo{_a, _b}:
          {==}
        case T.VBool{_a}:
          {==}
        case T.VWhen{_a}:
          {==}
        case T.VArr{_a}:
          {==}
        case T.VInl{_a}:
          {==}
        case T.VHead{_a, _b}:
          {==}
        case T.VAot{_a, _b}:
          {==}
        case T.VAots{_a, _b}:
          {==}
        case T.VPair{_a, _b}:
          {==}
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{_a, _b}:
      {==}
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}

# and so does the scanner's form
def cv.raw.cons(
  xx: T.Val,
  +tt: List<&2, T.Val>
) -> {Laws.cv.raw(xx <> tt) == Laws.cv.raw1(xx) <> Laws.cv.raw(tt) : List<&2, T.Val>}:
  match xx:
    case T.VPair{nn, yy}:
      match yy:
        case T.VStr{_a}:
          {==}
        case T.VSpan{_a, _b}:
          {==}
        case T.VInt{_a, _b}:
          {==}
        case T.VFlo{_a, _b}:
          {==}
        case T.VBool{_a}:
          {==}
        case T.VWhen{_a}:
          {==}
        case T.VArr{_a}:
          {==}
        case T.VInl{_a}:
          {==}
        case T.VHead{_a, _b}:
          {==}
        case T.VAot{_a, _b}:
          {==}
        case T.VAots{_a, _b}:
          {==}
        case T.VPair{_a, _b}:
          {==}
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{_a, _b}:
      {==}
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}

# own reads a reversal onto a list as the reversal of what it reads
def cv.own.rev(
  xs: List<&2, T.Val>,
  +aa: List<&2, T.Val>
) -> {Laws.own.rows(List.reverse.go(&2, T.Val, xs, aa))
  == List.reverse.go(&2, T.Val, Laws.own.rows(xs), Laws.own.rows(aa)) : List<&2, T.Val>}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      Equal.trans(List<&2, T.Val>,
        Laws.own.rows(List.reverse.go(&2, T.Val, tt, hh <> aa)),
        List.reverse.go(&2, T.Val, Laws.own.rows(tt), Laws.own.rows(hh <> aa)),
        List.reverse.go(&2, T.Val, Laws.own.rows(hh <> tt), Laws.own.rows(aa)),
        cv.own.rev(tt, hh <> aa),
        Equal.trans(List<&2, T.Val>,
          List.reverse.go(&2, T.Val, Laws.own.rows(tt), Laws.own.rows(hh <> aa)),
          List.reverse.go(&2, T.Val, Laws.cv.own1(hh) <> Laws.own.rows(tt), Laws.own.rows(aa)),
          List.reverse.go(&2, T.Val, Laws.own.rows(hh <> tt), Laws.own.rows(aa)),
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => List.reverse.go(&2, T.Val, Laws.own.rows(tt), ys),
            Laws.own.rows(hh <> aa), Laws.cv.own1(hh) <> Laws.own.rows(aa), cv.own.cons(hh, aa)),
          Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => List.reverse.go(&2, T.Val, ys, Laws.own.rows(aa)),
            Laws.cv.own1(hh) <> Laws.own.rows(tt), Laws.own.rows(hh <> tt),
            Equal.sym(List<&2, T.Val>, Laws.own.rows(hh <> tt), Laws.cv.own1(hh) <> Laws.own.rows(tt),
              cv.own.cons(hh, tt)))))

# a list appended to nothing is itself
def cv.app.nil(xs: List<&2, T.Val>) -> {List.append(&2, T.Val, xs, []) == xs : List<&2, T.Val>}:
  match xs:
    case []:
      {==}
    case +hh <> tt:
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => hh <> ys, List.append(&2, T.Val, tt, []), tt,
        cv.app.nil(tt))

# reversing twice puts a list back, what it was reversed onto after it
def cv.rr(
  xs: List<&2, T.Val>,
  aa: List<&2, T.Val>,
  bb: List<&2, T.Val>
) -> {List.reverse.go(&2, T.Val, List.reverse.go(&2, T.Val, xs, aa), bb)
  == List.reverse.go(&2, T.Val, aa, List.append(&2, T.Val, xs, bb)) : List<&2, T.Val>}:
  match xs:
    case []:
      {==}
    case hh <> tt:
      cv.rr(tt, hh <> aa, bb)

# reversing twice is the list
def cv.rev2(+xs: List<&2, T.Val>) -> {List.reverse(&2, T.Val, List.reverse(&2, T.Val, xs)) == xs : List<&2, T.Val>}:
  Equal.trans(List<&2, T.Val>, List.reverse.go(&2, T.Val, List.reverse.go(&2, T.Val, xs, []), []),
    List.append(&2, T.Val, xs, []), xs, cv.rr(xs, [], []), cv.app.nil(xs))

# The text. render writes an item or a pair's value as cv.tx writes the value,
# then the separator and the rest (cv.tl).

# the separator and the rest, then the closer
def cv.suf(
  vs: List<&2, T.Val>,
  +close: Char,
  +xx: String
) -> {String.append(cv.S(vs), SCon{close, xx}) == cv.tl(vs, close, xx) : String}:
  match vs:
    case []:
      {==}
    case _hh <> _tt:
      {==}

# a scalar's text, then the separator, the rest and the closer
def cv.at(
  +aa: String,
  +vs: List<&2, T.Val>,
  +close: Char,
  +xx: String
) -> {String.append(String.append(aa, cv.S(vs)), SCon{close, xx}) == String.append(aa, cv.tl(vs, close, xx)) : String}:
  Equal.trans(String, String.append(String.append(aa, cv.S(vs)), SCon{close, xx}),
    String.append(aa, String.append(cv.S(vs), SCon{close, xx})), String.append(aa, cv.tl(vs, close, xx)),
    Eq.append_assoc(aa, cv.S(vs), SCon{close, xx}),
    Equal.cong(String, String, zz => String.append(aa, zz), String.append(cv.S(vs), SCon{close, xx}),
      cv.tl(vs, close, xx), cv.suf(vs, close, xx)))

# a container's items and its closer, then the separator, the rest and the
# outer closer
def cv.cl(
  +rr: String,
  +c2: Char,
  +vs: List<&2, T.Val>,
  +close: Char,
  +xx: String
) -> {String.append(String.append(rr, SCon{c2, cv.S(vs)}), SCon{close, xx})
  == String.append(rr, SCon{c2, cv.tl(vs, close, xx)}) : String}:
  Equal.trans(String, String.append(String.append(rr, SCon{c2, cv.S(vs)}), SCon{close, xx}),
    String.append(rr, String.append(SCon{c2, cv.S(vs)}, SCon{close, xx})),
    String.append(rr, SCon{c2, cv.tl(vs, close, xx)}),
    Eq.append_assoc(rr, SCon{c2, cv.S(vs)}, SCon{close, xx}),
    Equal.cong(String, String, zz => String.append(rr, SCon{c2, zz}), String.append(cv.S(vs), SCon{close, xx}),
      cv.tl(vs, close, xx), cv.suf(vs, close, xx)))

# an item and the rest of the items, then the closer: the item's text, then
# what follows it
def cv.itx(
  ii: T.Val,
  +tt: List<&2, T.Val>,
  +close: Char,
  +xx: String,
  hw: {Laws.cv.wf(ii) == True{} : Bool}
) -> {String.append(T.render.go(ii <> tt, ", ", False{}), SCon{close, xx}) == Laws.cv.tx(ii, cv.tl(tt, close, xx))
  : String}:
  match ii:
    case T.VArr{+items}:
      Equal.cong(String, String, zz => SCon{'[', zz},
        String.append(String.append(T.render.go(items, ", ", False{}), SCon{']', cv.S(tt)}), SCon{close, xx}),
        String.append(T.render.go(items, ", ", False{}), SCon{']', cv.tl(tt, close, xx)}),
        cv.cl(T.render.go(items, ", ", False{}), ']', tt, close, xx))
    case T.VInl{+rows}:
      Equal.cong(String, String, zz => SCon{'{', zz},
        String.append(String.append(T.render.go(rows, ", ", False{}), SCon{'}', cv.S(tt)}), SCon{close, xx}),
        String.append(T.render.go(rows, ", ", False{}), SCon{'}', cv.tl(tt, close, xx)}),
        cv.cl(T.render.go(rows, ", ", False{}), '}', tt, close, xx))
    case T.VStr{+aa}:
      cv.at(T.render.atom(T.VStr{aa}), tt, close, xx)
    case T.VSpan{+aa, +bb}:
      cv.at(T.render.atom(T.VSpan{aa, bb}), tt, close, xx)
    case T.VInt{+aa, +bb}:
      cv.at(T.render.atom(T.VInt{aa, bb}), tt, close, xx)
    case T.VFlo{+aa, +bb}:
      cv.at(T.render.atom(T.VFlo{aa, bb}), tt, close, xx)
    case T.VBool{+aa}:
      cv.at(T.render.atom(T.VBool{aa}), tt, close, xx)
    case T.VWhen{+aa}:
      cv.at(T.render.atom(T.VWhen{aa}), tt, close, xx)
    case T.VHead{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VHead{aa, bb} <> tt, ", ", False{}), SCon{close, xx})
        == Laws.cv.tx(T.VHead{aa, bb}, cv.tl(tt, close, xx)) : String}, hw)
    case T.VAot{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VAot{aa, bb} <> tt, ", ", False{}), SCon{close, xx})
        == Laws.cv.tx(T.VAot{aa, bb}, cv.tl(tt, close, xx)) : String}, hw)
    case T.VAots{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VAots{aa, bb} <> tt, ", ", False{}), SCon{close, xx})
        == Laws.cv.tx(T.VAots{aa, bb}, cv.tl(tt, close, xx)) : String}, hw)
    case T.VPair{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VPair{aa, bb} <> tt, ", ", False{}), SCon{close, xx})
        == Laws.cv.tx(T.VPair{aa, bb}, cv.tl(tt, close, xx)) : String}, hw)

# the text after an item ends a value
def cv.tl.end(
  vs: List<&2, T.Val>,
  +xx: String
) -> {Laws.cv.end(cv.tl(vs, ']', xx)) == True{} : Bool}:
  match vs:
    case []:
      {==}
    case _hh <> _tt:
      {==}

# and so does the text after an inline table's pair
def cv.tl.endi(
  vs: List<&2, T.Val>,
  +xx: String
) -> {Laws.cv.end(cv.tl(vs, '}', xx)) == True{} : Bool}:
  match vs:
    case []:
      {==}
    case _hh <> _tt:
      {==}

# An item's first character. LArr holds any character that is no blank, no
# newline, no `#` and no `]`, and reads it again in LVal with back at LVal:
# from there on the item is read as a value in a value position.

# a character LArr does not keep for itself
def cv.bad(+cc: Char) -> Bool:
  Bool.or(T.ch.sp(cc), Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']'))))

# the first character of a text is one LArr passes on
def cv.xbad(xs: String) -> Bool:
  match xs:
    case SNil{}:
      True{}
    case SCon{+cc, _tt}:
      cv.bad(cc)

# a character no delimiter is no character LArr keeps
def cv.bad.d(
  aa: Bool,
  bb: Bool,
  cc: Bool,
  dd: Bool,
  ee: Bool,
  ff: Bool,
  hh: {Bool.or(aa, Bool.or(bb, Bool.or(cc, Bool.or(dd, Bool.or(ee, ff))))) == False{} : Bool}
) -> {Bool.or(aa, Bool.or(bb, Bool.or(cc, ee))) == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd2(&2, {Bool.or(True{}, Bool.or(bb, Bool.or(cc, ee))) == False{} : Bool}, hh)
    case False{}:
      match bb:
        case True{}:
          Eq.bit.absurd2(&2, {Bool.or(False{}, Bool.or(True{}, Bool.or(cc, ee))) == False{} : Bool}, hh)
        case False{}:
          match cc:
            case True{}:
              Eq.bit.absurd2(&2, {Bool.or(False{}, Bool.or(False{}, Bool.or(True{}, ee))) == False{} : Bool}, hh)
            case False{}:
              match dd:
                case True{}:
                  Eq.bit.absurd2(&2, {Bool.or(False{}, Bool.or(False{}, Bool.or(False{}, ee))) == False{} : Bool},
                    hh)
                case False{}:
                  Eq.or.left_false(ee, ff, hh)

# a bare value's text starts with such a character
def cv.xb.w(
  ss: String,
  +zz: String,
  hc: {Laws.word.chars(ss) == True{} : Bool}
) -> {cv.xbad(String.append(ss, zz)) == False{} : Bool}:
  match ss:
    case SNil{}:
      Eq.bit.absurd(&2, {cv.xbad(String.append(SNil{}, zz)) == False{} : Bool}, hc)
    case SCon{hh, tt}:
      match hh:
        case Chr{+xx}:
          +h1 = {Eq.and.left(Laws.word.first(Chr{xx}), Laws.word.rest(tt), hc)
            : {Laws.word.first(Chr{xx}) == True{} : Bool}}
          +hw = {Eq.and.left(Laws.word.char(Chr{xx}), Bool.not(Bool.or(Char.is_eq(Chr{xx}, '['),
            Char.is_eq(Chr{xx}, '{'))), h1) : {Laws.word.char(Chr{xx}) == True{} : Bool}}
          cv.bad.d(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), Char.is_eq(Chr{xx}, '#'), Char.is_eq(Chr{xx}, ','),
            Char.is_eq(Chr{xx}, ']'), Char.is_eq(Chr{xx}, '}'), wd.delim(Chr{xx}, hw))

# every value's text starts with such a character
def cv.xb(
  ii: T.Val,
  +zz: String,
  hw: {Laws.cv.wf(ii) == True{} : Bool}
) -> {cv.xbad(Laws.cv.tx(ii, zz)) == False{} : Bool}:
  match ii:
    case T.VArr{_items}:
      {==}
    case T.VInl{_rows}:
      {==}
    case T.VStr{_aa}:
      {==}
    case T.VSpan{+src, +nn}:
      %Equal.sym(String, T.span.quote(src, nn), T.key.basic(T.string(T.VSpan{src, nn})),
        Laws.span_quote_basic(src, nn)) : {cv.xbad(String.append(_, zz)) == False{} : Bool}
      {==}
    case T.VInt{+aa, +bb}:
      cv.xb.w(T.render.atom(T.VInt{aa, bb}), zz, cv.wch(T.VInt{aa, bb}, hw))
    case T.VFlo{+aa, +bb}:
      cv.xb.w(T.render.atom(T.VFlo{aa, bb}), zz, cv.wch(T.VFlo{aa, bb}, hw))
    case T.VBool{+aa}:
      cv.xb.w(T.render.atom(T.VBool{aa}), zz, cv.wch(T.VBool{aa}, hw))
    case T.VWhen{+aa}:
      cv.xb.w(T.render.atom(T.VWhen{aa}), zz, cv.wch(T.VWhen{aa}, hw))
    case T.VHead{aa, bb}:
      Eq.bit.absurd(&2, {cv.xbad(Laws.cv.tx(T.VHead{aa, bb}, zz)) == False{} : Bool}, hw)
    case T.VAot{aa, bb}:
      Eq.bit.absurd(&2, {cv.xbad(Laws.cv.tx(T.VAot{aa, bb}, zz)) == False{} : Bool}, hw)
    case T.VAots{aa, bb}:
      Eq.bit.absurd(&2, {cv.xbad(Laws.cv.tx(T.VAots{aa, bb}, zz)) == False{} : Bool}, hw)
    case T.VPair{aa, bb}:
      Eq.bit.absurd(&2, {cv.xbad(Laws.cv.tx(T.VPair{aa, bb}, zz)) == False{} : Bool}, hw)

# the value state's step leaves nothing held on every character but a newline
def cv.a2v.vg(
  sp: Bool,
  nl: Bool,
  hash: Bool,
  qq: Bool,
  lit: Bool,
  br: Bool,
  inl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  hnl: {nl == False{} : Bool}
) -> {T.lex.val.go(sp, nl, hash, qq, lit, br, inl, cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab), cc)
  == T.read.once2(T.lex.val.go(sp, nl, hash, qq, lit, br, inl, cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab),
  cc)) : T.St}:
  match sp:
    case True{}:
      {==}
    case False{}:
      match nl:
        case True{}:
          Eq.bit.absurd2(&2, {T.lex.val.go(False{}, True{}, hash, qq, lit, br, inl, cv.vp(rw, hs, he, ps, T.LVal{},
            qk, sk, un, lf, ab), cc) == T.read.once2(T.lex.val.go(False{}, True{}, hash, qq, lit, br, inl,
            cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab), cc)) : T.St}, hnl)
        case False{}:
          match hash:
            case True{}:
              {==}
            case False{}:
              match qq:
                case True{}:
                  {==}
                case False{}:
                  match lit:
                    case True{}:
                      {==}
                    case False{}:
                      match br:
                        case True{}:
                          {==}
                        case False{}:
                          match inl:
                            case True{}:
                              {==}
                            case False{}:
                              {==}

# LArr holds a character it does not keep and reads it in LVal
def cv.a2v.ag(
  sp: Bool,
  nl: Bool,
  hash: Bool,
  rb: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  hsp: {sp == False{} : Bool},
  hnl: {nl == False{} : Bool},
  hhs: {hash == False{} : Bool},
  hrb: {rb == False{} : Bool}
) -> {T.read.once2(T.lex.arr.go(sp, nl, hash, rb, T.St{"", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, T.HNone{}, un,
  lf, ab, False{}}, cc)) == T.lex.val(cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab), cc) : T.St}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.arr.go(True{}, nl, hash, rb, T.St{"", rw, hs, he, ps, [], T.LArr{}, bk,
        qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.lex.val(cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab),
        cc) : T.St}, hsp)
    case False{}:
      match nl:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.once2(T.lex.arr.go(False{}, True{}, hash, rb, T.St{"", rw, hs, he, ps, [],
            T.LArr{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.lex.val(cv.vp(rw, hs, he, ps, T.LVal{},
            qk, sk, un, lf, ab), cc) : T.St}, hnl)
        case False{}:
          match hash:
            case True{}:
              Eq.bit.absurd2(&2, {T.read.once2(T.lex.arr.go(False{}, False{}, True{}, rb, T.St{"", rw, hs, he, ps, [],
                T.LArr{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.lex.val(cv.vp(rw, hs, he, ps,
                T.LVal{}, qk, sk, un, lf, ab), cc) : T.St}, hhs)
            case False{}:
              match rb:
                case True{}:
                  Eq.bit.absurd2(&2, {T.read.once2(T.lex.arr.go(False{}, False{}, False{}, True{}, T.St{"", rw, hs,
                    he, ps, [], T.LArr{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.lex.val(cv.vp(rw, hs,
                    he, ps, T.LVal{}, qk, sk, un, lf, ab), cc) : T.St}, hrb)
                case False{}:
                  {==}

# the fast steps of LArr and of LVal with back at LVal agree on such a
# character
def cv.a2v.ws(
  sp: Bool,
  nl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  hsp: {sp == False{} : Bool},
  hnl: {nl == False{} : Bool},
  +fsp: {T.ch.sp(cc) == False{} : Bool},
  +fnl: {T.ch.nl(cc) == False{} : Bool},
  fhs: {Char.is_eq(cc, '#') == False{} : Bool},
  frb: {Char.is_eq(cc, ']') == False{} : Bool}
) -> {T.read.fast.ws(sp, nl, True{}, "", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, un, lf, ab, cc)
  == T.read.fast.ws(sp, nl, False{}, "", rw, hs, he, ps, [], T.LVal{}, T.LVal{}, qk, sk, un, lf, ab, cc) : T.St}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.fast.ws(True{}, nl, True{}, "", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, un, lf, ab,
        cc) == T.read.fast.ws(True{}, nl, False{}, "", rw, hs, he, ps, [], T.LVal{}, T.LVal{}, qk, sk, un, lf, ab, cc)
        : T.St}, hsp)
    case False{}:
      match nl:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.fast.ws(False{}, True{}, True{}, "", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk,
            un, lf, ab, cc) == T.read.fast.ws(False{}, True{}, False{}, "", rw, hs, he, ps, [], T.LVal{}, T.LVal{},
            qk, sk, un, lf, ab, cc) : T.St}, hnl)
        case False{}:
          Equal.trans(T.St,
            T.read.once2(T.lex.arr.go(T.ch.sp(cc), T.ch.nl(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, ']'),
              T.St{"", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)),
            T.lex.val(cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab), cc),
            T.read.once2(T.lex.val(cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab), cc)),
            cv.a2v.ag(T.ch.sp(cc), T.ch.nl(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, ']'), rw, hs, he, ps, bk, qk,
              sk, un, lf, ab, cc, fsp, fnl, fhs, frb),
            cv.a2v.vg(T.ch.sp(cc), T.ch.nl(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, '"'), Char.is_eq(cc, '\''),
              Char.is_eq(cc, '['), Char.is_eq(cc, '{'), rw, hs, he, ps, qk, sk, un, lf, ab, cc, fnl))

# a text whose first character LArr passes on reads from LArr as from LVal
# with back at LVal
def cv.a2v(
  xs: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +hb: {cv.xbad(xs) == False{} : Bool}
) -> {T.doc.read(xs, T.MScan{T.St{"", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}})
  == T.doc.read(xs, T.MScan{cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab)}) : T.Doc}:
  match xs:
    case SNil{}:
      Eq.bit.absurd2(&2, {T.doc.read(SNil{}, T.MScan{T.St{"", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, T.HNone{}, un,
        lf, ab, False{}}}) == T.doc.read(SNil{}, T.MScan{cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab)}) : T.Doc},
        hb)
    case SCon{+cc, +tt}:
      +r1 = {Eq.or.right_false(T.ch.sp(cc), Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']'))),
        hb) : {Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']'))) == False{} : Bool}}
      +r2 = {Eq.or.right_false(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']')), r1)
        : {Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']')) == False{} : Bool}}
      Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
        T.doc.scan(T.St{"", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc),
        T.doc.scan(cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab), cc),
        scan.fast(Char.is_eq(cc, '"'), Char.is_eq(cc, '\''), U32.is_eq(Char.to_u32(cc), 13),
          T.St{"", rw, hs, he, ps, [], T.LArr{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}},
          cv.vp(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab), cc,
          cv.a2v.ws(T.ch.sp(cc), T.ch.nl(cc), rw, hs, he, ps, bk, qk, sk, un, lf, ab, cc,
            Eq.or.left_false(T.ch.sp(cc), Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']'))),
              hb),
            Eq.or.left_false(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']')), r1),
            Eq.or.left_false(T.ch.sp(cc), Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']'))),
              hb),
            Eq.or.left_false(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, ']')), r1),
            Eq.or.left_false(Char.is_eq(cc, '#'), Char.is_eq(cc, ']'), r2),
            Eq.or.right_false(Char.is_eq(cc, '#'), Char.is_eq(cc, ']'), r2))))

# The frame's items. Putting a value that own reads as the scanner's form of
# the next item keeps what own reads of the frame the items read so far,
# pushed onto what it held.

# one more value put, read as one more item
def cv.grew(
  ii: T.Val,
  +tt: List<&2, T.Val>,
  +vv: T.Val,
  +acc: List<&2, T.Val>,
  ac2: List<&2, T.Val>,
  hh: {Laws.cv.own1(vv) == Laws.cv.raw1(ii) : T.Val},
  h2: {Laws.own.rows(ac2) == List.reverse.go(&2, T.Val, Laws.cv.raw(tt), Laws.own.rows(vv <> acc)) : List<&2, T.Val>}
) -> {Laws.own.rows(ac2) == List.reverse.go(&2, T.Val, Laws.cv.raw(ii <> tt), Laws.own.rows(acc)) : List<&2, T.Val>}:
  Equal.trans(List<&2, T.Val>, Laws.own.rows(ac2),
    List.reverse.go(&2, T.Val, Laws.cv.raw(tt), Laws.own.rows(vv <> acc)),
    List.reverse.go(&2, T.Val, Laws.cv.raw(ii <> tt), Laws.own.rows(acc)), h2,
    Equal.trans(List<&2, T.Val>, List.reverse.go(&2, T.Val, Laws.cv.raw(tt), Laws.own.rows(vv <> acc)),
      List.reverse.go(&2, T.Val, Laws.cv.raw(tt), Laws.cv.own1(vv) <> Laws.own.rows(acc)),
      List.reverse.go(&2, T.Val, Laws.cv.raw(ii <> tt), Laws.own.rows(acc)),
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => List.reverse.go(&2, T.Val, Laws.cv.raw(tt), ys),
        Laws.own.rows(vv <> acc), Laws.cv.own1(vv) <> Laws.own.rows(acc), cv.own.cons(vv, acc)),
      Equal.trans(List<&2, T.Val>, List.reverse.go(&2, T.Val, Laws.cv.raw(tt), Laws.cv.own1(vv) <> Laws.own.rows(acc)),
        List.reverse.go(&2, T.Val, Laws.cv.raw1(ii) <> Laws.cv.raw(tt), Laws.own.rows(acc)),
        List.reverse.go(&2, T.Val, Laws.cv.raw(ii <> tt), Laws.own.rows(acc)),
        Equal.cong(T.Val, List<&2, T.Val>, yy => List.reverse.go(&2, T.Val, Laws.cv.raw(tt), yy <> Laws.own.rows(acc)),
          Laws.cv.own1(vv), Laws.cv.raw1(ii), hh),
        Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => List.reverse.go(&2, T.Val, ys, Laws.own.rows(acc)),
          Laws.cv.raw1(ii) <> Laws.cv.raw(tt), Laws.cv.raw(ii <> tt),
          Equal.sym(List<&2, T.Val>, Laws.cv.raw(ii <> tt), Laws.cv.raw1(ii) <> Laws.cv.raw(tt),
            cv.raw.cons(ii, tt))))))

# `]` in LArr closes the array: what the frame holds, reversed, is put
def cv.close0(
  +acc: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  then: cv.ThenA([], acc, ps0, he0, rw, hs, sk, ab, rest, PP)
) -> PP(T.doc.read(SCon{']', rest}, T.MScan{cv.ar(acc, ps0, he0, rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  pp.step(PP, T.doc.read(SCon{']', rest}, T.MScan{cv.ar(acc, ps0, he0, rw, hs, he, ps, bk, qk, sk, un, lf, ab)}),
    T.doc.read(rest, T.MScan{cv.put(sk, T.VArr{List.reverse(&2, T.Val, acc)}, rw, hs, he0, ps0, bk, qk, un, lf, ab)}),
    Equal.cong(T.St, T.Doc, st => T.doc.read(rest, T.MScan{st}),
      T.read.once2(cv.put(sk, T.VArr{List.reverse(&2, T.Val, acc)}, rw, hs, he0, ps0, bk, qk, un, lf, ab)),
      cv.put(sk, T.VArr{List.reverse(&2, T.Val, acc)}, rw, hs, he0, ps0, bk, qk, un, lf, ab),
      Equal.sym(T.St, cv.put(sk, T.VArr{List.reverse(&2, T.Val, acc)}, rw, hs, he0, ps0, bk, qk, un, lf, ab),
        T.read.once2(cv.put(sk, T.VArr{List.reverse(&2, T.Val, acc)}, rw, hs, he0, ps0, bk, qk, un, lf, ab)),
        tk.once(sk, T.VArr{List.reverse(&2, T.Val, acc)}, "", rw, hs, he0, ps0, bk, qk, un, lf, ab, False{}))),
    then(acc, bk, qk, un, lf, {==}))

# the claim for the items after one, from the frame with any value put onto
# it and any fields that value leaves
def cv.IhA(
  +tt: List<&2, T.Val>,
  +acc: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @v2: T.Val -> @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    cv.G(tt, False{}, v2 <> acc, ps0, he0, rw, hs, he0, ps0, b2, q2, sk, u2, l2, ab, rest, PP)

# after an item: `]` closes the array, and ", " waits for the next item
def cv.after(
  tt: List<&2, T.Val>,
  ii: T.Val,
  +vv: T.Val,
  +acc: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  hh: {Laws.cv.own1(vv) == Laws.cv.raw1(ii) : T.Val},
  ih_t: cv.IhA(tt, acc, ps0, he0, rw, hs, sk, ab, rest, PP),
  hwt: {T.wf.go(tt, T.WfItems{}) == True{} : Bool},
  hst: {Laws.cv.shorts(tt) == True{} : Bool},
  hn: {Laws.cv.end(rest) == True{} : Bool},
  then: cv.ThenA(ii <> tt, acc, ps0, he0, rw, hs, sk, ab, rest, PP)
) -> PP(T.doc.read(cv.tl(tt, ']', rest), T.MScan{cv.put(T.CArr{acc, ps0, he0} <> sk, vv, rw, hs, he, ps, bk, qk, un,
  lf, ab)})):
  match tt:
    case []:
      pp.step(PP, T.doc.read(SCon{']', rest}, T.MScan{cv.put(T.CArr{acc, ps0, he0} <> sk, vv, rw, hs, he, ps, bk, qk,
        un, lf, ab)}),
        T.doc.read(rest, T.MScan{cv.put(sk, T.VArr{List.reverse(&2, T.Val, vv <> acc)}, rw, hs, he0, ps0, bk, qk, un,
          lf, ab)}),
        Equal.cong(T.St, T.Doc, st => T.doc.read(rest, T.MScan{st}),
          T.read.once2(cv.put(sk, T.VArr{List.reverse(&2, T.Val, vv <> acc)}, rw, hs, he0, ps0, bk, qk, un, lf, ab)),
          cv.put(sk, T.VArr{List.reverse(&2, T.Val, vv <> acc)}, rw, hs, he0, ps0, bk, qk, un, lf, ab),
          Equal.sym(T.St, cv.put(sk, T.VArr{List.reverse(&2, T.Val, vv <> acc)}, rw, hs, he0, ps0, bk, qk, un, lf,
            ab), T.read.once2(cv.put(sk, T.VArr{List.reverse(&2, T.Val, vv <> acc)}, rw, hs, he0, ps0, bk, qk, un, lf,
            ab)), tk.once(sk, T.VArr{List.reverse(&2, T.Val, vv <> acc)}, "", rw, hs, he0, ps0, bk, qk, un, lf, ab,
            False{}))),
        then(vv <> acc, bk, qk, un, lf, cv.grew(ii, [], vv, acc, vv <> acc, hh, {==})))
    case +h2 <> +t2:
      ih_t(vv, bk, qk, un, lf)(hwt, hst, hn,
        +ac2 => b3 => q3 => u3 => l3 => h3 => then(ac2, b3, q3, u3, l3, cv.grew(ii, h2 <> t2, vv, acc, ac2, hh, h3)))

# an item, then what follows it: the item is read as a value, from LVal with
# back at LVal, and put onto the frame
def cv.item(
  +ii: T.Val,
  +tt: List<&2, T.Val>,
  +acc: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  rd: cv.Rd(ii, rw, hs, he, ps, T.LVal{}, qk, T.CArr{acc, ps0, he0} <> sk, un, lf, ab, cv.tl(tt, ']', rest), PP),
  ih_t: cv.IhA(tt, acc, ps0, he0, rw, hs, sk, ab, rest, PP),
  +hw: {Laws.cv.wf(ii) == True{} : Bool},
  hwt: {T.wf.go(tt, T.WfItems{}) == True{} : Bool},
  hst: {Laws.cv.shorts(tt) == True{} : Bool},
  +hn: {Laws.cv.end(rest) == True{} : Bool},
  then: cv.ThenA(ii <> tt, acc, ps0, he0, rw, hs, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(T.render.go(ii <> tt, ", ", False{}), SCon{']', rest}), T.MScan{cv.ar(acc, ps0, he0,
  rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  +zz = {cv.tl(tt, ']', rest) : String}
  pp.step(PP, T.doc.read(String.append(T.render.go(ii <> tt, ", ", False{}), SCon{']', rest}), T.MScan{cv.ar(acc, ps0,
    he0, rw, hs, he, ps, bk, qk, sk, un, lf, ab)}),
    T.doc.read(Laws.cv.tx(ii, zz), T.MScan{cv.vp(rw, hs, he, ps, T.LVal{}, qk, T.CArr{acc, ps0, he0} <> sk, un, lf,
      ab)}),
    Equal.trans(T.Doc,
      T.doc.read(String.append(T.render.go(ii <> tt, ", ", False{}), SCon{']', rest}), T.MScan{cv.ar(acc, ps0, he0,
        rw, hs, he, ps, bk, qk, sk, un, lf, ab)}),
      T.doc.read(Laws.cv.tx(ii, zz), T.MScan{cv.ar(acc, ps0, he0, rw, hs, he, ps, bk, qk, sk, un, lf, ab)}),
      T.doc.read(Laws.cv.tx(ii, zz), T.MScan{cv.vp(rw, hs, he, ps, T.LVal{}, qk, T.CArr{acc, ps0, he0} <> sk, un, lf,
        ab)}),
      Equal.cong(String, T.Doc, xs => T.doc.read(xs, T.MScan{cv.ar(acc, ps0, he0, rw, hs, he, ps, bk, qk, sk, un, lf,
        ab)}), String.append(T.render.go(ii <> tt, ", ", False{}), SCon{']', rest}), Laws.cv.tx(ii, zz),
        cv.itx(ii, tt, ']', rest, hw)),
      cv.a2v(Laws.cv.tx(ii, zz), rw, hs, he, ps, bk, qk, T.CArr{acc, ps0, he0} <> sk, un, lf, ab, cv.xb(ii, zz, hw))),
    rd(cv.tl.end(tt, rest), +vv => b2 => q2 => u2 => l2 => hh => cv.after(tt, ii, vv, acc, ps0, he0, rw, hs, he, ps,
      b2, q2, sk, u2, l2, ab, rest, PP, hh, ih_t, hwt, hst, hn, then)))

# Inline tables. An inline table's key is read from any uni and left: a
# string value before it, in the same inline table, may have left them
# anywhere a \u escape puts them. WP0's quoted-segment family fixes both at
# 0, so a quoted key is read here by the same family over a scanner that
# keeps them as parameters, as WP-S's ls does for a string (qu).

# a scanner inside a quoted key, its characters so far reversed in buf, back
# wherever the last escape left it, and uni and left as they are
def qu(
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  ab: Bool,
  bk: T.Lex,
  un: U32,
  lf: U32,
  buf: List<&2, Char>
) -> T.St:
  T.St{"", rw, hs, he, ps, buf, T.LKeyQ{}, bk, T.QBasic{}, sk, T.HNone{}, un, lf, ab, False{}}

# the rest of the walk from a quoted key with buf in its buffer, whatever
# back, uni and left are
def qu.Then(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @b2: T.Lex -> @u2: U32 -> @l2: U32 ->
    PP(T.doc.read(rest, T.MScan{qu(rw, hs, he, ps, sk, ab, b2, u2, l2, buf)}))

# one character's escape read in a quoted key, then the rest of the text
def qu.Goal(
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  qu.Then(rw, hs, he, ps, sk, ab, Chr{uu} <> buf, rest, PP) ->
    PP(T.doc.read(String.append(Laws.esc(Chr{uu}), rest), T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)}))

# the fast step of a character in a quoted key is the key's full step
def qu.fast(
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.read.fast(qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}) == T.read.once2(T.lex.kq.go(U32.is_eq(uu, 34),
  U32.is_eq(uu, 92), True{}, Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf),
  Chr{uu}, T.LAfter{}, T.LKeyQ{})) : T.St}:
  {==}

# a character that is no control is pushed: str.bad passes it
def qu.char(
  ctl: Bool,
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hc: {ctl == False{} : Bool}
) -> {T.read.once2(T.lex.kq.char.go(T.str.bad.go(ctl, U32.is_eq(uu, 9), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)),
  False{}), qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}, T.LKeyQ{}))
  == qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}:
  match ctl:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.char.go(T.str.bad.go(True{}, U32.is_eq(uu, 9),
        Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), False{}), qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu},
        T.LKeyQ{})) == qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}, hc)

# a character that is no quote, no backslash and no newline is no closer and
# no escape
def qu.go(
  quote: Bool,
  bs: Bool,
  nl: Bool,
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool},
  hb: {bs == False{} : Bool},
  hn: {nl == False{} : Bool},
  hc: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool}
) -> {T.read.once2(T.lex.kq.go(quote, bs, True{}, nl, qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}, T.LAfter{},
  T.LKeyQ{})) == qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}:
  match quote:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(True{}, bs, True{}, nl, qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf),
        Chr{uu}, T.LAfter{}, T.LKeyQ{})) == qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}, hq)
    case False{}:
      match bs:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, True{}, True{}, nl, qu(rw, hs, he, ps, sk, ab, bk, un,
            lf, buf), Chr{uu}, T.LAfter{}, T.LKeyQ{})) == qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)
            : T.St}, hb)
        case False{}:
          match nl:
            case True{}:
              Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, False{}, True{}, True{}, qu(rw, hs, he, ps, sk,
                ab, bk, un, lf, buf), Chr{uu}, T.LAfter{}, T.LKeyQ{})) == qu(rw, hs, he, ps, sk, ab, bk, un, lf,
                Chr{uu} <> buf) : T.St}, hn)
            case False{}:
              qu.char(Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, hc)

# the fast step pushes a character
def qu.Fast(
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> Type:
  {T.read.fast(qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu})
    == qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}

# the doc.scan dispatch sends such a character to the fast step, and an
# apostrophe comes back from doc.wrap in the key's state
def qu.q(
  dq: Bool,
  sq: Bool,
  cr: Bool,
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {dq == False{} : Bool},
  hr: {cr == False{} : Bool},
  fast: qu.Fast(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf)
) -> {T.doc.scan.q(dq, sq, cr, qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu})
  == T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)} : T.Mode}:
  match dq:
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.scan.q(True{}, sq, cr, qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu})
        == T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)} : T.Mode}, hq)
    case False{}:
      match sq:
        case True{}:
          Equal.cong(T.St, T.Mode, st => T.doc.wrap(st),
            T.read.fast(qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}),
            qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf), fast)
        case False{}:
          match cr:
            case True{}:
              Eq.bit.absurd2(&2, {T.doc.scan.q(False{}, False{}, True{}, qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf),
                Chr{uu}) == T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)} : T.Mode}, hr)
            case False{}:
              Equal.cong(T.St, T.Mode, st => T.MScan{st},
                T.read.fast(qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}),
                qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf), fast)

# a character written as itself is pushed, and back, uni and left stay
def qu.plain(
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +e34: {U32.is_eq(uu, 34) == False{} : Bool},
  +e92: {U32.is_eq(uu, 92) == False{} : Bool},
  +ec: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool},
  ih: qu.Then(rw, hs, he, ps, sk, ab, Chr{uu} <> buf, rest, PP)
) -> PP(T.doc.read(String.append(Laws.esc(Chr{uu}), rest), T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  +e10 = {ctl.off(uu, 10, ec, {==}) : {U32.is_eq(uu, 10) == False{} : Bool}}
  +e13 = {ctl.off(uu, 13, ec, {==}) : {U32.is_eq(uu, 13) == False{} : Bool}}
  %Equal.sym(String, Laws.esc(Chr{uu}), SCon{Chr{uu}, SNil{}}, esc.pl2(uu, e34, e92, ec)) :
    PP(T.doc.read(String.append(_, rest), T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)}))
  pp.step(PP,
    T.doc.read(rest, T.doc.scan(qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu})),
    T.doc.read(rest, T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)}),
    Equal.cong(T.Mode, T.Doc, md => T.doc.read(rest, md),
      T.doc.scan(qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}),
      T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)},
      qu.q(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13), uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, e34,
        e13, Equal.trans(T.St, T.read.fast(qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}),
          T.read.once2(T.lex.kq.go(U32.is_eq(uu, 34), U32.is_eq(uu, 92), True{},
            Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu},
            T.LAfter{}, T.LKeyQ{})),
          qu(rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf),
          qu.fast(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf),
          qu.go(U32.is_eq(uu, 34), U32.is_eq(uu, 92), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), uu, rw, hs, he,
            ps, sk, ab, bk, un, lf, buf, e34, e92, or.ff(U32.is_eq(uu, 10), U32.is_eq(uu, 13), e10, e13), ec)))),
    ih(bk, un, lf))

# a quotation mark: its escape reads back by computation, and leaves back at
# the key's state and uni and left as they were
def qu.q34(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> qu.Goal(34, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP):
  ih => ih(T.LKeyQ{}, un, lf)

# and a backslash
def qu.q92(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> qu.Goal(92, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP):
  ih => ih(T.LKeyQ{}, un, lf)

# CTL: qu.Goal with the escape's text as ss, for ctl.esc.all
def qu.GoalS(
  +uu: U32,
  ss: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  qu.Then(rw, hs, he, ps, sk, ab, Chr{uu} <> buf, rest, PP) ->
    PP(T.doc.read(String.append(ss, rest), T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)}))

# a control: each of the thirty-three escapes reads back by computation and
# leaves back at the key's state. The five with a letter (\b, \t, \n, \f,
# \r) leave uni and left as they were; a \u escape leaves both at 0
def qu.ctl(
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  h_c: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == True{} : Bool}
) -> qu.Goal(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP):
  ctl.esc.all(kk => ss => qu.GoalS(kk, ss, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP), uu, h_c,
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, un, lf),
    ih => ih(T.LKeyQ{}, un, lf),
    ih => ih(T.LKeyQ{}, un, lf),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, un, lf),
    ih => ih(T.LKeyQ{}, un, lf),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0),
    ih => ih(T.LKeyQ{}, 0, 0))

# one code point k that the test found: its answer answers for the character
def qu.is(
  +uu: U32,
  +kk: U32,
  ee: {U32.is_eq(uu, kk) == True{} : Bool},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  at: qu.Goal(kk, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP)
) -> qu.Goal(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP):
  eu = Equal.cong(Char, U32, cc => Char.to_u32(cc), Chr{uu}, Chr{kk}, Eq.u32_eq(uu, kk, ee))
  %Equal.sym(U32, uu, kk, eu) : qu.Goal(_, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP)
  at

# every character: a quote, a backslash, a control, or one written as itself
def qu.split(
  +uu: U32,
  q34: Bool,
  b92: Bool,
  ctl: Bool,
  +e34: {U32.is_eq(uu, 34) == q34 : Bool},
  +e92: {U32.is_eq(uu, 92) == b92 : Bool},
  +ec: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == ctl : Bool},
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> qu.Goal(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP):
  match q34:
    case True{}:
      qu.is(uu, 34, e34, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP,
        qu.q34(rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP))
    case False{}:
      match b92:
        case True{}:
          qu.is(uu, 92, e92, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP,
            qu.q92(rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP))
        case False{}:
          match ctl:
            case True{}:
              qu.ctl(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, ec)
            case False{}:
              ih => qu.plain(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, e34, e92, ec, ih)

# one character of a quoted key
def qu.one(
  +uu: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> qu.Goal(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP):
  qu.split(uu, U32.is_eq(uu, 34), U32.is_eq(uu, 92), Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), {==}, {==}, {==},
    rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP)

# every character of a name, as escs writes it, read in a quoted key: the
# rest is read with the characters pushed, from wherever the last escape
# left back, uni and left
def qu.escs(
  ss: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  ih: qu.Then(rw, hs, he, ps, sk, ab, rev.onto(ss, buf), rest, PP)
) -> PP(T.doc.read(String.append(Laws.escs(ss), rest), T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match ss:
    case SNil{}:
      ih(bk, un, lf)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+uu}:
          pp.step(PP,
            T.doc.read(String.append(String.append(Laws.esc(Chr{uu}), Laws.escs(tt)), rest),
              T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
            T.doc.read(String.append(Laws.esc(Chr{uu}), String.append(Laws.escs(tt), rest)),
              T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
            Equal.cong(String, T.Doc, xs => T.doc.read(xs, T.MScan{qu(rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
              String.append(String.append(Laws.esc(Chr{uu}), Laws.escs(tt)), rest),
              String.append(Laws.esc(Chr{uu}), String.append(Laws.escs(tt), rest)),
              Eq.append_assoc(Laws.esc(Chr{uu}), Laws.escs(tt), rest)),
            qu.one(uu, rw, hs, he, ps, sk, ab, bk, un, lf, buf, String.append(Laws.escs(tt), rest), PP)(
              b2 => u2 => l2 => qu.escs(tt, rw, hs, he, ps, sk, ab, b2, u2, l2, Chr{uu} <> buf, rest, PP, ih)))

# An inline table's key, from the state after `{` or ", " (LInlK), with the
# frame and every other field as parameters: a quoted key through qu, a bare
# key on the key's fast path, then " = " leaves the scanner waiting for the
# value with the key's name as the one part.

# the scanner waiting for an inline table's key
def cv.ks(
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.St:
  T.St{"", rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}

# the scanner inside a bare key, its characters so far reversed in buf
def cv.kbs(
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool,
  buf: List<&2, Char>
) -> T.St:
  T.St{"", rw, hs, he, [], buf, T.LKey{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}

# the rest of the walk once a key named kk and " = " are read: the scanner
# waits for the value, from whatever back, qkind, uni and left the key left
def cv.KThen(
  +kk: String,
  +yy: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  -PP: T.Doc -> Type
) -> Type:
  @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    PP(T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [kk], b2, q2, sk, u2, l2, ab)}))

# a buffer a name was pushed onto reads as the name
def cv.bufk(+kk: String) -> {T.buf.str(rev.onto(kk, [])) == kk : String}:
  Equal.trans(String, T.buf.str.go(rev.onto(kk, []), ""), String.append(kk, ""), kk, ml.rev(kk, [], ""),
    Eq.append_nil(kk))

# the closing quote of a quoted key and " = ": the key's characters are its
# one part, and the scanner waits for the value
def cv.kq.close(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +kk: String,
  +yy: String
) -> {T.doc.read(SCon{'"', SCon{' ', SCon{'=', SCon{' ', yy}}}}, T.MScan{qu(rw, hs, he, [], sk, ab, bk, un, lf,
  rev.onto(kk, []))}) == T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [kk], bk, T.QBasic{}, sk, un, lf, ab)}) : T.Doc}:
  Equal.cong(String, T.Doc, nm => T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [nm], bk, T.QBasic{}, sk, un, lf, ab)}),
    T.buf.str(rev.onto(kk, [])), kk, cv.bufk(kk))

# a quoted key, as key.basic writes it, then " = "
def cv.kq(
  +kk: String,
  +yy: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  ih: cv.KThen(kk, yy, rw, hs, he, sk, ab, PP)
) -> PP(T.doc.read(String.append(T.key.basic(kk), SCon{' ', SCon{'=', SCon{' ', yy}}}), T.MScan{cv.ks(rw, hs, he,
  bk, qk, sk, un, lf, ab)})):
  +zz = {SCon{' ', SCon{'=', SCon{' ', yy}}} : String}
  %Equal.sym(String, T.key.basic(kk), "\"" ++ Laws.escs(kk) ++ "\"", Laws.basic_escs(kk)) :
    PP(T.doc.read(String.append(_, zz), T.MScan{cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab)}))
  %Equal.sym(String, String.append(String.append(Laws.escs(kk), "\""), zz), String.append(Laws.escs(kk), SCon{'"',
    zz}), Eq.append_assoc(Laws.escs(kk), "\"", zz)) :
    PP(T.doc.read(SCon{'"', _}, T.MScan{cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab)}))
  qu.escs(kk, rw, hs, he, [], sk, ab, bk, un, lf, [], SCon{'"', zz}, PP,
    +b2 => +u2 => +l2 => pp.step(PP, T.doc.read(SCon{'"', zz}, T.MScan{qu(rw, hs, he, [], sk, ab, b2, u2, l2,
      rev.onto(kk, []))}), T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [kk], b2, T.QBasic{}, sk, u2, l2, ab)}),
      cv.kq.close(rw, hs, he, sk, ab, b2, u2, l2, kk, yy), ih(b2, T.QBasic{}, u2, l2)))

# a code point that is a blank or a newline is no bare-key character
def cv.nsp(
  bb: Bool,
  +xx: U32,
  +k1: U32,
  +k2: U32,
  ee: {Bool.or(U32.is_eq(xx, k1), U32.is_eq(xx, k2)) == bb : Bool},
  yes: {T.bare.at(Chr{xx}) == True{} : Bool},
  n1: {T.bare.at(Chr{k1}) == False{} : Bool},
  n2: {T.bare.at(Chr{k2}) == False{} : Bool}
) -> {bb == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.gone(&2, {True{} == False{} : Bool}, or2.no(xx, k1, k2, U32.is_eq(xx, k1), U32.is_eq(xx, k2), {==}, {==},
        ee, ch => T.bare.at(ch), yes, n1, n2))
    case False{}:
      {==}

# a character another bare-key test refuses is not a bare-key character
def cv.nch(
  bb: Bool,
  +cc: Char,
  +kk: Char,
  ee: {Char.is_eq(cc, kk) == bb : Bool},
  yes: {T.bare.at(cc) == True{} : Bool},
  no: {T.bare.at(kk) == False{} : Bool}
) -> {bb == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.gone(&2, {True{} == False{} : Bool}, Eq.refute_char(cc, kk, ch => T.bare.at(ch), ee, yes, no))
    case False{}:
      {==}

# the key dispatch pushes a bare-key character once it is no quote
def cv.kb.b(
  ok: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  fb: {ok == True{} : Bool}
) -> {T.read.once2(T.lex.key.bare(ok, cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, []), cc))
  == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}:
  match ok:
    case True{}:
      {==}
    case False{}:
      Eq.bit.absurd(&2, {T.read.once2(T.lex.key.bare(False{}, cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, []), cc))
        == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, fb)

# and once it is no apostrophe
def cv.kb.l(
  lit: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  fl: {lit == False{} : Bool},
  fb: {T.bare.at(cc) == True{} : Bool}
) -> {T.read.once2(T.lex.key.lit(lit, cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, []), cc))
  == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}:
  match lit:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.key.lit(True{}, cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, []), cc))
        == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, fl)
    case False{}:
      cv.kb.b(T.bare.at(cc), rw, hs, he, bk, qk, sk, un, lf, ab, cc, fb)

# and once it is no quotation mark
def cv.kb.q(
  qq: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  fq: {qq == False{} : Bool},
  fl: {Char.is_eq(cc, '\'') == False{} : Bool},
  fb: {T.bare.at(cc) == True{} : Bool}
) -> {T.read.once2(T.lex.key.q(qq, cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, []), cc))
  == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}:
  match qq:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.key.q(True{}, cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, []), cc))
        == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, fq)
    case False{}:
      cv.kb.l(Char.is_eq(cc, '\''), rw, hs, he, bk, qk, sk, un, lf, ab, cc, fl, fb)

# LInlK passes a character that is no blank, `#` or newline to the key
def cv.kb.ik(
  sp: Bool,
  hash: Bool,
  nl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  fsp: {sp == False{} : Bool},
  fhs: {hash == False{} : Bool},
  fnl: {nl == False{} : Bool},
  fq: {Char.is_eq(cc, '"') == False{} : Bool},
  fl: {Char.is_eq(cc, '\'') == False{} : Bool},
  fb: {T.bare.at(cc) == True{} : Bool}
) -> {T.read.once2(T.lex.inlk.go(sp, hash, nl, cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc))
  == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.inlk.go(True{}, hash, nl, cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc))
        == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, fsp)
    case False{}:
      match hash:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.once2(T.lex.inlk.go(False{}, True{}, nl, cv.ks(rw, hs, he, bk, qk, sk, un, lf,
            ab), cc)) == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, fhs)
        case False{}:
          match nl:
            case True{}:
              Eq.bit.absurd2(&2, {T.read.once2(T.lex.inlk.go(False{}, False{}, True{}, cv.ks(rw, hs, he, bk, qk, sk,
                un, lf, ab), cc)) == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, fnl)
            case False{}:
              cv.kb.q(Char.is_eq(cc, '"'), rw, hs, he, bk, qk, sk, un, lf, ab, cc, fq, fl, fb)

# the fast step of LInlK on such a character
def cv.kb.ws(
  sp: Bool,
  nl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  hsp: {sp == False{} : Bool},
  hnl: {nl == False{} : Bool},
  fsp: {T.ch.sp(cc) == False{} : Bool},
  fhs: {Char.is_eq(cc, '#') == False{} : Bool},
  fnl: {T.ch.nl(cc) == False{} : Bool},
  fq: {Char.is_eq(cc, '"') == False{} : Bool},
  fl: {Char.is_eq(cc, '\'') == False{} : Bool},
  fb: {T.bare.at(cc) == True{} : Bool}
) -> {T.read.fast.ws(sp, nl, False{}, "", rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, un, lf, ab, cc)
  == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.fast.ws(True{}, nl, False{}, "", rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, un, lf, ab,
        cc) == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, hsp)
    case False{}:
      match nl:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.fast.ws(False{}, True{}, False{}, "", rw, hs, he, [], [], T.LInlK{}, bk, qk, sk,
            un, lf, ab, cc) == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [cc]) : T.St}, hnl)
        case False{}:
          cv.kb.ik(T.ch.sp(cc), Char.is_eq(cc, '#'), T.ch.nl(cc), rw, hs, he, bk, qk, sk, un, lf, ab, cc, fsp, fhs, fnl,
            fq, fl, fb)

# the first character of a bare key starts the key
def cv.kb.first(
  +xx: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +fb: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.doc.scan(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx}) == T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf,
  ab, [Chr{xx}])} : T.Mode}:
  +fsp = {cv.nsp(T.ch.sp(Chr{xx}), xx, 32, 9, {==}, fb, {==}, {==}) : {T.ch.sp(Chr{xx}) == False{} : Bool}}
  +fnl = {cv.nsp(T.ch.nl(Chr{xx}), xx, 10, 13, {==}, fb, {==}, {==}) : {T.ch.nl(Chr{xx}) == False{} : Bool}}
  Equal.trans(T.Mode,
    T.doc.scan(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx}),
    T.MScan{T.read.fast(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx})},
    T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [Chr{xx}])},
    scan.other(Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), U32.is_eq(xx, 13),
      cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx}, {==}, {==}, {==}, ch => T.bare.at(ch), fb, {==}, {==}, {==}),
    Equal.cong(T.St, T.Mode, st => T.MScan{st},
      T.read.fast(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx}),
      cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [Chr{xx}]),
      cv.kb.ws(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), rw, hs, he, bk, qk, sk, un, lf, ab, Chr{xx}, fsp, fnl, fsp,
        cv.nch(Char.is_eq(Chr{xx}, '#'), Chr{xx}, '#', {==}, fb, {==}), fnl,
        cv.nch(Char.is_eq(Chr{xx}, '"'), Chr{xx}, '"', {==}, fb, {==}),
        cv.nch(Char.is_eq(Chr{xx}, '\''), Chr{xx}, '\'', {==}, fb, {==}), fb)))

# a later bare-key character stays on the key's fast path
def cv.kb.fast(
  ok: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +buf: List<&2, Char>,
  +cc: Char,
  fb: {ok == True{} : Bool}
) -> {T.read.fast.key(ok, "", rw, hs, he, [], buf, bk, qk, sk, un, lf, ab, cc)
  == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, cc <> buf) : T.St}:
  match ok:
    case True{}:
      {==}
    case False{}:
      Eq.bit.absurd(&2, {T.read.fast.key(False{}, "", rw, hs, he, [], buf, bk, qk, sk, un, lf, ab, cc)
        == cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, cc <> buf) : T.St}, fb)

# one later character of the key, from the scan mode
def cv.kb.step(
  +xx: U32,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +buf: List<&2, Char>,
  +fb: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.doc.scan(cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf), Chr{xx}) == T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un,
  lf, ab, Chr{xx} <> buf)} : T.Mode}:
  Equal.trans(T.Mode,
    T.doc.scan(cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf), Chr{xx}),
    T.MScan{T.read.fast(cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf), Chr{xx})},
    T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, Chr{xx} <> buf)},
    scan.other(Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), U32.is_eq(xx, 13),
      cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf), Chr{xx}, {==}, {==}, {==}, ch => T.bare.at(ch), fb, {==}, {==},
      {==}),
    Equal.cong(T.St, T.Mode, st => T.MScan{st},
      T.read.fast(cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf), Chr{xx}),
      cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, Chr{xx} <> buf),
      cv.kb.fast(T.bare.at(Chr{xx}), rw, hs, he, bk, qk, sk, un, lf, ab, buf, Chr{xx}, fb)))

# a text of bare-key characters is pushed onto the key's buffer
def cv.kb.body(
  ks: String,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +buf: List<&2, Char>,
  +ee: {T.bare.all(String.to_list(ks)) == True{} : Bool}
) -> {T.doc.read(String.append(ks, rr), T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf)})
  == T.doc.read(rr, T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, rev.onto(ks, buf))}) : T.Doc}:
  match ks:
    case SNil{}:
      {==}
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          Equal.trans(T.Doc,
            T.doc.read(String.append(tt, rr), T.doc.scan(cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf), Chr{xx})),
            T.doc.read(String.append(tt, rr), T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, Chr{xx} <> buf)}),
            T.doc.read(rr, T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, rev.onto(tt, Chr{xx} <> buf))}),
            Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, rr), md),
              T.doc.scan(cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, buf), Chr{xx}),
              T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, Chr{xx} <> buf)},
              cv.kb.step(xx, rw, hs, he, bk, qk, sk, un, lf, ab, buf, ball.head(T.bare.at(Chr{xx}),
                String.to_list(tt), ee))),
            cv.kb.body(tt, rr, rw, hs, he, bk, qk, sk, un, lf, ab, Chr{xx} <> buf,
              ball.tail(T.bare.at(Chr{xx}), String.to_list(tt), ee)))

# a space ends a nonempty bare key, and " = " leaves the scanner waiting for
# the value, the key its one part
def cv.kb.eq(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +bb: List<&2, Char>,
  full: {List.is_empty(&2, Char, bb) == False{} : Bool},
  +yy: String
) -> {T.doc.read(SCon{' ', SCon{'=', SCon{' ', yy}}}, T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, bb)})
  == T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [T.buf.str(bb)], bk, qk, sk, un, lf, ab)}) : T.Doc}:
  Equal.trans(T.Doc,
    T.doc.read(SCon{'=', SCon{' ', yy}}, T.MScan{T.read.once2(T.lex.key.end.go(List.is_empty(&2, Char, bb),
      cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, bb), T.LAfter{}))}),
    T.doc.read(SCon{'=', SCon{' ', yy}}, T.MScan{T.read.once2(T.lex.key.end.go(False{},
      cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, bb), T.LAfter{}))}),
    T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [T.buf.str(bb)], bk, qk, sk, un, lf, ab)}),
    Equal.cong(Bool, T.Doc, bt => T.doc.read(SCon{'=', SCon{' ', yy}}, T.MScan{T.read.once2(T.lex.key.end.go(bt,
      cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, bb), T.LAfter{}))}), List.is_empty(&2, Char, bb), False{}, full),
    {==})

# a bare key then " = "
def cv.kb(
  +xx: U32,
  +tt: String,
  +yy: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  +ee: {T.bare.all.step(T.bare.at(Chr{xx}), _u => T.bare.all(String.to_list(tt))) == True{} : Bool},
  ih: cv.KThen(SCon{Chr{xx}, tt}, yy, rw, hs, he, sk, ab, PP)
) -> PP(T.doc.read(String.append(SCon{Chr{xx}, tt}, SCon{' ', SCon{'=', SCon{' ', yy}}}), T.MScan{cv.ks(rw, hs, he, bk,
  qk, sk, un, lf, ab)})):
  +zz = {SCon{' ', SCon{'=', SCon{' ', yy}}} : String}
  +b1 = {rev.onto(tt, [Chr{xx}]) : List<&2, Char>}
  pp.step(PP, T.doc.read(String.append(tt, zz), T.doc.scan(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx})),
    T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [SCon{Chr{xx}, tt}], bk, qk, sk, un, lf, ab)}),
    Equal.trans(T.Doc,
      T.doc.read(String.append(tt, zz), T.doc.scan(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx})),
      T.doc.read(String.append(tt, zz), T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [Chr{xx}])}),
      T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [SCon{Chr{xx}, tt}], bk, qk, sk, un, lf, ab)}),
      Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, zz), md),
        T.doc.scan(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), Chr{xx}),
        T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [Chr{xx}])},
        cv.kb.first(xx, rw, hs, he, bk, qk, sk, un, lf, ab, ball.head(T.bare.at(Chr{xx}), String.to_list(tt), ee))),
      Equal.trans(T.Doc,
        T.doc.read(String.append(tt, zz), T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, [Chr{xx}])}),
        T.doc.read(zz, T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, b1)}),
        T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [SCon{Chr{xx}, tt}], bk, qk, sk, un, lf, ab)}),
        cv.kb.body(tt, zz, rw, hs, he, bk, qk, sk, un, lf, ab, [Chr{xx}], ball.tail(T.bare.at(Chr{xx}),
          String.to_list(tt), ee)),
        Equal.trans(T.Doc,
          T.doc.read(zz, T.MScan{cv.kbs(rw, hs, he, bk, qk, sk, un, lf, ab, b1)}),
          T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [T.buf.str(b1)], bk, qk, sk, un, lf, ab)}),
          T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [SCon{Chr{xx}, tt}], bk, qk, sk, un, lf, ab)}),
          cv.kb.eq(rw, hs, he, bk, qk, sk, un, lf, ab, b1, rev.full(tt, Chr{xx}, []), yy),
          Equal.cong(String, T.Doc, nm => T.doc.read(yy, T.MScan{cv.vp(rw, hs, he, [nm], bk, qk, sk, un, lf, ab)}),
            T.buf.str(b1), SCon{Chr{xx}, tt},
            Equal.trans(String, T.buf.str.go(b1, ""), SCon{Chr{xx}, String.append(tt, "")}, SCon{Chr{xx}, tt},
              ml.rev(tt, [Chr{xx}], ""),
              Equal.cong(String, String, ss => SCon{Chr{xx}, ss}, String.append(tt, ""), tt, Eq.append_nil(tt))))))),
    ih(bk, qk, un, lf))

# a key as key writes it, bare or quoted, then " = "
def cv.key.go(
  bb: Bool,
  +kk: String,
  eb: {T.bare(kk) == bb : Bool},
  +yy: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  ih: cv.KThen(kk, yy, rw, hs, he, sk, ab, PP)
) -> PP(T.doc.read(String.append(T.key.go(bb, kk), SCon{' ', SCon{'=', SCon{' ', yy}}}), T.MScan{cv.ks(rw, hs, he, bk,
  qk, sk, un, lf, ab)})):
  match bb:
    case False{}:
      cv.kq(kk, yy, rw, hs, he, bk, qk, sk, un, lf, ab, PP, ih)
    case True{}:
      match kk:
        case SNil{}:
          Eq.bit.absurd(&1, PP(T.doc.read(String.append(SNil{}, SCon{' ', SCon{'=', SCon{' ', yy}}}),
            T.MScan{cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab)})), eb)
        case SCon{hh, +tt}:
          match hh:
            case Chr{+xx}:
              cv.kb(xx, tt, yy, rw, hs, he, bk, qk, sk, un, lf, ab, PP, eb, ih)

# a key as key writes it, then " = "
def cv.key(
  +kk: String,
  +yy: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  -PP: T.Doc -> Type,
  ih: cv.KThen(kk, yy, rw, hs, he, sk, ab, PP)
) -> PP(T.doc.read(String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', yy}}}), T.MScan{cv.ks(rw, hs, he, bk, qk,
  sk, un, lf, ab)})):
  cv.key.go(T.bare(kk), kk, {==}, yy, rw, hs, he, bk, qk, sk, un, lf, ab, PP, ih)

# LInl, right after `{`, reads the first key as LInlK does after ", ": both
# pass a character that is no blank, newline, `#` or `}` to the key.

# a character LInl keeps for itself or LInlK refuses
def cv.kbad(+cc: Char) -> Bool:
  Bool.or(T.ch.sp(cc), Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, '}'))))

# the first character of a text is no such character
def cv.xkbad(xs: String) -> Bool:
  match xs:
    case SNil{}:
      True{}
    case SCon{+cc, _tt}:
      cv.kbad(cc)

# the two dispatches agree on such a character
def cv.l2k.go(
  sp: Bool,
  hash: Bool,
  end: Bool,
  nl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  fsp: {sp == False{} : Bool},
  fhs: {hash == False{} : Bool},
  fen: {end == False{} : Bool},
  fnl: {nl == False{} : Bool}
) -> {T.read.once2(T.lex.inl.go(sp, hash, end, nl, T.St{"", rw, hs, he, [], [], T.LInl{}, bk, qk, sk, T.HNone{}, un,
  lf, ab, False{}}, cc)) == T.read.once2(T.lex.inlk.go(sp, hash, nl, cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc))
  : T.St}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.inl.go(True{}, hash, end, nl, T.St{"", rw, hs, he, [], [], T.LInl{}, bk,
        qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.read.once2(T.lex.inlk.go(True{}, hash, nl, cv.ks(rw, hs, he,
        bk, qk, sk, un, lf, ab), cc)) : T.St}, fsp)
    case False{}:
      match hash:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.once2(T.lex.inl.go(False{}, True{}, end, nl, T.St{"", rw, hs, he, [], [],
            T.LInl{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.read.once2(T.lex.inlk.go(False{}, True{},
            nl, cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc)) : T.St}, fhs)
        case False{}:
          match end:
            case True{}:
              Eq.bit.absurd2(&2, {T.read.once2(T.lex.inl.go(False{}, False{}, True{}, nl, T.St{"", rw, hs, he, [], [],
                T.LInl{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.read.once2(T.lex.inlk.go(False{},
                False{}, nl, cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc)) : T.St}, fen)
            case False{}:
              match nl:
                case True{}:
                  Eq.bit.absurd2(&2, {T.read.once2(T.lex.inl.go(False{}, False{}, False{}, True{}, T.St{"", rw, hs,
                    he, [], [], T.LInl{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc)) == T.read.once2(
                    T.lex.inlk.go(False{}, False{}, True{}, cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc)) : T.St},
                    fnl)
                case False{}:
                  {==}

# and so do the two fast steps
def cv.l2k.ws(
  sp: Bool,
  nl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  hsp: {sp == False{} : Bool},
  hnl: {nl == False{} : Bool},
  fsp: {T.ch.sp(cc) == False{} : Bool},
  fhs: {Char.is_eq(cc, '#') == False{} : Bool},
  fen: {Char.is_eq(cc, '}') == False{} : Bool},
  fnl: {T.ch.nl(cc) == False{} : Bool}
) -> {T.read.fast.ws(sp, nl, False{}, "", rw, hs, he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab, cc)
  == T.read.fast.ws(sp, nl, False{}, "", rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, un, lf, ab, cc) : T.St}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.fast.ws(True{}, nl, False{}, "", rw, hs, he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab,
        cc) == T.read.fast.ws(True{}, nl, False{}, "", rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, un, lf, ab, cc)
        : T.St}, hsp)
    case False{}:
      match nl:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.fast.ws(False{}, True{}, False{}, "", rw, hs, he, [], [], T.LInl{}, bk, qk, sk,
            un, lf, ab, cc) == T.read.fast.ws(False{}, True{}, False{}, "", rw, hs, he, [], [], T.LInlK{}, bk, qk, sk,
            un, lf, ab, cc) : T.St}, hnl)
        case False{}:
          cv.l2k.go(T.ch.sp(cc), Char.is_eq(cc, '#'), Char.is_eq(cc, '}'), T.ch.nl(cc), rw, hs, he, bk, qk, sk, un,
            lf, ab, cc, fsp, fhs, fen, fnl)

# a text whose first character both pass on reads from LInl as from LInlK
def cv.l2k(
  xs: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +hb: {cv.xkbad(xs) == False{} : Bool}
) -> {T.doc.read(xs, T.MScan{T.St{"", rw, hs, he, [], [], T.LInl{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}})
  == T.doc.read(xs, T.MScan{cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab)}) : T.Doc}:
  match xs:
    case SNil{}:
      Eq.bit.absurd2(&2, {T.doc.read(SNil{}, T.MScan{T.St{"", rw, hs, he, [], [], T.LInl{}, bk, qk, sk, T.HNone{}, un,
        lf, ab, False{}}}) == T.doc.read(SNil{}, T.MScan{cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab)}) : T.Doc}, hb)
    case SCon{+cc, +tt}:
      +r1 = {Eq.or.right_false(T.ch.sp(cc), Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, '}'))),
        hb) : {Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, '}'))) == False{} : Bool}}
      +r2 = {Eq.or.right_false(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, '}')), r1)
        : {Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, '}')) == False{} : Bool}}
      +fsp = {Eq.or.left_false(T.ch.sp(cc), Bool.or(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, '}'))),
        hb) : {T.ch.sp(cc) == False{} : Bool}}
      +fnl = {Eq.or.left_false(T.ch.nl(cc), Bool.or(Char.is_eq(cc, '#'), Char.is_eq(cc, '}')), r1)
        : {T.ch.nl(cc) == False{} : Bool}}
      Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
        T.doc.scan(T.St{"", rw, hs, he, [], [], T.LInl{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}, cc),
        T.doc.scan(cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc),
        scan.fast(Char.is_eq(cc, '"'), Char.is_eq(cc, '\''), U32.is_eq(Char.to_u32(cc), 13),
          T.St{"", rw, hs, he, [], [], T.LInl{}, bk, qk, sk, T.HNone{}, un, lf, ab, False{}},
          cv.ks(rw, hs, he, bk, qk, sk, un, lf, ab), cc,
          cv.l2k.ws(T.ch.sp(cc), T.ch.nl(cc), rw, hs, he, bk, qk, sk, un, lf, ab, cc, fsp, fnl, fsp,
            Eq.or.left_false(Char.is_eq(cc, '#'), Char.is_eq(cc, '}'), r2),
            Eq.or.right_false(Char.is_eq(cc, '#'), Char.is_eq(cc, '}'), r2), fnl)))

# a bare-key character is no such character
def cv.kbad.of(
  sp: Bool,
  nl: Bool,
  hash: Bool,
  end: Bool,
  hsp: {sp == False{} : Bool},
  hnl: {nl == False{} : Bool},
  hhs: {hash == False{} : Bool},
  hen: {end == False{} : Bool}
) -> {Bool.or(sp, Bool.or(nl, Bool.or(hash, end))) == False{} : Bool}:
  match sp:
    case True{}:
      hsp
    case False{}:
      match nl:
        case True{}:
          hnl
        case False{}:
          match hash:
            case True{}:
              hhs
            case False{}:
              hen

# a key as key writes it starts with such a character
def cv.kx.go(
  bb: Bool,
  kk: String,
  eb: {T.bare(kk) == bb : Bool},
  +zz: String
) -> {cv.xkbad(String.append(T.key.go(bb, kk), zz)) == False{} : Bool}:
  match bb:
    case False{}:
      {==}
    case True{}:
      match kk:
        case SNil{}:
          Eq.bit.absurd(&2, {cv.xkbad(String.append(SNil{}, zz)) == False{} : Bool}, eb)
        case SCon{hh, +tt}:
          match hh:
            case Chr{+xx}:
              +fb = {ball.head(T.bare.at(Chr{xx}), String.to_list(tt), eb) : {T.bare.at(Chr{xx}) == True{} : Bool}}
              cv.kbad.of(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), Char.is_eq(Chr{xx}, '#'), Char.is_eq(Chr{xx}, '}'),
                cv.nsp(T.ch.sp(Chr{xx}), xx, 32, 9, {==}, fb, {==}, {==}),
                cv.nsp(T.ch.nl(Chr{xx}), xx, 10, 13, {==}, fb, {==}, {==}),
                cv.nch(Char.is_eq(Chr{xx}, '#'), Chr{xx}, '#', {==}, fb, {==}),
                cv.nch(Char.is_eq(Chr{xx}, '}'), Chr{xx}, '}', {==}, fb, {==}))

# the text of a pair render writes starts with such a character
def cv.kx(+kk: String, +zz: String) -> {cv.xkbad(String.append(T.key(kk), zz)) == False{} : Bool}:
  cv.kx.go(T.bare(kk), kk, {==}, zz)

# The pairs of an inline table: the text render writes for one, what
# well-formedness says of it, and the names read so far.

# a pair of a scalar, then the separator, the rest and the closer
def cv.pat(
  +kk: String,
  +aa: String,
  +vs: List<&2, T.Val>,
  +close: Char,
  +xx: String
) -> {String.append(String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', String.append(aa, cv.S(vs))}}}), SCon{close,
  xx}) == String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', String.append(aa, cv.tl(vs, close, xx))}}}) : String}:
  Equal.trans(String,
    String.append(String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', String.append(aa, cv.S(vs))}}}), SCon{close,
      xx}),
    String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', String.append(String.append(aa, cv.S(vs)), SCon{close,
      xx})}}}),
    String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', String.append(aa, cv.tl(vs, close, xx))}}}),
    Eq.append_assoc(T.key(kk), SCon{' ', SCon{'=', SCon{' ', String.append(aa, cv.S(vs))}}}, SCon{close, xx}),
    Equal.cong(String, String, zz => String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', zz}}}),
      String.append(String.append(aa, cv.S(vs)), SCon{close, xx}), String.append(aa, cv.tl(vs, close, xx)),
      cv.at(aa, vs, close, xx)))

# a pair of an array or an inline table, then the separator, the rest and
# the closer
def cv.pcl(
  +kk: String,
  +c1: Char,
  +rr: String,
  +c2: Char,
  +vs: List<&2, T.Val>,
  +close: Char,
  +xx: String
) -> {String.append(String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', SCon{c1, String.append(rr, SCon{c2,
  cv.S(vs)})}}}}), SCon{close, xx}) == String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', SCon{c1, String.append(rr,
  SCon{c2, cv.tl(vs, close, xx)})}}}}) : String}:
  Equal.trans(String,
    String.append(String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', SCon{c1, String.append(rr, SCon{c2,
      cv.S(vs)})}}}}), SCon{close, xx}),
    String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', SCon{c1, String.append(String.append(rr, SCon{c2,
      cv.S(vs)}), SCon{close, xx})}}}}),
    String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', SCon{c1, String.append(rr, SCon{c2, cv.tl(vs, close,
      xx)})}}}}),
    Eq.append_assoc(T.key(kk), SCon{' ', SCon{'=', SCon{' ', SCon{c1, String.append(rr, SCon{c2, cv.S(vs)})}}}},
      SCon{close, xx}),
    Equal.cong(String, String, zz => String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', SCon{c1, zz}}}}),
      String.append(String.append(rr, SCon{c2, cv.S(vs)}), SCon{close, xx}),
      String.append(rr, SCon{c2, cv.tl(vs, close, xx)}), cv.cl(rr, c2, vs, close, xx)))

# a pair and the rest of the pairs, then the closer: the key, " = ", the
# value's text, then what follows it
def cv.ptx(
  +kk: String,
  vv: T.Val,
  +tt: List<&2, T.Val>,
  +close: Char,
  +xx: String,
  hw: {Laws.cv.wf(vv) == True{} : Bool}
) -> {String.append(T.render.go(T.VPair{kk, vv} <> tt, ", ", False{}), SCon{close, xx}) == String.append(T.key(kk),
  SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(vv, cv.tl(tt, close, xx))}}}) : String}:
  match vv:
    case T.VArr{+items}:
      cv.pcl(kk, '[', T.render.go(items, ", ", False{}), ']', tt, close, xx)
    case T.VInl{+rows}:
      cv.pcl(kk, '{', T.render.go(rows, ", ", False{}), '}', tt, close, xx)
    case T.VStr{+aa}:
      cv.pat(kk, T.render.atom(T.VStr{aa}), tt, close, xx)
    case T.VSpan{+aa, +bb}:
      cv.pat(kk, T.render.atom(T.VSpan{aa, bb}), tt, close, xx)
    case T.VInt{+aa, +bb}:
      cv.pat(kk, T.render.atom(T.VInt{aa, bb}), tt, close, xx)
    case T.VFlo{+aa, +bb}:
      cv.pat(kk, T.render.atom(T.VFlo{aa, bb}), tt, close, xx)
    case T.VBool{+aa}:
      cv.pat(kk, T.render.atom(T.VBool{aa}), tt, close, xx)
    case T.VWhen{+aa}:
      cv.pat(kk, T.render.atom(T.VWhen{aa}), tt, close, xx)
    case T.VHead{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VPair{kk, T.VHead{aa, bb}} <> tt, ", ", False{}), SCon{close, xx})
        == String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(T.VHead{aa, bb}, cv.tl(tt, close,
        xx))}}}) : String}, hw)
    case T.VAot{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VPair{kk, T.VAot{aa, bb}} <> tt, ", ", False{}), SCon{close, xx})
        == String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(T.VAot{aa, bb}, cv.tl(tt, close,
        xx))}}}) : String}, hw)
    case T.VAots{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VPair{kk, T.VAots{aa, bb}} <> tt, ", ", False{}), SCon{close,
        xx}) == String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(T.VAots{aa, bb}, cv.tl(tt, close,
        xx))}}}) : String}, hw)
    case T.VPair{aa, bb}:
      Eq.bit.absurd(&2, {String.append(T.render.go(T.VPair{kk, T.VPair{aa, bb}} <> tt, ", ", False{}), SCon{close,
        xx}) == String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(T.VPair{aa, bb}, cv.tl(tt, close,
        xx))}}}) : String}, hw)

# the part of a check that held
def cv.thl(
  ok: Bool,
  -more: Unit -> Bool,
  hh: {T.wf.then(ok, more) == True{} : Bool}
) -> {ok == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      hh

# and the rest of it
def cv.thr(
  ok: Bool,
  -more: Unit -> Bool,
  hh: {T.wf.then(ok, more) == True{} : Bool}
) -> {more(Unit{}) == True{} : Bool}:
  match ok:
    case True{}:
      hh
    case False{}:
      Eq.bit.absurd(&2, {more(Unit{}) == True{} : Bool}, hh)

# what wf.go says of an array's first item: it may sit in a value position
def cv.wfi.hd(
  ii: T.Val,
  +tt: List<&2, T.Val>,
  hw: {T.wf.go(ii <> tt, T.WfItems{}) == True{} : Bool}
) -> {Laws.cv.wf(ii) == True{} : Bool}:
  match ii:
    case T.VArr{+items}:
      cv.thl(T.wf.go(items, T.WfItems{}), _v => T.wf.go(tt, T.WfItems{}), hw)
    case T.VInl{+rows}:
      cv.thl(T.wf.go(rows, T.WfInl{}), _v => T.wf.go(tt, T.WfItems{}), hw)
    case T.VStr{+aa}:
      cv.thl(T.wf.atom(T.VStr{aa}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VSpan{+aa, +bb}:
      cv.thl(T.wf.atom(T.VSpan{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VInt{+aa, +bb}:
      cv.thl(T.wf.atom(T.VInt{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VFlo{+aa, +bb}:
      cv.thl(T.wf.atom(T.VFlo{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VBool{+aa}:
      cv.thl(T.wf.atom(T.VBool{aa}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VWhen{+aa}:
      cv.thl(T.wf.atom(T.VWhen{aa}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VHead{+aa, +bb}:
      cv.thl(T.wf.atom(T.VHead{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VAot{aa, bb}:
      Eq.bit.absurd(&2, {Laws.cv.wf(T.VAot{aa, bb}) == True{} : Bool}, hw)
    case T.VAots{+aa, +bb}:
      cv.thl(T.wf.atom(T.VAots{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VPair{aa, bb}:
      match bb:
        case T.VHead{_c, _d}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VHead{_c, _d}}) == True{} : Bool}, hw)
        case T.VAots{_c, _d}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VAots{_c, _d}}) == True{} : Bool}, hw)
        case T.VArr{_c}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VArr{_c}}) == True{} : Bool}, hw)
        case T.VInl{_c}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VInl{_c}}) == True{} : Bool}, hw)
        case T.VStr{_c}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VStr{_c}}) == True{} : Bool}, hw)
        case T.VSpan{_c, _d}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VSpan{_c, _d}}) == True{} : Bool}, hw)
        case T.VInt{_c, _d}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VInt{_c, _d}}) == True{} : Bool}, hw)
        case T.VFlo{_c, _d}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VFlo{_c, _d}}) == True{} : Bool}, hw)
        case T.VBool{_c}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VBool{_c}}) == True{} : Bool}, hw)
        case T.VWhen{_c}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VWhen{_c}}) == True{} : Bool}, hw)
        case T.VAot{_c, _d}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VAot{_c, _d}}) == True{} : Bool}, hw)
        case T.VPair{_c, _d}:
          Eq.bit.absurd(&2, {Laws.cv.wf(T.VPair{aa, T.VPair{_c, _d}}) == True{} : Bool}, hw)

# and of the items after it
def cv.wfi.tl(
  ii: T.Val,
  +tt: List<&2, T.Val>,
  hw: {T.wf.go(ii <> tt, T.WfItems{}) == True{} : Bool}
) -> {T.wf.go(tt, T.WfItems{}) == True{} : Bool}:
  match ii:
    case T.VArr{+items}:
      cv.thr(T.wf.go(items, T.WfItems{}), _v => T.wf.go(tt, T.WfItems{}), hw)
    case T.VInl{+rows}:
      cv.thr(T.wf.go(rows, T.WfInl{}), _v => T.wf.go(tt, T.WfItems{}), hw)
    case T.VStr{+aa}:
      cv.thr(T.wf.atom(T.VStr{aa}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VSpan{+aa, +bb}:
      cv.thr(T.wf.atom(T.VSpan{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VInt{+aa, +bb}:
      cv.thr(T.wf.atom(T.VInt{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VFlo{+aa, +bb}:
      cv.thr(T.wf.atom(T.VFlo{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VBool{+aa}:
      cv.thr(T.wf.atom(T.VBool{aa}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VWhen{+aa}:
      cv.thr(T.wf.atom(T.VWhen{aa}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VHead{+aa, +bb}:
      cv.thr(T.wf.atom(T.VHead{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VAot{_aa, _bb}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
    case T.VAots{+aa, +bb}:
      cv.thr(T.wf.atom(T.VAots{aa, bb}), _u => T.wf.go(tt, T.WfItems{}), hw)
    case T.VPair{_aa, bb}:
      match bb:
        case T.VHead{_c, _d}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VAots{_c, _d}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VArr{_c}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VInl{_c}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VStr{_c}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VSpan{_c, _d}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VInt{_c, _d}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VFlo{_c, _d}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VBool{_c}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VWhen{_c}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VAot{_c, _d}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)
        case T.VPair{_c, _d}:
          Eq.bit.absurd(&2, {T.wf.go(tt, T.WfItems{}) == True{} : Bool}, hw)

# what wf.go says of an inline table's first pair: its value may sit in a
# value position
def cv.wfp.v(
  +kk: String,
  vv: T.Val,
  +tt: List<&2, T.Val>,
  hw: {T.wf.go(T.VPair{kk, vv} <> tt, T.WfInl{}) == True{} : Bool}
) -> {Laws.cv.wf(vv) == True{} : Bool}:
  match vv:
    case T.VArr{+items}:
      cv.thl(T.wf.go(items, T.WfItems{}), _v => T.wf.go(tt, T.WfInl{}), cv.thr(T.wf.key(kk, tt),
        _u => T.wf.then(T.wf.go(items, T.WfItems{}), _v => T.wf.go(tt, T.WfInl{})), hw))
    case T.VInl{+rows}:
      cv.thl(T.wf.go(rows, T.WfInl{}), _v => T.wf.go(tt, T.WfInl{}), cv.thr(T.wf.key(kk, tt),
        _u => T.wf.then(T.wf.go(rows, T.WfInl{}), _v => T.wf.go(tt, T.WfInl{})), hw))
    case T.VStr{+aa}:
      Eq.and.left(T.wf.atom(T.VStr{aa}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VStr{aa}), T.wf.key(kk, tt)),
        _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VSpan{+aa, +bb}:
      Eq.and.left(T.wf.atom(T.VSpan{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VSpan{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VInt{+aa, +bb}:
      Eq.and.left(T.wf.atom(T.VInt{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VInt{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VFlo{+aa, +bb}:
      Eq.and.left(T.wf.atom(T.VFlo{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VFlo{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VBool{+aa}:
      Eq.and.left(T.wf.atom(T.VBool{aa}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VBool{aa}), T.wf.key(kk, tt)),
        _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VWhen{+aa}:
      Eq.and.left(T.wf.atom(T.VWhen{aa}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VWhen{aa}), T.wf.key(kk, tt)),
        _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VHead{aa, bb}:
      Eq.bit.absurd(&2, {Laws.cv.wf(T.VHead{aa, bb}) == True{} : Bool}, hw)
    case T.VAot{+aa, +bb}:
      Eq.and.left(T.wf.atom(T.VAot{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VAot{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VAots{aa, bb}:
      Eq.bit.absurd(&2, {Laws.cv.wf(T.VAots{aa, bb}) == True{} : Bool}, hw)
    case T.VPair{+aa, +bb}:
      Eq.and.left(T.wf.atom(T.VPair{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VPair{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))

# its name is none of the later pairs'
def cv.wfp.k(
  +kk: String,
  vv: T.Val,
  +tt: List<&2, T.Val>,
  hw: {T.wf.go(T.VPair{kk, vv} <> tt, T.WfInl{}) == True{} : Bool}
) -> {T.wf.key(kk, tt) == True{} : Bool}:
  match vv:
    case T.VArr{+items}:
      cv.thl(T.wf.key(kk, tt), _u => T.wf.then(T.wf.go(items, T.WfItems{}), _v => T.wf.go(tt, T.WfInl{})), hw)
    case T.VInl{+rows}:
      cv.thl(T.wf.key(kk, tt), _u => T.wf.then(T.wf.go(rows, T.WfInl{}), _v => T.wf.go(tt, T.WfInl{})), hw)
    case T.VStr{+aa}:
      Eq.and.right(T.wf.atom(T.VStr{aa}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VStr{aa}), T.wf.key(kk, tt)),
        _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VSpan{+aa, +bb}:
      Eq.and.right(T.wf.atom(T.VSpan{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VSpan{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VInt{+aa, +bb}:
      Eq.and.right(T.wf.atom(T.VInt{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VInt{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VFlo{+aa, +bb}:
      Eq.and.right(T.wf.atom(T.VFlo{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VFlo{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VBool{+aa}:
      Eq.and.right(T.wf.atom(T.VBool{aa}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VBool{aa}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VWhen{+aa}:
      Eq.and.right(T.wf.atom(T.VWhen{aa}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VWhen{aa}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VHead{_aa, _bb}:
      Eq.bit.absurd(&2, {T.wf.key(kk, tt) == True{} : Bool}, hw)
    case T.VAot{+aa, +bb}:
      Eq.and.right(T.wf.atom(T.VAot{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VAot{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))
    case T.VAots{_aa, _bb}:
      Eq.bit.absurd(&2, {T.wf.key(kk, tt) == True{} : Bool}, hw)
    case T.VPair{+aa, +bb}:
      Eq.and.right(T.wf.atom(T.VPair{aa, bb}), T.wf.key(kk, tt), cv.thl(Bool.and(T.wf.atom(T.VPair{aa, bb}),
        T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw))

# and the later pairs are well-formed
def cv.wfp.t(
  +kk: String,
  vv: T.Val,
  +tt: List<&2, T.Val>,
  hw: {T.wf.go(T.VPair{kk, vv} <> tt, T.WfInl{}) == True{} : Bool}
) -> {T.wf.go(tt, T.WfInl{}) == True{} : Bool}:
  match vv:
    case T.VArr{+items}:
      cv.thr(T.wf.go(items, T.WfItems{}), _v => T.wf.go(tt, T.WfInl{}), cv.thr(T.wf.key(kk, tt),
        _u => T.wf.then(T.wf.go(items, T.WfItems{}), _v => T.wf.go(tt, T.WfInl{})), hw))
    case T.VInl{+rows}:
      cv.thr(T.wf.go(rows, T.WfInl{}), _v => T.wf.go(tt, T.WfInl{}), cv.thr(T.wf.key(kk, tt),
        _u => T.wf.then(T.wf.go(rows, T.WfInl{}), _v => T.wf.go(tt, T.WfInl{})), hw))
    case T.VStr{+aa}:
      cv.thr(Bool.and(T.wf.atom(T.VStr{aa}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)
    case T.VSpan{+aa, +bb}:
      cv.thr(Bool.and(T.wf.atom(T.VSpan{aa, bb}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)
    case T.VInt{+aa, +bb}:
      cv.thr(Bool.and(T.wf.atom(T.VInt{aa, bb}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)
    case T.VFlo{+aa, +bb}:
      cv.thr(Bool.and(T.wf.atom(T.VFlo{aa, bb}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)
    case T.VBool{+aa}:
      cv.thr(Bool.and(T.wf.atom(T.VBool{aa}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)
    case T.VWhen{+aa}:
      cv.thr(Bool.and(T.wf.atom(T.VWhen{aa}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)
    case T.VHead{_aa, _bb}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfInl{}) == True{} : Bool}, hw)
    case T.VAot{+aa, +bb}:
      cv.thr(Bool.and(T.wf.atom(T.VAot{aa, bb}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)
    case T.VAots{_aa, _bb}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfInl{}) == True{} : Bool}, hw)
    case T.VPair{+aa, +bb}:
      cv.thr(Bool.and(T.wf.atom(T.VPair{aa, bb}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfInl{}), hw)

# the strings of an item and of the items after it
def cv.sh.item(
  ii: T.Val,
  +tt: List<&2, T.Val>,
  hw: {Laws.cv.wf(ii) == True{} : Bool}
) -> {Laws.cv.shorts(ii <> tt) == Bool.and(Laws.cv.short1(ii), Laws.cv.shorts(tt)) : Bool}:
  match ii:
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{_a, _b}:
      {==}
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}
    case T.VPair{aa, bb}:
      Eq.bit.absurd(&2, {Laws.cv.shorts(T.VPair{aa, bb} <> tt) == Bool.and(Laws.cv.short1(T.VPair{aa, bb}),
        Laws.cv.shorts(tt)) : Bool}, hw)

# the strings of a pair's value and of the pairs after it
def cv.sh.pair(
  +kk: String,
  vv: T.Val,
  +tt: List<&2, T.Val>
) -> {Laws.cv.shorts(T.VPair{kk, vv} <> tt) == Bool.and(Laws.cv.short1(vv), Laws.cv.shorts(tt)) : Bool}:
  match vv:
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{_a, _b}:
      {==}
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}
    case T.VPair{_a, _b}:
      {==}

# Names. The pairs read so far are the inline table's rows, newest first; a
# pair's name must be none of theirs for the walk to put it, and wf says it is
# none of the later pairs'. str.eq is symmetric, so that is the same thing.

# a lookup that missed is a miss
def cv.miss(
  hh: T.Hit,
  ee: {Laws.is_miss(hh) == True{} : Bool}
) -> {hh == T.Miss{} : T.Hit}:
  match hh:
    case T.Miss{}:
      {==}
    case T.Found{vv}:
      Eq.bit.absurd(&2, {T.Found{vv} == T.Miss{} : T.Hit}, ee)

# no name is in an empty table
def cv.fr.nil(rows: List<&2, T.Val>) -> {cv.fr([], rows) == True{} : Bool}:
  match rows:
    case []:
      {==}
    case T.VPair{_kk, _vv} <> tt:
      cv.fr.nil(tt)
    case T.VStr{_a} <> tt:
      cv.fr.nil(tt)
    case T.VSpan{_a, _b} <> tt:
      cv.fr.nil(tt)
    case T.VInt{_a, _b} <> tt:
      cv.fr.nil(tt)
    case T.VFlo{_a, _b} <> tt:
      cv.fr.nil(tt)
    case T.VBool{_a} <> tt:
      cv.fr.nil(tt)
    case T.VWhen{_a} <> tt:
      cv.fr.nil(tt)
    case T.VArr{_a} <> tt:
      cv.fr.nil(tt)
    case T.VInl{_a} <> tt:
      cv.fr.nil(tt)
    case T.VHead{_a, _b} <> tt:
      cv.fr.nil(tt)
    case T.VAot{_a, _b} <> tt:
      cv.fr.nil(tt)
    case T.VAots{_a, _b} <> tt:
      cv.fr.nil(tt)

# two chars compare alike either way round
def cv.ceq.go(
  b1: Bool,
  b2: Bool,
  +xx: Char,
  +yy: Char,
  +e1: {Char.is_eq(xx, yy) == b1 : Bool},
  +e2: {Char.is_eq(yy, xx) == b2 : Bool}
) -> {b1 == b2 : Bool}:
  match b1:
    case True{}:
      match b2:
        case True{}:
          {==}
        case False{}:
          Equal.trans(Bool, True{}, Char.is_eq(yy, xx), False{},
            Equal.trans(Bool, True{}, Char.is_eq(yy, yy), Char.is_eq(yy, xx),
              Equal.sym(Bool, Char.is_eq(yy, yy), True{}, Eq.char_eq_self(yy)),
              Equal.cong(Char, Bool, cc => Char.is_eq(yy, cc), yy, xx,
                Equal.sym(Char, xx, yy, Eq.char_eq_true(xx, yy, e1)))), e2)
    case False{}:
      match b2:
        case True{}:
          Equal.trans(Bool, False{}, Char.is_eq(xx, yy), True{}, Equal.sym(Bool, Char.is_eq(xx, yy), False{}, e1),
            Equal.trans(Bool, Char.is_eq(xx, yy), Char.is_eq(xx, xx), True{},
              Equal.cong(Char, Bool, cc => Char.is_eq(xx, cc), yy, xx, Eq.char_eq_true(yy, xx, e2)),
              Eq.char_eq_self(xx)))
        case False{}:
          {==}

# two chars compare alike either way round
def cv.ceq.sym(+xx: Char, +yy: Char) -> {Char.is_eq(xx, yy) == Char.is_eq(yy, xx) : Bool}:
  cv.ceq.go(Char.is_eq(xx, yy), Char.is_eq(yy, xx), xx, yy, {==}, {==})

# and so do two strings, from any start
def cv.seqs(
  aa: String,
  bb: String,
  ss: Bool
) -> {T.str.eq.step(aa, bb, ss) == T.str.eq.step(bb, aa, ss) : Bool}:
  match aa:
    case SNil{}:
      match bb:
        case SNil{}:
          match ss:
            case True{}:
              {==}
            case False{}:
              {==}
        case SCon{_y, _yt}:
          match ss:
            case True{}:
              {==}
            case False{}:
              {==}
    case SCon{+xx, +xt}:
      match bb:
        case SNil{}:
          match ss:
            case True{}:
              {==}
            case False{}:
              {==}
        case SCon{+yy, +yt}:
          match ss:
            case True{}:
              Equal.trans(Bool, T.str.eq.step(xt, yt, Char.is_eq(xx, yy)), T.str.eq.step(yt, xt, Char.is_eq(xx, yy)),
                T.str.eq.step(yt, xt, Char.is_eq(yy, xx)), cv.seqs(xt, yt, Char.is_eq(xx, yy)),
                Equal.cong(Bool, Bool, bt => T.str.eq.step(yt, xt, bt), Char.is_eq(xx, yy), Char.is_eq(yy, xx),
                  cv.ceq.sym(xx, yy)))
            case False{}:
              {==}

# a lookup that passes a pair tells its name was not the one looked for
def cv.fs.l(
  bb: Bool,
  +xx: T.Val,
  -more: Unit -> T.Hit,
  hh: {T.wf.fresh(T.find.step(bb, xx, more)) == True{} : Bool}
) -> {bb == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, hh)
    case False{}:
      {==}

# and goes on to the rest
def cv.fs.r(
  bb: Bool,
  +xx: T.Val,
  -more: Unit -> T.Hit,
  hh: {T.wf.fresh(T.find.step(bb, xx, more)) == True{} : Bool}
) -> {T.wf.fresh(more(Unit{})) == True{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.absurd(&2, {T.wf.fresh(more(Unit{})) == True{} : Bool}, hh)
    case False{}:
      hh

# both halves of an and
def cv.and2(
  aa: Bool,
  bb: Bool,
  ha: {aa == True{} : Bool},
  hb: {bb == True{} : Bool}
) -> {Bool.and(aa, bb) == True{} : Bool}:
  match aa:
    case True{}:
      hb
    case False{}:
      Eq.bit.absurd(&2, {Bool.and(False{}, bb) == True{} : Bool}, ha)

# a pair put in front keeps every later name missing, once its own name is
# none of theirs
def cv.fr.step(
  tt: List<&2, T.Val>,
  +kk: String,
  +v2: T.Val,
  +inl: List<&2, T.Val>,
  +h1: {cv.fr(inl, tt) == True{} : Bool},
  +h2: {T.wf.fresh(T.get(tt, kk)) == True{} : Bool}
) -> {cv.fr(T.VPair{kk, v2} <> inl, tt) == True{} : Bool}:
  match tt:
    case []:
      {==}
    case T.VPair{+k2, +xx} <> +t2:
      +e1 = {cv.fs.l(T.str.eq(k2, kk), xx, _u => T.rows.find(t2, kk), h2) : {T.str.eq(k2, kk) == False{} : Bool}}
      +e3 = {Equal.trans(Bool, T.str.eq(kk, k2), T.str.eq(k2, kk), False{}, cv.seqs(kk, k2, True{}), e1)
        : {T.str.eq(kk, k2) == False{} : Bool}}
      %Equal.sym(Bool, T.str.eq(kk, k2), False{}, e3) : {Bool.and(Laws.is_miss(T.find.step(_, v2,
        _u => T.rows.find(inl, k2))), cv.fr(T.VPair{kk, v2} <> inl, t2)) == True{} : Bool}
      cv.and2(Laws.is_miss(T.rows.find(inl, k2)), cv.fr(T.VPair{kk, v2} <> inl, t2),
        Eq.and.left(Laws.is_miss(T.get(inl, k2)), cv.fr(inl, t2), h1),
        cv.fr.step(t2, kk, v2, inl, Eq.and.right(Laws.is_miss(T.get(inl, k2)), cv.fr(inl, t2), h1),
          cv.fs.r(T.str.eq(k2, kk), xx, _u => T.rows.find(t2, kk), h2)))
    case T.VStr{_a} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VSpan{_a, _b} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VInt{_a, _b} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VFlo{_a, _b} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VBool{_a} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VWhen{_a} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VArr{_a} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VInl{_a} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VHead{_a, _b} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VAot{_a, _b} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)
    case T.VAots{_a, _b} <> +t2:
      cv.fr.step(t2, kk, v2, inl, h1, h2)

# Values put. A value own reads as the scanner's form of a well-formed value
# is no pair and no table, so a pair of it reads as the pair of that form,
# and sealing an inline table leaves it where it is.

# no pair and no table
def cv.plain(vv: T.Val) -> Bool:
  match vv:
    case T.VPair{_nn, _yy}:
      False{}
    case T.VHead{_pp, _rr}:
      False{}
    case _:
      True{}

# own keeps a value a pair or a table, or neither
def cv.plain.own(xx: T.Val) -> {cv.plain(Laws.cv.own1(xx)) == cv.plain(xx) : Bool}:
  match xx:
    case T.VPair{_nn, yy}:
      match yy:
        case T.VStr{_a}:
          {==}
        case T.VSpan{_a, _b}:
          {==}
        case T.VInt{_a, _b}:
          {==}
        case T.VFlo{_a, _b}:
          {==}
        case T.VBool{_a}:
          {==}
        case T.VWhen{_a}:
          {==}
        case T.VArr{_a}:
          {==}
        case T.VInl{_a}:
          {==}
        case T.VHead{_a, _b}:
          {==}
        case T.VAot{_a, _b}:
          {==}
        case T.VAots{_a, _b}:
          {==}
        case T.VPair{_a, _b}:
          {==}
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{_a, _b}:
      {==}
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}

# the scanner's form of a well-formed value is no pair and no table
def cv.plain.raw(
  vv: T.Val,
  hw: {Laws.cv.wf(vv) == True{} : Bool}
) -> {cv.plain(Laws.cv.raw1(vv)) == True{} : Bool}:
  match vv:
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{aa, bb}:
      Eq.bit.absurd(&2, {cv.plain(Laws.cv.raw1(T.VHead{aa, bb})) == True{} : Bool}, hw)
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}
    case T.VPair{aa, bb}:
      Eq.bit.absurd(&2, {cv.plain(Laws.cv.raw1(T.VPair{aa, bb})) == True{} : Bool}, hw)

# so a value put for it is no pair and no table
def cv.plain.of(
  +vv: T.Val,
  +ww: T.Val,
  hh: {Laws.cv.own1(vv) == Laws.cv.raw1(ww) : T.Val},
  hw: {Laws.cv.wf(ww) == True{} : Bool}
) -> {cv.plain(vv) == True{} : Bool}:
  Equal.trans(Bool, cv.plain(vv), cv.plain(Laws.cv.own1(vv)), True{},
    Equal.sym(Bool, cv.plain(Laws.cv.own1(vv)), cv.plain(vv), cv.plain.own(vv)),
    Equal.trans(Bool, cv.plain(Laws.cv.own1(vv)), cv.plain(Laws.cv.raw1(ww)), True{},
      Equal.cong(T.Val, Bool, xx => cv.plain(xx), Laws.cv.own1(vv), Laws.cv.raw1(ww), hh),
      cv.plain.raw(ww, hw)))

# own reads a pair of a value that is no pair as the pair of what it reads
def cv.own.pair(
  +kk: String,
  vv: T.Val,
  hp: {cv.plain(vv) == True{} : Bool}
) -> {Laws.cv.own1(T.VPair{kk, vv}) == T.VPair{kk, Laws.cv.own1(vv)} : T.Val}:
  match vv:
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{_a, _b}:
      {==}
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}
    case T.VPair{aa, bb}:
      Eq.bit.absurd(&2, {Laws.cv.own1(T.VPair{kk, T.VPair{aa, bb}}) == T.VPair{kk, Laws.cv.own1(T.VPair{aa, bb})}
        : T.Val}, hp)

# and so does the scanner's form
def cv.raw.pair(
  +kk: String,
  vv: T.Val,
  hw: {Laws.cv.wf(vv) == True{} : Bool}
) -> {Laws.cv.raw1(T.VPair{kk, vv}) == T.VPair{kk, Laws.cv.raw1(vv)} : T.Val}:
  match vv:
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{_a, _b}:
      {==}
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}
    case T.VPair{aa, bb}:
      Eq.bit.absurd(&2, {Laws.cv.raw1(T.VPair{kk, T.VPair{aa, bb}}) == T.VPair{kk, Laws.cv.raw1(T.VPair{aa, bb})}
        : T.Val}, hw)

# a pair of a value put reads as the pair of the value render wrote
def cv.lift(
  +kk: String,
  +vv: T.Val,
  +ww: T.Val,
  +hh: {Laws.cv.own1(vv) == Laws.cv.raw1(ww) : T.Val},
  +hw: {Laws.cv.wf(ww) == True{} : Bool}
) -> {Laws.cv.own1(T.VPair{kk, vv}) == Laws.cv.raw1(T.VPair{kk, ww}) : T.Val}:
  Equal.trans(T.Val, Laws.cv.own1(T.VPair{kk, vv}), T.VPair{kk, Laws.cv.own1(vv)}, Laws.cv.raw1(T.VPair{kk, ww}),
    cv.own.pair(kk, vv, cv.plain.of(vv, ww, hh, hw)),
    Equal.trans(T.Val, T.VPair{kk, Laws.cv.own1(vv)}, T.VPair{kk, Laws.cv.raw1(ww)}, Laws.cv.raw1(T.VPair{kk, ww}),
      Equal.cong(T.Val, T.Val, yy => T.VPair{kk, yy}, Laws.cv.own1(vv), Laws.cv.raw1(ww), hh),
      Equal.sym(T.Val, Laws.cv.raw1(T.VPair{kk, ww}), T.VPair{kk, Laws.cv.raw1(ww)}, cv.raw.pair(kk, ww, hw))))

# sealing passes over a pair of a value that is no table
def cv.seal.cons(
  +kk: String,
  vv: T.Val,
  +xs: List<&2, T.Val>,
  hp: {cv.plain(vv) == True{} : Bool}
) -> {T.inl.seal(T.VPair{kk, vv} <> xs) == T.VPair{kk, vv} <> T.inl.seal(xs) : List<&2, T.Val>}:
  match vv:
    case T.VStr{_a}:
      {==}
    case T.VSpan{_a, _b}:
      {==}
    case T.VInt{_a, _b}:
      {==}
    case T.VFlo{_a, _b}:
      {==}
    case T.VBool{_a}:
      {==}
    case T.VWhen{_a}:
      {==}
    case T.VArr{_a}:
      {==}
    case T.VInl{_a}:
      {==}
    case T.VHead{aa, bb}:
      Eq.bit.absurd(&2, {T.inl.seal(T.VPair{kk, T.VHead{aa, bb}} <> xs) == T.VPair{kk, T.VHead{aa, bb}} <>
        T.inl.seal(xs) : List<&2, T.Val>}, hp)
    case T.VAot{_a, _b}:
      {==}
    case T.VAots{_a, _b}:
      {==}
    case T.VPair{_a, _b}:
      {==}

# An inline table's pair. The key is read to the value position with the key
# as the one part; the value is read and put by a walk of that one part into
# the frame's rows (WP-W's put contract, with the rows so far as the table,
# no heads and the inline flag), so it goes in front; the scanner waits in
# LInlC, where ", " goes on to the next key and `}` closes the table.

# the scanner after a pair of an inline table, waiting for ", " or `}`
def cv.ic(
  inl: List<&2, T.Val>,
  ps0: List<&2, String>,
  +he0: List<&2, String>,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.St:
  T.St{"", rw, hs, he0, [], [], T.LInlC{}, bk, qk, T.CInl{inl, ps0, he0} <> sk, T.HNone{}, un, lf, ab, False{}}

# the claim for the pairs after one, from the frame with any pair of the
# name put in front and any fields that value leaves
def cv.IhI(
  +tt: List<&2, T.Val>,
  +kk: String,
  +inl: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @v2: T.Val -> @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    cv.G(tt, True{}, T.VPair{kk, v2} <> inl, ps0, he0, rw, hs, he0, [], b2, q2, sk, u2, l2, ab, rest, PP)

# the reader of a pair's value, from wherever the key left the fields
def cv.RdP(
  +vv: T.Val,
  +kk: String,
  +inl: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +zz: String,
  -PP: T.Doc -> Type
) -> Type:
  @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 -> {Laws.cv.wf(vv) == True{} : Bool} ->
    {Laws.cv.short1(vv) == True{} : Bool} ->
    cv.Rd(vv, rw, hs, he0, [kk], b2, q2, T.CInl{inl, ps0, he0} <> sk, u2, l2, ab, zz, PP)

# the frame's rows once a pair is put in front: sealing still leaves them
def cv.seal.put(
  +kk: String,
  +v2: T.Val,
  +vv: T.Val,
  +inl: List<&2, T.Val>,
  hh: {Laws.cv.own1(v2) == Laws.cv.raw1(vv) : T.Val},
  hwv: {Laws.cv.wf(vv) == True{} : Bool},
  hsl: {T.inl.seal(inl) == inl : List<&2, T.Val>}
) -> {T.inl.seal(T.VPair{kk, v2} <> inl) == T.VPair{kk, v2} <> inl : List<&2, T.Val>}:
  Equal.trans(List<&2, T.Val>, T.inl.seal(T.VPair{kk, v2} <> inl), T.VPair{kk, v2} <> T.inl.seal(inl),
    T.VPair{kk, v2} <> inl, cv.seal.cons(kk, v2, inl, cv.plain.of(v2, vv, hh, hwv)),
    Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => T.VPair{kk, v2} <> ys, T.inl.seal(inl), inl, hsl))

# after the pair is put: `}` closes, ", " goes on
def cv.afteri.go(
  tt: List<&2, T.Val>,
  +kk: String,
  +vv: T.Val,
  +v2: T.Val,
  +inl: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hh: {Laws.cv.own1(v2) == Laws.cv.raw1(vv) : T.Val},
  ih_t: cv.IhI(tt, kk, inl, ps0, he0, rw, hs, sk, ab, rest, PP),
  hwt: {T.wf.go(tt, T.WfInl{}) == True{} : Bool},
  hst: {Laws.cv.shorts(tt) == True{} : Bool},
  hn: {Laws.cv.end(rest) == True{} : Bool},
  hfr: {T.wf.fresh(T.get(tt, kk)) == True{} : Bool},
  hft: {cv.fr(inl, tt) == True{} : Bool},
  hsl: {T.inl.seal(inl) == inl : List<&2, T.Val>},
  +hwv: {Laws.cv.wf(vv) == True{} : Bool},
  then: cv.ThenI(T.VPair{kk, vv} <> tt, inl, ps0, he0, rw, hs, sk, ab, rest, PP)
) -> PP(T.doc.read(cv.tl(tt, '}', rest), T.MScan{cv.ic(T.VPair{kk, v2} <> inl, ps0, he0, rw, hs, bk, qk, sk, un, lf,
  ab)})):
  match tt:
    case []:
      pp.step(PP, T.doc.read(SCon{'}', rest}, T.MScan{cv.ic(T.VPair{kk, v2} <> inl, ps0, he0, rw, hs, bk, qk, sk, un,
        lf, ab)}),
        T.doc.read(rest, T.MScan{cv.put(sk, T.VInl{T.inl.seal(T.VPair{kk, v2} <> inl)}, rw, hs, he0, ps0, bk, qk, un,
          lf, ab)}),
        Equal.cong(T.St, T.Doc, st => T.doc.read(rest, T.MScan{st}),
          T.read.once2(cv.put(sk, T.VInl{T.inl.seal(T.VPair{kk, v2} <> inl)}, rw, hs, he0, ps0, bk, qk, un, lf, ab)),
          cv.put(sk, T.VInl{T.inl.seal(T.VPair{kk, v2} <> inl)}, rw, hs, he0, ps0, bk, qk, un, lf, ab),
          Equal.sym(T.St, cv.put(sk, T.VInl{T.inl.seal(T.VPair{kk, v2} <> inl)}, rw, hs, he0, ps0, bk, qk, un, lf, ab),
            T.read.once2(cv.put(sk, T.VInl{T.inl.seal(T.VPair{kk, v2} <> inl)}, rw, hs, he0, ps0, bk, qk, un, lf,
            ab)), tk.once(sk, T.VInl{T.inl.seal(T.VPair{kk, v2} <> inl)}, "", rw, hs, he0, ps0, bk, qk, un, lf, ab,
            False{}))),
        then(T.VPair{kk, v2} <> inl, bk, qk, un, lf, cv.grew(T.VPair{kk, vv}, [], T.VPair{kk, v2}, inl,
          T.VPair{kk, v2} <> inl, cv.lift(kk, v2, vv, hh, hwv), {==}), cv.seal.put(kk, v2, vv, inl, hh, hwv, hsl)))
    case +h2 <> +t2:
      ih_t(v2, bk, qk, un, lf)({==}, hwt, hst, hn, cv.fr.step(h2 <> t2, kk, v2, inl, hft, hfr),
        cv.seal.put(kk, v2, vv, inl, hh, hwv, hsl),
        +in2 => b4 => q4 => u4 => l4 => hg => hs4 => then(in2, b4, q4, u4, l4, cv.grew(T.VPair{kk, vv}, h2 <> t2,
          T.VPair{kk, v2}, inl, in2, cv.lift(kk, v2, vv, hh, hwv), hg), hs4))

# after a pair's value: the walk puts the pair in front, then `}` closes the
# table and ", " waits for the next key
def cv.afteri(
  +tt: List<&2, T.Val>,
  +kk: String,
  +vv: T.Val,
  +v2: T.Val,
  +inl: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hh: {Laws.cv.own1(v2) == Laws.cv.raw1(vv) : T.Val},
  ih_t: cv.IhI(tt, kk, inl, ps0, he0, rw, hs, sk, ab, rest, PP),
  hwt: {T.wf.go(tt, T.WfInl{}) == True{} : Bool},
  hst: {Laws.cv.shorts(tt) == True{} : Bool},
  hn: {Laws.cv.end(rest) == True{} : Bool},
  hfr: {T.wf.fresh(T.get(tt, kk)) == True{} : Bool},
  hft: {cv.fr(inl, tt) == True{} : Bool},
  hsl: {T.inl.seal(inl) == inl : List<&2, T.Val>},
  +hwv: {Laws.cv.wf(vv) == True{} : Bool},
  em: {T.get(inl, kk) == T.Miss{} : T.Hit},
  then: cv.ThenI(T.VPair{kk, vv} <> tt, inl, ps0, he0, rw, hs, sk, ab, rest, PP)
) -> PP(T.doc.read(cv.tl(tt, '}', rest), T.MScan{cv.put(T.CInl{inl, ps0, he0} <> sk, v2, rw, hs, he0, [kk], bk, qk,
  un, lf, ab)})):
  pp.step(PP, T.doc.read(cv.tl(tt, '}', rest), T.MScan{cv.put(T.CInl{inl, ps0, he0} <> sk, v2, rw, hs, he0, [kk], bk,
    qk, un, lf, ab)}),
    T.doc.read(cv.tl(tt, '}', rest), T.MScan{cv.ic(T.VPair{kk, v2} <> inl, ps0, he0, rw, hs, bk, qk, sk, un, lf, ab)}),
    Equal.cong(T.End, T.Doc, en => T.doc.read(cv.tl(tt, '}', rest), T.MScan{T.take.inl(en, rw, hs, he0, ps0, sk, bk,
      qk, un, lf, ab, False{})}),
      T.tree.walk(List.append(&2, String, [], [kk]), T.Tw{inl, T.JPut{v2}, [], "", "", [], True{}}, 0),
      T.End{Laws.tb.set([], "", inl, T.VPair{kk, v2} <> Laws.tb.rows([], inl)), "", []},
      Laws.walk_put_at_head([], kk, v2, inl, [], 0, True{}, {==}, {==}, em)),
    cv.afteri.go(tt, kk, vv, v2, inl, ps0, he0, rw, hs, bk, qk, sk, un, lf, ab, rest, PP, hh, ih_t, hwt, hst, hn, hfr,
      hft, hsl, hwv, then))

# a pair, then what follows it: the key, " = ", the value, put in front of
# the frame's rows
def cv.pair(
  +kk: String,
  +vv: T.Val,
  +tt: List<&2, T.Val>,
  +inl: List<&2, T.Val>,
  +ps0: List<&2, String>,
  +he0: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  rd: cv.RdP(vv, kk, inl, ps0, he0, rw, hs, sk, ab, cv.tl(tt, '}', rest), PP),
  ih_t: cv.IhI(tt, kk, inl, ps0, he0, rw, hs, sk, ab, rest, PP),
  +hw: {T.wf.go(T.VPair{kk, vv} <> tt, T.WfInl{}) == True{} : Bool},
  +hs2: {Laws.cv.shorts(T.VPair{kk, vv} <> tt) == True{} : Bool},
  hn: {Laws.cv.end(rest) == True{} : Bool},
  +hfi: {cv.fr(inl, T.VPair{kk, vv} <> tt) == True{} : Bool},
  hsl: {T.inl.seal(inl) == inl : List<&2, T.Val>},
  then: cv.ThenI(T.VPair{kk, vv} <> tt, inl, ps0, he0, rw, hs, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(T.render.go(T.VPair{kk, vv} <> tt, ", ", False{}), SCon{'}', rest}),
  T.MScan{cv.ik(inl, ps0, he0, rw, hs, bk, qk, sk, un, lf, ab)})):
  +hwv = {cv.wfp.v(kk, vv, tt, hw) : {Laws.cv.wf(vv) == True{} : Bool}}
  +hsp = {Equal.trans(Bool, Bool.and(Laws.cv.short1(vv), Laws.cv.shorts(tt)), Laws.cv.shorts(T.VPair{kk, vv} <> tt),
    True{}, Equal.sym(Bool, Laws.cv.shorts(T.VPair{kk, vv} <> tt), Bool.and(Laws.cv.short1(vv), Laws.cv.shorts(tt)),
    cv.sh.pair(kk, vv, tt)), hs2) : {Bool.and(Laws.cv.short1(vv), Laws.cv.shorts(tt)) == True{} : Bool}}
  +zz = {cv.tl(tt, '}', rest) : String}
  pp.step(PP, T.doc.read(String.append(T.render.go(T.VPair{kk, vv} <> tt, ", ", False{}), SCon{'}', rest}),
    T.MScan{cv.ik(inl, ps0, he0, rw, hs, bk, qk, sk, un, lf, ab)}),
    T.doc.read(String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(vv, zz)}}}),
      T.MScan{cv.ik(inl, ps0, he0, rw, hs, bk, qk, sk, un, lf, ab)}),
    Equal.cong(String, T.Doc, xs => T.doc.read(xs, T.MScan{cv.ik(inl, ps0, he0, rw, hs, bk, qk, sk, un, lf, ab)}),
      String.append(T.render.go(T.VPair{kk, vv} <> tt, ", ", False{}), SCon{'}', rest}),
      String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(vv, zz)}}}),
      cv.ptx(kk, vv, tt, '}', rest, hwv)),
    cv.key(kk, Laws.cv.tx(vv, zz), rw, hs, he0, bk, qk, T.CInl{inl, ps0, he0} <> sk, un, lf, ab, PP,
      b2 => q2 => u2 => l2 => rd(b2, q2, u2, l2, hwv, Eq.and.left(Laws.cv.short1(vv), Laws.cv.shorts(tt), hsp))(
        cv.tl.endi(tt, rest), +v2 => b3 => q3 => u3 => l3 => hh => cv.afteri(tt, kk, vv, v2, inl, ps0, he0, rw, hs, b3,
        q3, sk, u3, l3, ab, rest, PP, hh, ih_t, cv.wfp.t(kk, vv, tt, hw), Eq.and.right(Laws.cv.short1(vv),
        Laws.cv.shorts(tt), hsp), hn, Eq.and.right(T.wf.text(kk), T.wf.fresh(T.get(tt, kk)), cv.wfp.k(kk, vv, tt, hw)),
        Eq.and.right(Laws.is_miss(T.get(inl, kk)), cv.fr(inl, tt), hfi), hsl, hwv,
        cv.miss(T.get(inl, kk), Eq.and.left(Laws.is_miss(T.get(inl, kk)), cv.fr(inl, tt), hfi)), then))))

# the array put: own reads its items, reversed from what the frame held, as
# the scanner's form of the items
def cv.arr.is(
  +items: List<&2, T.Val>,
  +ac2: List<&2, T.Val>,
  hh: {Laws.own.rows(ac2) == List.reverse.go(&2, T.Val, Laws.cv.raw(items), Laws.own.rows([])) : List<&2, T.Val>}
) -> {Laws.cv.own1(T.VArr{List.reverse(&2, T.Val, ac2)}) == Laws.cv.raw1(T.VArr{items}) : T.Val}:
  Equal.cong(List<&2, T.Val>, T.Val, xs => T.VArr{xs}, Laws.own.rows(List.reverse(&2, T.Val, ac2)), Laws.cv.raw(items),
    Equal.trans(List<&2, T.Val>, Laws.own.rows(List.reverse.go(&2, T.Val, ac2, [])),
      List.reverse.go(&2, T.Val, Laws.own.rows(ac2), []), Laws.cv.raw(items), cv.own.rev(ac2, []),
      Equal.trans(List<&2, T.Val>, List.reverse.go(&2, T.Val, Laws.own.rows(ac2), []),
        List.reverse(&2, T.Val, List.reverse(&2, T.Val, Laws.cv.raw(items))), Laws.cv.raw(items),
        Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => List.reverse.go(&2, T.Val, ys, []), Laws.own.rows(ac2),
          List.reverse.go(&2, T.Val, Laws.cv.raw(items), []), hh),
        cv.rev2(Laws.cv.raw(items)))))

# the inline table put: own reads its pairs, sealed, as the scanner's form
def cv.inl.is(
  +rows: List<&2, T.Val>,
  +in2: List<&2, T.Val>,
  hh: {Laws.own.rows(in2) == List.reverse.go(&2, T.Val, Laws.cv.raw(rows), Laws.own.rows([])) : List<&2, T.Val>},
  hsl: {T.inl.seal(in2) == in2 : List<&2, T.Val>}
) -> {Laws.cv.own1(T.VInl{T.inl.seal(in2)}) == Laws.cv.raw1(T.VInl{rows}) : T.Val}:
  Equal.cong(List<&2, T.Val>, T.Val, xs => T.VInl{xs}, Laws.own.rows(T.inl.seal(in2)),
    List.reverse(&2, T.Val, Laws.cv.raw(rows)),
    Equal.trans(List<&2, T.Val>, Laws.own.rows(T.inl.seal(in2)), Laws.own.rows(in2),
      List.reverse(&2, T.Val, Laws.cv.raw(rows)),
      Equal.cong(List<&2, T.Val>, List<&2, T.Val>, ys => Laws.own.rows(ys), T.inl.seal(in2), in2, hsl), hh))

# what the induction proves of a value's list: an array's items, an inline
# table's pairs, or nothing for a scalar
def cv.Sub(
  +vv: T.Val,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  match vv:
    case T.VArr{items}:
      cv.G(items, False{}, [], ps, he, rw, hs, he, [], bk, qk, sk, un, lf, ab, rest, PP)
    case T.VInl{rows}:
      cv.G(rows, True{}, [], ps, he, rw, hs, he, [], bk, qk, sk, un, lf, ab, rest, PP)
    case _:
      Unit

# The induction. A value's reader (cv.one) reads `[`, `{` or a scalar; an
# array's items and an inline table's pairs are read by the claim the
# induction proves of the list (cv.Sub), which cv.go proves of every list,
# value and shape together, as ezjson's pv: an item's or a pair's value by
# its reader, with the claim for its own list from the induction, and the
# items or pairs after it by the induction.

# the rows of an inline table read from LInl, as they are from LInlK
def cv.l2k.rows(
  +kk: String,
  +vv: T.Val,
  +tt: List<&2, T.Val>,
  +ps: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +hwv: {Laws.cv.wf(vv) == True{} : Bool}
) -> {T.doc.read(String.append(T.render.go(T.VPair{kk, vv} <> tt, ", ", False{}), SCon{'}', rest}), T.MScan{T.St{"",
  rw, hs, he, [], [], T.LInl{}, bk, qk, T.CInl{[], ps, he} <> sk, T.HNone{}, un, lf, ab, False{}}})
  == T.doc.read(String.append(T.render.go(T.VPair{kk, vv} <> tt, ", ", False{}), SCon{'}', rest}),
  T.MScan{cv.ik([], ps, he, rw, hs, bk, qk, sk, un, lf, ab)}) : T.Doc}:
  +xs = {String.append(T.render.go(T.VPair{kk, vv} <> tt, ", ", False{}), SCon{'}', rest}) : String}
  +ys = {String.append(T.key(kk), SCon{' ', SCon{'=', SCon{' ', Laws.cv.tx(vv, cv.tl(tt, '}', rest))}}}) : String}
  +exy = {cv.ptx(kk, vv, tt, '}', rest, hwv) : {xs == ys : String}}
  %Equal.sym(String, xs, ys, exy) : {T.doc.read(_, T.MScan{T.St{"", rw, hs, he, [], [], T.LInl{}, bk, qk, T.CInl{[], ps,
    he} <> sk, T.HNone{}, un,
    lf, ab, False{}}}) == T.doc.read(_, T.MScan{cv.ik([], ps, he, rw, hs, bk, qk, sk, un, lf, ab)}) : T.Doc}
  cv.l2k(ys, rw, hs, he, bk, qk, T.CInl{[], ps, he} <> sk, un, lf, ab, cv.kx(kk, SCon{' ', SCon{'=', SCon{' ',
    Laws.cv.tx(vv, cv.tl(tt, '}', rest))}}}))

# a value in a value position, once the claim for its list is in hand
def cv.one(
  vv: T.Val,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  sub: cv.Sub(vv, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP),
  +hw: {Laws.cv.wf(vv) == True{} : Bool},
  hs1: {Laws.cv.short1(vv) == True{} : Bool}
) -> cv.Rd(vv, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP):
  match vv:
    case T.VArr{+items}:
      hn => ih => pp.step(PP, T.doc.read(Laws.cv.tx(T.VArr{items}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk, un,
        lf, ab)}), T.doc.read(String.append(T.render.go(items, ", ", False{}), SCon{']', rest}), T.MScan{cv.ar([], ps,
        he, rw, hs, he, [], bk, qk, sk, un, lf, ab)}), {==},
        sub(hw, hs1, hn, +ac2 => b2 => q2 => u2 => l2 => hh => ih(T.VArr{List.reverse(&2, T.Val, ac2)}, b2, q2, u2, l2,
          cv.arr.is(items, ac2, hh))))
    case T.VInl{rows}:
      match rows:
        case []:
          _hn => ih => pp.step(PP, T.doc.read(Laws.cv.tx(T.VInl{[]}, rest), T.MScan{cv.vp(rw, hs, he, ps, bk, qk, sk,
            un, lf, ab)}), T.doc.read(rest, T.MScan{cv.put(sk, T.VInl{T.inl.seal([])}, rw, hs, he, ps, bk, qk, un,
            lf, ab)}),
            Equal.cong(T.St, T.Doc, st => T.doc.read(rest, T.MScan{st}),
              T.read.once2(cv.put(sk, T.VInl{T.inl.seal([])}, rw, hs, he, ps, bk, qk, un, lf, ab)),
              cv.put(sk, T.VInl{T.inl.seal([])}, rw, hs, he, ps, bk, qk, un, lf, ab),
              Equal.sym(T.St, cv.put(sk, T.VInl{T.inl.seal([])}, rw, hs, he, ps, bk, qk, un, lf, ab),
                T.read.once2(cv.put(sk, T.VInl{T.inl.seal([])}, rw, hs, he, ps, bk, qk, un, lf, ab)),
                tk.once(sk, T.VInl{T.inl.seal([])}, "", rw, hs, he, ps, bk, qk, un, lf, ab, False{}))),
            ih(T.VInl{T.inl.seal([])}, bk, qk, un, lf, {==}))
        case T.VStr{raa} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VStr{raa} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VSpan{raa, rbb} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VSpan{raa, rbb} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP),
            hw)
        case T.VInt{raa, rbb} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VInt{raa, rbb} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VFlo{raa, rbb} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VFlo{raa, rbb} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VBool{raa} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VBool{raa} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VWhen{raa} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VWhen{raa} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VArr{raa} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VArr{raa} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VInl{raa} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VInl{raa} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VHead{raa, rbb} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VHead{raa, rbb} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP),
            hw)
        case T.VAot{raa, rbb} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VAot{raa, rbb} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP), hw)
        case T.VAots{raa, rbb} <> rt:
          Eq.bit.absurd(&1, cv.Rd(T.VInl{T.VAots{raa, rbb} <> rt}, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP),
            hw)
        case T.VPair{+kk, +v1} <> +rt:
          +hwv = {cv.wfp.v(kk, v1, rt, hw) : {Laws.cv.wf(v1) == True{} : Bool}}
          hn => ih => pp.step(PP, T.doc.read(Laws.cv.tx(T.VInl{T.VPair{kk, v1} <> rt}, rest), T.MScan{cv.vp(rw, hs,
            he, ps, bk, qk, sk, un, lf, ab)}), T.doc.read(String.append(T.render.go(T.VPair{kk, v1} <> rt, ", ",
            False{}), SCon{'}', rest}), T.MScan{cv.ik([], ps, he, rw, hs, bk, qk, sk, un, lf, ab)}),
            cv.l2k.rows(kk, v1, rt, ps, rw, hs, he, bk, qk, sk, un, lf, ab, rest, hwv),
            sub({==}, hw, hs1, hn, cv.fr.nil(T.VPair{kk, v1} <> rt), {==},
              +in2 => b2 => q2 => u2 => l2 => hh => hsl => ih(T.VInl{T.inl.seal(in2)}, b2, q2, u2, l2,
                cv.inl.is(T.VPair{kk, v1} <> rt, in2, hh, hsl))))
    case T.VStr{+aa}:
      hn => ih => cv.atom(T.VStr{aa}, hw, hs1, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VSpan{+aa, +bb}:
      hn => ih => cv.atom(T.VSpan{aa, bb}, hw, hs1, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VInt{+aa, +bb}:
      hn => ih => cv.atom(T.VInt{aa, bb}, hw, hs1, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VFlo{+aa, +bb}:
      hn => ih => cv.atom(T.VFlo{aa, bb}, hw, hs1, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
    case T.VBool{+aa}:
      hn => ih => cv.atom(T.VBool{aa}, hw, hs1, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, hn, ih)
