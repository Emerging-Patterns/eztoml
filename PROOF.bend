) -> PP(T.doc.read(String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest}), T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps,
  [], T.LHeadGap{}, bk, qk, [], un, lf, ab)})):
  %k3.hgap(gs, SCon{k3.hdl(cl), rest}, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab) : PP(_)
  %k3.hgdl(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab, rest) : PP(_)
  %en : PP(T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, _ <> ps, bk, qk, un, lf, ab)}))
  ih(bk, qk, un, lf)

# a bare header segment, its blank space and a dot or the bracket
def kx.hbseg(
  +xx: U32,
  +tt: String,
  +gs: List<&2, Bool>,
