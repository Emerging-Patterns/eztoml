  dg.elim(xx => {gd.fput(False{}, xx, T.FlFrac{}) == T.FlFrac{} : T.Fl}, cc, eD, {==}, {==}, {==}, {==}, {==}, {==},
    {==}, {==}, {==},
    {==})

