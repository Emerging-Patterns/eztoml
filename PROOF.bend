      he, k3.ps0(dt, ps), b2, T.QBasic{}, u2, l2, ab, rest, PP, ih))

# a literal header segment, its blank space and a dot or the bracket
def kx.hlseg(
  +name: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rw: List<&2, T.Val>,
