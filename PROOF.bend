    case True{}:
      kg.qkey(gg, st, T.QLit{}, T.LKeyQ{}, eg, KcO{}, ecl, {==})
    case False{}:
      kg.dbare(gg, T.bare.at(cc), dot, nl, st, cc, eg, ecl)

# the step dq
