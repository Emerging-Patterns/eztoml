    256n), True{}, Equal.cong(Nat, Bool, nn => Nat.is_lt(nn, 256n), Nat.add(U32.to_nat(mm), U32.to_nat(cc)),
    Nat.add(Nat.mul(U32.to_nat(dd), U32.to_nat(n1.rb(rx))), U32.to_nat(cc)), e2), hb))), e2)

