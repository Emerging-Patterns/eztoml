  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool
) -> T.St:
  sip.S(bd, rw, hs, he, pt, bf, T.LKeyDot{}, bk, qk, sk, un, lf, at)

# the mode r1.kd.go2 reads its text from
def r1.kd.go2M(
  +bare: Bool,
  +dot: Bool,
  +nl: Bool,
  +cr: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
