        T.path.len(here, 0)), +eb => kk.or4(kk.pend(gg, [], here, parts), kk.PF(gg, []), kk.L(gg, [], rows),
        kk.sfx(Laws.k3.pl([], here, parts, []), kk.tp(gg), HVal{vv}, kk.key(gg)),
