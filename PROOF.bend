            gd.fput(True{}, cc, T.FlFrac{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, True{}, saw, T.FlFrac{}), e))
        case T.FlE{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(True{}, cc, T.FlE{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, True{}, saw, T.FlE{}), e))
        case T.FlESign{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(True{}, cc, T.FlESign{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, True{}, saw, T.FlESign{}), e))
        case T.FlExp{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(True{}, cc, T.FlExp{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, True{}, saw, T.FlExp{}), e))
        case T.FlNo{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(True{}, cc, T.FlNo{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, True{}, saw, T.FlNo{}), e))
    case False{}:
      match fl:
        case T.FlStart{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlStart{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlStart{}), e))
        case T.FlZero{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlZero{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlZero{}), e))
        case T.FlInt{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlInt{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlInt{}), e))
        case T.FlDot{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlDot{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlDot{}), e))
        case T.FlFrac{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlFrac{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlFrac{}), e))
        case T.FlE{}:
          gd.nd.NExp(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), Char.is_digit(cc), sign, base, ds, us, saw, why, cc,
            {==}, {==}, {==}, gd.l(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlE{}), e))
        case T.FlESign{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlESign{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlESign{}), e))
        case T.FlExp{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlExp{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlExp{}), e))
        case T.FlNo{}:
          Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NExp{}, T.Num{T.NExp{}, sign, base, ds, us, saw, why}, cc), False{},
            gd.fput(False{}, cc, T.FlNo{})) == True{} : Bool},
            gd.r(gd.d10(ds), gd.nk(T.NExp{}, False{}, saw, T.FlNo{}), e))

# the scan and the automaton in NFrac, by whether a digit was seen
def gd.nx.NFrac(
  lead: Bool,
  saw: Bool,
  fl: T.Fl,
  +sign: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +why: String,
  +cc: Char,
  +e: {Bool.and(gd.d10(ds), gd.nk(T.NFrac{}, lead, saw, fl)) == True{} : Bool}
) -> {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, saw, why}, cc), False{}, gd.fput(lead, cc,
  fl)) == True{} : Bool}:
  match lead:
    case True{}:
      match saw:
        case True{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlInt{}), e))
            case T.FlDot{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlDot{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlDot{}), e))
            case T.FlFrac{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlFrac{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlE{}), e))
            case T.FlESign{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlESign{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlESign{}), e))
            case T.FlExp{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlExp{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, True{}, T.FlNo{}), e))
        case False{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlInt{}), e))
            case T.FlDot{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlDot{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlDot{}), e))
            case T.FlFrac{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlFrac{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlE{}), e))
            case T.FlESign{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlESign{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlESign{}), e))
            case T.FlExp{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlExp{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, True{}, False{}, T.FlNo{}), e))
    case False{}:
      match saw:
        case True{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlInt{}), e))
            case T.FlDot{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlDot{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlDot{}), e))
            case T.FlFrac{}:
              gd.nd.NFracT(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), sign,
                base, ds, us, why, cc, {==}, {==}, {==}, {==}, gd.l(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{},
                  T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlE{}), e))
            case T.FlESign{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlESign{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlESign{}), e))
            case T.FlExp{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlExp{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, True{}, T.FlNo{}), e))
        case False{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlInt{}), e))
            case T.FlDot{}:
              gd.nd.NFracF(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), sign,
                base, ds, us, why, cc, {==}, {==}, {==}, {==}, gd.l(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{},
                  T.FlDot{}), e))
            case T.FlFrac{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlFrac{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlE{}), e))
            case T.FlESign{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlESign{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlESign{}), e))
            case T.FlExp{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlExp{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NFrac{}, T.Num{T.NFrac{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NFrac{}, False{}, False{}, T.FlNo{}), e))

# the scan and the automaton in NEDig, by whether a digit was seen
def gd.nx.NEDig(
  lead: Bool,
  saw: Bool,
  fl: T.Fl,
  +sign: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +why: String,
  +cc: Char,
  +e: {Bool.and(gd.d10(ds), gd.nk(T.NEDig{}, lead, saw, fl)) == True{} : Bool}
) -> {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, saw, why}, cc), False{}, gd.fput(lead, cc,
  fl)) == True{} : Bool}:
  match lead:
    case True{}:
      match saw:
        case True{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlInt{}), e))
            case T.FlDot{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlDot{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlDot{}), e))
            case T.FlFrac{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlFrac{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlE{}), e))
            case T.FlESign{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlESign{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlESign{}), e))
            case T.FlExp{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlExp{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, True{}, T.FlNo{}), e))
        case False{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlInt{}), e))
            case T.FlDot{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlDot{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlDot{}), e))
            case T.FlFrac{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlFrac{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlE{}), e))
            case T.FlESign{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlESign{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlESign{}), e))
            case T.FlExp{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlExp{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(True{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, True{}, False{}, T.FlNo{}), e))
    case False{}:
      match saw:
        case True{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlInt{}), e))
            case T.FlDot{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlDot{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlDot{}), e))
            case T.FlFrac{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlFrac{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlE{}), e))
            case T.FlESign{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlESign{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlESign{}), e))
            case T.FlExp{}:
              gd.nd.NEDigT(Char.is_digit(cc), Char.is_eq(cc, '_'), sign, base, ds, us, why, cc, {==}, {==},
                gd.l(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, True{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, True{}, T.FlNo{}), e))
        case False{}:
          match fl:
            case T.FlStart{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlStart{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlStart{}), e))
            case T.FlZero{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlZero{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlZero{}), e))
            case T.FlInt{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlInt{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlInt{}), e))
            case T.FlDot{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlDot{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlDot{}), e))
            case T.FlFrac{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlFrac{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlFrac{}), e))
            case T.FlE{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlE{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlE{}), e))
            case T.FlESign{}:
              gd.nd.NEDigF(Char.is_digit(cc), Char.is_eq(cc, '_'), sign, base, ds, us, why, cc, {==}, {==},
                gd.l(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlESign{}), e))
            case T.FlExp{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlExp{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlExp{}), e))
            case T.FlNo{}:
              Eq.bit.absurd(&2, {gd.nm(T.num.on(T.NEDig{}, T.Num{T.NEDig{}, sign, base, ds, us, False{}, why}, cc),
                False{}, gd.fput(False{}, cc, T.FlNo{})) == True{} : Bool},
                gd.r(gd.d10(ds), gd.nk(T.NEDig{}, False{}, False{}, T.FlNo{}), e))

# the scan after one character, in NBase: the automaton's state is not asked
def gd.nx.NBase(
  +lead: Bool,
  +fl: T.Fl,
  +sign: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +cc: Char,
  +e: {Bool.and(gd.d10(ds), gd.nk(T.NBase{}, lead, saw, fl)) == True{} : Bool}
) -> {gd.nm(T.num.on(T.NBase{}, T.Num{T.NBase{}, sign, base, ds, us, saw, why}, cc), False{}, gd.fput(lead, cc,
  fl)) == True{} : Bool}:
  gd.nd.NBase(Char.is_eq(cc, '_'), sign, base, ds, us, saw, why, cc, gd.fput(lead, cc, fl), gd.l(gd.d10(ds), True{}, e))

# a failed scan stays failed
def gd.nx.NBad(
  +lead: Bool,
  +fl: T.Fl,
  +sign: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +cc: Char,
  +e: {Bool.and(gd.d10(ds), gd.nk(T.NBad{}, lead, saw, fl)) == True{} : Bool}
) -> {gd.nm(T.num.on(T.NBad{}, T.Num{T.NBad{}, sign, base, ds, us, saw, why}, cc), False{}, gd.fput(lead, cc,
  fl)) == True{} : Bool}:
  gd.tt(gd.d10(ds), True{}, gd.l(gd.d10(ds), True{}, e), {==})

# the scan and the automaton after one character, by the scan's state
def gd.ns.nk(
  nk: T.NK,
  +lead: Bool,
  +fl: T.Fl,
  +sign: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +cc: Char,
  +e: {Bool.and(gd.d10(ds), gd.nk(nk, lead, saw, fl)) == True{} : Bool}
) -> {gd.nm(T.num.on(nk, T.Num{nk, sign, base, ds, us, saw, why}, cc), False{}, gd.fput(lead, cc,
  fl)) == True{} : Bool}:
  match nk:
    case T.NLead{}:
      gd.nx.NLead(lead, fl, sign, base, ds, us, saw, why, cc, e)
    case T.NSign{}:
      gd.nx.NSign(lead, fl, sign, base, ds, us, saw, why, cc, e)
    case T.NZero{}:
      gd.nx.NZero(lead, fl, sign, base, ds, us, saw, why, cc, e)
    case T.NDig{}:
      gd.nx.NDig(lead, fl, sign, base, ds, us, saw, why, cc, e)
    case T.NBase{}:
      gd.nx.NBase(lead, fl, sign, base, ds, us, saw, why, cc, e)
    case T.NFrac{}:
      gd.nx.NFrac(lead, saw, fl, sign, base, ds, us, why, cc, e)
    case T.NExp{}:
      gd.nx.NExp(lead, fl, sign, base, ds, us, saw, why, cc, e)
    case T.NEDig{}:
      gd.nx.NEDig(lead, saw, fl, sign, base, ds, us, why, cc, e)
    case T.NBad{}:
      gd.nx.NBad(lead, fl, sign, base, ds, us, saw, why, cc, e)

# one step of the numeral scan keeps it in step with the automaton
def gd.ns(
  st: T.Num,
  +lead: Bool,
  +fl: T.Fl,
  +cc: Char,
  +e: {gd.nm(st, lead, fl) == True{} : Bool}
) -> {gd.nm(T.num.step(st, cc), False{}, gd.fput(lead, cc, fl)) == True{} : Bool}:
  match st:
    case T.Num{+nk, +sign, +base, +ds, +us, +saw, +why}:
      gd.ns.nk(nk, lead, fl, sign, base, ds, us, saw, why, cc, e)

# the first character of a spelling, then none
def gd.nlead(cs: List<&2, Char>, lead: Bool) -> Bool:
  match cs:
    case []:
      lead
    case _h <> tt:
      gd.nlead(tt, False{})

# the whole scan keeps it in step
def gd.ngo(
  cs: List<&2, Char>,
  +st: T.Num,
  +lead: Bool,
  +fl: T.Fl,
  +e: {gd.nm(st, lead, fl) == True{} : Bool}
) -> {gd.nm(T.num.go(cs, st), gd.nlead(cs, lead), gd.fb(cs, lead, fl)) == True{} : Bool}:
  match cs:
    case []:
      e
    case +hh <> +tt:
      gd.ngo(tt, T.num.step(st, hh), False{}, gd.fput(lead, hh, fl), gd.ns(st, lead, fl, hh, e))

# a list made a text and back is itself
def gd.tlfl(xs: List<&2, Char>) -> {String.to_list(String.from_list(xs)) == xs : List<&2, Char>}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      Equal.cong(List<&2, Char>, List<&2, Char>, ys => hh <> ys, String.to_list(String.from_list(tt)), tt, gd.tlfl(tt))

# the automaton over characters reversed onto more
def gd.rg(
  xs: List<&2, Char>,
  +acc: List<&2, Char>,
  +ss: T.Fl
) -> {T.wf.flo.go(List.reverse.go(&2, Char, xs, acc), ss) == T.wf.flo.go(acc, T.wf.flo.go(List.reverse.go(&2, Char,
  xs, []), ss)) : T.Fl}:
  match xs:
    case []:
      {==}
    case +xx <> +rr:
      Equal.trans(T.Fl, T.wf.flo.go(List.reverse.go(&2, Char, rr, xx <> acc), ss),
        T.wf.flo.go(acc, T.wf.flo.step(T.wf.flo.go(List.reverse.go(&2, Char, rr, []), ss), xx)),
        T.wf.flo.go(acc, T.wf.flo.go(List.reverse.go(&2, Char, rr, [xx]), ss)),
        gd.rg(rr, xx <> acc, ss),
        Equal.sym(T.Fl, T.wf.flo.go(acc, T.wf.flo.go(List.reverse.go(&2, Char, rr, [xx]), ss)),
          T.wf.flo.go(acc, T.wf.flo.step(T.wf.flo.go(List.reverse.go(&2, Char, rr, []), ss), xx)),
          Equal.cong(T.Fl, T.Fl, yy => T.wf.flo.go(acc, yy), T.wf.flo.go(List.reverse.go(&2, Char, rr, [xx]), ss),
            T.wf.flo.step(T.wf.flo.go(List.reverse.go(&2, Char, rr, []), ss), xx), gd.rg(rr, [xx], ss))))

# a character kept or dropped by the spelling of a sign
def gd.fbput.s(
  bb: Bool,
  +cc: Char,
  +out: List<&2, Char>,
  +ss: T.Fl
) -> {T.wf.flo.go(List.reverse(&2, Char, T.word.body.put.sign(bb, cc, out)), ss) == gd.fsel(bb,
  T.wf.flo.go(List.reverse(&2, Char, out), ss), T.wf.flo.step(T.wf.flo.go(List.reverse(&2, Char, out), ss),
    cc)) : T.Fl}:
  match bb:
    case True{}:
      {==}
    case False{}:
      gd.rg(out, [cc], ss)

# a character kept or dropped by the spelling of an underscore
def gd.fbput.u(
  bb: Bool,
  +cc: Char,
  +out: List<&2, Char>,
  +ss: T.Fl
) -> {T.wf.flo.go(List.reverse(&2, Char, T.word.body.put.us(bb, cc, out)), ss) == gd.fsel(bb,
  T.wf.flo.go(List.reverse(&2, Char, out), ss), T.wf.flo.step(T.wf.flo.go(List.reverse(&2, Char, out), ss),
    cc)) : T.Fl}:
  match bb:
    case True{}:
      {==}
    case False{}:
      gd.rg(out, [cc], ss)

# one character of the spelling
def gd.fbput(
  lead: Bool,
  +cc: Char,
  +out: List<&2, Char>,
  +ss: T.Fl
) -> {T.wf.flo.go(List.reverse(&2, Char, T.word.body.put(lead, cc, out)), ss) == gd.fput(lead, cc,
  T.wf.flo.go(List.reverse(&2, Char, out), ss)) : T.Fl}:
  match lead:
    case True{}:
      gd.fbput.s(Bool.or(Char.is_eq(cc, '+'), Char.is_eq(cc, '-')), cc, out, ss)
    case False{}:
      gd.fbput.u(Char.is_eq(cc, '_'), cc, out, ss)

# the automaton over a spelling is gd.fb
def gd.fbl(
  cs: List<&2, Char>,
  +lead: Bool,
  +out: List<&2, Char>,
  +ss: T.Fl
) -> {T.wf.flo.go(T.word.body.go(cs, lead, out), ss) == gd.fb(cs, lead, T.wf.flo.go(List.reverse(&2, Char, out),
  ss)) : T.Fl}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      Equal.trans(T.Fl, T.wf.flo.go(T.word.body.go(tt, False{}, T.word.body.put(lead, hh, out)), ss),
        gd.fb(tt, False{}, T.wf.flo.go(List.reverse(&2, Char, T.word.body.put(lead, hh, out)), ss)),
        gd.fb(tt, False{}, gd.fput(lead, hh, T.wf.flo.go(List.reverse(&2, Char, out), ss))),
        gd.fbl(tt, False{}, T.word.body.put(lead, hh, out), ss),
        Equal.cong(T.Fl, T.Fl, yy => gd.fb(tt, False{}, yy),
          T.wf.flo.go(List.reverse(&2, Char, T.word.body.put(lead, hh, out)), ss),
          gd.fput(lead, hh, T.wf.flo.go(List.reverse(&2, Char, out), ss)), gd.fbput(lead, hh, out, ss)))



# a spelling the automaton ends in a fraction's digit reads as a float
def gd.fl.frac(fl: T.Fl, +ee: {gd.flq(fl, T.FlFrac{}) == True{} : Bool}) -> {T.wf.flo.end(fl) == True{} : Bool}:
  match fl:
    case T.FlFrac{}:
      {==}
    case T.FlStart{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlStart{}) == True{} : Bool}, ee)
    case T.FlZero{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlZero{}) == True{} : Bool}, ee)
    case T.FlInt{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlInt{}) == True{} : Bool}, ee)
    case T.FlDot{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlDot{}) == True{} : Bool}, ee)
    case T.FlE{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlE{}) == True{} : Bool}, ee)
    case T.FlESign{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlESign{}) == True{} : Bool}, ee)
    case T.FlExp{}:
      {==}
    case T.FlNo{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlNo{}) == True{} : Bool}, ee)

# or an exponent's digit
def gd.fl.exp(fl: T.Fl, +ee: {gd.flq(fl, T.FlExp{}) == True{} : Bool}) -> {T.wf.flo.end(fl) == True{} : Bool}:
  match fl:
    case T.FlExp{}:
      {==}
    case T.FlStart{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlStart{}) == True{} : Bool}, ee)
    case T.FlZero{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlZero{}) == True{} : Bool}, ee)
    case T.FlInt{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlInt{}) == True{} : Bool}, ee)
    case T.FlDot{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlDot{}) == True{} : Bool}, ee)
    case T.FlFrac{}:
      {==}
    case T.FlE{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlE{}) == True{} : Bool}, ee)
    case T.FlESign{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlESign{}) == True{} : Bool}, ee)
    case T.FlNo{}:
      Eq.bit.absurd(&2, {T.wf.flo.end(T.FlNo{}) == True{} : Bool}, ee)

# the last of three ors
def gd.or3(
  aa: Bool,
  bb: Bool,
  +cc: Bool,
  +ec: {cc == True{} : Bool}
) -> {Bool.or(aa, Bool.or(bb, cc)) == True{} : Bool}:
  match aa bb:
    case True{} _b:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      ec

# a float's spelling that the automaton ends well in is well-formed
def gd.flo.ok(
  +text: String,
  +fl: T.Fl,
  +ef: {fl == T.wf.flo.go(String.to_list(text), T.FlStart{}) : T.Fl},
  +ee: {T.wf.flo.end(fl) == True{} : Bool}
) -> {T.wf.flo(text) == True{} : Bool}:
  gd.or3(T.str.eq(text, "inf"), T.str.eq(text, "nan"), T.wf.flo.end(T.wf.flo.go(String.to_list(text), T.FlStart{})),
    Equal.trans(Bool, T.wf.flo.end(T.wf.flo.go(String.to_list(text), T.FlStart{})), T.wf.flo.end(fl), True{},
      Equal.cong(T.Fl, Bool, ff => T.wf.flo.end(ff), T.wf.flo.go(String.to_list(text), T.FlStart{}), fl,
        Equal.sym(T.Fl, fl, T.wf.flo.go(String.to_list(text), T.FlStart{}), ef)), ee))

# an integer whose range was checked
def gd.nfin.rng(
  ok: Bool,
  +sign: T.Sign,
  +digits: String,
  +ew: {T.wf.dec(digits) == True{} : Bool},
  +eo: {T.i64.fits(sign, digits) == ok : Bool}
) -> {Laws.gd.gok(T.num.fin.range(ok, sign, digits)) == True{} : Bool}:
  match ok:
    case True{}:
      gd.tt(T.wf.dec(digits), T.i64.fits(sign, digits), ew, eo)
    case False{}:
      {==}

# an integer, when a digit was seen
def gd.nfin.int(
  saw: Bool,
  +sign: T.Sign,
  +ds: List<&2, U32>,
  +ed: {gd.d10(ds) == True{} : Bool}
) -> {Laws.gd.gok(T.num.fin.int(saw, sign, T.dec.text(ds))) == True{} : Bool}:
  match saw:
    case True{}:
      gd.nfin.rng(T.i64.fits(sign, T.dec.text(ds)), sign, T.dec.text(ds), gd.dec.text(ds, ed), {==})
    case False{}:
      {==}

# a prefixed integer, when no sign was written
def gd.nfin.base(
  signed: Bool,
  +saw: Bool,
  +sign: T.Sign,
  +ds: List<&2, U32>,
  +ed: {gd.d10(ds) == True{} : Bool}
) -> {Laws.gd.gok(T.num.fin.base(signed, saw, sign, ds)) == True{} : Bool}:
  match signed:
    case True{}:
      {==}
    case False{}:
      gd.nfin.int(saw, sign, ds, ed)

# a float, when a digit was seen
def gd.nfin.flo(
  saw: Bool,
  +sign: T.Sign,
  +text: String,
  +ee: {Laws.gd.ifok(saw, T.wf.flo(text)) == True{} : Bool}
) -> {Laws.gd.gok(T.num.fin.saw(saw, T.VFlo{sign, text})) == True{} : Bool}:
  match saw:
    case True{}:
      ee
    case False{}:
      {==}

# a zero
def gd.nfin.zero(sign: T.Sign) -> {Laws.gd.gok(T.GotVal{T.VInt{sign, "0"}}) == True{} : Bool}:
  match sign:
    case T.Plus{}:
      {==}
    case T.Minus{}:
      {==}

# the float's end state from the scan's
def gd.nfin.fe(
  saw: Bool,
  +lead: Bool,
  +fl: T.Fl,
  +text: String,
  +ef: {fl == T.wf.flo.go(String.to_list(text), T.FlStart{}) : T.Fl},
  +ee: {gd.nk(T.NFrac{}, lead, saw, fl) == True{} : Bool}
) -> {Laws.gd.ifok(saw, T.wf.flo(text)) == True{} : Bool}:
  match saw:
    case True{}:
      gd.flo.ok(text, fl, ef, gd.fl.frac(fl, gd.r(Bool.not(lead), gd.flq(fl, T.FlFrac{}), ee)))
    case False{}:
      {==}

# and an exponent's
def gd.nfin.ee(
  saw: Bool,
  +lead: Bool,
  +fl: T.Fl,
  +text: String,
  +ef: {fl == T.wf.flo.go(String.to_list(text), T.FlStart{}) : T.Fl},
  +ee: {gd.nk(T.NEDig{}, lead, saw, fl) == True{} : Bool}
) -> {Laws.gd.ifok(saw, T.wf.flo(text)) == True{} : Bool}:
  match saw:
    case True{}:
      gd.flo.ok(text, fl, ef, gd.fl.exp(fl, gd.r(Bool.not(lead), gd.flq(fl, T.FlExp{}), ee)))
    case False{}:
      {==}

# the value a finished scan gives, by its state
def gd.nfin.nk(
  nk: T.NK,
  +sign: T.Sign,
  +ds: List<&2, U32>,
  +saw: Bool,
  +why: String,
  +cs: List<&2, Char>,
  +lead: Bool,
  +fl: T.Fl,
  +e: {Bool.and(gd.d10(ds), gd.nk(nk, lead, saw, fl)) == True{} : Bool},
  +ef: {fl == T.wf.flo.go(String.to_list(T.word.body(cs)), T.FlStart{}) : T.Fl}
) -> {Laws.gd.gok(T.num.fin.nk(nk, sign, ds, saw, why, cs)) == True{} : Bool}:
  match nk:
    case T.NBad{}:
      {==}
    case T.NLead{}:
      {==}
    case T.NSign{}:
      {==}
    case T.NZero{}:
      gd.nfin.zero(sign)
    case T.NDig{}:
      gd.nfin.int(saw, sign, ds, gd.l(gd.d10(ds), gd.nk(T.NDig{}, lead, saw, fl), e))
    case T.NBase{}:
      gd.nfin.base(T.num.signed(cs), saw, sign, ds, gd.l(gd.d10(ds), True{}, e))
    case T.NFrac{}:
      gd.nfin.flo(saw, sign, T.word.body(cs),
        gd.nfin.fe(saw, lead, fl, T.word.body(cs), ef, gd.r(gd.d10(ds), gd.nk(T.NFrac{}, lead, saw, fl), e)))
    case T.NExp{}:
      {==}
    case T.NEDig{}:
      gd.nfin.flo(saw, sign, T.word.body(cs),
        gd.nfin.ee(saw, lead, fl, T.word.body(cs), ef, gd.r(gd.d10(ds), gd.nk(T.NEDig{}, lead, saw, fl), e)))

# no trailing underscore
def gd.nfin.us(
  us: Bool,
  +nk: T.NK,
  +sign: T.Sign,
  +ds: List<&2, U32>,
  +saw: Bool,
  +why: String,
  +cs: List<&2, Char>,
  +lead: Bool,
  +fl: T.Fl,
  +e: {Bool.and(gd.d10(ds), gd.nk(nk, lead, saw, fl)) == True{} : Bool},
  +ef: {fl == T.wf.flo.go(String.to_list(T.word.body(cs)), T.FlStart{}) : T.Fl}
) -> {Laws.gd.gok(T.num.fin.us(us, nk, sign, ds, saw, why, cs)) == True{} : Bool}:
  match us:
    case True{}:
      {==}
    case False{}:
      gd.nfin.nk(nk, sign, ds, saw, why, cs, lead, fl, e, ef)

# a finished scan's value is well-formed
def gd.nfin(
  st: T.Num,
  +cs: List<&2, Char>,
  +lead: Bool,
  +fl: T.Fl,
  +e: {gd.nm(st, lead, fl) == True{} : Bool},
  +ef: {fl == T.wf.flo.go(String.to_list(T.word.body(cs)), T.FlStart{}) : T.Fl}
) -> {Laws.gd.gok(T.num.fin(st, cs)) == True{} : Bool}:
  match st:
    case T.Num{+nk, +sign, _b, +ds, +us, +saw, +why}:
      gd.nfin.us(us, nk, sign, ds, saw, why, cs, lead, fl, e, ef)

# every numeral's value is well-formed
def gd.num(+cs: List<&2, Char>) -> {Laws.gd.gok(T.word.num(cs)) == True{} : Bool}:
  gd.nfin(T.num.go(cs, T.num.start()), cs, gd.nlead(cs, True{}), gd.fb(cs, True{}, T.FlStart{}),
    gd.ngo(cs, T.num.start(), True{}, T.FlStart{}, {==}),
    Equal.sym(T.Fl, T.wf.flo.go(String.to_list(T.word.body(cs)), T.FlStart{}), gd.fb(cs, True{}, T.FlStart{}),
      Equal.trans(T.Fl, T.wf.flo.go(String.to_list(T.word.body(cs)), T.FlStart{}),
        T.wf.flo.go(T.word.body.go(cs, True{}, []), T.FlStart{}), gd.fb(cs, True{}, T.FlStart{}),
        Equal.cong(List<&2, Char>, T.Fl, xs => T.wf.flo.go(xs, T.FlStart{}),
          String.to_list(String.from_list(T.word.body.go(cs, True{}, []))), T.word.body.go(cs, True{}, []),
          gd.tlfl(T.word.body.go(cs, True{}, []))),
        gd.fbl(cs, True{}, [], T.FlStart{}))))

# the specials: true, false, inf and nan, signed or not
def gd.w.nan(aa: Bool, bb: Bool, cc: Bool) -> {Laws.gd.gok(T.word.spec.nan(aa, bb, cc)) == True{} : Bool}:
  match aa bb cc:
    case True{} _b _c:
      {==}
    case False{} True{} _c:
      {==}
    case False{} False{} True{}:
      {==}
    case False{} False{} False{}:
      {==}

# inf, or nan
def gd.w.inf(
  aa: Bool,
  bb: Bool,
  cc: Bool,
  +ss: String
) -> {Laws.gd.gok(T.word.spec.inf(aa, bb, cc, ss)) == True{} : Bool}:
  match aa bb cc:
    case True{} _b _c:
      {==}
    case False{} True{} _c:
      {==}
    case False{} False{} True{}:
      {==}
    case False{} False{} False{}:
      gd.w.nan(T.str.eq(ss, "nan"), T.str.eq(ss, "+nan"), T.str.eq(ss, "-nan"))

# true, false, or the rest
def gd.w.st(hit: Bool, other: Bool, +ss: String) -> {Laws.gd.gok(T.word.spec.t(hit, other, ss)) == True{} : Bool}:
  match hit other:
    case True{} _o:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      gd.w.inf(T.str.eq(ss, "inf"), T.str.eq(ss, "+inf"), T.str.eq(ss, "-inf"), ss)

# every special's value is well-formed
def gd.w.spec(+ss: String) -> {Laws.gd.gok(T.word.spec(ss)) == True{} : Bool}:
  gd.w.st(T.str.eq(ss, "true"), T.str.eq(ss, "false"), ss)

# a datetime's value
def gd.w.when(
  ww: T.WhenOut,
  +ee: {gd.wot(ww) == True{} : Bool}
) -> {Laws.gd.gok(T.word.from.when(ww)) == True{} : Bool}:
  match ww:
    case T.WSome{_w}:
      ee
    case T.WFail{_why}:
      {==}
    case T.WSkip{}:
      {==}

# a datetime or a numeral
def gd.w.rdate(dt: Bool, +cs: List<&2, Char>) -> {Laws.gd.gok(T.word.route.date(dt, cs)) == True{} : Bool}:
  match dt:
    case True{}:
      gd.w.when(T.when.read(cs), gd.when(cs))
    case False{}:
      gd.num(cs)

# a special's value, or a datetime or a numeral
def gd.w.route(
  gg: T.Got,
  +dt: Bool,
  +cs: List<&2, Char>,
  +eg: {Laws.gd.gok(gg) == True{} : Bool}
) -> {Laws.gd.gok(T.word.route(gg, dt, cs)) == True{} : Bool}:
  match gg:
    case T.GotVal{_v}:
      eg
    case T.GotBad{_why}:
      gd.w.rdate(T.word.as_date(dt, T.word.ee(cs)), cs)

# a word that may be special, or not
def gd.w.pick(special: Bool, +cs: List<&2, Char>) -> {Laws.gd.gok(T.word.val.pick(special, cs)) == True{} : Bool}:
  match special:
    case True{}:
      gd.w.route(T.word.spec(String.from_list(cs)), T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs,
        gd.w.spec(String.from_list(cs)))
    case False{}:
      gd.w.route(T.GotBad{""}, T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs, {==})

def Laws.gd_word(cs) :
  gd.w.pick(T.word.lead(cs), cs)


# WP-R3: a bare word's states. A bare word ends through word.val (gd_word)
# and gd_take; the character that ended it is held, or a newline that ended a
# root value moves the line on.

# a failed step, for any reason
def gd.g.err2(
  +st: T.St,
  +why: String,
  +eg: {Laws.good(st) == True{} : Bool}
) -> {Laws.good(T.st.err(st, why)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      match bad:
        case SNil{}:
          gd.tt(Laws.gd.tr(why, rows, stack), Laws.gd.lx(here, parts, buf, stack, T.HNone{}),
            gd.ifok.any(String.is_empty(why), Bool.and(T.wf.go(rows, T.WfRows{""}), Laws.gd.vals(stack)),
              gd.l(Laws.gd.tr("", rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)),
            gd.lx.mk(here, parts, buf, stack, T.HNone{}, gd.lx.h(here, parts, buf, stack, hold, gd.r(Laws.gd.tr("",
              rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)), gd.lx.p(here, parts, buf, stack, hold,
                gd.r(Laws.gd.tr("", rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)), gd.lx.b(here,
                  parts, buf, stack, hold, gd.r(Laws.gd.tr("", rows, stack), Laws.gd.lx(here, parts, buf, stack,
                    hold), eg)), gd.lx.s(here, parts, buf, stack, hold, gd.r(Laws.gd.tr("", rows, stack),
                      Laws.gd.lx(here, parts, buf, stack, hold), eg)), {==}))
        case SCon{+bh, +bt}:
          gd.tt(Laws.gd.tr(SCon{bh, bt}, rows, stack), Laws.gd.lx(here, parts, buf, stack, T.HNone{}), {==},
            gd.lx.mk(here, parts, buf, stack, T.HNone{}, gd.lx.h(here, parts, buf, stack, hold,
              gd.r(Laws.gd.tr(SCon{bh, bt}, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)),
                gd.lx.p(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(SCon{bh, bt}, rows, stack), Laws.gd.lx(here,
                  parts, buf, stack, hold), eg)), gd.lx.b(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(SCon{bh, bt},
                    rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)), gd.lx.s(here, parts, buf, stack,
                      hold, gd.r(Laws.gd.tr(SCon{bh, bt}, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold),
                        eg)), {==}))

# a value a key may hold is one gd_take may put, whatever the state
def gd.okv.of(+st: T.St, +vv: T.Val, +ev: {Laws.gd.vok(vv) == True{} : Bool}) -> {Laws.gd.okv(st, vv) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.ifok.any(String.is_empty(bad), Laws.gd.vok(vv), ev)

# a newline that ended a root value moves the line on; any other state stays
def gd.g.bline.lex(
  lex: T.Lex,
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool}
) -> {Laws.good(T.bare.line.lex(lex, st)) == True{} : Bool}:
  match lex:
    case T.LTop{}:
      eg
    case T.LLine{}:
      gd.g.lex(st, T.LTop{}, eg)
    case T.LKey{}:
      eg
    case T.LKeyDot{}:
      eg
    case T.LAfter{}:
      eg
    case T.LKeyQ{}:
      eg
    case T.LKeyE{}:
      eg
    case T.LKeyU{}:
      eg
    case T.LVal{}:
      eg
    case T.LQ{}:
      eg
    case T.LQ2{}:
      eg
    case T.LStr{}:
      eg
    case T.LEsc{}:
      eg
    case T.LUni{}:
      eg
    case T.LFold{}:
      eg
    case T.LMq{}:
      eg
    case T.LMqEnd{}:
      eg
    case T.LTrim{}:
      eg
    case T.LTrim2{}:
      eg
    case T.LBare{}:
      eg
    case T.LDate{}:
      eg
    case T.LCom{}:
      eg
    case T.LHead{}:
      eg
    case T.LHeadGap{}:
      eg
    case T.LHeadDot{}:
      eg
    case T.LHeadQ{}:
      eg
    case T.LHeadE{}:
      eg
    case T.LHeadU{}:
      eg
    case T.LHeadR{}:
      eg
    case T.LArr{}:
      eg
    case T.LArrC{}:
      eg
    case T.LInl{}:
      eg
    case T.LInlK{}:
      eg
    case T.LInlC{}:
      eg
    case T.LSink{}:
      eg

# the newline, read off the state
def gd.g.bline.go(+st: T.St, +eg: {Laws.good(st) == True{} : Bool}) -> {Laws.good(T.bare.line.go(st)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.g.bline.lex(lex, T.St{bad, rows, heads, here, parts, buf, lex, back, qkind, stack, hold, uni, left, arrtab,
        lead}, eg)

# a newline, or another delimiter
def gd.g.bline(
  nl: Bool,
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool}
) -> {Laws.good(T.bare.line(st, nl)) == True{} : Bool}:
  match nl:
    case True{}:
      gd.g.bline.go(st, eg)
    case False{}:
      eg

# the delimiter held, or not
def gd.g.bhold(
  +st: T.St,
  +cc: Char,
  hold: Bool,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.bare.hold(st, cc, hold)) == True{} : Bool}:
  match hold:
    case False{}:
      gd.g.bline(T.ch.nl(cc), st, eg)
    case True{}:
      gd.g.hold.on(st, cc, eg, ec)

# a bare word's value placed, or its refusal
def gd.g.bgot(
  gg: T.Got,
  +st: T.St,
  +cc: Char,
  +hold: Bool,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool},
  +ev: {Laws.gd.gok(gg) == True{} : Bool}
) -> {Laws.good(T.bare.got(gg, st, cc, hold)) == True{} : Bool}:
  match gg:
    case T.GotBad{+why}:
      gd.g.err2(st, why, eg)
    case T.GotVal{+vv}:
      gd.g.bhold(T.val.take(st, vv), cc, hold, gd.g.take(st, vv, eg, gd.okv.of(st, vv, ev)), ec)

# a bare word ends: its buffer read as a value
def gd.g.bfin(
  +st: T.St,
  +cc: Char,
  +hd: Bool,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.bare.finish(st, cc, hd)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.g.bgot(T.word.val(List.reverse(&2, Char, buf)),
        T.St{bad, rows, heads, here, parts, [], lex, back, qkind, stack, hold, uni, left, arrtab, lead}, cc, hd,
        gd.tt(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, [], stack, hold), gd.l(Laws.gd.tr(bad, rows,
          stack), Laws.gd.lx(here, parts, buf, stack, hold), eg),
          gd.lx.mk(here, parts, [], stack, hold, gd.lx.h(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(bad, rows,
            stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)), gd.lx.p(here, parts, buf, stack, hold,
              gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)), {==}, gd.lx.s(here,
                parts, buf, stack, hold, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold),
                  eg)), gd.r(Laws.gd.keys(stack), Laws.gd.hold(hold), gd.lx.s1(here, parts, buf, stack, hold,
                    gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg))))),
        ec, Laws.gd_word(List.reverse(&2, Char, buf)))


# a step of a bare word: bdgo
def gd.g.bdgo(
  date: Bool,
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.lex.bare.date.go(date, st, cc)) == True{} : Bool}:
  match date:
    case True{}:
      gd.g.lex(st, T.LDate{}, eg)
    case False{}:
      gd.g.bfin(st, cc, False{}, eg, ec)


# a step of a bare word: bdate
def gd.g.bdate(
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.lex.bare.date(st, cc)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.g.bdgo(T.date.shaped(buf), T.St{bad, rows, heads, here, parts, buf, lex, back, qkind, stack, hold, uni, left,
        arrtab, lead}, cc, eg, ec)


# a step of a bare word: bend
def gd.g.bend(
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.lex.bare.end(st, cc)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.g.bfin(T.St{bad, rows, heads, here, parts, buf, lex, back, qkind, stack, hold, uni, left, arrtab, lead}, cc,
        T.lex.bare.hold(T.ch.skip(cc), T.ch.nl(cc), T.inl.open(stack)), eg, ec)


# a step of a bare word: bsp
def gd.g.bsp(
  sp: Bool,
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.lex.bare.sp(sp, st, cc)) == True{} : Bool}:
  match sp:
    case True{}:
      gd.g.bdate(st, cc, eg, ec)
    case False{}:
      gd.g.bend(st, cc, eg, ec)


# a step of a bare word: bgo
def gd.g.bgo(
  delim: Bool,
  +sp: Bool,
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.lex.bare.go(delim, sp, st, cc)) == True{} : Bool}:
  match delim:
    case False{}:
      gd.g.push(st, cc, T.LBare{}, eg, ec)
    case True{}:
      gd.g.bsp(sp, st, cc, eg, ec)


# a step of a bare word: datedig
def gd.g.datedig(
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.lex.date.digit(st, cc)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.tt(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, cc <> (' ' <> buf), stack, hold),
        gd.l(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg),
        gd.lx.mk(here, parts, cc <> (' ' <> buf), stack, hold, gd.lx.h(here, parts, buf, stack, hold,
          gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)), gd.lx.p(here, parts,
            buf, stack, hold, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)),
          gd.tt(T.wf.char(cc), Bool.and(T.wf.char(' '), Laws.gd.cs(buf)), ec,
            gd.tt(T.wf.char(' '), Laws.gd.cs(buf), {==}, gd.lx.b(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(bad,
              rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)))), gd.lx.s(here, parts, buf, stack, hold,
                gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)),
                  gd.r(Laws.gd.keys(stack), Laws.gd.hold(hold), gd.lx.s1(here, parts, buf, stack, hold,
                    gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg)))))


# a step of a bare word: datego
def gd.g.datego(
  digit: Bool,
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.lex.date.go(digit, st, cc)) == True{} : Bool}:
  match digit:
    case True{}:
      gd.g.datedig(st, cc, eg, ec)
    case False{}:
      gd.g.bfin(st, cc, True{}, eg, ec)


def Laws.gd_bare_steps(lex, hl, st, eg, cc, ec) :
  match lex:
    case T.LTop{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LTop{}, st, cc)) == True{} : Bool}, hl)
    case T.LLine{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LLine{}, st, cc)) == True{} : Bool}, hl)
    case T.LKey{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LKey{}, st, cc)) == True{} : Bool}, hl)
    case T.LKeyDot{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LKeyDot{}, st, cc)) == True{} : Bool}, hl)
    case T.LAfter{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LAfter{}, st, cc)) == True{} : Bool}, hl)
    case T.LKeyQ{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LKeyQ{}, st, cc)) == True{} : Bool}, hl)
    case T.LKeyE{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LKeyE{}, st, cc)) == True{} : Bool}, hl)
    case T.LKeyU{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LKeyU{}, st, cc)) == True{} : Bool}, hl)
    case T.LVal{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LVal{}, st, cc)) == True{} : Bool}, hl)
    case T.LQ{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LQ{}, st, cc)) == True{} : Bool}, hl)
    case T.LQ2{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LQ2{}, st, cc)) == True{} : Bool}, hl)
    case T.LStr{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LStr{}, st, cc)) == True{} : Bool}, hl)
    case T.LEsc{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LEsc{}, st, cc)) == True{} : Bool}, hl)
    case T.LUni{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LUni{}, st, cc)) == True{} : Bool}, hl)
    case T.LFold{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LFold{}, st, cc)) == True{} : Bool}, hl)
    case T.LMq{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LMq{}, st, cc)) == True{} : Bool}, hl)
    case T.LMqEnd{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LMqEnd{}, st, cc)) == True{} : Bool}, hl)
    case T.LTrim{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LTrim{}, st, cc)) == True{} : Bool}, hl)
    case T.LTrim2{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LTrim2{}, st, cc)) == True{} : Bool}, hl)
    case T.LBare{}:
      gd.g.bgo(T.ch.delim(cc), T.ch.sp(cc), st, cc, eg, ec)
    case T.LDate{}:
      gd.g.datego(Char.is_digit(cc), st, cc, eg, ec)
    case T.LCom{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LCom{}, st, cc)) == True{} : Bool}, hl)
    case T.LHead{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LHead{}, st, cc)) == True{} : Bool}, hl)
    case T.LHeadGap{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LHeadGap{}, st, cc)) == True{} : Bool}, hl)
    case T.LHeadDot{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LHeadDot{}, st, cc)) == True{} : Bool}, hl)
    case T.LHeadQ{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LHeadQ{}, st, cc)) == True{} : Bool}, hl)
    case T.LHeadE{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LHeadE{}, st, cc)) == True{} : Bool}, hl)
    case T.LHeadU{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LHeadU{}, st, cc)) == True{} : Bool}, hl)
    case T.LHeadR{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LHeadR{}, st, cc)) == True{} : Bool}, hl)
    case T.LArr{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LArr{}, st, cc)) == True{} : Bool}, hl)
    case T.LArrC{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LArrC{}, st, cc)) == True{} : Bool}, hl)
    case T.LInl{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LInl{}, st, cc)) == True{} : Bool}, hl)
    case T.LInlK{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LInlK{}, st, cc)) == True{} : Bool}, hl)
    case T.LInlC{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LInlC{}, st, cc)) == True{} : Bool}, hl)
    case T.LSink{}:
      Eq.bit.absurd(&2, {Laws.good(T.read.on(T.LSink{}, st, cc)) == True{} : Bool}, hl)


# WP-R3: the dispatch. read.fast keeps a plain character in the buffer or
# ignores it, and gives every other character, and a held one, to read.on:
# every state good (gd_header_steps, gd_key_steps, gd_value_steps,
# gd_bare_steps). A byte-order mark is dropped.

# a state good, as the fast step builds it: good reads no other field
def gd.gf(
  +bad: String,
  +rows: List<&2, T.Val>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +stack: List<&2, T.Ctx>
) -> Bool:
  Laws.good(T.St{bad, rows, [], here, parts, buf, T.LTop{}, T.LTop{}, T.QBasic{}, stack, T.HNone{}, 0, 0, False{},
    False{}})

# one character in any state
def gd.on(
  lex: T.Lex,
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.on(lex, st, cc)) == True{} : Bool}:
  match lex:
    case T.LTop{}:
      Laws.gd_key_steps(T.LTop{}, {==}, st, eg, cc, ec)
    case T.LLine{}:
      Laws.gd_key_steps(T.LLine{}, {==}, st, eg, cc, ec)
    case T.LKey{}:
      Laws.gd_key_steps(T.LKey{}, {==}, st, eg, cc, ec)
    case T.LKeyDot{}:
      Laws.gd_key_steps(T.LKeyDot{}, {==}, st, eg, cc, ec)
    case T.LAfter{}:
      Laws.gd_key_steps(T.LAfter{}, {==}, st, eg, cc, ec)
    case T.LKeyQ{}:
      Laws.gd_key_steps(T.LKeyQ{}, {==}, st, eg, cc, ec)
    case T.LKeyE{}:
      Laws.gd_key_steps(T.LKeyE{}, {==}, st, eg, cc, ec)
    case T.LKeyU{}:
      Laws.gd_key_steps(T.LKeyU{}, {==}, st, eg, cc, ec)
    case T.LVal{}:
      Laws.gd_value_steps(T.LVal{}, {==}, st, eg, cc, ec)
    case T.LQ{}:
      Laws.gd_value_steps(T.LQ{}, {==}, st, eg, cc, ec)
    case T.LQ2{}:
      Laws.gd_value_steps(T.LQ2{}, {==}, st, eg, cc, ec)
    case T.LStr{}:
      Laws.gd_value_steps(T.LStr{}, {==}, st, eg, cc, ec)
    case T.LEsc{}:
      Laws.gd_value_steps(T.LEsc{}, {==}, st, eg, cc, ec)
    case T.LUni{}:
      Laws.gd_value_steps(T.LUni{}, {==}, st, eg, cc, ec)
    case T.LFold{}:
      Laws.gd_value_steps(T.LFold{}, {==}, st, eg, cc, ec)
    case T.LMq{}:
      Laws.gd_value_steps(T.LMq{}, {==}, st, eg, cc, ec)
    case T.LMqEnd{}:
      Laws.gd_value_steps(T.LMqEnd{}, {==}, st, eg, cc, ec)
    case T.LTrim{}:
      Laws.gd_value_steps(T.LTrim{}, {==}, st, eg, cc, ec)
    case T.LTrim2{}:
      Laws.gd_value_steps(T.LTrim2{}, {==}, st, eg, cc, ec)
    case T.LBare{}:
      Laws.gd_bare_steps(T.LBare{}, {==}, st, eg, cc, ec)
    case T.LDate{}:
      Laws.gd_bare_steps(T.LDate{}, {==}, st, eg, cc, ec)
    case T.LCom{}:
      Laws.gd_value_steps(T.LCom{}, {==}, st, eg, cc, ec)
    case T.LHead{}:
      Laws.gd_header_steps(T.LHead{}, {==}, st, eg, cc, ec)
    case T.LHeadGap{}:
      Laws.gd_header_steps(T.LHeadGap{}, {==}, st, eg, cc, ec)
    case T.LHeadDot{}:
      Laws.gd_header_steps(T.LHeadDot{}, {==}, st, eg, cc, ec)
    case T.LHeadQ{}:
      Laws.gd_header_steps(T.LHeadQ{}, {==}, st, eg, cc, ec)
    case T.LHeadE{}:
      Laws.gd_header_steps(T.LHeadE{}, {==}, st, eg, cc, ec)
    case T.LHeadU{}:
      Laws.gd_header_steps(T.LHeadU{}, {==}, st, eg, cc, ec)
    case T.LHeadR{}:
      Laws.gd_header_steps(T.LHeadR{}, {==}, st, eg, cc, ec)
    case T.LArr{}:
      Laws.gd_value_steps(T.LArr{}, {==}, st, eg, cc, ec)
    case T.LArrC{}:
      Laws.gd_value_steps(T.LArrC{}, {==}, st, eg, cc, ec)
    case T.LInl{}:
      Laws.gd_value_steps(T.LInl{}, {==}, st, eg, cc, ec)
    case T.LInlK{}:
      Laws.gd_value_steps(T.LInlK{}, {==}, st, eg, cc, ec)
    case T.LInlC{}:
      Laws.gd_value_steps(T.LInlC{}, {==}, st, eg, cc, ec)
    case T.LSink{}:
      Laws.gd_value_steps(T.LSink{}, {==}, st, eg, cc, ec)

# one character, the state read off
def gd.onst(
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.on.st(st, cc)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.on(lex, T.St{bad, rows, heads, here, parts, buf, lex, back, qkind, stack, hold, uni, left, arrtab, lead}, cc,
        eg, ec)

# a byte-order mark is dropped
def gd.sbom(
  bom: Bool,
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.step.bom(bom, st, cc)) == True{} : Bool}:
  match bom:
    case True{}:
      eg
    case False{}:
      gd.onst(st, cc, eg, ec)

# the first character may be a byte-order mark
def gd.slead(
  lead: Bool,
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.step.lead(lead, st, cc)) == True{} : Bool}:
  match lead:
    case False{}:
      gd.onst(st, cc, eg, ec)
    case True{}:
      gd.sbom(U32.is_eq(Char.to_u32(cc), 65279), st, cc, eg, ec)

# one character of the document by the full step
def gd.step(
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.step(st, cc)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.slead(lead, T.St{bad, rows, heads, here, parts, buf, lex, back, qkind, stack, hold, uni, left, arrtab,
        False{}},
        cc, eg, ec)

# a held character is read once
def gd.ohold(
  hold: T.Hold,
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool},
  +eh: {Laws.gd.hold(hold) == True{} : Bool}
) -> {Laws.good(T.read.once.hold(hold, st)) == True{} : Bool}:
  match hold:
    case T.HNone{}:
      eg
    case T.HChar{+c0}:
      gd.step(st, c0, eg, eh)

# the held character, read off the state
def gd.once2(+st: T.St, +eg: {Laws.good(st) == True{} : Bool}) -> {Laws.good(T.read.once2(st)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.ohold(hold, T.St{bad, rows, heads, here, parts, buf, lex, back, qkind, stack, T.HNone{}, uni, left, arrtab,
        lead},
        gd.tt(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, T.HNone{}),
          gd.l(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg),
          gd.lx.mk(here, parts, buf, stack, T.HNone{},
            gd.lx.h(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf,
              stack,
              hold), eg)),
            gd.lx.p(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf,
              stack,
              hold), eg)),
            gd.lx.b(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf,
              stack,
              hold), eg)),
            gd.lx.s(here, parts, buf, stack, hold, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf,
              stack,
              hold), eg)),
            {==})),
        gd.r(Laws.gd.keys(stack), Laws.gd.hold(hold), gd.lx.s1(here, parts, buf, stack, hold,
          gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, hold), eg))))

# one character, then a held one
def gd.once(
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.once(st, cc)) == True{} : Bool}:
  gd.once2(T.read.step(st, cc), gd.step(st, cc, eg, ec))


# the full step, from the fast step's state
def gd.fold(
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.old(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  gd.once2(T.read.on.st(T.read.fast.st(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left,
    arrtab), cc), gd.onst(T.read.fast.st(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left,
      arrtab), cc, eg, ec))

# the character joins the buffer
def gd.fcons(
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.cons(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  gd.tt(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, cc <> buf, stack, T.HNone{}),
    gd.l(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, T.HNone{}), eg),
    gd.lx.mk(here, parts, cc <> buf, stack, T.HNone{},
      gd.lx.h(here, parts, buf, stack, T.HNone{}, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack,
        T.HNone{}), eg)),
      gd.lx.p(here, parts, buf, stack, T.HNone{}, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack,
        T.HNone{}), eg)),
      gd.tt(T.wf.char(cc), Laws.gd.cs(buf), ec, gd.lx.b(here, parts, buf, stack, T.HNone{},
        gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack, T.HNone{}), eg))),
      gd.lx.s(here, parts, buf, stack, T.HNone{}, gd.r(Laws.gd.tr(bad, rows, stack), Laws.gd.lx(here, parts, buf, stack,
        T.HNone{}), eg)),
      {==}))


# a control takes the full step; a plain character is kept
def gd.fpush(
  ctrl: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.push(ctrl, bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match ctrl:
    case False{}:
      gd.fcons(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case True{}:
      gd.fold(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab, eg, cc, ec)


# a backslash in a basic string takes the full step
def gd.fbbs(
  bs: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.basic.bs(bs, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match bs:
    case True{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LStr{}, back, T.QBasic{}, stack, uni, left, arrtab, eg, cc, ec)
    case False{}:
      gd.fpush(T.str.bad(Char.to_u32(cc), False{}), bad, rows, heads, here, parts, buf, T.LStr{}, back, T.QBasic{},
        stack, uni, left, arrtab, eg, cc, ec)


# a quote in a basic string takes the full step
def gd.fbasic(
  quote: Bool,
  +bs: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.basic(quote, bs, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match quote:
    case True{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LStr{}, back, T.QBasic{}, stack, uni, left, arrtab, eg, cc, ec)
    case False{}:
      gd.fbbs(bs, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab, eg, cc, ec)


# a quote in a literal string takes the full step
def gd.flit(
  quote: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.lit(quote, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match quote:
    case True{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LStr{}, back, T.QLit{}, stack, uni, left, arrtab, eg, cc, ec)
    case False{}:
      gd.fpush(T.str.bad(Char.to_u32(cc), False{}), bad, rows, heads, here, parts, buf, T.LStr{}, back, T.QLit{},
        stack, uni, left, arrtab, eg, cc, ec)


# one character of a string on the fast step
def gd.fstr(
  qkind: T.QKind,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.str(qkind, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match qkind:
    case T.QBasic{}:
      gd.fbasic(Char.is_eq(cc, '"'), Char.is_eq(cc, '\\'), bad, rows, heads, here, parts, buf, back, stack, uni, left,
        arrtab, eg, cc, ec)
    case T.QLit{}:
      gd.flit(Char.is_eq(cc, '\''), bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab, eg, cc, ec)
    case T.QMulti{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LStr{}, back, T.QMulti{}, stack, uni, left, arrtab, eg, cc, ec)
    case T.QMultiLit{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LStr{}, back, T.QMultiLit{}, stack, uni, left, arrtab, eg, cc, ec)


# one character of a bare key on the fast step
def gd.fkey(
  ok: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.key(ok, bad, rows, heads, here, parts, buf, back, qkind, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match ok:
    case True{}:
      gd.fcons(bad, rows, heads, here, parts, buf, T.LKey{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case False{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LKey{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)


# one character of a bare value on the fast step
def gd.fbare(
  delim: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.bare(delim, bad, rows, heads, here, parts, buf, back, qkind, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match delim:
    case True{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LBare{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case False{}:
      gd.fcons(bad, rows, heads, here, parts, buf, T.LBare{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)


# one character of a comment on the fast step
def gd.fcom(
  ctl: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.com(ctl, bad, rows, heads, here, parts, buf, back, qkind, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match ctl:
    case True{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LCom{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case False{}:
      eg


# a newline this state ignores
def gd.fkeep(
  keep: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.ws.keep(keep, bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left,
  arrtab, cc)) == True{} : Bool}:
  match keep:
    case True{}:
      eg
    case False{}:
      gd.fold(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab, eg, cc, ec)


# a newline, or the full step
def gd.fwsnl(
  nl: Bool,
  +keep: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.ws.nl(nl, keep, bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left,
  arrtab, cc)) == True{} : Bool}:
  match nl:
    case True{}:
      gd.fkeep(keep, bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case False{}:
      gd.fold(bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab, eg, cc, ec)


# blank space this state ignores
def gd.fws(
  sp: Bool,
  +nl: Bool,
  +keep: Bool,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +back: T.Lex,
  +qkind: T.QKind,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.ws(sp, nl, keep, bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left,
  arrtab, cc)) == True{} : Bool}:
  match sp:
    case True{}:
      eg
    case False{}:
      gd.fwsnl(nl, keep, bad, rows, heads, here, parts, buf, lex, back, qkind, stack, uni, left, arrtab, eg, cc, ec)


# the fast step, by the state
def gd.flex(
  lex: T.Lex,
  +qkind: T.QKind,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.lex(lex, qkind, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match lex:
    case T.LTop{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), True{}, bad, rows, heads, here, parts, buf, T.LTop{}, back, qkind, stack, uni,
        left, arrtab, eg, cc, ec)
    case T.LLine{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), False{}, bad, rows, heads, here, parts, buf, T.LLine{}, back, qkind, stack,
        uni, left, arrtab, eg, cc, ec)
    case T.LKey{}:
      gd.fkey(T.bare.at(cc), bad, rows, heads, here, parts, buf, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LKeyDot{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LKeyDot{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LAfter{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), False{}, bad, rows, heads, here, parts, buf, T.LAfter{}, back, qkind, stack,
        uni, left, arrtab, eg, cc, ec)
    case T.LKeyQ{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LKeyQ{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LKeyE{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LKeyE{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LKeyU{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LKeyU{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LVal{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), False{}, bad, rows, heads, here, parts, buf, T.LVal{}, back, qkind, stack, uni,
        left, arrtab, eg, cc, ec)
    case T.LQ{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LQ{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LQ2{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LQ2{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LStr{}:
      gd.fstr(qkind, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab, eg, cc, ec)
    case T.LEsc{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LEsc{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LUni{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LUni{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LFold{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LFold{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LMq{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LMq{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LMqEnd{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LMqEnd{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LTrim{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LTrim{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LTrim2{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LTrim2{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LBare{}:
      gd.fbare(T.ch.delim(cc), bad, rows, heads, here, parts, buf, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LDate{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LDate{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LCom{}:
      gd.fcom(T.ch.ctl(cc), bad, rows, heads, here, parts, buf, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LHead{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LHead{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LHeadGap{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LHeadGap{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LHeadDot{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LHeadDot{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LHeadQ{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LHeadQ{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LHeadE{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LHeadE{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LHeadU{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LHeadU{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LHeadR{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LHeadR{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)
    case T.LArr{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), True{}, bad, rows, heads, here, parts, buf, T.LArr{}, back, qkind, stack, uni,
        left, arrtab, eg, cc, ec)
    case T.LArrC{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), True{}, bad, rows, heads, here, parts, buf, T.LArrC{}, back, qkind, stack, uni,
        left, arrtab, eg, cc, ec)
    case T.LInl{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), False{}, bad, rows, heads, here, parts, buf, T.LInl{}, back, qkind, stack, uni,
        left, arrtab, eg, cc, ec)
    case T.LInlK{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), False{}, bad, rows, heads, here, parts, buf, T.LInlK{}, back, qkind, stack,
        uni, left, arrtab, eg, cc, ec)
    case T.LInlC{}:
      gd.fws(T.ch.sp(cc), T.ch.nl(cc), False{}, bad, rows, heads, here, parts, buf, T.LInlC{}, back, qkind, stack,
        uni, left, arrtab, eg, cc, ec)
    case T.LSink{}:
      gd.fold(bad, rows, heads, here, parts, buf, T.LSink{}, back, qkind, stack, uni, left, arrtab, eg, cc, ec)

# the first character takes the full step
def gd.flead(
  lead: Bool,
  +lex: T.Lex,
  +qkind: T.QKind,
  +bad: String,
  +rows: List<&2, T.Val>,
  +heads: List<&2, String>,
  +here: List<&2, String>,
  +parts: List<&2, String>,
  +buf: List<&2, Char>,
  +back: T.Lex,
  +stack: List<&2, T.Ctx>,
  +uni: U32,
  +left: U32,
  +arrtab: Bool,
  +eg: {gd.gf(bad, rows, here, parts, buf, stack) == True{} : Bool},
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast.lead(lead, lex, qkind, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab,
  cc)) == True{} : Bool}:
  match lead:
    case True{}:
      gd.once(T.St{bad, rows, heads, here, parts, buf, lex, back, qkind, stack, T.HNone{}, uni, left, arrtab, True{}},
        cc, eg, ec)
    case False{}:
      gd.flex(lex, qkind, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab, eg, cc, ec)

# a held character takes the full step first
def gd.fhold(
  hd: T.Hold,
  +ld: Bool,
  +lx: T.Lex,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +ec: {T.wf.char(cc) == True{} : Bool},
  +eg: {Laws.good(T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, hd, un, lf, at, ld}) == True{} : Bool}
) -> {Laws.good(T.read.fast.hold(hd, ld, lx, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc)) == True{} : Bool}:
  match hd:
    case T.HChar{+held}:
      gd.once(T.read.once2(T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, T.HChar{held}, un, lf, at, ld}), cc,
        gd.once2(T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, T.HChar{held}, un, lf, at, ld}, eg), ec)
    case T.HNone{}:
      gd.flead(ld, lx, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, eg, cc, ec)

# one character by the fast step
def gd.fast(
  +st: T.St,
  +cc: Char,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.good(T.read.fast(st, cc)) == True{} : Bool}:
  match st:
    case T.St{+bad, +rows, +heads, +here, +parts, +buf, +lex, +back, +qkind, +stack, +hold, +uni, +left,
      +arrtab, +lead}:
      gd.fhold(hold, lead, lex, qkind, bad, rows, heads, here, parts, buf, back, stack, uni, left, arrtab, cc, ec, eg)

def Laws.gd_fast_step(st, eg, cc, ec) :
  gd.fast(st, cc, eg, ec)

def Laws.gd_held(st, eg) :
  gd.once2(st, eg)


# WP-R3: the span modes. doc.read reads the text in four modes. A scanning
# state and one after a carriage return are good states; an opening quote's
# mode is good as the quote left its state; a plain string's span keeps its
# first character and its length, and gd.sp ties the span to the text still
# to read, so each character the span takes is one the text had, a Unicode
# scalar value. A span that closes is a VSpan whose n characters are scalar
# values; one copied to the buffer puts scalar values there

# a then that holds holds its first part
def gd.th.l(aa: Bool, mm: Unit -> Bool, +ee: {T.wf.then(aa, mm) == True{} : Bool}) -> {aa == True{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      Eq.bit.absurd(&2, {False{} == True{} : Bool}, ee)

# a then that holds holds its rest
def gd.th.r(aa: Bool, mm: Unit -> Bool, +ee: {T.wf.then(aa, mm) == True{} : Bool}) -> {mm(Unit{}) == True{} : Bool}:
  match aa:
    case True{}:
      ee
    case False{}:
      Eq.bit.absurd(&2, {mm(Unit{}) == True{} : Bool}, ee)

# a Bool whose negation holds is False
def gd.not.f(bb: Bool, +ee: {Bool.not(bb) == True{} : Bool}) -> {bb == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, ee)
    case False{}:
      {==}

# a text is as long as itself
def gd.ln.self(+ss: String) -> {Laws.gd.ln(ss, ss) == True{} : Bool}:
  match ss:
    case SNil{}:
      {==}
    case SCon{_h, tt}:
      gd.ln.self(tt)

# taking a borrow from a word and then adding the carry back leaves the word
def gd.decinc.w(
  nn: Nat,
  ww: Word(nn),
  cc: Bool
) -> {Word.adc(nn, Word.adc(nn, ww, Word.zero(nn), True{}, cc), Word.zero(nn), False{}, Bool.not(cc)) == ww : Word(nn)}:
  match nn:
    case 0n:
      match ww:
        case WNil{}:
          {==}
    case 1n+pp:
      match ww:
        case WCon{bb, +tt}:
          match bb cc:
            case False{} False{}:
              Equal.cong(Word(pp), Word(1n+pp), yy => WCon{False{}, yy},
                Word.adc(pp, Word.adc(pp, tt, Word.zero(pp), True{}, False{}), Word.zero(pp), False{}, True{}), tt,
                gd.decinc.w(pp, tt, False{}))
            case False{} True{}:
              Equal.cong(Word(pp), Word(1n+pp), yy => WCon{False{}, yy},
                Word.adc(pp, Word.adc(pp, tt, Word.zero(pp), True{}, True{}), Word.zero(pp), False{}, False{}), tt,
                gd.decinc.w(pp, tt, True{}))
            case True{} False{}:
              Equal.cong(Word(pp), Word(1n+pp), yy => WCon{True{}, yy},
                Word.adc(pp, Word.adc(pp, tt, Word.zero(pp), True{}, True{}), Word.zero(pp), False{}, False{}), tt,
                gd.decinc.w(pp, tt, True{}))
            case True{} True{}:
              Equal.cong(Word(pp), Word(1n+pp), yy => WCon{True{}, yy},
                Word.adc(pp, Word.adc(pp, tt, Word.zero(pp), True{}, True{}), Word.zero(pp), False{}, False{}), tt,
                gd.decinc.w(pp, tt, True{}))

# one more than one less than a U32 is the U32
def gd.decinc(xx: U32) -> {U32.add(U32.sub(xx, 1), 1) == xx : U32}:
  match xx:
    case U32{ww}:
      match ww:
        case WCon{bb, +tt}:
          match bb:
            case False{}:
              Equal.cong(Word(31n), U32, yy => U32{WCon{False{}, yy}},
                Word.adc(31n, Word.adc(31n, tt, Word.zero(31n), True{}, False{}), Word.zero(31n), False{}, True{}),
                tt, gd.decinc.w(31n, tt, False{}))
            case True{}:
              Equal.cong(Word(31n), U32, yy => U32{WCon{True{}, yy}},
                Word.adc(31n, Word.adc(31n, tt, Word.zero(31n), True{}, True{}), Word.zero(31n), False{}, False{}),
                tt, gd.decinc.w(31n, tt, True{}))

# a span as gd.sp keeps it, at the count it has run down to
def gd.spm(+cut: String, +nn: U32, text: String) -> Bool:
  Laws.gd.sp(cut, U32.is_zero(nn), nn, text)

# the span one character on, read back at the count it came from
def gd.spm.back(
  +cut: String,
  +nn: U32,
  +text: String
) -> {gd.spm(cut, U32.sub(U32.add(nn, 1), 1), text) == gd.spm(cut, nn, text) : Bool}:
  Equal.cong(U32, Bool, xx => gd.spm(cut, xx, text), U32.sub(U32.add(nn, 1), 1), nn, Eq.sub.inc(nn))

# the span one character back and on again is at its count
def gd.spm.fwd(
  +cut: String,
  +nn: U32,
  +text: String
) -> {gd.spm(cut, U32.add(U32.sub(nn, 1), 1), text) == gd.spm(cut, nn, text) : Bool}:
  Equal.cong(U32, Bool, xx => gd.spm(cut, xx, text), U32.add(U32.sub(nn, 1), 1), nn, gd.decinc(nn))

# a span's rest, where its count has run down
def gd.sp.end(
  +ct: String,
  +nn: U32,
  +tt: String,
  +hz: {U32.is_zero(nn) == True{} : Bool},
  +ee: {Laws.gd.sp(ct, True{}, nn, tt) == True{} : Bool}
) -> {gd.spm(ct, U32.sub(U32.add(nn, 1), 1), tt) == True{} : Bool}:
  Equal.trans(Bool, gd.spm(ct, U32.sub(U32.add(nn, 1), 1), tt), gd.spm(ct, nn, tt), True{},
    gd.spm.back(ct, nn, tt),
    Equal.trans(Bool, gd.spm(ct, nn, tt), Laws.gd.sp(ct, True{}, nn, tt), True{},
      Equal.cong(Bool, Bool, zz => Laws.gd.sp(ct, zz, nn, tt), U32.is_zero(nn), True{}, hz), ee))

# a span's rest of scalar values, as long as the text, where its count has run down
def gd.sp.full(
  +ct: String,
  +nn: U32,
  +tt: String,
  +ew: {T.wf.text(ct) == True{} : Bool},
  +el: {Laws.gd.ln(ct, tt) == True{} : Bool}
) -> {Laws.gd.sp(ct, True{}, nn, tt) == True{} : Bool}:
  match ct:
    case SNil{}:
      gd.tt(T.wf.text(SNil{}), Laws.gd.ln(SNil{}, tt), {==}, el)
    case SCon{+dh, +dt}:
      gd.tt(T.wf.text(SCon{dh, dt}), Laws.gd.ln(SCon{dh, dt}, tt), ew, el)

# the rest of a span whose count has run down: scalar values, as long as the text
def gd.sp.rest(
  +ct: String,
  +nn: U32,
  +tt: String,
  +ch: Char,
  +ee: {Bool.and(T.wf.then(T.wf.char(ch), _u => T.wf.text(ct)), Laws.gd.ln(ct, tt)) == True{} : Bool}
) -> {Laws.gd.sp(ct, True{}, nn, tt) == True{} : Bool}:
  match ct:
    case SNil{}:
      gd.tt(T.wf.text(SNil{}), Laws.gd.ln(SNil{}, tt), {==},
        gd.r(T.wf.then(T.wf.char(ch), _u => T.wf.text(SNil{})), Laws.gd.ln(SNil{}, tt), ee))
    case SCon{+dh, +dt}:
      gd.tt(T.wf.text(SCon{dh, dt}), Laws.gd.ln(SCon{dh, dt}, tt),
        gd.th.r(T.wf.char(ch), _u => T.wf.text(SCon{dh, dt}),
          gd.l(T.wf.then(T.wf.char(ch), _u => T.wf.text(SCon{dh, dt})), Laws.gd.ln(SCon{dh, dt}, tt), ee)),
        gd.r(T.wf.then(T.wf.char(ch), _u => T.wf.text(SCon{dh, dt})), Laws.gd.ln(SCon{dh, dt}, tt), ee))

# a span takes the text's next character: its count goes up by one, and the
# span still reaches the text after that character
def gd.sp.inc(
  cut: String,
  zz: Bool,
  +nn: U32,
  +hh: Char,
  +tt: String,
  +hz: {U32.is_zero(nn) == zz : Bool},
  +en: {U32.is_zero(U32.add(nn, 1)) == False{} : Bool},
  +ep: {Laws.gd.sp(cut, zz, nn, SCon{hh, tt}) == True{} : Bool}
) -> {gd.spm(cut, U32.add(nn, 1), tt) == True{} : Bool}:
  match cut:
    case SNil{}:
      match zz:
        case True{}:
          Eq.bit.absurd(&2, {gd.spm(SNil{}, U32.add(nn, 1), tt) == True{} : Bool}, ep)
        case False{}:
          Eq.bit.absurd(&2, {gd.spm(SNil{}, U32.add(nn, 1), tt) == True{} : Bool}, ep)
    case SCon{+ch, +ct}:
      match zz:
        case True{}:
          Equal.trans(Bool, gd.spm(SCon{ch, ct}, U32.add(nn, 1), tt),
            Laws.gd.sp(SCon{ch, ct}, False{}, U32.add(nn, 1), tt), True{},
            Equal.cong(Bool, Bool, yy => Laws.gd.sp(SCon{ch, ct}, yy, U32.add(nn, 1), tt),
              U32.is_zero(U32.add(nn, 1)), False{}, en),
            gd.tt(T.wf.char(ch), gd.spm(ct, U32.sub(U32.add(nn, 1), 1), tt),
              gd.th.l(T.wf.char(ch), _u => T.wf.text(ct),
                gd.l(T.wf.then(T.wf.char(ch), _u => T.wf.text(ct)), Laws.gd.ln(ct, tt), ep)),
              gd.sp.end(ct, nn, tt, hz, gd.sp.rest(ct, nn, tt, ch, ep))))
        case False{}:
          Equal.trans(Bool, gd.spm(SCon{ch, ct}, U32.add(nn, 1), tt),
            Laws.gd.sp(SCon{ch, ct}, False{}, U32.add(nn, 1), tt), True{},
            Equal.cong(Bool, Bool, yy => Laws.gd.sp(SCon{ch, ct}, yy, U32.add(nn, 1), tt),
              U32.is_zero(U32.add(nn, 1)), False{}, en),
            gd.tt(T.wf.char(ch), gd.spm(ct, U32.sub(U32.add(nn, 1), 1), tt),
              gd.l(T.wf.char(ch), gd.spm(ct, U32.sub(nn, 1), SCon{hh, tt}), ep),
              Equal.trans(Bool, gd.spm(ct, U32.sub(U32.add(nn, 1), 1), tt), gd.spm(ct, nn, tt), True{},
                gd.spm.back(ct, nn, tt),
                Equal.trans(Bool, gd.spm(ct, nn, tt), gd.spm(ct, U32.add(U32.sub(nn, 1), 1), tt), True{},
                  Equal.sym(Bool, gd.spm(ct, U32.add(U32.sub(nn, 1), 1), tt), gd.spm(ct, nn, tt),
                    gd.spm.fwd(ct, nn, tt)),
                  gd.sp.inc(ct, U32.is_zero(U32.sub(nn, 1)), U32.sub(nn, 1), hh, tt, {==},
                    Equal.trans(Bool, U32.is_zero(U32.add(U32.sub(nn, 1), 1)), U32.is_zero(nn), False{},
                      Equal.cong(U32, Bool, xx => U32.is_zero(xx), U32.add(U32.sub(nn, 1), 1), nn, gd.decinc(nn)),
                      hz),
                    gd.r(T.wf.char(ch), gd.spm(ct, U32.sub(nn, 1), SCon{hh, tt}), ep))))))

# a span kept as gd.sp keeps it is a well-formed span
def gd.sp.wf(
  cut: String,
  zz: Bool,
  +nn: U32,
  +text: String,
  +ep: {Laws.gd.sp(cut, zz, nn, text) == True{} : Bool}
) -> {T.wf.span(cut, nn, zz) == True{} : Bool}:
  match cut:
    case SNil{}:
      match zz:
        case True{}:
          {==}
        case False{}:
          Eq.bit.absurd(&2, {T.wf.span(SNil{}, nn, False{}) == True{} : Bool}, ep)
    case SCon{+ch, +ct}:
      match zz:
        case True{}:
          {==}
        case False{}:
          gd.then(T.wf.char(ch), _u => T.wf.span(ct, U32.sub(nn, 1), U32.is_zero(U32.sub(nn, 1))),
            gd.l(T.wf.char(ch), gd.spm(ct, U32.sub(nn, 1), text), ep),
            gd.sp.wf(ct, U32.is_zero(U32.sub(nn, 1)), U32.sub(nn, 1), text,
              gd.r(T.wf.char(ch), gd.spm(ct, U32.sub(nn, 1), text), ep)))

# a span copied to the buffer, reversed onto scalar values, is scalar values
def gd.sp.rev(
  cut: String,
  zz: Bool,
  +nn: U32,
  +text: String,
  +acc: List<&2, Char>,
  +ep: {Laws.gd.sp(cut, zz, nn, text) == True{} : Bool},
  +ea: {Laws.gd.cs(acc) == True{} : Bool}
) -> {Laws.gd.cs(T.span.rev(cut, nn, zz, acc)) == True{} : Bool}:
  match cut:
    case SNil{}:
      match zz:
        case True{}:
          ea
        case False{}:
          ea
    case SCon{+ch, +ct}:
      match zz:
        case True{}:
          ea
        case False{}:
          gd.sp.rev(ct, U32.is_zero(U32.sub(nn, 1)), U32.sub(nn, 1), text, ch <> acc,
            gd.r(T.wf.char(ch), gd.spm(ct, U32.sub(nn, 1), text), ep),
            gd.tt(T.wf.char(ch), Laws.gd.cs(acc), gd.l(T.wf.char(ch), gd.spm(ct, U32.sub(nn, 1), text), ep), ea))

def Laws.gd_span_wf(cut, nn, text, ep) :
  gd.sp.wf(cut, U32.is_zero(nn), nn, text, ep)

def Laws.gd_next(mode, _hh, _tt):
  match mode:
    case T.MOpen{_b, _q, _k, _bd, _rw, _hs, _he, _pt, _bf, _bk, _sk, _un, _lf, _at}:
      {==}
    case T.MEat{_b, _q, _c, _n, _bd, _rw, _hs, _he, _pt, _k, _sk, _un, _lf, _at}:
      {==}
    case T.MScan{_st}:
      {==}
    case T.MCr{_st}:
      {==}


# a quote's state: a one-line string opens a span unless a character is held
# or it is the first character; every other state scans on
def gd.wlex(
  lx: T.Lex,
  hd: T.Hold,
  ld: Bool,
  qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +tl: String,
  +eg: {Laws.good(T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, hd, un, lf, at, ld}) == True{} : Bool}
) -> {Laws.gd.md(T.doc.wrap.lex(lx, bd, rw, hs, he, pt, bf, bk, qk, sk, hd, un, lf, at, ld), tl) == True{} : Bool}:
  match lx:
    case T.LTop{}:
      eg
    case T.LLine{}:
      eg
    case T.LKey{}:
      eg
    case T.LKeyDot{}:
      eg
    case T.LAfter{}:
      eg
    case T.LKeyQ{}:
      eg
    case T.LKeyE{}:
      eg
    case T.LKeyU{}:
      eg
    case T.LVal{}:
      eg
    case T.LQ{}:
      match hd:
        case T.HChar{_held}:
          eg
        case T.HNone{}:
          match ld:
            case True{}:
              eg
            case False{}:
              match qk:
                case T.QBasic{}:
                  eg
                case T.QLit{}:
                  eg
                case T.QMulti{}:
                  eg
                case T.QMultiLit{}:
                  eg
    case T.LQ2{}:
      eg
    case T.LStr{}:
      eg
    case T.LEsc{}:
      eg
    case T.LUni{}:
      eg
    case T.LFold{}:
      eg
    case T.LMq{}:
      eg
    case T.LMqEnd{}:
      eg
    case T.LTrim{}:
      eg
    case T.LTrim2{}:
      eg
    case T.LBare{}:
      eg
    case T.LDate{}:
      eg
    case T.LCom{}:
      eg
    case T.LHead{}:
      eg
    case T.LHeadGap{}:
      eg
    case T.LHeadDot{}:
      eg
    case T.LHeadQ{}:
      eg
    case T.LHeadE{}:
      eg
    case T.LHeadU{}:
      eg
    case T.LHeadR{}:
      eg
    case T.LArr{}:
      eg
    case T.LArrC{}:
      eg
    case T.LInl{}:
      eg
    case T.LInlK{}:
      eg
    case T.LInlC{}:
      eg
    case T.LSink{}:
      eg

# a state a quote may have opened a string in
def gd.wrap(
  +st: T.St,
  +tl: String,
  +eg: {Laws.good(st) == True{} : Bool}
) -> {Laws.gd.md(T.doc.wrap(st), tl) == True{} : Bool}:
  match st:
    case T.St{+bd, +rw, +hs, +he, +pt, +bf, +lx, +bk, +qk, +sk, +hd, +un, +lf, +at, +ld}:
      gd.wlex(lx, hd, ld, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, tl, eg)

# a carriage return, or another character
def gd.scr(
  cr: Bool,
  +st: T.St,
  +cc: Char,
  +tl: String,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.gd.md(T.doc.scan.cr(cr, st, cc), tl) == True{} : Bool}:
  match cr:
    case True{}:
      gd.fast(st, cc, eg, ec)
    case False{}:
      gd.fast(st, cc, eg, ec)

# an apostrophe, or another character
def gd.ssq(
  sq: Bool,
  +cr: Bool,
  +st: T.St,
  +cc: Char,
  +tl: String,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.gd.md(T.doc.scan.sq(sq, cr, st, cc), tl) == True{} : Bool}:
  match sq:
    case True{}:
      gd.wrap(T.read.fast(st, cc), tl, gd.fast(st, cc, eg, ec))
    case False{}:
      gd.scr(cr, st, cc, tl, eg, ec)

# a quote, or another character
def gd.sdq(
  dq: Bool,
  +sq: Bool,
  +cr: Bool,
  +st: T.St,
  +cc: Char,
  +tl: String,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.gd.md(T.doc.scan.q(dq, sq, cr, st, cc), tl) == True{} : Bool}:
  match dq:
    case True{}:
      gd.wrap(T.read.fast(st, cc), tl, gd.fast(st, cc, eg, ec))
    case False{}:
      gd.ssq(sq, cr, st, cc, tl, eg, ec)

# a line feed after a carriage return, or the error
def gd.dcr(
  lf: Bool,
  +st: T.St,
  +cc: Char,
  +tl: String,
  +eg: {Laws.good(st) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool}
) -> {Laws.gd.md(T.doc.cr(lf, st, cc), tl) == True{} : Bool}:
  match lf:
    case True{}:
      gd.fast(st, cc, eg, ec)
    case False{}:
      gd.g.err2(st, "carriage return without line feed", eg)


# an empty buffer starts a span at this character; a buffer in use goes the
# old way
def gd.obuf(
  bf: List<&2, Char>,
  +ba: Bool,
  +qq: Char,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +tl: String,
  +eg: {gd.gf(bd, rw, he, pt, bf, sk) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool},
  +et: {T.wf.text(tl) == True{} : Bool},
  +es: {Laws.short(SCon{cc, tl}) == True{} : Bool}
) -> {Laws.gd.md(T.doc.open.buf(ba, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl), tl) == True{} : Bool}:
  match bf:
    case []:
      gd.tt(gd.gf(bd, rw, he, pt, [], sk), Bool.and(gd.spm(SCon{cc, tl}, 1, tl), Laws.counts(tl, 1)), eg,
        gd.tt(gd.spm(SCon{cc, tl}, 1, tl), Laws.counts(tl, 1),
          gd.tt(T.wf.char(cc), Laws.gd.sp(tl, True{}, 0, tl), ec, gd.sp.full(tl, 0, tl, et, gd.ln.self(tl))),
          gd.r(Bool.not(U32.is_zero(1)), Laws.counts(tl, 1), es)))
    case +bh <> +bt:
      gd.flex(T.LQ{}, qk, bd, rw, hs, he, pt, bh <> bt, bk, sk, un, lf, at, eg, cc, ec)


# a forbidden control goes the old way; any other starts a span
def gd.ook(
  badc: Bool,
  +ba: Bool,
  +qq: Char,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +tl: String,
  +eg: {gd.gf(bd, rw, he, pt, bf, sk) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool},
  +et: {T.wf.text(tl) == True{} : Bool},
  +es: {Laws.short(SCon{cc, tl}) == True{} : Bool}
) -> {Laws.gd.md(T.doc.open.ok(badc, ba, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl),
  tl) == True{} : Bool}:
  match badc:
    case True{}:
      gd.flex(T.LQ{}, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, eg, cc, ec)
    case False{}:
      gd.obuf(bf, ba, qq, qk, bd, rw, hs, he, pt, bk, sk, un, lf, at, cc, tl, eg, ec, et, es)


# a backslash in a basic string goes the old way
def gd.obs(
  bs: Bool,
  +qq: Char,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +tl: String,
  +eg: {gd.gf(bd, rw, he, pt, bf, sk) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool},
  +et: {T.wf.text(tl) == True{} : Bool},
  +es: {Laws.short(SCon{cc, tl}) == True{} : Bool}
) -> {Laws.gd.md(T.doc.open.bs(bs, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl), tl) == True{} : Bool}:
  match bs:
    case True{}:
      gd.flex(T.LQ{}, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, eg, cc, ec)
    case False{}:
      gd.ook(T.str.bad(Char.to_u32(cc), False{}), True{}, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl,
        eg, ec, et, es)


# a literal string keeps a backslash; a basic string does not
def gd.ob(
  ba: Bool,
  +qq: Char,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +tl: String,
  +eg: {gd.gf(bd, rw, he, pt, bf, sk) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool},
  +et: {T.wf.text(tl) == True{} : Bool},
  +es: {Laws.short(SCon{cc, tl}) == True{} : Bool}
) -> {Laws.gd.md(T.doc.open.b(ba, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl), tl) == True{} : Bool}:
  match ba:
    case False{}:
      gd.ook(T.str.bad(Char.to_u32(cc), False{}), False{}, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl,
        eg, ec, et, es)
    case True{}:
      gd.obs(Char.is_eq(cc, '\\'), qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl, eg, ec, et, es)


# a second quote goes the old way
def gd.oq(
  same: Bool,
  +ba: Bool,
  +qq: Char,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +tl: String,
  +eg: {gd.gf(bd, rw, he, pt, bf, sk) == True{} : Bool},
  +ec: {T.wf.char(cc) == True{} : Bool},
  +et: {T.wf.text(tl) == True{} : Bool},
  +es: {Laws.short(SCon{cc, tl}) == True{} : Bool}
) -> {Laws.gd.md(T.doc.open.q(same, ba, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl),
  tl) == True{} : Bool}:
  match same:
    case True{}:
      gd.flex(T.LQ{}, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, eg, cc, ec)
    case False{}:
      gd.ob(ba, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tl, eg, ec, et, es)


# the span copied to the buffer, and the character read the old way
def gd.ecopy(
  +ct: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +hh: Char,
  +tt: String,
  +eg: {gd.gf(bd, rw, he, pt, [], sk) == True{} : Bool},
  +ep: {gd.spm(ct, nn, SCon{hh, tt}) == True{} : Bool},
  +eh: {T.wf.char(hh) == True{} : Bool},
  _en: {Laws.counts(SCon{hh, tt}, nn) == True{} : Bool}
) -> {Laws.gd.md(T.eat.copy(hh, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at), tt) == True{} : Bool}:
  gd.g.str(T.St{bd, rw, hs, he, pt, T.span.rev(ct, nn, U32.is_zero(nn), []), T.LStr{}, T.LStr{}, qk, sk, T.HNone{},
    un, lf, at, False{}}, hh,
    gd.tt(Laws.gd.tr(bd, rw, sk), Laws.gd.lx(he, pt, T.span.rev(ct, nn, U32.is_zero(nn), []), sk, T.HNone{}),
      gd.l(Laws.gd.tr(bd, rw, sk), Laws.gd.lx(he, pt, [], sk, T.HNone{}), eg),
      gd.lx.mk(he, pt, T.span.rev(ct, nn, U32.is_zero(nn), []), sk, T.HNone{}, gd.lx.h(he, pt, [], sk, T.HNone{},
        gd.r(Laws.gd.tr(bd, rw, sk), Laws.gd.lx(he, pt, [], sk, T.HNone{}), eg)), gd.lx.p(he, pt, [], sk, T.HNone{},
          gd.r(Laws.gd.tr(bd, rw, sk), Laws.gd.lx(he, pt, [], sk, T.HNone{}), eg)),
        gd.sp.rev(ct, U32.is_zero(nn), nn, SCon{hh, tt}, [], ep, {==}), gd.lx.s(he, pt, [], sk, T.HNone{},
          gd.r(Laws.gd.tr(bd, rw, sk), Laws.gd.lx(he, pt, [], sk, T.HNone{}), eg)), {==})),
    eh)

# the span one character longer
def gd.emore(
  +ba: Bool,
  +qq: Char,
  +ct: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +hh: Char,
  +tt: String,
  +eg: {gd.gf(bd, rw, he, pt, [], sk) == True{} : Bool},
  +ep: {gd.spm(ct, nn, SCon{hh, tt}) == True{} : Bool},
  +en: {Laws.counts(SCon{hh, tt}, nn) == True{} : Bool}
) -> {Laws.gd.md(T.MEat{ba, qq, ct, U32.add(nn, 1), bd, rw, hs, he, pt, qk, sk, un, lf, at}, tt) == True{} : Bool}:
  gd.tt(gd.gf(bd, rw, he, pt, [], sk), Bool.and(gd.spm(ct, U32.add(nn, 1), tt), Laws.counts(tt, U32.add(nn, 1))), eg,
    gd.tt(gd.spm(ct, U32.add(nn, 1), tt), Laws.counts(tt, U32.add(nn, 1)),
      gd.sp.inc(ct, U32.is_zero(nn), nn, hh, tt, {==},
        gd.not.f(U32.is_zero(U32.add(nn, 1)),
          gd.l(Bool.not(U32.is_zero(U32.add(nn, 1))), Laws.counts(tt, U32.add(nn, 1)), en)),
        ep),
      gd.r(Bool.not(U32.is_zero(U32.add(nn, 1))), Laws.counts(tt, U32.add(nn, 1)), en)))


# a forbidden control copies the span; a plain character extends it
def gd.ectrl(
  badc: Bool,
  +ba: Bool,
  +qq: Char,
  +ct: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +hh: Char,
  +tt: String,
  +eg: {gd.gf(bd, rw, he, pt, [], sk) == True{} : Bool},
  +ep: {gd.spm(ct, nn, SCon{hh, tt}) == True{} : Bool},
  +en: {Laws.counts(SCon{hh, tt}, nn) == True{} : Bool},
  +eh: {T.wf.char(hh) == True{} : Bool}
) -> {Laws.gd.md(T.eat.ctrl(badc, ba, qq, hh, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at), tt) == True{} : Bool}:
  match badc:
    case True{}:
      gd.ecopy(ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh, tt, eg, ep, eh, en)
    case False{}:
      gd.emore(ba, qq, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh, tt, eg, ep, en)


# a backslash in a basic string copies the span
def gd.ebs(
  bs: Bool,
  +ba: Bool,
  +qq: Char,
  +ct: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +hh: Char,
  +tt: String,
  +eg: {gd.gf(bd, rw, he, pt, [], sk) == True{} : Bool},
  +ep: {gd.spm(ct, nn, SCon{hh, tt}) == True{} : Bool},
  +en: {Laws.counts(SCon{hh, tt}, nn) == True{} : Bool},
  +eh: {T.wf.char(hh) == True{} : Bool}
) -> {Laws.gd.md(T.eat.bs(bs, ba, qq, hh, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at), tt) == True{} : Bool}:
  match bs:
    case True{}:
      gd.ecopy(ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh, tt, eg, ep, eh, en)
    case False{}:
      gd.ectrl(T.str.bad(Char.to_u32(hh), False{}), ba, qq, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh, tt,
        eg, ep, en, eh)


# a literal string's character, or a basic string's
def gd.ebasic(
  ba: Bool,
  +qq: Char,
  +ct: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +hh: Char,
  +tt: String,
  +eg: {gd.gf(bd, rw, he, pt, [], sk) == True{} : Bool},
  +ep: {gd.spm(ct, nn, SCon{hh, tt}) == True{} : Bool},
  +en: {Laws.counts(SCon{hh, tt}, nn) == True{} : Bool},
  +eh: {T.wf.char(hh) == True{} : Bool}
) -> {Laws.gd.md(T.eat.basic(ba, qq, hh, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at), tt) == True{} : Bool}:
  match ba:
    case False{}:
      gd.ectrl(T.str.bad(Char.to_u32(hh), False{}), False{}, qq, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh,
        tt, eg, ep, en, eh)
    case True{}:
      gd.ebs(Char.is_eq(hh, '\\'), True{}, qq, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh, tt, eg, ep, en, eh)


# the quote closes the span as a VSpan; any other character goes on
def gd.eq(
  quote: Bool,
  +ba: Bool,
  +qq: Char,
  +ct: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +hh: Char,
  +tt: String,
  +eg: {gd.gf(bd, rw, he, pt, [], sk) == True{} : Bool},
  +ep: {gd.spm(ct, nn, SCon{hh, tt}) == True{} : Bool},
  +en: {Laws.counts(SCon{hh, tt}, nn) == True{} : Bool},
  +eh: {T.wf.char(hh) == True{} : Bool}
) -> {Laws.gd.md(T.eat.feed.q(quote, ba, qq, hh, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at), tt) == True{} : Bool}:
  match quote:
    case True{}:
      gd.g.take(T.St{bd, rw, hs, he, pt, [], T.LStr{}, T.LStr{}, qk, sk, T.HNone{}, un, lf, at, False{}},
        T.VSpan{ct, nn}, eg,
        gd.okv.of(T.St{bd, rw, hs, he, pt, [], T.LStr{}, T.LStr{}, qk, sk, T.HNone{}, un, lf, at, False{}},
          T.VSpan{ct, nn}, Laws.gd_span_wf(ct, nn, SCon{hh, tt}, ep)))
    case False{}:
      gd.ebasic(ba, qq, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh, tt, eg, ep, en, eh)


def Laws.gd_mode_step(mode, hh, tt, em, eh, et, es) :
  match mode:
    case T.MOpen{+ba, +qq, +qk, +bd, +rw, +hs, +he, +pt, +bf, +bk, +sk, +un, +lf, +at}:
      gd.oq(Char.is_eq(hh, qq), ba, qq, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, hh, tt, em, eh, et, es)
    case T.MEat{+ba, +qq, +ct, +nn, +bd, +rw, +hs, +he, +pt, +qk, +sk, +un, +lf, +at}:
      gd.eq(Char.is_eq(hh, qq), ba, qq, ct, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at, hh, tt,
        gd.l(gd.gf(bd, rw, he, pt, [], sk), Bool.and(gd.spm(ct, nn, SCon{hh, tt}), Laws.counts(SCon{hh, tt}, nn)), em),
        gd.l(gd.spm(ct, nn, SCon{hh, tt}), Laws.counts(SCon{hh, tt}, nn),
          gd.r(gd.gf(bd, rw, he, pt, [], sk), Bool.and(gd.spm(ct, nn, SCon{hh, tt}), Laws.counts(SCon{hh, tt}, nn)),
            em)),
        gd.r(gd.spm(ct, nn, SCon{hh, tt}), Laws.counts(SCon{hh, tt}, nn),
          gd.r(gd.gf(bd, rw, he, pt, [], sk), Bool.and(gd.spm(ct, nn, SCon{hh, tt}), Laws.counts(SCon{hh, tt}, nn)),
            em)),
        eh)
    case T.MScan{+st}:
      gd.sdq(Char.is_eq(hh, '"'), Char.is_eq(hh, '\''), U32.is_eq(Char.to_u32(hh), 13), st, hh, tt, em, eh)
    case T.MCr{+st}:
      gd.dcr(Char.is_eq(hh, '\n'), st, hh, tt, em, eh)


# WP-R3: the induction over the text. Each character keeps doc.read's mode
# good (gd_mode_step); the text runs out in a scanning state, one after a
# carriage return, or an opening quote's, whose token is closed and held
# character read before gd_fin seals it, or in a string's span, which is an
# error. Every end that is not an error is well-formed

# counting from one more without wrapping counts from one less too
def gd.cm(
  ss: String,
  +mm: U32,
  +hz: {U32.is_zero(U32.add(mm, 1)) == False{} : Bool},
  +hc: {Laws.counts(ss, U32.add(mm, 1)) == True{} : Bool}
) -> {Laws.counts(ss, mm) == True{} : Bool}:
  match ss:
    case SNil{}:
      {==}
    case SCon{_h, +st}:
      gd.tt(Bool.not(U32.is_zero(U32.add(mm, 1))), Laws.counts(st, U32.add(mm, 1)),
        Equal.cong(Bool, Bool, bb => Bool.not(bb), U32.is_zero(U32.add(mm, 1)), False{}, hz),
        gd.cm(st, U32.add(mm, 1),
          gd.not.f(U32.is_zero(U32.add(U32.add(mm, 1), 1)),
            gd.l(Bool.not(U32.is_zero(U32.add(U32.add(mm, 1), 1))), Laws.counts(st, U32.add(U32.add(mm, 1), 1)), hc)),
          gd.r(Bool.not(U32.is_zero(U32.add(U32.add(mm, 1), 1))), Laws.counts(st, U32.add(U32.add(mm, 1), 1)), hc)))

# the rest of a short text is short
def gd.short.tail(
  +hh: Char,
  +tt: String,
  +es: {Laws.short(SCon{hh, tt}) == True{} : Bool}
) -> {Laws.short(tt) == True{} : Bool}:
  gd.cm(tt, 0, {==}, gd.r(Bool.not(U32.is_zero(1)), Laws.counts(tt, 1), es))

# an unfinished document is an error, so a document with no error is not one
def gd.unc(
  +st: T.St,
  +eo: {String.is_empty(T.bad(T.read.fin.unclosed(st))) == True{} : Bool}
) -> {T.wf(T.read.fin.unclosed(st)) == True{} : Bool}:
  match st:
    case T.St{+bd, +rw, +hs, +he, +pt, +bf, +lx, +bk, +qk, +sk, +hd, +un, +lf, +at, +ld}:
      match bd:
        case SNil{}:
          Eq.bit.absurd(&2, {T.wf(T.read.fin.unclosed(T.St{"", rw, hs, he, pt, bf, lx, bk, qk, sk, hd, un, lf, at,
            ld})) == True{} : Bool}, eo)
        case SCon{+bh, +bt}:
          Eq.bit.absurd(&2, {T.wf(T.read.fin.unclosed(T.St{SCon{bh, bt}, rw, hs, he, pt, bf, lx, bk, qk, sk, hd, un,
            lf, at, ld})) == True{} : Bool}, eo)

# a token still open at the end is closed: a bare word read as a value, an
# empty string or a multiline string placed
def gd.rlex(
  lx: T.Lex,
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool}
) -> {Laws.good(T.read.fin.lex(lx, st)) == True{} : Bool}:
  match lx:
    case T.LTop{}:
      eg
    case T.LLine{}:
      eg
    case T.LKey{}:
      eg
    case T.LKeyDot{}:
      eg
    case T.LAfter{}:
      eg
    case T.LKeyQ{}:
      eg
    case T.LKeyE{}:
      eg
    case T.LKeyU{}:
      eg
    case T.LVal{}:
      eg
    case T.LQ{}:
      eg
    case T.LQ2{}:
      gd.g.take(st, T.VStr{""}, eg, gd.okv.of(st, T.VStr{""}, {==}))
    case T.LStr{}:
      eg
    case T.LEsc{}:
      eg
    case T.LUni{}:
      eg
    case T.LFold{}:
      eg
    case T.LMq{}:
      eg
    case T.LMqEnd{}:
      gd.g.strfin(st, eg)
    case T.LTrim{}:
      eg
    case T.LTrim2{}:
      eg
    case T.LBare{}:
      gd.g.bfin(st, ' ', False{}, eg, {==})
    case T.LDate{}:
      gd.g.bfin(st, ' ', False{}, eg, {==})
    case T.LCom{}:
      eg
    case T.LHead{}:
      eg
    case T.LHeadGap{}:
      eg
    case T.LHeadDot{}:
      eg
    case T.LHeadQ{}:
      eg
    case T.LHeadE{}:
      eg
    case T.LHeadU{}:
      eg
    case T.LHeadR{}:
      eg
    case T.LArr{}:
      eg
    case T.LArrC{}:
      eg
    case T.LInl{}:
      eg
    case T.LInlK{}:
      eg
    case T.LInlC{}:
      eg
    case T.LSink{}:
      eg

# the end's token closed, read off the state
def gd.rclose(+st: T.St, +eg: {Laws.good(st) == True{} : Bool}) -> {Laws.good(T.read.fin.close(st)) == True{} : Bool}:
  match st:
    case T.St{+bd, +rw, +hs, +he, +pt, +bf, +lx, +bk, +qk, +sk, +hd, +un, +lf, +at, +ld}:
      gd.rlex(lx, T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, hd, un, lf, at, ld}, eg)

# a comment at the end ends the document where the line could, and is an
# error anywhere else
def gd.rcom(
  ok: Bool,
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool},
  +eo: {String.is_empty(T.bad(T.read.fin.com(ok, st))) == True{} : Bool}
) -> {T.wf(T.read.fin.com(ok, st)) == True{} : Bool}:
  match ok:
    case True{}:
      Laws.gd_fin(st, eg, eo)
    case False{}:
      gd.unc(st, eo)

# a comment at the end, read off the state
def gd.rcomst(
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool},
  +eo: {String.is_empty(T.bad(T.read.fin.com.st(st))) == True{} : Bool}
) -> {T.wf(T.read.fin.com.st(st)) == True{} : Bool}:
  match st:
    case T.St{+bd, +rw, +hs, +he, +pt, +bf, +lx, +bk, +qk, +sk, +hd, +un, +lf, +at, +ld}:
      gd.rcom(T.read.fin.end(bk), T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, hd, un, lf, at, ld}, eg, eo)

# the states that may end a document end it; any other is an error
def gd.rok(
  lx: T.Lex,
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool},
  +eo: {String.is_empty(T.bad(T.read.fin.ok(lx, st))) == True{} : Bool}
) -> {T.wf(T.read.fin.ok(lx, st)) == True{} : Bool}:
  match lx:
    case T.LTop{}:
      Laws.gd_fin(st, eg, eo)
    case T.LLine{}:
      Laws.gd_fin(st, eg, eo)
    case T.LKey{}:
      gd.unc(st, eo)
    case T.LKeyDot{}:
      gd.unc(st, eo)
    case T.LAfter{}:
      gd.unc(st, eo)
    case T.LKeyQ{}:
      gd.unc(st, eo)
    case T.LKeyE{}:
      gd.unc(st, eo)
    case T.LKeyU{}:
      gd.unc(st, eo)
    case T.LVal{}:
      gd.unc(st, eo)
    case T.LQ{}:
      gd.unc(st, eo)
    case T.LQ2{}:
      gd.unc(st, eo)
    case T.LStr{}:
      gd.unc(st, eo)
    case T.LEsc{}:
      gd.unc(st, eo)
    case T.LUni{}:
      gd.unc(st, eo)
    case T.LFold{}:
      gd.unc(st, eo)
    case T.LMq{}:
      gd.unc(st, eo)
    case T.LMqEnd{}:
      gd.unc(st, eo)
    case T.LTrim{}:
      gd.unc(st, eo)
    case T.LTrim2{}:
      gd.unc(st, eo)
    case T.LBare{}:
      gd.unc(st, eo)
    case T.LDate{}:
      gd.unc(st, eo)
    case T.LCom{}:
      gd.rcomst(st, eg, eo)
    case T.LHead{}:
      gd.unc(st, eo)
    case T.LHeadGap{}:
      gd.unc(st, eo)
    case T.LHeadDot{}:
      gd.unc(st, eo)
    case T.LHeadQ{}:
      gd.unc(st, eo)
    case T.LHeadE{}:
      gd.unc(st, eo)
    case T.LHeadU{}:
      gd.unc(st, eo)
    case T.LHeadR{}:
      gd.unc(st, eo)
    case T.LArr{}:
      gd.unc(st, eo)
    case T.LArrC{}:
      gd.unc(st, eo)
    case T.LInl{}:
      gd.unc(st, eo)
    case T.LInlK{}:
      gd.unc(st, eo)
    case T.LInlC{}:
      gd.unc(st, eo)
    case T.LSink{}:
      Laws.gd_fin(st, eg, eo)

# the end, read off the closed state
def gd.rfin2(
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool},
  +eo: {String.is_empty(T.bad(T.read.fin2(st))) == True{} : Bool}
) -> {T.wf(T.read.fin2(st)) == True{} : Bool}:
  match st:
    case T.St{+bd, +rw, +hs, +he, +pt, +bf, +lx, +bk, +qk, +sk, +hd, +un, +lf, +at, +ld}:
      gd.rok(lx, T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, hd, un, lf, at, ld}, eg, eo)

# a good state at the end of the text gives a well-formed document, unless
# it gives an error
def gd.rfin(
  +st: T.St,
  +eg: {Laws.good(st) == True{} : Bool},
  +eo: {String.is_empty(T.bad(T.read.fin(st))) == True{} : Bool}
) -> {T.wf(T.read.fin(st)) == True{} : Bool}:
  gd.rfin2(T.read.fin.close(st), gd.rclose(st, eg), eo)

# the text runs out: in a scanning state, after a carriage return, after an
# opening quote, or in a span, which is an error
def gd.dend(
  mode: T.Mode,
  +em: {Laws.gd.md(mode, SNil{}) == True{} : Bool},
  +eo: {String.is_empty(T.bad(T.doc.read(SNil{}, mode))) == True{} : Bool}
) -> {T.wf(T.doc.read(SNil{}, mode)) == True{} : Bool}:
  match mode:
    case T.MScan{+st}:
      gd.rfin(T.read.once2(st), gd.once2(st, em), eo)
    case T.MCr{+st}:
      gd.rfin(T.read.once2(T.st.err(st, "carriage return without line feed")),
        gd.once2(T.st.err(st, "carriage return without line feed"),
          gd.g.err2(st, "carriage return without line feed", em)), eo)
    case T.MOpen{_ba, _qq, +qk, +bd, +rw, +hs, +he, +pt, +bf, +bk, +sk, +un, +lf, +at}:
      gd.rfin(T.read.once2(T.St{bd, rw, hs, he, pt, bf, T.LQ{}, bk, qk, sk, T.HNone{}, un, lf, at, False{}}),
        gd.once2(T.St{bd, rw, hs, he, pt, bf, T.LQ{}, bk, qk, sk, T.HNone{}, un, lf, at, False{}}, em), eo)
    case T.MEat{_ba, _qq, _ct, _nn, +bd, +rw, +hs, +he, +pt, +qk, +sk, +un, +lf, +at}:
      gd.unc(T.St{bd, rw, hs, he, pt, [], T.LStr{}, T.LStr{}, qk, sk, T.HNone{}, un, lf, at, False{}}, eo)

# doc.read's error, one character on
def gd.nexto(
  +mode: T.Mode,
  +hh: Char,
  +tt: String,
  +eo: {String.is_empty(T.bad(T.doc.read(SCon{hh, tt}, mode))) == True{} : Bool}
) -> {String.is_empty(T.bad(T.doc.read(tt, Laws.gd.next(mode, hh, tt)))) == True{} : Bool}:
  Equal.trans(Bool, String.is_empty(T.bad(T.doc.read(tt, Laws.gd.next(mode, hh, tt)))),
    String.is_empty(T.bad(T.doc.read(SCon{hh, tt}, mode))), True{},
    Equal.sym(Bool, String.is_empty(T.bad(T.doc.read(SCon{hh, tt}, mode))),
      String.is_empty(T.bad(T.doc.read(tt, Laws.gd.next(mode, hh, tt)))),
      Equal.cong(T.Doc, Bool, dd => String.is_empty(T.bad(dd)), T.doc.read(SCon{hh, tt}, mode),
        T.doc.read(tt, Laws.gd.next(mode, hh, tt)), Laws.gd_next(mode, hh, tt))),
    eo)

# doc.read's document, one character on
def gd.nextw(
  +mode: T.Mode,
  +hh: Char,
  +tt: String,
  +ew: {T.wf(T.doc.read(tt, Laws.gd.next(mode, hh, tt))) == True{} : Bool}
) -> {T.wf(T.doc.read(SCon{hh, tt}, mode)) == True{} : Bool}:
  Equal.trans(Bool, T.wf(T.doc.read(SCon{hh, tt}, mode)), T.wf(T.doc.read(tt, Laws.gd.next(mode, hh, tt))), True{},
    Equal.cong(T.Doc, Bool, dd => T.wf(dd), T.doc.read(SCon{hh, tt}, mode),
      T.doc.read(tt, Laws.gd.next(mode, hh, tt)), Laws.gd_next(mode, hh, tt)),
    ew)

def Laws.gd_read(text, mode, em, ew, es, eo) :
  match text:
    case SNil{}:
      gd.dend(mode, em, eo)
    case SCon{+hh, +tt}:
      gd.nextw(mode, hh, tt,
        Laws.gd_read(tt, Laws.gd.next(mode, hh, tt),
          Laws.gd_mode_step(mode, hh, tt, em, gd.th.l(T.wf.char(hh), _u => T.wf.text(tt), ew),
            gd.th.r(T.wf.char(hh), _u => T.wf.text(tt), ew), es),
          gd.th.r(T.wf.char(hh), _u => T.wf.text(tt), ew),
          gd.short.tail(hh, tt, es),
          gd.nexto(mode, hh, tt, eo)))

def Laws.parse_wf(text, ew, es, eo) :
  Laws.gd_read(text, T.MScan{T.st.start()},
    Laws.gd_start([], [], [], T.LTop{}, T.LTop{}, T.QBasic{}, 0, 0, False{}, True{}, {==}, {==}), ew, es, eo)

# WP-R2: TOML-RT-2. The first half is TOML-RT-1 at parse(t), which TOML-RT-3
# makes well-formed. The second reads render_parse_canon through render:
# render writes a span as the owned string of its characters
# (span_quote_basic), so render(own(x)) is render(x); and render already writes
# each table's pairs that are no table before its tables, so render(canon(d))
# is render(d). An element of an array of tables is written under its own
# path and canon stores it under the array's, which wf.aot makes one string.

# the pass as render calls it for a table's rows, keeping the separator
def r2.P(xs: List<&2, T.Val>, +gg: String, +tb: Bool) -> String:
  T.render.pass(xs, gg, True{}, tb)

# what render.go writes after an item: the separator, then the rest
def r2.R(+tt: List<&2, T.Val>, +gg: String, +tr: Bool) -> String:
  String.append(T.render.suf(gg, tr, List.is_empty(&2, T.Val, tt)), T.render.go(tt, gg, tr))

# a table's text in the pass that writes tables, and nothing in the other
def r2.tab(tb: Bool, ss: String) -> String:
  match tb:
    case True{}:
      ss
    case False{}:
      ""

# a key's text and the separator in the pass that writes keys, and nothing in
# the other
def r2.key(tb: Bool, ss: String, gg: String) -> String:
  match tb:
    case True{}:
      ""
    case False{}:
      ss ++ gg

# what one pass writes for one row, before the rest
def r2.hd(hh: T.Val, +gg: String, +tb: Bool) -> String:
  match hh:
    case T.VPair{_n, T.VHead{pp, rr}}:
      r2.tab(tb, "[" ++ pp ++ "]\n" ++ T.render.both(rr, "\n", True{}))
    case T.VPair{_n, T.VAots{_p, es}}:
      r2.tab(tb, T.render.both(es, "\n", True{}))
    case T.VAot{pp, rr}:
      r2.tab(tb, "[[" ++ pp ++ "]]\n" ++ T.render.both(rr, "\n", True{}))
    case T.VPair{nn, T.VArr{ii}}:
      r2.key(tb, T.key(nn) ++ " = [" ++ T.render.go(ii, ", ", False{}) ++ "]", gg)
    case T.VPair{nn, T.VInl{ii}}:
      r2.key(tb, T.key(nn) ++ " = {" ++ T.render.go(ii, ", ", False{}) ++ "}", gg)
    case T.VPair{nn, vv}:
      r2.key(tb, T.key(nn) ++ " = " ++ T.render.atom(vv), gg)
    case T.VArr{ii}:
      r2.key(tb, "[" ++ T.render.go(ii, ", ", False{}) ++ "]", gg)
    case T.VInl{ii}:
      r2.key(tb, "{" ++ T.render.go(ii, ", ", False{}) ++ "}", gg)
    case vv:
      r2.key(tb, T.render.atom(vv), gg)

# what render.go writes for one item, followed by the given rest
def r2.gk(hh: T.Val, rr: String) -> String:
  match hh:
    case T.VPair{_n, T.VHead{pp, ls}}:
      "[" ++ pp ++ "]\n" ++ T.render.go(ls, "\n", True{}) ++ rr
    case T.VPair{_n, T.VAots{_p, es}}:
      T.render.go(es, "\n", True{}) ++ rr
    case T.VAot{pp, ls}:
      "[[" ++ pp ++ "]]\n" ++ T.render.go(ls, "\n", True{}) ++ rr
    case T.VPair{nn, T.VArr{ii}}:
      T.key(nn) ++ " = [" ++ T.render.go(ii, ", ", False{}) ++ "]" ++ rr
    case T.VPair{nn, T.VInl{ii}}:
      T.key(nn) ++ " = {" ++ T.render.go(ii, ", ", False{}) ++ "}" ++ rr
    case T.VPair{nn, vv}:
      T.key(nn) ++ " = " ++ T.render.atom(vv) ++ rr
    case T.VArr{ii}:
      "[" ++ T.render.go(ii, ", ", False{}) ++ "]" ++ rr
    case T.VInl{ii}:
      "{" ++ T.render.go(ii, ", ", False{}) ++ "}" ++ rr
    case vv:
      T.render.atom(vv) ++ rr

# two appends of equal parts are equal
def r2.app2(
  +aa: String,
  +bb: String,
  +cc: String,
  +dd: String,
  e1: {aa == bb : String},
  e2: {cc == dd : String}
) -> {String.append(aa, cc) == String.append(bb, dd) : String}:
  Equal.trans(String, String.append(aa, cc), String.append(bb, cc), String.append(bb, dd),
    Equal.cong(String, String, zz => String.append(zz, cc), aa, bb, e1),
    Equal.cong(String, String, zz => String.append(bb, zz), cc, dd, e2))

# four parts and a rest, regrouped
def r2.as4(
  +aa: String,
  +bb: String,
  +cc: String,
  +dd: String,
  +rr: String
) -> {String.append(aa, String.append(bb, String.append(cc, String.append(dd, rr))))
  == String.append(String.append(aa, String.append(bb, String.append(cc, dd))), rr) : String}:
  +xx = {String.append(bb, String.append(cc, dd)) : String}
  Equal.sym(String, String.append(String.append(aa, xx), rr),
    String.append(aa, String.append(bb, String.append(cc, String.append(dd, rr)))),
    Equal.trans(String, String.append(String.append(aa, xx), rr), String.append(aa, String.append(xx, rr)),
      String.append(aa, String.append(bb, String.append(cc, String.append(dd, rr)))),
      Eq.append_assoc(aa, xx, rr),
      Equal.cong(String, String, zz => String.append(aa, zz), String.append(xx, rr),
        String.append(bb, String.append(cc, String.append(dd, rr))),
        Equal.trans(String, String.append(xx, rr), String.append(bb, String.append(String.append(cc, dd), rr)),
          String.append(bb, String.append(cc, String.append(dd, rr))),
          Eq.append_assoc(bb, String.append(cc, dd), rr),
          Equal.cong(String, String, zz => String.append(bb, zz), String.append(String.append(cc, dd), rr),
            String.append(cc, String.append(dd, rr)), Eq.append_assoc(cc, dd, rr))))))

# a table's header and rows, then the rest
def r2.sp.h(
  tb: Bool,
  +pp: String,
  rows: List<&2, T.Val>,
  tt: List<&2, T.Val>,
  +gg: String,
  +nn: String,
  +rr: String
) -> {T.render.head(tb, pp, rows, tt, gg, True{}, _u => nn, _v => rr)
  == String.append(r2.tab(tb, "[" ++ pp ++ "]\n" ++ nn), rr) : String}:
  match tb:
    case False{}:
      {==}
    case True{}:
      r2.as4("[", pp, "]\n", nn, rr)

# an array of tables' elements, then the rest
def r2.sp.a(
  tb: Bool,
  es: List<&2, T.Val>,
  tt: List<&2, T.Val>,
  +gg: String,
  +nn: String,
  +rr: String
) -> {T.render.aots(tb, es, tt, gg, True{}, _u => nn, _v => rr) == String.append(r2.tab(tb, nn), rr) : String}:
  match tb:
    case False{}:
      {==}
    case True{}:
      {==}

# an element's header and rows, then the rest
def r2.sp.o(
  tb: Bool,
  +pp: String,
  rows: List<&2, T.Val>,
  tt: List<&2, T.Val>,
  +gg: String,
  +nn: String,
  +rr: String
) -> {T.render.aot(tb, pp, rows, tt, gg, True{}, _u => nn, _v => rr)
  == String.append(r2.tab(tb, "[[" ++ pp ++ "]]\n" ++ nn), rr) : String}:
  match tb:
    case False{}:
      {==}
    case True{}:
      r2.as4("[[", pp, "]]\n", nn, rr)

# a key's text and the separator, then the rest
def r2.sp.v(
  tb: Bool,
  +text: String,
  +tt: List<&2, T.Val>,
  +gg: String,
  +rr: String
) -> {T.render.val(tb, text, tt, gg, True{}, _u => rr) == String.append(r2.key(tb, text, gg), rr) : String}:
  match tb:
    case True{}:
      {==}
    case False{}:
      Equal.sym(String, String.append(String.append(text, gg), rr), String.append(text, String.append(gg, rr)),
        Eq.append_assoc(text, gg, rr))

# the pass writes a row's text, then the rest
def r2.split(
  hh: T.Val,
  +tt: List<&2, T.Val>,
  +gg: String,
  +tb: Bool
) -> {r2.P(hh <> tt, gg, tb) == String.append(r2.hd(hh, gg, tb), r2.P(tt, gg, tb)) : String}:
  match hh:
    case T.VPair{+kk, T.VStr{+a1}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VStr{a1}), tt, gg, r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VSpan{+a1, +a2}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VSpan{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VInt{+a1, +a2}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VInt{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VFlo{+a1, +a2}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VFlo{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VBool{+a1}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VBool{a1}), tt, gg, r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VWhen{+a1}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VWhen{a1}), tt, gg, r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VArr{+a1}}:
      r2.sp.v(tb, T.key(kk) ++ " = [" ++ T.render.go(a1, ", ", False{}) ++ "]", tt, gg,
        r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VInl{+a1}}:
      r2.sp.v(tb, T.key(kk) ++ " = {" ++ T.render.go(a1, ", ", False{}) ++ "}", tt, gg,
        r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VHead{+a1, +a2}}:
      r2.sp.h(tb, a1, a2, tt, gg, T.render.both(a2, "\n", True{}),
        r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VAot{+a1, +a2}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VAot{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VAots{+a1, +a2}}:
      r2.sp.a(tb, a2, tt, gg, T.render.both(a2, "\n", True{}),
        r2.P(tt, gg, tb))
    case T.VPair{+kk, T.VPair{+a1, +a2}}:
      r2.sp.v(tb, T.key(kk) ++ " = " ++ T.render.atom(T.VPair{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VStr{+a1}:
      r2.sp.v(tb, T.render.atom(T.VStr{a1}), tt, gg, r2.P(tt, gg, tb))
    case T.VSpan{+a1, +a2}:
      r2.sp.v(tb, T.render.atom(T.VSpan{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VInt{+a1, +a2}:
      r2.sp.v(tb, T.render.atom(T.VInt{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VFlo{+a1, +a2}:
      r2.sp.v(tb, T.render.atom(T.VFlo{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VBool{+a1}:
      r2.sp.v(tb, T.render.atom(T.VBool{a1}), tt, gg, r2.P(tt, gg, tb))
    case T.VWhen{+a1}:
      r2.sp.v(tb, T.render.atom(T.VWhen{a1}), tt, gg, r2.P(tt, gg, tb))
    case T.VArr{+a1}:
      r2.sp.v(tb, "[" ++ T.render.go(a1, ", ", False{}) ++ "]", tt, gg, r2.P(tt, gg, tb))
    case T.VInl{+a1}:
      r2.sp.v(tb, "{" ++ T.render.go(a1, ", ", False{}) ++ "}", tt, gg, r2.P(tt, gg, tb))
    case T.VHead{+a1, +a2}:
      r2.sp.v(tb, T.render.atom(T.VHead{a1, a2}), tt, gg, r2.P(tt, gg, tb))
    case T.VAot{+a1, +a2}:
      r2.sp.o(tb, a1, a2, tt, gg, T.render.both(a2, "\n", True{}),
        r2.P(tt, gg, tb))
    case T.VAots{+a1, +a2}:
      r2.sp.v(tb, T.render.atom(T.VAots{a1, a2}), tt, gg, r2.P(tt, gg, tb))


# two rows one pass writes alike, before rests it writes alike
def r2.cc(
  +h1: T.Val,
  +h2: T.Val,
  +xx: List<&2, T.Val>,
  +yy: List<&2, T.Val>,
  +gg: String,
  +tb: Bool,
  eh: {r2.hd(h1, gg, tb) == r2.hd(h2, gg, tb) : String},
  et: {r2.P(xx, gg, tb) == r2.P(yy, gg, tb) : String}
) -> {r2.P(h1 <> xx, gg, tb) == r2.P(h2 <> yy, gg, tb) : String}:
  Equal.trans(String, r2.P(h1 <> xx, gg, tb), String.append(r2.hd(h1, gg, tb), r2.P(xx, gg, tb)),
    r2.P(h2 <> yy, gg, tb), r2.split(h1, xx, gg, tb),
    Equal.trans(String, String.append(r2.hd(h1, gg, tb), r2.P(xx, gg, tb)),
      String.append(r2.hd(h2, gg, tb), r2.P(yy, gg, tb)), r2.P(h2 <> yy, gg, tb),
      r2.app2(r2.hd(h1, gg, tb), r2.hd(h2, gg, tb), r2.P(xx, gg, tb), r2.P(yy, gg, tb), eh, et),
      Equal.sym(String, r2.P(h2 <> yy, gg, tb), String.append(r2.hd(h2, gg, tb), r2.P(yy, gg, tb)),
        r2.split(h2, yy, gg, tb))))

# a pass over two lists written one after the other
def r2.app(
  xs: List<&2, T.Val>,
  +ys: List<&2, T.Val>,
  +gg: String,
  +tb: Bool
) -> {r2.P(List.append(&2, T.Val, xs, ys), gg, tb) == String.append(r2.P(xs, gg, tb), r2.P(ys, gg, tb)) : String}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      Equal.trans(String, r2.P(hh <> List.append(&2, T.Val, tt, ys), gg, tb),
        String.append(r2.hd(hh, gg, tb), r2.P(List.append(&2, T.Val, tt, ys), gg, tb)),
        String.append(r2.P(hh <> tt, gg, tb), r2.P(ys, gg, tb)),
        r2.split(hh, List.append(&2, T.Val, tt, ys), gg, tb),
        Equal.trans(String, String.append(r2.hd(hh, gg, tb), r2.P(List.append(&2, T.Val, tt, ys), gg, tb)),
          String.append(r2.hd(hh, gg, tb), String.append(r2.P(tt, gg, tb), r2.P(ys, gg, tb))),
          String.append(r2.P(hh <> tt, gg, tb), r2.P(ys, gg, tb)),
          Equal.cong(String, String, zz => String.append(r2.hd(hh, gg, tb), zz),
            r2.P(List.append(&2, T.Val, tt, ys), gg, tb), String.append(r2.P(tt, gg, tb), r2.P(ys, gg, tb)),
            r2.app(tt, ys, gg, tb)),
          Equal.trans(String, String.append(r2.hd(hh, gg, tb), String.append(r2.P(tt, gg, tb), r2.P(ys, gg, tb))),
            String.append(String.append(r2.hd(hh, gg, tb), r2.P(tt, gg, tb)), r2.P(ys, gg, tb)),
            String.append(r2.P(hh <> tt, gg, tb), r2.P(ys, gg, tb)),
            Equal.sym(String, String.append(String.append(r2.hd(hh, gg, tb), r2.P(tt, gg, tb)), r2.P(ys, gg, tb)),
              String.append(r2.hd(hh, gg, tb), String.append(r2.P(tt, gg, tb), r2.P(ys, gg, tb))),
              Eq.append_assoc(r2.hd(hh, gg, tb), r2.P(tt, gg, tb), r2.P(ys, gg, tb))),
            Equal.cong(String, String, zz => String.append(zz, r2.P(ys, gg, tb)),
              String.append(r2.hd(hh, gg, tb), r2.P(tt, gg, tb)), r2.P(hh <> tt, gg, tb),
              Equal.sym(String, r2.P(hh <> tt, gg, tb), String.append(r2.hd(hh, gg, tb), r2.P(tt, gg, tb)),
                r2.split(hh, tt, gg, tb))))))

# the separator and the rest render.go writes after an item, for the rest
# read out and as it is
def r2.rt(
  +tt: List<&2, T.Val>,
  +gg: String,
  +tr: Bool,
  ih: {T.render.go(Laws.own.rows(tt), gg, tr) == T.render.go(tt, gg, tr) : String}
) -> {r2.R(Laws.own.rows(tt), gg, tr) == r2.R(tt, gg, tr) : String}:
  r2.app2(T.render.suf(gg, tr, List.is_empty(&2, T.Val, Laws.own.rows(tt))),
    T.render.suf(gg, tr, List.is_empty(&2, T.Val, tt)), T.render.go(Laws.own.rows(tt), gg, tr),
    T.render.go(tt, gg, tr),
    Equal.cong(Bool, String, bb => T.render.suf(gg, tr, bb), List.is_empty(&2, T.Val, Laws.own.rows(tt)),
      List.is_empty(&2, T.Val, tt), empty.own(tt)),
    ih)

# two items render.go writes alike, before the rest read out and as it is
def r2.gc(
  +h1: T.Val,
  +h2: T.Val,
  +tt: List<&2, T.Val>,
  +gg: String,
  +tr: Bool,
  ih: {T.render.go(Laws.own.rows(tt), gg, tr) == T.render.go(tt, gg, tr) : String},
  eh: {r2.gk(h1, r2.R(tt, gg, tr)) == r2.gk(h2, r2.R(tt, gg, tr)) : String}
) -> {r2.gk(h1, r2.R(Laws.own.rows(tt), gg, tr)) == r2.gk(h2, r2.R(tt, gg, tr)) : String}:
  Equal.trans(String, r2.gk(h1, r2.R(Laws.own.rows(tt), gg, tr)), r2.gk(h1, r2.R(tt, gg, tr)),
    r2.gk(h2, r2.R(tt, gg, tr)),
    Equal.cong(String, String, zz => r2.gk(h1, zz), r2.R(Laws.own.rows(tt), gg, tr), r2.R(tt, gg, tr),
      r2.rt(tt, gg, tr, ih)),
    eh)

# render.go writes a list read out as it writes the list
def r2.own.go(
  xs: List<&2, T.Val>,
  +gg: String,
  +tr: Bool
) -> {T.render.go(Laws.own.rows(xs), gg, tr) == T.render.go(xs, gg, tr) : String}:
  match xs:
    case []:
      {==}
    case T.VPair{+kk, T.VStr{+a1}} <> +tt:
      r2.gc(T.VPair{kk, T.VStr{a1}}, T.VPair{kk, T.VStr{a1}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt:
      r2.gc(T.VPair{kk, T.VStr{T.span.str(a1, a2, U32.is_zero(a2))}}, T.VPair{kk, T.VSpan{a1, a2}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => T.key(kk) ++ " = " ++ zz ++ r2.R(tt, gg, tr),
          T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))), T.span.quote(a1, a2),
          Equal.sym(String, T.span.quote(a1, a2), T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))),
            Laws.span_quote_basic(a1, a2))))
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt:
      r2.gc(T.VPair{kk, T.VInt{a1, a2}}, T.VPair{kk, T.VInt{a1, a2}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt:
      r2.gc(T.VPair{kk, T.VFlo{a1, a2}}, T.VPair{kk, T.VFlo{a1, a2}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VPair{+kk, T.VBool{+a1}} <> +tt:
      r2.gc(T.VPair{kk, T.VBool{a1}}, T.VPair{kk, T.VBool{a1}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt:
      r2.gc(T.VPair{kk, T.VWhen{a1}}, T.VPair{kk, T.VWhen{a1}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VPair{+kk, T.VArr{+a1}} <> +tt:
      r2.gc(T.VPair{kk, T.VArr{Laws.own.rows(a1)}}, T.VPair{kk, T.VArr{a1}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => T.key(kk) ++ " = [" ++ zz ++ "]" ++ r2.R(tt, gg, tr),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})))
    case T.VPair{+kk, T.VInl{+a1}} <> +tt:
      r2.gc(T.VPair{kk, T.VInl{Laws.own.rows(a1)}}, T.VPair{kk, T.VInl{a1}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => T.key(kk) ++ " = {" ++ zz ++ "}" ++ r2.R(tt, gg, tr),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})))
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt:
      r2.gc(T.VPair{kk, T.VHead{a1, Laws.own.rows(a2)}}, T.VPair{kk, T.VHead{a1, a2}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => "[" ++ a1 ++ "]\n" ++ zz ++ r2.R(tt, gg, tr),
          T.render.go(Laws.own.rows(a2), "\n", True{}), T.render.go(a2, "\n", True{}),
          r2.own.go(a2, "\n", True{})))
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt:
      r2.gc(T.VPair{kk, T.VAot{a1, Laws.own.rows(a2)}}, T.VPair{kk, T.VAot{a1, a2}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt:
      r2.gc(T.VPair{kk, T.VAots{a1, Laws.own.rows(a2)}}, T.VPair{kk, T.VAots{a1, a2}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => zz ++ r2.R(tt, gg, tr),
          T.render.go(Laws.own.rows(a2), "\n", True{}), T.render.go(a2, "\n", True{}),
          r2.own.go(a2, "\n", True{})))
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt:
      r2.gc(T.VPair{kk, T.VPair{a1, a2}}, T.VPair{kk, T.VPair{a1, a2}}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VStr{+a1} <> +tt:
      r2.gc(T.VStr{a1}, T.VStr{a1}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VSpan{+a1, +a2} <> +tt:
      r2.gc(T.VStr{T.span.str(a1, a2, U32.is_zero(a2))}, T.VSpan{a1, a2}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => zz ++ r2.R(tt, gg, tr),
          T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))), T.span.quote(a1, a2),
          Equal.sym(String, T.span.quote(a1, a2), T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))),
            Laws.span_quote_basic(a1, a2))))
    case T.VInt{+a1, +a2} <> +tt:
      r2.gc(T.VInt{a1, a2}, T.VInt{a1, a2}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VFlo{+a1, +a2} <> +tt:
      r2.gc(T.VFlo{a1, a2}, T.VFlo{a1, a2}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VBool{+a1} <> +tt:
      r2.gc(T.VBool{a1}, T.VBool{a1}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VWhen{+a1} <> +tt:
      r2.gc(T.VWhen{a1}, T.VWhen{a1}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VArr{+a1} <> +tt:
      r2.gc(T.VArr{Laws.own.rows(a1)}, T.VArr{a1}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => "[" ++ zz ++ "]" ++ r2.R(tt, gg, tr),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})))
    case T.VInl{+a1} <> +tt:
      r2.gc(T.VInl{Laws.own.rows(a1)}, T.VInl{a1}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => "{" ++ zz ++ "}" ++ r2.R(tt, gg, tr),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})))
    case T.VHead{+a1, +a2} <> +tt:
      r2.gc(T.VHead{a1, Laws.own.rows(a2)}, T.VHead{a1, a2}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})
    case T.VAot{+a1, +a2} <> +tt:
      r2.gc(T.VAot{a1, Laws.own.rows(a2)}, T.VAot{a1, a2}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        Equal.cong(String, String, zz => "[[" ++ a1 ++ "]]\n" ++ zz ++ r2.R(tt, gg, tr),
          T.render.go(Laws.own.rows(a2), "\n", True{}), T.render.go(a2, "\n", True{}),
          r2.own.go(a2, "\n", True{})))
    case T.VAots{+a1, +a2} <> +tt:
      r2.gc(T.VAots{a1, Laws.own.rows(a2)}, T.VAots{a1, a2}, tt, gg, tr,
        r2.own.go(tt, gg, tr),
        {==})


# the pass writes a list read out as it writes the list
def r2.own.pass(
  xs: List<&2, T.Val>,
  +gg: String,
  +tb: Bool
) -> {r2.P(Laws.own.rows(xs), gg, tb) == r2.P(xs, gg, tb) : String}:
  match xs:
    case []:
      {==}
    case T.VPair{+kk, T.VStr{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VStr{a1}}, T.VPair{kk, T.VStr{a1}},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VStr{T.span.str(a1, a2, U32.is_zero(a2))}}, T.VPair{kk, T.VSpan{a1, a2}},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.key(tb, T.key(kk) ++ " = " ++ zz, gg),
          T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))), T.span.quote(a1, a2),
          Equal.sym(String, T.span.quote(a1, a2), T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))),
            Laws.span_quote_basic(a1, a2))),
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VInt{a1, a2}}, T.VPair{kk, T.VInt{a1, a2}},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VFlo{a1, a2}}, T.VPair{kk, T.VFlo{a1, a2}},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VBool{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VBool{a1}}, T.VPair{kk, T.VBool{a1}},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VWhen{a1}}, T.VPair{kk, T.VWhen{a1}},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VArr{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VArr{Laws.own.rows(a1)}}, T.VPair{kk, T.VArr{a1}},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.key(tb, T.key(kk) ++ " = [" ++ zz ++ "]", gg),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})),
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VInl{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VInl{Laws.own.rows(a1)}}, T.VPair{kk, T.VInl{a1}},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.key(tb, T.key(kk) ++ " = {" ++ zz ++ "}", gg),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})),
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VHead{a1, Laws.own.rows(a2)}}, T.VPair{kk, T.VHead{a1, a2}},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.tab(tb, "[" ++ a1 ++ "]\n" ++ zz),
          T.render.both(Laws.own.rows(a2), "\n", True{}), T.render.both(a2, "\n", True{}),
          r2.app2(r2.P(Laws.own.rows(a2), "\n", False{}), r2.P(a2, "\n", False{}),
            r2.P(Laws.own.rows(a2), "\n", True{}), r2.P(a2, "\n", True{}),
            r2.own.pass(a2, "\n", False{}), r2.own.pass(a2, "\n", True{}))),
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VAot{a1, Laws.own.rows(a2)}}, T.VPair{kk, T.VAot{a1, a2}},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VAots{a1, Laws.own.rows(a2)}}, T.VPair{kk, T.VAots{a1, a2}},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.tab(tb, zz),
          T.render.both(Laws.own.rows(a2), "\n", True{}), T.render.both(a2, "\n", True{}),
          r2.app2(r2.P(Laws.own.rows(a2), "\n", False{}), r2.P(a2, "\n", False{}),
            r2.P(Laws.own.rows(a2), "\n", True{}), r2.P(a2, "\n", True{}),
            r2.own.pass(a2, "\n", False{}), r2.own.pass(a2, "\n", True{}))),
        r2.own.pass(tt, gg, tb))
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VPair{a1, a2}}, T.VPair{kk, T.VPair{a1, a2}},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VStr{+a1} <> +tt:
      r2.cc(T.VStr{a1}, T.VStr{a1},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VSpan{+a1, +a2} <> +tt:
      r2.cc(T.VStr{T.span.str(a1, a2, U32.is_zero(a2))}, T.VSpan{a1, a2},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.key(tb, zz, gg),
          T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))), T.span.quote(a1, a2),
          Equal.sym(String, T.span.quote(a1, a2), T.key.basic(T.span.str(a1, a2, U32.is_zero(a2))),
            Laws.span_quote_basic(a1, a2))),
        r2.own.pass(tt, gg, tb))
    case T.VInt{+a1, +a2} <> +tt:
      r2.cc(T.VInt{a1, a2}, T.VInt{a1, a2},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VFlo{+a1, +a2} <> +tt:
      r2.cc(T.VFlo{a1, a2}, T.VFlo{a1, a2},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VBool{+a1} <> +tt:
      r2.cc(T.VBool{a1}, T.VBool{a1},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VWhen{+a1} <> +tt:
      r2.cc(T.VWhen{a1}, T.VWhen{a1},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VArr{+a1} <> +tt:
      r2.cc(T.VArr{Laws.own.rows(a1)}, T.VArr{a1},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.key(tb, "[" ++ zz ++ "]", gg),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})),
        r2.own.pass(tt, gg, tb))
    case T.VInl{+a1} <> +tt:
      r2.cc(T.VInl{Laws.own.rows(a1)}, T.VInl{a1},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.key(tb, "{" ++ zz ++ "}", gg),
          T.render.go(Laws.own.rows(a1), ", ", False{}), T.render.go(a1, ", ", False{}),
          r2.own.go(a1, ", ", False{})),
        r2.own.pass(tt, gg, tb))
    case T.VHead{+a1, +a2} <> +tt:
      r2.cc(T.VHead{a1, Laws.own.rows(a2)}, T.VHead{a1, a2},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))
    case T.VAot{+a1, +a2} <> +tt:
      r2.cc(T.VAot{a1, Laws.own.rows(a2)}, T.VAot{a1, a2},
        Laws.own.rows(tt), tt, gg, tb,
        Equal.cong(String, String, zz => r2.tab(tb, "[[" ++ a1 ++ "]]\n" ++ zz),
          T.render.both(Laws.own.rows(a2), "\n", True{}), T.render.both(a2, "\n", True{}),
          r2.app2(r2.P(Laws.own.rows(a2), "\n", False{}), r2.P(a2, "\n", False{}),
            r2.P(Laws.own.rows(a2), "\n", True{}), r2.P(a2, "\n", True{}),
            r2.own.pass(a2, "\n", False{}), r2.own.pass(a2, "\n", True{}))),
        r2.own.pass(tt, gg, tb))
    case T.VAots{+a1, +a2} <> +tt:
      r2.cc(T.VAots{a1, Laws.own.rows(a2)}, T.VAots{a1, a2},
        Laws.own.rows(tt), tt, gg, tb,
        {==},
        r2.own.pass(tt, gg, tb))


# render.both writes rows read out as it writes the rows
def r2.own.both(
  +ys: List<&2, T.Val>
) -> {T.render.both(Laws.own.rows(ys), "\n", True{}) == T.render.both(ys, "\n", True{}) : String}:
  r2.app2(r2.P(Laws.own.rows(ys), "\n", False{}), r2.P(ys, "\n", False{}), r2.P(Laws.own.rows(ys), "\n", True{}),
    r2.P(ys, "\n", True{}), r2.own.pass(ys, "\n", False{}), r2.own.pass(ys, "\n", True{}))

# render writes a document read out as it writes the document
def r2.rown(dd: T.Doc) -> {T.render(Laws.own(dd)) == T.render(dd) : String}:
  match dd:
    case T.Doc{_b, +rs}:
      r2.own.both(rs)

# the pass that writes keys writes the pairs canon keeps as it writes the
# table: it writes nothing for a table or an array of tables
def r2.keysF(
  xs: List<&2, T.Val>,
  +gg: String
) -> {r2.P(Laws.canon.keys(xs), gg, False{}) == r2.P(xs, gg, False{}) : String}:
  match xs:
    case []:
      {==}
    case T.VPair{+kk, T.VStr{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VStr{a1}}, T.VPair{kk, T.VStr{a1}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VSpan{a1, a2}}, T.VPair{kk, T.VSpan{a1, a2}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VInt{a1, a2}}, T.VPair{kk, T.VInt{a1, a2}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VFlo{a1, a2}}, T.VPair{kk, T.VFlo{a1, a2}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VBool{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VBool{a1}}, T.VPair{kk, T.VBool{a1}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VWhen{a1}}, T.VPair{kk, T.VWhen{a1}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VArr{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VArr{a1}}, T.VPair{kk, T.VArr{a1}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VInl{+a1}} <> +tt:
      r2.cc(T.VPair{kk, T.VInl{a1}}, T.VPair{kk, T.VInl{a1}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt:
      r2.keysF(tt, gg)
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VAot{a1, a2}}, T.VPair{kk, T.VAot{a1, a2}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt:
      r2.keysF(tt, gg)
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt:
      r2.cc(T.VPair{kk, T.VPair{a1, a2}}, T.VPair{kk, T.VPair{a1, a2}}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VStr{+a1} <> +tt:
      r2.cc(T.VStr{a1}, T.VStr{a1}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VSpan{+a1, +a2} <> +tt:
      r2.cc(T.VSpan{a1, a2}, T.VSpan{a1, a2}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VInt{+a1, +a2} <> +tt:
      r2.cc(T.VInt{a1, a2}, T.VInt{a1, a2}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VFlo{+a1, +a2} <> +tt:
      r2.cc(T.VFlo{a1, a2}, T.VFlo{a1, a2}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VBool{+a1} <> +tt:
      r2.cc(T.VBool{a1}, T.VBool{a1}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VWhen{+a1} <> +tt:
      r2.cc(T.VWhen{a1}, T.VWhen{a1}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VArr{+a1} <> +tt:
      r2.cc(T.VArr{a1}, T.VArr{a1}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VInl{+a1} <> +tt:
      r2.cc(T.VInl{a1}, T.VInl{a1}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VHead{+a1, +a2} <> +tt:
      r2.cc(T.VHead{a1, a2}, T.VHead{a1, a2}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VAot{+a1, +a2} <> +tt:
      r2.cc(T.VAot{a1, a2}, T.VAot{a1, a2}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))
    case T.VAots{+a1, +a2} <> +tt:
      r2.cc(T.VAots{a1, a2}, T.VAots{a1, a2}, Laws.canon.keys(tt), tt, gg, False{}, {==},
        r2.keysF(tt, gg))


# the rest of a well-formed table's rows is well-formed
def r2.tl(
  hh: T.Val,
  +tt: List<&2, T.Val>,
  +hp: String,
  hw: {T.wf.go(hh <> tt, T.WfRows{hp}) == True{} : Bool}
) -> {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}:
  match hh:
    case T.VPair{+kk, T.VStr{+a1}}:
      wt.more(Bool.and(T.wf.atom(T.VStr{a1}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfRows{hp}), hw)
    case T.VPair{+kk, T.VSpan{+a1, +a2}}:
      wt.more(Bool.and(T.wf.atom(T.VSpan{a1, a2}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfRows{hp}), hw)
    case T.VPair{+kk, T.VInt{+a1, +a2}}:
      wt.more(Bool.and(T.wf.atom(T.VInt{a1, a2}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfRows{hp}), hw)
    case T.VPair{+kk, T.VFlo{+a1, +a2}}:
      wt.more(Bool.and(T.wf.atom(T.VFlo{a1, a2}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfRows{hp}), hw)
    case T.VPair{+kk, T.VBool{+a1}}:
      wt.more(Bool.and(T.wf.atom(T.VBool{a1}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfRows{hp}), hw)
    case T.VPair{+kk, T.VWhen{+a1}}:
      wt.more(Bool.and(T.wf.atom(T.VWhen{a1}), T.wf.key(kk, tt)), _u => T.wf.go(tt, T.WfRows{hp}), hw)
    case T.VPair{+kk, T.VArr{+a1}}:
      wt.more(T.wf.go(a1, T.WfItems{}), _v => T.wf.go(tt, T.WfRows{hp}), wt.more(T.wf.key(kk, tt),
        _u => T.wf.then(T.wf.go(a1, T.WfItems{}), _v => T.wf.go(tt, T.WfRows{hp})), hw))
    case T.VPair{+kk, T.VInl{+a1}}:
      wt.more(T.wf.go(a1, T.WfInl{}), _v => T.wf.go(tt, T.WfRows{hp}), wt.more(T.wf.key(kk, tt),
        _u => T.wf.then(T.wf.go(a1, T.WfInl{}), _v => T.wf.go(tt, T.WfRows{hp})), hw))
    case T.VPair{+kk, T.VHead{+a1, +a2}}:
      wt.more(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfRows{hp}),
        wt.more(Bool.and(T.wf.key(kk, tt), T.str.eq(a1, T.tree.pre(hp, kk))),
          _u => T.wf.then(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfRows{hp})), hw))
    case T.VPair{+kk, T.VAot{+a1, +a2}}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VPair{+kk, T.VAots{+a1, +a2}}:
      wt.more(T.wf.go(a2, T.WfElems{a1}), _v => T.wf.go(tt, T.WfRows{hp}),
        wt.more(Bool.and(Bool.not(List.is_empty(&2, T.Val, a2)),
          Bool.and(T.wf.key(kk, tt), T.str.eq(a1, T.tree.pre(hp, kk)))),
          _u => T.wf.then(T.wf.go(a2, T.WfElems{a1}), _v => T.wf.go(tt, T.WfRows{hp})), hw))
    case T.VPair{+kk, T.VPair{+a1, +a2}}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VStr{+a1}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VSpan{+a1, +a2}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VInt{+a1, +a2}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VFlo{+a1, +a2}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VBool{+a1}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VWhen{+a1}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VArr{+a1}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VInl{+a1}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VHead{+a1, +a2}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VAot{+a1, +a2}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)
    case T.VAots{+a1, +a2}:
      Eq.bit.absurd(&2, {T.wf.go(tt, T.WfRows{hp}) == True{} : Bool}, hw)


# the pass that writes tables writes nothing for the pairs canon keeps
def r2.keysT(
  xs: List<&2, T.Val>,
  +hp: String,
  +gg: String,
  +hw: {T.wf.go(xs, T.WfRows{hp}) == True{} : Bool}
) -> {r2.P(Laws.canon.keys(xs), gg, True{}) == "" : String}:
  match xs:
    case []:
      {==}
    case T.VPair{+kk, T.VStr{+a1}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VStr{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VSpan{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VInt{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VFlo{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VBool{+a1}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VBool{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VWhen{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VArr{+a1}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VArr{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VInl{+a1}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VInl{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VHead{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VPair{kk, T.VAot{a1, a2}} <> tt), gg, True{}) == "" : String}, hw)
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt:
      r2.keysT(tt, hp, gg, r2.tl(T.VPair{kk, T.VAots{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VPair{kk, T.VPair{a1, a2}} <> tt), gg, True{}) == "" : String}, hw)
    case T.VStr{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VStr{a1} <> tt), gg, True{}) == "" : String}, hw)
    case T.VSpan{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VSpan{a1, a2} <> tt), gg, True{}) == "" : String}, hw)
    case T.VInt{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VInt{a1, a2} <> tt), gg, True{}) == "" : String}, hw)
    case T.VFlo{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VFlo{a1, a2} <> tt), gg, True{}) == "" : String}, hw)
    case T.VBool{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VBool{a1} <> tt), gg, True{}) == "" : String}, hw)
    case T.VWhen{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VWhen{a1} <> tt), gg, True{}) == "" : String}, hw)
    case T.VArr{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VArr{a1} <> tt), gg, True{}) == "" : String}, hw)
    case T.VInl{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VInl{a1} <> tt), gg, True{}) == "" : String}, hw)
    case T.VHead{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VHead{a1, a2} <> tt), gg, True{}) == "" : String}, hw)
    case T.VAot{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VAot{a1, a2} <> tt), gg, True{}) == "" : String}, hw)
    case T.VAots{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(Laws.canon.keys(T.VAots{a1, a2} <> tt), gg, True{}) == "" : String}, hw)


# the pass that writes keys writes nothing for the tables canon keeps
def r2.tabsF(
  xs: List<&2, T.Val>,
  md: Bool,
  +hp: String,
  +gg: String
) -> {r2.P(st.l(md, xs, hp), gg, False{}) == "" : String}:
  match xs md:
    case [] False{}:
      {==}
    case [] True{}:
      {==}
    case T.VPair{+kk, T.VStr{+a1}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VStr{+a1}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VBool{+a1}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VBool{+a1}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VArr{+a1}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VArr{+a1}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VInl{+a1}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VInl{+a1}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VStr{+a1} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VStr{+a1} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VSpan{+a1, +a2} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VSpan{+a1, +a2} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VInt{+a1, +a2} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VInt{+a1, +a2} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VFlo{+a1, +a2} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VFlo{+a1, +a2} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VBool{+a1} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VBool{+a1} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VWhen{+a1} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VWhen{+a1} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VArr{+a1} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VArr{+a1} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VInl{+a1} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VInl{+a1} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VHead{+a1, +a2} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VHead{+a1, +a2} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VAot{+a1, +a2} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VAot{+a1, +a2} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)
    case T.VAots{+a1, +a2} <> +tt False{}:
      r2.tabsF(tt, False{}, hp, gg)
    case T.VAots{+a1, +a2} <> +tt True{}:
      r2.tabsF(tt, True{}, hp, gg)


# the pass that writes keys writes nothing for an array's elements
def r2.elemsF(
  xs: List<&2, T.Val>,
  +hp: String,
  +gg: String,
  +hw: {T.wf.go(xs, T.WfElems{hp}) == True{} : Bool}
) -> {r2.P(xs, gg, False{}) == "" : String}:
  match xs:
    case []:
      {==}
    case T.VPair{+kk, T.VStr{+a1}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VStr{a1}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VSpan{a1, a2}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VInt{a1, a2}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VFlo{a1, a2}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VBool{+a1}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VBool{a1}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VWhen{a1}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VArr{+a1}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VArr{a1}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VInl{+a1}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VInl{a1}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VHead{a1, a2}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VAot{a1, a2}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VAots{a1, a2}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VPair{kk, T.VPair{a1, a2}} <> tt, gg, False{}) == "" : String}, hw)
    case T.VStr{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VStr{a1} <> tt, gg, False{}) == "" : String}, hw)
    case T.VSpan{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VSpan{a1, a2} <> tt, gg, False{}) == "" : String}, hw)
    case T.VInt{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VInt{a1, a2} <> tt, gg, False{}) == "" : String}, hw)
    case T.VFlo{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VFlo{a1, a2} <> tt, gg, False{}) == "" : String}, hw)
    case T.VBool{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VBool{a1} <> tt, gg, False{}) == "" : String}, hw)
    case T.VWhen{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VWhen{a1} <> tt, gg, False{}) == "" : String}, hw)
    case T.VArr{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VArr{a1} <> tt, gg, False{}) == "" : String}, hw)
    case T.VInl{+a1} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VInl{a1} <> tt, gg, False{}) == "" : String}, hw)
    case T.VHead{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VHead{a1, a2} <> tt, gg, False{}) == "" : String}, hw)
    case T.VAot{+a1, +a2} <> +tt:
      r2.elemsF(tt, hp, gg, wt.more(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfElems{hp}),
        wt.more(T.str.eq(a1, hp), _u => T.wf.then(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfElems{hp})), hw)))
    case T.VAots{+a1, +a2} <> +tt:
      Eq.bit.absurd(&2, {r2.P(T.VAots{a1, a2} <> tt, gg, False{}) == "" : String}, hw)


# render.both writes a well-formed table's rows reordered as canon does as it
# writes the rows, given that the pass that writes tables does
def r2.both(
  +rr: List<&2, T.Val>,
  +hp: String,
  +hw: {T.wf.go(rr, T.WfRows{hp}) == True{} : Bool},
  et: {r2.P(Laws.canon.tabs(rr), "\n", True{}) == r2.P(rr, "\n", True{}) : String}
) -> {T.render.both(Laws.canon.rows(rr), "\n", True{}) == T.render.both(rr, "\n", True{}) : String}:
  +kk = {Laws.canon.keys(rr) : List<&2, T.Val>}
  +cc = {Laws.canon.tabs(rr) : List<&2, T.Val>}
  r2.app2(r2.P(List.append(&2, T.Val, kk, cc), "\n", False{}), r2.P(rr, "\n", False{}),
    r2.P(List.append(&2, T.Val, kk, cc), "\n", True{}), r2.P(rr, "\n", True{}),
    Equal.trans(String, r2.P(List.append(&2, T.Val, kk, cc), "\n", False{}),
      String.append(r2.P(kk, "\n", False{}), r2.P(cc, "\n", False{})), r2.P(rr, "\n", False{}),
      r2.app(kk, cc, "\n", False{}),
      Equal.trans(String, String.append(r2.P(kk, "\n", False{}), r2.P(cc, "\n", False{})),
        String.append(r2.P(rr, "\n", False{}), ""), r2.P(rr, "\n", False{}),
        r2.app2(r2.P(kk, "\n", False{}), r2.P(rr, "\n", False{}), r2.P(cc, "\n", False{}), "",
          r2.keysF(rr, "\n"), r2.tabsF(rr, False{}, hp, "\n")),
        Eq.append_nil(r2.P(rr, "\n", False{})))),
    Equal.trans(String, r2.P(List.append(&2, T.Val, kk, cc), "\n", True{}),
      String.append(r2.P(kk, "\n", True{}), r2.P(cc, "\n", True{})), r2.P(rr, "\n", True{}),
      r2.app(kk, cc, "\n", True{}),
      r2.app2(r2.P(kk, "\n", True{}), "", r2.P(cc, "\n", True{}), r2.P(rr, "\n", True{}),
        r2.keysT(rr, hp, "\n", hw), et)))

# the pass that writes tables writes canon's tables as it writes the
# table's (md false), and canon's elements of an array as it writes the
# elements (md true): each one's header, then its rows reordered, which
# render.both writes as it writes them
def r2.tabs(
  xs: List<&2, T.Val>,
  md: Bool,
  +hp: String,
  +gg: String,
  +hw: {T.wf.go(xs, st.at(md, hp)) == True{} : Bool}
) -> {r2.P(st.l(md, xs, hp), gg, True{}) == r2.P(xs, gg, True{}) : String}:
  match xs md:
    case [] False{}:
      {==}
    case [] True{}:
      {==}
    case T.VPair{+kk, T.VStr{+a1}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VStr{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VStr{+a1}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VStr{a1}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VStr{a1}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VSpan{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VSpan{+a1, +a2}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VSpan{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VSpan{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VInt{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VInt{+a1, +a2}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VInt{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VInt{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VFlo{a1, a2}}, tt, hp, hw))
    case T.VPair{+kk, T.VFlo{+a1, +a2}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VFlo{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VFlo{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VBool{+a1}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VBool{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VBool{+a1}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VBool{a1}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VBool{a1}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VWhen{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VWhen{+a1}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VWhen{a1}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VWhen{a1}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VArr{+a1}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VArr{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VArr{+a1}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VArr{a1}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VArr{a1}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VInl{+a1}} <> +tt False{}:
      r2.tabs(tt, False{}, hp, gg, r2.tl(T.VPair{kk, T.VInl{a1}}, tt, hp, hw))
    case T.VPair{+kk, T.VInl{+a1}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VInl{a1}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VInl{a1}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt False{}:
      +hin = {wt.more(Bool.and(T.wf.key(kk, tt), T.str.eq(a1, T.tree.pre(hp, kk))),
        _u => T.wf.then(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfRows{hp})), hw)
        : {T.wf.then(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfRows{hp})) == True{} : Bool}}
      +hwr = {wt.ok(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfRows{hp}), hin)
        : {T.wf.go(a2, T.WfRows{a1}) == True{} : Bool}}
      r2.cc(T.VPair{kk, T.VHead{a1, Laws.canon.rows(a2)}}, T.VPair{kk, T.VHead{a1, a2}},
        Laws.canon.tabs(tt), tt, gg, True{},
        Equal.cong(String, String, zz => "[" ++ a1 ++ "]\n" ++ zz,
          T.render.both(Laws.canon.rows(a2), "\n", True{}), T.render.both(a2, "\n", True{}),
          r2.both(a2, a1, hwr, r2.tabs(a2, False{}, a1, "\n", hwr))),
        r2.tabs(tt, False{}, hp, gg, wt.more(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfRows{hp}), hin)))
    case T.VPair{+kk, T.VHead{+a1, +a2}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VHead{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VHead{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VPair{kk, T.VAot{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VAot{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VAot{+a1, +a2}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VAot{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VAot{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt False{}:
      +hin = {wt.more(Bool.and(Bool.not(List.is_empty(&2, T.Val, a2)),
        Bool.and(T.wf.key(kk, tt), T.str.eq(a1, T.tree.pre(hp, kk)))),
        _u => T.wf.then(T.wf.go(a2, T.WfElems{a1}), _v => T.wf.go(tt, T.WfRows{hp})), hw)
        : {T.wf.then(T.wf.go(a2, T.WfElems{a1}), _v => T.wf.go(tt, T.WfRows{hp})) == True{} : Bool}}
      +hwe = {wt.ok(T.wf.go(a2, T.WfElems{a1}), _v => T.wf.go(tt, T.WfRows{hp}), hin)
        : {T.wf.go(a2, T.WfElems{a1}) == True{} : Bool}}
      r2.cc(T.VPair{kk, T.VAots{a1, Laws.canon.go(a2, Laws.CElems{a1})}}, T.VPair{kk, T.VAots{a1, a2}},
        Laws.canon.tabs(tt), tt, gg, True{},
        r2.app2(r2.P(st.l(True{}, a2, a1), "\n", False{}), r2.P(a2, "\n", False{}),
          r2.P(st.l(True{}, a2, a1), "\n", True{}), r2.P(a2, "\n", True{}),
          Equal.trans(String, r2.P(st.l(True{}, a2, a1), "\n", False{}), "", r2.P(a2, "\n", False{}),
            r2.tabsF(a2, True{}, a1, "\n"),
            Equal.sym(String, r2.P(a2, "\n", False{}), "", r2.elemsF(a2, a1, "\n", hwe))),
          r2.tabs(a2, True{}, a1, "\n", hwe)),
        r2.tabs(tt, False{}, hp, gg, wt.more(T.wf.go(a2, T.WfElems{a1}), _v => T.wf.go(tt, T.WfRows{hp}), hin)))
    case T.VPair{+kk, T.VAots{+a1, +a2}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VAots{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VAots{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VPair{kk, T.VPair{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VPair{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VPair{+kk, T.VPair{+a1, +a2}} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VPair{kk, T.VPair{a1, a2}} <> tt, hp), gg, True{})
        == r2.P(T.VPair{kk, T.VPair{a1, a2}} <> tt, gg, True{}) : String}, hw)
    case T.VStr{+a1} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VStr{a1} <> tt, hp), gg, True{})
        == r2.P(T.VStr{a1} <> tt, gg, True{}) : String}, hw)
    case T.VStr{+a1} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VStr{a1} <> tt, hp), gg, True{})
        == r2.P(T.VStr{a1} <> tt, gg, True{}) : String}, hw)
    case T.VSpan{+a1, +a2} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VSpan{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VSpan{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VSpan{+a1, +a2} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VSpan{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VSpan{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VInt{+a1, +a2} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VInt{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VInt{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VInt{+a1, +a2} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VInt{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VInt{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VFlo{+a1, +a2} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VFlo{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VFlo{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VFlo{+a1, +a2} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VFlo{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VFlo{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VBool{+a1} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VBool{a1} <> tt, hp), gg, True{})
        == r2.P(T.VBool{a1} <> tt, gg, True{}) : String}, hw)
    case T.VBool{+a1} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VBool{a1} <> tt, hp), gg, True{})
        == r2.P(T.VBool{a1} <> tt, gg, True{}) : String}, hw)
    case T.VWhen{+a1} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VWhen{a1} <> tt, hp), gg, True{})
        == r2.P(T.VWhen{a1} <> tt, gg, True{}) : String}, hw)
    case T.VWhen{+a1} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VWhen{a1} <> tt, hp), gg, True{})
        == r2.P(T.VWhen{a1} <> tt, gg, True{}) : String}, hw)
    case T.VArr{+a1} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VArr{a1} <> tt, hp), gg, True{})
        == r2.P(T.VArr{a1} <> tt, gg, True{}) : String}, hw)
    case T.VArr{+a1} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VArr{a1} <> tt, hp), gg, True{})
        == r2.P(T.VArr{a1} <> tt, gg, True{}) : String}, hw)
    case T.VInl{+a1} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VInl{a1} <> tt, hp), gg, True{})
        == r2.P(T.VInl{a1} <> tt, gg, True{}) : String}, hw)
    case T.VInl{+a1} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VInl{a1} <> tt, hp), gg, True{})
        == r2.P(T.VInl{a1} <> tt, gg, True{}) : String}, hw)
    case T.VHead{+a1, +a2} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VHead{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VHead{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VHead{+a1, +a2} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VHead{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VHead{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VAot{+a1, +a2} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VAot{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VAot{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VAot{+a1, +a2} <> +tt True{}:
      +hin = {wt.more(T.str.eq(a1, hp),
        _u => T.wf.then(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfElems{hp})), hw)
        : {T.wf.then(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfElems{hp})) == True{} : Bool}}
      +hwr = {wt.ok(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfElems{hp}), hin)
        : {T.wf.go(a2, T.WfRows{a1}) == True{} : Bool}}
      +heq = {str.eq.true(a1, hp, wt.ok(T.str.eq(a1, hp),
        _u => T.wf.then(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfElems{hp})), hw)) : {a1 == hp : String}}
      r2.cc(T.VAot{hp, Laws.canon.rows(a2)}, T.VAot{a1, a2}, Laws.canon.go(tt, Laws.CElems{hp}), tt, gg,
        True{},
        Equal.trans(String, "[[" ++ hp ++ "]]\n" ++ T.render.both(Laws.canon.rows(a2), "\n", True{}),
          "[[" ++ a1 ++ "]]\n" ++ T.render.both(Laws.canon.rows(a2), "\n", True{}),
          "[[" ++ a1 ++ "]]\n" ++ T.render.both(a2, "\n", True{}),
          Equal.cong(String, String, zz => "[[" ++ zz ++ "]]\n" ++ T.render.both(Laws.canon.rows(a2), "\n", True{}),
            hp, a1, Equal.sym(String, a1, hp, heq)),
          Equal.cong(String, String, zz => "[[" ++ a1 ++ "]]\n" ++ zz,
            T.render.both(Laws.canon.rows(a2), "\n", True{}), T.render.both(a2, "\n", True{}),
            r2.both(a2, a1, hwr, r2.tabs(a2, False{}, a1, "\n", hwr)))),
        r2.tabs(tt, True{}, hp, gg, wt.more(T.wf.go(a2, T.WfRows{a1}), _v => T.wf.go(tt, T.WfElems{hp}), hin)))
    case T.VAots{+a1, +a2} <> +tt False{}:
      Eq.bit.absurd(&2, {r2.P(st.l(False{}, T.VAots{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VAots{a1, a2} <> tt, gg, True{}) : String}, hw)
    case T.VAots{+a1, +a2} <> +tt True{}:
      Eq.bit.absurd(&2, {r2.P(st.l(True{}, T.VAots{a1, a2} <> tt, hp), gg, True{})
        == r2.P(T.VAots{a1, a2} <> tt, gg, True{}) : String}, hw)


# render writes canon of a well-formed document as it writes the document
def r2.rcanon(
  +ee: String,
  +xs: List<&2, T.Val>,
  +ww: {T.wf(T.Doc{ee, xs}) == True{} : Bool}
) -> {T.render(Laws.canon(T.Doc{ee, xs})) == T.render(T.Doc{ee, xs}) : String}:
  Equal.trans(String, T.render.both(Laws.own.rows(Laws.canon.rows(xs)), "\n", True{}),
    T.render.both(Laws.canon.rows(xs), "\n", True{}), T.render.both(xs, "\n", True{}),
    r2.own.both(Laws.canon.rows(xs)), r2.both(xs, "", ww, r2.tabs(xs, False{}, "", "\n", ww)))

# a well-formed document whose text is short renders, reparses and renders to
# the same text
def r2.half2(
  dd: T.Doc,
  +ww: {T.wf(dd) == True{} : Bool},
  +hs: {Laws.short(T.render(dd)) == True{} : Bool}
) -> {String.eq(T.render(T.parse(T.render(dd))), T.render(dd)) == True{} : Bool}:
  match dd:
    case T.Doc{+ee, +xs}:
      +pd = {T.parse(T.render(T.Doc{ee, xs})) : T.Doc}
      +er = {Equal.trans(String, T.render(pd), T.render(Laws.own(pd)), T.render(T.Doc{ee, xs}),
        Equal.sym(String, T.render(Laws.own(pd)), T.render(pd), r2.rown(pd)),
        Equal.trans(String, T.render(Laws.own(pd)), T.render(Laws.canon(T.Doc{ee, xs})), T.render(T.Doc{ee, xs}),
          Equal.cong(T.Doc, String, zz => T.render(zz), Laws.own(pd), Laws.canon(T.Doc{ee, xs}),
            Laws.render_parse_canon(T.Doc{ee, xs}, ww, hs)),
          r2.rcanon(ee, xs, ww))) : {T.render(pd) == T.render(T.Doc{ee, xs}) : String}}
      Equal.trans(Bool, String.eq(T.render(pd), T.render(T.Doc{ee, xs})),
        String.eq(T.render(T.Doc{ee, xs}), T.render(T.Doc{ee, xs})), True{},
        Equal.cong(String, Bool, zz => String.eq(zz, T.render(T.Doc{ee, xs})), T.render(pd), T.render(T.Doc{ee, xs}),
          er),
        Eq.string_eq_self(T.render(T.Doc{ee, xs})))

# TOML-RT-2: parse_wf makes parse(t) well-formed, so render_parse gives the
# first half and r2.half2 the second
def Laws.parse_render_parse(t, h_u, h_s, h_r, ok):
  +ww = {Laws.parse_wf(t, h_u, h_s, ok) : {T.wf(T.parse(t)) == True{} : Bool}}
  and.tt(Laws.same(T.parse(T.render(T.parse(t))), T.parse(t)),
    String.eq(T.render(T.parse(T.render(T.parse(t)))), T.render(T.parse(t))),
    Eq.and.right(String.is_empty(T.bad(T.parse(T.render(T.parse(t))))),
      Laws.same(T.parse(T.render(T.parse(t))), T.parse(t)), Laws.render_parse(T.parse(t), ww, h_r)),
    r2.half2(T.parse(t), ww, h_r))

# KEY-3: a basic key segment read piece by piece. Every lemma takes the
# segment's state by the bit hd (a key's LKeyQ, or a header's LHeadQ, as
# WP0's qs does) with the stack, uni and left as parameters, since a key may
# sit in an inline table and a string before it may leave uni and left
# anywhere; each piece pushes the character it stands for, and the rest is
# read from whatever back, uni and left the piece leaves.

# a scanner inside a basic quoted segment, its characters so far reversed in
# buf
def k3.q(
  hd: Bool,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  ab: Bool,
  bk: T.Lex,
  un: U32,
  lf: U32,
  buf: List<&2, Char>
) -> T.St:
  T.St{"", rw, hs, he, ps, buf, qs.lex(hd), bk, T.QBasic{}, sk, T.HNone{}, un, lf, ab, False{}}

# the rest of the text read from the segment with buf in its buffer, whatever
# back, uni and left are
def k3.Then(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc
) -> Type:
  @b2: T.Lex -> @u2: U32 -> @l2: U32 ->
    {T.doc.read(rest, T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, b2, u2, l2, buf)}) == goal : T.Doc}

# a two-character escape pushes the character it stands for and leaves back
# at the segment's state
def k3.esc(
  mm: Laws.KMark,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  ih: k3.Then(hd, rw, hs, he, ps, sk, ab, Laws.k3.mark.dec(mm) <> buf, rest, goal)
) -> {T.doc.read(SCon{'\\', SCon{Laws.k3.mark.char(mm), rest}}, T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un,
  lf, buf)}) == goal : T.Doc}:
  match mm hd:
    case Laws.KmQuote{} False{}:
      ih(T.LKeyQ{}, un, lf)
    case Laws.KmQuote{} True{}:
      ih(T.LHeadQ{}, un, lf)
    case Laws.KmBack{} False{}:
      ih(T.LKeyQ{}, un, lf)
    case Laws.KmBack{} True{}:
      ih(T.LHeadQ{}, un, lf)
    case Laws.KmB{} False{}:
      ih(T.LKeyQ{}, un, lf)
    case Laws.KmB{} True{}:
      ih(T.LHeadQ{}, un, lf)
    case Laws.KmF{} False{}:
      ih(T.LKeyQ{}, un, lf)
    case Laws.KmF{} True{}:
      ih(T.LHeadQ{}, un, lf)
    case Laws.KmN{} False{}:
      ih(T.LKeyQ{}, un, lf)
    case Laws.KmN{} True{}:
      ih(T.LHeadQ{}, un, lf)
    case Laws.KmR{} False{}:
      ih(T.LKeyQ{}, un, lf)
    case Laws.KmR{} True{}:
      ih(T.LHeadQ{}, un, lf)
    case Laws.KmT{} False{}:
      ih(T.LKeyQ{}, un, lf)
    case Laws.KmT{} True{}:
      ih(T.LHeadQ{}, un, lf)

# a raw tab is pushed as itself
def k3.tab(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  ih: k3.Then(hd, rw, hs, he, ps, sk, ab, Chr{9} <> buf, rest, goal)
) -> {T.doc.read(SCon{Chr{9}, rest}, T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}) == goal
  : T.Doc}:
  match hd:
    case False{}:
      ih(bk, un, lf)
    case True{}:
      ih(bk, un, lf)

# the fast step of a character in the segment is the segment's full step
def k3.fast(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.read.fast(k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}) == T.read.once2(T.lex.kq.go(
  U32.is_eq(uu, 34), U32.is_eq(uu, 92), True{}, Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), k3.q(hd, rw, hs, he, ps,
  sk, ab, bk, un, lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) : T.St}:
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# the segment's state is no quote that opens a string
def k3.wrap(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)} == T.doc.wrap(k3.q(hd, rw, hs, he, ps, sk, ab, bk,
  un, lf, buf)) : T.Mode}:
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# a character that is no control is pushed: str.bad passes it
def k3.char(
  ctl: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hc: {ctl == False{} : Bool}
) -> {T.read.once2(T.lex.kq.char.go(T.str.bad.go(ctl, U32.is_eq(uu, 9), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)),
  False{}), k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}, qs.lex(hd)))
  == k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}:
  match ctl:
    case False{}:
      match hd:
        case False{}:
          {==}
        case True{}:
          {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.char.go(T.str.bad.go(True{}, U32.is_eq(uu, 9),
        Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), False{}), k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf),
        Chr{uu}, qs.lex(hd))) == k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}, hc)

# a character that is no quote, no backslash and no newline is no closer and
# no escape
def k3.go(
  quote: Bool,
  bs: Bool,
  nl: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool},
  hb: {bs == False{} : Bool},
  hn: {nl == False{} : Bool},
  hc: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool}
) -> {T.read.once2(T.lex.kq.go(quote, bs, True{}, nl, k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu},
  qs.close(hd), qs.lex(hd))) == k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf) : T.St}:
  match quote bs nl:
    case False{} False{} False{}:
      k3.char(Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), uu, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, hc)
    case True{} bb nn:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(True{}, bb, True{}, nn, k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf,
        buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)
        : T.St}, hq)
    case False{} True{} nn:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, True{}, True{}, nn, k3.q(hd, rw, hs, he, ps, sk, ab, bk, un,
        lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)
        : T.St}, hb)
    case False{} False{} True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, False{}, True{}, True{}, k3.q(hd, rw, hs, he, ps, sk, ab,
        bk,
        un, lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf,
        Chr{uu} <> buf) : T.St}, hn)

# the fast step pushes a character
def k3.Fast(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> Type:
  {k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)
    == T.read.fast(k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}) : T.St}

# the scan mode sends such a character to the fast step, and an apostrophe
# comes back from doc.wrap in the segment's state
def k3.scq(
  dq: Bool,
  sq: Bool,
  cr: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {dq == False{} : Bool},
  hr: {cr == False{} : Bool},
  fast: k3.Fast(uu, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)
) -> {T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)}
  == T.doc.scan.q(dq, sq, cr, k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}) : T.Mode}:
  match dq sq cr:
    case True{} s2 c2:
      Eq.bit.absurd2(&2, {T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)}
        == T.doc.scan.q(True{}, s2, c2, k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}) : T.Mode}, hq)
    case False{} True{} _c:
      %fast : {T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)} == T.doc.wrap(_) : T.Mode}
      k3.wrap(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)
    case False{} False{} True{}:
      Eq.bit.absurd2(&2, {T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)}
        == T.doc.scan.q(False{}, False{}, True{}, k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu})
        : T.Mode}, hr)
    case False{} False{} False{}:
      %fast : {T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf)} == T.MScan{_} : T.Mode}
      {==}

# a character written as itself that is no quote, no backslash and no
# control is pushed, and back, uni and left stay
def k3.plain(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  +e34: {U32.is_eq(uu, 34) == False{} : Bool},
  +e92: {U32.is_eq(uu, 92) == False{} : Bool},
  +ec: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool},
  ih: k3.Then(hd, rw, hs, he, ps, sk, ab, Chr{uu} <> buf, rest, goal)
) -> {T.doc.read(SCon{Chr{uu}, rest}, T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}) == goal : T.Doc}:
  +e10 = {ctl.off(uu, 10, ec, {==}) : {U32.is_eq(uu, 10) == False{} : Bool}}
  +e13 = {ctl.off(uu, 13, ec, {==}) : {U32.is_eq(uu, 13) == False{} : Bool}}
  fast = {Equal.sym(T.St, T.read.fast(k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}),
    k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf),
    Equal.trans(T.St, T.read.fast(k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}),
    T.read.once2(T.lex.kq.go(U32.is_eq(uu, 34), U32.is_eq(uu, 92), True{}, Bool.or(U32.is_eq(uu, 10),
    U32.is_eq(uu, 13)), k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))),
    k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, Chr{uu} <> buf),
    k3.fast(uu, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf),
    k3.go(U32.is_eq(uu, 34), U32.is_eq(uu, 92), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), uu, hd, rw, hs, he,
      ps, sk, ab, bk, un, lf, buf, e34, e92, or.ff(U32.is_eq(uu, 10), U32.is_eq(uu, 13), e10, e13), ec)))
    : k3.Fast(uu, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}
  %k3.scq(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13), uu, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf,
    e34, e13, fast) : {T.doc.read(rest, _) == goal : T.Doc}
  ih(bk, un, lf)

# KEY-3: a \u or \U escape's digits, read for every digit at once. dig.val
# is computed on a digit's character alone (k3.hx.dv, k3.hx.ok, one case per
# digit), and the number read so far and the digits left stay symbolic, so
# every code point goes through the same few lemmas.

# the state that reads an escape's hexadecimal digits: a key's LKeyU, or a
# header's LHeadU
def k3.ulex(hd: Bool) -> T.Lex:
  match hd:
    case False{}:
      T.LKeyU{}
    case True{}:
      T.LHeadU{}

# a scanner reading an escape's digits: the number read so far in uni, the
# digits still to read in left
def k3.u(
  hd: Bool,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  ab: Bool,
  bk: T.Lex,
  un: U32,
  lf: U32,
  buf: List<&2, Char>
) -> T.St:
  T.St{"", rw, hs, he, ps, buf, k3.ulex(hd), bk, T.QBasic{}, sk, T.HNone{}, un, lf, ab, False{}}


# a hexadecimal digit's character is one dig.val reads as the digit's value
def k3.hx.dv(hx: Laws.KHex) -> {Laws.k3.hex.val(hx) == T.dig.val(Laws.k3.hex.char(hx)) : U32}:
  match hx:
    case Laws.Kx0{}:
      {==}
    case Laws.Kx1{}:
      {==}
    case Laws.Kx2{}:
      {==}
    case Laws.Kx3{}:
      {==}
    case Laws.Kx4{}:
      {==}
    case Laws.Kx5{}:
      {==}
    case Laws.Kx6{}:
      {==}
    case Laws.Kx7{}:
      {==}
    case Laws.Kx8{}:
      {==}
    case Laws.Kx9{}:
      {==}
    case Laws.KxA{True{}}:
      {==}
    case Laws.KxA{False{}}:
      {==}
    case Laws.KxB{True{}}:
      {==}
    case Laws.KxB{False{}}:
      {==}
    case Laws.KxC{True{}}:
      {==}
    case Laws.KxC{False{}}:
      {==}
    case Laws.KxD{True{}}:
      {==}
    case Laws.KxD{False{}}:
      {==}
    case Laws.KxE{True{}}:
      {==}
    case Laws.KxE{False{}}:
      {==}
    case Laws.KxF{True{}}:
      {==}
    case Laws.KxF{False{}}:
      {==}

# and one dig.ok takes for a digit of base 16
def k3.hx.ok(hx: Laws.KHex) -> {True{} == T.dig.ok(T.dig.val(Laws.k3.hex.char(hx)), 16) : Bool}:
  match hx:
    case Laws.Kx0{}:
      {==}
    case Laws.Kx1{}:
      {==}
    case Laws.Kx2{}:
      {==}
    case Laws.Kx3{}:
      {==}
    case Laws.Kx4{}:
      {==}
    case Laws.Kx5{}:
      {==}
    case Laws.Kx6{}:
      {==}
    case Laws.Kx7{}:
      {==}
    case Laws.Kx8{}:
      {==}
    case Laws.Kx9{}:
      {==}
    case Laws.KxA{True{}}:
      {==}
    case Laws.KxA{False{}}:
      {==}
    case Laws.KxB{True{}}:
      {==}
    case Laws.KxB{False{}}:
      {==}
    case Laws.KxC{True{}}:
      {==}
    case Laws.KxC{False{}}:
      {==}
    case Laws.KxD{True{}}:
      {==}
    case Laws.KxD{False{}}:
      {==}
    case Laws.KxE{True{}}:
      {==}
    case Laws.KxE{False{}}:
      {==}
    case Laws.KxF{True{}}:
      {==}
    case Laws.KxF{False{}}:
      {==}

# the scan mode sends a hexadecimal digit to the fast step
def k3.hx.scan(
  hx: Laws.KHex,
  st: T.St
) -> {T.MScan{T.read.fast(st, Laws.k3.hex.char(hx))} == T.doc.scan(st, Laws.k3.hex.char(hx)) : T.Mode}:
  match hx:
    case Laws.Kx0{}:
      {==}
    case Laws.Kx1{}:
      {==}
    case Laws.Kx2{}:
      {==}
    case Laws.Kx3{}:
      {==}
    case Laws.Kx4{}:
      {==}
    case Laws.Kx5{}:
      {==}
    case Laws.Kx6{}:
      {==}
    case Laws.Kx7{}:
      {==}
    case Laws.Kx8{}:
      {==}
    case Laws.Kx9{}:
      {==}
    case Laws.KxA{True{}}:
      {==}
    case Laws.KxA{False{}}:
      {==}
    case Laws.KxB{True{}}:
      {==}
    case Laws.KxB{False{}}:
      {==}
    case Laws.KxC{True{}}:
      {==}
    case Laws.KxC{False{}}:
      {==}
    case Laws.KxD{True{}}:
      {==}
    case Laws.KxD{False{}}:
      {==}
    case Laws.KxE{True{}}:
      {==}
    case Laws.KxE{False{}}:
      {==}
    case Laws.KxF{True{}}:
      {==}
    case Laws.KxF{False{}}:
      {==}

# a digit that is not the last one: it joins the number, and one digit fewer
# is left
def k3.hx.mid(
  +hx: Laws.KHex,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  el: {U32.is_eq(lf, 1) == False{} : Bool}
) -> {k3.u(hd, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)
  == T.read.fast(k3.u(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Laws.k3.hex.char(hx)) : T.St}:
  match hd:
    case False{}:
      %k3.hx.ok(hx) : {k3.u(False{}, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)
        == T.read.once2(T.uni.go(_, k3.u(False{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Laws.k3.hex.char(hx),
        T.LKeyQ{}, un, lf)) : T.St}
      %k3.hx.dv(hx) : {k3.u(False{}, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)
        == T.read.once2(T.uni.next(U32.is_eq(lf, 1), k3.u(False{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf),
        U32.add(U32.mul(un, 16), _), T.LKeyQ{}, lf)) : T.St}
      %Equal.sym(Bool, U32.is_eq(lf, 1), False{}, el) : {k3.u(False{}, rw, hs, he, ps, sk, ab, bk,
        Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf) == T.read.once2(T.uni.next(_, k3.u(False{}, rw, hs, he, ps,
        sk, ab, bk, un, lf, buf), Laws.k3.hex.acc(un, hx), T.LKeyQ{}, lf)) : T.St}
      {==}
    case True{}:
      %k3.hx.ok(hx) : {k3.u(True{}, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)
        == T.read.once2(T.uni.go(_, k3.u(True{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Laws.k3.hex.char(hx),
        T.LHeadQ{}, un, lf)) : T.St}
      %k3.hx.dv(hx) : {k3.u(True{}, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)
        == T.read.once2(T.uni.next(U32.is_eq(lf, 1), k3.u(True{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf),
        U32.add(U32.mul(un, 16), _), T.LHeadQ{}, lf)) : T.St}
      %Equal.sym(Bool, U32.is_eq(lf, 1), False{}, el) : {k3.u(True{}, rw, hs, he, ps, sk, ab, bk,
        Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf) == T.read.once2(T.uni.next(_, k3.u(True{}, rw, hs, he, ps,
        sk, ab, bk, un, lf, buf), Laws.k3.hex.acc(un, hx), T.LHeadQ{}, lf)) : T.St}
      {==}

# the last digit: the number is a Unicode scalar value, pushed as the
# character, and the segment's state is back with uni and left at 0
def k3.hx.last(
  +hx: Laws.KHex,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  el: {U32.is_eq(lf, 1) == True{} : Bool},
  eo: {Laws.k3.scalar(Laws.k3.hex.acc(un, hx)) == True{} : Bool}
) -> {k3.q(hd, rw, hs, he, ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)
  == T.read.fast(k3.u(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Laws.k3.hex.char(hx)) : T.St}:
  match hd:
    case False{}:
      %k3.hx.ok(hx) : {k3.q(False{}, rw, hs, he, ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)
        == T.read.once2(T.uni.go(_, k3.u(False{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Laws.k3.hex.char(hx),
        T.LKeyQ{}, un, lf)) : T.St}
      %k3.hx.dv(hx) : {k3.q(False{}, rw, hs, he, ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)
        == T.read.once2(T.uni.next(U32.is_eq(lf, 1), k3.u(False{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf),
        U32.add(U32.mul(un, 16), _), T.LKeyQ{}, lf)) : T.St}
      %Equal.sym(Bool, U32.is_eq(lf, 1), True{}, el) : {k3.q(False{}, rw, hs, he, ps, sk, ab, bk, 0, 0,
        Chr{Laws.k3.hex.acc(un, hx)} <> buf) == T.read.once2(T.uni.next(_, k3.u(False{}, rw, hs, he, ps, sk, ab, bk,
        un, lf, buf), Laws.k3.hex.acc(un, hx), T.LKeyQ{}, lf)) : T.St}
      %Equal.sym(Bool, T.uni.ok(Laws.k3.hex.acc(un, hx)), True{}, eo) : {k3.q(False{}, rw, hs, he, ps, sk, ab, bk,
        0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf) == T.read.once2(T.uni.finish(_, k3.u(False{}, rw, hs, he, ps, sk,
        ab, bk, un, lf, buf), Laws.k3.hex.acc(un, hx), T.LKeyQ{})) : T.St}
      {==}
    case True{}:
      %k3.hx.ok(hx) : {k3.q(True{}, rw, hs, he, ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)
        == T.read.once2(T.uni.go(_, k3.u(True{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf), Laws.k3.hex.char(hx),
        T.LHeadQ{}, un, lf)) : T.St}
      %k3.hx.dv(hx) : {k3.q(True{}, rw, hs, he, ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)
        == T.read.once2(T.uni.next(U32.is_eq(lf, 1), k3.u(True{}, rw, hs, he, ps, sk, ab, bk, un, lf, buf),
        U32.add(U32.mul(un, 16), _), T.LHeadQ{}, lf)) : T.St}
      %Equal.sym(Bool, U32.is_eq(lf, 1), True{}, el) : {k3.q(True{}, rw, hs, he, ps, sk, ab, bk, 0, 0,
        Chr{Laws.k3.hex.acc(un, hx)} <> buf) == T.read.once2(T.uni.next(_, k3.u(True{}, rw, hs, he, ps, sk, ab, bk,
        un, lf, buf), Laws.k3.hex.acc(un, hx), T.LHeadQ{}, lf)) : T.St}
      %Equal.sym(Bool, T.uni.ok(Laws.k3.hex.acc(un, hx)), True{}, eo) : {k3.q(True{}, rw, hs, he, ps, sk, ab, bk,
        0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf) == T.read.once2(T.uni.finish(_, k3.u(True{}, rw, hs, he, ps, sk,
        ab, bk, un, lf, buf), Laws.k3.hex.acc(un, hx), T.LHeadQ{})) : T.St}
      {==}

# the digits an escape reads: eight when lg, four otherwise
def k3.hx.n(lg: Bool) -> U32:
  match lg:
    case True{}:
      8
    case False{}:
      4

# the letter after its backslash
def k3.hx.u(lg: Bool) -> Char:
  match lg:
    case True{}:
      'U'
    case False{}:
      'u'

# a digit that is not the last one, read from the text
def k3.hx.rmid(
  +hx: Laws.KHex,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  el: {U32.is_eq(lf, 1) == False{} : Bool}
) -> {T.doc.read(rest, T.MScan{k3.u(hd, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)})
  == T.doc.read(SCon{Laws.k3.hex.char(hx), rest}, T.MScan{k3.u(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})
  : T.Doc}:
  %k3.hx.scan(hx, k3.u(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)) : {T.doc.read(rest, T.MScan{k3.u(hd, rw, hs, he,
    ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)}) == T.doc.read(rest, _) : T.Doc}
  %k3.hx.mid(hx, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, el) : {T.doc.read(rest, T.MScan{k3.u(hd, rw, hs, he,
    ps, sk, ab, bk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), buf)}) == T.doc.read(rest, T.MScan{_}) : T.Doc}
  {==}

# the last digit, read from the text
def k3.hx.rlast(
  +hx: Laws.KHex,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  el: {U32.is_eq(lf, 1) == True{} : Bool},
  eo: {Laws.k3.scalar(Laws.k3.hex.acc(un, hx)) == True{} : Bool}
) -> {T.doc.read(rest, T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)})
  == T.doc.read(SCon{Laws.k3.hex.char(hx), rest}, T.MScan{k3.u(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})
  : T.Doc}:
  %k3.hx.scan(hx, k3.u(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)) : {T.doc.read(rest, T.MScan{k3.q(hd, rw, hs, he,
    ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)}) == T.doc.read(rest, _) : T.Doc}
  %k3.hx.last(hx, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, el, eo) : {T.doc.read(rest, T.MScan{k3.q(hd, rw, hs,
    he, ps, sk, ab, bk, 0, 0, Chr{Laws.k3.hex.acc(un, hx)} <> buf)}) == T.doc.read(rest, T.MScan{_}) : T.Doc}
  {==}

# a backslash and u (U when lg) start an escape of four digits (eight),
# with back at the segment's state
def k3.hx.open(
  +lg: Bool,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String
) -> {T.doc.read(rest, T.MScan{k3.u(hd, rw, hs, he, ps, sk, ab, qs.lex(hd), 0, k3.hx.n(lg), buf)})
  == T.doc.read(SCon{'\\', SCon{k3.hx.u(lg), rest}}, T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})
  : T.Doc}:
  match lg:
    case False{}:
      match hd:
        case False{}:
          {==}
        case True{}:
          {==}
    case True{}:
      match hd:
        case False{}:
          {==}
        case True{}:
          {==}

# `\u` and four digits push the character they name, and leave back at the
# segment's state and uni and left at 0
def k3.u4(
  +dd: Laws.KHex,
  +cc: Laws.KHex,
  +bb: Laws.KHex,
  +aa: Laws.KHex,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.k3.scalar(Laws.k3.hex4(dd, cc, bb, aa)) == True{} : Bool},
  ih: k3.Then(hd, rw, hs, he, ps, sk, ab, Chr{Laws.k3.hex4(dd, cc, bb, aa)} <> buf, rest, goal)
) -> {T.doc.read(Laws.k3.pc.text(Laws.KpU4{dd, cc, bb, aa}, rest), T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un,
  lf, buf)}) == goal : T.Doc}:
  %k3.hx.open(False{}, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.k3.hex4.text(dd, cc, bb, aa, rest))
    : {_ == goal : T.Doc}
  %k3.hx.rmid(dd, hd, rw, hs, he, ps, sk, ab, qs.lex(hd), 0, 4, buf, SCon{Laws.k3.hex.char(cc),
    SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa), rest}}}, {==}) : {_ == goal : T.Doc}
  %k3.hx.rmid(cc, hd, rw, hs, he, ps, sk, ab, qs.lex(hd), Laws.k3.hex.acc(0, dd), 3, buf,
    SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa), rest}}, {==}) : {_ == goal : T.Doc}
  %k3.hx.rmid(bb, hd, rw, hs, he, ps, sk, ab, qs.lex(hd), Laws.k3.hex.acc(Laws.k3.hex.acc(0, dd), cc), 2, buf,
    SCon{Laws.k3.hex.char(aa), rest}, {==}) : {_ == goal : T.Doc}
  %k3.hx.rlast(aa, hd, rw, hs, he, ps, sk, ab, qs.lex(hd), Laws.k3.hex.acc(Laws.k3.hex.acc(Laws.k3.hex.acc(0, dd),
    cc), bb), 1, buf, rest, {==}, eo) : {_ == goal : T.Doc}
  ih(qs.lex(hd), 0, 0)

# `\U` and eight digits push the character they name, and leave back at the
# segment's state and uni and left at 0
def k3.u8(
  +hh: Laws.KHex,
  +gg: Laws.KHex,
  +ff: Laws.KHex,
  +ee: Laws.KHex,
  +dd: Laws.KHex,
  +cc: Laws.KHex,
  +bb: Laws.KHex,
  +aa: Laws.KHex,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.k3.scalar(Laws.k3.hex8(hh, gg, ff, ee, dd, cc, bb, aa)) == True{} : Bool},
  ih: k3.Then(hd, rw, hs, he, ps, sk, ab, Chr{Laws.k3.hex8(hh, gg, ff, ee, dd, cc, bb, aa)} <> buf, rest, goal)
) -> {T.doc.read(Laws.k3.pc.text(Laws.KpU8{hh, gg, ff, ee, dd, cc, bb, aa}, rest), T.MScan{k3.q(hd, rw, hs, he, ps,
  sk, ab, bk, un, lf, buf)}) == goal : T.Doc}:
  +t4 = Laws.k3.hex4.text(dd, cc, bb, aa, rest)
  +a1 = Laws.k3.hex.acc(0, hh)
  +a2 = Laws.k3.hex.acc(a1, gg)
  +a3 = Laws.k3.hex.acc(a2, ff)
  +a4 = Laws.k3.hex.acc(a3, ee)
  +a5 = Laws.k3.hex.acc(a4, dd)
  +a6 = Laws.k3.hex.acc(a5, cc)
  +a7 = Laws.k3.hex.acc(a6, bb)
  +sl = qs.lex(hd)
  %k3.hx.open(True{}, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.k3.hex4.text(hh, gg, ff, ee, t4))
    : {_ == goal : T.Doc}
  %k3.hx.rmid(hh, hd, rw, hs, he, ps, sk, ab, sl, 0, 8, buf, SCon{Laws.k3.hex.char(gg), SCon{Laws.k3.hex.char(ff),
    SCon{Laws.k3.hex.char(ee), t4}}}, {==}) : {_ == goal : T.Doc}
  %k3.hx.rmid(gg, hd, rw, hs, he, ps, sk, ab, sl, a1, 7, buf, SCon{Laws.k3.hex.char(ff), SCon{Laws.k3.hex.char(ee),
    t4}}, {==}) : {_ == goal : T.Doc}
  %k3.hx.rmid(ff, hd, rw, hs, he, ps, sk, ab, sl, a2, 6, buf, SCon{Laws.k3.hex.char(ee), t4}, {==})
    : {_ == goal : T.Doc}
  %k3.hx.rmid(ee, hd, rw, hs, he, ps, sk, ab, sl, a3, 5, buf, t4, {==}) : {_ == goal : T.Doc}
  %k3.hx.rmid(dd, hd, rw, hs, he, ps, sk, ab, sl, a4, 4, buf, SCon{Laws.k3.hex.char(cc),
    SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa), rest}}}, {==}) : {_ == goal : T.Doc}
  %k3.hx.rmid(cc, hd, rw, hs, he, ps, sk, ab, sl, a5, 3, buf, SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa),
    rest}}, {==}) : {_ == goal : T.Doc}
  %k3.hx.rmid(bb, hd, rw, hs, he, ps, sk, ab, sl, a6, 2, buf, SCon{Laws.k3.hex.char(aa), rest}, {==})
    : {_ == goal : T.Doc}
  %k3.hx.rlast(aa, hd, rw, hs, he, ps, sk, ab, sl, a7, 1, buf, rest, {==}, eo) : {_ == goal : T.Doc}
  ih(sl, 0, 0)

# a character written as itself read from the segment, then the rest
def k3.PcG(
  +cc: Char,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc
) -> Type:
  k3.Then(hd, rw, hs, he, ps, sk, ab, cc <> buf, rest, goal) ->
    {T.doc.read(SCon{cc, rest}, T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}) == goal : T.Doc}

# basic-unescaped is no quotation mark
def k3.bc.q(
  aa: Bool,
  bb: Bool,
  cc: Bool,
  dd: Bool,
  ee: {Bool.not(Bool.or(aa, Bool.or(bb, Bool.and(cc, Bool.not(dd))))) == True{} : Bool}
) -> {aa == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, ee)
    case False{}:
      {==}

# no backslash
def k3.bc.b(
  aa: Bool,
  bb: Bool,
  cc: Bool,
  dd: Bool,
  ee: {Bool.not(Bool.or(aa, Bool.or(bb, Bool.and(cc, Bool.not(dd))))) == True{} : Bool}
) -> {bb == False{} : Bool}:
  match aa bb:
    case True{} b2:
      Eq.bit.absurd(&2, {b2 == False{} : Bool}, ee)
    case False{} True{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, ee)
    case False{} False{}:
      {==}

# and, when it is no tab, no control
def k3.bc.c(
  aa: Bool,
  bb: Bool,
  cc: Bool,
  dd: Bool,
  e9: {dd == False{} : Bool},
  ee: {Bool.not(Bool.or(aa, Bool.or(bb, Bool.and(cc, Bool.not(dd))))) == True{} : Bool}
) -> {cc == False{} : Bool}:
  match aa bb cc dd:
    case True{} b2 c2 d2:
      Eq.bit.absurd(&2, {c2 == False{} : Bool}, ee)
    case False{} True{} c2 d2:
      Eq.bit.absurd(&2, {c2 == False{} : Bool}, ee)
    case False{} False{} False{} d2:
      {==}
    case False{} False{} True{} True{}:
      Eq.bit.absurd2(&2, {True{} == False{} : Bool}, e9)
    case False{} False{} True{} False{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, ee)

# a character written as itself: a tab, or one that is no quote, no
# backslash and no control
def k3.chr(
  t9: Bool,
  +uu: U32,
  +e9: {U32.is_eq(uu, 9) == t9 : Bool},
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  +eb: {Laws.k3.bchar(Chr{uu}) == True{} : Bool}
) -> k3.PcG(Chr{uu}, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, goal):
  match t9:
    case True{}:
      %Equal.sym(Char, Chr{uu}, Chr{9}, Eq.u32_eq(uu, 9, e9)) : k3.PcG(_, hd, rw, hs, he, ps, sk, ab, bk, un, lf,
        buf, rest, goal)
      ih => k3.tab(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, goal, ih)
    case False{}:
      +tq = U32.is_eq(uu, 34)
      +tb = U32.is_eq(uu, 92)
      +tc = Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127))
      +tt = U32.is_eq(uu, 9)
      ih => k3.plain(uu, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, goal, k3.bc.q(tq, tb, tc, tt, eb),
        k3.bc.b(tq, tb, tc, tt, eb), k3.bc.c(tq, tb, tc, tt, e9, eb), ih)

# one piece a basic string may hold pushes the character it stands for
def k3.pc(
  pp: Laws.KPiece,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.k3.pc.ok(pp) == True{} : Bool},
  ih: k3.Then(hd, rw, hs, he, ps, sk, ab, Laws.k3.pc.char(pp) <> buf, rest, goal)
) -> {T.doc.read(Laws.k3.pc.text(pp, rest), T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}) == goal
  : T.Doc}:
  match pp:
    case Laws.KpChar{cc}:
      match cc:
        case Chr{+uu}:
          k3.chr(U32.is_eq(uu, 9), uu, {==}, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, goal, eo)(ih)
    case Laws.KpEsc{mm}:
      k3.esc(mm, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, goal, ih)
    case Laws.KpU4{+dd, +cc, +bb, +aa}:
      k3.u4(dd, cc, bb, aa, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, goal, eo, ih)
    case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
      k3.u8(hh, gg, ff, ee, dd, cc, bb, aa, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, goal, eo, ih)

# every piece of a list a basic string may hold, in order: the rest is read
# with their characters pushed, from wherever the last piece left back, uni
# and left
def k3.pcs(
  pl: List<&2, Laws.KPiece>,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  +goal: T.Doc,
  +eo: {Laws.k3.pcs.ok(pl) == True{} : Bool},
  ih: k3.Then(hd, rw, hs, he, ps, sk, ab, rev.onto(Laws.k3.pcs.name(pl), buf), rest, goal)
) -> {T.doc.read(Laws.k3.pcs.text(pl, rest), T.MScan{k3.q(hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}) == goal
  : T.Doc}:
  match pl:
    case []:
      ih(bk, un, lf)
    case +pp <> +pr:
      k3.pc(pp, hd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.k3.pcs.text(pr, rest), goal,
        Eq.and.left(Laws.k3.pc.ok(pp), Laws.k3.pcs.ok(pr), eo),
        +b2 => +u2 => +l2 => k3.pcs(pr, hd, rw, hs, he, ps, sk, ab, b2, u2, l2, Laws.k3.pc.char(pp) <> buf, rest,
          goal, Eq.and.right(Laws.k3.pc.ok(pp), Laws.k3.pcs.ok(pr), eo), ih))

# a name's characters pushed onto an empty buffer read back as the name
def k3.nm(+ss: String) -> {ss == T.buf.str.go(rev.onto(ss, []), "") : String}:
  Equal.sym(String, T.buf.str.go(rev.onto(ss, []), ""), ss, Equal.trans(String, T.buf.str.go(rev.onto(ss, []), ""),
    String.append(ss, ""), ss, ml.rev(ss, [], ""), Eq.append_nil(ss)))

def Laws.basic_key_reads_back(pl, ok):
  k3.pcs(pl, False{}, [], [], [], [], [], False{}, T.LTop{}, 0, 0, [], "\" = 1", T.Doc{"", [T.VPair{
    Laws.k3.pcs.name(pl), Laws.one()}]}, ok, _b2 => _u2 => _l2 =>
    %k3.nm(Laws.k3.pcs.name(pl)) : {T.Doc{"", [T.VPair{_, Laws.one()}]} == T.Doc{"", [T.VPair{Laws.k3.pcs.name(pl),
      Laws.one()}]} : T.Doc}
    {==})

# KEY-3: a literal segment, as WP-K3's ql reads it, with the stack, uni and
# left as parameters: every character but the apostrophe is pushed as it is,
# and back, uni and left never move.

# a scanner inside a literal quoted segment, its characters so far reversed
# in buf
def k3.l(
  hd: Bool,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  ab: Bool,
  bk: T.Lex,
  un: U32,
  lf: U32,
  buf: List<&2, Char>
) -> T.St:
  T.St{"", rw, hs, he, ps, buf, qs.lex(hd), bk, T.QLit{}, sk, T.HNone{}, un, lf, ab, False{}}

# a character read from a literal segment is pushed
def k3.l.Step(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> Type:
  {T.doc.scan(k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu})
    == T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf)} : T.Mode}

# a quotation mark, a backslash and a tab: their steps compute
def k3.l.s34(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> k3.l.Step(34, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf):
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# a backslash
def k3.l.s92(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> k3.l.Step(92, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf):
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# a tab
def k3.l.s9(
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> k3.l.Step(9, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf):
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# the fast step of a character in a literal segment is the segment's full step
def k3.l.fast(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.read.fast(k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu}) == T.read.once2(T.lex.kq.go(
  U32.is_eq(uu, 39), U32.is_eq(uu, 92), False{}, Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)),
  k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) : T.St}:
  match hd:
    case False{}:
      {==}
    case True{}:
      {==}

# a character that is no control is pushed: str.bad passes it
def k3.l.char(
  ctl: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hc: {ctl == False{} : Bool}
) -> {T.read.once2(T.lex.kq.char.go(T.str.bad.go(ctl, U32.is_eq(uu, 9),
  Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), False{}), k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf),
  Chr{uu}, qs.lex(hd))) == k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf) : T.St}:
  match ctl:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.char.go(T.str.bad.go(True{}, U32.is_eq(uu, 9),
        Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), False{}), k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf,
        buf), Chr{uu}, qs.lex(hd))) == k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf) : T.St}, hc)

# a character that is no apostrophe, no backslash and no newline is no closer
# and no backslash
def k3.l.go(
  quote: Bool,
  bs: Bool,
  nl: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool},
  hb: {bs == False{} : Bool},
  hn: {nl == False{} : Bool},
  hc: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool}
) -> {T.read.once2(T.lex.kq.go(quote, bs, False{}, nl, k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu},
  qs.close(hd), qs.lex(hd))) == k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf) : T.St}:
  match quote:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(True{}, bs, False{}, nl, k3.l(hd, rw, hs, he, ps, sk, ab,
        back, un, lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf,
        Chr{uu} <> buf) : T.St}, hq)
    case False{}:
      match bs:
        case True{}:
          Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, True{}, False{}, nl, k3.l(hd, rw, hs, he,
            ps, sk, ab, back, un, lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == k3.l(hd, rw, hs, he, ps, sk, ab,
            back, un, lf, Chr{uu} <> buf) : T.St}, hb)
        case False{}:
          match nl:
            case True{}:
              Eq.bit.absurd2(&2, {T.read.once2(T.lex.kq.go(False{}, False{}, False{}, True{}, k3.l(hd,
                rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu}, qs.close(hd), qs.lex(hd))) == k3.l(hd, rw, hs,
                he, ps, sk, ab, back, un, lf, Chr{uu} <> buf) : T.St}, hn)
            case False{}:
              k3.l.char(Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), uu, hd, rw, hs, he, ps, sk, ab,
                back, un, lf, buf, hc)

# the fast step pushes a character
def k3.l.Fast(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> Type:
  {T.read.fast(k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu})
    == k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf) : T.St}

# the scan mode sends such a character to the fast step
def k3.l.q(
  dq: Bool,
  sq: Bool,
  cr: Bool,
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {dq == False{} : Bool},
  hs1: {sq == False{} : Bool},
  hr: {cr == False{} : Bool},
  fast: k3.l.Fast(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf)
) -> {T.doc.scan.q(dq, sq, cr, k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu})
  == T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf)} : T.Mode}:
  match dq:
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.scan.q(True{}, sq, cr, k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu})
        == T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf)} : T.Mode}, hq)
    case False{}:
      match sq:
        case True{}:
          Eq.bit.absurd2(&2, {T.doc.scan.q(False{}, True{}, cr, k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf),
            Chr{uu}) == T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf)} : T.Mode}, hs1)
        case False{}:
          match cr:
            case True{}:
              Eq.bit.absurd2(&2, {T.doc.scan.q(False{}, False{}, True{}, k3.l(hd, rw, hs, he, ps, sk, ab,
                back, un, lf, buf), Chr{uu}) == T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf)}
                : T.Mode}, hr)
            case False{}:
              Equal.cong(T.St, T.Mode, st => T.MScan{st},
                T.read.fast(k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu}),
                k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf), fast)

# any other literal character goes through the dispatch and is pushed
def k3.l.gen(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  e34: {U32.is_eq(uu, 34) == False{} : Bool},
  e92: {U32.is_eq(uu, 92) == False{} : Bool},
  +e9: {U32.is_eq(uu, 9) == False{} : Bool},
  +el: {Laws.lit.char(Chr{uu}) == True{} : Bool}
) -> k3.l.Step(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf):
  +e39 = {lit.q(U32.is_eq(uu, 39), Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9),
    el) : {U32.is_eq(uu, 39) == False{} : Bool}}
  +ec = {lit.c(U32.is_eq(uu, 39), Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9),
    e9, el) : {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == False{} : Bool}}
  +e10 = {ctl.off(uu, 10, ec, {==}) : {U32.is_eq(uu, 10) == False{} : Bool}}
  +e13 = {ctl.off(uu, 13, ec, {==}) : {U32.is_eq(uu, 13) == False{} : Bool}}
  k3.l.q(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13), uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf,
    e34, e39, e13,
    Equal.trans(T.St, T.read.fast(k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu}),
      T.read.once2(T.lex.kq.go(U32.is_eq(uu, 39), U32.is_eq(uu, 92), False{},
        Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu},
        qs.close(hd), qs.lex(hd))),
      k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf),
      k3.l.fast(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf),
      k3.l.go(U32.is_eq(uu, 39), U32.is_eq(uu, 92), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), uu, hd,
        rw, hs, he, ps, sk, ab, back, un, lf, buf, e39, e92, or.ff(U32.is_eq(uu, 10), U32.is_eq(uu, 13), e10, e13),
        ec)))

# one code point k that the test found: its step is the character's
def k3.l.is(
  +uu: U32,
  +kk: U32,
  ee: {U32.is_eq(uu, kk) == True{} : Bool},
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  at: k3.l.Step(kk, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf)
) -> k3.l.Step(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf):
  eu = Equal.cong(Char, U32, cc => Char.to_u32(cc), Chr{uu}, Chr{kk}, Eq.u32_eq(uu, kk, ee))
  %Equal.sym(U32, uu, kk, eu) : k3.l.Step(_, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf)
  at

# every literal character: a quotation mark, a backslash, a tab, or another
def k3.l.split(
  +uu: U32,
  d34: Bool,
  b92: Bool,
  t9: Bool,
  e34: {U32.is_eq(uu, 34) == d34 : Bool},
  e92: {U32.is_eq(uu, 92) == b92 : Bool},
  e9: {U32.is_eq(uu, 9) == t9 : Bool},
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  el: {Laws.lit.char(Chr{uu}) == True{} : Bool}
) -> k3.l.Step(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf):
  match d34:
    case True{}:
      k3.l.is(uu, 34, e34, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf, k3.l.s34(hd, rw, hs, he, ps, sk, ab, back,
        un, lf, buf))
    case False{}:
      match b92:
        case True{}:
          k3.l.is(uu, 92, e92, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf, k3.l.s92(hd, rw, hs, he, ps, sk, ab,
            back, un, lf, buf))
        case False{}:
          match t9:
            case True{}:
              k3.l.is(uu, 9, e9, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf, k3.l.s9(hd, rw, hs, he, ps, sk, ab,
                back, un, lf,
                buf))
            case False{}:
              k3.l.gen(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf, e34, e92, e9, el)

# one character of a literal segment
def k3.l.one(
  +uu: U32,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  el: {Laws.lit.char(Chr{uu}) == True{} : Bool}
) -> k3.l.Step(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf):
  k3.l.split(uu, U32.is_eq(uu, 34), U32.is_eq(uu, 92), U32.is_eq(uu, 9), {==}, {==}, {==}, hd, rw, hs,
    he, ps, sk, ab, back, un, lf, buf, el)

# every character of a literal text is pushed, whatever follows it
def k3.l.body(
  ss: String,
  +rr: String,
  +hd: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +back: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +ee: {Laws.lit.text(ss) == True{} : Bool}
) -> {T.doc.read(String.append(ss, rr), T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf)})
  == T.doc.read(rr, T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, rev.onto(ss, buf))}) : T.Doc}:
  match ss:
    case SNil{}:
      {==}
    case SCon{hh, +tt}:
      match hh:
        case Chr{+uu}:
          Equal.trans(T.Doc,
            T.doc.read(String.append(tt, rr), T.doc.scan(k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu})),
            T.doc.read(String.append(tt, rr), T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf)}),
            T.doc.read(rr, T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, rev.onto(tt, Chr{uu} <> buf))}),
            Equal.cong(T.Mode, T.Doc, md => T.doc.read(String.append(tt, rr), md),
              T.doc.scan(k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, buf), Chr{uu}),
              T.MScan{k3.l(hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf)},
              k3.l.one(uu, hd, rw, hs, he, ps, sk, ab, back, un, lf, buf,
                Eq.and.left(Laws.lit.char(Chr{uu}), Laws.lit.text(tt), ee))),
            k3.l.body(tt, rr, hd, rw, hs, he, ps, sk, ab, back, un, lf, Chr{uu} <> buf,
              Eq.and.right(Laws.lit.char(Chr{uu}), Laws.lit.text(tt), ee)))


# KEY-3: a dotted key read from every place a key may start: the start of a
# line (LTop), an inline table after `{` (LInl) or a comma (LInlK), and after
# a dot (LKeyDot), whatever the stack, uni and left hold. A bare segment is
# pushed in LKey and ended by blank space, a dot or `=`; a basic one is read
# piece by piece (k3.pcs) and a literal one character by character (k3.l),
# each ending in LAfter; blank space in LAfter and after a dot is skipped.
# The segment's name joins parts, newest first, as WP-K3's kl does with the
# stack and the escape fields fixed.

# a scanner reading a key, with its segments so far in ps and the open bare
# segment reversed in buf
def k3.w(
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  buf: List<&2, Char>,
  lex: T.Lex,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.St:
  T.St{"", rw, hs, he, ps, buf, lex, bk, qk, sk, T.HNone{}, un, lf, ab, False{}}

# where a key segment starts: where a key may start, or after a dot
def k3.lex0(dt: Bool, at: Laws.KPos) -> T.Lex:
  match dt:
    case False{}:
      Laws.k3.pos.lex(at)
    case True{}:
      T.LKeyDot{}

# the segments before it: none where a key starts
def k3.ps0(dt: Bool, ps: List<&2, String>) -> List<&2, String>:
  match dt:
    case False{}:
      []
    case True{}:
      ps

# what ends a segment and its blank space: a dot, or `=` when cl
def k3.dl(cl: Bool) -> Char:
  match cl:
    case False{}:
      '.'
    case True{}:
      '='

# the state after it: waiting for the next segment, or for the value
def k3.aft(cl: Bool) -> T.Lex:
  match cl:
    case False{}:
      T.LKeyDot{}
    case True{}:
      T.LVal{}

# the rest of the text read after a segment and what ends it, from every
# back, qkind, uni and left
def k3.KT(
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc
) -> Type:
  @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    {T.doc.read(rest, T.MScan{k3.w(rw, hs, he, ps, [], k3.aft(cl), b2, q2, sk, u2, l2, ab)}) == goal : T.Doc}

# blank space after a segment stays in LAfter
def k3.agap(
  gs: List<&2, Bool>,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, [], T.LAfter{}, bk, qk, sk, un, lf, ab)})
  == T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{k3.w(rw, hs, he, ps, [], T.LAfter{}, bk, qk, sk, un, lf,
  ab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          k3.agap(rest, rr, rw, hs, he, ps, bk, qk, sk, un, lf, ab)
        case False{}:
          k3.agap(rest, rr, rw, hs, he, ps, bk, qk, sk, un, lf, ab)

# and blank space after a dot stays in LKeyDot
def k3.dgap(
  gs: List<&2, Bool>,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk, sk, un, lf, ab)})
  == T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk, sk, un, lf,
  ab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          k3.dgap(rest, rr, rw, hs, he, ps, bk, qk, sk, un, lf, ab)
        case False{}:
          k3.dgap(rest, rr, rw, hs, he, ps, bk, qk, sk, un, lf, ab)

# and blank space where a key may start leaves the scanner there
def k3.g0(
  gs: List<&2, Bool>,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +rr: String
) -> {T.doc.read(rr, T.MScan{Laws.k3.at(at, rw, hs, he, sk, ab, bk, qk, un, lf)})
  == T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{Laws.k3.at(at, rw, hs, he, sk, ab, bk, qk, un, lf)})
  : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          match at:
            case Laws.AtLine{}:
              k3.g0(rest, Laws.AtLine{}, rw, hs, he, sk, ab, bk, qk, un, lf, rr)
            case Laws.AtInl{}:
              k3.g0(rest, Laws.AtInl{}, rw, hs, he, sk, ab, bk, qk, un, lf, rr)
            case Laws.AtInlK{}:
              k3.g0(rest, Laws.AtInlK{}, rw, hs, he, sk, ab, bk, qk, un, lf, rr)
        case False{}:
          match at:
            case Laws.AtLine{}:
              k3.g0(rest, Laws.AtLine{}, rw, hs, he, sk, ab, bk, qk, un, lf, rr)
            case Laws.AtInl{}:
              k3.g0(rest, Laws.AtInl{}, rw, hs, he, sk, ab, bk, qk, un, lf, rr)
            case Laws.AtInlK{}:
              k3.g0(rest, Laws.AtInlK{}, rw, hs, he, sk, ab, bk, qk, un, lf, rr)

# a dot or `=` after a segment's blank space
def k3.adl(
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String
) -> {T.doc.read(rest, T.MScan{k3.w(rw, hs, he, ps, [], k3.aft(cl), bk, qk, sk, un, lf, ab)})
  == T.doc.read(SCon{k3.dl(cl), rest}, T.MScan{k3.w(rw, hs, he, ps, [], T.LAfter{}, bk, qk, sk, un, lf, ab)})
  : T.Doc}:
  match cl:
    case False{}:
      {==}
    case True{}:
      {==}

# a segment's name pushed onto parts, then blank space and a dot or `=`: the
# rest is read from there
def k3.fin(
  +nm: String,
  +bf: List<&2, Char>,
  en: {nm == T.buf.str(bf) : String},
  +gs: List<&2, Bool>,
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: k3.KT(cl, rw, hs, he, nm <> ps, sk, ab, rest, goal)
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{k3.dl(cl), rest}), T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps,
  [], T.LAfter{}, bk, qk, sk, un, lf, ab)}) == goal : T.Doc}:
  %k3.agap(gs, SCon{k3.dl(cl), rest}, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, sk, un, lf, ab) : {_ == goal : T.Doc}
  %k3.adl(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, sk, un, lf, ab, rest) : {_ == goal : T.Doc}
  %en : {T.doc.read(rest, T.MScan{k3.w(rw, hs, he, _ <> ps, [], k3.aft(cl), bk, qk, sk, un, lf, ab)}) == goal
    : T.Doc}
  ih(bk, qk, un, lf)

# a bare character is no quote and no carriage return, so the scan mode
# sends it to the fast step
def k3.so(
  +st: T.St,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{T.read.fast(st, Chr{xx})} == T.doc.scan(st, Chr{xx}) : T.Mode}:
  Equal.sym(T.Mode, T.doc.scan(st, Chr{xx}), T.MScan{T.read.fast(st, Chr{xx})},
    scan.other(Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), U32.is_eq(xx, 13), st, Chr{xx}, {==}, {==}, {==},
      ch => T.bare.at(ch), ee, {==}, {==}, {==}))

# a character that is no blank and no newline takes the full step
def k3.ws(
  sp: Bool,
  nl: Bool,
  keep: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +buf: List<&2, Char>,
  +lex: T.Lex,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char,
  hs0: {sp == False{} : Bool},
  hn: {nl == False{} : Bool}
) -> {T.read.fast.old("", rw, hs, he, ps, buf, lex, bk, qk, sk, un, lf, ab, cc)
  == T.read.fast.ws(sp, nl, keep, "", rw, hs, he, ps, buf, lex, bk, qk, sk, un, lf, ab, cc) : T.St}:
  match sp nl:
    case False{} False{}:
      {==}
    case True{} n2:
      Eq.bit.absurd2(&2, {T.read.fast.old("", rw, hs, he, ps, buf, lex, bk, qk, sk, un, lf, ab, cc)
        == T.read.fast.ws(True{}, n2, keep, "", rw, hs, he, ps, buf, lex, bk, qk, sk, un, lf, ab, cc) : T.St}, hs0)
    case False{} True{}:
      Eq.bit.absurd2(&2, {T.read.fast.old("", rw, hs, he, ps, buf, lex, bk, qk, sk, un, lf, ab, cc)
        == T.read.fast.ws(False{}, True{}, keep, "", rw, hs, he, ps, buf, lex, bk, qk, sk, un, lf, ab, cc) : T.St}, hn)

# a bare character starts an inline table's key: the last of the tests
def k3.kbare(
  ok: Bool,
  st: T.St,
  +xx: U32,
  eok: {T.bare.at(Chr{xx}) == ok : Bool},
  ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.lex.key.bare(ok, st, Chr{xx}) == T.st.push(st, Chr{xx}, T.LKey{}) : T.St}:
  match ok:
    case True{}:
      {==}
    case False{}:
      clash(&2, {T.lex.key.bare(False{}, st, Chr{xx}) == T.st.push(st, Chr{xx}, T.LKey{}) : T.St},
        Equal.trans(Bool, False{}, T.bare.at(Chr{xx}), True{}, Equal.sym(Bool, T.bare.at(Chr{xx}), False{}, eok), ee))

# no apostrophe
def k3.klit(
  lit: Bool,
  st: T.St,
  +xx: U32,
  elit: {Char.is_eq(Chr{xx}, '\'') == lit : Bool},
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.lex.key.lit(lit, st, Chr{xx}) == T.st.push(st, Chr{xx}, T.LKey{}) : T.St}:
  match lit:
    case True{}:
      Eq.bit.gone(&2, {T.lex.key.lit(True{}, st, Chr{xx}) == T.st.push(st, Chr{xx}, T.LKey{}) : T.St},
        Eq.refute_char(Chr{xx}, '\'', ch => T.bare.at(ch), elit, ee, {==}))
    case False{}:
      k3.kbare(T.bare.at(Chr{xx}), st, xx, {==}, ee)

# no quotation mark
def k3.kq(
  qq: Bool,
  st: T.St,
  +xx: U32,
  eqq: {Char.is_eq(Chr{xx}, '"') == qq : Bool},
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.lex.key.q(qq, st, Chr{xx}) == T.st.push(st, Chr{xx}, T.LKey{}) : T.St}:
  match qq:
    case True{}:
      Eq.bit.gone(&2, {T.lex.key.q(True{}, st, Chr{xx}) == T.st.push(st, Chr{xx}, T.LKey{}) : T.St},
        Eq.refute_char(Chr{xx}, '"', ch => T.bare.at(ch), eqq, ee, {==}))
    case False{}:
      k3.klit(Char.is_eq(Chr{xx}, '\''), st, xx, {==}, ee)

# in an inline table a bare character is no blank, no comment, no `}` and no
# newline, so it starts a key
def k3.inl.go(
  sp: Bool,
  hash: Bool,
  end: Bool,
  nl: Bool,
  st: T.St,
  +xx: U32,
  esp: {T.ch.sp(Chr{xx}) == sp : Bool},
  ehash: {Char.is_eq(Chr{xx}, '#') == hash : Bool},
  eend: {Char.is_eq(Chr{xx}, '}') == end : Bool},
  enl: {T.ch.nl(Chr{xx}) == nl : Bool},
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.lex.inl.go(sp, hash, end, nl, st, Chr{xx}) == T.st.push(T.lex.key.clear(st), Chr{xx}, T.LKey{}) : T.St}:
  match sp:
    case True{}:
      Eq.bit.gone(&2, {T.lex.inl.go(True{}, hash, end, nl, st, Chr{xx}) == T.st.push(T.lex.key.clear(st), Chr{xx},
        T.LKey{}) : T.St}, or2.no(xx, 32, 9, U32.is_eq(xx, 32), U32.is_eq(xx, 9), {==}, {==}, esp,
        ch => T.bare.at(ch), ee, {==}, {==}))
    case False{}:
      match hash:
        case True{}:
          Eq.bit.gone(&2, {T.lex.inl.go(False{}, True{}, end, nl, st, Chr{xx}) == T.st.push(T.lex.key.clear(st),
            Chr{xx}, T.LKey{}) : T.St}, Eq.refute_char(Chr{xx}, '#', ch => T.bare.at(ch), ehash, ee, {==}))
        case False{}:
          match end:
            case True{}:
              Eq.bit.gone(&2, {T.lex.inl.go(False{}, False{}, True{}, nl, st, Chr{xx})
                == T.st.push(T.lex.key.clear(st), Chr{xx}, T.LKey{}) : T.St},
                Eq.refute_char(Chr{xx}, '}', ch => T.bare.at(ch), eend, ee, {==}))
            case False{}:
              match nl:
                case True{}:
                  Eq.bit.gone(&2, {T.lex.inl.go(False{}, False{}, False{}, True{}, st, Chr{xx})
                    == T.st.push(T.lex.key.clear(st), Chr{xx}, T.LKey{}) : T.St},
                    or2.no(xx, 10, 13, U32.is_eq(xx, 10), U32.is_eq(xx, 13), {==}, {==}, enl, ch => T.bare.at(ch),
                      ee, {==}, {==}))
                case False{}:
                  k3.kq(Char.is_eq(Chr{xx}, '"'), T.lex.key.clear(st), xx, {==}, ee)

# and after a comma in one: no blank, no comment and no newline
def k3.inlk.go(
  sp: Bool,
  hash: Bool,
  nl: Bool,
  st: T.St,
  +xx: U32,
  esp: {T.ch.sp(Chr{xx}) == sp : Bool},
  ehash: {Char.is_eq(Chr{xx}, '#') == hash : Bool},
  enl: {T.ch.nl(Chr{xx}) == nl : Bool},
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.lex.inlk.go(sp, hash, nl, st, Chr{xx}) == T.st.push(T.lex.key.clear(st), Chr{xx}, T.LKey{}) : T.St}:
  match sp:
    case True{}:
      Eq.bit.gone(&2, {T.lex.inlk.go(True{}, hash, nl, st, Chr{xx}) == T.st.push(T.lex.key.clear(st), Chr{xx},
        T.LKey{}) : T.St}, or2.no(xx, 32, 9, U32.is_eq(xx, 32), U32.is_eq(xx, 9), {==}, {==}, esp,
        ch => T.bare.at(ch), ee, {==}, {==}))
    case False{}:
      match hash:
        case True{}:
          Eq.bit.gone(&2, {T.lex.inlk.go(False{}, True{}, nl, st, Chr{xx}) == T.st.push(T.lex.key.clear(st),
            Chr{xx}, T.LKey{}) : T.St}, Eq.refute_char(Chr{xx}, '#', ch => T.bare.at(ch), ehash, ee, {==}))
        case False{}:
          match nl:
            case True{}:
              Eq.bit.gone(&2, {T.lex.inlk.go(False{}, False{}, True{}, st, Chr{xx})
                == T.st.push(T.lex.key.clear(st), Chr{xx}, T.LKey{}) : T.St},
                or2.no(xx, 10, 13, U32.is_eq(xx, 10), U32.is_eq(xx, 13), {==}, {==}, enl, ch => T.bare.at(ch),
                  ee, {==}, {==}))
            case False{}:
              k3.kq(Char.is_eq(Chr{xx}, '"'), T.lex.key.clear(st), xx, {==}, ee)

# the first character of a bare segment after a dot starts its buffer
def k3.b1.dot(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{k3.w(rw, hs, he, ps, [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.doc.scan(k3.w(rw, hs, he, ps,
  [], T.LKeyDot{}, bk, qk, sk, un, lf, ab), Chr{xx}) : T.Mode}:
  %k3.so(k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk, sk, un, lf, ab), xx, ee) : {T.MScan{k3.w(rw, hs, he, ps,
    [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == _ : T.Mode}
  Equal.cong(T.St, T.Mode, st => T.MScan{T.read.once2(st)}, T.st.push(k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk,
    sk, un, lf, ab), Chr{xx}, T.LKey{}),
    T.lex.kdot.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), Char.is_eq(Chr{xx}, '.'),
      T.ch.nl(Chr{xx}), k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk, sk, un, lf, ab), Chr{xx}),
    Equal.sym(T.St, T.lex.kdot.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''),
      Char.is_eq(Chr{xx}, '.'), T.ch.nl(Chr{xx}), k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk, sk, un, lf, ab),
        Chr{xx}), T.st.push(k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk, sk, un, lf, ab), Chr{xx}, T.LKey{}),
      kd.bare(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), Char.is_eq(Chr{xx}, '.'),
        T.ch.nl(Chr{xx}), k3.w(rw, hs, he, ps, [], T.LKeyDot{}, bk, qk, sk, un, lf, ab), xx, {==}, {==}, {==}, ee)))

# at the start of a line, the first character of a bare key starts its
# buffer
def k3.b1.top(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{k3.w(rw, hs, he, [], [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.doc.scan(k3.w(rw, hs, he, [],
  [], T.LTop{}, bk, qk, sk, un, lf, ab), Chr{xx}) : T.Mode}:
  %k3.so(k3.w(rw, hs, he, [], [], T.LTop{}, bk, qk, sk, un, lf, ab), xx, ee) : {T.MScan{k3.w(rw, hs, he, [],
    [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == _ : T.Mode}
  %k3.ws(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), True{}, rw, hs, he, [], [], T.LTop{}, bk, qk, sk, un, lf, ab, Chr{xx},
    kl.no2(T.ch.sp(Chr{xx}), xx, 32, 9, {==}, ee, {==}, {==}), kl.no2(T.ch.nl(Chr{xx}), xx, 10, 13, {==}, ee, {==},
    {==})) : {T.MScan{k3.w(rw, hs, he, [], [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.MScan{_} : T.Mode}
  Equal.cong(T.St, T.Mode, st => T.MScan{T.read.once2(st)}, T.st.push(k3.w(rw, hs, he, [], [], T.LTop{}, bk, qk, sk,
    un, lf, ab), Chr{xx}, T.LKey{}),
    T.lex.top.go(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), Char.is_eq(Chr{xx}, '#'), Char.is_eq(Chr{xx}, '['),
      Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), T.bare.at(Chr{xx}), k3.w(rw, hs, he, [], [], T.LTop{}, bk,
        qk, sk, un, lf, ab), Chr{xx}),
    Equal.sym(T.St, T.lex.top.go(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), Char.is_eq(Chr{xx}, '#'),
      Char.is_eq(Chr{xx}, '['), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), T.bare.at(Chr{xx}), k3.w(rw, hs,
        he, [], [], T.LTop{}, bk, qk, sk, un, lf, ab),
      Chr{xx}), T.st.push(k3.w(rw, hs, he, [], [], T.LTop{}, bk, qk, sk, un, lf, ab), Chr{xx}, T.LKey{}),
      key.top(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), Char.is_eq(Chr{xx}, '#'), Char.is_eq(Chr{xx}, '['),
        Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), T.bare.at(Chr{xx}), k3.w(rw, hs, he, [], [], T.LTop{},
          bk, qk, sk, un, lf, ab), xx, {==}, {==}, {==}, {==},
        {==}, {==}, {==}, ee)))

# after an inline table's `{`, the first character of a bare key starts its
# buffer
def k3.b1.inl(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{k3.w(rw, hs, he, [], [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.doc.scan(k3.w(rw, hs, he, [],
  [], T.LInl{}, bk, qk, sk, un, lf, ab), Chr{xx}) : T.Mode}:
  %k3.so(k3.w(rw, hs, he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab), xx, ee) : {T.MScan{k3.w(rw, hs, he, [],
    [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == _ : T.Mode}
  %k3.ws(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), False{}, rw, hs, he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab, Chr{xx},
    kl.no2(T.ch.sp(Chr{xx}), xx, 32, 9, {==}, ee, {==}, {==}), kl.no2(T.ch.nl(Chr{xx}), xx, 10, 13, {==}, ee, {==},
    {==})) : {T.MScan{k3.w(rw, hs, he, [], [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.MScan{_} : T.Mode}
  Equal.cong(T.St, T.Mode, st => T.MScan{T.read.once2(st)}, T.st.push(T.lex.key.clear(k3.w(rw, hs, he, [], [],
    T.LInl{}, bk, qk, sk, un, lf, ab)), Chr{xx}, T.LKey{}),
    T.lex.inl.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '#'), Char.is_eq(Chr{xx}, '}'), T.ch.nl(Chr{xx}), k3.w(rw, hs,
      he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab),
      Chr{xx}),
    Equal.sym(T.St, T.lex.inl.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '#'), Char.is_eq(Chr{xx}, '}'),
      T.ch.nl(Chr{xx}), k3.w(rw, hs, he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab), Chr{xx}),
        T.st.push(T.lex.key.clear(k3.w(rw, hs, he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab)), Chr{xx}, T.LKey{}),
      k3.inl.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '#'), Char.is_eq(Chr{xx}, '}'), T.ch.nl(Chr{xx}), k3.w(rw, hs,
        he, [], [], T.LInl{}, bk, qk, sk, un, lf, ab), xx,
        {==}, {==}, {==}, {==}, ee)))

# and after a comma in one
def k3.b1.inlk(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{k3.w(rw, hs, he, [], [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.doc.scan(k3.w(rw, hs, he, [],
  [], T.LInlK{}, bk, qk, sk, un, lf, ab), Chr{xx}) : T.Mode}:
  %k3.so(k3.w(rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, un, lf, ab), xx, ee) : {T.MScan{k3.w(rw, hs, he, [],
    [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == _ : T.Mode}
  %k3.ws(T.ch.sp(Chr{xx}), T.ch.nl(Chr{xx}), False{}, rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, un, lf, ab, Chr{xx},
    kl.no2(T.ch.sp(Chr{xx}), xx, 32, 9, {==}, ee, {==}, {==}), kl.no2(T.ch.nl(Chr{xx}), xx, 10, 13, {==}, ee, {==},
    {==})) : {T.MScan{k3.w(rw, hs, he, [], [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.MScan{_} : T.Mode}
  Equal.cong(T.St, T.Mode, st => T.MScan{T.read.once2(st)}, T.st.push(T.lex.key.clear(k3.w(rw, hs, he, [], [],
    T.LInlK{}, bk, qk, sk, un, lf, ab)), Chr{xx}, T.LKey{}),
    T.lex.inlk.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '#'), T.ch.nl(Chr{xx}), k3.w(rw, hs, he, [], [], T.LInlK{},
      bk, qk, sk, un, lf, ab), Chr{xx}),
    Equal.sym(T.St, T.lex.inlk.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '#'), T.ch.nl(Chr{xx}), k3.w(rw, hs, he, [],
      [], T.LInlK{}, bk, qk, sk, un, lf, ab), Chr{xx}),
      T.st.push(T.lex.key.clear(k3.w(rw, hs, he, [], [], T.LInlK{}, bk, qk, sk, un, lf, ab)), Chr{xx}, T.LKey{}),
      k3.inlk.go(T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '#'), T.ch.nl(Chr{xx}), k3.w(rw, hs, he, [], [], T.LInlK{}, bk,
        qk, sk, un, lf, ab), xx, {==}, {==}, {==}, ee)))

# the first character of a bare segment starts its buffer, wherever the
# segment starts
def k3.b1(
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [Chr{xx}], T.LKey{}, bk, qk, sk, un, lf, ab)} == T.doc.scan(k3.w(rw,
  hs, he, k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab), Chr{xx}) : T.Mode}:
  match dt:
    case True{}:
      k3.b1.dot(rw, hs, he, ps, bk, qk, sk, un, lf, ab, xx, ee)
    case False{}:
      match at:
        case Laws.AtLine{}:
          k3.b1.top(rw, hs, he, bk, qk, sk, un, lf, ab, xx, ee)
        case Laws.AtInl{}:
          k3.b1.inl(rw, hs, he, bk, qk, sk, un, lf, ab, xx, ee)
        case Laws.AtInlK{}:
          k3.b1.inlk(rw, hs, he, bk, qk, sk, un, lf, ab, xx, ee)

# a later bare character stays on the key's fast path
def k3.kfast(
  ok: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +buf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  eok: {T.bare.at(Chr{xx}) == ok : Bool},
  ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {k3.w(rw, hs, he, ps, Chr{xx} <> buf, T.LKey{}, bk, qk, sk, un, lf, ab) == T.read.fast.key(ok, "", rw, hs, he,
  ps, buf, bk, qk, sk, un, lf, ab, Chr{xx}) : T.St}:
  match ok:
    case True{}:
      {==}
    case False{}:
      clash(&2, {k3.w(rw, hs, he, ps, Chr{xx} <> buf, T.LKey{}, bk, qk, sk, un, lf, ab) == T.read.fast.key(False{},
        "", rw, hs, he, ps, buf, bk, qk, sk, un, lf, ab, Chr{xx}) : T.St},
        Equal.trans(Bool, False{}, T.bare.at(Chr{xx}), True{}, Equal.sym(Bool, T.bare.at(Chr{xx}), False{}, eok), ee))

# the rest of a bare segment is pushed onto its buffer, whatever follows it
def k3.bbody(
  ks: String,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +buf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +ee: {T.bare.all(String.to_list(ks)) == True{} : Bool}
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, rev.onto(ks, buf), T.LKey{}, bk, qk, sk, un, lf,
  ab)}) == T.doc.read(String.append(ks, rr), T.MScan{k3.w(rw, hs, he, ps, buf, T.LKey{}, bk, qk, sk, un, lf,
    ab)}) : T.Doc}:
  match ks:
    case SNil{}:
      {==}
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          %k3.so(k3.w(rw, hs, he, ps, buf, T.LKey{}, bk, qk, sk, un, lf, ab), xx, ball.head(T.bare.at(Chr{xx}),
            String.to_list(tt), ee)) : {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, rev.onto(tt, Chr{xx} <> buf),
              T.LKey{}, bk, qk, sk, un, lf, ab)})
            == T.doc.read(String.append(tt, rr), _) : T.Doc}
          %k3.kfast(T.bare.at(Chr{xx}), rw, hs, he, ps, buf, bk, qk, sk, un, lf, ab, xx, {==},
            ball.head(T.bare.at(Chr{xx}),
            String.to_list(tt), ee)) : {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, rev.onto(tt, Chr{xx} <> buf),
              T.LKey{}, bk, qk, sk, un, lf, ab)}) == T.doc.read(String.append(tt, rr), T.MScan{_})
            : T.Doc}
          k3.bbody(tt, rr, rw, hs, he, ps, Chr{xx} <> buf, bk, qk, sk, un, lf, ab, ball.tail(T.bare.at(Chr{xx}),
            String.to_list(tt), ee))

# a blank ends an open bare segment: it is pushed, and the scanner waits in
# LAfter
def k3.bsp(
  +tab: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rr: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps, [], T.LAfter{}, bk, qk, sk, un, lf,
  ab)}) == T.doc.read(SCon{Laws.blank_char(tab), rr}, T.MScan{k3.w(rw, hs, he, ps, bf, T.LKey{}, bk, qk, sk, un, lf,
    ab)}) : T.Doc}:
  match tab:
    case True{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rr, T.MScan{k3.w(rw, hs, he,
        T.buf.str(bf) <> ps, [], T.LAfter{}, bk, qk, sk, un, lf,
        ab)}) == T.doc.read(rr, T.MScan{T.read.once2(T.lex.key.end.go(_, k3.w(rw, hs, he, ps, bf, T.LKey{}, bk, qk,
          sk, un, lf, ab),
        T.LAfter{}))}) : T.Doc}
      {==}
    case False{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rr, T.MScan{k3.w(rw, hs, he,
        T.buf.str(bf) <> ps, [], T.LAfter{}, bk, qk, sk, un, lf,
        ab)}) == T.doc.read(rr, T.MScan{T.read.once2(T.lex.key.end.go(_, k3.w(rw, hs, he, ps, bf, T.LKey{}, bk, qk,
          sk, un, lf, ab),
        T.LAfter{}))}) : T.Doc}
      {==}

# a dot or `=` right after an open bare segment pushes it
def k3.bdl(
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(rest, T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps, [], k3.aft(cl), bk, qk, sk, un, lf,
  ab)}) == T.doc.read(SCon{k3.dl(cl), rest}, T.MScan{k3.w(rw, hs, he, ps, bf, T.LKey{}, bk, qk, sk, un, lf,
    ab)}) : T.Doc}:
  match cl:
    case False{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rest, T.MScan{k3.w(rw, hs, he,
        T.buf.str(bf) <> ps, [], T.LKeyDot{}, bk, qk, sk, un, lf,
        ab)}) == T.doc.read(rest, T.MScan{T.read.once2(T.lex.key.end.go(_, k3.w(rw, hs, he, ps, bf, T.LKey{}, bk, qk,
          sk, un, lf, ab),
        T.LKeyDot{}))}) : T.Doc}
      {==}
    case True{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rest, T.MScan{k3.w(rw, hs, he,
        T.buf.str(bf) <> ps, [], T.LVal{}, bk, qk, sk, un, lf,
        ab)}) == T.doc.read(rest, T.MScan{T.read.once2(T.lex.key.end.go(_, k3.w(rw, hs, he, ps, bf, T.LKey{}, bk, qk,
          sk, un, lf, ab),
        T.LVal{}))}) : T.Doc}
      {==}

# blank space and a dot or `=` after an open bare segment push it
def k3.bend(
  gs: List<&2, Bool>,
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(rest, T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps, [], k3.aft(cl), bk, qk, sk, un, lf,
  ab)}) == T.doc.read(String.append(Laws.gap(gs), SCon{k3.dl(cl), rest}), T.MScan{k3.w(rw, hs, he, ps, bf, T.LKey{},
    bk, qk, sk, un, lf, ab)})
  : T.Doc}:
  match gs:
    case []:
      k3.bdl(cl, rw, hs, he, ps, bf, bk, qk, sk, un, lf, ab, rest, full)
    case +tab <> +gr:
      %k3.bsp(tab, rw, hs, he, ps, bf, bk, qk, sk, un, lf, ab, String.append(Laws.gap(gr), SCon{k3.dl(cl), rest}),
        full) : {T.doc.read(rest, T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps, [], k3.aft(cl), bk, qk, sk, un, lf,
          ab)}) == _ : T.Doc}
      %k3.agap(gr, SCon{k3.dl(cl), rest}, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, sk, un, lf, ab)
        : {T.doc.read(rest, T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps, [], k3.aft(cl), bk, qk, sk, un, lf,
          ab)}) == _ : T.Doc}
      k3.adl(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, sk, un, lf, ab, rest)

# a bare segment, its blank space and a dot or `=`: the rest is read with the
# segment pushed, and back, qkind, uni and left as they were
def k3.bseg(
  +xx: U32,
  +tt: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  +ee: {T.bare.all.step(T.bare.at(Chr{xx}), _u => T.bare.all(String.to_list(tt))) == True{} : Bool},
  ih: k3.KT(cl, rw, hs, he, SCon{Chr{xx}, tt} <> k3.ps0(dt, ps), sk, ab, rest, goal)
) -> {T.doc.read(String.append(SCon{Chr{xx}, tt}, String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})),
  T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab)}) == goal : T.Doc}:
  %k3.b1(dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab, xx, ball.head(T.bare.at(Chr{xx}), String.to_list(tt), ee))
    : {T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})), _) == goal : T.Doc}
  %k3.bbody(tt, String.append(Laws.gap(gs), SCon{k3.dl(cl), rest}), rw, hs, he, k3.ps0(dt, ps), [Chr{xx}], bk, qk, sk,
    un, lf, ab, ball.tail(T.bare.at(Chr{xx}),
    String.to_list(tt), ee)) : {_ == goal : T.Doc}
  %k3.bend(gs, cl, rw, hs, he, k3.ps0(dt, ps), rev.onto(tt, [Chr{xx}]), bk, qk, sk, un, lf, ab, rest, rev.full(tt,
    Chr{xx},
    [])) : {_ == goal : T.Doc}
  %Equal.sym(String, T.buf.str(rev.onto(tt, [Chr{xx}])), SCon{Chr{xx}, tt}, wh.bname(xx, tt)) : {T.doc.read(rest,
    T.MScan{k3.w(rw, hs, he, _ <> k3.ps0(dt, ps), [], k3.aft(cl), bk, qk, sk, un, lf, ab)}) == goal : T.Doc}
  ih(bk, qk, un, lf)

# a quotation mark where a segment starts opens a basic segment
def k3.qopen(
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.MScan{k3.q(False{}, rw, hs, he, k3.ps0(dt, ps), sk, ab, bk, un, lf, [])} == T.doc.scan(k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab), '"') : T.Mode}:
  match dt:
    case True{}:
      {==}
    case False{}:
      match at:
        case Laws.AtLine{}:
          {==}
        case Laws.AtInl{}:
          {==}
        case Laws.AtInlK{}:
          {==}

# and an apostrophe a literal one
def k3.lopen(
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.MScan{k3.l(False{}, rw, hs, he, k3.ps0(dt, ps), sk, ab, bk, un, lf, [])} == T.doc.scan(k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab), '\'') : T.Mode}:
  match dt:
    case True{}:
      {==}
    case False{}:
      match at:
        case Laws.AtLine{}:
          {==}
        case Laws.AtInl{}:
          {==}
        case Laws.AtInlK{}:
          {==}

# a basic segment of pieces, its blank space and a dot or `=`: the rest is
# read with the segment pushed under the characters the pieces stand for,
# from wherever the last piece left back, uni and left
def k3.qseg(
  +pl: List<&2, Laws.KPiece>,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.k3.pcs.ok(pl) == True{} : Bool},
  ih: k3.KT(cl, rw, hs, he, Laws.k3.pcs.name(pl) <> k3.ps0(dt, ps), sk, ab, rest, goal)
) -> {T.doc.read(SCon{'"', Laws.k3.pcs.text(pl, SCon{'"', String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})})},
  T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab)}) == goal : T.Doc}:
  %k3.qopen(dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab) : {T.doc.read(Laws.k3.pcs.text(pl, SCon{'"',
    String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})}),
    _) == goal : T.Doc}
  k3.pcs(pl, False{}, rw, hs, he, k3.ps0(dt, ps), sk, ab, bk, un, lf, [], SCon{'"', String.append(Laws.gap(gs),
    SCon{k3.dl(cl), rest})}, goal, eo, +b2 => +u2 => +l2 =>
    k3.fin(Laws.k3.pcs.name(pl), rev.onto(Laws.k3.pcs.name(pl), []), k3.nm(Laws.k3.pcs.name(pl)), gs, cl, rw, hs, he,
      k3.ps0(dt, ps), b2, T.QBasic{}, sk, u2, l2, ab, rest, goal, ih))

# a literal segment, its blank space and a dot or `=`: the rest is read with
# the segment pushed under its characters, and back, uni and left as they
# were
def k3.lseg(
  +name: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  el: {Laws.lit.text(name) == True{} : Bool},
  ih: k3.KT(cl, rw, hs, he, name <> k3.ps0(dt, ps), sk, ab, rest, goal)
) -> {T.doc.read(SCon{'\'', String.append(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})})},
  T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab)}) == goal : T.Doc}:
  %k3.lopen(dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab) : {T.doc.read(String.append(name, SCon{'\'',
    String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})}), _)
    == goal : T.Doc}
  Equal.trans(T.Doc, T.doc.read(String.append(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})}),
    T.MScan{k3.l(False{}, rw, hs, he, k3.ps0(dt, ps),
    sk, ab, bk, un, lf, [])}), T.doc.read(SCon{'\'', String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})},
      T.MScan{k3.l(False{}, rw, hs, he, k3.ps0(dt, ps), sk, ab, bk,
    un, lf, rev.onto(name, []))}), goal,
    k3.l.body(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})}, False{}, rw, hs, he, k3.ps0(dt,
      ps), sk, ab, bk, un, lf, [], el),
    k3.fin(name, rev.onto(name, []), k3.nm(name), gs, cl, rw, hs, he, k3.ps0(dt, ps), bk, T.QLit{}, sk, un, lf, ab,
      rest, goal,
      ih))

# a segment spelled any way toml.abnf allows, its blank space and a dot or
# `=`
def k3.seg(
  sg: Laws.KSeg,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.k3.seg.ok(sg) == True{} : Bool},
  ih: k3.KT(cl, rw, hs, he, Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), sk, ab, rest, goal)
) -> {T.doc.read(Laws.k3.seg.text(sg, String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})), T.MScan{k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab)}) == goal : T.Doc}:
  match sg:
    case Laws.KsBare{name}:
      match name:
        case SNil{}:
          Eq.bit.absurd(&2, {T.doc.read(String.append(SNil{}, String.append(Laws.gap(gs), SCon{k3.dl(cl), rest})),
            T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab)}) == goal : T.Doc},
              eo)
        case SCon{hh, +tt}:
          match hh:
            case Chr{+xx}:
              k3.bseg(xx, tt, gs, cl, dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, goal, eo, ih)
    case Laws.KsBasic{+pl}:
      k3.qseg(pl, gs, cl, dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, goal, eo, ih)
    case Laws.KsLit{+name}:
      k3.lseg(name, gs, cl, dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, goal, eo, ih)

# the key's segments pushed onto the parts before them, newest first
def k3.acc(ds: List<&2, Laws.KDot>, last: Laws.KSeg, dt: Bool, ps: List<&2, String>) -> List<&2, String>:
  List.reverse.go(&2, String, Laws.k3.dk.names(ds, last), k3.ps0(dt, ps))

# a dotted key's segments, then blank space and `=`: the rest is read with
# every segment pushed onto parts, newest first
def k3.keys(
  ds: List<&2, Laws.KDot>,
  +last: Laws.KSeg,
  +g: List<&2, Bool>,
  +dt: Bool,
  +at: Laws.KPos,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  +eo: {Laws.k3.dk.ok(ds, last) == True{} : Bool},
  ih: k3.KT(True{}, rw, hs, he, k3.acc(ds, last, dt, ps), sk, ab, rest, goal)
) -> {T.doc.read(Laws.k3.dk.text(ds, last, String.append(Laws.gap(g), SCon{'=', rest})), T.MScan{k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.lex0(dt, at), bk, qk, sk, un, lf, ab)}) == goal
  : T.Doc}:
  match ds:
    case []:
      k3.seg(last, g, True{}, dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, goal, eo, ih)
    case Laws.KDot{+sg, g1, +g2} <> +dr:
      k3.seg(sg, g1, False{}, dt, at, rw, hs, he, ps, bk, qk, sk, un, lf, ab, String.append(Laws.gap(g2),
        Laws.k3.dk.text(dr, last, String.append(Laws.gap(g), SCon{'=', rest}))), goal, Eq.and.left(Laws.k3.seg.ok(sg),
        Laws.k3.dk.ok(dr, last), eo), +b2 => +q2 => +u2 => +l2 =>
        %k3.dgap(g2, Laws.k3.dk.text(dr, last, String.append(Laws.gap(g), SCon{'=', rest})), rw, hs, he,
          Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), b2, q2, sk, u2, l2, ab) : {_ == goal : T.Doc}
        k3.keys(dr, last, g, True{}, at, rw, hs, he, Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), b2, q2, sk, u2, l2, ab,
          rest, goal,
          Eq.and.right(Laws.k3.seg.ok(sg), Laws.k3.dk.ok(dr, last), eo), ih))

def Laws.key_reads_back_anywhere(
  at,
  g0,
  ds,
  last,
  ok,
  g,
  rows,
  heads,
  here,
  stack,
  arrtab,
  back,
  qkind,
  uni,
  left,
  rest,
  goal,
  ih
):
  %k3.g0(g0, at, rows, heads, here, stack, arrtab, back, qkind, uni, left, Laws.k3.dk.text(ds, last,
    String.append(Laws.gap(g), SCon{'=', rest}))) : {_ == goal : T.Doc}
  k3.keys(ds, last, g, False{}, at, rows, heads, here, [], back, qkind, stack, uni, left, arrtab, rest, goal, ok, ih)

# KEY-3: a header read with every spelling of its segments, from any uni and
# left. After `[` (and a second `[` for an array of tables) the header waits
# in LHead; blank space there moves it to LHeadDot, as after a dot. A bare
# segment is pushed in LHead and ended by a blank (to LHeadGap), a dot or the
# bracket; a basic one is read by k3.pcs and a literal one by k3.l at hd =
# True, each closing into LHeadGap, where blank space stays until a dot or
# the bracket. The bracket runs the header's walk, as WP-H's wh.fin does.

# where a header segment starts: right after the bracket, or after blank
# space or a dot
def k3.hlex0(dt: Bool) -> T.Lex:
  match dt:
    case False{}:
      T.LHead{}
    case True{}:
      T.LHeadDot{}

# what ends a header segment: a dot, or the closing bracket
def k3.hdl(cl: Bool) -> Char:
  match cl:
    case False{}:
      '.'
    case True{}:
      ']'

# the scanner after a header segment and what follows it: waiting for the
# next segment after a dot, or closed after the bracket
def k3.haft(
  cl: Bool,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  bk: T.Lex,
  qk: T.QKind,
  un: U32,
  lf: U32,
  +ab: Bool
) -> T.St:
  match cl:
    case False{}:
      k3.w(rw, hs, he, ps, [], T.LHeadDot{}, bk, qk, [], un, lf, ab)
    case True{}:
      T.read.once2(T.lex.head.close2(ab, k3.w(rw, hs, he, ps, [], T.LHeadGap{}, bk, qk, [], un, lf, ab)))

# the rest of the text after a header segment, read from every back, qkind,
# uni and left
def k3.HT(
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc
) -> Type:
  @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    {T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, ps, b2, q2, u2, l2, ab)}) == goal : T.Doc}

# blank space after a dot, or right after the bracket once one blank is
# read, stays in LHeadDot
def k3.hdgap(
  gs: List<&2, Bool>,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, [], T.LHeadDot{}, bk, qk, [], un, lf,
  ab)}) == T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{k3.w(rw, hs, he, ps, [], T.LHeadDot{}, bk, qk, [], un,
    lf, ab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          k3.hdgap(rest, rr, rw, hs, he, ps, bk, qk, un, lf, ab)
        case False{}:
          k3.hdgap(rest, rr, rw, hs, he, ps, bk, qk, un, lf, ab)

# and after a segment in LHeadGap
def k3.hgap(
  gs: List<&2, Bool>,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, [], T.LHeadGap{}, bk, qk, [], un, lf,
  ab)}) == T.doc.read(String.append(Laws.gap(gs), rr), T.MScan{k3.w(rw, hs, he, ps, [], T.LHeadGap{}, bk, qk, [], un,
    lf, ab)}) : T.Doc}:
  match gs:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          k3.hgap(rest, rr, rw, hs, he, ps, bk, qk, un, lf, ab)
        case False{}:
          k3.hgap(rest, rr, rw, hs, he, ps, bk, qk, un, lf, ab)

# whether there is any blank space
def k3.nz(gs: List<&2, Bool>) -> Bool:
  match gs:
    case []:
      False{}
    case _t <> _r:
      True{}

# blank space right after the bracket waits for the first segment in
# LHeadDot
def k3.hlead(
  g0: List<&2, Bool>,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, k3.ps0(k3.nz(g0), []), [], k3.hlex0(k3.nz(g0)), bk, qk, [], un, lf,
  ab)}) == T.doc.read(String.append(Laws.gap(g0), rr), T.MScan{k3.w(rw, hs, he, [], [], T.LHead{}, bk, qk, [], un, lf,
    ab)}) : T.Doc}:
  match g0:
    case []:
      {==}
    case tab <> rest:
      match tab:
        case True{}:
          k3.hdgap(rest, rr, rw, hs, he, [], bk, qk, un, lf, ab)
        case False{}:
          k3.hdgap(rest, rr, rw, hs, he, [], bk, qk, un, lf, ab)

# a dot or the bracket after a segment's blank space
def k3.hgdl(
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String
) -> {T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, ps, bk, qk, un, lf, ab)}) == T.doc.read(SCon{k3.hdl(cl), rest},
  T.MScan{k3.w(rw, hs, he, ps, [], T.LHeadGap{}, bk, qk, [], un, lf, ab)}) : T.Doc}:
  match cl:
    case False{}:
      {==}
    case True{}:
      {==}

# a header segment's name pushed onto parts, then blank space and a dot or
# the bracket: the rest is read from there
def k3.hfin(
  +nm: String,
  +bf: List<&2, Char>,
  en: {nm == T.buf.str(bf) : String},
  +gs: List<&2, Bool>,
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  ih: k3.HT(cl, rw, hs, he, nm <> ps, ab, rest, goal)
) -> {T.doc.read(String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest}), T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps,
  [], T.LHeadGap{}, bk, qk, [], un, lf, ab)}) == goal : T.Doc}:
  %k3.hgap(gs, SCon{k3.hdl(cl), rest}, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab) : {_ == goal : T.Doc}
  %k3.hgdl(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab, rest) : {_ == goal : T.Doc}
  %en : {T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, _ <> ps, bk, qk, un, lf, ab)}) == goal : T.Doc}
  ih(bk, qk, un, lf)

# the first character of a bare header segment starts its buffer
def k3.hb1(
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [Chr{xx}], T.LHead{}, bk, qk, [], un, lf, ab)} == T.doc.scan(k3.w(rw,
  hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab), Chr{xx}) : T.Mode}:
  match dt:
    case False{}:
      %k3.so(k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab), xx, ee) : {T.MScan{k3.w(rw, hs,
        he, k3.ps0(dt, ps), [Chr{xx}], T.LHead{}, bk, qk, [], un, lf, ab)} == _ : T.Mode}
      Equal.cong(T.St, T.Mode, st => T.MScan{T.read.once2(st)}, T.lex.head.ch(k3.w(rw, hs, he, [], [], T.LHead{}, bk,
        qk, [], un, lf, ab), Chr{xx}), T.lex.head.go(Char.is_eq(Chr{xx}, '['), T.bare.at(Chr{xx}), T.ch.sp(Chr{xx}),
          Char.is_eq(Chr{xx}, '.'), Char.is_eq(Chr{xx}, ']'), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''),
            Char.is_eq(Chr{xx}, '#'), k3.w(rw, hs, he, [], [], T.LHead{}, bk, qk, [], un, lf, ab), Chr{xx}),
        Equal.sym(T.St, T.lex.head.go(Char.is_eq(Chr{xx}, '['), T.bare.at(Chr{xx}), T.ch.sp(Chr{xx}),
          Char.is_eq(Chr{xx}, '.'), Char.is_eq(Chr{xx}, ']'), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''),
            Char.is_eq(Chr{xx}, '#'), k3.w(rw, hs, he, [], [], T.LHead{}, bk, qk, [], un, lf, ab), Chr{xx}),
              T.lex.head.ch(k3.w(rw, hs, he, [], [], T.LHead{}, bk, qk, [], un, lf, ab), Chr{xx}),
                wh.go.bare(Char.is_eq(Chr{xx}, '['), T.bare.at(Chr{xx}), T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '.'),
                  Char.is_eq(Chr{xx}, ']'), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), Char.is_eq(Chr{xx},
                    '#'), k3.w(rw, hs, he, [], [], T.LHead{}, bk, qk, [], un, lf, ab), xx, {==}, {==}, ee)))
    case True{}:
      %k3.so(k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab), xx, ee) : {T.MScan{k3.w(rw, hs,
        he, k3.ps0(dt, ps), [Chr{xx}], T.LHead{}, bk, qk, [], un, lf, ab)} == _ : T.Mode}
      Equal.cong(T.St, T.Mode, st => T.MScan{T.read.once2(st)}, T.st.push(k3.w(rw, hs, he, ps, [], T.LHeadDot{}, bk,
        qk, [], un, lf, ab), Chr{xx}, T.LHead{}), T.lex.hdot(T.ch.sp(Chr{xx}), T.bare.at(Chr{xx}), Char.is_eq(Chr{xx},
          '"'), Char.is_eq(Chr{xx}, '\''), k3.w(rw, hs, he, ps, [], T.LHeadDot{}, bk, qk, [], un, lf, ab), Chr{xx}),
        Equal.sym(T.St, T.lex.hdot(T.ch.sp(Chr{xx}), T.bare.at(Chr{xx}), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx},
          '\''), k3.w(rw, hs, he, ps, [], T.LHeadDot{}, bk, qk, [], un, lf, ab), Chr{xx}), T.st.push(k3.w(rw, hs, he,
            ps, [], T.LHeadDot{}, bk, qk, [], un, lf, ab), Chr{xx}, T.LHead{}), wh.dot.bare(T.ch.sp(Chr{xx}),
              T.bare.at(Chr{xx}), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), k3.w(rw, hs, he, ps, [],
                T.LHeadDot{}, bk, qk, [], un, lf, ab), xx, {==}, {==}, ee)))

# with a segment open, the next bare character joins it, whatever came
# before
def k3.hlater(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +dd: Char,
  +bb: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +cc: Char
) -> {k3.w(rw, hs, he, ps, cc <> dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab) == T.read.once2(T.lex.head.ch(k3.w(rw,
  hs, he, ps, dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab), cc)) : T.St}:
  match ps:
    case []:
      {==}
    case _p <> _ps:
      {==}

# a later character of a bare header segment
def k3.hb2(
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +dd: Char,
  +bb: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +xx: U32,
  +ee: {T.bare.at(Chr{xx}) == True{} : Bool}
) -> {T.MScan{k3.w(rw, hs, he, ps, Chr{xx} <> dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab)} == T.doc.scan(k3.w(rw, hs,
  he, ps, dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab), Chr{xx}) : T.Mode}:
  %k3.so(k3.w(rw, hs, he, ps, dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab), xx, ee) : {T.MScan{k3.w(rw, hs, he, ps,
    Chr{xx} <> dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab)} == _ : T.Mode}
  %Equal.sym(T.St, T.lex.head.go(Char.is_eq(Chr{xx}, '['), T.bare.at(Chr{xx}), T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx},
    '.'), Char.is_eq(Chr{xx}, ']'), Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), Char.is_eq(Chr{xx}, '#'),
      k3.w(rw, hs, he, ps, dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab), Chr{xx}), T.lex.head.ch(k3.w(rw, hs, he, ps,
        dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab), Chr{xx}), wh.go.bare(Char.is_eq(Chr{xx}, '['),
          T.bare.at(Chr{xx}), T.ch.sp(Chr{xx}), Char.is_eq(Chr{xx}, '.'), Char.is_eq(Chr{xx}, ']'),
            Char.is_eq(Chr{xx}, '"'), Char.is_eq(Chr{xx}, '\''), Char.is_eq(Chr{xx}, '#'), k3.w(rw, hs, he, ps,
              dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab), xx, {==}, {==}, ee)) : {T.MScan{k3.w(rw, hs, he, ps,
                Chr{xx} <> dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab)} == T.MScan{T.read.once2(_)}
    : T.Mode}
  Equal.cong(T.St, T.Mode, st => T.MScan{st}, k3.w(rw, hs, he, ps, Chr{xx} <> dd <> bb, T.LHead{}, bk, qk, [], un, lf,
    ab), T.read.once2(T.lex.head.ch(k3.w(rw, hs, he, ps, dd <> bb, T.LHead{}, bk, qk, [], un, lf, ab), Chr{xx})),
    k3.hlater(rw, hs, he, ps, dd, bb, bk, qk, un, lf, ab, Chr{xx}))

# the rest of a bare header segment is pushed onto its buffer
def k3.hbbody(
  ks: String,
  +rr: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +dd: Char,
  +bb: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +ee: {T.bare.all(String.to_list(ks)) == True{} : Bool}
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, rev.onto(ks, dd <> bb), T.LHead{}, bk, qk, [], un, lf,
  ab)}) == T.doc.read(String.append(ks, rr), T.MScan{k3.w(rw, hs, he, ps, dd <> bb, T.LHead{}, bk, qk, [], un, lf,
    ab)}) : T.Doc}:
  match ks:
    case SNil{}:
      {==}
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          %k3.hb2(rw, hs, he, ps, dd, bb, bk, qk, un, lf, ab, xx, ball.head(T.bare.at(Chr{xx}), String.to_list(tt), ee))
            : {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, ps, rev.onto(ks, dd <> bb), T.LHead{}, bk, qk, [], un, lf,
              ab)}) == T.doc.read(String.append(tt, rr), _) : T.Doc}
          k3.hbbody(tt, rr, rw, hs, he, ps, Chr{xx}, dd <> bb, bk, qk, un, lf, ab, ball.tail(T.bare.at(Chr{xx}),
            String.to_list(tt), ee))

# a blank ends an open bare header segment: it is pushed, and the header
# waits in LHeadGap
def k3.hbsp(
  +tab: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rr: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(rr, T.MScan{k3.w(rw, hs, he, T.buf.str(bf) <> ps, [], T.LHeadGap{}, bk, qk, [], un, lf,
  ab)}) == T.doc.read(SCon{Laws.blank_char(tab), rr}, T.MScan{k3.w(rw, hs, he, ps, bf, T.LHead{}, bk, qk, [], un, lf,
    ab)}) : T.Doc}:
  match tab:
    case True{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rr, T.MScan{k3.w(rw, hs, he,
        T.buf.str(bf) <> ps, [], T.LHeadGap{}, bk, qk, [], un, lf, ab)})
        == T.doc.read(rr, T.MScan{T.read.once2(T.lex.head.gap.go(_, k3.w(rw, hs, he, ps, bf, T.LHead{}, bk, qk, [],
          un, lf, ab)))}) : T.Doc}
      {==}
    case False{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rr, T.MScan{k3.w(rw, hs, he,
        T.buf.str(bf) <> ps, [], T.LHeadGap{}, bk, qk, [], un, lf, ab)})
        == T.doc.read(rr, T.MScan{T.read.once2(T.lex.head.gap.go(_, k3.w(rw, hs, he, ps, bf, T.LHead{}, bk, qk, [],
          un, lf, ab)))}) : T.Doc}
      {==}

# the bracket closes the header the same way whatever state the last
# segment ended in
def k3.hlexfree(
  +ab: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pp: String,
  +ps: List<&2, String>,
  +lx: T.Lex,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32
) -> {T.read.once2(T.lex.head.close2(ab, k3.w(rw, hs, he, pp <> ps, [], T.LHeadGap{}, bk, qk, [], un, lf,
  ab))) == T.read.once2(T.lex.head.close2(ab, k3.w(rw, hs, he, pp <> ps, [], lx, bk, qk, [], un, lf, ab))) : T.St}:
  match ab:
    case False{}:
      {==}
    case True{}:
      {==}

# a dot or the bracket ends an open bare header segment and pushes it
def k3.hbdl(
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab)})
  == T.doc.read(SCon{k3.hdl(cl), rest}, T.MScan{k3.w(rw, hs, he, ps, bf, T.LHead{}, bk, qk, [], un, lf, ab)}) : T.Doc}:
  match cl:
    case False{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rest,
        T.MScan{k3.haft(False{}, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab)}) == T.doc.read(rest,
        T.MScan{T.read.once2(T.lex.head.dot3(_, k3.w(rw, hs, he, ps, bf, T.LHead{}, bk, qk, [], un, lf, ab)))}) : T.Doc}
      {==}
    case True{}:
      %Equal.sym(Bool, List.is_empty(&2, Char, bf), False{}, full) : {T.doc.read(rest,
        T.MScan{k3.haft(True{}, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab)}) == T.doc.read(rest,
        T.MScan{T.read.once2(T.lex.head.close.go(_, ab, k3.w(rw, hs, he, ps, bf, T.LHead{}, bk, qk, [], un, lf,
          ab)))}) : T.Doc}
      Equal.cong(T.St, T.Doc, st => T.doc.read(rest, T.MScan{st}), T.read.once2(T.lex.head.close2(ab, k3.w(rw, hs, he,
        T.buf.str(bf) <> ps, [], T.LHeadGap{}, bk, qk, [], un, lf, ab))),
        T.read.once2(T.lex.head.close2(ab, k3.w(rw, hs, he, T.buf.str(bf) <> ps, [], T.LHead{}, bk, qk, [], un, lf,
          ab))), k3.hlexfree(ab, rw, hs, he, T.buf.str(bf), ps, T.LHead{}, bk,
        qk, un, lf))

# blank space and a dot or the bracket after an open bare header segment
# push it
def k3.hbend(
  gs: List<&2, Bool>,
  +cl: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  full: {List.is_empty(&2, Char, bf) == False{} : Bool}
) -> {T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab)})
  == T.doc.read(String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest}), T.MScan{k3.w(rw, hs, he, ps, bf, T.LHead{}, bk,
    qk, [], un, lf, ab)}) : T.Doc}:
  match gs:
    case []:
      k3.hbdl(cl, rw, hs, he, ps, bf, bk, qk, un, lf, ab, rest, full)
    case +tab <> +gr:
      %k3.hbsp(tab, rw, hs, he, ps, bf, bk, qk, un, lf, ab, String.append(Laws.gap(gr), SCon{k3.hdl(cl), rest}), full)
        : {T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab)}) == _ : T.Doc}
      %k3.hgap(gr, SCon{k3.hdl(cl), rest}, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab)
        : {T.doc.read(rest, T.MScan{k3.haft(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab)}) == _ : T.Doc}
      k3.hgdl(cl, rw, hs, he, T.buf.str(bf) <> ps, bk, qk, un, lf, ab, rest)

# a bare header segment, its blank space and a dot or the bracket
def k3.hbseg(
  +xx: U32,
  +tt: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  +ee: {T.bare.all.step(T.bare.at(Chr{xx}), _u => T.bare.all(String.to_list(tt))) == True{} : Bool},
  ih: k3.HT(cl, rw, hs, he, SCon{Chr{xx}, tt} <> k3.ps0(dt, ps), ab, rest, goal)
) -> {T.doc.read(String.append(SCon{Chr{xx}, tt}, String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})),
  T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)}) == goal : T.Doc}:
  %k3.hb1(dt, rw, hs, he, ps, bk, qk, un, lf, ab, xx, ball.head(T.bare.at(Chr{xx}), String.to_list(tt), ee))
    : {T.doc.read(String.append(tt, String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})), _) == goal : T.Doc}
  %k3.hbbody(tt, String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest}), rw, hs, he, k3.ps0(dt, ps), Chr{xx}, [], bk, qk,
    un, lf, ab, ball.tail(T.bare.at(Chr{xx}),
    String.to_list(tt), ee)) : {_ == goal : T.Doc}
  %k3.hbend(gs, cl, rw, hs, he, k3.ps0(dt, ps), rev.onto(tt, [Chr{xx}]), bk, qk, un, lf, ab, rest, rev.full(tt,
    Chr{xx}, []))
    : {_ == goal : T.Doc}
  %Equal.sym(String, T.buf.str(rev.onto(tt, [Chr{xx}])), SCon{Chr{xx}, tt}, wh.bname(xx, tt)) : {T.doc.read(rest,
    T.MScan{k3.haft(cl, rw, hs, he, _ <> k3.ps0(dt, ps), bk, qk, un, lf, ab)}) == goal : T.Doc}
  ih(bk, qk, un, lf)

# a quotation mark where a header segment starts opens a basic segment
def k3.hqopen(
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.MScan{k3.q(True{}, rw, hs, he, k3.ps0(dt, ps), [], ab, bk, un, lf, [])} == T.doc.scan(k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab), '"') : T.Mode}:
  match dt:
    case True{}:
      {==}
    case False{}:
      {==}

# and an apostrophe a literal one
def k3.hlopen(
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.MScan{k3.l(True{}, rw, hs, he, k3.ps0(dt, ps), [], ab, bk, un, lf, [])} == T.doc.scan(k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab), '\'') : T.Mode}:
  match dt:
    case True{}:
      {==}
    case False{}:
      {==}

# a basic header segment of pieces, its blank space and a dot or the
# bracket
def k3.hqseg(
  +pl: List<&2, Laws.KPiece>,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.k3.pcs.ok(pl) == True{} : Bool},
  ih: k3.HT(cl, rw, hs, he, Laws.k3.pcs.name(pl) <> k3.ps0(dt, ps), ab, rest, goal)
) -> {T.doc.read(SCon{'"', Laws.k3.pcs.text(pl, SCon{'"', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})})},
  T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)}) == goal : T.Doc}:
  %k3.hqopen(dt, rw, hs, he, ps, bk, qk, un, lf, ab) : {T.doc.read(Laws.k3.pcs.text(pl, SCon{'"',
    String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})}), _)
    == goal : T.Doc}
  k3.pcs(pl, True{}, rw, hs, he, k3.ps0(dt, ps), [], ab, bk, un, lf, [], SCon{'"', String.append(Laws.gap(gs),
    SCon{k3.hdl(cl), rest})}, goal, eo, +b2 => +u2 => +l2 =>
    k3.hfin(Laws.k3.pcs.name(pl), rev.onto(Laws.k3.pcs.name(pl), []), k3.nm(Laws.k3.pcs.name(pl)), gs, cl, rw, hs,
      he, k3.ps0(dt, ps), b2, T.QBasic{}, u2, l2, ab, rest, goal, ih))

# a literal header segment, its blank space and a dot or the bracket
def k3.hlseg(
  +name: String,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  el: {Laws.lit.text(name) == True{} : Bool},
  ih: k3.HT(cl, rw, hs, he, name <> k3.ps0(dt, ps), ab, rest, goal)
) -> {T.doc.read(SCon{'\'', String.append(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})})},
  T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)}) == goal : T.Doc}:
  %k3.hlopen(dt, rw, hs, he, ps, bk, qk, un, lf, ab) : {T.doc.read(String.append(name, SCon{'\'',
    String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})}), _)
    == goal : T.Doc}
  Equal.trans(T.Doc, T.doc.read(String.append(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})}),
    T.MScan{k3.l(True{}, rw, hs, he, k3.ps0(dt, ps),
    [], ab, bk, un, lf, [])}), T.doc.read(SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})},
      T.MScan{k3.l(True{}, rw, hs, he, k3.ps0(dt, ps), [], ab, bk,
    un, lf, rev.onto(name, []))}), goal,
    k3.l.body(name, SCon{'\'', String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})}, True{}, rw, hs, he, k3.ps0(dt,
      ps), [], ab, bk, un, lf, [], el),
    k3.hfin(name, rev.onto(name, []), k3.nm(name), gs, cl, rw, hs, he, k3.ps0(dt, ps), bk, T.QLit{}, un, lf, ab, rest,
      goal,
      ih))

# a header segment spelled any way toml.abnf allows, its blank space and a
# dot or the bracket
def k3.hseg(
  sg: Laws.KSeg,
  +gs: List<&2, Bool>,
  +cl: Bool,
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  eo: {Laws.k3.seg.ok(sg) == True{} : Bool},
  ih: k3.HT(cl, rw, hs, he, Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), ab, rest, goal)
) -> {T.doc.read(Laws.k3.seg.text(sg, String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})), T.MScan{k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)}) == goal : T.Doc}:
  match sg:
    case Laws.KsBare{name}:
      match name:
        case SNil{}:
          Eq.bit.absurd(&2, {T.doc.read(String.append(SNil{}, String.append(Laws.gap(gs), SCon{k3.hdl(cl), rest})),
            T.MScan{k3.w(rw, hs, he, k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)}) == goal : T.Doc}, eo)
        case SCon{hh, +tt}:
          match hh:
            case Chr{+xx}:
              k3.hbseg(xx, tt, gs, cl, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, goal, eo, ih)
    case Laws.KsBasic{+pl}:
      k3.hqseg(pl, gs, cl, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, goal, eo, ih)
    case Laws.KsLit{+name}:
      k3.hlseg(name, gs, cl, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, goal, eo, ih)

# a header's segments, then blank space and the bracket: the rest is read
# with every segment pushed onto parts, newest first
def k3.hkeys(
  ds: List<&2, Laws.KDot>,
  +last: Laws.KSeg,
  +g9: List<&2, Bool>,
  +dt: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  +goal: T.Doc,
  +eo: {Laws.k3.dk.ok(ds, last) == True{} : Bool},
  ih: k3.HT(True{}, rw, hs, he, k3.acc(ds, last, dt, ps), ab, rest, goal)
) -> {T.doc.read(Laws.k3.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', rest})), T.MScan{k3.w(rw, hs, he,
  k3.ps0(dt, ps), [], k3.hlex0(dt), bk, qk, [], un, lf, ab)}) == goal
  : T.Doc}:
  match ds:
    case []:
      k3.hseg(last, g9, True{}, dt, rw, hs, he, ps, bk, qk, un, lf, ab, rest, goal, eo, ih)
    case Laws.KDot{+sg, g1, +g2} <> +dr:
      k3.hseg(sg, g1, False{}, dt, rw, hs, he, ps, bk, qk, un, lf, ab, String.append(Laws.gap(g2),
        Laws.k3.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']', rest}))), goal, Eq.and.left(Laws.k3.seg.ok(sg),
        Laws.k3.dk.ok(dr, last), eo), +b2 => +q2 => +u2 => +l2 =>
        %k3.hdgap(g2, Laws.k3.dk.text(dr, last, String.append(Laws.gap(g9), SCon{']', rest})), rw, hs, he,
          Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), b2, q2, u2, l2, ab) : {_ == goal : T.Doc}
        k3.hkeys(dr, last, g9, True{}, rw, hs, he, Laws.k3.seg.name(sg) <> k3.ps0(dt, ps), b2, q2, u2, l2, ab, rest,
          goal,
          Eq.and.right(Laws.k3.seg.ok(sg), Laws.k3.dk.ok(dr, last), eo), ih))

# the names pushed are never none
def k3.ne(
  ds: List<&2, Laws.KDot>,
  +last: Laws.KSeg,
  +acc: List<&2, String>
) -> {List.is_empty(&2, String, List.reverse.go(&2, String, Laws.k3.dk.names(ds, last), acc)) == False{} : Bool}:
  match ds:
    case []:
      {==}
    case Laws.KDot{sg, _g1, _g2} <> rest:
      k3.ne(rest, last, Laws.k3.seg.name(sg) <> acc)

# the names pushed from where a key or a header starts, reversed, are the
# key's names
def k3.path(
  +dt: Bool,
  +ds: List<&2, Laws.KDot>,
  +last: Laws.KSeg
) -> {List.reverse(&2, String, k3.acc(ds, last, dt, [])) == Laws.k3.dk.names(ds, last) : List<&2, String>}:
  match dt:
    case False{}:
      kv.rr(Laws.k3.dk.names(ds, last))
    case True{}:
      kv.rr(Laws.k3.dk.names(ds, last))

# the walk a header runs along path, with what it returns
def k3.HWalk(
  +ab: Bool,
  +path: List<&2, String>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>
) -> Type:
  {T.tree.walk(path, T.Tw{rw, Laws.header_job(ab), [], "", "", hs, False{}}, 0) == T.End{rows2, "", heads2} : T.End}

# the rest of the text read after a header, in the table path names, from
# every back, qkind, uni and left
def k3.HLine(
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +path: List<&2, String>,
  +rest: String,
  +goal: T.Doc
) -> Type:
  @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    {T.doc.read(rest, T.MScan{Laws.k3.line(rows2, heads2, path, b2, q2, u2, l2)}) == goal : T.Doc}

# what follows the closing bracket: nothing more, or the second bracket of
# an array of tables
def k3.htail(ab: Bool, rest: String) -> String:
  match ab:
    case False{}:
      rest
    case True{}:
      SCon{']', rest}

# the bracket runs the header's walk along the segments read and leaves the
# scanner in the header's table
def k3.hend(
  +ab: Bool,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +parts: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +path: List<&2, String>,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +rest: String,
  ne: {List.is_empty(&2, String, parts) == False{} : Bool},
  er: {List.reverse(&2, String, parts) == path : List<&2, String>},
  ew: k3.HWalk(ab, path, rw, hs, rows2, heads2)
) -> {T.doc.read(rest, T.MScan{Laws.k3.line(rows2, heads2, path, bk, qk, un, lf)}) == T.doc.read(k3.htail(ab, rest),
  T.MScan{k3.haft(True{}, rw, hs, he, parts, bk, qk, un, lf, ab)}) : T.Doc}:
  match ab:
    case False{}:
      %Equal.sym(Bool, List.is_empty(&2, String, parts), False{}, ne) : {T.doc.read(rest,
        T.MScan{Laws.k3.line(rows2, heads2, path, bk, qk, un, lf)}) == T.doc.read(rest,
          T.MScan{T.read.once2(T.head.go(_,
        k3.w(rw, hs, he, parts, [], T.LHeadGap{}, bk, qk, [], un, lf, False{}), List.reverse(&2, String,
          parts)))}) : T.Doc}
      %Equal.sym(List<&2, String>, List.reverse(&2, String, parts), path, er) : {T.doc.read(rest,
        T.MScan{Laws.k3.line(rows2, heads2, path, bk, qk, un, lf)}) == T.doc.read(rest,
        T.MScan{T.read.once2(T.head.apply(T.tree.walk(_, T.Tw{rw, T.JDef{}, [], "", "", hs, False{}}, 0), _, bk, qk,
        un, lf, False{}))}) : T.Doc}
      %Equal.sym(T.End, T.tree.walk(path, T.Tw{rw, T.JDef{}, [], "", "", hs, False{}}, 0), T.End{rows2, "", heads2},
        ew) : {T.doc.read(rest, T.MScan{Laws.k3.line(rows2, heads2, path, bk, qk, un, lf)}) == T.doc.read(rest,
        T.MScan{T.read.once2(T.head.apply(_, path, bk, qk, un, lf, False{}))}) : T.Doc}
      {==}
    case True{}:
      %Equal.sym(Bool, List.is_empty(&2, String, parts), False{}, ne) : {T.doc.read(rest,
        T.MScan{Laws.k3.line(rows2, heads2, path, bk, qk, un, lf)}) == T.doc.read(rest,
          T.MScan{T.read.once2(T.head.go(_,
        k3.w(rw, hs, he, parts, [], T.LHeadR{}, bk, qk, [], un, lf, True{}), List.reverse(&2, String,
          parts)))}) : T.Doc}
      %Equal.sym(List<&2, String>, List.reverse(&2, String, parts), path, er) : {T.doc.read(rest,
        T.MScan{Laws.k3.line(rows2, heads2, path, bk, qk, un, lf)}) == T.doc.read(rest,
        T.MScan{T.read.once2(T.head.apply(T.tree.walk(_, T.Tw{rw, T.JAot{}, [], "", "", hs, False{}}, 0), _, bk, qk,
        un, lf, False{}))}) : T.Doc}
      %Equal.sym(T.End, T.tree.walk(path, T.Tw{rw, T.JAot{}, [], "", "", hs, False{}}, 0), T.End{rows2, "", heads2},
        ew) : {T.doc.read(rest, T.MScan{Laws.k3.line(rows2, heads2, path, bk, qk, un, lf)}) == T.doc.read(rest,
        T.MScan{T.read.once2(T.head.apply(_, path, bk, qk, un, lf, False{}))}) : T.Doc}
      {==}

# a whole header, from the start of a line in any table
def k3.hcore(
  +arr: Bool,
  +g0: List<&2, Bool>,
  +ds: List<&2, Laws.KDot>,
  +last: Laws.KSeg,
  +g9: List<&2, Bool>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +a0: Bool,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  +rows2: List<&2, T.Val>,
  +heads2: List<&2, String>,
  +rest: String,
  +goal: T.Doc,
  +eo: {Laws.k3.dk.ok(ds, last) == True{} : Bool},
  ew: k3.HWalk(arr, Laws.k3.dk.names(ds, last), rw, hs, rows2, heads2),
  ih: k3.HLine(rows2, heads2, Laws.k3.dk.names(ds, last), rest, goal)
) -> {T.doc.read(Laws.k3.hd.text(arr, g0, ds, last, g9, rest), T.MScan{Laws.k3.at(Laws.AtLine{}, rw, hs, he, [], a0,
  bk, qk, un, lf)}) == goal : T.Doc}:
  match arr:
    case False{}:
      %k3.hlead(g0, Laws.k3.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', rest})), rw, hs, he, bk, qk, un, lf,
        False{}) : {_ == goal : T.Doc}
      k3.hkeys(ds, last, g9, k3.nz(g0), rw, hs, he, [], bk, qk, un, lf, False{}, rest, goal, eo, +b2 => +q2 => +u2 =>
        +l2 =>
        %k3.hend(False{}, rw, hs, he, k3.acc(ds, last, k3.nz(g0), []), b2, q2, u2, l2, Laws.k3.dk.names(ds, last),
          rows2, heads2, rest, k3.ne(ds, last, k3.ps0(k3.nz(g0), [])), k3.path(k3.nz(g0), ds, last), ew)
          : {_ == goal : T.Doc}
        ih(b2, q2, u2, l2))
    case True{}:
      %k3.hlead(g0, Laws.k3.dk.text(ds, last, String.append(Laws.gap(g9), SCon{']', SCon{']', rest}})), rw, hs, he,
        bk, qk, un, lf, True{}) : {_ == goal : T.Doc}
      k3.hkeys(ds, last, g9, k3.nz(g0), rw, hs, he, [], bk, qk, un, lf, True{}, SCon{']', rest}, goal, eo,
        +b2 => +q2 => +u2 => +l2 =>
        %k3.hend(True{}, rw, hs, he, k3.acc(ds, last, k3.nz(g0), []), b2, q2, u2, l2, Laws.k3.dk.names(ds, last),
          rows2, heads2, rest, k3.ne(ds, last, k3.ps0(k3.nz(g0), [])), k3.path(k3.nz(g0), ds, last), ew)
          : {_ == goal : T.Doc}
        ih(b2, q2, u2, l2))

def Laws.header_reads_back_anywhere(
  arr,
  g0,
  ds,
  last,
  ok,
  g9,
  rows,
  heads,
  here,
  arrtab,
  back,
  qkind,
  uni,
  left,
  rows2,
  heads2,
  ew,
  rest,
  goal,
  ih
):
  k3.hcore(arr, g0, ds, last, g9, rows, heads, here, arrtab, back, qkind, uni, left, rows2, heads2, rest, goal, ok, ew,
    ih)

# SCAN: an induction over parse's reading of a text, for any invariant of
# the scanner's state. doc.read reads a text in four modes (TOML-RT-3's
# gd.md): a scanning state and one after a carriage return hold a state; an
# opening quote's mode holds the fields of the state the quote left; a plain
# string's mode holds a span of the source, the first n characters of cut.
# An invariant ii of states, with a predicate sp of a span against the text
# still to read, is kept by every character when each obligation below
# holds, and then holds of what parse returns in the form pd asks. The
# characters are those cp allows, in a text tx allows; TOML-RT-3's good is
# the instance ii = good, sp = its span check, cp = wf.char. The invariant,
# the span predicate, the document's property and the obligations take a
# context gg of any type GG (TOML-RT-3's is Unit; a key's is the key), since
# a template argument must be closed and cannot capture it. The invariant,
# the predicates and the obligations are template parameters (~), since an
# obligation is used once for every character and Bend copies a function
# only as a template argument; their names start with `_` because bolt's
# unused-parameter check does not see a template parameter's uses.

# a mode's invariant, over the text still to read
def si.md(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_sp: _GG -> String -> U32 -> String -> Bool,
  -gg: _GG,
  mode: T.Mode,
  -text: String
) -> Data:
  match mode:
    case T.MScan{st}:
      {_ii(gg, st) == True{} : Bool}
    case T.MCr{st}:
      {_ii(gg, st) == True{} : Bool}
    case T.MOpen{_basic, _q, qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at}:
      {_ii(gg, T.St{bd, rw, hs, he, pt, bf, T.LQ{}, bk, qk, sk, T.HNone{}, un, lf, at,
        False{}}) == True{} : Bool}
    case T.MEat{_basic, _q, cut, nn, bd, rw, hs, he, pt, qk, sk, un, lf, at}:
      {Bool.and(_ii(gg, T.St{bd, rw, hs, he, pt, [], T.LStr{}, T.LStr{}, qk, sk, T.HNone{}, un, lf,
        at, False{}}), _sp(gg, cut, nn, text)) == True{} : Bool}

# a plain string's state, as its span keeps it
def si.str(
  bd: String,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  pt: List<&2, String>,
  bf: List<&2, Char>,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  at: Bool
) -> T.St:
  T.St{bd, rw, hs, he, pt, bf, T.LStr{}, T.LStr{}, qk, sk, T.HNone{}, un, lf, at, False{}}

# every full step keeps the invariant: one character read in any state
def si.OStep(~_GG: Data, ~_ii: _GG -> T.St -> Bool, ~_cp: Char -> Bool) -> Type:
  @gg: _GG -> @st: T.St -> {_ii(gg, st) == True{} : Bool} -> @cc: Char -> {_cp(cc) == True{} : Bool} ->
    {_ii(gg, T.read.step(st, cc)) == True{} : Bool}

# and so does reading a held character
def si.OOnce(~_GG: Data, ~_ii: _GG -> T.St -> Bool) -> Type:
  @gg: _GG -> @st: T.St -> {_ii(gg, st) == True{} : Bool} -> {_ii(gg, T.read.once2(st)) == True{} : Bool}

# the fast step's character pushed onto the buffer keeps it, in a state
# with no held character that is past the first
def si.OCons(~_GG: Data, ~_ii: _GG -> T.St -> Bool, ~_cp: Char -> Bool) -> Type:
  @gg: _GG -> @bd: String -> @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @he: List<&2, String> ->
    @pt: List<&2, String> -> @bf: List<&2, Char> -> @lx: T.Lex -> @bk: T.Lex -> @qk: T.QKind ->
    @sk: List<&2, T.Ctx> -> @un: U32 -> @lf: U32 -> @at: Bool -> @cc: Char ->
    {_ii(gg, T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, T.HNone{}, un, lf, at, False{}})
      == True{} : Bool} -> {_cp(cc) == True{} : Bool} ->
    {_ii(gg, T.St{bd, rw, hs, he, pt, cc <> bf, lx, bk, qk, sk, T.HNone{}, un, lf, at,
      False{}}) == True{} : Bool}

# a failed step keeps it
def si.OErr(~_GG: Data, ~_ii: _GG -> T.St -> Bool) -> Type:
  @gg: _GG -> @st: T.St -> @why: String -> {String.is_empty(why) == False{} : Bool} -> {_ii(gg, st) == True{} : Bool} ->
    {_ii(gg, T.st.err(st, why)) == True{} : Bool}

# an opening quote's state that starts a span keeps it as the span's state
def si.OOpen(~_GG: Data, ~_ii: _GG -> T.St -> Bool) -> Type:
  @gg: _GG -> @bd: String -> @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @he: List<&2, String> ->
    @pt: List<&2, String> -> @bk: T.Lex -> @qk: T.QKind -> @sk: List<&2, T.Ctx> -> @un: U32 ->
    @lf: U32 -> @at: Bool ->
    {_ii(gg, T.St{bd, rw, hs, he, pt, [], T.LQ{}, bk, qk, sk, T.HNone{}, un, lf, at, False{}})
      == True{} : Bool} ->
    {_ii(gg, si.str(bd, rw, hs, he, pt, [], qk, sk, un, lf, at)) == True{} : Bool}

# a span of one character, the text's first, holds sp against the rest
def si.OSp1(~_GG: Data, ~_sp: _GG -> String -> U32 -> String -> Bool, ~_cp: Char -> Bool, ~_tx: String -> Bool) -> Type:
  @gg: _GG -> @hh: Char -> @tt: String -> {_cp(hh) == True{} : Bool} -> {_tx(SCon{hh, tt}) == True{} : Bool} ->
    {_sp(gg, SCon{hh, tt}, 1, tt) == True{} : Bool}

# a span that takes the text's next character still holds sp
def si.OSpInc(
  ~_GG: Data,
  ~_sp: _GG -> String -> U32 -> String -> Bool,
  ~_cp: Char -> Bool,
  ~_tx: String -> Bool
) -> Type:
  @gg: _GG -> @cut: String -> @nn: U32 -> @hh: Char -> @tt: String -> {_sp(gg, cut, nn, SCon{hh,
    tt}) == True{} : Bool} ->
    {_cp(hh) == True{} : Bool} -> {_tx(SCon{hh, tt}) == True{} : Bool} -> {_sp(gg, cut, U32.add(nn, 1),
      tt) == True{} : Bool}

# a span that closes is placed as a VSpan and keeps it
def si.OClose(~_GG: Data, ~_ii: _GG -> T.St -> Bool, ~_sp: _GG -> String -> U32 -> String -> Bool) -> Type:
  @gg: _GG -> @bd: String -> @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @he: List<&2, String> ->
    @pt: List<&2, String> -> @qk: T.QKind -> @sk: List<&2, T.Ctx> -> @un: U32 -> @lf: U32 ->
    @at: Bool -> @cut: String -> @nn: U32 -> @text: String ->
    {_ii(gg, si.str(bd, rw, hs, he, pt, [], qk, sk, un, lf, at)) == True{} : Bool} ->
    {_sp(gg, cut, nn, text) == True{} : Bool} ->
    {_ii(gg, T.val.take(si.str(bd, rw, hs, he, pt, [], qk, sk, un, lf, at), T.VSpan{cut, nn}))
      == True{} : Bool}

# a span copied to the buffer keeps it
def si.OCopy(~_GG: Data, ~_ii: _GG -> T.St -> Bool, ~_sp: _GG -> String -> U32 -> String -> Bool) -> Type:
  @gg: _GG -> @bd: String -> @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @he: List<&2, String> ->
    @pt: List<&2, String> -> @qk: T.QKind -> @sk: List<&2, T.Ctx> -> @un: U32 -> @lf: U32 ->
    @at: Bool -> @cut: String -> @nn: U32 -> @text: String ->
    {_ii(gg, si.str(bd, rw, hs, he, pt, [], qk, sk, un, lf, at)) == True{} : Bool} ->
    {_sp(gg, cut, nn, text) == True{} : Bool} ->
    {_ii(gg, si.str(bd, rw, hs, he, pt, T.span.rev(cut, nn, U32.is_zero(nn), []), qk, sk, un, lf,
      at)) == True{} : Bool}

# a state at the end of the text gives what pd asks of the document
def si.OFin(~_GG: Data, ~_ii: _GG -> T.St -> Bool, ~_pd: _GG -> T.Doc -> Type) -> Type:
  @gg: _GG -> @st: T.St -> {_ii(gg, st) == True{} : Bool} -> _pd(gg, T.read.fin(st))

# and a span still open at the end
def si.OUnc(~_GG: Data, ~_ii: _GG -> T.St -> Bool, ~_pd: _GG -> T.Doc -> Type) -> Type:
  @gg: _GG -> @bd: String -> @rw: List<&2, T.Val> -> @hs: List<&2, String> -> @he: List<&2, String> ->
    @pt: List<&2, String> -> @qk: T.QKind -> @sk: List<&2, T.Ctx> -> @un: U32 -> @lf: U32 ->
    @at: Bool ->
    {_ii(gg, si.str(bd, rw, hs, he, pt, [], qk, sk, un, lf, at)) == True{} : Bool} ->
    _pd(gg, T.read.fin.unclosed(si.str(bd, rw, hs, he, pt, [], qk, sk, un, lf, at)))

# a text tx allows starts with a character cp allows
def si.OTxH(~_cp: Char -> Bool, ~_tx: String -> Bool) -> Type:
  @hh: Char -> @tt: String -> {_tx(SCon{hh, tt}) == True{} : Bool} -> {_cp(hh) == True{} : Bool}

# and goes on with a text tx allows
def si.OTxT(~_tx: String -> Bool) -> Type:
  @hh: Char -> @tt: String -> {_tx(SCon{hh, tt}) == True{} : Bool} -> {_tx(tt) == True{} : Bool}

# SCAN: the induction over the text, for any invariant (sip.read below).
# This is TOML-RT-3's dispatch, span modes and induction (gd.fast, gd.mode
# step, gd_read) with good replaced by the invariant ii and its lemmas by the
# obligations: the fast step keeps a plain character in the buffer (si.OCons)
# or ignores it, and gives every other character, and a held one, to the
# full step (si.OStep, si.OOnce); a quote may open a span, which grows, closes
# or is copied to the buffer (si.OOpen, si.OSp1, si.OSpInc, si.OClose,
# si.OCopy); a carriage return must meet a line feed (si.OErr); and the text
# ends in a state (si.OFin) or in a span (si.OUnc).

# a state as the fast step builds it: no held character, past the first
def sip.S(
  bd: String,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  pt: List<&2, String>,
  bf: List<&2, Char>,
  lx: T.Lex,
  bk: T.Lex,
  qk: T.QKind,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  at: Bool
) -> T.St:
  T.St{bd, rw, hs, he, pt, bf, lx, bk, qk, sk, T.HNone{}, un, lf, at, False{}}

# the full step, from the fast step's state
def sip.fold(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +lx: T.Lex,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.old(bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at, cc)) == True{} : Bool}:
  _oo(gg, T.read.on.st(sip.S(bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at), cc), _os(gg, sip.S(bd, rw, hs, he,
    pt, bf,
    lx, bk, qk, sk, un, lf, at), eg, cc, ec))

# the character joins the buffer
def sip.fcons(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +lx: T.Lex,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.cons(bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at, cc)) == True{} : Bool}:
  _oc(gg, bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at, cc, eg, ec)

# a control takes the full step; a plain character is kept
def sip.fpush(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  ctrl: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +lx: T.Lex,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.push(ctrl, bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at, cc)) == True{} : Bool}:
  match ctrl:
    case False{}:
      sip.fcons(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at, eg, cc, ec)
    case True{}:
      sip.fold(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, lx, bk, qk, sk, un, lf, at, eg, cc, ec)

# a backslash in a basic string takes the full step
def sip.fbbs(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  bs: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.basic.bs(bs, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc)) == True{} : Bool}:
  match bs:
    case True{}:
      sip.fold(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf,
        at, eg, cc,
        ec)
    case False{}:
      sip.fpush(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, T.str.bad(Char.to_u32(cc), False{}), bd, rw, hs, he, pt, bf,
        T.LStr{},
        bk, T.QBasic{}, sk, un, lf, at, eg, cc, ec)

# a quote in a basic string takes the full step
def sip.fbasic(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  quote: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.basic(quote, Char.is_eq(cc, '\\'), bd, rw, hs, he, pt, bf, bk, sk, un, lf, at,
  cc)) == True{} : Bool}:
  match quote:
    case True{}:
      sip.fold(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QBasic{}, sk, un, lf,
        at, eg, cc,
        ec)
    case False{}:
      sip.fbbs(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, Char.is_eq(cc, '\\'), bd, rw, hs, he, pt, bf, bk, sk, un, lf,
        at, eg, cc,
        ec)

# a quote in a literal string takes the full step
def sip.flit(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  quote: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.lit(quote, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc)) == True{} : Bool}:
  match quote:
    case True{}:
      sip.fold(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QLit{}, sk, un, lf, at,
        eg, cc, ec)
    case False{}:
      sip.fpush(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, T.str.bad(Char.to_u32(cc), False{}), bd, rw, hs, he, pt, bf,
        T.LStr{},
        bk, T.QLit{}, sk, un, lf, at, eg, cc, ec)

# one character of a string on the fast step
def sip.fstr(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, T.LStr{}, bk, qk, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.str(qk, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc)) == True{} : Bool}:
  match qk:
    case T.QBasic{}:
      sip.fbasic(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, Char.is_eq(cc, '"'), bd, rw, hs, he, pt, bf, bk, sk, un, lf,
        at, eg,
        cc, ec)
    case T.QLit{}:
      sip.flit(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, Char.is_eq(cc, '\''), bd, rw, hs, he, pt, bf, bk, sk, un, lf,
        at, eg, cc,
        ec)
    case T.QMulti{}:
      sip.fold(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QMulti{}, sk, un, lf,
        at, eg, cc,
        ec)
    case T.QMultiLit{}:
      sip.fold(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, T.LStr{}, bk, T.QMultiLit{}, sk, un,
        lf, at, eg,
        cc, ec)

# one character of a bare key on the fast step
def sip.fkey(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
  +gg: _GG,
  ok: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +eg: {_ii(gg, sip.S(bd, rw, hs, he, pt, bf, T.LKey{}, bk, qk, sk, un, lf, at)) == True{} : Bool},
  +cc: Char,
  +ec: {_cp(cc) == True{} : Bool}
) -> {_ii(gg, T.read.fast.key(ok, bd, rw, hs, he, pt, bf, bk, qk, sk, un, lf, at, cc)) == True{} : Bool}:
  match ok:
    case True{}:
      sip.fcons(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, T.LKey{}, bk, qk, sk, un, lf, at, eg,
        cc, ec)
    case False{}:
      sip.fold(~_GG, ~_ii, ~_cp, ~_os, ~_oo, ~_oc, gg, bd, rw, hs, he, pt, bf, T.LKey{}, bk, qk, sk, un, lf, at, eg,
        cc, ec)

# one character of a bare value on the fast step
def sip.fbare(
  ~_GG: Data,
  ~_ii: _GG -> T.St -> Bool,
  ~_cp: Char -> Bool,
  ~_os: si.OStep(~_GG, ~_ii, ~_cp),
  ~_oo: si.OOnce(~_GG, ~_ii),
  ~_oc: si.OCons(~_GG, ~_ii, ~_cp),
