        T.WfRows{hp})), hw) : {T.wf.then(T.wf.go(T.VSpan{a1, a2} <> et, T.WfElems{p}), _v => T.wf.go(t, T.WfRows{hp}))
        == True{} : Bool}}
      Eq.bit.absurd(&1, se(String.append(T.render.pass(T.VPair{kk, T.VAots{p, T.VSpan{a1, a2} <> et}} <> t, "\n",
