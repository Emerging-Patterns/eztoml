# LKeyU's last digit: its code point checked
def r1.kub.f(
  fin: Bool,
  qq: Bool,
  lit: Bool,
  cr: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +efin: {T.uni.ok(U32.add(U32.mul(un, 16), T.dig.val(cc))) == fin : Bool},
  +eqq: {Char.is_eq(cc, '"') == qq : Bool},
  +elt: {Char.is_eq(cc, '\'') == lit : Bool},
  +ecr: {U32.is_eq(Char.to_u32(cc), 13) == cr : Bool},
  +ez: {U32.is_zero(lf) == False{} : Bool},
  +edok: {T.dig.ok(T.dig.val(cc), 16) == True{} : Bool},
  +el: {U32.is_eq(lf, 1) == True{} : Bool},
  +tt: String,
  en: sr.N(tt, r1.kub.fM(fin, qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at)),
  ih: r1.CC(r1.kub.fM(fin, qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at), tt)
) -> Laws.r1.fill(Laws.RfKUni{un, lf} <> (Laws.RfKAfter{} <> Laws.r1.vend(sk)), SCon{cc, tt}):
  match fin:
    case True{}:
      r1.x.ulast.c(cc, un, lf, tt, Laws.RfKAfter{} <> Laws.r1.vend(sk), ez, el, efin, edok, r1.kk(qq, lit, cr, cc, eqq,
        elt, ecr, xx => T.dig.ok(T.dig.val(xx), 16), edok, {==}, {==}, {==}, sip.S(bd, rw, hs, he, pt,
        Char.from_u32(U32.add(U32.mul(un, 16), T.dig.val(cc))) <> bf, T.LKeyQ{}, bk, T.QBasic{}, sk, 0, 0, at), tt, ih))
    case False{}:
      Eq.bit.gone(&1, Laws.r1.fill(Laws.RfKUni{un, lf} <> (Laws.RfKAfter{} <> Laws.r1.vend(sk)), SCon{cc, tt}),
        r1.bad(qq, lit, cr, bd, rw, hs, he, pt, bf, T.LKeyU{}, bk, T.QBasic{}, sk, un, lf, at, 'i', "nvalid escape", tt,
        en))

# the mode r1.kub.n reads its text from
def r1.kub.nM(
  +last: Bool,
  +qq: Bool,
  +lit: Bool,
  +cr: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool
) -> T.Mode:
  sr.K(qq, lit, cr, T.read.once2(T.uni.next(last, r1.SKUb(bd, rw, hs, he, pt, bf, bk, sk, un, lf, at),
    U32.add(U32.mul(un, 16), T.dig.val(cc)), T.LKeyQ{}, lf)))

# LKeyU's digit: the last one, or one more to come
def r1.kub.n(
  last: Bool,
  qq: Bool,
  lit: Bool,
  cr: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +elast: {U32.is_eq(lf, 1) == last : Bool},
  +eqq: {Char.is_eq(cc, '"') == qq : Bool},
  +elt: {Char.is_eq(cc, '\'') == lit : Bool},
  +ecr: {U32.is_eq(Char.to_u32(cc), 13) == cr : Bool},
  +ez: {U32.is_zero(lf) == False{} : Bool},
  +edok: {T.dig.ok(T.dig.val(cc), 16) == True{} : Bool},
  +tt: String,
  en: sr.N(tt, r1.kub.nM(last, qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at)),
  ih: r1.CC(r1.kub.nM(last, qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at), tt)
) -> Laws.r1.fill(Laws.RfKUni{un, lf} <> (Laws.RfKAfter{} <> Laws.r1.vend(sk)), SCon{cc, tt}):
  match last:
    case True{}:
      r1.kub.f(T.uni.ok(U32.add(U32.mul(un, 16), T.dig.val(cc))), qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un,
        lf, at, {==}, eqq, elt, ecr, ez, edok, elast, tt, en, ih)
    case False{}:
      r1.x.umore.c(cc, un, lf, tt, Laws.RfKAfter{} <> Laws.r1.vend(sk), ez, edok, r1.u0f(U32.is_zero(U32.sub(lf, 1)),
        Equal.trans(Bool, U32.is_zero(U32.sub(lf, 1)), U32.is_eq(lf, 1), False{}, r1.dec1(lf), elast), Laws.r1.vend(sk),
        U32.add(U32.mul(un, 16), T.dig.val(cc)), U32.sub(lf, 1), tt, r1.kk(qq, lit, cr, cc, eqq, elt, ecr, xx =>
        T.dig.ok(T.dig.val(xx), 16), edok, {==}, {==}, {==}, sip.S(bd, rw, hs, he, pt, bf, T.LKeyU{}, bk, T.QBasic{},
        sk, U32.add(U32.mul(un, 16), T.dig.val(cc)), U32.sub(lf, 1), at), tt, ih)))

# the mode r1.kub.go reads its text from
def r1.kubM(
  +dok: Bool,
  +qq: Bool,
  +lit: Bool,
  +cr: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool
) -> T.Mode:
  sr.K(qq, lit, cr, T.read.once2(T.uni.go(dok, r1.SKUb(bd, rw, hs, he, pt, bf, bk, sk, un, lf, at), cc, T.LKeyQ{}, un,
    lf)))

# LKeyU's dispatch: a hexadecimal digit, else refused
def r1.kub.go(
  dok: Bool,
  qq: Bool,
  lit: Bool,
  cr: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +edok: {T.dig.ok(T.dig.val(cc), 16) == dok : Bool},
  +eqq: {Char.is_eq(cc, '"') == qq : Bool},
  +elt: {Char.is_eq(cc, '\'') == lit : Bool},
  +ecr: {U32.is_eq(Char.to_u32(cc), 13) == cr : Bool},
  +ez: {U32.is_zero(lf) == False{} : Bool},
  +tt: String,
  en: sr.N(tt, r1.kubM(dok, qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at)),
  ih: r1.CC(r1.kubM(dok, qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at), tt)
) -> Laws.r1.fill(Laws.RfKUni{un, lf} <> (Laws.RfKAfter{} <> Laws.r1.vend(sk)), SCon{cc, tt}):
  match dok:
    case True{}:
      r1.kub.n(U32.is_eq(lf, 1), qq, lit, cr, cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, {==}, eqq, elt, ecr, ez,
        edok, tt, en, ih)
    case False{}:
      Eq.bit.gone(&1, Laws.r1.fill(Laws.RfKUni{un, lf} <> (Laws.RfKAfter{} <> Laws.r1.vend(sk)), SCon{cc, tt}),
        r1.bad(qq, lit, cr, bd, rw, hs, he, pt, bf, T.LKeyU{}, bk, T.QBasic{}, sk, un, lf, at, 'i', "nvalid escape", tt,
        en))

# LKeyU with no digit left is a state no step reaches
def r1.kub.z(
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +tt: String,
  zz: Bool,
  ez: {U32.is_zero(lf) == zz : Bool},
  en: sr.N(tt, sr.Kc(cc, T.read.fast.old(bd, rw, hs, he, pt, bf, T.LKeyU{}, bk, T.QBasic{}, sk, un, lf, at, cc))),
  ih: Laws.r1.C(sr.Kc(cc, T.read.fast.old(bd, rw, hs, he, pt, bf, T.LKeyU{}, bk, T.QBasic{}, sk, un, lf, at, cc)), tt)
) -> Laws.r1.fill(Laws.r1.gp.u0(zz, Laws.r1.vend(sk), un, lf), SCon{cc, tt}):
  match zz:
    case True{}:
      Unit{}
    case False{}:
      r1.kub.go(T.dig.ok(T.dig.val(cc), 16), Char.is_eq(cc, '"'), Char.is_eq(cc, '\''), U32.is_eq(Char.to_u32(cc), 13),
        cc, bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, {==}, {==}, {==}, {==}, ez, tt, en, ih)

# WP-R: LKeyU's obligation, for every character: an escape's digits are only
# in a basic segment
def r1.ob.ku(
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +pt: List<&2, String>,
  +bf: List<&2, Char>,
  +bk: T.Lex,
  qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +at: Bool,
  +cc: Char,
  +tt: String
) -> r1.Ob(bd, rw, hs, he, pt, bf, T.LKeyU{}, bk, qk, sk, un, lf, at, cc, tt):
  match qk:
    case T.QBasic{}:
      _ec => en => ih => r1.kub.z(bd, rw, hs, he, pt, bf, bk, sk, un, lf, at, cc, tt, U32.is_zero(lf), {==}, en, ih)
    case T.QLit{}:
      _ec => _en => _ih => Unit{}
    case T.QMulti{}:
      _ec => _en => _ih => Unit{}
    case T.QMultiLit{}:
      _ec => _en => _ih => Unit{}


# WP-S1: strings of every form read as the text they denote. A string's
# derivation (GString) is read from the state that waits for a value, one
# piece at a time: a one-line basic string through WP-S's span (sv.open,
# sv.eat) while its pieces are characters written as themselves, and in
# LStr once an escape copies the span; a literal string as a span alone; a
# multi-line string in LStr with the trims of LTrim and LFold and the quotes
# of LMq and LMqEnd. Escapes go through KEY-3's symbolic hex reader
# (k3.hx.dv, k3.hx.ok, k3.hx.scan), so every \u and \U costs the same few
# lemmas. Every field a string leaves alone is a parameter (bd the error, rw
# the rows, hs heads, he here, ps parts, sk the stack, ab arrtab), and the
# rest of the walk is a motive PP over the document, as in WP-S and WP-C.

# Characters. basic-unescaped and literal-char leave out every control but
# tab, so a character either takes is pushed by the string states, and is no
# quote it leaves out.

# a code point a class of characters takes is not one it leaves out
def s1.off(
  pp: Char -> Bool,
  +uu: U32,
  +kk: U32,
  yes: {pp(Chr{uu}) == True{} : Bool},
  no: {pp(Chr{kk}) == False{} : Bool}
) -> {U32.is_eq(uu, kk) == False{} : Bool}:
  neq.off(uu, kk, ee => Eq.bit.clash(Equal.trans(Bool, False{}, pp(Chr{kk}), True{},
    Equal.sym(Bool, pp(Chr{kk}), False{}, no),
    Equal.trans(Bool, pp(Chr{kk}), pp(Chr{uu}), True{},
      Equal.cong(Char, Bool, pp, Chr{kk}, Chr{uu}, Equal.sym(Char, Chr{uu}, Chr{kk}, ee)), yes))))

# a control basic-unescaped takes is a tab
def s1.bu.tab(
  +uu: U32,
  h_c: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == True{} : Bool},
  hb: {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}
) -> {U32.is_eq(uu, 9) == True{} : Bool}:
  Eq.ctl.all(kk => {Laws.abnf.basic_unescaped(Chr{kk}) == True{} : Bool} -> {U32.is_eq(kk, 9) == True{} : Bool},
    uu, h_c,
    h0 => Eq.bit.absurd(&2, {U32.is_eq(0, 9) == True{} : Bool}, h0),
    h1 => Eq.bit.absurd(&2, {U32.is_eq(1, 9) == True{} : Bool}, h1),
    h2 => Eq.bit.absurd(&2, {U32.is_eq(2, 9) == True{} : Bool}, h2),
    h3 => Eq.bit.absurd(&2, {U32.is_eq(3, 9) == True{} : Bool}, h3),
    h4 => Eq.bit.absurd(&2, {U32.is_eq(4, 9) == True{} : Bool}, h4),
    h5 => Eq.bit.absurd(&2, {U32.is_eq(5, 9) == True{} : Bool}, h5),
    h6 => Eq.bit.absurd(&2, {U32.is_eq(6, 9) == True{} : Bool}, h6),
    h7 => Eq.bit.absurd(&2, {U32.is_eq(7, 9) == True{} : Bool}, h7),
    h8 => Eq.bit.absurd(&2, {U32.is_eq(8, 9) == True{} : Bool}, h8),
    _h9 => {==},
    h10 => Eq.bit.absurd(&2, {U32.is_eq(10, 9) == True{} : Bool}, h10),
    h11 => Eq.bit.absurd(&2, {U32.is_eq(11, 9) == True{} : Bool}, h11),
    h12 => Eq.bit.absurd(&2, {U32.is_eq(12, 9) == True{} : Bool}, h12),
    h13 => Eq.bit.absurd(&2, {U32.is_eq(13, 9) == True{} : Bool}, h13),
    h14 => Eq.bit.absurd(&2, {U32.is_eq(14, 9) == True{} : Bool}, h14),
    h15 => Eq.bit.absurd(&2, {U32.is_eq(15, 9) == True{} : Bool}, h15),
    h16 => Eq.bit.absurd(&2, {U32.is_eq(16, 9) == True{} : Bool}, h16),
    h17 => Eq.bit.absurd(&2, {U32.is_eq(17, 9) == True{} : Bool}, h17),
    h18 => Eq.bit.absurd(&2, {U32.is_eq(18, 9) == True{} : Bool}, h18),
    h19 => Eq.bit.absurd(&2, {U32.is_eq(19, 9) == True{} : Bool}, h19),
    h20 => Eq.bit.absurd(&2, {U32.is_eq(20, 9) == True{} : Bool}, h20),
    h21 => Eq.bit.absurd(&2, {U32.is_eq(21, 9) == True{} : Bool}, h21),
    h22 => Eq.bit.absurd(&2, {U32.is_eq(22, 9) == True{} : Bool}, h22),
    h23 => Eq.bit.absurd(&2, {U32.is_eq(23, 9) == True{} : Bool}, h23),
    h24 => Eq.bit.absurd(&2, {U32.is_eq(24, 9) == True{} : Bool}, h24),
    h25 => Eq.bit.absurd(&2, {U32.is_eq(25, 9) == True{} : Bool}, h25),
    h26 => Eq.bit.absurd(&2, {U32.is_eq(26, 9) == True{} : Bool}, h26),
    h27 => Eq.bit.absurd(&2, {U32.is_eq(27, 9) == True{} : Bool}, h27),
    h28 => Eq.bit.absurd(&2, {U32.is_eq(28, 9) == True{} : Bool}, h28),
    h29 => Eq.bit.absurd(&2, {U32.is_eq(29, 9) == True{} : Bool}, h29),
    h30 => Eq.bit.absurd(&2, {U32.is_eq(30, 9) == True{} : Bool}, h30),
    h31 => Eq.bit.absurd(&2, {U32.is_eq(31, 9) == True{} : Bool}, h31),
    h127 => Eq.bit.absurd(&2, {U32.is_eq(127, 9) == True{} : Bool}, h127))(hb)

# and so does literal-char
def s1.lc.tab(
  +uu: U32,
  h_c: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == True{} : Bool},
  hl: {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool}
) -> {U32.is_eq(uu, 9) == True{} : Bool}:
  Eq.ctl.all(kk => {Laws.abnf.literal_char(Chr{kk}) == True{} : Bool} -> {U32.is_eq(kk, 9) == True{} : Bool},
    uu, h_c,
    h0 => Eq.bit.absurd(&2, {U32.is_eq(0, 9) == True{} : Bool}, h0),
    h1 => Eq.bit.absurd(&2, {U32.is_eq(1, 9) == True{} : Bool}, h1),
    h2 => Eq.bit.absurd(&2, {U32.is_eq(2, 9) == True{} : Bool}, h2),
    h3 => Eq.bit.absurd(&2, {U32.is_eq(3, 9) == True{} : Bool}, h3),
    h4 => Eq.bit.absurd(&2, {U32.is_eq(4, 9) == True{} : Bool}, h4),
    h5 => Eq.bit.absurd(&2, {U32.is_eq(5, 9) == True{} : Bool}, h5),
    h6 => Eq.bit.absurd(&2, {U32.is_eq(6, 9) == True{} : Bool}, h6),
    h7 => Eq.bit.absurd(&2, {U32.is_eq(7, 9) == True{} : Bool}, h7),
    h8 => Eq.bit.absurd(&2, {U32.is_eq(8, 9) == True{} : Bool}, h8),
    _h9 => {==},
    h10 => Eq.bit.absurd(&2, {U32.is_eq(10, 9) == True{} : Bool}, h10),
    h11 => Eq.bit.absurd(&2, {U32.is_eq(11, 9) == True{} : Bool}, h11),
    h12 => Eq.bit.absurd(&2, {U32.is_eq(12, 9) == True{} : Bool}, h12),
    h13 => Eq.bit.absurd(&2, {U32.is_eq(13, 9) == True{} : Bool}, h13),
    h14 => Eq.bit.absurd(&2, {U32.is_eq(14, 9) == True{} : Bool}, h14),
    h15 => Eq.bit.absurd(&2, {U32.is_eq(15, 9) == True{} : Bool}, h15),
    h16 => Eq.bit.absurd(&2, {U32.is_eq(16, 9) == True{} : Bool}, h16),
    h17 => Eq.bit.absurd(&2, {U32.is_eq(17, 9) == True{} : Bool}, h17),
    h18 => Eq.bit.absurd(&2, {U32.is_eq(18, 9) == True{} : Bool}, h18),
    h19 => Eq.bit.absurd(&2, {U32.is_eq(19, 9) == True{} : Bool}, h19),
    h20 => Eq.bit.absurd(&2, {U32.is_eq(20, 9) == True{} : Bool}, h20),
    h21 => Eq.bit.absurd(&2, {U32.is_eq(21, 9) == True{} : Bool}, h21),
    h22 => Eq.bit.absurd(&2, {U32.is_eq(22, 9) == True{} : Bool}, h22),
    h23 => Eq.bit.absurd(&2, {U32.is_eq(23, 9) == True{} : Bool}, h23),
    h24 => Eq.bit.absurd(&2, {U32.is_eq(24, 9) == True{} : Bool}, h24),
    h25 => Eq.bit.absurd(&2, {U32.is_eq(25, 9) == True{} : Bool}, h25),
    h26 => Eq.bit.absurd(&2, {U32.is_eq(26, 9) == True{} : Bool}, h26),
    h27 => Eq.bit.absurd(&2, {U32.is_eq(27, 9) == True{} : Bool}, h27),
    h28 => Eq.bit.absurd(&2, {U32.is_eq(28, 9) == True{} : Bool}, h28),
    h29 => Eq.bit.absurd(&2, {U32.is_eq(29, 9) == True{} : Bool}, h29),
    h30 => Eq.bit.absurd(&2, {U32.is_eq(30, 9) == True{} : Bool}, h30),
    h31 => Eq.bit.absurd(&2, {U32.is_eq(31, 9) == True{} : Bool}, h31),
    h127 => Eq.bit.absurd(&2, {U32.is_eq(127, 9) == True{} : Bool}, h127))(hl)

# the code point is 9
def s1.is9(+uu: U32, e9: {U32.is_eq(uu, 9) == True{} : Bool}) -> {uu == 9 : U32}:
  Equal.cong(Char, U32, cc => Char.to_u32(cc), Chr{uu}, Chr{9}, Eq.u32_eq(uu, 9, e9))

# a character that is a control only when it is a tab, as the two classes
# take: ct says whether it is a control, and it is one exactly when a tab
def s1.C9(+uu: U32) -> Type:
  {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}

# a code point that is a control exactly when it is 9, by the two answers
def s1.c9.go(
  ct: Bool,
  t9: Bool,
  +uu: U32,
  ec: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == ct : Bool},
  e9: {U32.is_eq(uu, 9) == t9 : Bool},
  tab: {ct == True{} : Bool} -> {t9 == True{} : Bool}
) -> s1.C9(uu):
  match ct t9:
    case True{} True{}:
      Equal.trans(Bool, Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), True{}, U32.is_eq(uu, 9), ec,
        Equal.sym(Bool, U32.is_eq(uu, 9), True{}, e9))
    case True{} False{}:
      Eq.bit.absurd(&1, s1.C9(uu), tab({==}))
    case False{} True{}:
      Eq.bit.absurd2(&1, s1.C9(uu), Equal.trans(Bool, True{}, Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), False{},
        Equal.cong(U32, Bool, nn => Bool.or(U32.is_lt(nn, 32), U32.is_eq(nn, 127)), 9, uu,
          Equal.sym(U32, uu, 9, s1.is9(uu, e9))), ec))
    case False{} False{}:
      Equal.trans(Bool, Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), False{}, U32.is_eq(uu, 9), ec,
        Equal.sym(Bool, U32.is_eq(uu, 9), False{}, e9))

# a character basic-unescaped takes is a control only when it is a tab
def s1.bu.c9(
  +uu: U32,
  +hb: {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}
) -> s1.C9(uu):
  s1.c9.go(Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9), uu, {==}, {==},
    ec => s1.bu.tab(uu, ec, hb))

# and so is one literal-char takes
def s1.lc.c9(
  +uu: U32,
  +hl: {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool}
) -> s1.C9(uu):
  s1.c9.go(Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9), uu, {==}, {==},
    ec => s1.lc.tab(uu, ec, hl))

# such a character is one str.bad passes, in a one-line string or a
# multi-line one
def s1.sb.go(
  t9: Bool,
  +uu: U32,
  +ml: Bool,
  e9: {U32.is_eq(uu, 9) == t9 : Bool},
  c9: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}
) -> {T.str.bad(uu, ml) == False{} : Bool}:
  match t9:
    case True{}:
      %Equal.sym(U32, uu, 9, s1.is9(uu, e9)) : {T.str.bad(_, ml) == False{} : Bool}
      {==}
    case False{}:
      %Equal.sym(Bool, Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), False{}, Equal.trans(Bool,
        Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9), False{}, c9, e9)) :
        {T.str.bad.go(_, U32.is_eq(uu, 9), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)), ml) == False{} : Bool}
      {==}

# str.bad passes it
def s1.sb(
  +uu: U32,
  +ml: Bool,
  c9: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}
) -> {T.str.bad(uu, ml) == False{} : Bool}:
  s1.sb.go(U32.is_eq(uu, 9), uu, ml, {==}, c9)

# it is no control k other than tab
def s1.nk.go(
  t9: Bool,
  +uu: U32,
  +kk: U32,
  e9: {U32.is_eq(uu, 9) == t9 : Bool},
  c9: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool},
  ek: {Bool.or(U32.is_lt(kk, 32), U32.is_eq(kk, 127)) == True{} : Bool},
  k9: {U32.is_eq(9, kk) == False{} : Bool}
) -> {U32.is_eq(uu, kk) == False{} : Bool}:
  match t9:
    case True{}:
      %Equal.sym(U32, uu, 9, s1.is9(uu, e9)) : {U32.is_eq(_, kk) == False{} : Bool}
      k9
    case False{}:
      ctl.off(uu, kk, Equal.trans(Bool, Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)), U32.is_eq(uu, 9), False{},
        c9, e9), ek)

# no carriage return
def s1.ncr(
  +uu: U32,
  c9: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}
) -> {U32.is_eq(uu, 13) == False{} : Bool}:
  s1.nk.go(U32.is_eq(uu, 9), uu, 13, {==}, c9, {==}, {==})

# no line feed
def s1.nlf(
  +uu: U32,
  c9: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}
) -> {U32.is_eq(uu, 10) == False{} : Bool}:
  s1.nk.go(U32.is_eq(uu, 9), uu, 10, {==}, c9, {==}, {==})

# no newline, as ch.nl tests one
def s1.nnl(
  +uu: U32,
  +c9: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}
) -> {T.ch.nl(Chr{uu}) == False{} : Bool}:
  or.ff(U32.is_eq(uu, 10), U32.is_eq(uu, 13), s1.nlf(uu, c9), s1.ncr(uu, c9))

# basic-unescaped takes no quotation mark
def s1.bu.q(
  +uu: U32,
  hb: {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}
) -> {U32.is_eq(uu, 34) == False{} : Bool}:
  s1.off(cc => Laws.abnf.basic_unescaped(cc), uu, 34, hb, {==})

# and no backslash
def s1.bu.b(
  +uu: U32,
  hb: {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}
) -> {U32.is_eq(uu, 92) == False{} : Bool}:
  s1.off(cc => Laws.abnf.basic_unescaped(cc), uu, 92, hb, {==})

# literal-char takes no apostrophe
def s1.lc.a(
  +uu: U32,
  hl: {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool}
) -> {U32.is_eq(uu, 39) == False{} : Bool}:
  s1.off(cc => Laws.abnf.literal_char(cc), uu, 39, hl, {==})

# A basic string in LStr, one piece at a time. A one-line string's plain
# characters take the fast step (read.fast.basic), and a multi-line string's
# take the full step (lex.str); an escape goes through LEsc and a \u or \U
# escape through LUni in both. The string's state is fs.st with lex LStr,
# its characters so far reversed in buf; each piece pushes the character it
# stands for and keeps back, and the rest is read from whatever uni and left
# the piece leaves.

# the kind of a basic string: a multi-line one's when ml, a one-line one's
# otherwise
def s1.bk(ml: Bool) -> T.QKind:
  match ml:
    case True{}:
      T.QMulti{}
    case False{}:
      T.QBasic{}

# the rest of the text read from a string of kind qk in LStr with buf in its
# buffer, whatever back, uni and left are
def s1.Then(
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @b2: T.Lex -> @u2: U32 -> @l2: U32 ->
    PP(T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, b2, qk, sk, u2, l2, ab)}))

# the scan mode reads a character that is no carriage return by the fast
# step, and doc.wrap leaves that step's state as it is when it opens no string
def s1.scq(
  dq: Bool,
  sq: Bool,
  cr: Bool,
  +st: T.St,
  +cc: Char,
  +s2: T.St,
  hr: {cr == False{} : Bool},
  fast: {T.read.fast(st, cc) == s2 : T.St},
  hw: {T.doc.wrap(s2) == T.MScan{s2} : T.Mode}
) -> {T.doc.scan.q(dq, sq, cr, st, cc) == T.MScan{s2} : T.Mode}:
  match dq sq cr:
    case True{} _s _c:
      Equal.trans(T.Mode, T.doc.wrap(T.read.fast(st, cc)), T.doc.wrap(s2), T.MScan{s2},
        Equal.cong(T.St, T.Mode, xs => T.doc.wrap(xs), T.read.fast(st, cc), s2, fast), hw)
    case False{} True{} _c:
      Equal.trans(T.Mode, T.doc.wrap(T.read.fast(st, cc)), T.doc.wrap(s2), T.MScan{s2},
        Equal.cong(T.St, T.Mode, xs => T.doc.wrap(xs), T.read.fast(st, cc), s2, fast), hw)
    case False{} False{} True{}:
      Eq.bit.absurd2(&2, {T.doc.scan.q(False{}, False{}, True{}, st, cc) == T.MScan{s2} : T.Mode}, hr)
    case False{} False{} False{}:
      Equal.cong(T.St, T.Mode, xs => T.MScan{xs}, T.read.fast(st, cc), s2, fast)

# a one-line string's fast step pushes a character that is no quotation
# mark and no backslash, and that str.bad passes
def s1.fb(
  quote: Bool,
  bs: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool},
  hb: {bs == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.read.fast.basic(quote, bs, bd, rw, hs, he, ps, buf, bk, sk, un, lf, ab, Chr{uu})
  == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, ab) : T.St}:
  match quote bs:
    case True{} b2:
      Eq.bit.absurd2(&2, {T.read.fast.basic(True{}, b2, bd, rw, hs, he, ps, buf, bk, sk, un, lf, ab, Chr{uu})
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, ab) : T.St}, hq)
    case False{} True{}:
      Eq.bit.absurd2(&2, {T.read.fast.basic(False{}, True{}, bd, rw, hs, he, ps, buf, bk, sk, un, lf, ab, Chr{uu})
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, ab) : T.St}, hb)
    case False{} False{}:
      %Equal.sym(Bool, T.str.bad(uu, False{}), False{}, sb) : {T.read.fast.push(_, bd, rw, hs, he, ps, buf,
        T.LStr{}, bk, T.QBasic{}, sk, un, lf, ab, Chr{uu})
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, ab) : T.St}
      {==}

# a multi-line string's full step pushes a character that is no backslash
# and that str.bad passes
def s1.fm2(
  bs: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hb: {bs == False{} : Bool},
  sb: {T.str.bad(uu, True{}) == False{} : Bool}
) -> {T.read.once2(T.lex.str.bs(bs, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab),
  Chr{uu}, T.QMulti{})) == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab) : T.St}:
  match bs:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.str.bs(True{}, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk,
        T.QMulti{}, sk, un, lf, ab), Chr{uu}, T.QMulti{}))
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab) : T.St}, hb)
    case False{}:
      %Equal.sym(Bool, T.str.bad(uu, True{}), False{}, sb) : {T.read.once2(T.lex.str.char.go(_, fs.st(bd, rw, hs, he,
        ps, buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab), Chr{uu}))
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab) : T.St}
      {==}

# and that is no quotation mark
def s1.fm(
  quote: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool},
  hb: {U32.is_eq(uu, 92) == False{} : Bool},
  sb: {T.str.bad(uu, True{}) == False{} : Bool}
) -> {T.read.once2(T.lex.str.go(quote, True{}, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMulti{}, sk,
  un, lf, ab), Chr{uu}, T.QMulti{}))
  == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab) : T.St}:
  match quote:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.str.go(True{}, True{}, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{},
        bk, T.QMulti{}, sk, un, lf, ab), Chr{uu}, T.QMulti{}))
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab) : T.St}, hq)
    case False{}:
      s1.fm2(U32.is_eq(uu, 92), uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, hb, sb)

# the step of a basic string's character that is no quotation mark and no
# backslash, and that str.bad passes, pushes it, one-line or multi-line
def s1.fast.ch(
  ml: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  e34: {U32.is_eq(uu, 34) == False{} : Bool},
  e92: {U32.is_eq(uu, 92) == False{} : Bool},
  sb0: {T.str.bad(uu, False{}) == False{} : Bool},
  sb1: {T.str.bad(uu, True{}) == False{} : Bool}
) -> {T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab), Chr{uu})
  == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab) : T.St}:
  match ml:
    case False{}:
      s1.fb(U32.is_eq(uu, 34), U32.is_eq(uu, 92), uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, e34, e92, sb0)
    case True{}:
      s1.fm(U32.is_eq(uu, 34), uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, e34, e92, sb1)

# a character basic-unescaped takes is pushed, and back, uni and left stay
def s1.chr(
  +ml: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hb: {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool},
  ih: s1.Then(s1.bk(ml), bd, rw, hs, he, ps, sk, ab, Chr{uu} <> buf, rest, PP)
) -> PP(T.doc.read(SCon{Chr{uu}, rest}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf,
  ab)})):
  +c9 = {s1.bu.c9(uu, hb) : {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}}
  pp.step(PP,
    T.doc.read(SCon{Chr{uu}, rest}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab)}),
    T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab)}),
    Equal.cong(T.Mode, T.Doc, md => T.doc.read(rest, md),
      T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab), Chr{uu}),
      T.MScan{fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab)},
      s1.scq(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
        fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab), Chr{uu},
        fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab), s1.ncr(uu, c9),
        s1.fast.ch(ml, uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, s1.bu.q(uu, hb), s1.bu.b(uu, hb),
          s1.sb(uu, False{}, c9), s1.sb(uu, True{}, c9)), {==})),
    ih(bk, un, lf))

# a two-character escape pushes the character it stands for, and back, uni
# and left stay
def s1.esc(
  mm: Laws.KMark,
  ml: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  ih: s1.Then(s1.bk(ml), bd, rw, hs, he, ps, sk, ab, Laws.k3.mark.dec(mm) <> buf, rest, PP)
) -> PP(T.doc.read(SCon{'\\', SCon{Laws.k3.mark.char(mm), rest}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{},
  bk, s1.bk(ml), sk, un, lf, ab)})):
  match mm ml:
    case Laws.KmQuote{} False{}:
      ih(bk, un, lf)
    case Laws.KmQuote{} True{}:
      ih(bk, un, lf)
    case Laws.KmBack{} False{}:
      ih(bk, un, lf)
    case Laws.KmBack{} True{}:
      ih(bk, un, lf)
    case Laws.KmB{} False{}:
      ih(bk, un, lf)
    case Laws.KmB{} True{}:
      ih(bk, un, lf)
    case Laws.KmF{} False{}:
      ih(bk, un, lf)
    case Laws.KmF{} True{}:
      ih(bk, un, lf)
    case Laws.KmN{} False{}:
      ih(bk, un, lf)
    case Laws.KmN{} True{}:
      ih(bk, un, lf)
    case Laws.KmR{} False{}:
      ih(bk, un, lf)
    case Laws.KmR{} True{}:
      ih(bk, un, lf)
    case Laws.KmT{} False{}:
      ih(bk, un, lf)
    case Laws.KmT{} True{}:
      ih(bk, un, lf)

# a digit of a \u or \U escape that is not the last one joins the number
# read so far, and one digit fewer is left, whatever kind the string is
def s1.hx.mid(
  +hx: Laws.KHex,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  el: {U32.is_eq(lf, 1) == False{} : Bool}
) -> {fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), ab)
  == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab), Laws.k3.hex.char(hx)) : T.St}:
  %k3.hx.ok(hx) : {fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), ab)
    == T.read.once2(T.uni.go(_, fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab),
    Laws.k3.hex.char(hx), T.LStr{}, un, lf)) : T.St}
  %k3.hx.dv(hx) : {fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), ab)
    == T.read.once2(T.uni.next(U32.is_eq(lf, 1), fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab),
    U32.add(U32.mul(un, 16), _), T.LStr{}, lf)) : T.St}
  %Equal.sym(Bool, U32.is_eq(lf, 1), False{}, el) : {fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk,
    Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), ab) == T.read.once2(T.uni.next(_, fs.st(bd, rw, hs, he, ps, buf,
    T.LUni{}, bk, qk, sk, un, lf, ab), Laws.k3.hex.acc(un, hx), T.LStr{}, lf)) : T.St}
  {==}

# the last digit: the number is a Unicode scalar value, pushed as the
# character, and the string's state is back with uni and left at 0
def s1.hx.last(
  +hx: Laws.KHex,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  el: {U32.is_eq(lf, 1) == True{} : Bool},
  eo: {Laws.k3.scalar(Laws.k3.hex.acc(un, hx)) == True{} : Bool}
) -> {fs.st(bd, rw, hs, he, ps, Chr{Laws.k3.hex.acc(un, hx)} <> buf, T.LStr{}, bk, qk, sk, 0, 0, ab)
  == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab), Laws.k3.hex.char(hx)) : T.St}:
  %k3.hx.ok(hx) : {fs.st(bd, rw, hs, he, ps, Chr{Laws.k3.hex.acc(un, hx)} <> buf, T.LStr{}, bk, qk, sk, 0, 0, ab)
    == T.read.once2(T.uni.go(_, fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab),
    Laws.k3.hex.char(hx), T.LStr{}, un, lf)) : T.St}
  %k3.hx.dv(hx) : {fs.st(bd, rw, hs, he, ps, Chr{Laws.k3.hex.acc(un, hx)} <> buf, T.LStr{}, bk, qk, sk, 0, 0, ab)
    == T.read.once2(T.uni.next(U32.is_eq(lf, 1), fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab),
    U32.add(U32.mul(un, 16), _), T.LStr{}, lf)) : T.St}
  %Equal.sym(Bool, U32.is_eq(lf, 1), True{}, el) : {fs.st(bd, rw, hs, he, ps, Chr{Laws.k3.hex.acc(un, hx)} <> buf,
    T.LStr{}, bk, qk, sk, 0, 0, ab) == T.read.once2(T.uni.next(_, fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk,
    un, lf, ab), Laws.k3.hex.acc(un, hx), T.LStr{}, lf)) : T.St}
  %Equal.sym(Bool, T.uni.ok(Laws.k3.hex.acc(un, hx)), True{}, eo) : {fs.st(bd, rw, hs, he, ps,
    Chr{Laws.k3.hex.acc(un, hx)} <> buf, T.LStr{}, bk, qk, sk, 0, 0, ab) == T.read.once2(T.uni.finish(_, fs.st(bd,
    rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab), Laws.k3.hex.acc(un, hx), T.LStr{})) : T.St}
  {==}

# a digit that is not the last one, read from the text
def s1.hx.rmid(
  +hx: Laws.KHex,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  el: {U32.is_eq(lf, 1) == False{} : Bool}
) -> {T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, Laws.k3.hex.acc(un, hx),
  U32.sub(lf, 1), ab)}) == T.doc.read(SCon{Laws.k3.hex.char(hx), rest}, T.MScan{fs.st(bd, rw, hs, he, ps, buf,
  T.LUni{}, bk, qk, sk, un, lf, ab)}) : T.Doc}:
  %k3.hx.scan(hx, fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab)) : {T.doc.read(rest,
    T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), ab)})
    == T.doc.read(rest, _) : T.Doc}
  %s1.hx.mid(hx, qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, el) : {T.doc.read(rest, T.MScan{fs.st(bd, rw, hs,
    he, ps, buf, T.LUni{}, bk, qk, sk, Laws.k3.hex.acc(un, hx), U32.sub(lf, 1), ab)}) == T.doc.read(rest, T.MScan{_})
    : T.Doc}
  {==}

# the last digit, read from the text
def s1.hx.rlast(
  +hx: Laws.KHex,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  el: {U32.is_eq(lf, 1) == True{} : Bool},
  eo: {Laws.k3.scalar(Laws.k3.hex.acc(un, hx)) == True{} : Bool}
) -> {T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, Chr{Laws.k3.hex.acc(un, hx)} <> buf, T.LStr{}, bk, qk, sk,
  0, 0, ab)}) == T.doc.read(SCon{Laws.k3.hex.char(hx), rest}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk,
  qk, sk, un, lf, ab)}) : T.Doc}:
  %k3.hx.scan(hx, fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, qk, sk, un, lf, ab)) : {T.doc.read(rest,
    T.MScan{fs.st(bd, rw, hs, he, ps, Chr{Laws.k3.hex.acc(un, hx)} <> buf, T.LStr{}, bk, qk, sk, 0, 0, ab)})
    == T.doc.read(rest, _) : T.Doc}
  %s1.hx.last(hx, qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, el, eo) : {T.doc.read(rest, T.MScan{fs.st(bd, rw,
    hs, he, ps, Chr{Laws.k3.hex.acc(un, hx)} <> buf, T.LStr{}, bk, qk, sk, 0, 0, ab)}) == T.doc.read(rest,
    T.MScan{_}) : T.Doc}
  {==}

# a backslash and u (U when lg) start an escape of four digits (eight),
# with back where it was
def s1.hx.open(
  +lg: Bool,
  +ml: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String
) -> {T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LUni{}, bk, s1.bk(ml), sk, 0, k3.hx.n(lg), ab)})
  == T.doc.read(SCon{'\\', SCon{k3.hx.u(lg), rest}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml),
  sk, un, lf, ab)}) : T.Doc}:
  match lg ml:
    case False{} False{}:
      {==}
    case False{} True{}:
      {==}
    case True{} False{}:
      {==}
    case True{} True{}:
      {==}

# `\u` and four digits push the character they name, and leave back where it
# was and uni and left at 0
def s1.u4(
  +dd: Laws.KHex,
  +cc: Laws.KHex,
  +bb: Laws.KHex,
  +aa: Laws.KHex,
  +ml: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  eo: {Laws.k3.scalar(Laws.k3.hex4(dd, cc, bb, aa)) == True{} : Bool},
  ih: s1.Then(s1.bk(ml), bd, rw, hs, he, ps, sk, ab, Chr{Laws.k3.hex4(dd, cc, bb, aa)} <> buf, rest, PP)
) -> PP(T.doc.read(Laws.k3.pc.text(Laws.KpU4{dd, cc, bb, aa}, rest), T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{},
  bk, s1.bk(ml), sk, un, lf, ab)})):
  +qk = {s1.bk(ml) : T.QKind}
  %s1.hx.open(False{}, ml, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.k3.hex4.text(dd, cc, bb, aa, rest))
    : PP(_)
  %s1.hx.rmid(dd, qk, bd, rw, hs, he, ps, sk, ab, bk, 0, 4, buf, SCon{Laws.k3.hex.char(cc),
    SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa), rest}}}, {==}) : PP(_)
  %s1.hx.rmid(cc, qk, bd, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(0, dd), 3, buf,
    SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa), rest}}, {==}) : PP(_)
  %s1.hx.rmid(bb, qk, bd, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(Laws.k3.hex.acc(0, dd), cc), 2, buf,
    SCon{Laws.k3.hex.char(aa), rest}, {==}) : PP(_)
  %s1.hx.rlast(aa, qk, bd, rw, hs, he, ps, sk, ab, bk, Laws.k3.hex.acc(Laws.k3.hex.acc(Laws.k3.hex.acc(0, dd), cc),
    bb), 1, buf, rest, {==}, eo) : PP(_)
  ih(bk, 0, 0)

# the number eight digits write
def s1.h8(
  hh: Laws.KHex,
  gg: Laws.KHex,
  ff: Laws.KHex,
  ee: Laws.KHex,
  dd: Laws.KHex,
  cc: Laws.KHex,
  bb: Laws.KHex,
  aa: Laws.KHex
) -> U32:
  Laws.k3.hex8(hh, gg, ff, ee, dd, cc, bb, aa)

# `\U` and eight digits push the character they name, and leave back where
# it was and uni and left at 0
def s1.u8(
  +hh: Laws.KHex,
  +gg: Laws.KHex,
  +ff: Laws.KHex,
  +ee: Laws.KHex,
  +dd: Laws.KHex,
  +cc: Laws.KHex,
  +bb: Laws.KHex,
  +aa: Laws.KHex,
  +ml: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  eo: {Laws.k3.scalar(Laws.k3.hex8(hh, gg, ff, ee, dd, cc, bb, aa)) == True{} : Bool},
  ih: s1.Then(s1.bk(ml), bd, rw, hs, he, ps, sk, ab, Chr{s1.h8(hh, gg, ff, ee, dd, cc, bb, aa)} <> buf, rest, PP)
) -> PP(T.doc.read(Laws.k3.pc.text(Laws.KpU8{hh, gg, ff, ee, dd, cc, bb, aa}, rest), T.MScan{fs.st(bd, rw, hs, he, ps,
  buf, T.LStr{}, bk, s1.bk(ml), sk, un, lf, ab)})):
  +qk = {s1.bk(ml) : T.QKind}
  +t4 = Laws.k3.hex4.text(dd, cc, bb, aa, rest)
  +a1 = Laws.k3.hex.acc(0, hh)
  +a2 = Laws.k3.hex.acc(a1, gg)
  +a3 = Laws.k3.hex.acc(a2, ff)
  +a4 = Laws.k3.hex.acc(a3, ee)
  +a5 = Laws.k3.hex.acc(a4, dd)
  +a6 = Laws.k3.hex.acc(a5, cc)
  +a7 = Laws.k3.hex.acc(a6, bb)
  %s1.hx.open(True{}, ml, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.k3.hex4.text(hh, gg, ff, ee, t4)) : PP(_)
  %s1.hx.rmid(hh, qk, bd, rw, hs, he, ps, sk, ab, bk, 0, 8, buf, SCon{Laws.k3.hex.char(gg), SCon{Laws.k3.hex.char(ff),
    SCon{Laws.k3.hex.char(ee), t4}}}, {==}) : PP(_)
  %s1.hx.rmid(gg, qk, bd, rw, hs, he, ps, sk, ab, bk, a1, 7, buf, SCon{Laws.k3.hex.char(ff), SCon{Laws.k3.hex.char(ee),
    t4}}, {==}) : PP(_)
  %s1.hx.rmid(ff, qk, bd, rw, hs, he, ps, sk, ab, bk, a2, 6, buf, SCon{Laws.k3.hex.char(ee), t4}, {==}) : PP(_)
  %s1.hx.rmid(ee, qk, bd, rw, hs, he, ps, sk, ab, bk, a3, 5, buf, t4, {==}) : PP(_)
  %s1.hx.rmid(dd, qk, bd, rw, hs, he, ps, sk, ab, bk, a4, 4, buf, SCon{Laws.k3.hex.char(cc),
    SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa), rest}}}, {==}) : PP(_)
  %s1.hx.rmid(cc, qk, bd, rw, hs, he, ps, sk, ab, bk, a5, 3, buf, SCon{Laws.k3.hex.char(bb), SCon{Laws.k3.hex.char(aa),
    rest}}, {==}) : PP(_)
  %s1.hx.rmid(bb, qk, bd, rw, hs, he, ps, sk, ab, bk, a6, 2, buf, SCon{Laws.k3.hex.char(aa), rest}, {==}) : PP(_)
  %s1.hx.rlast(aa, qk, bd, rw, hs, he, ps, sk, ab, bk, a7, 1, buf, rest, {==}, eo) : PP(_)
  ih(bk, 0, 0)

# one piece a basic string may hold pushes the character it stands for
def s1.pc(
  pp: Laws.KPiece,
  +ml: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hc: {Laws.abnf.basic_char(pp) == True{} : Bool},
  eo: {Laws.prose.escape_scalar(pp) == True{} : Bool},
  ih: s1.Then(s1.bk(ml), bd, rw, hs, he, ps, sk, ab, Laws.k3.pc.char(pp) <> buf, rest, PP)
) -> PP(T.doc.read(Laws.k3.pc.text(pp, rest), T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml), sk, un,
  lf, ab)})):
  match pp:
    case Laws.KpChar{cc}:
      match cc:
        case Chr{+uu}:
          s1.chr(ml, uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hc, ih)
    case Laws.KpEsc{mm}:
      s1.esc(mm, ml, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, ih)
    case Laws.KpU4{+dd, +cc, +bb, +aa}:
      s1.u4(dd, cc, bb, aa, ml, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, eo, ih)
    case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
      s1.u8(hh, gg, ff, ee, dd, cc, bb, aa, ml, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, eo, ih)

# every piece of a list a basic string may hold, in order: the rest is read
# with their characters pushed, from wherever the last piece left back, uni
# and left
def s1.pcs(
  pl: List<&2, Laws.KPiece>,
  +ml: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hc: {Laws.abnf.basic_string(pl) == True{} : Bool},
  +eo: {Laws.prose.escapes_scalar(pl) == True{} : Bool},
  ih: s1.Then(s1.bk(ml), bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.k3.pcs.name(pl), buf), rest, PP)
) -> PP(T.doc.read(Laws.k3.pcs.text(pl, rest), T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.bk(ml), sk,
  un, lf, ab)})):
  match pl:
    case []:
      ih(bk, un, lf)
    case +pp <> +pr:
      s1.pc(pp, ml, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.k3.pcs.text(pr, rest), PP,
        Eq.and.left(Laws.abnf.basic_char(pp), Laws.abnf.basic_string(pr), hc),
        Eq.and.left(Laws.prose.escape_scalar(pp), Laws.prose.escapes_scalar(pr), eo),
        +b2 => +u2 => +l2 => s1.pcs(pr, ml, bd, rw, hs, he, ps, sk, ab, b2, u2, l2, Laws.k3.pc.char(pp) <> buf, rest,
          PP, Eq.and.right(Laws.abnf.basic_char(pp), Laws.abnf.basic_string(pr), hc),
          Eq.and.right(Laws.prose.escape_scalar(pp), Laws.prose.escapes_scalar(pr), eo), ih))

# The rest of the walk once a string is read. A string of every form places
# a value holding its characters (sv.Is) by take.top; the kind it leaves in
# qkind is its own, so s1.Done takes it as a parameter too, as WP-C's vrest
# does, and WP-S's sv.Then is s1.Done at a basic string's kind.

# the rest of the walk for the string ss: reading rest from the scanner with
# any string value holding ss placed, and any back, kind, uni and left, gives
# a document PP holds of
def s1.Done(
  +ss: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @vv: T.Val -> @bk: T.Lex -> @qk: T.QKind -> @un: U32 -> @lf: U32 ->
    sv.Is(vv, ss) ->
    PP(T.doc.read(rest, T.MScan{T.take.top(sk, vv, bd, rw, hs, he, ps, bk, qk, un, lf, ab, False{})}))

# WP-S's rest of the walk is s1.Done at a basic string's kind
def s1.done.sv(
  +ss: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  dn: s1.Done(ss, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> sv.Then(ss, bd, rw, hs, he, ps, sk, ab, rest, PP):
  vv => bk => un => lf => hv => dn(vv, bk, T.QBasic{}, un, lf, hv)

# the rest of the walk for one string serves for another equal to it
def s1.done.cast(
  +s1: String,
  +s2: String,
  e12: {s1 == s2 : String},
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  ih: s1.Done(s1, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> s1.Done(s2, bd, rw, hs, he, ps, sk, ab, rest, PP):
  %e12 : s1.Done(_, bd, rw, hs, he, ps, sk, ab, rest, PP)
  ih

# Texts that may follow a string. Laws.s1.free leaves out a quotation mark
# and an apostrophe first.

# a pair of bits whose or is false: the first is false
def s1.nor.l(
  aa: Bool,
  bb: Bool,
  hh: {Bool.not(Bool.or(aa, bb)) == True{} : Bool}
) -> {aa == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, hh)
    case False{}:
      {==}

# and so is the second
def s1.nor.r(
  aa: Bool,
  bb: Bool,
  hh: {Bool.not(Bool.or(aa, bb)) == True{} : Bool}
) -> {bb == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd(&2, {bb == False{} : Bool}, hh)
    case False{}:
      Eq.not.true(bb, hh)

# a text that may follow a string does not start with a quotation mark
def s1.free.sv(
  rest: String,
  hr: {Laws.s1.free(rest) == True{} : Bool}
) -> {sv.free(rest) == True{} : Bool}:
  match rest:
    case SNil{}:
      {==}
    case SCon{hh, _tt}:
      match hh:
        case Chr{+uu}:
          Equal.cong(Bool, Bool, xx => Bool.not(xx), U32.is_eq(uu, 34), False{},
            s1.nor.l(U32.is_eq(uu, 34), U32.is_eq(uu, 39), hr))

# One-line basic strings. A character written as itself opens WP-S's span
# or grows it; a tab among them, since str.bad passes it. An escape meets a
# backslash, which copies the span into the buffer, and the pieces from it
# on are read in LStr by s1.pcs.

# the first character: str.bad passes it, so the span starts
def s1.so.ok(
  badc: Bool,
  +uu: U32,
  +tail: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hc: {badc == False{} : Bool}
) -> {T.doc.open.ok(badc, True{}, '"', T.QBasic{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu}, tail)
  == sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match badc:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.open.ok(True{}, True{}, '"', T.QBasic{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab,
        Chr{uu}, tail) == sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hc)

# no backslash
def s1.so.bs(
  bs: Bool,
  +uu: U32,
  +tail: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hb: {bs == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.doc.open.bs(bs, '"', T.QBasic{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu}, tail)
  == sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match bs:
    case False{}:
      s1.so.ok(T.str.bad(uu, False{}), uu, tail, bd, rw, hs, he, ps, bk, sk, un, lf, ab, sb)
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.open.bs(True{}, '"', T.QBasic{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu},
        tail) == sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hb)

# no quotation mark
def s1.so.q(
  same: Bool,
  +uu: U32,
  +tail: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hq: {same == False{} : Bool},
  hb: {U32.is_eq(uu, 92) == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.doc.open.q(same, True{}, '"', T.QBasic{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu}, tail)
  == sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match same:
    case False{}:
      s1.so.bs(U32.is_eq(uu, 92), uu, tail, bd, rw, hs, he, ps, bk, sk, un, lf, ab, hb, sb)
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.open.q(True{}, True{}, '"', T.QBasic{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab,
        Chr{uu}, tail) == sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hq)

# a first character that is no quotation mark and no backslash, and that
# str.bad passes, opens the span
def s1.so.one(
  +uu: U32,
  +tail: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  e34: {U32.is_eq(uu, 34) == False{} : Bool},
  e92: {U32.is_eq(uu, 92) == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tail}, sv.open(bd, rw, hs, he, ps, bk, sk, un, lf, ab))
  == T.doc.read(tail, sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab)) : T.Doc}:
  Equal.cong(T.Mode, T.Doc, md => T.doc.read(tail, md),
    T.doc.open(True{}, '"', T.QBasic{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu}, tail),
    sv.eat(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab),
    s1.so.q(U32.is_eq(uu, 34), uu, tail, bd, rw, hs, he, ps, bk, sk, un, lf, ab, e34, e92, sb))

# a later character: str.bad passes it, so the span grows
def s1.se.ctl(
  badc: Bool,
  +uu: U32,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hc: {badc == False{} : Bool}
) -> {T.eat.ctrl(badc, True{}, '"', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QBasic{}, sk, un, lf, ab)
  == sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match badc:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.eat.ctrl(True{}, True{}, '"', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QBasic{}, sk, un, lf,
        ab) == sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hc)

# no backslash
def s1.se.bs(
  bs: Bool,
  +uu: U32,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hb: {bs == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.eat.bs(bs, True{}, '"', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QBasic{}, sk, un, lf, ab)
  == sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match bs:
    case False{}:
      s1.se.ctl(T.str.bad(uu, False{}), uu, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, sb)
    case True{}:
      Eq.bit.absurd2(&2, {T.eat.bs(True{}, True{}, '"', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QBasic{}, sk, un, lf,
        ab) == sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hb)

# no quotation mark
def s1.se.q(
  quote: Bool,
  +uu: U32,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hq: {quote == False{} : Bool},
  hb: {U32.is_eq(uu, 92) == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.eat.feed.q(quote, True{}, '"', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QBasic{}, sk, un, lf, ab)
  == sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match quote:
    case False{}:
      s1.se.bs(U32.is_eq(uu, 92), uu, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, hb, sb)
    case True{}:
      Eq.bit.absurd2(&2, {T.eat.feed.q(True{}, True{}, '"', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QBasic{}, sk, un,
        lf, ab) == sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hq)

# a later character that is no quotation mark and no backslash, and that
# str.bad passes, grows the span by one
def s1.se.one(
  +uu: U32,
  +tail: String,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  e34: {U32.is_eq(uu, 34) == False{} : Bool},
  e92: {U32.is_eq(uu, 92) == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tail}, sv.eat(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab))
  == T.doc.read(tail, sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab)) : T.Doc}:
  Equal.cong(T.Mode, T.Doc, md => T.doc.read(tail, md),
    T.eat.feed(True{}, '"', cut, nn, bd, rw, hs, he, ps, T.QBasic{}, sk, un, lf, ab, Chr{uu}),
    sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab),
    s1.se.q(U32.is_eq(uu, 34), uu, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, e34, e92, sb))

# the span's count after one more character is the characters of pre and it,
# when the count does not wrap
def s1.hn(
  +nn: U32,
  +pre: String,
  +cc: Char,
  +tl: String,
  hn: {U32.to_nat(nn) == plus(pre, 0n) : Nat},
  hk: {Laws.counts(SCon{cc, tl}, nn) == True{} : Bool}
) -> {U32.to_nat(U32.add(nn, 1)) == plus(String.append(pre, SCon{cc, SNil{}}), 0n) : Nat}:
  Equal.trans(Nat, U32.to_nat(U32.add(nn, 1)), 1n+U32.to_nat(nn), plus(String.append(pre, SCon{cc, SNil{}}), 0n),
    Eq.inc.nat(nn, Eq.not.true(U32.is_zero(U32.add(nn, 1)), Eq.and.left(Bool.not(U32.is_zero(U32.add(nn, 1))),
      Laws.counts(tl, U32.add(nn, 1)), hk))),
    Equal.trans(Nat, 1n+U32.to_nat(nn), 1n+plus(pre, 0n), plus(String.append(pre, SCon{cc, SNil{}}), 0n),
      Equal.cong(Nat, Nat, kk => 1n+kk, U32.to_nat(nn), plus(pre, 0n), hn),
      Equal.sym(Nat, plus(String.append(pre, SCon{cc, SNil{}}), 0n), 1n+plus(pre, 0n),
        plus.app(pre, SCon{cc, SNil{}}, 0n))))

# the text from pre, then a character and the rest: pre grows by it
def s1.cut(
  +cut: String,
  +pre: String,
  +cc: Char,
  +xx: String,
  hc: {cut == String.append(pre, SCon{cc, xx}) : String}
) -> {cut == String.append(String.append(pre, SCon{cc, SNil{}}), xx) : String}:
  Equal.trans(String, cut, String.append(pre, SCon{cc, xx}), String.append(String.append(pre, SCon{cc, SNil{}}), xx),
    hc, Equal.sym(String, String.append(String.append(pre, SCon{cc, SNil{}}), xx), String.append(pre, SCon{cc, xx}),
    Eq.append_assoc(pre, SCon{cc, SNil{}}, xx)))

# the placement after the copied pieces: the closing quote places the owned
# string, with back where the pieces left it
def s1.close.b(
  +rest: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.doc.read(SCon{'"', rest}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QBasic{}, sk, un, lf, ab)})
  == T.doc.read(rest, T.MScan{sv.took(sk, T.VStr{T.buf.str(buf)}, bd, rw, hs, he, ps, bk, un, lf, ab)}) : T.Doc}:
  Equal.cong(T.Mode, T.Doc, md => T.doc.read(rest, md),
    T.doc.wrap(T.read.once2(sv.took(sk, T.VStr{T.buf.str(buf)}, bd, rw, hs, he, ps, bk, un, lf, ab))),
    T.MScan{sv.took(sk, T.VStr{T.buf.str(buf)}, bd, rw, hs, he, ps, bk, un, lf, ab)},
    tk.fix(sk, T.VStr{T.buf.str(buf)}, bd, rw, hs, he, ps, bk, T.QBasic{}, un, lf, ab, False{}))

# the pieces from a copied span on, then the closing quote: read from a
# buffer holding pre, they place an owned string of pre and their characters
def s1.cp(
  +pl: List<&2, Laws.KPiece>,
  +pre: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +un: U32,
  +lf: U32,
  +rest: String,
  -PP: T.Doc -> Type,
  hc: {Laws.abnf.basic_string(pl) == True{} : Bool},
  eo: {Laws.prose.escapes_scalar(pl) == True{} : Bool},
  ih: sv.Then(String.append(pre, Laws.k3.pcs.name(pl)), bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), T.MScan{fs.st(bd, rw, hs, he, ps, rev.onto(pre, []),
  T.LStr{}, T.LStr{}, T.QBasic{}, sk, un, lf, ab)})):
  s1.pcs(pl, False{}, bd, rw, hs, he, ps, sk, ab, T.LStr{}, un, lf, rev.onto(pre, []), SCon{'"', rest}, PP, hc, eo,
    +b2 => +u2 => +l2 => pp.step(PP,
      T.doc.read(SCon{'"', rest}, T.MScan{fs.st(bd, rw, hs, he, ps, rev.onto(Laws.k3.pcs.name(pl), rev.onto(pre, [])),
        T.LStr{}, b2, T.QBasic{}, sk, u2, l2, ab)}),
      T.doc.read(rest, T.MScan{sv.took(sk, T.VStr{T.buf.str(rev.onto(Laws.k3.pcs.name(pl), rev.onto(pre, [])))}, bd,
        rw, hs, he, ps, b2, u2, l2, ab)}),
      s1.close.b(rest, bd, rw, hs, he, ps, sk, ab, b2, u2, l2, rev.onto(Laws.k3.pcs.name(pl), rev.onto(pre, []))),
      ih(T.VStr{T.buf.str(rev.onto(Laws.k3.pcs.name(pl), rev.onto(pre, [])))}, b2, u2, l2,
        ls.own(pre, Laws.k3.pcs.name(pl)))))

# the span meets a backslash where the pieces start: it copies itself
def s1.SgEq(
  +pl: List<&2, Laws.KPiece>,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String
) -> Type:
  {T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), sv.eat(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab))
    == T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), T.MScan{ls(bd, rw, hs, he, ps, sk, ab, un, lf,
    T.span.rev(cut, nn, U32.is_zero(nn), []))}) : T.Doc}

# an escape inside the span: the backslash copies the span, which holds pre,
# and the pieces from the escape on are read in LStr
def s1.sg.cp(
  +pl: List<&2, Laws.KPiece>,
  +pre: String,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  eq: s1.SgEq(pl, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, rest),
  hc: {cut == String.append(pre, Laws.k3.pcs.text(pl, SCon{'"', rest})) : String},
  hn: {U32.to_nat(nn) == plus(pre, 0n) : Nat},
  hb: {Laws.abnf.basic_string(pl) == True{} : Bool},
  eo: {Laws.prose.escapes_scalar(pl) == True{} : Bool},
  ih: sv.Then(String.append(pre, Laws.k3.pcs.name(pl)), bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), sv.eat(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab))):
  pp.step(PP,
    T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), sv.eat(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab)),
    T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), T.MScan{ls(bd, rw, hs, he, ps, sk, ab, un, lf,
      T.span.rev(cut, nn, U32.is_zero(nn), []))}),
    eq,
    pp.step(PP,
      T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), T.MScan{ls(bd, rw, hs, he, ps, sk, ab, un, lf,
        T.span.rev(cut, nn, U32.is_zero(nn), []))}),
      T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), T.MScan{ls(bd, rw, hs, he, ps, sk, ab, un, lf,
        rev.onto(pre, []))}),
      Equal.cong(List<&2, Char>, T.Doc, bb => T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), T.MScan{ls(bd, rw, hs,
        he, ps, sk, ab, un, lf, bb)}), T.span.rev(cut, nn, U32.is_zero(nn), []), rev.onto(pre, []),
        se.rev(pre, cut, Laws.k3.pcs.text(pl, SCon{'"', rest}), nn, hc, hn)),
      s1.cp(pl, pre, bd, rw, hs, he, ps, sk, ab, un, lf, rest, PP, hb, eo, ih)))

# the rest pl of a string inside its span, pre read so far: cut is the text
# from the string's first character, and nn counts pre's characters without
# wrapping. The string reads to a value holding pre and the characters pl
# stands for: the span itself when pl holds no escape, and the copied string
# otherwise
def s1.sg(
  pl: List<&2, Laws.KPiece>,
  +pre: String,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hc: {cut == String.append(pre, Laws.k3.pcs.text(pl, SCon{'"', rest})) : String},
  +hn: {U32.to_nat(nn) == plus(pre, 0n) : Nat},
  +hk: {Laws.counts(Laws.k3.pcs.name(pl), nn) == True{} : Bool},
  +hb: {Laws.abnf.basic_string(pl) == True{} : Bool},
  +eo: {Laws.prose.escapes_scalar(pl) == True{} : Bool},
  ih: sv.Then(String.append(pre, Laws.k3.pcs.name(pl)), bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), sv.eat(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab))):
  match pl:
    case []:
      pp.step(PP,
        T.doc.read(SCon{'"', rest}, sv.eat(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab)),
        T.doc.read(rest, T.MScan{sv.took(sk, T.VSpan{cut, nn}, bd, rw, hs, he, ps, T.LStr{}, un, lf, ab)}),
        se.close(rest, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab),
        sv.then.cast(String.append(pre, SNil{}), pre, Eq.append_nil(pre), bd, rw, hs, he, ps, sk, ab, rest, PP, ih)(
          T.VSpan{cut, nn}, T.LStr{}, un, lf, se.own(pre, cut, SCon{'"', rest}, nn, hc, hn)))
    case +kp <> +pr:
      match kp:
        case Laws.KpChar{cc}:
          match cc:
            case Chr{+uu}:
              +tx = {Laws.k3.pcs.text(pr, SCon{'"', rest}) : String}
              +hb0 = {Eq.and.left(Laws.abnf.basic_unescaped(Chr{uu}), Laws.abnf.basic_string(pr), hb)
                : {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}}
              +c9 = {s1.bu.c9(uu, hb0) : {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}}
              pp.step(PP,
                T.doc.read(SCon{Chr{uu}, tx}, sv.eat(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab)),
                T.doc.read(tx, sv.eat(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab)),
                s1.se.one(uu, tx, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, s1.bu.q(uu, hb0), s1.bu.b(uu, hb0),
                  s1.sb(uu, False{}, c9)),
                s1.sg(pr, String.append(pre, SCon{Chr{uu}, SNil{}}), cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un,
                  lf, ab, rest, PP, s1.cut(cut, pre, Chr{uu}, tx, hc),
                  s1.hn(nn, pre, Chr{uu}, Laws.k3.pcs.name(pr), hn, hk),
                  Eq.and.right(Bool.not(U32.is_zero(U32.add(nn, 1))), Laws.counts(Laws.k3.pcs.name(pr), U32.add(nn, 1)),
                    hk),
                  Eq.and.right(Laws.abnf.basic_unescaped(Chr{uu}), Laws.abnf.basic_string(pr), hb),
                  Eq.and.right(True{}, Laws.prose.escapes_scalar(pr), eo),
                  sv.then.cast(String.append(pre, SCon{Chr{uu}, Laws.k3.pcs.name(pr)}),
                    String.append(String.append(pre, SCon{Chr{uu}, SNil{}}), Laws.k3.pcs.name(pr)),
                    Equal.sym(String, String.append(String.append(pre, SCon{Chr{uu}, SNil{}}), Laws.k3.pcs.name(pr)),
                      String.append(pre, SCon{Chr{uu}, Laws.k3.pcs.name(pr)}),
                      Eq.append_assoc(pre, SCon{Chr{uu}, SNil{}}, Laws.k3.pcs.name(pr))),
                    bd, rw, hs, he, ps, sk, ab, rest, PP, ih)))
        case Laws.KpEsc{mm}:
          s1.sg.cp(Laws.KpEsc{mm} <> pr, pre, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, rest, PP,
            se.copy(SCon{Laws.k3.mark.char(mm), Laws.k3.pcs.text(pr, SCon{'"', rest})}, cut, nn, bd, rw, hs, he, ps,
              sk, un, lf, ab), hc, hn, hb, eo, ih)
        case Laws.KpU4{+dd, +cc, +bb, +aa}:
          s1.sg.cp(Laws.KpU4{dd, cc, bb, aa} <> pr, pre, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, rest, PP,
            se.copy(SCon{'u', Laws.k3.hex4.text(dd, cc, bb, aa, Laws.k3.pcs.text(pr, SCon{'"', rest}))}, cut, nn, bd,
              rw, hs, he, ps, sk, un, lf, ab), hc, hn, hb, eo, ih)
        case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
          s1.sg.cp(Laws.KpU8{hh, gg, ff, ee, dd, cc, bb, aa} <> pr, pre, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab,
            rest, PP, se.copy(SCon{'U', Laws.k3.hex4.text(hh, gg, ff, ee, Laws.k3.hex4.text(dd, cc, bb, aa,
              Laws.k3.pcs.text(pr, SCon{'"', rest})))}, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab), hc, hn, hb, eo,
            ih)

# a one-line basic string of pieces, after its opening quote, then the
# closing quote and a rest that does not start with a quote: from every
# value position the rest is read with a value holding the pieces'
# characters placed
def s1.bo(
  pl: List<&2, Laws.KPiece>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hk: {Laws.short(Laws.k3.pcs.name(pl)) == True{} : Bool},
  +hb: {Laws.abnf.basic_string(pl) == True{} : Bool},
  +eo: {Laws.prose.escapes_scalar(pl) == True{} : Bool},
  hr: {sv.free(rest) == True{} : Bool},
  ih: sv.Then(Laws.k3.pcs.name(pl), bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.k3.pcs.text(pl, SCon{'"', rest}), sv.open(bd, rw, hs, he, ps, bk, sk, un, lf, ab))):
  match pl:
    case []:
      sv.empty(bd, rw, hs, he, ps, bk, sk, un, lf, ab, rest, PP, hr, ih)
    case +kp <> +pr:
      match kp:
        case Laws.KpChar{cc}:
          match cc:
            case Chr{+uu}:
              +tx = {Laws.k3.pcs.text(pr, SCon{'"', rest}) : String}
              +hb0 = {Eq.and.left(Laws.abnf.basic_unescaped(Chr{uu}), Laws.abnf.basic_string(pr), hb)
                : {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}}
              +c9 = {s1.bu.c9(uu, hb0) : {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}}
              pp.step(PP,
                T.doc.read(SCon{Chr{uu}, tx}, sv.open(bd, rw, hs, he, ps, bk, sk, un, lf, ab)),
                T.doc.read(tx, sv.eat(SCon{Chr{uu}, tx}, 1, bd, rw, hs, he, ps, sk, un, lf, ab)),
                s1.so.one(uu, tx, bd, rw, hs, he, ps, bk, sk, un, lf, ab, s1.bu.q(uu, hb0), s1.bu.b(uu, hb0),
                  s1.sb(uu, False{}, c9)),
                s1.sg(pr, SCon{Chr{uu}, SNil{}}, SCon{Chr{uu}, tx}, 1, bd, rw, hs, he, ps, sk, un, lf, ab, rest, PP,
                  {==}, {==},
                  Eq.and.right(Bool.not(U32.is_zero(U32.add(0, 1))), Laws.counts(Laws.k3.pcs.name(pr), U32.add(0, 1)),
                    hk),
                  Eq.and.right(Laws.abnf.basic_unescaped(Chr{uu}), Laws.abnf.basic_string(pr), hb),
                  Eq.and.right(True{}, Laws.prose.escapes_scalar(pr), eo), ih))
        case Laws.KpEsc{mm}:
          pp.step(PP,
            T.doc.read(SCon{'\\', SCon{Laws.k3.mark.char(mm), Laws.k3.pcs.text(pr, SCon{'"', rest})}},
              sv.open(bd, rw, hs, he, ps, bk, sk, un, lf, ab)),
            T.doc.read(SCon{'\\', SCon{Laws.k3.mark.char(mm), Laws.k3.pcs.text(pr, SCon{'"', rest})}},
              T.MScan{ls(bd, rw, hs, he, ps, sk, ab, un, lf, [])}),
            so.copy(SCon{Laws.k3.mark.char(mm), Laws.k3.pcs.text(pr, SCon{'"', rest})}, bd, rw, hs, he, ps, bk, sk, un,
              lf, ab),
            s1.cp(Laws.KpEsc{mm} <> pr, SNil{}, bd, rw, hs, he, ps, sk, ab, un, lf, rest, PP, hb, eo, ih))
        case Laws.KpU4{+dd, +cc, +bb, +aa}:
          +xx = {SCon{'u', Laws.k3.hex4.text(dd, cc, bb, aa, Laws.k3.pcs.text(pr, SCon{'"', rest}))} : String}
          pp.step(PP,
            T.doc.read(SCon{'\\', xx}, sv.open(bd, rw, hs, he, ps, bk, sk, un, lf, ab)),
            T.doc.read(SCon{'\\', xx}, T.MScan{ls(bd, rw, hs, he, ps, sk, ab, un, lf, [])}),
            so.copy(xx, bd, rw, hs, he, ps, bk, sk, un, lf, ab),
            s1.cp(Laws.KpU4{dd, cc, bb, aa} <> pr, SNil{}, bd, rw, hs, he, ps, sk, ab, un, lf, rest, PP, hb, eo, ih))
        case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
          +xx = {SCon{'U', Laws.k3.hex4.text(hh, gg, ff, ee, Laws.k3.hex4.text(dd, cc, bb, aa,
            Laws.k3.pcs.text(pr, SCon{'"', rest})))} : String}
          pp.step(PP,
            T.doc.read(SCon{'\\', xx}, sv.open(bd, rw, hs, he, ps, bk, sk, un, lf, ab)),
            T.doc.read(SCon{'\\', xx}, T.MScan{ls(bd, rw, hs, he, ps, sk, ab, un, lf, [])}),
            so.copy(xx, bd, rw, hs, he, ps, bk, sk, un, lf, ab),
            s1.cp(Laws.KpU8{hh, gg, ff, ee, dd, cc, bb, aa} <> pr, SNil{}, bd, rw, hs, he, ps, sk, ab, un, lf, rest, PP,
              hb, eo, ih))

# One-line literal strings. literal-char leaves out every control but tab
# and the apostrophe, so every character of a literal string opens or grows
# its span (MEat with basic false and the apostrophe as the quote), and the
# closing apostrophe places the span: a literal string is always a span.
# `''` goes through LQ2 as `""` does.

# the scanner just past the opening apostrophe of a literal string in a
# value position
def s1.lo(
  bd: String,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  bk: T.Lex,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.Mode:
  T.MOpen{False{}, '\'', T.QLit{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab}

# the scanner inside the span of such a string: cut is the text from its
# first character, nn the characters counted so far
def s1.le(
  cut: String,
  nn: U32,
  bd: String,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  un: U32,
  lf: U32,
  ab: Bool
) -> T.Mode:
  T.MEat{False{}, '\'', cut, nn, bd, rw, hs, he, ps, T.QLit{}, sk, un, lf, ab}

# the first character: str.bad passes it, so the span starts
def s1.lo.ok(
  badc: Bool,
  +uu: U32,
  +tail: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hc: {badc == False{} : Bool}
) -> {T.doc.open.ok(badc, False{}, '\'', T.QLit{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu}, tail)
  == s1.le(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match badc:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.open.ok(True{}, False{}, '\'', T.QLit{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab,
        Chr{uu}, tail) == s1.le(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hc)

# no apostrophe
def s1.lo.q(
  same: Bool,
  +uu: U32,
  +tail: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hq: {same == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.doc.open.q(same, False{}, '\'', T.QLit{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu}, tail)
  == s1.le(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match same:
    case False{}:
      s1.lo.ok(T.str.bad(uu, False{}), uu, tail, bd, rw, hs, he, ps, bk, sk, un, lf, ab, sb)
    case True{}:
      Eq.bit.absurd2(&2, {T.doc.open.q(True{}, False{}, '\'', T.QLit{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab,
        Chr{uu}, tail) == s1.le(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hq)

# a first character that is no apostrophe, and that str.bad passes, opens
# the span
def s1.lo.one(
  +uu: U32,
  +tail: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  e39: {U32.is_eq(uu, 39) == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tail}, s1.lo(bd, rw, hs, he, ps, bk, sk, un, lf, ab))
  == T.doc.read(tail, s1.le(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab)) : T.Doc}:
  Equal.cong(T.Mode, T.Doc, md => T.doc.read(tail, md),
    T.doc.open(False{}, '\'', T.QLit{}, bd, rw, hs, he, ps, [], bk, sk, un, lf, ab, Chr{uu}, tail),
    s1.le(SCon{Chr{uu}, tail}, 1, bd, rw, hs, he, ps, sk, un, lf, ab),
    s1.lo.q(U32.is_eq(uu, 39), uu, tail, bd, rw, hs, he, ps, bk, sk, un, lf, ab, e39, sb))

# a later character: str.bad passes it, so the span grows
def s1.le.ctl(
  badc: Bool,
  +uu: U32,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hc: {badc == False{} : Bool}
) -> {T.eat.ctrl(badc, False{}, '\'', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QLit{}, sk, un, lf, ab)
  == s1.le(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match badc:
    case False{}:
      {==}
    case True{}:
      Eq.bit.absurd2(&2, {T.eat.ctrl(True{}, False{}, '\'', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QLit{}, sk, un, lf,
        ab) == s1.le(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hc)

# no apostrophe
def s1.le.q(
  quote: Bool,
  +uu: U32,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hq: {quote == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.eat.feed.q(quote, False{}, '\'', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QLit{}, sk, un, lf, ab)
  == s1.le(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}:
  match quote:
    case False{}:
      s1.le.ctl(T.str.bad(uu, False{}), uu, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, sb)
    case True{}:
      Eq.bit.absurd2(&2, {T.eat.feed.q(True{}, False{}, '\'', Chr{uu}, cut, nn, bd, rw, hs, he, ps, T.QLit{}, sk, un,
        lf, ab) == s1.le(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab) : T.Mode}, hq)

# a later character that is no apostrophe, and that str.bad passes, grows
# the span by one
def s1.le.one(
  +uu: U32,
  +tail: String,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  e39: {U32.is_eq(uu, 39) == False{} : Bool},
  sb: {T.str.bad(uu, False{}) == False{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tail}, s1.le(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab))
  == T.doc.read(tail, s1.le(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab)) : T.Doc}:
  Equal.cong(T.Mode, T.Doc, md => T.doc.read(tail, md),
    T.eat.feed(False{}, '\'', cut, nn, bd, rw, hs, he, ps, T.QLit{}, sk, un, lf, ab, Chr{uu}),
    s1.le(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf, ab),
    s1.le.q(U32.is_eq(uu, 39), uu, cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab, e39, sb))

# the rest tx of a literal string inside its span, pre read so far: cut is
# the text from the string's first character, and nn counts pre's
# characters without wrapping. The closing apostrophe places the span, which
# holds pre and tx
def s1.lg(
  tx: String,
  +pre: String,
  +cut: String,
  +nn: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +hc: {cut == String.append(pre, String.append(tx, SCon{'\'', rest})) : String},
  +hn: {U32.to_nat(nn) == plus(pre, 0n) : Nat},
  +hk: {Laws.counts(tx, nn) == True{} : Bool},
  +hl: {Laws.abnf.literal_string(tx) == True{} : Bool},
  ih: s1.Done(String.append(pre, tx), bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(tx, SCon{'\'', rest}), s1.le(cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab))):
  match tx:
    case SNil{}:
      s1.done.cast(String.append(pre, SNil{}), pre, Eq.append_nil(pre), bd, rw, hs, he, ps, sk, ab, rest, PP, ih)(
        T.VSpan{cut, nn}, T.LStr{}, T.QLit{}, un, lf, se.own(pre, cut, SCon{'\'', rest}, nn, hc, hn))
    case SCon{hh, +tt}:
      match hh:
        case Chr{+uu}:
          +hl0 = {Eq.and.left(Laws.abnf.literal_char(Chr{uu}), Laws.abnf.literal_string(tt), hl)
            : {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool}}
          pp.step(PP,
            T.doc.read(SCon{Chr{uu}, String.append(tt, SCon{'\'', rest})}, s1.le(cut, nn, bd, rw, hs, he, ps, sk, un,
              lf, ab)),
            T.doc.read(String.append(tt, SCon{'\'', rest}), s1.le(cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf,
              ab)),
            s1.le.one(uu, String.append(tt, SCon{'\'', rest}), cut, nn, bd, rw, hs, he, ps, sk, un, lf, ab,
              s1.lc.a(uu, hl0), s1.sb(uu, False{}, s1.lc.c9(uu, hl0))),
            s1.lg(tt, String.append(pre, SCon{Chr{uu}, SNil{}}), cut, U32.add(nn, 1), bd, rw, hs, he, ps, sk, un, lf,
              ab, rest, PP, s1.cut(cut, pre, Chr{uu}, String.append(tt, SCon{'\'', rest}), hc),
              s1.hn(nn, pre, Chr{uu}, tt, hn, hk),
              Eq.and.right(Bool.not(U32.is_zero(U32.add(nn, 1))), Laws.counts(tt, U32.add(nn, 1)), hk),
              Eq.and.right(Laws.abnf.literal_char(Chr{uu}), Laws.abnf.literal_string(tt), hl),
              s1.done.cast(String.append(pre, SCon{Chr{uu}, tt}),
                String.append(String.append(pre, SCon{Chr{uu}, SNil{}}), tt),
                Equal.sym(String, String.append(String.append(pre, SCon{Chr{uu}, SNil{}}), tt),
                  String.append(pre, SCon{Chr{uu}, tt}), Eq.append_assoc(pre, SCon{Chr{uu}, SNil{}}, tt)),
                bd, rw, hs, he, ps, sk, ab, rest, PP, ih)))

# a character after `''` that is no apostrophe places the empty string and
# is read as the fast step would read it with the string placed
def s1.lq2(
  same: Bool,
  +cc: Char,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  hq: {same == False{} : Bool}
) -> {T.read.once2(T.lex.q2.go(same, fs.st(bd, rw, hs, he, ps, [], T.LQ2{}, bk, T.QLit{}, sk, un, lf, ab), cc,
  T.QLit{})) == T.read.fast(T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab, False{}), cc)
  : T.St}:
  match same:
    case False{}:
      fs.held(sk, T.VStr{""}, cc, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab)
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.q2.go(True{}, fs.st(bd, rw, hs, he, ps, [], T.LQ2{}, bk, T.QLit{}, sk,
        un, lf, ab), cc, T.QLit{})) == T.read.fast(T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf,
        ab, False{}), cc) : T.St}, hq)

# `''` then a rest that may follow a string: the rest is read with the empty
# string placed, back where the value position left it
def s1.lempty(
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  rest: String,
  -PP: T.Doc -> Type,
  hr: {Laws.s1.free(rest) == True{} : Bool},
  ih: s1.Done(SNil{}, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(SCon{'\'', rest}, s1.lo(bd, rw, hs, he, ps, bk, sk, un, lf, ab))):
  match rest:
    case SNil{}:
      pp.step(PP, T.doc.read(SCon{'\'', SNil{}}, s1.lo(bd, rw, hs, he, ps, bk, sk, un, lf, ab)),
        T.doc.read(SNil{}, T.MScan{T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab, False{})}),
        Equal.cong(T.St, T.Doc, st => T.read.fin2(st),
          T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab, False{}),
          T.read.fin.close(T.read.once2(T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab,
            False{}))),
          tk.fin(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab, False{})),
        ih(T.VStr{""}, bk, T.QLit{}, un, lf, {==}))
    case SCon{hh, +tt}:
      match hh:
        case Chr{+uu}:
          pp.step(PP,
            T.doc.read(SCon{'\'', SCon{Chr{uu}, tt}}, s1.lo(bd, rw, hs, he, ps, bk, sk, un, lf, ab)),
            T.doc.read(SCon{Chr{uu}, tt}, T.MScan{T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf,
              ab, False{})}),
            Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
              T.doc.scan(fs.st(bd, rw, hs, he, ps, [], T.LQ2{}, bk, T.QLit{}, sk, un, lf, ab), Chr{uu}),
              T.doc.scan(T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab, False{}), Chr{uu}),
              scan.fast(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
                fs.st(bd, rw, hs, he, ps, [], T.LQ2{}, bk, T.QLit{}, sk, un, lf, ab),
                T.take.top(sk, T.VStr{""}, bd, rw, hs, he, ps, bk, T.QLit{}, un, lf, ab, False{}), Chr{uu},
                s1.lq2(U32.is_eq(uu, 39), Chr{uu}, bd, rw, hs, he, ps, bk, sk, un, lf, ab,
                  s1.nor.r(U32.is_eq(uu, 34), U32.is_eq(uu, 39), hr)))),
            ih(T.VStr{""}, bk, T.QLit{}, un, lf, {==}))

# a one-line literal string, after its opening apostrophe, then the closing
# apostrophe and a rest that may follow a string: from every value position
# the rest is read with a span of its characters placed
def s1.lopen(
  tx: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  hk: {Laws.short(tx) == True{} : Bool},
  +hl: {Laws.abnf.literal_string(tx) == True{} : Bool},
  hr: {Laws.s1.free(rest) == True{} : Bool},
  ih: s1.Done(tx, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(tx, SCon{'\'', rest}), s1.lo(bd, rw, hs, he, ps, bk, sk, un, lf, ab))):
  match tx:
    case SNil{}:
      s1.lempty(bd, rw, hs, he, ps, bk, sk, un, lf, ab, rest, PP, hr, ih)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+uu}:
          +hl0 = {Eq.and.left(Laws.abnf.literal_char(Chr{uu}), Laws.abnf.literal_string(tt), hl)
            : {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool}}
          pp.step(PP,
            T.doc.read(SCon{Chr{uu}, String.append(tt, SCon{'\'', rest})}, s1.lo(bd, rw, hs, he, ps, bk, sk, un, lf,
              ab)),
            T.doc.read(String.append(tt, SCon{'\'', rest}), s1.le(SCon{Chr{uu}, String.append(tt, SCon{'\'', rest})}, 1,
              bd, rw, hs, he, ps, sk, un, lf, ab)),
            s1.lo.one(uu, String.append(tt, SCon{'\'', rest}), bd, rw, hs, he, ps, bk, sk, un, lf, ab,
              s1.lc.a(uu, hl0), s1.sb(uu, False{}, s1.lc.c9(uu, hl0))),
            s1.lg(tt, SCon{Chr{uu}, SNil{}}, SCon{Chr{uu}, String.append(tt, SCon{'\'', rest})}, 1, bd, rw, hs, he, ps,
              sk, un, lf, ab, rest, PP, {==}, {==},
              Eq.and.right(Bool.not(U32.is_zero(U32.add(0, 1))), Laws.counts(tt, U32.add(0, 1)), hk),
              Eq.and.right(Laws.abnf.literal_char(Chr{uu}), Laws.abnf.literal_string(tt), hl), ih))

# Multi-line strings. Every step of a multi-line string is the full step
# (read.fast leaves only a one-line string's plain characters to the fast
# path). After the opening delimiter the scanner is in LTrim, which drops a
# newline; after a line-ending backslash it is in LFold, which drops
# whitespace and newlines; a quote waits in LMq for the two that would close
# the string, and after the closing delimiter LMqEnd takes up to two more.
# A character that ends a trim, or one after quotes that did not close, is
# held and read again in LStr, and since no LStr step holds a character,
# that is the fast step from LStr: the lemmas below turn each of those states
# into LStr for such a character. The same lemmas serve a multi-line basic
# string (QMulti, quotation marks) and a multi-line literal one (QMultiLit,
# apostrophes), by the bit lit.

# the kind of a multi-line string: a literal one's when lit
def s1.mk(lit: Bool) -> T.QKind:
  match lit:
    case True{}:
      T.QMultiLit{}
    case False{}:
      T.QMulti{}

# its quote: an apostrophe when lit, a quotation mark otherwise
def s1.qc(lit: Bool) -> Char:
  match lit:
    case True{}:
      '\''
    case False{}:
      '"'

# the rest of the walk once a multi-line string is closed with its
# characters reversed in fb: reading rest from the scanner with an owned
# string of them placed, and any back, kind, uni and left, gives a document
# PP holds of
def s1.Fin(
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +fb: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @b2: T.Lex -> @q2: T.QKind -> @u2: U32 -> @l2: U32 ->
    PP(T.doc.read(rest, T.MScan{T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, b2, q2, u2, l2, ab,
      False{})}))

# A multi-line string's LStr step holds no character.

# a character is pushed, or refused
def s1.once.ch(
  bad: Bool,
  +uu: U32,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.read.once2(T.lex.str.char.go(bad, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, qk, sk, un, lf, ab), Chr{uu}))
  == T.lex.str.char.go(bad, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, qk, sk, un, lf, ab), Chr{uu}) : T.St}:
  match bad:
    case True{}:
      {==}
    case False{}:
      {==}

# a backslash starts an escape, and anything else is a character
def s1.once.bs(
  bs: Bool,
  +uu: U32,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.read.once2(T.lex.str.bs(bs, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, qk, sk, un, lf, ab), Chr{uu},
  qk)) == T.lex.str.bs(bs, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, qk, sk, un, lf, ab), Chr{uu}, qk)
  : T.St}:
  match bs:
    case True{}:
      {==}
    case False{}:
      s1.once.ch(T.str.bad(uu, True{}), uu, qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)

# a quote starts the closing quotes, a backslash an escape in a basic
# string, and anything else is a character
def s1.once.go(
  quote: Bool,
  basic: Bool,
  +uu: U32,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.read.once2(T.lex.str.go(quote, True{}, basic, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, qk, sk, un, lf, ab),
  Chr{uu}, qk)) == T.lex.str.go(quote, True{}, basic, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, qk, sk, un, lf,
  ab), Chr{uu}, qk) : T.St}:
  match quote basic:
    case True{} _b:
      {==}
    case False{} True{}:
      s1.once.bs(U32.is_eq(uu, 92), uu, qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)
    case False{} False{}:
      s1.once.ch(T.str.bad(uu, True{}), uu, qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)

# so a multi-line string's fast step from LStr is its LStr step, which a
# held character is read by
def s1.once(
  lit: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>
) -> {T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.mk(lit), sk, un, lf, ab), Chr{uu})
  == T.lex.str(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.mk(lit), sk, un, lf, ab), Chr{uu}) : T.St}:
  match lit:
    case True{}:
      s1.once.go(U32.is_eq(uu, 39), False{}, uu, T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)
    case False{}:
      s1.once.go(U32.is_eq(uu, 34), True{}, uu, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)

# The trims. A multi-line body is read from LStr (nothing trimmed), from
# LTrim (the first newline, right after the opening delimiter) or from LFold
# (whitespace and newlines after a line-ending backslash, with the newline
# seen); a character that ends the trim is read from LStr, with back at
# LStr.

# the scanner reading a multi-line body under the trim tm
def s1.ms(
  tm: Laws.GTrim,
  qk: T.QKind,
  bd: String,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  ab: Bool,
  bk: T.Lex,
  un: U32,
  lf: U32,
  buf: List<&2, Char>
) -> T.St:
  match tm:
    case Laws.TNone{}:
      fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, qk, sk, un, lf, ab)
    case Laws.TFirst{}:
      fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, qk, sk, un, lf, ab)
    case Laws.TAll{}:
      fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, qk, sk, un, 1, ab)

# the back a character that ends the trim leaves
def s1.eb(tm: Laws.GTrim, bk: T.Lex) -> T.Lex:
  match tm:
    case Laws.TNone{}:
      bk
    case Laws.TFirst{}:
      T.LStr{}
    case Laws.TAll{}:
      T.LStr{}

# the left it leaves
def s1.el(tm: Laws.GTrim, lf: U32) -> U32:
  match tm:
    case Laws.TNone{}:
      lf
    case Laws.TFirst{}:
      lf
    case Laws.TAll{}:
      1

# LTrim holds a character that is no newline, which LStr reads
def s1.tr.go(
  cr: Bool,
  nl: Bool,
  +lit: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hc: {cr == False{} : Bool},
  hn: {nl == False{} : Bool}
) -> {T.read.once2(T.lex.trim.go(cr, nl, fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, s1.mk(lit), sk, un, lf, ab),
  Chr{uu})) == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf, ab), Chr{uu})
  : T.St}:
  match cr nl:
    case True{} n2:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.trim.go(True{}, n2, fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk,
        s1.mk(lit), sk, un, lf, ab), Chr{uu})) == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{},
        s1.mk(lit), sk, un, lf, ab), Chr{uu}) : T.St}, hc)
    case False{} True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.trim.go(False{}, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk,
        s1.mk(lit), sk, un, lf, ab), Chr{uu})) == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{},
        s1.mk(lit), sk, un, lf, ab), Chr{uu}) : T.St}, hn)
    case False{} False{}:
      Equal.sym(T.St, T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf, ab),
        Chr{uu}), T.lex.str(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf, ab), Chr{uu}),
        s1.once(lit, uu, bd, rw, hs, he, ps, sk, ab, T.LStr{}, un, lf, buf))

# LFold, after the newline, holds a character that is no whitespace and no
# newline, which LStr reads
def s1.fd.go(
  sp: Bool,
  nl: Bool,
  +lit: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>,
  hs0: {sp == False{} : Bool},
  hn: {nl == False{} : Bool}
) -> {T.read.once2(T.lex.fold.go(sp, nl, fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, s1.mk(lit), sk, un, 1, ab),
  Chr{uu})) == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, 1, ab), Chr{uu})
  : T.St}:
  match sp nl:
    case True{} n2:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.fold.go(True{}, n2, fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk,
        s1.mk(lit), sk, un, 1, ab), Chr{uu})) == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{},
        s1.mk(lit), sk, un, 1, ab), Chr{uu}) : T.St}, hs0)
    case False{} True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.fold.go(False{}, True{}, fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk,
        s1.mk(lit), sk, un, 1, ab), Chr{uu})) == T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{},
        s1.mk(lit), sk, un, 1, ab), Chr{uu}) : T.St}, hn)
    case False{} False{}:
      Equal.sym(T.St, T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, 1, ab),
        Chr{uu}), T.lex.str(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, 1, ab), Chr{uu}),
        s1.once(lit, uu, bd, rw, hs, he, ps, sk, ab, T.LStr{}, un, 1, buf))

# a character that is no whitespace (under TAll) and no newline ends the
# trim: the text from it is read from LStr
def s1.enter(
  tm: Laws.GTrim,
  +lit: Bool,
  +uu: U32,
  +tt: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hs0: {T.ch.sp(Chr{uu}) == False{} : Bool},
  +hn: {T.ch.nl(Chr{uu}) == False{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tt}, T.MScan{s1.ms(tm, s1.mk(lit), bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})
  == T.doc.read(SCon{Chr{uu}, tt}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), s1.mk(lit), sk, un,
  s1.el(tm, lf), ab)}) : T.Doc}:
  match tm:
    case Laws.TNone{}:
      {==}
    case Laws.TFirst{}:
      Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
        T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, s1.mk(lit), sk, un, lf, ab), Chr{uu}),
        T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf, ab), Chr{uu}),
        scan.fast(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
          fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, s1.mk(lit), sk, un, lf, ab),
          fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf, ab), Chr{uu},
          s1.tr.go(U32.is_eq(uu, 13), T.ch.nl(Chr{uu}), lit, uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf,
            Eq.or.right_false(U32.is_eq(uu, 10), U32.is_eq(uu, 13), hn), hn)))
    case Laws.TAll{}:
      Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
        T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, s1.mk(lit), sk, un, 1, ab), Chr{uu}),
        T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, 1, ab), Chr{uu}),
        scan.fast(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
          fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, s1.mk(lit), sk, un, 1, ab),
          fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, 1, ab), Chr{uu},
          s1.fd.go(T.ch.sp(Chr{uu}), T.ch.nl(Chr{uu}), lit, uu, bd, rw, hs, he, ps, sk, ab, bk, un, buf, hs0, hn)))

# The quotes. One or two quotes wait in LMq; a character that is no quote
# returns them to the string, pushed, and is held and read again in LStr.

# the left LMq counts: two quotes, or one
def s1.ql(two: Bool) -> U32:
  match two:
    case True{}:
      2
    case False{}:
      1

# the buffer with the quotes pushed
def s1.qp(two: Bool, +qc: Char, buf: List<&2, Char>) -> List<&2, Char>:
  match two:
    case True{}:
      qc <> (qc <> buf)
    case False{}:
      qc <> buf

# one or two quotes in LStr wait in LMq
def s1.mq.in(
  +lit: Bool,
  +two: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +xx: String
) -> {T.doc.read(Laws.g.quotes.text(two, s1.qc(lit), xx), T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk,
  s1.mk(lit), sk, un, lf, ab)}) == T.doc.read(xx, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, s1.mk(lit), sk,
  0, s1.ql(two), ab)}) : T.Doc}:
  match lit two:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

# a character that is no quote returns the waiting quotes to the string and
# is read again in LStr
def s1.mq.go(
  quote: Bool,
  +lit: Bool,
  +two: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool}
) -> {T.read.once2(T.lex.mq.go(quote, U32.is_eq(s1.ql(two), 1), fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk,
  s1.mk(lit), sk, 0, s1.ql(two), ab), Chr{uu}, buf, s1.mk(lit), s1.ql(two)))
  == T.lex.str(fs.st(bd, rw, hs, he, ps, s1.qp(two, s1.qc(lit), buf), T.LStr{}, bk, s1.mk(lit), sk, 0, 0, ab), Chr{uu})
  : T.St}:
  match quote lit two:
    case True{} l2 t2:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.mq.go(True{}, U32.is_eq(s1.ql(t2), 1), fs.st(bd, rw, hs, he, ps, buf,
        T.LMq{}, bk, s1.mk(l2), sk, 0, s1.ql(t2), ab), Chr{uu}, buf, s1.mk(l2), s1.ql(t2)))
        == T.lex.str(fs.st(bd, rw, hs, he, ps, s1.qp(t2, s1.qc(l2), buf), T.LStr{}, bk, s1.mk(l2), sk, 0, 0, ab),
        Chr{uu}) : T.St}, hq)
    case False{} True{} True{}:
      {==}
    case False{} True{} False{}:
      {==}
    case False{} False{} True{}:
      {==}
    case False{} False{} False{}:
      {==}

# the fast step from the waiting quotes is the fast step from LStr with them
# pushed, for a character that is no quote of the string
def s1.mq.exit.eq(
  lit: Bool,
  +two: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +buf: List<&2, Char>,
  hq: {Char.is_eq(Chr{uu}, s1.qc(lit)) == False{} : Bool}
) -> {T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, s1.mk(lit), sk, 0, s1.ql(two), ab), Chr{uu})
  == T.read.fast(fs.st(bd, rw, hs, he, ps, s1.qp(two, s1.qc(lit), buf), T.LStr{}, bk, s1.mk(lit), sk, 0, 0, ab),
    Chr{uu})
  : T.St}:
  match lit:
    case True{}:
      Equal.trans(T.St,
        T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, T.QMultiLit{}, sk, 0, s1.ql(two), ab), Chr{uu}),
        T.lex.str(fs.st(bd, rw, hs, he, ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{}, sk, 0, 0, ab), Chr{uu}),
        T.read.fast(fs.st(bd, rw, hs, he, ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{}, sk, 0, 0, ab),
          Chr{uu}),
        s1.mq.go(U32.is_eq(uu, 39), True{}, two, uu, bd, rw, hs, he, ps, sk, ab, bk, buf, hq),
        Equal.sym(T.St, T.read.fast(fs.st(bd, rw, hs, he, ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{}, sk,
          0, 0, ab), Chr{uu}), T.lex.str(fs.st(bd, rw, hs, he, ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{},
          sk, 0, 0, ab), Chr{uu}), s1.once(True{}, uu, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, s1.qp(two, '\'', buf))))
    case False{}:
      Equal.trans(T.St,
        T.read.fast(fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, T.QMulti{}, sk, 0, s1.ql(two), ab), Chr{uu}),
        T.lex.str(fs.st(bd, rw, hs, he, ps, s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0, ab), Chr{uu}),
        T.read.fast(fs.st(bd, rw, hs, he, ps, s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0, ab), Chr{uu}),
        s1.mq.go(U32.is_eq(uu, 34), False{}, two, uu, bd, rw, hs, he, ps, sk, ab, bk, buf, hq),
        Equal.sym(T.St, T.read.fast(fs.st(bd, rw, hs, he, ps, s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0,
          ab), Chr{uu}), T.lex.str(fs.st(bd, rw, hs, he, ps, s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0,
          ab), Chr{uu}), s1.once(False{}, uu, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, s1.qp(two, '"', buf))))

# a text that starts with no quote of the string, after one or two quotes,
# is read from LStr with the quotes pushed
def s1.mq.exit(
  +lit: Bool,
  +two: Bool,
  +uu: U32,
  +tt: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +buf: List<&2, Char>,
  hq: {Char.is_eq(Chr{uu}, s1.qc(lit)) == False{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tt}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, s1.mk(lit), sk, 0,
  s1.ql(two), ab)}) == T.doc.read(SCon{Chr{uu}, tt}, T.MScan{fs.st(bd, rw, hs, he, ps, s1.qp(two, s1.qc(lit), buf),
  T.LStr{}, bk, s1.mk(lit), sk, 0, 0, ab)}) : T.Doc}:
  Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
    T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, s1.mk(lit), sk, 0, s1.ql(two), ab), Chr{uu}),
    T.doc.scan(fs.st(bd, rw, hs, he, ps, s1.qp(two, s1.qc(lit), buf), T.LStr{}, bk, s1.mk(lit), sk, 0, 0, ab), Chr{uu}),
    scan.fast(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
      fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, s1.mk(lit), sk, 0, s1.ql(two), ab),
      fs.st(bd, rw, hs, he, ps, s1.qp(two, s1.qc(lit), buf), T.LStr{}, bk, s1.mk(lit), sk, 0, 0, ab), Chr{uu},
      s1.mq.exit.eq(lit, two, uu, bd, rw, hs, he, ps, sk, ab, bk, buf, hq)))

# Newlines, whitespace after a line-ending backslash, and the closing
# delimiter.

# the code point is k
def s1.isk(+uu: U32, +kk: U32, ee: {U32.is_eq(uu, kk) == True{} : Bool}) -> {uu == kk : U32}:
  Equal.cong(Char, U32, cc => Char.to_u32(cc), Chr{uu}, Chr{kk}, Eq.u32_eq(uu, kk, ee))

# an or whose second half is false: its first half holds
def s1.or.l(
  aa: Bool,
  hh: {Bool.or(aa, False{}) == True{} : Bool}
) -> {aa == True{} : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      Eq.bit.absurd(&2, {False{} == True{} : Bool}, hh)

# a carriage return and a line feed with nothing after them are CRLF
def s1.nl.end(
  t2: String,
  em: {String.is_empty(t2) == True{} : Bool},
  -QQ: String -> Type,
  crlf: QQ("\r\n")
) -> QQ(SCon{Chr{13}, SCon{Chr{10}, t2}}):
  match t2:
    case SNil{}:
      crlf
    case SCon{h3, t3}:
      Eq.bit.absurd(&1, QQ(SCon{Chr{13}, SCon{Chr{10}, SCon{h3, t3}}}), em)

# a newline is a line feed, or a carriage return and a line feed: a claim
# about both holds of every newline
def s1.nl.elim(
  -QQ: String -> Type,
  nl: String,
  +hn: {Laws.abnf.newline(nl) == True{} : Bool},
  lf: QQ("\n"),
  crlf: QQ("\r\n")
) -> QQ(nl):
  match nl:
    case SNil{}:
      Eq.bit.absurd(&1, QQ(SNil{}), hn)
    case SCon{hh, tt}:
      match hh:
        case Chr{+uu}:
          match tt:
            case SNil{}:
              %Equal.sym(U32, uu, 10, s1.isk(uu, 10, hn)) : QQ(SCon{Chr{_}, SNil{}})
              lf
            case SCon{h2, +t2}:
              match h2:
                case Chr{+u2}:
                  +e13 = {Eq.and.left(U32.is_eq(uu, 13), Bool.and(U32.is_eq(u2, 10), String.is_empty(t2)), hn)
                    : {U32.is_eq(uu, 13) == True{} : Bool}}
                  +e10 = {Eq.and.left(U32.is_eq(u2, 10), String.is_empty(t2), Eq.and.right(U32.is_eq(uu, 13),
                    Bool.and(U32.is_eq(u2, 10), String.is_empty(t2)), hn)) : {U32.is_eq(u2, 10) == True{} : Bool}}
                  +em = {Eq.and.right(U32.is_eq(u2, 10), String.is_empty(t2), Eq.and.right(U32.is_eq(uu, 13),
                    Bool.and(U32.is_eq(u2, 10), String.is_empty(t2)), hn)) : {String.is_empty(t2) == True{} : Bool}}
                  %Equal.sym(U32, uu, 13, s1.isk(uu, 13, e13)) : QQ(SCon{Chr{_}, SCon{Chr{u2}, t2}})
                  %Equal.sym(U32, u2, 10, s1.isk(u2, 10, e10)) : QQ(SCon{Chr{13}, SCon{Chr{_}, t2}})
                  s1.nl.end(t2, em, QQ, crlf)

# the fold's state: LFold with uni and left as given
def s1.fd(
  qk: T.QKind,
  bd: String,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  ab: Bool,
  bk: T.Lex,
  un: U32,
  lf: U32,
  buf: List<&2, Char>
) -> T.Mode:
  T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, qk, sk, un, lf, ab)}

# The fold. After a line-ending backslash the scanner is in LFold: a space
# or a tab keeps it there, a newline (a line feed, or a carriage return and
# a line feed) keeps it there with the newline seen (left 1).

# a space or a tab stays in the fold
def s1.fws1.go(
  aa: Bool,
  bb: Bool,
  +uu: U32,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  ea: {U32.is_eq(uu, 32) == aa : Bool},
  eb: {U32.is_eq(uu, 9) == bb : Bool},
  hw: {Bool.or(aa, bb) == True{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
  == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)) : T.Doc}:
  match aa bb:
    case True{} _b:
      %Equal.sym(U32, uu, 32, s1.isk(uu, 32, ea)) : {T.doc.read(SCon{Chr{_}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab,
        bk, un, lf, buf)) == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)) : T.Doc}
      {==}
    case False{} True{}:
      %Equal.sym(U32, uu, 9, s1.isk(uu, 9, eb)) : {T.doc.read(SCon{Chr{_}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab,
        bk, un, lf, buf)) == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)) : T.Doc}
      {==}
    case False{} False{}:
      Eq.bit.absurd(&2, {T.doc.read(SCon{Chr{uu}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
        == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)) : T.Doc}, hw)

# whitespace (ws) stays in the fold
def s1.fws(
  w1: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +hw: {Laws.abnf.ws(w1) == True{} : Bool}
) -> {T.doc.read(String.append(w1, tt), s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
  == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)) : T.Doc}:
  match w1:
    case SNil{}:
      {==}
    case SCon{hh, +wt}:
      match hh:
        case Chr{+uu}:
          Equal.trans(T.Doc,
            T.doc.read(SCon{Chr{uu}, String.append(wt, tt)}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)),
            T.doc.read(String.append(wt, tt), s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)),
            T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)),
            s1.fws1.go(U32.is_eq(uu, 32), U32.is_eq(uu, 9), uu, String.append(wt, tt), qk, bd, rw, hs, he, ps, sk, ab,
              bk, un, lf, buf, {==}, {==}, Eq.and.left(Laws.abnf.wschar(Chr{uu}), Laws.abnf.ws(wt), hw)),
            s1.fws(wt, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf,
              Eq.and.right(Laws.abnf.wschar(Chr{uu}), Laws.abnf.ws(wt), hw)))

# a newline in the fold is seen: left becomes 1
def s1.fnl(
  nl: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hn: {Laws.abnf.newline(nl) == True{} : Bool}
) -> {T.doc.read(String.append(nl, tt), s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
  == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}:
  s1.nl.elim(xs => {T.doc.read(String.append(xs, tt), s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
    == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}, nl, hn, {==}, {==})

# one character of *( wschar / newline ) on its own: a space, a tab or a
# line feed stays in the fold after its newline
def s1.fwn1.go(
  aa: Bool,
  bb: Bool,
  cc: Bool,
  +uu: U32,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>,
  ea: {U32.is_eq(uu, 32) == aa : Bool},
  eb: {U32.is_eq(uu, 9) == bb : Bool},
  ec: {U32.is_eq(uu, 10) == cc : Bool},
  hw: {Bool.or(Bool.or(aa, bb), cc) == True{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf))
  == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}:
  match aa bb cc:
    case True{} _b _c:
      %Equal.sym(U32, uu, 32, s1.isk(uu, 32, ea)) : {T.doc.read(SCon{Chr{_}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab,
        bk, un, 1, buf)) == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}
      {==}
    case False{} True{} _c:
      %Equal.sym(U32, uu, 9, s1.isk(uu, 9, eb)) : {T.doc.read(SCon{Chr{_}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab,
        bk, un, 1, buf)) == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}
      {==}
    case False{} False{} True{}:
      %Equal.sym(U32, uu, 10, s1.isk(uu, 10, ec)) : {T.doc.read(SCon{Chr{_}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab,
        bk, un, 1, buf)) == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}
      {==}
    case False{} False{} False{}:
      Eq.bit.absurd(&2, {T.doc.read(SCon{Chr{uu}, tt}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf))
        == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}, hw)

# the text read after the rest of *( wschar / newline ), from the fold after
# its newline
def s1.Fwn(
  +more: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>
) -> Type:
  {T.doc.read(String.append(more, tt), s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf))
    == T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)) : T.Doc}

# the induction hypothesis for the rest after one character
def s1.FwnIh(
  +h2: Char,
  +t2: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>
) -> Type:
  {Laws.abnf.ws_newlines(SCon{h2, t2}) == True{} : Bool} -> s1.Fwn(SCon{h2, t2}, tt, qk, bd, rw, hs, he, ps, sk, ab, bk,
    un, buf)

# a carriage return in *( wschar / newline ) goes with the line feed after
# it, and the rest is read on from the fold
def s1.fwn.cr(
  +uu: U32,
  h2: Char,
  +t2: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>,
  +eu: {uu == 13 : U32},
  hw: {Laws.abnf.ws_newlines(SCon{Chr{uu}, SCon{h2, t2}}) == True{} : Bool},
  ih2: {Laws.abnf.ws_newlines(t2) == True{} : Bool} -> s1.Fwn(t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf)
) -> s1.Fwn(SCon{Chr{uu}, SCon{h2, t2}}, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf):
  match h2:
    case Chr{+u2}:
      +hw13 = {Equal.trans(Bool, Laws.abnf.ws_newlines(SCon{Chr{13}, SCon{Chr{u2}, t2}}),
        Laws.abnf.ws_newlines(SCon{Chr{uu}, SCon{Chr{u2}, t2}}), True{},
        Equal.cong(U32, Bool, xx => Laws.abnf.ws_newlines(SCon{Chr{xx}, SCon{Chr{u2}, t2}}), 13, uu,
          Equal.sym(U32, uu, 13, eu)), hw) : {Bool.and(U32.is_eq(u2, 10), Laws.abnf.ws_newlines(t2)) == True{} : Bool}}
      %Equal.sym(U32, uu, 13, eu) : s1.Fwn(SCon{Chr{_}, SCon{Chr{u2}, t2}}, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un,
        buf)
      %Equal.sym(U32, u2, 10, s1.isk(u2, 10, Eq.and.left(U32.is_eq(u2, 10), Laws.abnf.ws_newlines(t2), hw13))) :
        s1.Fwn(SCon{Chr{13}, SCon{Chr{_}, t2}}, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf)
      ih2(Eq.and.right(U32.is_eq(u2, 10), Laws.abnf.ws_newlines(t2), hw13))

# a character of *( wschar / newline ) that is no carriage return is one on
# its own, and the rest is read on from the fold
def s1.fwn.one(
  +uu: U32,
  +h2: Char,
  +t2: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>,
  e13: {U32.is_eq(uu, 13) == False{} : Bool},
  hw: {Laws.abnf.ws_newlines(SCon{Chr{uu}, SCon{h2, t2}}) == True{} : Bool},
  ih1: s1.FwnIh(h2, t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf)
) -> s1.Fwn(SCon{Chr{uu}, SCon{h2, t2}}, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf):
  +xa = {Bool.or(Bool.or(U32.is_eq(uu, 32), U32.is_eq(uu, 9)), U32.is_eq(uu, 10)) : Bool}
  +hx = {s1.or.l(Bool.and(xa, Laws.abnf.ws_newlines(SCon{h2, t2})), Equal.trans(Bool,
    Bool.or(Bool.and(xa, Laws.abnf.ws_newlines(SCon{h2, t2})), False{}),
    Bool.or(Bool.and(xa, Laws.abnf.ws_newlines(SCon{h2, t2})), Bool.and(U32.is_eq(uu, 13),
      Bool.and(Laws.abnf.cp(h2, 10), Laws.abnf.ws_newlines(t2)))), True{},
    Equal.cong(Bool, Bool, bb => Bool.or(Bool.and(xa, Laws.abnf.ws_newlines(SCon{h2, t2})), Bool.and(bb,
      Bool.and(Laws.abnf.cp(h2, 10), Laws.abnf.ws_newlines(t2)))), False{}, U32.is_eq(uu, 13),
      Equal.sym(Bool, U32.is_eq(uu, 13), False{}, e13)), hw))
    : {Bool.and(xa, Laws.abnf.ws_newlines(SCon{h2, t2})) == True{} : Bool}}
  Equal.trans(T.Doc,
    T.doc.read(SCon{Chr{uu}, String.append(SCon{h2, t2}, tt)}, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)),
    T.doc.read(String.append(SCon{h2, t2}, tt), s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)),
    T.doc.read(tt, s1.fd(qk, bd, rw, hs, he, ps, sk, ab, bk, un, 1, buf)),
    s1.fwn1.go(U32.is_eq(uu, 32), U32.is_eq(uu, 9), U32.is_eq(uu, 10), uu, String.append(SCon{h2, t2}, tt), qk, bd, rw,
      hs, he, ps, sk, ab, bk, un, buf, {==}, {==}, {==}, Eq.and.left(xa, Laws.abnf.ws_newlines(SCon{h2, t2}), hx)),
    ih1(Eq.and.right(xa, Laws.abnf.ws_newlines(SCon{h2, t2}), hx)))

# two or more characters of *( wschar / newline ): a carriage return goes
# with the line feed after it, and anything else is one character on its own
def s1.fwn.two(
  c13: Bool,
  +uu: U32,
  +h2: Char,
  +t2: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>,
  e13: {U32.is_eq(uu, 13) == c13 : Bool},
  +hw: {Laws.abnf.ws_newlines(SCon{Chr{uu}, SCon{h2, t2}}) == True{} : Bool},
  ih1: s1.FwnIh(h2, t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf),
  ih2: {Laws.abnf.ws_newlines(t2) == True{} : Bool} -> s1.Fwn(t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf)
) -> s1.Fwn(SCon{Chr{uu}, SCon{h2, t2}}, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf):
  match c13:
    case True{}:
      s1.fwn.cr(uu, h2, t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf, s1.isk(uu, 13, e13), hw, ih2)
    case False{}:
      s1.fwn.one(uu, h2, t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf, e13, hw, ih1)

# *( wschar / newline ), read from the fold after its newline, stays there
def s1.fwn(
  more: String,
  +tt: String,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>,
  +hw: {Laws.abnf.ws_newlines(more) == True{} : Bool}
) -> s1.Fwn(more, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf):
  match more:
    case SNil{}:
      {==}
    case SCon{hh, t1}:
      match hh:
        case Chr{+uu}:
          match t1:
            case SNil{}:
              s1.fwn1.go(U32.is_eq(uu, 32), U32.is_eq(uu, 9), U32.is_eq(uu, 10), uu, tt, qk, bd, rw, hs, he, ps, sk, ab,
                bk, un, buf, {==}, {==}, {==}, hw)
            case SCon{+h2, +t2}:
              s1.fwn.two(U32.is_eq(uu, 13), uu, h2, t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf, {==}, hw,
                h1 => s1.fwn(SCon{h2, t2}, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf, h1),
                h3 => s1.fwn(t2, tt, qk, bd, rw, hs, he, ps, sk, ab, bk, un, buf, h3))

# A line-ending backslash (mlb-escaped-nl): `\`, whitespace, a newline and
# any whitespace and newlines after it, read from LStr, leave the scanner in
# the fold after its newline (left 1), with uni at 0.

# the escape state of a multi-line basic string
def s1.ls.esc(
  bd: String,
  rw: List<&2, T.Val>,
  hs: List<&2, String>,
  he: List<&2, String>,
  ps: List<&2, String>,
  sk: List<&2, T.Ctx>,
  ab: Bool,
  bk: T.Lex,
  un: U32,
  lf: U32,
  buf: List<&2, Char>
) -> T.Mode:
  T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LEsc{}, bk, T.QMulti{}, sk, un, lf, ab)}

# a space or a tab right after the backslash starts the fold, no newline
# seen yet
def s1.esc.ws.go(
  aa: Bool,
  bb: Bool,
  +uu: U32,
  +tt: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  ea: {U32.is_eq(uu, 32) == aa : Bool},
  eb: {U32.is_eq(uu, 9) == bb : Bool},
  hw: {Bool.or(aa, bb) == True{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tt}, s1.ls.esc(bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
  == T.doc.read(tt, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, buf)) : T.Doc}:
  match aa bb:
    case True{} _b:
      %Equal.sym(U32, uu, 32, s1.isk(uu, 32, ea)) : {T.doc.read(SCon{Chr{_}, tt}, s1.ls.esc(bd, rw, hs, he, ps, sk, ab,
        bk, un, lf, buf)) == T.doc.read(tt, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, buf)) : T.Doc}
      {==}
    case False{} True{}:
      %Equal.sym(U32, uu, 9, s1.isk(uu, 9, eb)) : {T.doc.read(SCon{Chr{_}, tt}, s1.ls.esc(bd, rw, hs, he, ps, sk, ab,
        bk, un, lf, buf)) == T.doc.read(tt, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, buf)) : T.Doc}
      {==}
    case False{} False{}:
      Eq.bit.absurd(&2, {T.doc.read(SCon{Chr{uu}, tt}, s1.ls.esc(bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
        == T.doc.read(tt, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, buf)) : T.Doc}, hw)

# after the backslash: the whitespace and the newline start the fold and see
# the newline
def s1.enl.first(
  w1: String,
  +nl: String,
  +xx: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +hw: {Laws.abnf.ws(w1) == True{} : Bool},
  +hn: {Laws.abnf.newline(nl) == True{} : Bool}
) -> {T.doc.read(String.append(w1, String.append(nl, xx)), s1.ls.esc(bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
  == T.doc.read(xx, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 1, buf)) : T.Doc}:
  match w1:
    case SNil{}:
      s1.nl.elim(ys => {T.doc.read(String.append(ys, xx), s1.ls.esc(bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf))
        == T.doc.read(xx, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 1, buf)) : T.Doc}, nl, hn, {==}, {==})
    case SCon{hh, +wt}:
      match hh:
        case Chr{+uu}:
          Equal.trans(T.Doc,
            T.doc.read(SCon{Chr{uu}, String.append(wt, String.append(nl, xx))}, s1.ls.esc(bd, rw, hs, he, ps, sk, ab,
              bk,
              un, lf, buf)),
            T.doc.read(String.append(wt, String.append(nl, xx)), s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0,
              buf)),
            T.doc.read(xx, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 1, buf)),
            s1.esc.ws.go(U32.is_eq(uu, 32), U32.is_eq(uu, 9), uu, String.append(wt, String.append(nl, xx)), bd, rw, hs,
              he, ps, sk, ab, bk, un, lf, buf, {==}, {==}, Eq.and.left(Laws.abnf.wschar(Chr{uu}), Laws.abnf.ws(wt),
                hw)),
            Equal.trans(T.Doc,
              T.doc.read(String.append(wt, String.append(nl, xx)), s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0,
                0, buf)),
              T.doc.read(String.append(nl, xx), s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, buf)),
              T.doc.read(xx, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 1, buf)),
              s1.fws(wt, String.append(nl, xx), T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, buf,
                Eq.and.right(Laws.abnf.wschar(Chr{uu}), Laws.abnf.ws(wt), hw)),
              s1.fnl(nl, xx, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, buf, hn)))

# a line-ending backslash read from LStr: the backslash, its whitespace, its
# newline and every whitespace and newline after them leave the fold after
# its newline
def s1.enl(
  +w1: String,
  +nl: String,
  +more: String,
  +tt: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +hw: {Laws.abnf.mlb_escaped_nl(w1, nl, more) == True{} : Bool}
) -> {T.doc.read(SCon{'\\', String.append(w1, String.append(nl, String.append(more, tt)))}, T.MScan{fs.st(bd, rw, hs,
  he, ps, buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab)})
  == T.doc.read(tt, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 1, buf)) : T.Doc}:
  +h2 = {Eq.and.right(Laws.abnf.ws(w1), Bool.and(Laws.abnf.newline(nl), Laws.abnf.ws_newlines(more)), hw)
    : {Bool.and(Laws.abnf.newline(nl), Laws.abnf.ws_newlines(more)) == True{} : Bool}}
  Equal.trans(T.Doc,
    T.doc.read(String.append(w1, String.append(nl, String.append(more, tt))), s1.ls.esc(bd, rw, hs, he, ps, sk, ab, bk,
      un, lf, buf)),
    T.doc.read(String.append(more, tt), s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 1, buf)),
    T.doc.read(tt, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, 1, buf)),
    s1.enl.first(w1, nl, String.append(more, tt), bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf,
      Eq.and.left(Laws.abnf.ws(w1), Bool.and(Laws.abnf.newline(nl), Laws.abnf.ws_newlines(more)), hw),
      Eq.and.left(Laws.abnf.newline(nl), Laws.abnf.ws_newlines(more), h2)),
    s1.fwn(more, tt, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, 0, buf,
      Eq.and.right(Laws.abnf.newline(nl), Laws.abnf.ws_newlines(more), h2)))

# The closing delimiter: three quotes in LStr close the string, and up to two
# more after them are its own.

# three quotes in LStr are the closing delimiter
def s1.m3(
  +lit: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +xx: String
) -> {T.doc.read(SCon{s1.qc(lit), SCon{s1.qc(lit), SCon{s1.qc(lit), xx}}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf,
  T.LStr{}, bk, s1.mk(lit), sk, un, lf, ab)}) == T.doc.read(xx, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMqEnd{}, bk,
  s1.mk(lit), sk, 0, 0, ab)}) : T.Doc}:
  match lit:
    case True{}:
      {==}
    case False{}:
      {==}

# and one or two quotes before them are the string's
def s1.m3x(
  +lit: Bool,
  +two: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +xx: String
) -> {T.doc.read(Laws.g.quotes.text(two, s1.qc(lit), SCon{s1.qc(lit), SCon{s1.qc(lit), SCon{s1.qc(lit), xx}}}),
  T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, s1.mk(lit), sk, un, lf, ab)}) == T.doc.read(xx,
  T.MScan{fs.st(bd, rw, hs, he, ps, s1.qp(two, s1.qc(lit), buf), T.LMqEnd{}, bk, s1.mk(lit), sk, 0, s1.ql(two), ab)})
  : T.Doc}:
  match lit two:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

# a text that does not start with the string's quote
def s1.nq(lit: Bool, rest: String) -> Bool:
  match rest:
    case SNil{}:
      True{}
    case SCon{+hh, _tt}:
      Bool.not(Char.is_eq(hh, s1.qc(lit)))

# a text that may follow a string starts with no apostrophe
def s1.free.na(
  rest: String,
  hr: {Laws.s1.free(rest) == True{} : Bool}
) -> {s1.nq(True{}, rest) == True{} : Bool}:
  match rest:
    case SNil{}:
      {==}
    case SCon{hh, _tt}:
      match hh:
        case Chr{+uu}:
          Equal.cong(Bool, Bool, xx => Bool.not(xx), U32.is_eq(uu, 39), False{},
            s1.nor.r(U32.is_eq(uu, 34), U32.is_eq(uu, 39), hr))

# and no quotation mark
def s1.free.nd(
  rest: String,
  hr: {Laws.s1.free(rest) == True{} : Bool}
) -> {s1.nq(False{}, rest) == True{} : Bool}:
  match rest:
    case SNil{}:
      {==}
    case SCon{hh, _tt}:
      match hh:
        case Chr{+uu}:
          Equal.cong(Bool, Bool, xx => Bool.not(xx), U32.is_eq(uu, 34), False{},
            s1.nor.l(U32.is_eq(uu, 34), U32.is_eq(uu, 39), hr))

# a text that may follow a string starts with neither quote
def s1.free.nq(
  lit: Bool,
  rest: String,
  hr: {Laws.s1.free(rest) == True{} : Bool}
) -> {s1.nq(lit, rest) == True{} : Bool}:
  match lit:
    case True{}:
      s1.free.na(rest, hr)
    case False{}:
      s1.free.nd(rest, hr)

# a character after the closing quotes that is no quote places the string
# and is read as the fast step reads it from the state with it placed
def s1.me.go(
  quote: Bool,
  room: Bool,
  +cc: Char,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lx: U32,
  +fb: List<&2, Char>,
  hq: {quote == False{} : Bool}
) -> {T.read.once2(T.lex.mq.end.go(quote, room, fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, qk, sk, un, lx, ab), cc))
  == T.read.fast(T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, qk, un, lx, ab, False{}), cc) : T.St}:
  match quote:
    case False{}:
      fs.held(sk, T.VStr{T.buf.str(fb)}, cc, bd, rw, hs, he, ps, bk, qk, un, lx, ab)
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.mq.end.go(True{}, room, fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, qk,
        sk, un, lx, ab), cc)) == T.read.fast(T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, qk, un, lx,
        ab, False{}), cc) : T.St}, hq)

# and so for the string's own kind and quote
def s1.me.q(
  lit: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lx: U32,
  +fb: List<&2, Char>,
  hr: {Bool.not(Char.is_eq(Chr{uu}, s1.qc(lit))) == True{} : Bool}
) -> {T.read.fast(fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, s1.mk(lit), sk, un, lx, ab), Chr{uu})
  == T.read.fast(T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, s1.mk(lit), un, lx, ab, False{}),
    Chr{uu})
  : T.St}:
  match lit:
    case True{}:
      s1.me.go(U32.is_eq(uu, 39), U32.is_lt(lx, 2), Chr{uu}, T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lx, fb,
        Eq.not.true(U32.is_eq(uu, 39), hr))
    case False{}:
      s1.me.go(U32.is_eq(uu, 34), U32.is_lt(lx, 2), Chr{uu}, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lx, fb,
        Eq.not.true(U32.is_eq(uu, 34), hr))

# after the closing quotes, a rest that does not start with the string's
# quote is read with the string placed: an owned string of the characters
# in the buffer, reversed
def s1.mend(
  +lit: Bool,
  rest: String,
  +fb: List<&2, Char>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lx: U32,
  -PP: T.Doc -> Type,
  hr: {s1.nq(lit, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, fb, rest, PP)
) -> PP(T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, s1.mk(lit), sk, un, lx, ab)})):
  match rest:
    case SNil{}:
      pp.step(PP, T.doc.read(SNil{}, T.MScan{fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, s1.mk(lit), sk, un, lx,
        ab)}),
        T.doc.read(SNil{}, T.MScan{T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, s1.mk(lit), un, lx, ab,
          False{})}),
        Equal.cong(T.St, T.Doc, st => T.read.fin2(st),
          T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, s1.mk(lit), un, lx, ab, False{}),
          T.read.fin.close(T.read.once2(T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, s1.mk(lit), un,
            lx, ab, False{}))),
          tk.fin(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, s1.mk(lit), un, lx, ab, False{})),
        ih(bk, s1.mk(lit), un, lx))
    case SCon{hh, +tt}:
      match hh:
        case Chr{+uu}:
          pp.step(PP,
            T.doc.read(SCon{Chr{uu}, tt}, T.MScan{fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, s1.mk(lit), sk, un, lx,
              ab)}),
            T.doc.read(SCon{Chr{uu}, tt}, T.MScan{T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk,
              s1.mk(lit), un, lx, ab, False{})}),
            Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
              T.doc.scan(fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, s1.mk(lit), sk, un, lx, ab), Chr{uu}),
              T.doc.scan(T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, s1.mk(lit), un, lx, ab, False{}),
                Chr{uu}),
              scan.fast(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
                fs.st(bd, rw, hs, he, ps, fb, T.LMqEnd{}, bk, s1.mk(lit), sk, un, lx, ab),
                T.take.top(sk, T.VStr{T.buf.str(fb)}, bd, rw, hs, he, ps, bk, s1.mk(lit), un, lx, ab, False{}), Chr{uu},
                s1.me.q(lit, uu, bd, rw, hs, he, ps, sk, ab, bk, un, lx, fb, hr))),
            ih(bk, s1.mk(lit), un, lx))

# A multi-line basic body, one piece at a time (GMlb), under the trim g.mlb.chars
# gives it: each piece is read from the state its trim says (s1.ms), and the
# characters it stands for are pushed. The rest of the body is the induction
# hypothesis, a function over the rest's flag, trim, back, uni, left and
# buffer (s1.MbRec), so each piece's lemma is its own def.

# a character that is no newline ends the first trim: the text from it is
# read from LStr
def s1.enter.tf(
  +lit: Bool,
  +uu: U32,
  +tt: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +hn: {T.ch.nl(Chr{uu}) == False{} : Bool}
) -> {T.doc.read(SCon{Chr{uu}, tt}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, s1.mk(lit), sk, un, lf, ab)})
  == T.doc.read(SCon{Chr{uu}, tt}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf,
  ab)}) : T.Doc}:
  Equal.cong(T.Mode, T.Doc, md => T.doc.read(tt, md),
    T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, s1.mk(lit), sk, un, lf, ab), Chr{uu}),
    T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf, ab), Chr{uu}),
    scan.fast(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
      fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, s1.mk(lit), sk, un, lf, ab),
      fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, s1.mk(lit), sk, un, lf, ab), Chr{uu},
      s1.tr.go(U32.is_eq(uu, 13), T.ch.nl(Chr{uu}), lit, uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf,
        Eq.or.right_false(U32.is_eq(uu, 10), U32.is_eq(uu, 13), hn), hn)))

# a space or a tab stays in the fold
def s1.fd.stay(
  sp: Bool,
  nl: Bool,
  +uu: U32,
  +qk: T.QKind,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +buf: List<&2, Char>,
  hs0: {sp == True{} : Bool}
) -> {T.read.once2(T.lex.fold.go(sp, nl, fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, qk, sk, un, 1, ab), Chr{uu}))
  == fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, qk, sk, un, 1, ab) : T.St}:
  match sp:
    case True{}:
      {==}
    case False{}:
      Eq.bit.absurd(&2, {T.read.once2(T.lex.fold.go(False{}, nl, fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, qk, sk,
        un, 1, ab), Chr{uu})) == fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, qk, sk, un, 1, ab) : T.St}, hs0)

# a piece mlb-char takes is one basic-char takes
def s1.mlb.bc(
  kp: Laws.KPiece,
  hm: {Laws.abnf.mlb_char(kp) == True{} : Bool}
) -> {Laws.abnf.basic_char(kp) == True{} : Bool}:
  match kp:
    case Laws.KpChar{cc}:
      match cc:
        case Chr{_uu}:
          hm
    case Laws.KpEsc{_mm}:
      {==}
    case Laws.KpU4{_d, _c, _b, _a}:
      {==}
    case Laws.KpU8{_h, _g, _f, _e, _d, _c, _b, _a}:
      {==}

# the rest of a multi-line basic body, then the closing delimiter and rest,
# read from the state the rest's trim says: the induction hypothesis, for
# every flag, trim, back, uni, left and buffer
def s1.MbRec(
  +rr: List<&2, Laws.GMlb>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @q2: Bool -> {Laws.abnf.ml_basic_body(rr, q2) == True{} : Bool} ->
    {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool} ->
    @t2: Laws.GTrim -> @b2: T.Lex -> @u2: U32 -> @l2: U32 -> @f2: List<&2, Char> ->
    s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mlb.chars(rr, t2), f2), rest, PP) ->
    PP(T.doc.read(Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{s1.ms(t2, T.QMulti{}, bd, rw, hs,
      he, ps, sk, ab, b2, u2, l2, f2)}))

# the end of the body: the closing delimiter, from whatever state the trim
# left, places the characters pushed so far
def s1.mb.nil(
  +tm: Laws.GTrim,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hr: {s1.nq(False{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, buf, rest, PP)
) -> PP(T.doc.read(SCon{'"', SCon{'"', SCon{'"', rest}}}, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk,
  un, lf, buf)})):
  pp.step(PP,
    T.doc.read(SCon{'"', SCon{'"', SCon{'"', rest}}}, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un,
      lf, buf)}),
    T.doc.read(SCon{'"', SCon{'"', SCon{'"', rest}}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk),
      T.QMulti{}, sk, un, s1.el(tm, lf), ab)}),
    s1.enter(tm, False{}, 34, SCon{'"', SCon{'"', rest}}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, {==}, {==}),
    pp.step(PP,
      T.doc.read(SCon{'"', SCon{'"', SCon{'"', rest}}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk),
        T.QMulti{}, sk, un, s1.el(tm, lf), ab)}),
      T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMqEnd{}, s1.eb(tm, bk), T.QMulti{}, sk, 0, 0, ab)}),
      s1.m3(False{}, bd, rw, hs, he, ps, sk, ab, s1.eb(tm, bk), un, s1.el(tm, lf), buf, rest),
      s1.mend(False{}, rest, buf, bd, rw, hs, he, ps, sk, ab, s1.eb(tm, bk), 0, 0, PP, hr, ih)))

# the buffers the body lemmas' rest of the walk is stated over: after a
# character under the trim after a line-ending backslash
def s1.wsb(+ww: Bool, +cc: Char, rr: List<&2, Laws.GMlb>, buf: List<&2, Char>) -> List<&2, Char>:
  rev.onto(Laws.g.mlb.char.pick(ww, cc, Laws.g.mlb.chars(rr, Laws.g.mlb.char.trim.pick(ww))), buf)

# after a character under any trim
def s1.chb(+uu: U32, rr: List<&2, Laws.GMlb>, tm: Laws.GTrim, buf: List<&2, Char>) -> List<&2, Char>:
  rev.onto(Laws.g.mlb.chars(Laws.GmChar{Laws.KpChar{Chr{uu}}} <> rr, tm), buf)

# after an escape
def s1.escb(kp: Laws.KPiece, rr: List<&2, Laws.GMlb>, buf: List<&2, Char>) -> List<&2, Char>:
  rev.onto(SCon{Laws.k3.pc.char(kp), Laws.g.mlb.chars(rr, Laws.TNone{})}, buf)

# after a newline
def s1.nlb(+tm: Laws.GTrim, nl: String, rr: List<&2, Laws.GMlb>, buf: List<&2, Char>) -> List<&2, Char>:
  rev.onto(Laws.g.nl.char(tm, nl, Laws.g.mlb.chars(rr, Laws.g.nl.trim(tm))), buf)

# after one or two quotation marks
def s1.qb(two: Bool, rr: List<&2, Laws.GMlb>, buf: List<&2, Char>) -> List<&2, Char>:
  rev.onto(Laws.g.quotes.text(two, '"', Laws.g.mlb.chars(rr, Laws.TNone{})), buf)

# after one or two apostrophes
def s1.lqb(two: Bool, rr: List<&2, Laws.GMll>, buf: List<&2, Char>) -> List<&2, Char>:
  rev.onto(Laws.g.quotes.text(two, '\'', Laws.g.mll.chars(rr, Laws.TNone{})), buf)

# a character written as itself under the trim after a line-ending
# backslash: whitespace is dropped and keeps the trim, and anything else ends
# it and is pushed
def s1.mb.ws(
  ww: Bool,
  +uu: U32,
  +rr: List<&2, Laws.GMlb>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  ew: {T.ch.sp(Chr{uu}) == ww : Bool},
  +hbu: {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool},
  +c9: {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool},
  hbr: {Laws.abnf.ml_basic_body(rr, False{}) == True{} : Bool},
  hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, s1.wsb(ww, Chr{uu}, rr, buf), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(SCon{Chr{uu}, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})}, T.MScan{fs.st(bd, rw, hs,
  he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1, ab)})):
  match ww:
    case True{}:
      +tx = {Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{Chr{uu}, tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1,
          ab)}),
        T.doc.read(tx, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1, ab)}),
        Equal.cong(T.Mode, T.Doc, md => T.doc.read(tx, md),
          T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1, ab), Chr{uu}),
          T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1, ab)},
          s1.scq(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
            fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1, ab), Chr{uu},
            fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1, ab), s1.ncr(uu, c9),
            s1.fd.stay(T.ch.sp(Chr{uu}), T.ch.nl(Chr{uu}), uu, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, buf, ew),
            {==})),
        rec(False{}, hbr, hx, Laws.TAll{}, bk, un, lf, buf, ih))
    case False{}:
      +tx = {Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{Chr{uu}, tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LFold{}, bk, T.QMulti{}, sk, un, 1,
          ab)}),
        T.doc.read(SCon{Chr{uu}, tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, T.QMulti{}, sk, un, 1,
          ab)}),
        s1.enter(Laws.TAll{}, False{}, uu, tx, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, ew, s1.nnl(uu, c9)),
        s1.chr(True{}, uu, bd, rw, hs, he, ps, sk, ab, T.LStr{}, un, 1, buf, tx, PP, hbu,
          +b2 => +u2 => +l2 => rec(False{}, hbr, hx, Laws.TNone{}, b2, u2, l2, Chr{uu} <> buf, ih)))

# a character written as itself: pushed under no trim or the first trim
# (which it ends), and under the trim after a line-ending backslash dropped
# when it is whitespace
def s1.mb.ch(
  tm: Laws.GTrim,
  +uu: U32,
  +rr: List<&2, Laws.GMlb>,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hb: {Laws.abnf.ml_basic_body(Laws.GmChar{Laws.KpChar{Chr{uu}}} <> rr, qq) == True{} : Bool},
  hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, s1.chb(uu, rr, tm, buf), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.mlb.text(Laws.GmChar{Laws.KpChar{Chr{uu}}} <> rr, SCon{'"', SCon{'"', SCon{'"', rest}}}),
  T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match tm:
    case Laws.TNone{}:
      +hbu = {Eq.and.left(Laws.abnf.mlb_unescaped(Chr{uu}), Laws.abnf.ml_basic_body(rr, False{}), hb)
        : {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}}
      s1.chr(True{}, uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"',
        rest}}}), PP, hbu, +b2 => +u2 => +l2 => rec(False{}, Eq.and.right(Laws.abnf.mlb_unescaped(Chr{uu}),
        Laws.abnf.ml_basic_body(rr, False{}), hb), hx, Laws.TNone{}, b2, u2, l2, Chr{uu} <> buf, ih))
    case Laws.TFirst{}:
      +hbu = {Eq.and.left(Laws.abnf.mlb_unescaped(Chr{uu}), Laws.abnf.ml_basic_body(rr, False{}), hb)
        : {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}}
      +tx = {Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{Chr{uu}, tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, T.QMulti{}, sk, un, lf,
          ab)}),
        T.doc.read(SCon{Chr{uu}, tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, T.QMulti{}, sk, un, lf,
          ab)}),
        s1.enter.tf(False{}, uu, tx, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, s1.nnl(uu, s1.bu.c9(uu, hbu))),
        s1.chr(True{}, uu, bd, rw, hs, he, ps, sk, ab, T.LStr{}, un, lf, buf, tx, PP, hbu,
          +b2 => +u2 => +l2 => rec(False{}, Eq.and.right(Laws.abnf.mlb_unescaped(Chr{uu}), Laws.abnf.ml_basic_body(rr,
          False{}), hb), hx, Laws.TNone{}, b2, u2, l2, Chr{uu} <> buf, ih)))
    case Laws.TAll{}:
      +hbu = {Eq.and.left(Laws.abnf.mlb_unescaped(Chr{uu}), Laws.abnf.ml_basic_body(rr, False{}), hb)
        : {Laws.abnf.basic_unescaped(Chr{uu}) == True{} : Bool}}
      s1.mb.ws(T.ch.sp(Chr{uu}), uu, rr, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, {==}, hbu,
        s1.bu.c9(uu, hbu), Eq.and.right(Laws.abnf.mlb_unescaped(Chr{uu}), Laws.abnf.ml_basic_body(rr, False{}), hb), hx,
        ih, rec)

# a text that starts with a character ending the trim is read from LStr
def s1.enter.eq(
  tm: Laws.GTrim,
  +uu: U32,
  +xx: String,
  +tx: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +hk: {tx == SCon{Chr{uu}, xx} : String},
  hs0: {T.ch.sp(Chr{uu}) == False{} : Bool},
  hn: {T.ch.nl(Chr{uu}) == False{} : Bool}
) -> {T.doc.read(tx, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})
  == T.doc.read(tx, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un, s1.el(tm, lf),
  ab)}) : T.Doc}:
  Equal.trans(T.Doc, T.doc.read(tx, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
    T.doc.read(SCon{Chr{uu}, xx}, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
    T.doc.read(tx, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un, s1.el(tm, lf),
      ab)}),
    Equal.cong(String, T.Doc, zz => T.doc.read(zz, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf,
      buf)}), tx, SCon{Chr{uu}, xx}, hk),
    Equal.trans(T.Doc,
      T.doc.read(SCon{Chr{uu}, xx}, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
      T.doc.read(SCon{Chr{uu}, xx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un,
        s1.el(tm, lf), ab)}),
      T.doc.read(tx, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un, s1.el(tm, lf),
        ab)}),
      s1.enter(tm, False{}, uu, xx, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, hs0, hn),
      Equal.cong(String, T.Doc, zz => T.doc.read(zz, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk),
        T.QMulti{}, sk, un, s1.el(tm, lf), ab)}), SCon{Chr{uu}, xx}, tx, Equal.sym(String, tx, SCon{Chr{uu}, xx}, hk))))

# an escape: it ends any trim and pushes the character it stands for
def s1.mb.esc(
  +kp: Laws.KPiece,
  +xx: String,
  +rr: List<&2, Laws.GMlb>,
  +tm: Laws.GTrim,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hk: {Laws.k3.pc.text(kp, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})) == SCon{'\\', xx} : String},
  +hb: {Laws.abnf.ml_basic_body(Laws.GmChar{kp} <> rr, qq) == True{} : Bool},
  +hx: {Laws.prose.mlb_escapes_scalar(Laws.GmChar{kp} <> rr) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, s1.escb(kp, rr, buf), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.k3.pc.text(kp, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{s1.ms(tm,
  T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  pp.step(PP,
    T.doc.read(Laws.k3.pc.text(kp, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{s1.ms(tm,
      T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
    T.doc.read(Laws.k3.pc.text(kp, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{fs.st(bd, rw,
      hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un, s1.el(tm, lf), ab)}),
    s1.enter.eq(tm, 92, xx, Laws.k3.pc.text(kp, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), bd, rw, hs,
      he, ps, sk, ab, bk, un, lf, buf, hk, {==}, {==}),
    s1.pc(kp, True{}, bd, rw, hs, he, ps, sk, ab, s1.eb(tm, bk), un, s1.el(tm, lf), buf, Laws.g.mlb.text(rr, SCon{'"',
      SCon{'"', SCon{'"', rest}}}), PP,
      s1.mlb.bc(kp, Eq.and.left(Laws.abnf.mlb_char(kp), Laws.abnf.ml_basic_body(rr, False{}), hb)),
      Eq.and.left(Laws.prose.escape_scalar(kp), Laws.prose.mlb_escapes_scalar(rr), hx),
      +b2 => +u2 => +l2 => rec(False{}, Eq.and.right(Laws.abnf.mlb_char(kp), Laws.abnf.ml_basic_body(rr, False{}), hb),
        Eq.and.right(Laws.prose.escape_scalar(kp), Laws.prose.mlb_escapes_scalar(rr), hx), Laws.TNone{}, b2, u2, l2,
        Laws.k3.pc.char(kp) <> buf, ih)))

# a line feed: pushed with no trim, dropped by either trim
def s1.mb.lf(
  tm: Laws.GTrim,
  +rr: List<&2, Laws.GMlb>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hbr: {Laws.abnf.ml_basic_body(rr, False{}) == True{} : Bool},
  +hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool}
) -> s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP) -> s1.Fin(bd, rw, hs, he, ps, sk, ab,
  rev.onto(Laws.g.nl.char(tm, "\n", Laws.g.mlb.chars(rr, Laws.g.nl.trim(tm))), buf), rest, PP) ->
  PP(T.doc.read(String.append("\n", Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{s1.ms(tm,
  T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match tm:
    case Laws.TNone{}:
      rc => ih => rc(False{}, hbr, hx, Laws.TNone{}, bk, un, lf, '\n' <> buf, ih)
    case Laws.TFirst{}:
      rc => ih => rc(False{}, hbr, hx, Laws.TNone{}, bk, un, lf, buf, ih)
    case Laws.TAll{}:
      rc => ih => rc(False{}, hbr, hx, Laws.TAll{}, bk, un, lf, buf, ih)

# a carriage return and a line feed: pushed with no trim, dropped by either
# trim
def s1.mb.crlf(
  tm: Laws.GTrim,
  +rr: List<&2, Laws.GMlb>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hbr: {Laws.abnf.ml_basic_body(rr, False{}) == True{} : Bool},
  +hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool}
) -> s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP) -> s1.Fin(bd, rw, hs, he, ps, sk, ab,
  rev.onto(Laws.g.nl.char(tm, "\r\n", Laws.g.mlb.chars(rr, Laws.g.nl.trim(tm))), buf), rest, PP) ->
  PP(T.doc.read(String.append("\r\n", Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{s1.ms(tm,
  T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match tm:
    case Laws.TNone{}:
      rc => ih => rc(False{}, hbr, hx, Laws.TNone{}, bk, un, lf, '\n' <> ('\r' <> buf), ih)
    case Laws.TFirst{}:
      rc => ih => rc(False{}, hbr, hx, Laws.TNone{}, bk, un, lf, buf, ih)
    case Laws.TAll{}:
      rc => ih => rc(False{}, hbr, hx, Laws.TAll{}, bk, un, lf, buf, ih)

# a newline, a line feed or a carriage return and a line feed
def s1.mb.nl(
  +nl: String,
  +rr: List<&2, Laws.GMlb>,
  +tm: Laws.GTrim,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hb: {Laws.abnf.ml_basic_body(Laws.GmNewline{nl} <> rr, qq) == True{} : Bool},
  +hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, s1.nlb(tm, nl, rr, buf), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(String.append(nl, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{s1.ms(tm,
  T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  +hbr = {Eq.and.right(Laws.abnf.newline(nl), Laws.abnf.ml_basic_body(rr, False{}), hb)
    : {Laws.abnf.ml_basic_body(rr, False{}) == True{} : Bool}}
  s1.nl.elim(nn => s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP) -> s1.Fin(bd, rw, hs, he, ps, sk, ab,
    rev.onto(Laws.g.nl.char(tm, nn, Laws.g.mlb.chars(rr, Laws.g.nl.trim(tm))), buf), rest, PP) ->
    PP(T.doc.read(String.append(nn, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{s1.ms(tm,
    T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})), nl,
    Eq.and.left(Laws.abnf.newline(nl), Laws.abnf.ml_basic_body(rr, False{}), hb),
    s1.mb.lf(tm, rr, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hbr, hx),
    s1.mb.crlf(tm, rr, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hbr, hx))(rec, ih)

# a line-ending backslash: it ends any trim, and the trim after it drops the
# whitespace and newlines that follow
def s1.mb.enl(
  +w1: String,
  +nl: String,
  +more: String,
  +rr: List<&2, Laws.GMlb>,
  +tm: Laws.GTrim,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hb: {Laws.abnf.ml_basic_body(Laws.GmEscapedNl{w1, nl, more} <> rr, qq) == True{} : Bool},
  hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mlb.chars(rr, Laws.TAll{}), buf), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(SCon{'\\', String.append(w1, String.append(nl, String.append(more, Laws.g.mlb.text(rr, SCon{'"',
  SCon{'"', SCon{'"', rest}}}))))}, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  +tx = {Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}}) : String}
  pp.step(PP,
    T.doc.read(SCon{'\\', String.append(w1, String.append(nl, String.append(more, tx)))}, T.MScan{s1.ms(tm, T.QMulti{},
      bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
    T.doc.read(SCon{'\\', String.append(w1, String.append(nl, String.append(more, tx)))}, T.MScan{fs.st(bd, rw, hs, he,
      ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un, s1.el(tm, lf), ab)}),
    s1.enter(tm, False{}, 92, String.append(w1, String.append(nl, String.append(more, tx))), bd, rw, hs, he, ps, sk, ab,
      bk, un, lf, buf, {==}, {==}),
    pp.step(PP,
      T.doc.read(SCon{'\\', String.append(w1, String.append(nl, String.append(more, tx)))}, T.MScan{fs.st(bd, rw, hs,
        he,
        ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un, s1.el(tm, lf), ab)}),
      T.doc.read(tx, s1.fd(T.QMulti{}, bd, rw, hs, he, ps, sk, ab, s1.eb(tm, bk), 0, 1, buf)),
      s1.enl(w1, nl, more, tx, bd, rw, hs, he, ps, sk, ab, s1.eb(tm, bk), un, s1.el(tm, lf), buf,
        Eq.and.left(Laws.abnf.mlb_escaped_nl(w1, nl, more), Laws.abnf.ml_basic_body(rr, False{}), hb)),
      rec(False{}, Eq.and.right(Laws.abnf.mlb_escaped_nl(w1, nl, more), Laws.abnf.ml_basic_body(rr, False{}), hb), hx,
        Laws.TAll{}, s1.eb(tm, bk), 0, lf, buf, ih)))

# after one or two quotes, the next piece (never quotes: ml-basic-body puts
# content between two mlb-quotes) starts with no quotation mark, so the
# quotes return to the string
def s1.mb.qx(
  gm: Laws.GMlb,
  +r2: List<&2, Laws.GMlb>,
  +two: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +buf: List<&2, Char>,
  +rest: String,
  hbr: {Laws.abnf.ml_basic_body(gm <> r2, True{}) == True{} : Bool}
) -> {T.doc.read(Laws.g.mlb.text(gm <> r2, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{fs.st(bd, rw, hs, he, ps,
  buf, T.LMq{}, bk, T.QMulti{}, sk, 0, s1.ql(two), ab)}) == T.doc.read(Laws.g.mlb.text(gm <> r2, SCon{'"', SCon{'"',
  SCon{'"', rest}}}), T.MScan{fs.st(bd, rw, hs, he, ps, s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0, ab)})
  : T.Doc}:
  match gm:
    case Laws.GmChar{kp}:
      match kp:
        case Laws.KpChar{cc}:
          match cc:
            case Chr{+uu}:
              s1.mq.exit(False{}, two, uu, Laws.g.mlb.text(r2, SCon{'"', SCon{'"', SCon{'"', rest}}}), bd, rw, hs, he,
                ps, sk, ab, bk, buf, s1.bu.q(uu, Eq.and.left(Laws.abnf.mlb_unescaped(Chr{uu}),
                Laws.abnf.ml_basic_body(r2, False{}), hbr)))
        case Laws.KpEsc{+mm}:
          s1.mq.exit(False{}, two, 92, SCon{Laws.k3.mark.char(mm), Laws.g.mlb.text(r2, SCon{'"', SCon{'"', SCon{'"',
            rest}}})}, bd, rw, hs, he, ps, sk, ab, bk, buf, {==})
        case Laws.KpU4{+dd, +cc, +bb, +aa}:
          s1.mq.exit(False{}, two, 92, SCon{'u', Laws.k3.hex4.text(dd, cc, bb, aa, Laws.g.mlb.text(r2, SCon{'"',
            SCon{'"', SCon{'"', rest}}}))}, bd, rw, hs, he, ps, sk, ab, bk, buf, {==})
        case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
          s1.mq.exit(False{}, two, 92, SCon{'U', Laws.k3.hex4.text(hh, gg, ff, ee, Laws.k3.hex4.text(dd, cc, bb, aa,
            Laws.g.mlb.text(r2, SCon{'"', SCon{'"', SCon{'"', rest}}})))}, bd, rw, hs, he, ps, sk, ab, bk, buf, {==})
    case Laws.GmNewline{+nl}:
      s1.nl.elim(nn => {T.doc.read(String.append(nn, Laws.g.mlb.text(r2, SCon{'"', SCon{'"', SCon{'"', rest}}})),
        T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, T.QMulti{}, sk, 0, s1.ql(two), ab)})
        == T.doc.read(String.append(nn, Laws.g.mlb.text(r2, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{fs.st(bd,
        rw, hs, he, ps, s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0, ab)}) : T.Doc}, nl,
        Eq.and.left(Laws.abnf.newline(nl), Laws.abnf.ml_basic_body(r2, False{}), hbr),
        s1.mq.exit(False{}, two, 10, Laws.g.mlb.text(r2, SCon{'"', SCon{'"', SCon{'"', rest}}}), bd, rw, hs, he, ps, sk,
          ab, bk, buf, {==}),
        s1.mq.exit(False{}, two, 13, SCon{'\n', Laws.g.mlb.text(r2, SCon{'"', SCon{'"', SCon{'"', rest}}})}, bd, rw, hs,
          he, ps, sk, ab, bk, buf, {==}))
    case Laws.GmEscapedNl{+w1, +nl, +more}:
      s1.mq.exit(False{}, two, 92, String.append(w1, String.append(nl, String.append(more, Laws.g.mlb.text(r2, SCon{'"',
        SCon{'"', SCon{'"', rest}}})))), bd, rw, hs, he, ps, sk, ab, bk, buf, {==})
    case Laws.GmQuotes{t2}:
      Eq.bit.absurd(&2, {T.doc.read(Laws.g.mlb.text(Laws.GmQuotes{t2} <> r2, SCon{'"', SCon{'"', SCon{'"', rest}}}),
        T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, T.QMulti{}, sk, 0, s1.ql(two), ab)})
        == T.doc.read(Laws.g.mlb.text(Laws.GmQuotes{t2} <> r2, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{fs.st(bd,
        rw, hs, he, ps, s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0, ab)}) : T.Doc}, hbr)

# one or two quotes read from LStr: the closing delimiter's when the body
# ends there, or the string's, pushed, when content follows
def s1.mb.qr(
  +two: Bool,
  rr: List<&2, Laws.GMlb>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hbr: {Laws.abnf.ml_basic_body(rr, True{}) == True{} : Bool},
  hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool},
  hr: {s1.nq(False{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mlb.chars(rr, Laws.TNone{}), s1.qp(two, '"', buf)), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.quotes.text(two, '"', Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})),
  T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab)})):
  match rr:
    case []:
      pp.step(PP,
        T.doc.read(Laws.g.quotes.text(two, '"', SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{fs.st(bd, rw, hs, he,
          ps,
          buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab)}),
        T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, s1.qp(two, '"', buf), T.LMqEnd{}, bk, T.QMulti{}, sk, 0,
          s1.ql(two), ab)}),
        s1.m3x(False{}, two, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest),
        s1.mend(False{}, rest, s1.qp(two, '"', buf), bd, rw, hs, he, ps, sk, ab, bk, 0, s1.ql(two), PP, hr, ih))
    case +gm <> +r2:
      pp.step(PP,
        T.doc.read(Laws.g.quotes.text(two, '"', Laws.g.mlb.text(gm <> r2, SCon{'"', SCon{'"', SCon{'"', rest}}})),
          T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMulti{}, sk, un, lf, ab)}),
        T.doc.read(Laws.g.mlb.text(gm <> r2, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{fs.st(bd, rw, hs, he, ps,
          buf, T.LMq{}, bk, T.QMulti{}, sk, 0, s1.ql(two), ab)}),
        s1.mq.in(False{}, two, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.g.mlb.text(gm <> r2, SCon{'"',
          SCon{'"', SCon{'"', rest}}})),
        pp.step(PP,
          T.doc.read(Laws.g.mlb.text(gm <> r2, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{fs.st(bd, rw, hs, he, ps,
            buf, T.LMq{}, bk, T.QMulti{}, sk, 0, s1.ql(two), ab)}),
          T.doc.read(Laws.g.mlb.text(gm <> r2, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{fs.st(bd, rw, hs, he, ps,
            s1.qp(two, '"', buf), T.LStr{}, bk, T.QMulti{}, sk, 0, 0, ab)}),
          s1.mb.qx(gm, r2, two, bd, rw, hs, he, ps, sk, ab, bk, buf, rest, hbr),
          rec(True{}, hbr, hx, Laws.TNone{}, bk, 0, 0, s1.qp(two, '"', buf), ih)))

# one or two quotes in the body: they end any trim
def s1.mb.q(
  two: Bool,
  +rr: List<&2, Laws.GMlb>,
  +tm: Laws.GTrim,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hb: {Laws.abnf.ml_basic_body(Laws.GmQuotes{two} <> rr, qq) == True{} : Bool},
  hx: {Laws.prose.mlb_escapes_scalar(rr) == True{} : Bool},
  hr: {s1.nq(False{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, s1.qb(two, rr, buf), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.quotes.text(two, '"', Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})),
  T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match two:
    case True{}:
      +tx = {Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{'"', SCon{'"', tx}}, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf,
          buf)}),
        T.doc.read(SCon{'"', SCon{'"', tx}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{},
          sk, un, s1.el(tm, lf), ab)}),
        s1.enter(tm, False{}, 34, SCon{'"', tx}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, {==}, {==}),
        s1.mb.qr(True{}, rr, bd, rw, hs, he, ps, sk, ab, s1.eb(tm, bk), un, s1.el(tm, lf), buf, rest, PP,
          Eq.and.right(Bool.not(qq), Laws.abnf.ml_basic_body(rr, True{}), hb), hx, hr, ih, rec))
    case False{}:
      +tx = {Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{'"', tx}, T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)}),
        T.doc.read(SCon{'"', tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(tm, bk), T.QMulti{}, sk, un,
          s1.el(tm, lf), ab)}),
        s1.enter(tm, False{}, 34, tx, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, {==}, {==}),
        s1.mb.qr(False{}, rr, bd, rw, hs, he, ps, sk, ab, s1.eb(tm, bk), un, s1.el(tm, lf), buf, rest, PP,
          Eq.and.right(Bool.not(qq), Laws.abnf.ml_basic_body(rr, True{}), hb), hx, hr, ih, rec))

# one piece of a multi-line basic body, then the rest by the induction
# hypothesis
def s1.mb.cons(
  gm: Laws.GMlb,
  +rr: List<&2, Laws.GMlb>,
  +tm: Laws.GTrim,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hb: {Laws.abnf.ml_basic_body(gm <> rr, qq) == True{} : Bool},
  hx: {Laws.prose.mlb_escapes_scalar(gm <> rr) == True{} : Bool},
  hr: {s1.nq(False{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mlb.chars(gm <> rr, tm), buf), rest, PP),
  rec: s1.MbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.mlb.text(gm <> rr, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{s1.ms(tm, T.QMulti{}, bd,
  rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match gm:
    case Laws.GmChar{kp}:
      match kp:
        case Laws.KpChar{cc}:
          match cc:
            case Chr{+uu}:
              s1.mb.ch(tm, uu, rr, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, hx, ih, rec)
        case Laws.KpEsc{+mm}:
          s1.mb.esc(Laws.KpEsc{mm}, SCon{Laws.k3.mark.char(mm), Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"',
            rest}}})}, rr, tm, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, {==}, hb, hx, ih, rec)
        case Laws.KpU4{+dd, +cc, +bb, +aa}:
          s1.mb.esc(Laws.KpU4{dd, cc, bb, aa}, SCon{'u', Laws.k3.hex4.text(dd, cc, bb, aa, Laws.g.mlb.text(rr, SCon{'"',
            SCon{'"', SCon{'"', rest}}}))}, rr, tm, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, {==}, hb,
            hx, ih, rec)
        case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
          s1.mb.esc(Laws.KpU8{hh, gg, ff, ee, dd, cc, bb, aa}, SCon{'U', Laws.k3.hex4.text(hh, gg, ff, ee,
            Laws.k3.hex4.text(dd, cc, bb, aa, Laws.g.mlb.text(rr, SCon{'"', SCon{'"', SCon{'"', rest}}})))}, rr, tm, qq,
            bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, {==}, hb, hx, ih, rec)
    case Laws.GmNewline{+nl}:
      s1.mb.nl(nl, rr, tm, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, hx, ih, rec)
    case Laws.GmEscapedNl{+w1, +nl, +more}:
      s1.mb.enl(w1, nl, more, rr, tm, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, hx, ih, rec)
    case Laws.GmQuotes{two}:
      s1.mb.q(two, rr, tm, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, hx, hr, ih, rec)

# a multi-line basic body under the trim tm, then the closing delimiter and
# a rest that does not start with a quotation mark, read from the state the
# trim says: the rest is read with an owned string of the characters pushed
# so far and the body's placed
def s1.mb(
  bl: List<&2, Laws.GMlb>,
  +tm: Laws.GTrim,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hb: {Laws.abnf.ml_basic_body(bl, qq) == True{} : Bool},
  hx: {Laws.prose.mlb_escapes_scalar(bl) == True{} : Bool},
  +hr: {s1.nq(False{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mlb.chars(bl, tm), buf), rest, PP)
) -> PP(T.doc.read(Laws.g.mlb.text(bl, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{s1.ms(tm, T.QMulti{}, bd, rw, hs,
  he, ps, sk, ab, bk, un, lf, buf)})):
  match bl:
    case []:
      s1.mb.nil(tm, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hr, ih)
    case +gm <> +rr:
      s1.mb.cons(gm, rr, tm, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, hx, hr, ih,
        +q2 => +h2 => +x2 => +t2 => +b2 => +u2 => +l2 => +f2 => i2 => s1.mb(rr, t2, q2, bd, rw, hs, he, ps, sk, ab, b2,
          u2, l2, f2, rest, PP, h2, x2, hr, i2))

# A multi-line literal body (GMll), one piece at a time. It has no escapes,
# so its only trim is the first newline's (TFirst, by the bit first); every
# other character, a quotation mark and a backslash among them, is pushed as
# itself.

# the trim a multi-line literal body is read under
def s1.ft(first: Bool) -> Laws.GTrim:
  match first:
    case True{}:
      Laws.TFirst{}
    case False{}:
      Laws.TNone{}

# a multi-line literal string's step pushes a character that is no
# apostrophe and that str.bad passes
def s1.fml(
  quote: Bool,
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  hq: {quote == False{} : Bool},
  sb: {T.str.bad(uu, True{}) == False{} : Bool}
) -> {T.read.once2(T.lex.str.go(quote, True{}, False{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk,
  un, lf, ab), Chr{uu}, T.QMultiLit{}))
  == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab) : T.St}:
  match quote:
    case True{}:
      Eq.bit.absurd2(&2, {T.read.once2(T.lex.str.go(True{}, True{}, False{}, fs.st(bd, rw, hs, he, ps, buf, T.LStr{},
        bk, T.QMultiLit{}, sk, un, lf, ab), Chr{uu}, T.QMultiLit{}))
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab) : T.St}, hq)
    case False{}:
      %Equal.sym(Bool, T.str.bad(uu, True{}), False{}, sb) : {T.read.once2(T.lex.str.char.go(_, fs.st(bd, rw, hs, he,
        ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab), Chr{uu}))
        == fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab) : T.St}
      {==}

# a character literal-char takes is pushed, and back, uni and left stay
def s1.lchr(
  +uu: U32,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hl: {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool},
  ih: s1.Then(T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, Chr{uu} <> buf, rest, PP)
) -> PP(T.doc.read(SCon{Chr{uu}, rest}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf,
  ab)})):
  +c9 = {s1.lc.c9(uu, hl) : {Bool.or(U32.is_lt(uu, 32), U32.is_eq(uu, 127)) == U32.is_eq(uu, 9) : Bool}}
  pp.step(PP,
    T.doc.read(SCon{Chr{uu}, rest}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf,
      ab)}),
    T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab)}),
    Equal.cong(T.Mode, T.Doc, md => T.doc.read(rest, md),
      T.doc.scan(fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab), Chr{uu}),
      T.MScan{fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab)},
      s1.scq(U32.is_eq(uu, 34), U32.is_eq(uu, 39), U32.is_eq(uu, 13),
        fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab), Chr{uu},
        fs.st(bd, rw, hs, he, ps, Chr{uu} <> buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab), s1.ncr(uu, c9),
        s1.fml(U32.is_eq(uu, 39), uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, s1.lc.a(uu, hl),
          s1.sb(uu, True{}, c9)), {==})),
    ih(bk, un, lf))

# the rest of a multi-line literal body, then the closing delimiter and
# rest: the induction hypothesis, for every flag, trim bit, back, uni, left
# and buffer
def s1.LbRec(
  +rr: List<&2, Laws.GMll>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type
) -> Type:
  @q2: Bool -> {Laws.abnf.ml_literal_body(rr, q2) == True{} : Bool} ->
    @t2: Bool -> @b2: T.Lex -> @u2: U32 -> @l2: U32 -> @f2: List<&2, Char> ->
    s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mll.chars(rr, s1.ft(t2)), f2), rest, PP) ->
    PP(T.doc.read(Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{s1.ms(s1.ft(t2), T.QMultiLit{},
      bd, rw, hs, he, ps, sk, ab, b2, u2, l2, f2)}))

# the end of a multi-line literal body
def s1.lb.nil(
  first: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hr: {s1.nq(True{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, buf, rest, PP)
) -> PP(T.doc.read(SCon{'\'', SCon{'\'', SCon{'\'', rest}}}, T.MScan{s1.ms(s1.ft(first), T.QMultiLit{}, bd, rw, hs, he,
  ps, sk, ab, bk, un, lf, buf)})):
  match first:
    case True{}:
      pp.step(PP,
        T.doc.read(SCon{'\'', SCon{'\'', SCon{'\'', rest}}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk,
          T.QMultiLit{}, sk, un, lf, ab)}),
        T.doc.read(SCon{'\'', SCon{'\'', SCon{'\'', rest}}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{},
          T.QMultiLit{}, sk, un, lf, ab)}),
        s1.enter.tf(True{}, 39, SCon{'\'', SCon{'\'', rest}}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, {==}),
        pp.step(PP,
          T.doc.read(SCon{'\'', SCon{'\'', SCon{'\'', rest}}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{},
            T.LStr{},
            T.QMultiLit{}, sk, un, lf, ab)}),
          T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMqEnd{}, T.LStr{}, T.QMultiLit{}, sk, 0, 0, ab)}),
          s1.m3(True{}, bd, rw, hs, he, ps, sk, ab, T.LStr{}, un, lf, buf, rest),
          s1.mend(True{}, rest, buf, bd, rw, hs, he, ps, sk, ab, T.LStr{}, 0, 0, PP, hr, ih)))
    case False{}:
      pp.step(PP,
        T.doc.read(SCon{'\'', SCon{'\'', SCon{'\'', rest}}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk,
          T.QMultiLit{}, sk, un, lf, ab)}),
        T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMqEnd{}, bk, T.QMultiLit{}, sk, 0, 0, ab)}),
        s1.m3(True{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest),
        s1.mend(True{}, rest, buf, bd, rw, hs, he, ps, sk, ab, bk, 0, 0, PP, hr, ih))

# a character: it ends the first trim, and is pushed
def s1.lb.ch(
  first: Bool,
  +uu: U32,
  +rr: List<&2, Laws.GMll>,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hb: {Laws.abnf.ml_literal_body(Laws.GlChar{Chr{uu}} <> rr, qq) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(SCon{Chr{uu}, Laws.g.mll.chars(rr, Laws.TNone{})}, buf), rest, PP),
  rec: s1.LbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(SCon{Chr{uu}, Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})}, T.MScan{s1.ms(
  s1.ft(first), T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match first:
    case True{}:
      +hl = {Eq.and.left(Laws.abnf.mll_char(Chr{uu}), Laws.abnf.ml_literal_body(rr, False{}), hb)
        : {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool}}
      +tx = {Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{Chr{uu}, tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LTrim{}, bk, T.QMultiLit{}, sk, un, lf,
          ab)}),
        T.doc.read(SCon{Chr{uu}, tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, T.LStr{}, T.QMultiLit{}, sk, un,
          lf, ab)}),
        s1.enter.tf(True{}, uu, tx, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, s1.nnl(uu, s1.lc.c9(uu, hl))),
        s1.lchr(uu, bd, rw, hs, he, ps, sk, ab, T.LStr{}, un, lf, buf, tx, PP, hl,
          +b2 => +u2 => +l2 => rec(False{}, Eq.and.right(Laws.abnf.mll_char(Chr{uu}), Laws.abnf.ml_literal_body(rr,
          False{}), hb), False{}, b2, u2, l2, Chr{uu} <> buf, ih)))
    case False{}:
      +hl = {Eq.and.left(Laws.abnf.mll_char(Chr{uu}), Laws.abnf.ml_literal_body(rr, False{}), hb)
        : {Laws.abnf.literal_char(Chr{uu}) == True{} : Bool}}
      s1.lchr(uu, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'',
        rest}}}), PP, hl, +b2 => +u2 => +l2 => rec(False{}, Eq.and.right(Laws.abnf.mll_char(Chr{uu}),
        Laws.abnf.ml_literal_body(rr, False{}), hb), False{}, b2, u2, l2, Chr{uu} <> buf, ih))

# a line feed: pushed, or dropped by the first trim
def s1.lb.lf(
  first: Bool,
  +rr: List<&2, Laws.GMll>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hbr: {Laws.abnf.ml_literal_body(rr, False{}) == True{} : Bool}
) -> s1.LbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP) -> s1.Fin(bd, rw, hs, he, ps, sk, ab,
  rev.onto(Laws.g.nl.char(s1.ft(first), "\n", Laws.g.mll.chars(rr, Laws.g.nl.trim(s1.ft(first)))), buf), rest, PP) ->
  PP(T.doc.read(String.append("\n", Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})), T.MScan{s1.ms(
  s1.ft(first), T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match first:
    case True{}:
      rc => ih => rc(False{}, hbr, False{}, bk, un, lf, buf, ih)
    case False{}:
      rc => ih => rc(False{}, hbr, False{}, bk, un, lf, '\n' <> buf, ih)

# a carriage return and a line feed: pushed, or dropped by the first trim
def s1.lb.crlf(
  first: Bool,
  +rr: List<&2, Laws.GMll>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hbr: {Laws.abnf.ml_literal_body(rr, False{}) == True{} : Bool}
) -> s1.LbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP) -> s1.Fin(bd, rw, hs, he, ps, sk, ab,
  rev.onto(Laws.g.nl.char(s1.ft(first), "\r\n", Laws.g.mll.chars(rr, Laws.g.nl.trim(s1.ft(first)))), buf), rest, PP) ->
  PP(T.doc.read(String.append("\r\n", Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})), T.MScan{s1.ms(
  s1.ft(first), T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match first:
    case True{}:
      rc => ih => rc(False{}, hbr, False{}, bk, un, lf, buf, ih)
    case False{}:
      rc => ih => rc(False{}, hbr, False{}, bk, un, lf, '\n' <> ('\r' <> buf), ih)

# after one or two apostrophes, the next piece (never apostrophes) starts
# with no apostrophe, so they return to the string
def s1.lb.qx(
  gl: Laws.GMll,
  +r2: List<&2, Laws.GMll>,
  +two: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +buf: List<&2, Char>,
  +rest: String,
  hbr: {Laws.abnf.ml_literal_body(gl <> r2, True{}) == True{} : Bool}
) -> {T.doc.read(Laws.g.mll.text(gl <> r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{fs.st(bd, rw, hs, he, ps,
  buf, T.LMq{}, bk, T.QMultiLit{}, sk, 0, s1.ql(two), ab)}) == T.doc.read(Laws.g.mll.text(gl <> r2, SCon{'\'',
  SCon{'\'', SCon{'\'', rest}}}), T.MScan{fs.st(bd, rw, hs, he, ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{},
  sk, 0, 0, ab)}) : T.Doc}:
  match gl:
    case Laws.GlChar{cc}:
      match cc:
        case Chr{+uu}:
          s1.mq.exit(True{}, two, uu, Laws.g.mll.text(r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), bd, rw, hs, he, ps,
            sk, ab, bk, buf, s1.lc.a(uu, Eq.and.left(Laws.abnf.mll_char(Chr{uu}), Laws.abnf.ml_literal_body(r2,
            False{}), hbr)))
    case Laws.GlNewline{+nl}:
      s1.nl.elim(nn => {T.doc.read(String.append(nn, Laws.g.mll.text(r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})),
        T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, T.QMultiLit{}, sk, 0, s1.ql(two), ab)})
        == T.doc.read(String.append(nn, Laws.g.mll.text(r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})),
          T.MScan{fs.st(bd,
        rw, hs, he, ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{}, sk, 0, 0, ab)}) : T.Doc}, nl,
        Eq.and.left(Laws.abnf.newline(nl), Laws.abnf.ml_literal_body(r2, False{}), hbr),
        s1.mq.exit(True{}, two, 10, Laws.g.mll.text(r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), bd, rw, hs, he, ps,
          sk, ab, bk, buf, {==}),
        s1.mq.exit(True{}, two, 13, SCon{'\n', Laws.g.mll.text(r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})}, bd, rw,
          hs, he, ps, sk, ab, bk, buf, {==}))
    case Laws.GlQuotes{t2}:
      Eq.bit.absurd(&2, {T.doc.read(Laws.g.mll.text(Laws.GlQuotes{t2} <> r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}),
        T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LMq{}, bk, T.QMultiLit{}, sk, 0, s1.ql(two), ab)})
        == T.doc.read(Laws.g.mll.text(Laws.GlQuotes{t2} <> r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}),
        T.MScan{fs.st(bd, rw, hs, he, ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{}, sk, 0, 0, ab)}) : T.Doc},
        hbr)

# one or two apostrophes read from LStr: the closing delimiter's when the
# body ends there, or the string's, pushed, when content follows
def s1.lb.qr(
  +two: Bool,
  rr: List<&2, Laws.GMll>,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hbr: {Laws.abnf.ml_literal_body(rr, True{}) == True{} : Bool},
  hr: {s1.nq(True{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mll.chars(rr, Laws.TNone{}), s1.qp(two, '\'', buf)), rest, PP),
  rec: s1.LbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.quotes.text(two, '\'', Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})),
  T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab)})):
  match rr:
    case []:
      pp.step(PP,
        T.doc.read(Laws.g.quotes.text(two, '\'', SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{fs.st(bd, rw, hs,
          he,
          ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab)}),
        T.doc.read(rest, T.MScan{fs.st(bd, rw, hs, he, ps, s1.qp(two, '\'', buf), T.LMqEnd{}, bk, T.QMultiLit{}, sk, 0,
          s1.ql(two), ab)}),
        s1.m3x(True{}, two, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest),
        s1.mend(True{}, rest, s1.qp(two, '\'', buf), bd, rw, hs, he, ps, sk, ab, bk, 0, s1.ql(two), PP, hr, ih))
    case +gl <> +r2:
      pp.step(PP,
        T.doc.read(Laws.g.quotes.text(two, '\'', Laws.g.mll.text(gl <> r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})),
          T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab)}),
        T.doc.read(Laws.g.mll.text(gl <> r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{fs.st(bd, rw, hs, he,
          ps,
          buf, T.LMq{}, bk, T.QMultiLit{}, sk, 0, s1.ql(two), ab)}),
        s1.mq.in(True{}, two, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, Laws.g.mll.text(gl <> r2, SCon{'\'',
          SCon{'\'', SCon{'\'', rest}}})),
        pp.step(PP,
          T.doc.read(Laws.g.mll.text(gl <> r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{fs.st(bd, rw, hs, he,
            ps, buf, T.LMq{}, bk, T.QMultiLit{}, sk, 0, s1.ql(two), ab)}),
          T.doc.read(Laws.g.mll.text(gl <> r2, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{fs.st(bd, rw, hs, he,
            ps, s1.qp(two, '\'', buf), T.LStr{}, bk, T.QMultiLit{}, sk, 0, 0, ab)}),
          s1.lb.qx(gl, r2, two, bd, rw, hs, he, ps, sk, ab, bk, buf, rest, hbr),
          rec(True{}, hbr, False{}, bk, 0, 0, s1.qp(two, '\'', buf), ih)))

# one or two apostrophes in the body: they end the first trim
def s1.lb.q(
  two: Bool,
  +first: Bool,
  +rr: List<&2, Laws.GMll>,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hb: {Laws.abnf.ml_literal_body(Laws.GlQuotes{two} <> rr, qq) == True{} : Bool},
  hr: {s1.nq(True{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, s1.lqb(two, rr, buf), rest, PP),
  rec: s1.LbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.quotes.text(two, '\'', Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})),
  T.MScan{s1.ms(s1.ft(first), T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match two:
    case True{}:
      +tx = {Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{'\'', SCon{'\'', tx}}, T.MScan{s1.ms(s1.ft(first), T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab,
          bk,
          un, lf, buf)}),
        T.doc.read(SCon{'\'', SCon{'\'', tx}}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(s1.ft(first), bk),
          T.QMultiLit{}, sk, un, s1.el(s1.ft(first), lf), ab)}),
        s1.enter(s1.ft(first), True{}, 39, SCon{'\'', tx}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, {==}, {==}),
        s1.lb.qr(True{}, rr, bd, rw, hs, he, ps, sk, ab, s1.eb(s1.ft(first), bk), un, s1.el(s1.ft(first), lf), buf,
          rest,
          PP, Eq.and.right(Bool.not(qq), Laws.abnf.ml_literal_body(rr, True{}), hb), hr, ih, rec))
    case False{}:
      +tx = {Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}) : String}
      pp.step(PP,
        T.doc.read(SCon{'\'', tx}, T.MScan{s1.ms(s1.ft(first), T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf,
          buf)}),
        T.doc.read(SCon{'\'', tx}, T.MScan{fs.st(bd, rw, hs, he, ps, buf, T.LStr{}, s1.eb(s1.ft(first), bk),
          T.QMultiLit{}, sk, un, s1.el(s1.ft(first), lf), ab)}),
        s1.enter(s1.ft(first), True{}, 39, tx, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, {==}, {==}),
        s1.lb.qr(False{}, rr, bd, rw, hs, he, ps, sk, ab, s1.eb(s1.ft(first), bk), un, s1.el(s1.ft(first), lf), buf,
          rest, PP, Eq.and.right(Bool.not(qq), Laws.abnf.ml_literal_body(rr, True{}), hb), hr, ih, rec))

# one piece of a multi-line literal body, then the rest by the induction
# hypothesis
def s1.lb.cons(
  gl: Laws.GMll,
  +rr: List<&2, Laws.GMll>,
  +first: Bool,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  +hb: {Laws.abnf.ml_literal_body(gl <> rr, qq) == True{} : Bool},
  hr: {s1.nq(True{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mll.chars(gl <> rr, s1.ft(first)), buf), rest, PP),
  rec: s1.LbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.mll.text(gl <> rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{s1.ms(s1.ft(first),
  T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match gl:
    case Laws.GlChar{cc}:
      match cc:
        case Chr{+uu}:
          s1.lb.ch(first, uu, rr, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, ih, rec)
    case Laws.GlNewline{+nl}:
      +hbr = {Eq.and.right(Laws.abnf.newline(nl), Laws.abnf.ml_literal_body(rr, False{}), hb)
        : {Laws.abnf.ml_literal_body(rr, False{}) == True{} : Bool}}
      s1.nl.elim(nn => s1.LbRec(rr, bd, rw, hs, he, ps, sk, ab, rest, PP) -> s1.Fin(bd, rw, hs, he, ps, sk, ab,
        rev.onto(Laws.g.nl.char(s1.ft(first), nn, Laws.g.mll.chars(rr, Laws.g.nl.trim(s1.ft(first)))), buf), rest,
          PP) ->
        PP(T.doc.read(String.append(nn, Laws.g.mll.text(rr, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})), T.MScan{s1.ms(
        s1.ft(first), T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})), nl,
        Eq.and.left(Laws.abnf.newline(nl), Laws.abnf.ml_literal_body(rr, False{}), hb),
        s1.lb.lf(first, rr, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hbr),
        s1.lb.crlf(first, rr, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hbr))(rec, ih)
    case Laws.GlQuotes{two}:
      s1.lb.q(two, first, rr, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, hr, ih, rec)

# a multi-line literal body, first-trimmed when first, then the closing
# delimiter and a rest that does not start with an apostrophe: the rest is
# read with an owned string of the characters pushed so far and the body's
# placed
def s1.lb(
  bl: List<&2, Laws.GMll>,
  +first: Bool,
  +qq: Bool,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +buf: List<&2, Char>,
  +rest: String,
  -PP: T.Doc -> Type,
  hb: {Laws.abnf.ml_literal_body(bl, qq) == True{} : Bool},
  +hr: {s1.nq(True{}, rest) == True{} : Bool},
  ih: s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mll.chars(bl, s1.ft(first)), buf), rest, PP)
) -> PP(T.doc.read(Laws.g.mll.text(bl, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{s1.ms(s1.ft(first),
  T.QMultiLit{}, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf)})):
  match bl:
    case []:
      s1.lb.nil(first, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hr, ih)
    case +gl <> +rr:
      s1.lb.cons(gl, rr, first, qq, bd, rw, hs, he, ps, sk, ab, bk, un, lf, buf, rest, PP, hb, hr, ih,
        +q2 => +h2 => +t2 => +b2 => +u2 => +l2 => +f2 => i2 => s1.lb(rr, t2, q2, bd, rw, hs, he, ps, sk, ab, b2, u2, l2,
          f2, rest, PP, h2, hr, i2))

# A string denotes no more characters than its text holds: each piece
# stands for at most one character and is written with at least one, and
# the delimiters stand for none. So in a document shorter than 2^32
# characters the string's characters are fewer than 2^32 too, and its span
# counts them without wrapping.

# a text no longer than another
def s1.ln(xs: String, ys: String) -> Bool:
  match xs:
    case SNil{}:
      True{}
    case SCon{_hh, +xt}:
      match ys:
        case SNil{}:
          False{}
        case SCon{_gg, +yt}:
          s1.ln(xt, yt)

# a text no longer than another is no longer than it with one more
# character in front
def s1.ln.r(
  xs: String,
  ys: String,
  +cc: Char,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(xs, SCon{cc, ys}) == True{} : Bool}:
  match xs:
    case SNil{}:
      {==}
    case SCon{+xh, +xt}:
      match ys:
        case SNil{}:
          Eq.bit.absurd(&2, {s1.ln(SCon{xh, xt}, SCon{cc, SNil{}}) == True{} : Bool}, hl)
        case SCon{+yh, +yt}:
          s1.ln.r(xt, yt, yh, hl)

# nor than it with any text in front
def s1.ln.app(
  zs: String,
  +xs: String,
  +ys: String,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(xs, String.append(zs, ys)) == True{} : Bool}:
  match zs:
    case SNil{}:
      hl
    case SCon{+zh, +zt}:
      s1.ln.r(xs, String.append(zt, ys), zh, s1.ln.app(zt, xs, ys, hl))

# a text is no longer than it with any text after it
def s1.ln.pre(
  xs: String,
  +zs: String
) -> {s1.ln(xs, String.append(xs, zs)) == True{} : Bool}:
  match xs:
    case SNil{}:
      {==}
    case SCon{_xh, +xt}:
      s1.ln.pre(xt, zs)

# the same text in front of both keeps the order
def s1.ln.same(
  zs: String,
  +xs: String,
  +ys: String,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(String.append(zs, xs), String.append(zs, ys)) == True{} : Bool}:
  match zs:
    case SNil{}:
      hl
    case SCon{_zh, +zt}:
      s1.ln.same(zt, xs, ys, hl)

# a count that does not wrap over a text does not wrap over a shorter one
def s1.counts.le(
  xs: String,
  ys: String,
  +nn: U32,
  hl: {s1.ln(xs, ys) == True{} : Bool},
  hc: {Laws.counts(ys, nn) == True{} : Bool}
) -> {Laws.counts(xs, nn) == True{} : Bool}:
  match xs:
    case SNil{}:
      {==}
    case SCon{+xh, +xt}:
      match ys:
        case SNil{}:
          Eq.bit.absurd(&2, {Laws.counts(SCon{xh, xt}, nn) == True{} : Bool}, hl)
        case SCon{_yh, +yt}:
          +hc2 = {hc : {Bool.and(Bool.not(U32.is_zero(U32.add(nn, 1))), Laws.counts(yt, U32.add(nn, 1))) == True{}
            : Bool}}
          and.tt(Bool.not(U32.is_zero(U32.add(nn, 1))), Laws.counts(xt, U32.add(nn, 1)),
            Eq.and.left(Bool.not(U32.is_zero(U32.add(nn, 1))), Laws.counts(yt, U32.add(nn, 1)), hc2),
            s1.counts.le(xt, yt, U32.add(nn, 1), hl, Eq.and.right(Bool.not(U32.is_zero(U32.add(nn, 1))),
              Laws.counts(yt, U32.add(nn, 1)), hc2)))

# a piece of a basic string stands for one character and is written with at
# least one
def s1.ln.pc(
  pp: Laws.KPiece,
  +xs: String,
  +ys: String,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(SCon{Laws.k3.pc.char(pp), xs}, Laws.k3.pc.text(pp, ys)) == True{} : Bool}:
  match pp:
    case Laws.KpChar{_cc}:
      hl
    case Laws.KpEsc{+mm}:
      s1.ln.r(xs, ys, Laws.k3.mark.char(mm), hl)
    case Laws.KpU4{+dd, +cc, +bb, +aa}:
      s1.ln.app(SCon{'u', Laws.k3.hex4.text(dd, cc, bb, aa, "")}, xs, ys, hl)
    case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
      s1.ln.app(SCon{'U', Laws.k3.hex4.text(hh, gg, ff, ee, Laws.k3.hex4.text(dd, cc, bb, aa, ""))}, xs, ys, hl)

# a basic string's pieces
def s1.ln.pcs(
  pl: List<&2, Laws.KPiece>,
  +ys: String
) -> {s1.ln(Laws.k3.pcs.name(pl), Laws.k3.pcs.text(pl, ys)) == True{} : Bool}:
  match pl:
    case []:
      {==}
    case +pp <> +pr:
      s1.ln.pc(pp, Laws.k3.pcs.name(pr), Laws.k3.pcs.text(pr, ys), s1.ln.pcs(pr, ys))

# a character is kept or dropped after a line-ending backslash
def s1.ln.pick(
  ww: Bool,
  +cc: Char,
  +xs: String,
  +ys: String,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(Laws.g.mlb.char.pick(ww, cc, xs), SCon{cc, ys}) == True{} : Bool}:
  match ww:
    case True{}:
      s1.ln.r(xs, ys, cc, hl)
    case False{}:
      hl

# a multi-line basic body's character, under any trim
def s1.ln.mch(
  tm: Laws.GTrim,
  +cc: Char,
  +xs: String,
  +ys: String,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(Laws.g.mlb.char(tm, cc, xs), SCon{cc, ys}) == True{} : Bool}:
  match tm:
    case Laws.TAll{}:
      s1.ln.pick(Laws.abnf.wschar(cc), cc, xs, ys, hl)
    case Laws.TFirst{}:
      hl
    case Laws.TNone{}:
      hl

# a newline, kept or trimmed
def s1.ln.nlc(
  tm: Laws.GTrim,
  +nl: String,
  +xs: String,
  +ys: String,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(Laws.g.nl.char(tm, nl, xs), String.append(nl, ys)) == True{} : Bool}:
  match tm:
    case Laws.TAll{}:
      s1.ln.app(nl, xs, ys, hl)
    case Laws.TFirst{}:
      s1.ln.app(nl, xs, ys, hl)
    case Laws.TNone{}:
      s1.ln.same(nl, xs, ys, hl)

# one or two quotes stand for themselves
def s1.ln.q(
  two: Bool,
  +qc: Char,
  +xs: String,
  +ys: String,
  hl: {s1.ln(xs, ys) == True{} : Bool}
) -> {s1.ln(Laws.g.quotes.text(two, qc, xs), Laws.g.quotes.text(two, qc, ys)) == True{} : Bool}:
  match two:
    case True{}:
      hl
    case False{}:
      hl

# a multi-line basic body, under any trim
def s1.ln.mlb(
  bl: List<&2, Laws.GMlb>,
  +tm: Laws.GTrim,
  +ys: String
) -> {s1.ln(Laws.g.mlb.chars(bl, tm), Laws.g.mlb.text(bl, ys)) == True{} : Bool}:
  match bl:
    case []:
      {==}
    case Laws.GmChar{kp} <> +rr:
      match kp:
        case Laws.KpChar{+cc}:
          s1.ln.mch(tm, cc, Laws.g.mlb.chars(rr, Laws.g.mlb.char.trim(tm, cc)), Laws.g.mlb.text(rr, ys),
            s1.ln.mlb(rr, Laws.g.mlb.char.trim(tm, cc), ys))
        case Laws.KpEsc{+mm}:
          s1.ln.pc(Laws.KpEsc{mm}, Laws.g.mlb.chars(rr, Laws.TNone{}), Laws.g.mlb.text(rr, ys),
            s1.ln.mlb(rr, Laws.TNone{}, ys))
        case Laws.KpU4{+dd, +cc, +bb, +aa}:
          s1.ln.pc(Laws.KpU4{dd, cc, bb, aa}, Laws.g.mlb.chars(rr, Laws.TNone{}), Laws.g.mlb.text(rr, ys),
            s1.ln.mlb(rr, Laws.TNone{}, ys))
        case Laws.KpU8{+hh, +gg, +ff, +ee, +dd, +cc, +bb, +aa}:
          s1.ln.pc(Laws.KpU8{hh, gg, ff, ee, dd, cc, bb, aa}, Laws.g.mlb.chars(rr, Laws.TNone{}), Laws.g.mlb.text(rr,
            ys),
            s1.ln.mlb(rr, Laws.TNone{}, ys))
    case Laws.GmNewline{+nl} <> +rr:
      s1.ln.nlc(tm, nl, Laws.g.mlb.chars(rr, Laws.g.nl.trim(tm)), Laws.g.mlb.text(rr, ys),
        s1.ln.mlb(rr, Laws.g.nl.trim(tm), ys))
    case Laws.GmEscapedNl{+w1, +nl, +more} <> +rr:
      s1.ln.r(Laws.g.mlb.chars(rr, Laws.TAll{}), String.append(w1, String.append(nl, String.append(more,
        Laws.g.mlb.text(rr, ys)))), '\\', s1.ln.app(w1, Laws.g.mlb.chars(rr, Laws.TAll{}), String.append(nl,
        String.append(more, Laws.g.mlb.text(rr, ys))), s1.ln.app(nl, Laws.g.mlb.chars(rr, Laws.TAll{}),
        String.append(more, Laws.g.mlb.text(rr, ys)), s1.ln.app(more, Laws.g.mlb.chars(rr, Laws.TAll{}),
        Laws.g.mlb.text(rr, ys), s1.ln.mlb(rr, Laws.TAll{}, ys)))))
    case Laws.GmQuotes{two} <> +rr:
      s1.ln.q(two, '"', Laws.g.mlb.chars(rr, Laws.TNone{}), Laws.g.mlb.text(rr, ys), s1.ln.mlb(rr, Laws.TNone{}, ys))

# a multi-line literal body, under any trim
def s1.ln.mll(
  bl: List<&2, Laws.GMll>,
  +tm: Laws.GTrim,
  +ys: String
) -> {s1.ln(Laws.g.mll.chars(bl, tm), Laws.g.mll.text(bl, ys)) == True{} : Bool}:
  match bl:
    case []:
      {==}
    case Laws.GlChar{_cc} <> +rr:
      s1.ln.mll(rr, Laws.TNone{}, ys)
    case Laws.GlNewline{+nl} <> +rr:
      s1.ln.nlc(tm, nl, Laws.g.mll.chars(rr, Laws.g.nl.trim(tm)), Laws.g.mll.text(rr, ys),
        s1.ln.mll(rr, Laws.g.nl.trim(tm), ys))
    case Laws.GlQuotes{two} <> +rr:
      s1.ln.q(two, '\'', Laws.g.mll.chars(rr, Laws.TNone{}), Laws.g.mll.text(rr, ys), s1.ln.mll(rr, Laws.TNone{}, ys))

# a string of every form
def s1.ln.str(
  st: Laws.GString,
  +tail: String
) -> {s1.ln(Laws.g.str.chars(st), Laws.g.str.text(st, tail)) == True{} : Bool}:
  match st:
    case Laws.GsBasic{+pl}:
      s1.ln.r(Laws.k3.pcs.name(pl), Laws.k3.pcs.text(pl, SCon{'"', tail}), '"', s1.ln.pcs(pl, SCon{'"', tail}))
    case Laws.GsLiteral{+tx}:
      s1.ln.r(tx, String.append(tx, SCon{'\'', tail}), '\'', s1.ln.pre(tx, SCon{'\'', tail}))
    case Laws.GsMlBasic{+nl, +bl}:
      s1.ln.app(SCon{'"', SCon{'"', SCon{'"', nl}}}, Laws.g.mlb.chars(bl, Laws.g.first.trim(nl)), Laws.g.mlb.text(bl,
        SCon{'"', SCon{'"', SCon{'"', tail}}}), s1.ln.mlb(bl, Laws.g.first.trim(nl), SCon{'"', SCon{'"', SCon{'"',
        tail}}}))
    case Laws.GsMlLiteral{+nl, +bl}:
      s1.ln.app(SCon{'\'', SCon{'\'', SCon{'\'', nl}}}, Laws.g.mll.chars(bl, Laws.g.first.trim(nl)), Laws.g.mll.text(bl,
        SCon{'\'', SCon{'\'', SCon{'\'', tail}}}), s1.ln.mll(bl, Laws.g.first.trim(nl), SCon{'\'', SCon{'\'',
        SCon{'\'', tail}}}))

# The whole string, from every value position. The opening delimiter from
# LVal reaches WP-S's span (a basic string), the literal span (a literal
# string) or LTrim (a multi-line string), and the reader of the form takes
# it from there. The value it places holds the characters the derivation
# stands for (g.str.chars).

# a value holding the characters, as the scanner's lemmas say it, is one as
# the law says it
def s1.is.holds(
  vv: T.Val,
  +ss: String,
  hv: sv.Is(vv, ss)
) -> Laws.s1.holds(vv, ss):
  match vv:
    case T.VStr{_tx}:
      hv
    case T.VSpan{_src, _nn}:
      hv
    case T.VInt{_sign, _digits}:
      match hv:
    case T.VFlo{_sign, _text}:
      match hv:
    case T.VBool{_bit}:
      match hv:
    case T.VWhen{_when}:
      match hv:
    case T.VArr{_items}:
      match hv:
    case T.VInl{_rows}:
      match hv:
    case T.VHead{_path, _rows}:
      match hv:
    case T.VAot{_path, _rows}:
      match hv:
    case T.VAots{_path, _elems}:
      match hv:
    case T.VPair{_name, _val}:
      match hv:

# and one g.val relates to a string of those characters (g.str.is), as a
# document proof over the grammar takes it
def s1.holds.is(
  vv: T.Val,
  +ss: String,
  hv: Laws.s1.holds(vv, ss)
) -> {Laws.g.str.is(vv, ss) == True{} : Bool}:
  match vv:
    case T.VStr{tx}:
      %Equal.sym(String, tx, ss, hv) : {String.eq(_, ss) == True{} : Bool}
      Eq.string_eq_self(ss)
    case T.VSpan{src, +nn}:
      %Equal.sym(String, T.span.str(src, nn, U32.is_zero(nn)), ss, hv) : {String.eq(_, ss) == True{} : Bool}
      Eq.string_eq_self(ss)
    case T.VInt{_sign, _digits}:
      match hv:
    case T.VFlo{_sign, _text}:
      match hv:
    case T.VBool{_bit}:
      match hv:
    case T.VWhen{_when}:
      match hv:
    case T.VArr{_items}:
      match hv:
    case T.VInl{_rows}:
      match hv:
    case T.VHead{_path, _rows}:
      match hv:
    case T.VAot{_path, _rows}:
      match hv:
    case T.VAots{_path, _elems}:
      match hv:
    case T.VPair{_name, _val}:
      match hv:

# the law's rest of the walk is the scanner lemmas'
def s1.rest.done(
  +ss: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  ih: Laws.s1.rest(ss, rw, hs, he, ps, sk, ab, rest, PP)
) -> s1.Done(ss, "", rw, hs, he, ps, sk, ab, rest, PP):
  +vv => bk => qk => un => lf => hv => ih(vv, bk, qk, un, lf, s1.is.holds(vv, ss, hv))

# an owned string of the characters pushed onto an empty buffer holds them
def s1.done.fin(
  +ss: String,
  +bd: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  dn: s1.Done(ss, bd, rw, hs, he, ps, sk, ab, rest, PP)
) -> s1.Fin(bd, rw, hs, he, ps, sk, ab, rev.onto(ss, []), rest, PP):
  b2 => q2 => u2 => l2 => dn(T.VStr{T.buf.str(rev.onto(ss, []))}, b2, q2, u2, l2,
    Equal.sym(String, ss, T.buf.str.go(rev.onto(ss, []), ""), k3.nm(ss)))

# the optional newline right after a multi-line string's opening delimiter
# is dropped: with none the body is read under the first trim, and with one
# under none
def s1.mnl(
  +lit: Bool,
  nl: String,
  +xx: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  hn: {Laws.abnf.opt_newline(nl) == True{} : Bool}
) -> {T.doc.read(String.append(nl, xx), T.MScan{fs.st("", rw, hs, he, ps, [], T.LTrim{}, bk, s1.mk(lit), sk, un, lf,
  ab)}) == T.doc.read(xx, T.MScan{s1.ms(Laws.g.first.trim(nl), s1.mk(lit), "", rw, hs, he, ps, sk, ab, bk, un, lf, [])})
  : T.Doc}:
  match nl:
    case SNil{}:
      {==}
    case SCon{hh, tt}:
      s1.nl.elim(ys => {T.doc.read(String.append(ys, xx), T.MScan{fs.st("", rw, hs, he, ps, [], T.LTrim{}, bk,
        s1.mk(lit), sk, un, lf, ab)}) == T.doc.read(xx, T.MScan{s1.ms(Laws.g.first.trim(ys), s1.mk(lit), "", rw, hs, he,
        ps, sk, ab, bk, un, lf, [])}) : T.Doc}, SCon{hh, tt}, hn, {==}, {==})

# a multi-line literal string's body, after the optional newline
def s1.mll(
  nl: String,
  +bl: List<&2, Laws.GMll>,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +sk: List<&2, T.Ctx>,
  +ab: Bool,
  +bk: T.Lex,
  +un: U32,
  +lf: U32,
  +rest: String,
  -PP: T.Doc -> Type,
  hn: {Laws.abnf.opt_newline(nl) == True{} : Bool},
  hb: {Laws.abnf.ml_literal_body(bl, False{}) == True{} : Bool},
  hr: {s1.nq(True{}, rest) == True{} : Bool},
  ih: s1.Fin("", rw, hs, he, ps, sk, ab, rev.onto(Laws.g.mll.chars(bl, Laws.g.first.trim(nl)), []), rest, PP)
) -> PP(T.doc.read(String.append(nl, Laws.g.mll.text(bl, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})), T.MScan{fs.st("",
  rw,
  hs, he, ps, [], T.LTrim{}, bk, T.QMultiLit{}, sk, un, lf, ab)})):
  match nl:
    case SNil{}:
      s1.lb(bl, True{}, False{}, "", rw, hs, he, ps, sk, ab, bk, un, lf, [], rest, PP, hb, hr, ih)
    case SCon{+hh, +tt}:
      pp.step(PP,
        T.doc.read(String.append(SCon{hh, tt}, Laws.g.mll.text(bl, SCon{'\'', SCon{'\'', SCon{'\'', rest}}})),
          T.MScan{fs.st("", rw, hs, he, ps, [], T.LTrim{}, bk, T.QMultiLit{}, sk, un, lf, ab)}),
        T.doc.read(Laws.g.mll.text(bl, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), T.MScan{fs.st("", rw, hs, he, ps, [],
          T.LStr{}, bk, T.QMultiLit{}, sk, un, lf, ab)}),
        s1.mnl(True{}, SCon{hh, tt}, Laws.g.mll.text(bl, SCon{'\'', SCon{'\'', SCon{'\'', rest}}}), rw, hs, he, ps, sk,
          ab, bk, un, lf, hn),
        s1.lb(bl, False{}, False{}, "", rw, hs, he, ps, sk, ab, bk, un, lf, [], rest, PP, hb, hr, ih))

# a string of every form, from every value position: the rest is read with
# a value holding the characters it stands for placed
def s1.str(
  st: Laws.GString,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool,
  +rest: String,
  -PP: T.Doc -> Type,
  +ok: {Laws.g.ok.str(st) == True{} : Bool},
  es: {Laws.short(Laws.g.str.chars(st)) == True{} : Bool},
  +hr: {Laws.s1.free(rest) == True{} : Bool},
  dn: s1.Done(Laws.g.str.chars(st), "", rw, hs, he, ps, sk, ab, rest, PP)
) -> PP(T.doc.read(Laws.g.str.text(st, rest), T.MScan{Laws.vpos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})):
  match st:
    case Laws.GsBasic{+pl}:
      s1.bo(pl, "", rw, hs, he, ps, bk, sk, un, lf, ab, rest, PP, es,
        Eq.and.left(Laws.abnf.basic_string(pl), Laws.prose.escapes_scalar(pl), ok),
        Eq.and.right(Laws.abnf.basic_string(pl), Laws.prose.escapes_scalar(pl), ok), s1.free.sv(rest, hr),
        s1.done.sv(Laws.k3.pcs.name(pl), "", rw, hs, he, ps, sk, ab, rest, PP, dn))
    case Laws.GsLiteral{+tx}:
      s1.lopen(tx, "", rw, hs, he, ps, bk, sk, un, lf, ab, rest, PP, es, ok, hr, dn)
    case Laws.GsMlBasic{+nl, +bl}:
      +h2 = {Eq.and.right(Laws.abnf.opt_newline(nl), Bool.and(Laws.abnf.ml_basic_body(bl, False{}),
        Laws.prose.mlb_escapes_scalar(bl)), ok) : {Bool.and(Laws.abnf.ml_basic_body(bl, False{}),
        Laws.prose.mlb_escapes_scalar(bl)) == True{} : Bool}}
      pp.step(PP,
        T.doc.read(String.append(nl, Laws.g.mlb.text(bl, SCon{'"', SCon{'"', SCon{'"', rest}}})), T.MScan{fs.st("", rw,
          hs, he, ps, [], T.LTrim{}, bk, T.QMulti{}, sk, un, lf, ab)}),
        T.doc.read(Laws.g.mlb.text(bl, SCon{'"', SCon{'"', SCon{'"', rest}}}), T.MScan{s1.ms(Laws.g.first.trim(nl),
          T.QMulti{}, "", rw, hs, he, ps, sk, ab, bk, un, lf, [])}),
        s1.mnl(False{}, nl, Laws.g.mlb.text(bl, SCon{'"', SCon{'"', SCon{'"', rest}}}), rw, hs, he, ps, sk, ab, bk, un,
          lf, Eq.and.left(Laws.abnf.opt_newline(nl), Bool.and(Laws.abnf.ml_basic_body(bl, False{}),
          Laws.prose.mlb_escapes_scalar(bl)), ok)),
        s1.mb(bl, Laws.g.first.trim(nl), False{}, "", rw, hs, he, ps, sk, ab, bk, un, lf, [], rest, PP,
          Eq.and.left(Laws.abnf.ml_basic_body(bl, False{}), Laws.prose.mlb_escapes_scalar(bl), h2),
          Eq.and.right(Laws.abnf.ml_basic_body(bl, False{}), Laws.prose.mlb_escapes_scalar(bl), h2),
          s1.free.nq(False{}, rest, hr),
          s1.done.fin(Laws.g.mlb.chars(bl, Laws.g.first.trim(nl)), "", rw, hs, he, ps, sk, ab, rest, PP, dn)))
    case Laws.GsMlLiteral{+nl, +bl}:
      s1.mll(nl, bl, rw, hs, he, ps, sk, ab, bk, un, lf, rest, PP,
        Eq.and.left(Laws.abnf.opt_newline(nl), Laws.abnf.ml_literal_body(bl, False{}), ok),
        Eq.and.right(Laws.abnf.opt_newline(nl), Laws.abnf.ml_literal_body(bl, False{}), ok),
        s1.free.nq(True{}, rest, hr),
        s1.done.fin(Laws.g.mll.chars(bl, Laws.g.first.trim(nl)), "", rw, hs, he, ps, sk, ab, rest, PP, dn))

# TOML-STR-1: s1.str, with the law's rest of the walk
def Laws.string_reads_as_denoted(st, ok, es, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, hr, PP, ih):
  s1.str(st, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, PP, ok, es, hr,
    s1.rest.done(Laws.g.str.chars(st), rw, hs, he, ps, sk, ab, rest, PP, ih))

# TOML-STR-1: the characters are no more than the text holds (s1.ln.str),
# and a count that does not wrap over the document does not over them
def Laws.string_short_in_document(pre, st, rest, h):
  s1.counts.le(Laws.g.str.chars(st), String.append(pre, Laws.g.str.text(st, rest)), 0,
    s1.ln.app(pre, Laws.g.str.chars(st), Laws.g.str.text(st, rest), s1.ln.str(st, rest)), h)

# a root pair's string value, placed with any back, kind, uni and left, then
# a newline, ends the document of the pair
def s1.root(
  vv: T.Val,
  +kk: String,
  +ss: String,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  hv: Laws.s1.holds(vv, ss)
) -> sw.Own(T.Doc{"", [T.VPair{kk, T.VStr{ss}}]}, T.doc.read("\n", T.MScan{T.take.top([], vv, "", [], [], [], [kk], bk,
  qk, un, lf, False{}, False{})})):
  match vv:
    case T.VStr{tx}:
      Equal.cong(String, T.Doc, xs => T.Doc{"", [T.VPair{kk, T.VStr{xs}}]}, tx, ss, hv)
    case T.VSpan{src, +nn}:
      Equal.cong(String, T.Doc, xs => T.Doc{"", [T.VPair{kk, T.VStr{xs}}]}, T.span.str(src, nn, U32.is_zero(nn)), ss,
        hv)
    case T.VInt{_sign, _digits}:
      match hv:
    case T.VFlo{_sign, _text}:
      match hv:
    case T.VBool{_bit}:
      match hv:
    case T.VWhen{_when}:
      match hv:
    case T.VArr{_items}:
      match hv:
    case T.VInl{_rows}:
      match hv:
    case T.VHead{_path, _rows}:
      match hv:
    case T.VAot{_path, _rows}:
      match hv:
    case T.VAots{_path, _elems}:
      match hv:
    case T.VPair{_name, _val}:
      match hv:

# TOML-STR-1 as a document: a bare key, " = " and the string bring the
# scanner to a value position (kv.key2), where the law reads the string, and
# the newline closes the document of the pair
def Laws.string_parses_as_denoted(k, ek, st, ok, es):
  match k:
    case SNil{}:
      Eq.bit.absurd(&1, sw.Own(T.Doc{"", [T.VPair{SNil{}, T.VStr{Laws.g.str.chars(st)}}]}, T.parse(String.append(SNil{},
        String.append(" = ", Laws.g.str.text(st, "\n"))))), ek)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          pp.step(dd => sw.Own(T.Doc{"", [T.VPair{SCon{Chr{xx}, tt}, T.VStr{Laws.g.str.chars(st)}}]}, dd),
            T.parse(String.append(SCon{Chr{xx}, tt}, String.append(" = ", Laws.g.str.text(st, "\n")))),
            T.doc.read(Laws.g.str.text(st, "\n"), T.MScan{fs.st("", [], [], [], [SCon{Chr{xx}, tt}], [], T.LVal{},
              T.LTop{}, T.QBasic{}, [], 0, 0, False{})}),
            kv.key2(xx, tt, Laws.g.str.text(st, "\n"), ek),
            s1.str(st, [], [], [], [SCon{Chr{xx}, tt}], T.LTop{}, T.QBasic{}, [], 0, 0, False{}, "\n",
              dd => sw.Own(T.Doc{"", [T.VPair{SCon{Chr{xx}, tt}, T.VStr{Laws.g.str.chars(st)}}]}, dd), ok,
              s1.counts.le(Laws.g.str.chars(st), String.append(SCon{Chr{xx}, tt}, String.append(" = ",
                Laws.g.str.text(st, "\n"))), 0, s1.ln.app(SCon{Chr{xx}, tt}, Laws.g.str.chars(st), String.append(" = ",
                Laws.g.str.text(st, "\n")), s1.ln.app(" = ", Laws.g.str.chars(st), Laws.g.str.text(st, "\n"),
                s1.ln.str(st, "\n"))), es), {==},
              +vv => bk => qk => un => lf => hv => s1.root(vv, SCon{Chr{xx}, tt}, Laws.g.str.chars(st), bk, qk, un, lf,
                s1.is.holds(vv, Laws.g.str.chars(st), hv))))

# An array's item. In LArr the opening quote is held and read again in LVal,
# with back at LVal: the string is read from that value position.

# the text of a string of every form, read from the state that waits for an
# array's item, is read from the value position the held quote opens
def s1.arr.eq(
  st: Laws.GString,
  +rest: String,
  +rw: List<&2, T.Val>,
  +hs: List<&2, String>,
  +he: List<&2, String>,
  +ps: List<&2, String>,
  +bk: T.Lex,
  +qk: T.QKind,
  +sk: List<&2, T.Ctx>,
  +un: U32,
  +lf: U32,
  +ab: Bool
) -> {T.doc.read(Laws.g.str.text(st, rest), T.MScan{Laws.s1.apos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)})
  == T.doc.read(Laws.g.str.text(st, rest), T.MScan{Laws.vpos(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab)}) : T.Doc}:
  match st:
    case Laws.GsMlBasic{_nl, _bl}:
      {==}
    case Laws.GsBasic{_pl}:
      {==}
    case Laws.GsMlLiteral{_nl, _bl}:
      {==}
    case Laws.GsLiteral{_tx}:
      {==}

# TOML-STR-1 in an array: s1.arr.eq, then the string from the value position
def Laws.string_reads_as_denoted_in_array(st, ok, es, rw, hs, he, ps, bk, qk, sk, un, lf, ab, rest, hr, PP, ih):
  pp.step(PP,
    T.doc.read(Laws.g.str.text(st, rest), T.MScan{Laws.s1.apos(rw, hs, he, ps, bk, qk, sk, un, lf, ab)}),
    T.doc.read(Laws.g.str.text(st, rest), T.MScan{Laws.vpos(rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab)}),
    s1.arr.eq(st, rest, rw, hs, he, ps, bk, qk, sk, un, lf, ab),
    s1.str(st, rw, hs, he, ps, T.LVal{}, qk, sk, un, lf, ab, rest, PP, ok, es, hr,
      s1.rest.done(Laws.g.str.chars(st), rw, hs, he, ps, sk, ab, rest, PP, ih)))

# an array item's string value, placed with any back, kind, uni and left,
# then `]` and a newline, ends the document of the pair
def s1.item(
  vv: T.Val,
  +kk: String,
  +ss: String,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  hv: Laws.s1.holds(vv, ss)
) -> sw.Own(T.Doc{"", [T.VPair{kk, T.VArr{[T.VStr{ss}]}}]}, T.doc.read("]\n", T.MScan{T.take.top([T.CArr{[], [kk], []}],
  vv, "", [], [], [], [], bk, qk, un, lf, False{}, False{})})):
  match vv:
    case T.VStr{tx}:
      Equal.cong(String, T.Doc, xs => T.Doc{"", [T.VPair{kk, T.VArr{[T.VStr{xs}]}}]}, tx, ss, hv)
    case T.VSpan{src, +nn}:
      Equal.cong(String, T.Doc, xs => T.Doc{"", [T.VPair{kk, T.VArr{[T.VStr{xs}]}}]},
        T.span.str(src, nn, U32.is_zero(nn)), ss, hv)
    case T.VInt{_sign, _digits}:
      match hv:
    case T.VFlo{_sign, _text}:
      match hv:
    case T.VBool{_bit}:
      match hv:
    case T.VWhen{_when}:
      match hv:
    case T.VArr{_items}:
      match hv:
    case T.VInl{_rows}:
      match hv:
    case T.VHead{_path, _rows}:
      match hv:
    case T.VAot{_path, _rows}:
      match hv:
    case T.VAots{_path, _elems}:
      match hv:
    case T.VPair{_name, _val}:
      match hv:

# TOML-STR-1 as an array's item: a bare key and " = [" bring the scanner to
# an array's item (kv.key2), where the law reads the string, and `]` and the
# newline close the document
def Laws.string_parses_as_denoted_in_array(k, ek, st, ok, es):
  match k:
    case SNil{}:
      Eq.bit.absurd(&1, sw.Own(T.Doc{"", [T.VPair{SNil{}, T.VArr{[T.VStr{Laws.g.str.chars(st)}]}}]},
        T.parse(String.append(SNil{}, String.append(" = [", Laws.g.str.text(st, "]\n"))))), ek)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          pp.step(dd => sw.Own(T.Doc{"", [T.VPair{SCon{Chr{xx}, tt}, T.VArr{[T.VStr{Laws.g.str.chars(st)}]}}]}, dd),
            T.parse(String.append(SCon{Chr{xx}, tt}, String.append(" = [", Laws.g.str.text(st, "]\n")))),
            T.doc.read(Laws.g.str.text(st, "]\n"), T.MScan{Laws.s1.apos([], [], [], [], T.LTop{}, T.QBasic{},
              [T.CArr{[], [SCon{Chr{xx}, tt}], []}], 0, 0, False{})}),
            kv.key2(xx, tt, SCon{'[', Laws.g.str.text(st, "]\n")}, ek),
            Laws.string_reads_as_denoted_in_array(st, ok, s1.counts.le(Laws.g.str.chars(st), String.append(SCon{Chr{xx},
              tt}, String.append(" = [", Laws.g.str.text(st, "]\n"))), 0, s1.ln.app(SCon{Chr{xx}, tt},
              Laws.g.str.chars(st), String.append(" = [", Laws.g.str.text(st, "]\n")), s1.ln.app(" = [",
              Laws.g.str.chars(st), Laws.g.str.text(st, "]\n"), s1.ln.str(st, "]\n"))), es), [], [], [], [], T.LTop{},
              T.QBasic{}, [T.CArr{[], [SCon{Chr{xx}, tt}], []}], 0, 0, False{}, "]\n",
              {==}, dd => sw.Own(T.Doc{"", [T.VPair{SCon{Chr{xx}, tt}, T.VArr{[T.VStr{Laws.g.str.chars(st)}]}}]}, dd),
              +vv => bk => qk => un => lf => hv => s1.item(vv, SCon{Chr{xx}, tt}, Laws.g.str.chars(st), bk, qk, un, lf,
                hv)))

# an inline table's string value, placed with any back, kind, uni and left,
# then `}` and a newline, ends the document of the pair
def s1.inl.val(
  vv: T.Val,
  +kk: String,
  +ss: String,
  +bk: T.Lex,
  +qk: T.QKind,
  +un: U32,
  +lf: U32,
  hv: Laws.s1.holds(vv, ss)
) -> sw.Own(T.Doc{"", [T.VPair{kk, T.VInl{[T.VPair{"v", T.VStr{ss}}]}}]}, T.doc.read("}\n",
  T.MScan{T.take.top([T.CInl{[], [kk], []}], vv, "", [], [], [], ["v"], bk, qk, un, lf, False{}, False{})})):
  match vv:
    case T.VStr{tx}:
      Equal.cong(String, T.Doc, xs => T.Doc{"", [T.VPair{kk, T.VInl{[T.VPair{"v", T.VStr{xs}}]}}]}, tx, ss, hv)
    case T.VSpan{src, +nn}:
      Equal.cong(String, T.Doc, xs => T.Doc{"", [T.VPair{kk, T.VInl{[T.VPair{"v", T.VStr{xs}}]}}]},
        T.span.str(src, nn, U32.is_zero(nn)), ss, hv)
    case T.VInt{_sign, _digits}:
      match hv:
    case T.VFlo{_sign, _text}:
      match hv:
    case T.VBool{_bit}:
      match hv:
    case T.VWhen{_when}:
      match hv:
    case T.VArr{_items}:
      match hv:
    case T.VInl{_rows}:
      match hv:
    case T.VHead{_path, _rows}:
      match hv:
    case T.VAot{_path, _rows}:
      match hv:
    case T.VAots{_path, _elems}:
      match hv:
    case T.VPair{_name, _val}:
      match hv:

# TOML-STR-1 as an inline table's value: a bare key and " = {v = " bring the
# scanner to the inline table's value position (kv.key2), where the law
# reads the string, and `}` and the newline close the document
def Laws.string_parses_as_denoted_in_inline_table(k, ek, st, ok, es):
  match k:
    case SNil{}:
      Eq.bit.absurd(&1, sw.Own(T.Doc{"", [T.VPair{SNil{}, T.VInl{[T.VPair{"v", T.VStr{Laws.g.str.chars(st)}}]}}]},
        T.parse(String.append(SNil{}, String.append(" = {v = ", Laws.g.str.text(st, "}\n"))))), ek)
    case SCon{hh, +tt}:
      match hh:
        case Chr{+xx}:
          pp.step(dd => sw.Own(T.Doc{"", [T.VPair{SCon{Chr{xx}, tt}, T.VInl{[T.VPair{"v",
            T.VStr{Laws.g.str.chars(st)}}]}}]}, dd),
            T.parse(String.append(SCon{Chr{xx}, tt}, String.append(" = {v = ", Laws.g.str.text(st, "}\n")))),
            T.doc.read(Laws.g.str.text(st, "}\n"), T.MScan{fs.st("", [], [], [], ["v"], [], T.LVal{}, T.LTop{},
              T.QBasic{}, [T.CInl{[], [SCon{Chr{xx}, tt}], []}], 0, 0, False{})}),
            kv.key2(xx, tt, SCon{'{', SCon{'v', SCon{' ', SCon{'=', SCon{' ', Laws.g.str.text(st, "}\n")}}}}}, ek),
            s1.str(st, [], [], [], ["v"], T.LTop{}, T.QBasic{}, [T.CInl{[], [SCon{Chr{xx}, tt}], []}], 0, 0, False{},
              "}\n", dd => sw.Own(T.Doc{"", [T.VPair{SCon{Chr{xx}, tt}, T.VInl{[T.VPair{"v",
              T.VStr{Laws.g.str.chars(st)}}]}}]}, dd), ok,
              s1.counts.le(Laws.g.str.chars(st), String.append(SCon{Chr{xx}, tt}, String.append(" = {v = ",
                Laws.g.str.text(st, "}\n"))), 0, s1.ln.app(SCon{Chr{xx}, tt}, Laws.g.str.chars(st),
                String.append(" = {v = ", Laws.g.str.text(st, "}\n")), s1.ln.app(" = {v = ", Laws.g.str.chars(st),
                Laws.g.str.text(st, "}\n"), s1.ln.str(st, "}\n"))), es), {==},
              +vv => bk => qk => un => lf => hv => s1.inl.val(vv, SCon{Chr{xx}, tt}, Laws.g.str.chars(st), bk, qk, un,
                lf, s1.is.holds(vv, Laws.g.str.chars(st), hv))))

# WP-N1: the integer, float and boolean words, exact in both directions
# (docs/rfc/eztoml-grammar-proofs.md). The numeral scan is followed state by
# state. From each state the scan finishes as a float exactly when the rest of
# the word matches what toml.abnf's float rule asks for from the position
# that state stands for, and as an integer likewise: one Bool equation per
# state gives both the accept and the refuse direction. The routing lemmas
# show that a word the scan does not fail is sent to it, and the value
# lemmas that the scan's value is the one g.val says the word denotes.

# a digit is a DIGIT, whatever the character
def n1.dig(cc: Char) -> {Char.is_digit(cc) == Laws.abnf.DIGIT(cc) : Bool}:
  match cc:
    case Chr{+cp}:
      {==}

# the character _ is an underscore, whatever the character
def n1.us(cc: Char) -> {Char.is_eq(cc, '_') == Laws.abnf.underscore(cc) : Bool}:
  match cc:
    case Chr{+cp}:
      {==}

# an or with False on its right is its left
def n1.orf(aa: Bool) -> {Bool.or(aa, False{}) == aa : Bool}:
  match aa:
    case True{}:
      {==}
    case False{}:
      {==}

# a digit fits base ten
def n1.dok10(cc: Char, hc: {Char.is_digit(cc) == True{} : Bool}) -> {T.dig.ok(T.dig.val(cc), 10) == True{} : Bool}:
  dg.elim(zz => {T.dig.ok(T.dig.val(zz), 10) == True{} : Bool}, cc, hc,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a digit is no underscore
def n1.nous(cc: Char, hc: {Char.is_digit(cc) == True{} : Bool}) -> {Char.is_eq(cc, '_') == False{} : Bool}:
  dg.elim(zz => {Char.is_eq(zz, '_') == False{} : Bool}, cc, hc,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a character that is both a digit and an underscore is not there
def n1.du(
  -A: Type,
  cc: Char,
  hd: {Char.is_digit(cc) == True{} : Bool},
  hu: {Char.is_eq(cc, '_') == True{} : Bool}
) -> A:
  Eq.bit.absurd2(&1, A, Equal.trans(Bool, True{}, Char.is_eq(cc, '_'), False{}, Equal.sym(Bool, Char.is_eq(cc, '_'),
    True{}, hu), n1.nous(cc, hd)))

# a failed scan stays failed, whatever follows
def n1.bad.go(
  rest: List<&2, Char>,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {T.num.go(rest, T.Num{T.NBad{}, sg, base, ds, us, saw, why}) == T.Num{T.NBad{}, sg, base, ds, us, saw,
  why} : T.Num}:
  match rest:
    case []:
      {==}
    case _h <> tt:
      n1.bad.go(tt, sg, base, ds, us, saw, why)

# a finished numeral scan holds a float: a fraction or an exponent with a
# digit read
def n1.fsh.nk(nk: T.NK, saw: Bool) -> Bool:
  match nk:
    case T.NFrac{}:
      saw
    case T.NEDig{}:
      saw
    case _k:
      False{}

# whether a finished numeral scan holds a float, with no underscore last
def n1.fsh(st: T.Num) -> Bool:
  match st:
    case T.Num{nk, _sign, _base, _ds, us, saw, _why}:
      Bool.and(n1.fsh.nk(nk, saw), Bool.not(us))

# a failed scan holds no float, whatever follows
def n1.fsh.bad(
  rest: List<&2, Char>,
  +why: String
) -> {n1.fsh(T.num.go(rest, T.Num{T.NBad{}, T.Plus{}, 10, [], False{}, False{}, why})) == False{} : Bool}:
  %Equal.sym(T.Num, T.num.go(rest, T.Num{T.NBad{}, T.Plus{}, 10, [], False{}, False{}, why}), T.Num{T.NBad{}, T.Plus{},
    10, [], False{}, False{}, why}, n1.bad.go(rest, T.Plus{}, 10, [], False{}, False{}, why)) : {n1.fsh(_) == False{}
    : Bool}
  {==}

# the scan after a digit of an exponent
def n1.sx(+sg: T.Sign, +ds: List<&2, U32>, +why: String) -> T.Num:
  T.Num{T.NEDig{}, sg, 10, ds, False{}, True{}, why}

# what the exponent-digit lemma claims: after a digit of an exponent, the
# scan finishes as a float exactly when the rest is *( DIGIT / underscore
# DIGIT )
def n1.X.G(rest: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> Type:
  {n1.fsh(T.num.go(rest, n1.sx(sg, ds, why))) == Laws.abnf.dec_rep(rest) : Bool}

# one character left
def n1.X.one(
  dd: Bool,
  uu: Bool,
  +cc: Char,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  ed: {Char.is_digit(cc) == dd : Bool}
) -> {n1.fsh(T.num.edig.go(dd, uu, n1.sx(sg, ds, why), cc)) == dd : Bool}:
  match dd:
    case True{}:
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) :
        {n1.fsh(T.num.digit.ok(_, cc, T.NEDig{}, sg, 10, ds)) == True{} : Bool}
      {==}
    case False{}:
      match uu:
        case True{}:
          {==}
        case False{}:
          {==}

# an exponent's state where an underscore fails (after an underscore, or
# before the first digit): a digit goes on, anything else fails
def n1.X.us(
  dd: Bool,
  uu: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  ed: {Char.is_digit(cc) == dd : Bool},
  hq: {Bool.and(saw, Bool.not(us)) == False{} : Bool},
  ih: n1.X.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.edig.go(dd, uu, T.Num{T.NEDig{}, sg, 10, ds, us, saw, why}, cc)))
  == Bool.and(dd, Laws.abnf.dec_rep(tt)) : Bool}:
  match dd:
    case True{}:
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) :
        {n1.fsh(T.num.go(tt, T.num.digit.ok(_, cc, T.NEDig{}, sg, 10, ds))) == Laws.abnf.dec_rep(tt) : Bool}
      ih
    case False{}:
      match uu:
        case True{}:
          %Equal.sym(Bool, Bool.and(saw, Bool.not(us)), False{}, hq) :
            {n1.fsh(T.num.go(tt, T.num.us.go(_, T.NEDig{}, sg, 10, ds, why))) == False{} : Bool}
          n1.fsh.bad(tt, "invalid underscore")
        case False{}:
          n1.fsh.bad(tt, "invalid exponent")

# what the exponent's underscore lemma claims: after an underscore, the scan
# finishes as a float exactly when a digit and the repetition follow
def n1.X.U(+h2: Char, +t2: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> Type:
  {n1.fsh(T.num.go(h2 <> t2, T.Num{T.NEDig{}, sg, 10, ds, True{}, True{}, why})) == Bool.and(Char.is_digit(h2),
    Laws.abnf.dec_rep(t2)) : Bool}

# two or more characters left
def n1.X.two(
  dd: Bool,
  uu: Bool,
  +cc: Char,
  +h2: Char,
  +t2: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  ed: {Char.is_digit(cc) == dd : Bool},
  eu: {Char.is_eq(cc, '_') == uu : Bool},
  ihd: n1.X.G(h2 <> t2, sg, T.dec.go(ds, 10, T.dig.val(cc)), ""),
  ihu: n1.X.U(h2, t2, sg, ds, why)
) -> {n1.fsh(T.num.go(h2 <> t2, T.num.edig.go(dd, uu, n1.sx(sg, ds, why), cc))) == Bool.or(Bool.and(dd,
  Laws.abnf.dec_rep(h2 <> t2)), Bool.and(uu, Bool.and(Char.is_digit(h2), Laws.abnf.dec_rep(t2)))) : Bool}:
  match dd:
    case True{}:
      match uu:
        case True{}:
          n1.du({n1.fsh(T.num.go(h2 <> t2, T.num.edig.go(True{}, True{}, n1.sx(sg, ds, why), cc)))
            == Bool.or(Laws.abnf.dec_rep(h2 <> t2), Bool.and(Char.is_digit(h2), Laws.abnf.dec_rep(t2))) : Bool}, cc, ed,
            eu)
        case False{}:
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) :
            {n1.fsh(T.num.go(h2 <> t2, T.num.digit.ok(_, cc, T.NEDig{}, sg, 10, ds))) == Bool.or(Laws.abnf.dec_rep(h2
              <> t2), False{}) : Bool}
          Equal.trans(Bool, n1.fsh(T.num.go(h2 <> t2, n1.sx(sg, T.dec.go(ds, 10, T.dig.val(cc)), ""))),
            Laws.abnf.dec_rep(h2 <> t2), Bool.or(Laws.abnf.dec_rep(h2 <> t2), False{}), ihd,
            Equal.sym(Bool, Bool.or(Laws.abnf.dec_rep(h2 <> t2), False{}), Laws.abnf.dec_rep(h2 <> t2),
              n1.orf(Laws.abnf.dec_rep(h2 <> t2))))
    case False{}:
      match uu:
        case True{}:
          ihu
        case False{}:
          n1.fsh.bad(h2 <> t2, "invalid exponent")

# after a digit of an exponent, the scan finishes as a float exactly when the
# rest is *( DIGIT / underscore DIGIT )
def n1.X(rest: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> n1.X.G(rest, sg, ds, why):
  match rest:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          %n1.dig(hh) : {n1.fsh(T.num.go([hh], n1.sx(sg, ds, why))) == _ : Bool}
          n1.X.one(Char.is_digit(hh), Char.is_eq(hh, '_'), hh, sg, ds, why, {==})
        case +h2 <> +t2:
          %n1.dig(hh) : {n1.fsh(T.num.go(hh <> h2 <> t2, n1.sx(sg, ds, why))) == Bool.or(Bool.and(_,
            Laws.abnf.dec_rep(h2 <> t2)), Bool.and(Laws.abnf.underscore(hh), Bool.and(Laws.abnf.DIGIT(h2),
            Laws.abnf.dec_rep(t2)))) : Bool}
          %n1.us(hh) : {n1.fsh(T.num.go(hh <> h2 <> t2, n1.sx(sg, ds, why))) == Bool.or(Bool.and(Char.is_digit(hh),
            Laws.abnf.dec_rep(h2 <> t2)), Bool.and(_, Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)))) : Bool}
          %n1.dig(h2) : {n1.fsh(T.num.go(hh <> h2 <> t2, n1.sx(sg, ds, why))) == Bool.or(Bool.and(Char.is_digit(hh),
            Laws.abnf.dec_rep(h2 <> t2)), Bool.and(Char.is_eq(hh, '_'), Bool.and(_, Laws.abnf.dec_rep(t2)))) : Bool}
          n1.X.two(Char.is_digit(hh), Char.is_eq(hh, '_'), hh, h2, t2, sg, ds, why, {==}, {==},
            n1.X(h2 <> t2, sg, T.dec.go(ds, 10, T.dig.val(hh)), ""),
            n1.X.us(Char.is_digit(h2), Char.is_eq(h2, '_'), h2, t2, sg, ds, True{}, True{}, why, {==}, {==},
              n1.X(t2, sg, T.dec.go(ds, 10, T.dig.val(h2)), "")))

# a character a test found equal to k, where k fails a predicate the
# character passes, is not there
def n1.no(
  -A: Type,
  cc: Char,
  kk: Char,
  pp: Char -> Bool,
  ee: {Char.is_eq(cc, kk) == True{} : Bool},
  yes: {pp(cc) == True{} : Bool},
  no: {pp(kk) == False{} : Bool}
) -> A:
  Eq.bit.gone(&1, A, Eq.refute_char(cc, kk, pp, ee, yes, no))

# an or of a claim and False is the claim
def n1.orf.eq(
  +aa: Bool,
  +bb: Bool,
  ee: {aa == bb : Bool}
) -> {aa == Bool.or(bb, False{}) : Bool}:
  Equal.trans(Bool, aa, bb, Bool.or(bb, False{}), ee, Equal.sym(Bool, Bool.or(bb, False{}), bb, n1.orf(bb)))

# the scan before an exponent's first digit, after its sign
def n1.ses(+sg: T.Sign) -> T.Num:
  T.Num{T.NEDig{}, sg, 10, [], False{}, False{}, ""}

# after an exponent's sign, the scan finishes as a float exactly when the
# rest is a zero-prefixable-int
def n1.Es(
  rest: List<&2, Char>,
  +sg: T.Sign
) -> {n1.fsh(T.num.go(rest, n1.ses(sg))) == Laws.abnf.zero_prefixable_int(rest) : Bool}:
  match rest:
    case []:
      {==}
    case +hh <> +tt:
      %n1.dig(hh) : {n1.fsh(T.num.go(hh <> tt, n1.ses(sg))) == Bool.and(_, Laws.abnf.dec_rep(tt)) : Bool}
      n1.X.us(Char.is_digit(hh), Char.is_eq(hh, '_'), hh, tt, sg, [], False{}, False{}, "", {==}, {==},
        n1.X(tt, sg, T.dec.go([], 10, T.dig.val(hh)), ""))

# the scan after an exponent's e
def n1.se(+sg: T.Sign) -> T.Num:
  T.Num{T.NExp{}, sg, 10, [], False{}, False{}, ""}

# the character after e: a sign, a digit, or anything else, which fails
def n1.E.go(
  pp: Bool,
  mm: Bool,
  dd: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  ep: {Char.is_eq(cc, '+') == pp : Bool},
  em: {Char.is_eq(cc, '-') == mm : Bool},
  ed: {Char.is_digit(cc) == dd : Bool},
  ihs: {n1.fsh(T.num.go(tt, n1.ses(sg))) == Laws.abnf.zero_prefixable_int(tt) : Bool},
  ihx: n1.X.G(tt, sg, T.dec.go([], 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.expon.go(pp, mm, dd, n1.se(sg), cc))) == Bool.or(Bool.and(Bool.or(mm, pp),
  Laws.abnf.zero_prefixable_int(tt)), Bool.and(dd, Laws.abnf.dec_rep(tt))) : Bool}:
  match pp:
    case True{}:
      match mm:
        case True{}:
          n1.no({n1.fsh(T.num.go(tt, T.num.expon.go(True{}, True{}, dd, n1.se(sg), cc))) == Bool.or(
            Laws.abnf.zero_prefixable_int(tt), Bool.and(dd, Laws.abnf.dec_rep(tt))) : Bool}, cc, '+',
            xx => Char.is_eq(xx, '-'), ep, em, {==})
        case False{}:
          match dd:
            case True{}:
              n1.no({n1.fsh(T.num.go(tt, T.num.expon.go(True{}, False{}, True{}, n1.se(sg), cc))) ==
                Bool.or(Laws.abnf.zero_prefixable_int(tt), Laws.abnf.dec_rep(tt)) : Bool}, cc, '+',
                xx => Char.is_digit(xx), ep, ed, {==})
            case False{}:
              n1.orf.eq(n1.fsh(T.num.go(tt, n1.ses(sg))), Laws.abnf.zero_prefixable_int(tt), ihs)
    case False{}:
      match mm:
        case True{}:
          match dd:
            case True{}:
              n1.no({n1.fsh(T.num.go(tt, T.num.expon.go(False{}, True{}, True{}, n1.se(sg), cc))) ==
                Bool.or(Laws.abnf.zero_prefixable_int(tt), Laws.abnf.dec_rep(tt)) : Bool}, cc, '-',
                xx => Char.is_digit(xx), em, ed, {==})
            case False{}:
              n1.orf.eq(n1.fsh(T.num.go(tt, n1.ses(sg))), Laws.abnf.zero_prefixable_int(tt), ihs)
        case False{}:
          match dd:
            case True{}:
              %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) :
                {n1.fsh(T.num.go(tt, T.num.digit.ok(_, cc, T.NEDig{}, sg, 10, []))) == Laws.abnf.dec_rep(tt) : Bool}
              ihx
            case False{}:
              n1.fsh.bad(tt, "invalid exponent")

# the character - is the minus of the grammar, whatever the character
def n1.minus(cc: Char) -> {Char.is_eq(cc, '-') == Laws.abnf.minus(cc) : Bool}:
  match cc:
    case Chr{+cp}:
      {==}

# and + the plus
def n1.plus(cc: Char) -> {Char.is_eq(cc, '+') == Laws.abnf.plus(cc) : Bool}:
  match cc:
    case Chr{+cp}:
      {==}

# after an exponent's e, the scan finishes as a float exactly when the rest
# is a float-exp-part
def n1.E(
  rest: List<&2, Char>,
  +sg: T.Sign
) -> {n1.fsh(T.num.go(rest, n1.se(sg))) == Laws.abnf.float_exp_part(rest) : Bool}:
  match rest:
    case []:
      {==}
    case +hh <> +tt:
      %n1.minus(hh) : {n1.fsh(T.num.go(hh <> tt, n1.se(sg))) == Bool.or(Bool.and(Bool.or(_, Laws.abnf.plus(hh)),
        Laws.abnf.zero_prefixable_int(tt)), Laws.abnf.zero_prefixable_int(hh <> tt)) : Bool}
      %n1.plus(hh) : {n1.fsh(T.num.go(hh <> tt, n1.se(sg))) == Bool.or(Bool.and(Bool.or(Char.is_eq(hh, '-'), _),
        Laws.abnf.zero_prefixable_int(tt)), Laws.abnf.zero_prefixable_int(hh <> tt)) : Bool}
      %n1.dig(hh) : {n1.fsh(T.num.go(hh <> tt, n1.se(sg))) == Bool.or(Bool.and(Bool.or(Char.is_eq(hh, '-'),
        Char.is_eq(hh, '+')), Laws.abnf.zero_prefixable_int(tt)), Bool.and(_, Laws.abnf.dec_rep(tt))) : Bool}
      n1.E.go(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), Char.is_digit(hh), hh, tt, sg, {==}, {==}, {==},
        n1.Es(tt, sg), n1.X(tt, sg, T.dec.go([], 10, T.dig.val(hh)), ""))

# The cut of a float's text. A character where no cut falls is kept in front
# of the part before the cut, and the part from the cut on is the rest's.

# a character where no cut falls stays in front of the part before the cut
def n1.pre.no(
  +ct: Laws.ACut,
  +cc: Char,
  +xs: List<&2, Char>,
  hc: {Laws.abnf.cut.at(ct, cc) == False{} : Bool}
) -> {cc <> Laws.abnf.cut.pre(xs, ct) == Laws.abnf.cut.pre(cc <> xs, ct) : List<&2, Char>}:
  %Equal.sym(Bool, Laws.abnf.cut.at(ct, cc), False{}, hc) : {cc <> Laws.abnf.cut.pre(xs, ct)
    == Laws.abnf.cut.pre.pick(_, cc, Laws.abnf.cut.pre(xs, ct)) : List<&2, Char>}
  {==}

# and the part from the cut on is the rest's
def n1.post.no(
  +ct: Laws.ACut,
  +cc: Char,
  +xs: List<&2, Char>,
  hc: {Laws.abnf.cut.at(ct, cc) == False{} : Bool}
) -> {Laws.abnf.cut.post(xs, ct) == Laws.abnf.cut.post(cc <> xs, ct) : List<&2, Char>}:
  %Equal.sym(Bool, Laws.abnf.cut.at(ct, cc), False{}, hc) : {Laws.abnf.cut.post(xs, ct)
    == Laws.abnf.cut.post.pick(_, cc, xs, Laws.abnf.cut.post(xs, ct)) : List<&2, Char>}
  {==}

# no cut falls at a digit
def n1.at.dig(
  ct: Laws.ACut,
  cc: Char,
  hc: {Char.is_digit(cc) == True{} : Bool}
) -> {Laws.abnf.cut.at(ct, cc) == False{} : Bool}:
  match ct:
    case Laws.ACutDot{}:
      dg.elim(zz => {Laws.abnf.cut.at(Laws.ACutDot{}, zz) == False{} : Bool}, cc, hc,
        {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.ACutExp{}:
      dg.elim(zz => {Laws.abnf.cut.at(Laws.ACutExp{}, zz) == False{} : Bool}, cc, hc,
        {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# no exponent's cut falls at a character that is no e and no E
def n1.at.e(
  cc: Char,
  e1: {Char.is_eq(cc, 'e') == False{} : Bool},
  e2: {Char.is_eq(cc, 'E') == False{} : Bool}
) -> {Laws.abnf.cut.at(Laws.ACutExp{}, cc) == False{} : Bool}:
  match cc:
    case Chr{+cp}:
      %Equal.sym(Bool, Char.is_eq(Chr{cp}, 'e'), False{}, e1) : {Bool.or(_, Char.is_eq(Chr{cp}, 'E')) == False{}
        : Bool}
      e2

# no float's cut falls at a character that is no dot, e or E
def n1.at.d(
  cc: Char,
  e0: {Char.is_eq(cc, '.') == False{} : Bool},
  e1: {Char.is_eq(cc, 'e') == False{} : Bool},
  e2: {Char.is_eq(cc, 'E') == False{} : Bool}
) -> {Laws.abnf.cut.at(Laws.ACutDot{}, cc) == False{} : Bool}:
  match cc:
    case Chr{+cp}:
      %Equal.sym(Bool, Char.is_eq(Chr{cp}, '.'), False{}, e0) : {Bool.or(_, Laws.abnf.e(Chr{cp})) == False{} : Bool}
      n1.at.e(Chr{cp}, e1, e2)

# the repetition after a digit is the repetition
def n1.rep.d(
  +cc: Char,
  xs: List<&2, Char>,
  +hc: {Char.is_digit(cc) == True{} : Bool}
) -> {Laws.abnf.dec_rep(xs) == Laws.abnf.dec_rep(cc <> xs) : Bool}:
  match xs:
    case []:
      Equal.trans(Bool, True{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), True{}, hc),
        n1.dig(cc))
    case +h2 <> +t2:
      %Equal.trans(Bool, True{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), True{},
        hc), n1.dig(cc)) : {Laws.abnf.dec_rep(h2 <> t2) == Bool.or(Bool.and(_, Laws.abnf.dec_rep(h2 <> t2)),
        Bool.and(Laws.abnf.underscore(cc), Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)))) : Bool}
      %Equal.trans(Bool, False{}, Char.is_eq(cc, '_'), Laws.abnf.underscore(cc), Equal.sym(Bool, Char.is_eq(cc, '_'),
        False{}, n1.nous(cc, hc)), n1.us(cc)) : {Laws.abnf.dec_rep(h2 <> t2) == Bool.or(Laws.abnf.dec_rep(h2 <> t2),
        Bool.and(_, Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)))) : Bool}
      n1.orf.eq(Laws.abnf.dec_rep(h2 <> t2), Laws.abnf.dec_rep(h2 <> t2), {==})

# the repetition after an underscore is a DIGIT and the repetition
def n1.rep.u(xs: List<&2, Char>) -> {Laws.abnf.zero_prefixable_int(xs) == Laws.abnf.dec_rep('_' <> xs) : Bool}:
  match xs:
    case []:
      {==}
    case +h2 <> +t2:
      {==}

# no repetition starts with a character that is no digit and no underscore
def n1.rep.n(
  +cc: Char,
  xs: List<&2, Char>,
  hd: {Char.is_digit(cc) == False{} : Bool},
  hu: {Char.is_eq(cc, '_') == False{} : Bool}
) -> {False{} == Laws.abnf.dec_rep(cc <> xs) : Bool}:
  match xs:
    case []:
      Equal.trans(Bool, False{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), False{},
        hd), n1.dig(cc))
    case +h2 <> +t2:
      %Equal.trans(Bool, False{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), False{},
        hd), n1.dig(cc)) : {False{} == Bool.or(Bool.and(_, Laws.abnf.dec_rep(h2 <> t2)),
        Bool.and(Laws.abnf.underscore(cc), Bool.and(Laws.abnf.DIGIT(h2), Laws.abnf.dec_rep(t2)))) : Bool}
      %Equal.trans(Bool, False{}, Char.is_eq(cc, '_'), Laws.abnf.underscore(cc), Equal.sym(Bool, Char.is_eq(cc, '_'),
        False{}, hu), n1.us(cc)) : {False{} == Bool.or(False{}, Bool.and(_, Bool.and(Laws.abnf.DIGIT(h2),
        Laws.abnf.dec_rep(t2)))) : Bool}
      {==}

# a zero-prefixable-int that starts with a digit is its repetition
def n1.zpi.d(
  +cc: Char,
  +xs: List<&2, Char>,
  hc: {Char.is_digit(cc) == True{} : Bool}
) -> {Laws.abnf.dec_rep(xs) == Laws.abnf.zero_prefixable_int(cc <> xs) : Bool}:
  %Equal.trans(Bool, True{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), True{}, hc),
    n1.dig(cc)) : {Laws.abnf.dec_rep(xs) == Bool.and(_, Laws.abnf.dec_rep(xs)) : Bool}
  {==}

# a zero-prefixable-int that does not start with a digit is none
def n1.zpi.n(
  +cc: Char,
  +xs: List<&2, Char>,
  hc: {Char.is_digit(cc) == False{} : Bool}
) -> {False{} == Laws.abnf.zero_prefixable_int(cc <> xs) : Bool}:
  %Equal.trans(Bool, False{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), False{}, hc),
    n1.dig(cc)) : {False{} == Bool.and(_, Laws.abnf.dec_rep(xs)) : Bool}
  {==}

# a zero-prefixable-int cut at c, where c is no digit, is none, whatever
# follows
def n1.zpi.cut(
  cut: Bool,
  +cc: Char,
  +xs: List<&2, Char>,
  +more: Bool,
  hc: {Char.is_digit(cc) == False{} : Bool}
) -> {False{} == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre.pick(cut, cc, xs)), more) : Bool}:
  match cut:
    case True{}:
      {==}
    case False{}:
      %n1.zpi.n(cc, xs, hc) :
        {False{} == Bool.and(_, more) : Bool}
      {==}

# The fraction. After a digit of the fraction the scan finishes as a float
# exactly when the rest, cut at its first e, is the repetition and then an
# optional exp.

# the scan after a digit of a fraction
def n1.sf(+sg: T.Sign, +ds: List<&2, U32>, +why: String) -> T.Num:
  T.Num{T.NFrac{}, sg, 10, ds, False{}, True{}, why}

# what the fraction lemma claims
def n1.F.G(rest: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> Type:
  {n1.fsh(T.num.go(rest, n1.sf(sg, ds, why))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(rest, Laws.ACutExp{})),
    Laws.abnf.opt_exp(Laws.abnf.cut.post(rest, Laws.ACutExp{}))) : Bool}

# a fraction's state where an underscore fails (after an underscore, or before
# the first digit), with a character that is no digit: it fails, and no
# zero-prefixable-int starts there
def n1.Fu.bad(
  uu: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hq: {Bool.and(saw, Bool.not(us)) == False{} : Bool}
) -> {n1.fsh(T.num.go(tt, T.num.frac.go(False{}, uu, e1, e2, T.Num{T.NFrac{}, sg, 10, ds, us, saw, why}, cc)))
  == False{} : Bool}:
  match uu:
    case True{}:
      %Equal.sym(Bool, Bool.and(saw, Bool.not(us)), False{}, hq) :
        {n1.fsh(T.num.go(tt, T.num.us.go(_, T.NFrac{}, sg, 10, ds, why))) == False{} : Bool}
      n1.fsh.bad(tt, "invalid underscore")
    case False{}:
      match e1:
        case True{}:
          %Equal.sym(Bool, Bool.and(saw, Bool.not(us)), False{}, hq) :
            {n1.fsh(T.num.go(tt, T.num.exp.go(_, sg))) == False{} : Bool}
          n1.fsh.bad(tt, "invalid exponent")
        case False{}:
          match e2:
            case True{}:
              %Equal.sym(Bool, Bool.and(saw, Bool.not(us)), False{}, hq) :
                {n1.fsh(T.num.go(tt, T.num.exp.go(_, sg))) == False{} : Bool}
              n1.fsh.bad(tt, "invalid exponent")
            case False{}:
              n1.fsh.bad(tt, "invalid fraction")

# the character after such a state
def n1.Fu.go(
  dd: Bool,
  uu: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +ed: {Char.is_digit(cc) == dd : Bool},
  hq: {Bool.and(saw, Bool.not(us)) == False{} : Bool},
  ih: n1.F.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.frac.go(dd, uu, e1, e2, T.Num{T.NFrac{}, sg, 10, ds, us, saw, why}, cc)))
  == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(cc <> tt, Laws.ACutExp{})),
  Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{}))) : Bool}:
  match dd:
    case True{}:
      %n1.pre.no(Laws.ACutExp{}, cc, tt, n1.at.dig(Laws.ACutExp{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NFrac{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.zero_prefixable_int(_), Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{})))
        : Bool}
      %n1.post.no(Laws.ACutExp{}, cc, tt, n1.at.dig(Laws.ACutExp{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NFrac{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.zero_prefixable_int(cc <> Laws.abnf.cut.pre(tt, Laws.ACutExp{})), Laws.abnf.opt_exp(_))
        : Bool}
      %n1.zpi.d(cc, Laws.abnf.cut.pre(tt, Laws.ACutExp{}), ed) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NFrac{}, sg, 10, ds))) == Bool.and(_,
        Laws.abnf.opt_exp(Laws.abnf.cut.post(tt, Laws.ACutExp{}))) : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(_, cc, T.NFrac{}, sg, 10, ds))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(tt,
        Laws.ACutExp{})), Laws.abnf.opt_exp(Laws.abnf.cut.post(tt, Laws.ACutExp{}))) : Bool}
      ih
    case False{}:
      Equal.trans(Bool, n1.fsh(T.num.go(tt, T.num.frac.go(False{}, uu, e1, e2, T.Num{T.NFrac{}, sg, 10, ds, us, saw,
        why}, cc))), False{}, Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(cc <> tt, Laws.ACutExp{})),
        Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{}))),
        n1.Fu.bad(uu, e1, e2, cc, tt, sg, ds, us, saw, why, hq),
        n1.zpi.cut(Laws.abnf.cut.at(Laws.ACutExp{}, cc), cc, Laws.abnf.cut.pre(tt, Laws.ACutExp{}),
          Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{})), ed))

# a fraction's state where an underscore fails, with a character and the rest
def n1.Fu(
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hq: {Bool.and(saw, Bool.not(us)) == False{} : Bool},
  ih: n1.F.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(cc <> tt, T.Num{T.NFrac{}, sg, 10, ds, us, saw, why}))
  == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(cc <> tt, Laws.ACutExp{})),
  Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{}))) : Bool}:
  n1.Fu.go(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, tt, sg, ds, us, saw,
    why, {==}, hq, ih)

# what the fraction's underscore lemma claims: after an underscore, the scan
# finishes as a float exactly when the rest, cut at its first e, is a
# zero-prefixable-int and then an optional exp
def n1.F.U(+tt: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> Type:
  {n1.fsh(T.num.go(tt, T.Num{T.NFrac{}, sg, 10, ds, True{}, True{}, why}))
    == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(tt, Laws.ACutExp{})),
    Laws.abnf.opt_exp(Laws.abnf.cut.post(tt, Laws.ACutExp{}))) : Bool}

# the character after a fraction's digit
def n1.F.go(
  dd: Bool,
  uu: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  +ed: {Char.is_digit(cc) == dd : Bool},
  eu: {Char.is_eq(cc, '_') == uu : Bool},
  ee1: {Char.is_eq(cc, 'e') == e1 : Bool},
  ee2: {Char.is_eq(cc, 'E') == e2 : Bool},
  ihd: n1.F.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), ""),
  ihu: n1.F.U(tt, sg, ds, why),
  ihe: {n1.fsh(T.num.go(tt, n1.se(sg))) == Laws.abnf.float_exp_part(tt) : Bool}
) -> {n1.fsh(T.num.go(tt, T.num.frac.go(dd, uu, e1, e2, n1.sf(sg, ds, why), cc))) == Bool.and(
  Laws.abnf.dec_rep(Laws.abnf.cut.pre(cc <> tt, Laws.ACutExp{})),
  Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{}))) : Bool}:
  match dd:
    case True{}:
      %n1.pre.no(Laws.ACutExp{}, cc, tt, n1.at.dig(Laws.ACutExp{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NFrac{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.dec_rep(_), Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{}))) : Bool}
      %n1.post.no(Laws.ACutExp{}, cc, tt, n1.at.dig(Laws.ACutExp{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NFrac{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.dec_rep(cc <> Laws.abnf.cut.pre(tt, Laws.ACutExp{})), Laws.abnf.opt_exp(_)) : Bool}
      %n1.rep.d(cc, Laws.abnf.cut.pre(tt, Laws.ACutExp{}), ed) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NFrac{}, sg, 10, ds))) == Bool.and(_,
        Laws.abnf.opt_exp(Laws.abnf.cut.post(tt, Laws.ACutExp{}))) : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(_, cc, T.NFrac{}, sg, 10, ds))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(tt,
        Laws.ACutExp{})), Laws.abnf.opt_exp(Laws.abnf.cut.post(tt, Laws.ACutExp{}))) : Bool}
      ihd
    case False{}:
      match uu:
        case True{}:
          %Equal.sym(Char, cc, '_', Eq.char_eq_true(cc, '_', eu)) : {n1.fsh(T.num.go(tt,
            T.Num{T.NFrac{}, sg, 10, ds, True{}, True{}, why})) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(_ <> tt,
            Laws.ACutExp{})), Laws.abnf.opt_exp(Laws.abnf.cut.post(_ <> tt, Laws.ACutExp{}))) : Bool}
          %n1.rep.u(Laws.abnf.cut.pre(tt, Laws.ACutExp{})) : {n1.fsh(T.num.go(tt,
            T.Num{T.NFrac{}, sg, 10, ds, True{}, True{}, why})) == Bool.and(_, Laws.abnf.opt_exp(Laws.abnf.cut.post(tt,
            Laws.ACutExp{}))) : Bool}
          ihu
        case False{}:
          match e1:
            case True{}:
              %Equal.sym(Char, cc, 'e', Eq.char_eq_true(cc, 'e', ee1)) : {n1.fsh(T.num.go(tt, n1.se(sg))) ==
                Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(_ <> tt, Laws.ACutExp{})),
                Laws.abnf.opt_exp(Laws.abnf.cut.post(_ <> tt, Laws.ACutExp{}))) : Bool}
              ihe
            case False{}:
              match e2:
                case True{}:
                  %Equal.sym(Char, cc, 'E', Eq.char_eq_true(cc, 'E', ee2)) : {n1.fsh(T.num.go(tt, n1.se(sg))) ==
                    Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(_ <> tt, Laws.ACutExp{})),
                    Laws.abnf.opt_exp(Laws.abnf.cut.post(_ <> tt, Laws.ACutExp{}))) : Bool}
                  ihe
                case False{}:
                  %n1.pre.no(Laws.ACutExp{}, cc, tt, n1.at.e(cc, ee1, ee2)) : {n1.fsh(T.num.go(tt,
                    T.num.bad(n1.sf(sg, ds, why), "invalid fraction"))) == Bool.and(Laws.abnf.dec_rep(_),
                    Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{}))) : Bool}
                  %n1.rep.n(cc, Laws.abnf.cut.pre(tt, Laws.ACutExp{}), ed, eu) : {n1.fsh(T.num.go(tt,
                    T.num.bad(n1.sf(sg, ds, why), "invalid fraction"))) == Bool.and(_,
                    Laws.abnf.opt_exp(Laws.abnf.cut.post(cc <> tt, Laws.ACutExp{}))) : Bool}
                  n1.fsh.bad(tt, "invalid fraction")

# after a digit of a fraction, the scan finishes as a float exactly when the
# rest, cut at its first e, is the repetition and then an optional exp
def n1.F(rest: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> n1.F.G(rest, sg, ds, why):
  match rest:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          n1.F.go(Char.is_digit(hh), Char.is_eq(hh, '_'), Char.is_eq(hh, 'e'), Char.is_eq(hh, 'E'), hh, [], sg, ds, why,
            {==}, {==}, {==}, {==}, n1.F([], sg, T.dec.go(ds, 10, T.dig.val(hh)), ""), {==}, n1.E([], sg))
        case +h2 <> +t2:
          n1.F.go(Char.is_digit(hh), Char.is_eq(hh, '_'), Char.is_eq(hh, 'e'), Char.is_eq(hh, 'E'), hh, h2 <> t2, sg,
            ds, why, {==}, {==}, {==}, {==}, n1.F(h2 <> t2, sg, T.dec.go(ds, 10, T.dig.val(hh)), ""),
            n1.Fu(h2, t2, sg, ds, True{}, True{}, why, {==}, n1.F(t2, sg, T.dec.go(ds, 10, T.dig.val(h2)), "")),
            n1.E(h2 <> t2, sg))

# the scan after a decimal point
def n1.sf0(+sg: T.Sign) -> T.Num:
  T.Num{T.NFrac{}, sg, 10, [], False{}, False{}, ""}

# what the decimal point lemma claims
def n1.F0.G(+rest: List<&2, Char>, +sg: T.Sign) -> Type:
  {n1.fsh(T.num.go(rest, n1.sf0(sg))) == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(rest,
    Laws.ACutExp{})), Laws.abnf.opt_exp(Laws.abnf.cut.post(rest, Laws.ACutExp{}))) : Bool}

# after a decimal point, the scan finishes as a float exactly when the rest,
# cut at its first e, is a zero-prefixable-int and then an optional exp
def n1.F0(
  rest: List<&2, Char>,
  +sg: T.Sign
) -> {n1.fsh(T.num.go(rest, n1.sf0(sg))) == Bool.and( Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(rest,
  Laws.ACutExp{})), Laws.abnf.opt_exp(Laws.abnf.cut.post(rest, Laws.ACutExp{}))) : Bool}:
  match rest:
    case []:
      {==}
    case +hh <> +tt:
      n1.Fu(hh, tt, sg, [], False{}, False{}, "", {==}, n1.F(tt, sg, T.dec.go([], 10, T.dig.val(hh)), ""))

# A prefixed integer's scan. Its state stays NBase until it fails, so it never
# holds a float.

# whether a numeral kind is a prefixed integer's, or a failure
def n1.isb.nk(nk: T.NK) -> Bool:
  match nk:
    case T.NBase{}:
      True{}
    case T.NBad{}:
      True{}
    case _k:
      False{}

# whether a numeral scan is in a prefixed integer or has failed
def n1.isb(st: T.Num) -> Bool:
  match st:
    case T.Num{nk, _sign, _base, _ds, _us, _saw, _why}:
      n1.isb.nk(nk)

# a digit of a prefixed integer, taken or refused
def n1.isb.digit(
  ok: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>
) -> {n1.isb(T.num.digit.ok(ok, cc, T.NBase{}, sg, base, ds)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# an underscore of a prefixed integer, taken or refused
def n1.isb.us(
  ok: Bool,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String
) -> {n1.isb(T.num.us.go(ok, T.NBase{}, sg, base, ds, why)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# the character after a prefixed integer's digit or underscore
def n1.isb.based(
  uu: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {n1.isb(T.num.based.go(uu, T.Num{T.NBase{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match uu:
    case True{}:
      n1.isb.us(Bool.and(saw, Bool.not(us)), sg, base, ds, why)
    case False{}:
      n1.isb.digit(T.dig.ok(T.dig.val(cc), base), cc, sg, base, ds)

# a step keeps a scan in a prefixed integer or failed
def n1.isb.step(
  +st: T.Num,
  +cc: Char,
  hs: {n1.isb(st) == True{} : Bool}
) -> {n1.isb(T.num.step(st, cc)) == True{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, +us, +saw, +why}:
      match nk:
        case T.NBase{}:
          n1.isb.based(Char.is_eq(cc, '_'), cc, sg, base, ds, us, saw, why)
        case T.NBad{}:
          {==}
        case T.NLead{}:
          Eq.bit.absurd(&2, {n1.isb(T.num.step(T.Num{T.NLead{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NSign{}:
          Eq.bit.absurd(&2, {n1.isb(T.num.step(T.Num{T.NSign{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NZero{}:
          Eq.bit.absurd(&2, {n1.isb(T.num.step(T.Num{T.NZero{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NDig{}:
          Eq.bit.absurd(&2, {n1.isb(T.num.step(T.Num{T.NDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NFrac{}:
          Eq.bit.absurd(&2, {n1.isb(T.num.step(T.Num{T.NFrac{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NExp{}:
          Eq.bit.absurd(&2, {n1.isb(T.num.step(T.Num{T.NExp{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NEDig{}:
          Eq.bit.absurd(&2, {n1.isb(T.num.step(T.Num{T.NEDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)

# a scan in a prefixed integer or failed never finishes as a float
def n1.bcls(
  rest: List<&2, Char>,
  +st: T.Num,
  hs: {n1.isb(st) == True{} : Bool}
) -> {n1.fsh(T.num.go(rest, st)) == False{} : Bool}:
  match rest:
    case []:
      match st:
        case T.Num{nk, _sign, _base, _ds, us, saw, _why}:
          match nk:
            case T.NBase{}:
              {==}
            case T.NBad{}:
              {==}
            case T.NLead{}:
              Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NLead{}, saw), Bool.not(us)) == False{} : Bool}, hs)
            case T.NSign{}:
              Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NSign{}, saw), Bool.not(us)) == False{} : Bool}, hs)
            case T.NZero{}:
              Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NZero{}, saw), Bool.not(us)) == False{} : Bool}, hs)
            case T.NDig{}:
              Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NDig{}, saw), Bool.not(us)) == False{} : Bool}, hs)
            case T.NFrac{}:
              Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NFrac{}, saw), Bool.not(us)) == False{} : Bool}, hs)
            case T.NExp{}:
              Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NExp{}, saw), Bool.not(us)) == False{} : Bool}, hs)
            case T.NEDig{}:
              Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NEDig{}, saw), Bool.not(us)) == False{} : Bool}, hs)
    case +hh <> tt:
      n1.bcls(tt, T.num.step(st, hh), n1.isb.step(st, hh, hs))

# The integer part. After a digit of it the scan finishes as a float exactly
# when the rest, cut at its first dot or e, is the repetition and then an exp
# or a frac with an optional exp.

# the exp or frac [ exp ] a float's integer part is followed by
def n1.fq(+pp: List<&2, Char>) -> Bool:
  Bool.or(Laws.abnf.exp(pp), Laws.abnf.frac_exp(pp))

# the scan after a digit of an integer part
def n1.sd(+sg: T.Sign, +ds: List<&2, U32>, +why: String) -> T.Num:
  T.Num{T.NDig{}, sg, 10, ds, False{}, True{}, why}

# what the integer-part lemma claims
def n1.D.G(rest: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> Type:
  {n1.fsh(T.num.go(rest, n1.sd(sg, ds, why))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(rest, Laws.ACutDot{})),
    n1.fq(Laws.abnf.cut.post(rest, Laws.ACutDot{}))) : Bool}

# after an underscore in an integer part, a character that is no digit fails
def n1.Du.bad(
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String
) -> {n1.fsh(T.num.go(tt, T.num.digs.go(False{}, uu, pp, e1, e2, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why},
  cc))) == False{} : Bool}:
  match uu:
    case True{}:
      n1.fsh.bad(tt, "invalid underscore")
    case False{}:
      match pp:
        case True{}:
          n1.fsh.bad(tt, "invalid fraction")
        case False{}:
          match e1:
            case True{}:
              n1.fsh.bad(tt, "invalid exponent")
            case False{}:
              match e2:
                case True{}:
                  n1.fsh.bad(tt, "invalid exponent")
                case False{}:
                  n1.fsh.bad(tt, "invalid number")

# the character after an underscore in an integer part
def n1.Du.go(
  dd: Bool,
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  +ed: {Char.is_digit(cc) == dd : Bool},
  ih: n1.D.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.digs.go(dd, uu, pp, e1, e2, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why}, cc)))
  == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(cc <> tt, Laws.ACutDot{})),
  n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}:
  match dd:
    case True{}:
      %n1.pre.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.zero_prefixable_int(_), n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}
      %n1.post.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.zero_prefixable_int(cc <> Laws.abnf.cut.pre(tt, Laws.ACutDot{})), n1.fq(_)) : Bool}
      %n1.zpi.d(cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}), ed) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, ds))) == Bool.and(_,
        n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(_, cc, T.NDig{}, sg, 10, ds))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(tt,
        Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      ih
    case False{}:
      Equal.trans(Bool, n1.fsh(T.num.go(tt, T.num.digs.go(False{}, uu, pp, e1, e2, T.Num{T.NDig{}, sg, 10, ds, True{},
        True{}, why}, cc))), False{}, Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(cc <> tt,
        Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))),
        n1.Du.bad(uu, pp, e1, e2, cc, tt, sg, ds, why),
        n1.zpi.cut(Laws.abnf.cut.at(Laws.ACutDot{}, cc), cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}),
          n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{})), ed))

# after an underscore in an integer part, with a character and the rest
def n1.Du(
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  ih: n1.D.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(cc <> tt, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why}))
  == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(cc <> tt, Laws.ACutDot{})),
  n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}:
  n1.Du.go(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, '.'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc,
    tt, sg, ds, why, {==}, ih)

# what the integer part's underscore lemma claims: after an underscore, the
# scan finishes as a float exactly when the rest, cut at its first dot or e,
# is a zero-prefixable-int and then an exp or a frac with an optional exp
def n1.D.U(+tt: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> Type:
  {n1.fsh(T.num.go(tt, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why}))
    == Bool.and(Laws.abnf.zero_prefixable_int(Laws.abnf.cut.pre(tt, Laws.ACutDot{})),
    n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}

# the character after a digit of an integer part
def n1.D.go(
  dd: Bool,
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  +ed: {Char.is_digit(cc) == dd : Bool},
  +eu: {Char.is_eq(cc, '_') == uu : Bool},
  +ep: {Char.is_eq(cc, '.') == pp : Bool},
  +ee1: {Char.is_eq(cc, 'e') == e1 : Bool},
  +ee2: {Char.is_eq(cc, 'E') == e2 : Bool},
  ihd: n1.D.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), ""),
  ihu: n1.D.U(tt, sg, ds, why),
  ihp: n1.F0.G(tt, sg),
  ihe: {n1.fsh(T.num.go(tt, n1.se(sg))) == Laws.abnf.float_exp_part(tt) : Bool}
) -> {n1.fsh(T.num.go(tt, T.num.digs.go(dd, uu, pp, e1, e2, n1.sd(sg, ds, why), cc))) == Bool.and(
  Laws.abnf.dec_rep(Laws.abnf.cut.pre(cc <> tt, Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{})))
  : Bool}:
  match dd:
    case True{}:
      %n1.pre.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.dec_rep(_), n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}
      %n1.post.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, ds))) ==
        Bool.and(Laws.abnf.dec_rep(cc <> Laws.abnf.cut.pre(tt, Laws.ACutDot{})), n1.fq(_)) : Bool}
      %n1.rep.d(cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}), ed) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, ds))) == Bool.and(_,
        n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(_, cc, T.NDig{}, sg, 10, ds))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(tt,
        Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      ihd
    case False{}:
      match uu:
        case True{}:
          %Equal.sym(Char, cc, '_', Eq.char_eq_true(cc, '_', eu)) : {n1.fsh(T.num.go(tt,
            T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why})) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(_ <> tt,
            Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
          %n1.rep.u(Laws.abnf.cut.pre(tt, Laws.ACutDot{})) : {n1.fsh(T.num.go(tt,
            T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why})) == Bool.and(_, n1.fq(Laws.abnf.cut.post(tt,
            Laws.ACutDot{}))) : Bool}
          ihu
        case False{}:
          match pp:
            case True{}:
              %Equal.sym(Char, cc, '.', Eq.char_eq_true(cc, '.', ep)) : {n1.fsh(T.num.go(tt, n1.sf0(sg))) ==
                Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
                n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
              ihp
            case False{}:
              match e1:
                case True{}:
                  %Equal.sym(Char, cc, 'e', Eq.char_eq_true(cc, 'e', ee1)) : {n1.fsh(T.num.go(tt, n1.se(sg))) ==
                    Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
                    n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
                  n1.orf.eq(n1.fsh(T.num.go(tt, n1.se(sg))), Laws.abnf.float_exp_part(tt), ihe)
                case False{}:
                  match e2:
                    case True{}:
                      %Equal.sym(Char, cc, 'E', Eq.char_eq_true(cc, 'E', ee2)) : {n1.fsh(T.num.go(tt, n1.se(sg))) ==
                        Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
                        n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
                      n1.orf.eq(n1.fsh(T.num.go(tt, n1.se(sg))), Laws.abnf.float_exp_part(tt), ihe)
                    case False{}:
                      %n1.pre.no(Laws.ACutDot{}, cc, tt, n1.at.d(cc, ep, ee1, ee2)) : {n1.fsh(T.num.go(tt,
                        T.num.bad(n1.sd(sg, ds, why), "invalid number"))) == Bool.and(Laws.abnf.dec_rep(_),
                        n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}
                      %n1.rep.n(cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}), ed, eu) : {n1.fsh(T.num.go(tt,
                        T.num.bad(n1.sd(sg, ds, why), "invalid number"))) == Bool.and(_,
                        n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}
                      n1.fsh.bad(tt, "invalid number")

# after a digit of an integer part, the scan finishes as a float exactly when
# the rest, cut at its first dot or e, is the repetition and then an exp or a
# frac with an optional exp
def n1.D(rest: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String) -> n1.D.G(rest, sg, ds, why):
  match rest:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          n1.D.go(Char.is_digit(hh), Char.is_eq(hh, '_'), Char.is_eq(hh, '.'), Char.is_eq(hh, 'e'), Char.is_eq(hh, 'E'),
            hh, [], sg, ds, why, {==}, {==}, {==}, {==}, {==}, n1.D([], sg, T.dec.go(ds, 10, T.dig.val(hh)), ""), {==},
            n1.F0([], sg), n1.E([], sg))
        case +h2 <> +t2:
          n1.D.go(Char.is_digit(hh), Char.is_eq(hh, '_'), Char.is_eq(hh, '.'), Char.is_eq(hh, 'e'), Char.is_eq(hh, 'E'),
            hh, h2 <> t2, sg, ds, why, {==}, {==}, {==}, {==}, {==},
            n1.D(h2 <> t2, sg, T.dec.go(ds, 10, T.dig.val(hh)), ""),
            n1.Du(h2, t2, sg, ds, why, n1.D(t2, sg, T.dec.go(ds, 10, T.dig.val(h2)), "")),
            n1.F0(h2 <> t2, sg), n1.E(h2 <> t2, sg))

# The leading zero, the sign and the start.

# the scan after a leading zero
def n1.sz(+sg: T.Sign) -> T.Num:
  T.Num{T.NZero{}, sg, 10, [], False{}, True{}, ""}

# what the leading zero lemma claims
def n1.Z.G(+rest: List<&2, Char>, +sg: T.Sign) -> Type:
  {n1.fsh(T.num.go(rest, n1.sz(sg))) == Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(rest, Laws.ACutDot{})),
    n1.fq(Laws.abnf.cut.post(rest, Laws.ACutDot{}))) : Bool}

# the character after a leading zero: a prefix, a dot, an exponent, or
# anything else, which fails
def n1.Z.go(
  xx: Bool,
  oo: Bool,
  bb: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +exx: {Char.is_eq(cc, 'x') == xx : Bool},
  +eoo: {Char.is_eq(cc, 'o') == oo : Bool},
  +ebb: {Char.is_eq(cc, 'b') == bb : Bool},
  +ep: {Char.is_eq(cc, '.') == pp : Bool},
  +ee1: {Char.is_eq(cc, 'e') == e1 : Bool},
  +ee2: {Char.is_eq(cc, 'E') == e2 : Bool},
  ihp: n1.F0.G(tt, sg),
  ihe: {n1.fsh(T.num.go(tt, n1.se(sg))) == Laws.abnf.float_exp_part(tt) : Bool}
) -> {n1.fsh(T.num.go(tt, T.num.zero.go(xx, oo, bb, pp, e1, e2, n1.sz(sg), cc))) == Bool.and(List.is_empty(&2, Char,
  Laws.abnf.cut.pre(cc <> tt, Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}:
  match xx:
    case True{}:
      %Equal.sym(Char, cc, 'x', Eq.char_eq_true(cc, 'x', exx)) : {n1.fsh(T.num.go(tt, T.num.base(n1.sz(sg), 16))) ==
        Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
        n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
      n1.bcls(tt, T.num.base(n1.sz(sg), 16), {==})
    case False{}:
      match oo:
        case True{}:
          %Equal.sym(Char, cc, 'o', Eq.char_eq_true(cc, 'o', eoo)) : {n1.fsh(T.num.go(tt, T.num.base(n1.sz(sg), 8))) ==
            Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
            n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
          n1.bcls(tt, T.num.base(n1.sz(sg), 8), {==})
        case False{}:
          match bb:
            case True{}:
              %Equal.sym(Char, cc, 'b', Eq.char_eq_true(cc, 'b', ebb)) : {n1.fsh(T.num.go(tt, T.num.base(n1.sz(sg),
                2))) == Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
                n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
              n1.bcls(tt, T.num.base(n1.sz(sg), 2), {==})
            case False{}:
              match pp:
                case True{}:
                  %Equal.sym(Char, cc, '.', Eq.char_eq_true(cc, '.', ep)) : {n1.fsh(T.num.go(tt, n1.sf0(sg))) ==
                    Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
                    n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
                  ihp
                case False{}:
                  match e1:
                    case True{}:
                      %Equal.sym(Char, cc, 'e', Eq.char_eq_true(cc, 'e', ee1)) : {n1.fsh(T.num.go(tt, n1.se(sg))) ==
                        Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(_ <> tt, Laws.ACutDot{})),
                        n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
                      n1.orf.eq(n1.fsh(T.num.go(tt, n1.se(sg))), Laws.abnf.float_exp_part(tt), ihe)
                    case False{}:
                      match e2:
                        case True{}:
                          %Equal.sym(Char, cc, 'E', Eq.char_eq_true(cc, 'E', ee2)) : {n1.fsh(T.num.go(tt,
                            n1.se(sg))) == Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(_ <> tt,
                            Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(_ <> tt, Laws.ACutDot{}))) : Bool}
                          n1.orf.eq(n1.fsh(T.num.go(tt, n1.se(sg))), Laws.abnf.float_exp_part(tt), ihe)
                        case False{}:
                          %n1.pre.no(Laws.ACutDot{}, cc, tt, n1.at.d(cc, ep, ee1, ee2)) : {n1.fsh(T.num.go(tt,
                            T.num.bad(n1.sz(sg), "invalid number"))) == Bool.and(List.is_empty(&2, Char, _),
                            n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}
                          n1.fsh.bad(tt, "invalid number")

# after a leading zero, the scan finishes as a float exactly when the rest
# starts at a cut, with an exp or a frac and an optional exp from there
def n1.Z(
  rest: List<&2, Char>,
  +sg: T.Sign
) -> {n1.fsh(T.num.go(rest, n1.sz(sg))) == Bool.and(List.is_empty(&2, Char, Laws.abnf.cut.pre(rest, Laws.ACutDot{})),
  n1.fq(Laws.abnf.cut.post(rest, Laws.ACutDot{}))) : Bool}:
  match rest:
    case []:
      {==}
    case +hh <> +tt:
      n1.Z.go(Char.is_eq(hh, 'x'), Char.is_eq(hh, 'o'), Char.is_eq(hh, 'b'), Char.is_eq(hh, '.'), Char.is_eq(hh, 'e'),
        Char.is_eq(hh, 'E'), hh, tt, sg, {==}, {==}, {==}, {==}, {==}, {==}, n1.F0(tt, sg), n1.E(tt, sg))

# no digit is a digit1-9 unless it is one
def n1.d19.n.go(
  bb: Bool,
  +cc: Char,
  +eb: {Laws.abnf.digit1_9(cc) == bb : Bool},
  hd: {Char.is_digit(cc) == False{} : Bool}
) -> {Laws.abnf.digit1_9(cc) == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.absurd2(&2, {Laws.abnf.digit1_9(cc) == False{} : Bool}, Equal.trans(Bool, True{}, Char.is_digit(cc),
        False{}, Equal.sym(Bool, Char.is_digit(cc), True{}, gs.d19(cc, eb)), hd))
    case False{}:
      eb

# a character that is no digit is no digit1-9
def n1.d19.n(+cc: Char, hd: {Char.is_digit(cc) == False{} : Bool}) -> {Laws.abnf.digit1_9(cc) == False{} : Bool}:
  n1.d19.n.go(Laws.abnf.digit1_9(cc), cc, {==}, hd)

# a digit that is not 0 is a digit1-9
def n1.d19.y(
  cc: Char,
  hd: {Char.is_digit(cc) == True{} : Bool},
  hz: {Char.is_eq(cc, '0') == False{} : Bool}
) -> {Laws.abnf.digit1_9(cc) == True{} : Bool}:
  dg.elim(zz => {Char.is_eq(zz, '0') == False{} : Bool} -> {Laws.abnf.digit1_9(zz) == True{} : Bool}, cc, hd,
    ee => Eq.bit.absurd2(&2, {Laws.abnf.digit1_9('0') == True{} : Bool}, ee),
    _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==},
    _e => {==})(hz)

# an unsigned-dec-int that starts with 0 is 0 alone
def n1.udi.z(xs: List<&2, Char>) -> {List.is_empty(&2, Char, xs) == Laws.abnf.unsigned_dec_int('0' <> xs) : Bool}:
  match xs:
    case []:
      {==}
    case _h <> _t:
      {==}

# the same, once the character's DIGIT and digit1-9 are known to be False
def n1.udi.n.go(
  xs: List<&2, Char>,
  +cc: Char,
  +e1: {False{} == Laws.abnf.DIGIT(cc) : Bool},
  +e2: {False{} == Laws.abnf.digit1_9(cc) : Bool}
) -> {False{} == Laws.abnf.unsigned_dec_int(cc <> xs) : Bool}:
  match xs:
    case []:
      %e1 : {False{} == Bool.or(Bool.and(_, True{}), Bool.and(Laws.abnf.digit1_9(cc), False{})) : Bool}
      %e2 : {False{} == Bool.or(False{}, Bool.and(_, False{})) : Bool}
      {==}
    case +h2 <> +t2:
      %e1 : {False{} == Bool.or(Bool.and(_, False{}), Bool.and(Laws.abnf.digit1_9(cc), Laws.abnf.dec_rep(h2 <> t2)))
        : Bool}
      %e2 : {False{} == Bool.or(False{}, Bool.and(_, Laws.abnf.dec_rep(h2 <> t2))) : Bool}
      {==}

# no unsigned-dec-int starts with a character that is no digit
def n1.udi.n(
  +cc: Char,
  xs: List<&2, Char>,
  +hd: {Char.is_digit(cc) == False{} : Bool}
) -> {False{} == Laws.abnf.unsigned_dec_int(cc <> xs) : Bool}:
  +e1 = {Equal.trans(Bool, False{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), False{},
    hd), n1.dig(cc)) : {False{} == Laws.abnf.DIGIT(cc) : Bool}}
  +e2 = {Equal.sym(Bool, Laws.abnf.digit1_9(cc), False{}, n1.d19.n(cc, hd)) : {False{} == Laws.abnf.digit1_9(cc)
    : Bool}}
  n1.udi.n.go(xs, cc, e1, e2)

# the same, once the character's DIGIT and digit1-9 are known to be True
def n1.udi.d.go(
  xs: List<&2, Char>,
  +cc: Char,
  +e1: {True{} == Laws.abnf.DIGIT(cc) : Bool},
  +e2: {True{} == Laws.abnf.digit1_9(cc) : Bool}
) -> {Laws.abnf.dec_rep(xs) == Laws.abnf.unsigned_dec_int(cc <> xs) : Bool}:
  match xs:
    case []:
      %e1 : {True{} == Bool.or(Bool.and(_, True{}), Bool.and(Laws.abnf.digit1_9(cc), False{})) : Bool}
      {==}
    case +h2 <> +t2:
      %e1 : {Laws.abnf.dec_rep(h2 <> t2) == Bool.or(Bool.and(_, False{}), Bool.and(Laws.abnf.digit1_9(cc),
        Laws.abnf.dec_rep(h2 <> t2))) : Bool}
      %e2 : {Laws.abnf.dec_rep(h2 <> t2) == Bool.or(False{}, Bool.and(_, Laws.abnf.dec_rep(h2 <> t2))) : Bool}
      {==}

# an unsigned-dec-int that starts with a digit1-9 is it and the repetition
def n1.udi.d(
  +cc: Char,
  xs: List<&2, Char>,
  +e9: {Laws.abnf.digit1_9(cc) == True{} : Bool}
) -> {Laws.abnf.dec_rep(xs) == Laws.abnf.unsigned_dec_int(cc <> xs) : Bool}:
  +e1 = {Equal.trans(Bool, True{}, Char.is_digit(cc), Laws.abnf.DIGIT(cc), Equal.sym(Bool, Char.is_digit(cc), True{},
    gs.d19(cc, e9)), n1.dig(cc)) : {True{} == Laws.abnf.DIGIT(cc) : Bool}}
  n1.udi.d.go(xs, cc, e1, Equal.sym(Bool, Laws.abnf.digit1_9(cc), True{}, e9))

# an unsigned-dec-int cut at c, where c is no digit, is none, whatever
# follows
def n1.udi.cut(
  cut: Bool,
  +cc: Char,
  +xs: List<&2, Char>,
  +more: Bool,
  hc: {Char.is_digit(cc) == False{} : Bool}
) -> {False{} == Bool.and(Laws.abnf.unsigned_dec_int(Laws.abnf.cut.pre.pick(cut, cc, xs)), more) : Bool}:
  match cut:
    case True{}:
      {==}
    case False{}:
      %n1.udi.n(cc, xs, hc) : {False{} == Bool.and(_, more) : Bool}
      {==}

# the scan after a sign
def n1.ss(+sg: T.Sign) -> T.Num:
  T.Num{T.NSign{}, sg, 10, [], False{}, False{}, ""}

# the scan before an unsigned numeral's first character, with its sign
def n1.sl(+sg: T.Sign) -> T.Num:
  T.Num{T.NLead{}, sg, 10, [], False{}, False{}, ""}

# what the after-sign lemma claims: the scan finishes as a float exactly when
# the rest, cut at its first dot or e, is an unsigned-dec-int and then an exp
# or a frac with an optional exp
def n1.S.R(+rest: List<&2, Char>) -> Bool:
  Bool.and(Laws.abnf.unsigned_dec_int(Laws.abnf.cut.pre(rest, Laws.ACutDot{})),
    n1.fq(Laws.abnf.cut.post(rest, Laws.ACutDot{})))

# the first character of an unsigned numeral that is no sign: a zero, a
# digit, or anything else, which fails
def n1.S2.go(
  zz: Bool,
  dd: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ez: {Char.is_eq(cc, '0') == zz : Bool},
  +ed: {Char.is_digit(cc) == dd : Bool},
  ihz: n1.Z.G(tt, sg),
  ihd: n1.D.G(tt, sg, T.dec.go([], 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.lead.go(False{}, False{}, zz, dd, n1.sl(sg), cc))) == n1.S.R(cc <> tt) : Bool}:
  match zz:
    case True{}:
      %Equal.sym(Char, cc, '0', Eq.char_eq_true(cc, '0', ez)) : {n1.fsh(T.num.go(tt, n1.sz(sg))) == n1.S.R(_ <> tt)
        : Bool}
      %n1.udi.z(Laws.abnf.cut.pre(tt, Laws.ACutDot{})) : {n1.fsh(T.num.go(tt, n1.sz(sg))) == Bool.and(_,
        n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      ihz
    case False{}:
      match dd:
        case True{}:
          %n1.pre.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
            T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, []))) ==
            Bool.and(Laws.abnf.unsigned_dec_int(_), n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}
          %n1.post.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
            T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, []))) ==
            Bool.and(Laws.abnf.unsigned_dec_int(cc <> Laws.abnf.cut.pre(tt, Laws.ACutDot{})), n1.fq(_)) : Bool}
          %n1.udi.d(cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}), n1.d19.y(cc, ed, ez)) : {n1.fsh(T.num.go(tt,
            T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10, []))) == Bool.and(_,
            n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.fsh(T.num.go(tt,
            T.num.digit.ok(_, cc, T.NDig{}, sg, 10, []))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(tt,
            Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
          ihd
        case False{}:
          Equal.trans(Bool, n1.fsh(T.num.go(tt, T.num.bad(n1.sl(sg), "invalid number"))), False{},
            n1.S.R(cc <> tt), n1.fsh.bad(tt, "invalid number"),
            n1.udi.cut(Laws.abnf.cut.at(Laws.ACutDot{}, cc), cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}),
              n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{})), ed))

# the character after a sign: a second sign fails
def n1.S.go(
  pp: Bool,
  mm: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ep: {Char.is_eq(cc, '+') == pp : Bool},
  +em: {Char.is_eq(cc, '-') == mm : Bool},
  ihz: n1.Z.G(tt, sg),
  ihd: n1.D.G(tt, sg, T.dec.go([], 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.after.sign.go(Bool.or(pp, mm), sg, cc))) == n1.S.R(cc <> tt) : Bool}:
  match pp:
    case True{}:
      %Equal.sym(Char, cc, '+', Eq.char_eq_true(cc, '+', ep)) : {n1.fsh(T.num.go(tt, T.num.bad(T.num.start(),
        "invalid number"))) == n1.S.R(_ <> tt) : Bool}
      %n1.udi.n('+', Laws.abnf.cut.pre(tt, Laws.ACutDot{}), {==}) : {n1.fsh(T.num.go(tt, T.num.bad(T.num.start(),
        "invalid number"))) == Bool.and(_, n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      n1.fsh.bad(tt, "invalid number")
    case False{}:
      match mm:
        case True{}:
          %Equal.sym(Char, cc, '-', Eq.char_eq_true(cc, '-', em)) : {n1.fsh(T.num.go(tt, T.num.bad(T.num.start(),
            "invalid number"))) == n1.S.R(_ <> tt) : Bool}
          %n1.udi.n('-', Laws.abnf.cut.pre(tt, Laws.ACutDot{}), {==}) : {n1.fsh(T.num.go(tt,
            T.num.bad(T.num.start(), "invalid number"))) == Bool.and(_, n1.fq(Laws.abnf.cut.post(tt,
            Laws.ACutDot{}))) : Bool}
          n1.fsh.bad(tt, "invalid number")
        case False{}:
          %Equal.sym(Bool, Char.is_eq(cc, '+'), False{}, ep) : {n1.fsh(T.num.go(tt, T.num.lead.go(_,
            Char.is_eq(cc, '-'), Char.is_eq(cc, '0'), Char.is_digit(cc), n1.sl(sg), cc))) == n1.S.R(cc <> tt) : Bool}
          %Equal.sym(Bool, Char.is_eq(cc, '-'), False{}, em) : {n1.fsh(T.num.go(tt, T.num.lead.go(False{}, _,
            Char.is_eq(cc, '0'), Char.is_digit(cc), n1.sl(sg), cc))) == n1.S.R(cc <> tt) : Bool}
          n1.S2.go(Char.is_eq(cc, '0'), Char.is_digit(cc), cc, tt, sg, {==}, {==}, ihz, ihd)

# after a sign, the scan finishes as a float exactly when the rest, cut at
# its first dot or e, is an unsigned-dec-int and then an exp or a frac with
# an optional exp
def n1.S(rest: List<&2, Char>, +sg: T.Sign) -> {n1.fsh(T.num.go(rest, n1.ss(sg))) == n1.S.R(rest) : Bool}:
  match rest:
    case []:
      {==}
    case +hh <> +tt:
      n1.S.go(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), hh, tt, sg, {==}, {==}, n1.Z(tt, sg),
        n1.D(tt, sg, T.dec.go([], 10, T.dig.val(hh)), ""))

# a dec-int cut at c, where c is no sign and no digit, is none, whatever
# follows
def n1.dint.cut(
  cut: Bool,
  +cc: Char,
  +xs: List<&2, Char>,
  +more: Bool,
  +em: {False{} == Laws.abnf.minus(cc) : Bool},
  +ep: {False{} == Laws.abnf.plus(cc) : Bool},
  hc: {Char.is_digit(cc) == False{} : Bool}
) -> {False{} == Bool.and(Laws.abnf.dec_int(Laws.abnf.cut.pre.pick(cut, cc, xs)), more) : Bool}:
  match cut:
    case True{}:
      {==}
    case False{}:
      %em : {False{} == Bool.and(Bool.or(Bool.and(Bool.or(_, Laws.abnf.plus(cc)), Laws.abnf.unsigned_dec_int(xs)),
        Laws.abnf.unsigned_dec_int(cc <> xs)), more) : Bool}
      %ep : {False{} == Bool.and(Bool.or(Bool.and(Bool.or(False{}, _), Laws.abnf.unsigned_dec_int(xs)),
        Laws.abnf.unsigned_dec_int(cc <> xs)), more) : Bool}
      %n1.udi.n(cc, xs, hc) : {False{} == Bool.and(Bool.or(False{}, _), more) : Bool}
      {==}

# a dec-int that starts with a sign is the unsigned-dec-int after it
def n1.dint.sgn(
  +cc: Char,
  +xs: List<&2, Char>,
  +more: Bool,
  hd: {Char.is_digit(cc) == False{} : Bool}
) -> {Bool.and(Laws.abnf.unsigned_dec_int(xs), more) == Bool.and(Bool.or(Laws.abnf.unsigned_dec_int(xs),
  Laws.abnf.unsigned_dec_int(cc <> xs)), more) : Bool}:
  %n1.udi.n(cc, xs, hd) : {Bool.and(Laws.abnf.unsigned_dec_int(xs), more) == Bool.and(Bool.or(
    Laws.abnf.unsigned_dec_int(xs), _), more) : Bool}
  %Equal.sym(Bool, Bool.or(Laws.abnf.unsigned_dec_int(xs), False{}), Laws.abnf.unsigned_dec_int(xs),
    n1.orf(Laws.abnf.unsigned_dec_int(xs))) : {Bool.and(Laws.abnf.unsigned_dec_int(xs), more) == Bool.and(_, more)
    : Bool}
  {==}

# a first character that is no sign and no zero: a digit, or anything else
def n1.L.go2(
  dd: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +ez: {Char.is_eq(cc, '0') == False{} : Bool},
  +ed: {Char.is_digit(cc) == dd : Bool},
  +fm: {False{} == Laws.abnf.minus(cc) : Bool},
  +fp: {False{} == Laws.abnf.plus(cc) : Bool},
  ihd: n1.D.G(tt, T.Plus{}, T.dec.go([], 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.lead.go(False{}, False{}, False{}, dd, T.num.start(), cc)))
  == Laws.abnf.float_std(cc <> tt) : Bool}:
  match dd:
    case True{}:
      %n1.pre.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, T.Plus{}, 10, []))) ==
        Bool.and(Laws.abnf.dec_int(_), n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{}))) : Bool}
      %n1.post.no(Laws.ACutDot{}, cc, tt, n1.at.dig(Laws.ACutDot{}, cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, T.Plus{}, 10, []))) ==
        Bool.and(Laws.abnf.dec_int(cc <> Laws.abnf.cut.pre(tt, Laws.ACutDot{})), n1.fq(_)) : Bool}
      %fm : {n1.fsh(T.num.go(tt, T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, T.Plus{}, 10, []))) ==
        Bool.and(Bool.or(Bool.and(Bool.or(_, Laws.abnf.plus(cc)), Laws.abnf.unsigned_dec_int(Laws.abnf.cut.pre(tt,
        Laws.ACutDot{}))), Laws.abnf.unsigned_dec_int(cc <> Laws.abnf.cut.pre(tt, Laws.ACutDot{}))),
        n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      %fp : {n1.fsh(T.num.go(tt, T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, T.Plus{}, 10, []))) ==
        Bool.and(Bool.or(Bool.and(Bool.or(False{}, _), Laws.abnf.unsigned_dec_int(Laws.abnf.cut.pre(tt,
        Laws.ACutDot{}))), Laws.abnf.unsigned_dec_int(cc <> Laws.abnf.cut.pre(tt, Laws.ACutDot{}))),
        n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      %n1.udi.d(cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}), n1.d19.y(cc, ed, ez)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, T.Plus{}, 10, []))) == Bool.and(Bool.or(False{}, _),
        n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.fsh(T.num.go(tt,
        T.num.digit.ok(_, cc, T.NDig{}, T.Plus{}, 10, []))) == Bool.and(Laws.abnf.dec_rep(Laws.abnf.cut.pre(tt,
        Laws.ACutDot{})), n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
      ihd
    case False{}:
      Equal.trans(Bool, n1.fsh(T.num.go(tt, T.num.bad(T.num.start(), "invalid number"))), False{},
        Laws.abnf.float_std(cc <> tt), n1.fsh.bad(tt, "invalid number"),
        n1.dint.cut(Laws.abnf.cut.at(Laws.ACutDot{}, cc), cc, Laws.abnf.cut.pre(tt, Laws.ACutDot{}),
          n1.fq(Laws.abnf.cut.post(cc <> tt, Laws.ACutDot{})), fm, fp, ed))

# the first character of a word: a sign, a zero, a digit, or anything else,
# which fails
def n1.L.go(
  pp: Bool,
  mm: Bool,
  zz: Bool,
  dd: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +ep: {Char.is_eq(cc, '+') == pp : Bool},
  +em: {Char.is_eq(cc, '-') == mm : Bool},
  +ez: {Char.is_eq(cc, '0') == zz : Bool},
  +ed: {Char.is_digit(cc) == dd : Bool},
  ihp: {n1.fsh(T.num.go(tt, n1.ss(T.Plus{}))) == n1.S.R(tt) : Bool},
  ihm: {n1.fsh(T.num.go(tt, n1.ss(T.Minus{}))) == n1.S.R(tt) : Bool},
  ihz: n1.Z.G(tt, T.Plus{}),
  ihd: n1.D.G(tt, T.Plus{}, T.dec.go([], 10, T.dig.val(cc)), "")
) -> {n1.fsh(T.num.go(tt, T.num.lead.go(pp, mm, zz, dd, T.num.start(), cc))) == Laws.abnf.float_std(cc <> tt)
  : Bool}:
  match pp:
    case True{}:
      %Equal.sym(Char, cc, '+', Eq.char_eq_true(cc, '+', ep)) : {n1.fsh(T.num.go(tt, n1.ss(T.Plus{})))
        == Laws.abnf.float_std(_ <> tt) : Bool}
      %n1.dint.sgn('+', Laws.abnf.cut.pre(tt, Laws.ACutDot{}), n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{})), {==}) :
        {n1.fsh(T.num.go(tt, n1.ss(T.Plus{}))) == _ : Bool}
      ihp
    case False{}:
      match mm:
        case True{}:
          %Equal.sym(Char, cc, '-', Eq.char_eq_true(cc, '-', em)) : {n1.fsh(T.num.go(tt, n1.ss(T.Minus{})))
            == Laws.abnf.float_std(_ <> tt) : Bool}
          %n1.dint.sgn('-', Laws.abnf.cut.pre(tt, Laws.ACutDot{}), n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{})),
            {==}) : {n1.fsh(T.num.go(tt, n1.ss(T.Minus{}))) == _ : Bool}
          ihm
        case False{}:
          match zz:
            case True{}:
              %Equal.sym(Char, cc, '0', Eq.char_eq_true(cc, '0', ez)) : {n1.fsh(T.num.go(tt, n1.sz(T.Plus{})))
                == Laws.abnf.float_std(_ <> tt) : Bool}
              %n1.udi.z(Laws.abnf.cut.pre(tt, Laws.ACutDot{})) : {n1.fsh(T.num.go(tt, n1.sz(T.Plus{}))) == Bool.and(_,
                n1.fq(Laws.abnf.cut.post(tt, Laws.ACutDot{}))) : Bool}
              ihz
            case False{}:
              +fm = {Equal.trans(Bool, False{}, Char.is_eq(cc, '-'), Laws.abnf.minus(cc), Equal.sym(Bool,
                Char.is_eq(cc, '-'), False{}, em), n1.minus(cc)) : {False{} == Laws.abnf.minus(cc) : Bool}}
              +fp = {Equal.trans(Bool, False{}, Char.is_eq(cc, '+'), Laws.abnf.plus(cc), Equal.sym(Bool,
                Char.is_eq(cc, '+'), False{}, ep), n1.plus(cc)) : {False{} == Laws.abnf.plus(cc) : Bool}}
              n1.L.go2(dd, cc, tt, ez, ed, fm, fp, ihd)

# the numeral scan finishes as a float exactly when the word matches
# toml.abnf's float rule less its special floats
def n1.flo.sh(cs: List<&2, Char>) -> {n1.fsh(T.num.go(cs, T.num.start())) == Laws.abnf.float_std(cs) : Bool}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      n1.L.go(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), Char.is_eq(hh, '0'), Char.is_digit(hh), hh, tt, {==}, {==},
        {==}, {==}, n1.S(tt, T.Plus{}), n1.S(tt, T.Minus{}), n1.Z(tt, T.Plus{}),
        n1.D(tt, T.Plus{}, T.dec.go([], 10, T.dig.val(hh)), ""))

# Routing. A colon anywhere, or a dash after the first character with no e or
# E in the word, fails the numeral scan: so a word the scan reads as a value
# is never sent to the datetime reader. Every state keeps a base that 99, the
# value dig.val gives any character that is no digit, does not fit.

# whether a scan has failed
def n1.isbad(st: T.Num) -> Bool:
  match st:
    case T.Num{nk, _sign, _base, _ds, _us, _saw, _why}:
      match nk:
        case T.NBad{}:
          True{}
        case _k:
          False{}

# a failed scan stays failed
def n1.isbad.go(
  rest: List<&2, Char>,
  +st: T.Num,
  hs: {n1.isbad(st) == True{} : Bool}
) -> {n1.isbad(T.num.go(rest, st)) == True{} : Bool}:
  match rest:
    case []:
      hs
    case +hh <> tt:
      match st:
        case T.Num{nk, +sg, +base, +ds, +us, +saw, +why}:
          match nk:
            case T.NBad{}:
              n1.isbad.go(tt, T.Num{T.NBad{}, sg, base, ds, us, saw, why}, {==})
            case T.NLead{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NLead{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)
            case T.NSign{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NSign{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)
            case T.NZero{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NZero{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)
            case T.NDig{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NDig{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)
            case T.NBase{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NBase{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)
            case T.NFrac{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NFrac{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)
            case T.NExp{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NExp{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)
            case T.NEDig{}:
              Eq.bit.absurd(&2, {n1.isbad(T.num.go(hh <> tt, T.Num{T.NEDig{}, sg, base, ds, us, saw, why})) == True{}
                : Bool}, hs)

# a failed scan holds no float
def n1.isbad.fsh(+st: T.Num, hs: {n1.isbad(st) == True{} : Bool}) -> {n1.fsh(st) == False{} : Bool}:
  match st:
    case T.Num{nk, _sign, _base, _ds, us, saw, _why}:
      match nk:
        case T.NBad{}:
          {==}
        case T.NLead{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NLead{}, saw), Bool.not(us)) == False{} : Bool}, hs)
        case T.NSign{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NSign{}, saw), Bool.not(us)) == False{} : Bool}, hs)
        case T.NZero{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NZero{}, saw), Bool.not(us)) == False{} : Bool}, hs)
        case T.NDig{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NDig{}, saw), Bool.not(us)) == False{} : Bool}, hs)
        case T.NBase{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NBase{}, saw), Bool.not(us)) == False{} : Bool}, hs)
        case T.NFrac{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NFrac{}, saw), Bool.not(us)) == False{} : Bool}, hs)
        case T.NExp{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NExp{}, saw), Bool.not(us)) == False{} : Bool}, hs)
        case T.NEDig{}:
          Eq.bit.absurd(&2, {Bool.and(n1.fsh.nk(T.NEDig{}, saw), Bool.not(us)) == False{} : Bool}, hs)

# whether a scan's base leaves out 99: the value dig.val gives any character
# that is no digit of any base
def n1.bok(st: T.Num) -> Bool:
  match st:
    case T.Num{_nk, _sign, base, _ds, _us, _saw, _why}:
      Bool.not(U32.is_lt(99, base))

# a digit joined or refused keeps the base
def n1.bok.digit(
  ok: Bool,
  +cc: Char,
  +nk: T.NK,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.digit.ok(ok, cc, nk, sg, base, ds)) == True{} : Bool}:
  match ok:
    case True{}:
      hb
    case False{}:
      {==}

# an underscore taken or refused keeps the base
def n1.bok.us(
  ok: Bool,
  +nk: T.NK,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.us.go(ok, nk, sg, base, ds, why)) == True{} : Bool}:
  match ok:
    case True{}:
      hb
    case False{}:
      {==}

# a dot or an exponent mark taken or refused sets base ten
def n1.bok.ten(
  ok: Bool,
  +sg: T.Sign
) -> {Bool.and(n1.bok(T.num.dot.go(ok, sg)), n1.bok(T.num.exp.go(ok, sg))) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# the first character of an unsigned numeral keeps a base
def n1.bok.lead(
  pp: Bool,
  mm: Bool,
  zz: Bool,
  dd: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.lead.go(pp, mm, zz, dd, T.Num{T.NLead{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match pp:
    case True{}:
      {==}
    case False{}:
      match mm:
        case True{}:
          {==}
        case False{}:
          match zz:
            case True{}:
              {==}
            case False{}:
              match dd:
                case True{}:
                  n1.bok.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NDig{}, sg, base, ds, hb)
                case False{}:
                  {==}

# the character after a sign keeps a base
def n1.bok.sign(
  tw: Bool,
  +cc: Char,
  +sg: T.Sign
) -> {n1.bok(T.num.after.sign.go(tw, sg, cc)) == True{} : Bool}:
  match tw:
    case True{}:
      {==}
    case False{}:
      n1.bok.lead(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), Char.is_eq(cc, '0'), Char.is_digit(cc), cc, sg, 10, [],
        False{}, False{}, "", {==})

# the character after a leading zero keeps a base
def n1.bok.zero(
  xx: Bool,
  oo: Bool,
  bb: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {n1.bok(T.num.zero.go(xx, oo, bb, pp, e1, e2, T.Num{T.NZero{}, sg, base, ds, us, saw, why}, cc)) == True{}
  : Bool}:
  match xx oo bb pp:
    case True{} _o _b _p:
      {==}
    case False{} True{} _b _p:
      {==}
    case False{} False{} True{} _p:
      {==}
    case False{} False{} False{} True{}:
      Eq.and.left(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
        Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
    case False{} False{} False{} False{}:
      match e1:
        case True{}:
          Eq.and.right(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
            Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
        case False{}:
          match e2:
            case True{}:
              Eq.and.right(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
                Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
            case False{}:
              {==}

# the character after a digit of an integer part keeps a base
def n1.bok.digs(
  dd: Bool,
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.digs.go(dd, uu, pp, e1, e2, T.Num{T.NDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match dd uu pp:
    case True{} _u _p:
      n1.bok.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NDig{}, sg, base, ds, hb)
    case False{} True{} _p:
      n1.bok.us(Bool.and(saw, Bool.not(us)), T.NDig{}, sg, base, ds, why, hb)
    case False{} False{} True{}:
      Eq.and.left(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
        Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
    case False{} False{} False{}:
      match e1 e2:
        case True{} _e:
          Eq.and.right(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
            Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
        case False{} True{}:
          Eq.and.right(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
            Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
        case False{} False{}:
          {==}

# the character after a prefixed integer's digit keeps a base
def n1.bok.based(
  uu: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.based.go(uu, T.Num{T.NBase{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match uu:
    case True{}:
      n1.bok.us(Bool.and(saw, Bool.not(us)), T.NBase{}, sg, base, ds, why, hb)
    case False{}:
      n1.bok.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NBase{}, sg, base, ds, hb)

# the character after a fraction's digit keeps a base
def n1.bok.frac(
  dd: Bool,
  uu: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.frac.go(dd, uu, e1, e2, T.Num{T.NFrac{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match dd uu:
    case True{} _u:
      n1.bok.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NFrac{}, sg, base, ds, hb)
    case False{} True{}:
      n1.bok.us(Bool.and(saw, Bool.not(us)), T.NFrac{}, sg, base, ds, why, hb)
    case False{} False{}:
      match e1 e2:
        case True{} _e:
          Eq.and.right(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
            Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
        case False{} True{}:
          Eq.and.right(n1.bok(T.num.dot.go(Bool.and(saw, Bool.not(us)), sg)), n1.bok(T.num.exp.go(Bool.and(saw,
            Bool.not(us)), sg)), n1.bok.ten(Bool.and(saw, Bool.not(us)), sg))
        case False{} False{}:
          {==}

# the character after an exponent's e keeps a base
def n1.bok.expon(
  pp: Bool,
  mm: Bool,
  dd: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.expon.go(pp, mm, dd, T.Num{T.NExp{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match pp mm dd:
    case True{} _m _d:
      {==}
    case False{} True{} _d:
      {==}
    case False{} False{} True{}:
      n1.bok.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NEDig{}, sg, base, ds, hb)
    case False{} False{} False{}:
      {==}

# the character after an exponent's digit keeps a base
def n1.bok.edig(
  dd: Bool,
  uu: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.bok(T.num.edig.go(dd, uu, T.Num{T.NEDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match dd uu:
    case True{} _u:
      n1.bok.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NEDig{}, sg, base, ds, hb)
    case False{} True{}:
      n1.bok.us(Bool.and(saw, Bool.not(us)), T.NEDig{}, sg, base, ds, why, hb)
    case False{} False{}:
      {==}

# every step keeps a base that 99 does not fit
def n1.bok.step(
  +st: T.Num,
  +cc: Char,
  hb: {n1.bok(st) == True{} : Bool}
) -> {n1.bok(T.num.step(st, cc)) == True{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, +us, +saw, +why}:
      match nk:
        case T.NLead{}:
          n1.bok.lead(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), Char.is_eq(cc, '0'), Char.is_digit(cc), cc, sg, base,
            ds, us, saw, why, hb)
        case T.NSign{}:
          n1.bok.sign(Bool.or(Char.is_eq(cc, '+'), Char.is_eq(cc, '-')), cc, sg)
        case T.NZero{}:
          n1.bok.zero(Char.is_eq(cc, 'x'), Char.is_eq(cc, 'o'), Char.is_eq(cc, 'b'), Char.is_eq(cc, '.'),
            Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, sg, base, ds, us, saw, why)
        case T.NDig{}:
          n1.bok.digs(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, '.'), Char.is_eq(cc, 'e'),
            Char.is_eq(cc, 'E'), cc, sg, base, ds, us, saw, why, hb)
        case T.NBase{}:
          n1.bok.based(Char.is_eq(cc, '_'), cc, sg, base, ds, us, saw, why, hb)
        case T.NFrac{}:
          n1.bok.frac(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, sg, base,
            ds, us, saw, why, hb)
        case T.NExp{}:
          n1.bok.expon(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), Char.is_digit(cc), cc, sg, base, ds, us, saw, why, hb)
        case T.NEDig{}:
          n1.bok.edig(Char.is_digit(cc), Char.is_eq(cc, '_'), cc, sg, base, ds, us, saw, why, hb)
        case T.NBad{}:
          hb

# a not that answered True had False under it
def n1.not.t(+aa: Bool, hh: {Bool.not(aa) == True{} : Bool}) -> {aa == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd(&2, {True{} == False{} : Bool}, hh)
    case False{}:
      {==}

# a character no base takes, where the base leaves out 99, fails a prefixed
# integer
def n1.bad.based(
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  e9: {T.dig.val(cc) == 99 : U32},
  hb: {Bool.not(U32.is_lt(99, base)) == True{} : Bool}
) -> {n1.isbad(T.num.digit.ok(T.dig.ok(T.dig.val(cc), base), cc, T.NBase{}, sg, base, ds)) == True{} : Bool}:
  %Equal.sym(U32, T.dig.val(cc), 99, e9) : {n1.isbad(T.num.digit.ok(T.dig.ok(_, base), cc, T.NBase{}, sg, base, ds))
    == True{} : Bool}
  %Equal.sym(Bool, U32.is_lt(99, base), False{}, n1.not.t(U32.is_lt(99, base), hb)) :
    {n1.isbad(T.num.digit.ok(_, cc, T.NBase{}, sg, base, ds)) == True{} : Bool}
  {==}

# a colon fails every scan
def n1.colon.step(+st: T.Num, hb: {n1.bok(st) == True{} : Bool}) -> {n1.isbad(T.num.step(st, ':')) == True{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, +us, +saw, +why}:
      match nk:
        case T.NLead{}:
          {==}
        case T.NSign{}:
          {==}
        case T.NZero{}:
          {==}
        case T.NDig{}:
          {==}
        case T.NBase{}:
          n1.bad.based(':', sg, base, ds, {==}, hb)
        case T.NFrac{}:
          {==}
        case T.NExp{}:
          {==}
        case T.NEDig{}:
          {==}
        case T.NBad{}:
          {==}

# a word or answered False: both halves did
def n1.wor.l(
  aa: Bool,
  bb: Bool,
  ee: {T.word.or(aa, bb) == True{} : Bool},
  hf: {aa == False{} : Bool}
) -> {bb == True{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd2(&2, {bb == True{} : Bool}, hf)
    case False{}:
      ee

# a colon anywhere in the rest fails the scan
def n1.colon.go.c(
  cl: Bool,
  +hh: Char,
  tt: List<&2, Char>,
  +st: T.Num,
  hb: {n1.bok(st) == True{} : Bool},
  +ec: {Char.is_eq(hh, ':') == cl : Bool},
  hc: {T.word.or(cl, T.word.colon(tt)) == True{} : Bool},
  ih: {T.word.colon(tt) == True{} : Bool} -> {n1.isbad(T.num.go(tt, T.num.step(st, hh))) == True{} : Bool}
) -> {n1.isbad(T.num.go(tt, T.num.step(st, hh))) == True{} : Bool}:
  match cl:
    case True{}:
      %Equal.sym(Char, hh, ':', Eq.char_eq_true(hh, ':', ec)) : {n1.isbad(T.num.go(tt, T.num.step(st, _))) == True{}
        : Bool}
      n1.isbad.go(tt, T.num.step(st, ':'), n1.colon.step(st, hb))
    case False{}:
      ih(hc)

# a colon anywhere in the rest fails the scan
def n1.colon.go(
  rest: List<&2, Char>,
  +st: T.Num,
  +hb: {n1.bok(st) == True{} : Bool},
  hc: {T.word.colon(rest) == True{} : Bool}
) -> {n1.isbad(T.num.go(rest, st)) == True{} : Bool}:
  match rest:
    case []:
      Eq.bit.absurd(&2, {n1.isbad(st) == True{} : Bool}, hc)
    case +hh <> +tt:
      n1.colon.go.c(Char.is_eq(hh, ':'), hh, tt, st, hb, {==}, hc,
        h2 => n1.colon.go(tt, T.num.step(st, hh), n1.bok.step(st, hh, hb), h2))

# whether a numeral kind is past the first character and not an exponent's
def n1.noe.nk(nk: T.NK) -> Bool:
  match nk:
    case T.NLead{}:
      False{}
    case T.NExp{}:
      False{}
    case T.NEDig{}:
      False{}
    case _k:
      True{}

# whether a scan is past its first character and not in an exponent: there a
# dash fails it
def n1.noe(st: T.Num) -> Bool:
  match st:
    case T.Num{nk, _sign, _base, _ds, _us, _saw, _why}:
      n1.noe.nk(nk)

# a digit joined or refused leaves no exponent's state, in a kind that is none
def n1.noe.digit(
  ok: Bool,
  +cc: Char,
  +nk: T.NK,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  hn: {n1.noe.nk(nk) == True{} : Bool}
) -> {n1.noe(T.num.digit.ok(ok, cc, nk, sg, base, ds)) == True{} : Bool}:
  match ok:
    case True{}:
      hn
    case False{}:
      {==}

# an underscore taken or refused keeps a kind that is no exponent's
def n1.noe.us(
  ok: Bool,
  +nk: T.NK,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  hn: {n1.noe.nk(nk) == True{} : Bool}
) -> {n1.noe(T.num.us.go(ok, nk, sg, base, ds, why)) == True{} : Bool}:
  match ok:
    case True{}:
      hn
    case False{}:
      {==}

# a dot taken or refused leaves no exponent's state
def n1.noe.dot(ok: Bool, +sg: T.Sign) -> {n1.noe(T.num.dot.go(ok, sg)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# the first character of an unsigned numeral leaves no exponent's state
def n1.noe.lead(
  pp: Bool,
  mm: Bool,
  zz: Bool,
  dd: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {n1.noe(T.num.lead.go(pp, mm, zz, dd, T.Num{T.NLead{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match pp mm zz dd:
    case True{} _m _z _d:
      {==}
    case False{} True{} _z _d:
      {==}
    case False{} False{} True{} _d:
      {==}
    case False{} False{} False{} True{}:
      n1.noe.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NDig{}, sg, base, ds, {==})
    case False{} False{} False{} False{}:
      {==}

# the character after a sign leaves no exponent's state
def n1.noe.sign(tw: Bool, +cc: Char, +sg: T.Sign) -> {n1.noe(T.num.after.sign.go(tw, sg, cc)) == True{} : Bool}:
  match tw:
    case True{}:
      {==}
    case False{}:
      n1.noe.lead(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), Char.is_eq(cc, '0'), Char.is_digit(cc), cc, sg, 10, [],
        False{}, False{}, "")

# a character that is no e and no E after a leading zero leaves no exponent's
# state
def n1.noe.zero(
  xx: Bool,
  oo: Bool,
  bb: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  h1: {e1 == False{} : Bool},
  h2: {e2 == False{} : Bool}
) -> {n1.noe(T.num.zero.go(xx, oo, bb, pp, e1, e2, T.Num{T.NZero{}, sg, base, ds, us, saw, why}, cc)) == True{}
  : Bool}:
  match xx oo bb pp:
    case True{} _o _b _p:
      {==}
    case False{} True{} _b _p:
      {==}
    case False{} False{} True{} _p:
      {==}
    case False{} False{} False{} True{}:
      n1.noe.dot(Bool.and(saw, Bool.not(us)), sg)
    case False{} False{} False{} False{}:
      match e1 e2:
        case True{} _e:
          Eq.bit.absurd2(&2, {n1.noe(T.num.zero.go(False{}, False{}, False{}, False{}, True{}, e2, T.Num{T.NZero{}, sg,
            base, ds, us, saw, why}, cc)) == True{} : Bool}, h1)
        case False{} True{}:
          Eq.bit.absurd2(&2, {n1.noe(T.num.zero.go(False{}, False{}, False{}, False{}, False{}, True{}, T.Num{T.NZero{},
            sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, h2)
        case False{} False{}:
          {==}

# a character that is no e and no E after a digit of an integer part leaves
# no exponent's state
def n1.noe.digs(
  dd: Bool,
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  h1: {e1 == False{} : Bool},
  h2: {e2 == False{} : Bool}
) -> {n1.noe(T.num.digs.go(dd, uu, pp, e1, e2, T.Num{T.NDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match dd uu pp:
    case True{} _u _p:
      n1.noe.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NDig{}, sg, base, ds, {==})
    case False{} True{} _p:
      n1.noe.us(Bool.and(saw, Bool.not(us)), T.NDig{}, sg, base, ds, why, {==})
    case False{} False{} True{}:
      n1.noe.dot(Bool.and(saw, Bool.not(us)), sg)
    case False{} False{} False{}:
      match e1 e2:
        case True{} _e:
          Eq.bit.absurd2(&2, {n1.noe(T.num.digs.go(False{}, False{}, False{}, True{}, e2, T.Num{T.NDig{}, sg, base, ds,
            us, saw, why}, cc)) == True{} : Bool}, h1)
        case False{} True{}:
          Eq.bit.absurd2(&2, {n1.noe(T.num.digs.go(False{}, False{}, False{}, False{}, True{}, T.Num{T.NDig{}, sg, base,
            ds, us, saw, why}, cc)) == True{} : Bool}, h2)
        case False{} False{}:
          {==}

# the character after a prefixed integer's digit leaves no exponent's state
def n1.noe.based(
  uu: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {n1.noe(T.num.based.go(uu, T.Num{T.NBase{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match uu:
    case True{}:
      n1.noe.us(Bool.and(saw, Bool.not(us)), T.NBase{}, sg, base, ds, why, {==})
    case False{}:
      n1.noe.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NBase{}, sg, base, ds, {==})

# a character that is no e and no E after a fraction's digit leaves no
# exponent's state
def n1.noe.frac(
  dd: Bool,
  uu: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  h1: {e1 == False{} : Bool},
  h2: {e2 == False{} : Bool}
) -> {n1.noe(T.num.frac.go(dd, uu, e1, e2, T.Num{T.NFrac{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match dd uu:
    case True{} _u:
      n1.noe.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NFrac{}, sg, base, ds, {==})
    case False{} True{}:
      n1.noe.us(Bool.and(saw, Bool.not(us)), T.NFrac{}, sg, base, ds, why, {==})
    case False{} False{}:
      match e1 e2:
        case True{} _e:
          Eq.bit.absurd2(&2, {n1.noe(T.num.frac.go(False{}, False{}, True{}, e2, T.Num{T.NFrac{}, sg, base, ds, us,
            saw, why}, cc)) == True{} : Bool}, h1)
        case False{} True{}:
          Eq.bit.absurd2(&2, {n1.noe(T.num.frac.go(False{}, False{}, False{}, True{}, T.Num{T.NFrac{}, sg, base, ds, us,
            saw, why}, cc)) == True{} : Bool}, h2)
        case False{} False{}:
          {==}

# a character that is no e and no E leaves no exponent's state
def n1.noe.step(
  +st: T.Num,
  +cc: Char,
  hn: {n1.noe(st) == True{} : Bool},
  h1: {Char.is_eq(cc, 'e') == False{} : Bool},
  h2: {Char.is_eq(cc, 'E') == False{} : Bool}
) -> {n1.noe(T.num.step(st, cc)) == True{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, +us, +saw, +why}:
      match nk:
        case T.NLead{}:
          Eq.bit.absurd(&2, {n1.noe(T.num.step(T.Num{T.NLead{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool},
            hn)
        case T.NSign{}:
          n1.noe.sign(Bool.or(Char.is_eq(cc, '+'), Char.is_eq(cc, '-')), cc, sg)
        case T.NZero{}:
          n1.noe.zero(Char.is_eq(cc, 'x'), Char.is_eq(cc, 'o'), Char.is_eq(cc, 'b'), Char.is_eq(cc, '.'),
            Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, sg, base, ds, us, saw, why, h1, h2)
        case T.NDig{}:
          n1.noe.digs(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, '.'), Char.is_eq(cc, 'e'),
            Char.is_eq(cc, 'E'), cc, sg, base, ds, us, saw, why, h1, h2)
        case T.NBase{}:
          n1.noe.based(Char.is_eq(cc, '_'), cc, sg, base, ds, us, saw, why)
        case T.NFrac{}:
          n1.noe.frac(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, sg, base,
            ds, us, saw, why, h1, h2)
        case T.NExp{}:
          Eq.bit.absurd(&2, {n1.noe(T.num.step(T.Num{T.NExp{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hn)
        case T.NEDig{}:
          Eq.bit.absurd(&2, {n1.noe(T.num.step(T.Num{T.NEDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool},
            hn)
        case T.NBad{}:
          {==}

# a dash fails a scan past its first character and not in an exponent
def n1.dash.step(
  +st: T.Num,
  hb: {n1.bok(st) == True{} : Bool},
  hn: {n1.noe(st) == True{} : Bool}
) -> {n1.isbad(T.num.step(st, '-')) == True{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, +us, +saw, +why}:
      match nk:
        case T.NLead{}:
          Eq.bit.absurd(&2, {n1.isbad(T.num.step(T.Num{T.NLead{}, sg, base, ds, us, saw, why}, '-')) == True{} : Bool},
            hn)
        case T.NSign{}:
          {==}
        case T.NZero{}:
          {==}
        case T.NDig{}:
          {==}
        case T.NBase{}:
          n1.bad.based('-', sg, base, ds, {==}, hb)
        case T.NFrac{}:
          {==}
        case T.NExp{}:
          Eq.bit.absurd(&2, {n1.isbad(T.num.step(T.Num{T.NExp{}, sg, base, ds, us, saw, why}, '-')) == True{} : Bool},
            hn)
        case T.NEDig{}:
          Eq.bit.absurd(&2, {n1.isbad(T.num.step(T.Num{T.NEDig{}, sg, base, ds, us, saw, why}, '-')) == True{} : Bool},
            hn)
        case T.NBad{}:
          {==}

# a word or answered False: its right half did
def n1.wor.r(aa: Bool, bb: Bool, ee: {T.word.or(aa, bb) == False{} : Bool}) -> {bb == False{} : Bool}:
  match aa:
    case True{}:
      Eq.bit.absurd2(&2, {bb == False{} : Bool}, ee)
    case False{}:
      ee

# what the dash lemma claims of the rest after a character: that a dash in
# it, with no e or E, fails the scan
def n1.dash.IH(+hh: Char, +tt: List<&2, Char>, +st: T.Num) -> Type:
  {n1.noe(T.num.step(st, hh)) == True{} : Bool} -> {T.word.dash(tt, False{}) == True{} : Bool} ->
    {T.word.ee(tt) == False{} : Bool} -> {n1.isbad(T.num.go(tt, T.num.step(st, hh))) == True{} : Bool}

# a character of the rest: a dash fails, and anything else that is no e or E
# goes on
def n1.dash.go.c(
  dm: Bool,
  e1: Bool,
  e2: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +st: T.Num,
  hb: {n1.bok(st) == True{} : Bool},
  hn: {n1.noe(st) == True{} : Bool},
  +edm: {Char.is_eq(hh, '-') == dm : Bool},
  +ee1: {Char.is_eq(hh, 'e') == e1 : Bool},
  +ee2: {Char.is_eq(hh, 'E') == e2 : Bool},
  hd: {T.word.or(dm, T.word.dash(tt, False{})) == True{} : Bool},
  he: {T.word.or(Bool.or(e1, e2), T.word.ee(tt)) == False{} : Bool},
  ih: n1.dash.IH(hh, tt, st)
) -> {n1.isbad(T.num.go(tt, T.num.step(st, hh))) == True{} : Bool}:
  match dm:
    case True{}:
      %Equal.sym(Char, hh, '-', Eq.char_eq_true(hh, '-', edm)) : {n1.isbad(T.num.go(tt, T.num.step(st, _))) == True{}
        : Bool}
      n1.isbad.go(tt, T.num.step(st, '-'), n1.dash.step(st, hb, hn))
    case False{}:
      match e1:
        case True{}:
          Eq.bit.absurd2(&2, {n1.isbad(T.num.go(tt, T.num.step(st, hh))) == True{} : Bool}, he)
        case False{}:
          match e2:
            case True{}:
              Eq.bit.absurd2(&2, {n1.isbad(T.num.go(tt, T.num.step(st, hh))) == True{} : Bool}, he)
            case False{}:
              ih(n1.noe.step(st, hh, hn, ee1, ee2), hd, he)

# a dash in the rest, with no e or E in it, fails a scan past its first
# character and not in an exponent
def n1.dash.go(
  rest: List<&2, Char>,
  +st: T.Num,
  +hb: {n1.bok(st) == True{} : Bool},
  hn: {n1.noe(st) == True{} : Bool},
  hd: {T.word.dash(rest, False{}) == True{} : Bool},
  he: {T.word.ee(rest) == False{} : Bool}
) -> {n1.isbad(T.num.go(rest, st)) == True{} : Bool}:
  match rest:
    case []:
      Eq.bit.absurd(&2, {n1.isbad(st) == True{} : Bool}, hd)
    case +hh <> +tt:
      n1.dash.go.c(Char.is_eq(hh, '-'), Char.is_eq(hh, 'e'), Char.is_eq(hh, 'E'), hh, tt, st, hb, hn, {==}, {==}, {==},
        hd, he, a => b => c => n1.dash.go(tt, T.num.step(st, hh), n1.bok.step(st, hh, hb), a, b, c))

# The special words. word.spec compares the word with each of true, false,
# inf, nan and their signed forms, one character at a time, as abnf.chars_are
# does.

# comparing a word's text with a string is abnf.chars_are, while it still
# matches
def n1.streq(
  cs: List<&2, Char>,
  ss: String,
  ok: Bool
) -> {T.str.eq.step(String.from_list(cs), ss, ok) == Bool.and(ok, Laws.abnf.chars_are(cs, ss)) : Bool}:
  match cs ss:
    case [] SNil{}:
      match ok:
        case True{}:
          {==}
        case False{}:
          {==}
    case [] SCon{_h, _t}:
      match ok:
        case True{}:
          {==}
        case False{}:
          {==}
    case _h <> _t SNil{}:
      match ok:
        case True{}:
          {==}
        case False{}:
          {==}
    case +hh <> tt SCon{+h2, t2}:
      match ok:
        case True{}:
          n1.streq(tt, t2, Char.is_eq(hh, h2))
        case False{}:
          {==}

# a word whose characters are those of a string is that string's characters
def n1.ca.eq(
  cs: List<&2, Char>,
  ss: String,
  +hh: {Laws.abnf.chars_are(cs, ss) == True{} : Bool}
) -> {cs == String.to_list(ss) : List<&2, Char>}:
  match cs ss:
    case [] SNil{}:
      {==}
    case [] SCon{h0, t0}:
      Eq.bit.absurd(&2, {[] == String.to_list(SCon{h0, t0}) : List<&2, Char>}, hh)
    case h0 <> t0 SNil{}:
      Eq.bit.absurd(&2, {h0 <> t0 == [] : List<&2, Char>}, hh)
    case +h1 <> +t1 SCon{+h2, +t2}:
      +e1 = {Eq.char_eq_true(h1, h2, Eq.and.left(Char.is_eq(h1, h2), Laws.abnf.chars_are(t1, t2), hh)) : {h1 == h2
        : Char}}
      +e2 = {n1.ca.eq(t1, t2, Eq.and.right(Char.is_eq(h1, h2), Laws.abnf.chars_are(t1, t2), hh)) : {t1
        == String.to_list(t2) : List<&2, Char>}}
      %e1 : {h1 <> t1 == _ <> String.to_list(t2) : List<&2, Char>}
      %e2 : {h1 <> t1 == h1 <> _ : List<&2, Char>}
      {==}

# whether a word is one of the special words word.spec reads
def n1.isspec(+cs: List<&2, Char>) -> Bool:
  Bool.or(Laws.abnf.chars_are(cs, "true"), Bool.or(Laws.abnf.chars_are(cs, "false"), Bool.or(Laws.abnf.chars_are(cs,
    "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs, "-inf"),
    Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs,
    "-nan"))))))))

# a word's comparison with a special word, when abnf.chars_are refuses it
def n1.streq.f(
  +cs: List<&2, Char>,
  +ss: String,
  +hh: {Laws.abnf.chars_are(cs, ss) == False{} : Bool}
) -> {False{} == T.str.eq(String.from_list(cs), ss) : Bool}:
  Equal.sym(Bool, T.str.eq(String.from_list(cs), ss), False{}, Equal.trans(Bool, T.str.eq(String.from_list(cs), ss),
    Laws.abnf.chars_are(cs, ss), False{}, n1.streq(cs, ss, True{}), hh))

# a word that is none of the special words is no special value
def n1.spec.no(
  +cs: List<&2, Char>,
  +hs: {n1.isspec(cs) == False{} : Bool}
) -> {T.word.spec(String.from_list(cs)) == T.GotBad{""} : T.Got}:
  +ss = String.from_list(cs)
  +r1 = {Eq.or.right_false(Laws.abnf.chars_are(cs, "true"), Bool.or(Laws.abnf.chars_are(cs, "false"),
    Bool.or(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs,
    "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"),
    Laws.abnf.chars_are(cs, "-nan"))))))), hs) : {Bool.or(Laws.abnf.chars_are(cs, "false"),
    Bool.or(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs,
    "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"),
    Laws.abnf.chars_are(cs, "-nan"))))))) == False{} : Bool}}
  +r2 = {Eq.or.right_false(Laws.abnf.chars_are(cs, "false"), Bool.or(Laws.abnf.chars_are(cs, "inf"),
    Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs,
    "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan")))))), r1) :
    {Bool.or(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs,
    "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"),
    Laws.abnf.chars_are(cs, "-nan")))))) == False{} : Bool}}
  +r3 = {Eq.or.right_false(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"),
    Bool.or(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs,
    "+nan"), Laws.abnf.chars_are(cs, "-nan"))))), r2) : {Bool.or(Laws.abnf.chars_are(cs, "+inf"),
    Bool.or(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs,
    "+nan"), Laws.abnf.chars_are(cs, "-nan"))))) == False{} : Bool}}
  +r4 = {Eq.or.right_false(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs, "-inf"),
    Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs,
    "-nan")))), r3) : {Bool.or(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"),
    Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan")))) == False{} : Bool}}
  +r5 = {Eq.or.right_false(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"),
    Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan"))), r4) : {Bool.or(Laws.abnf.chars_are(cs,
    "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan"))) == False{} : Bool}}
  +r6 = {Eq.or.right_false(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"),
    Laws.abnf.chars_are(cs, "-nan")), r5) : {Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan"))
    == False{} : Bool}}
  %n1.streq.f(cs, "true", Eq.or.left_false(Laws.abnf.chars_are(cs, "true"), Bool.or(Laws.abnf.chars_are(cs, "false"),
    Bool.or(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs,
    "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs,
    "-nan"))))))), hs)) : {T.word.spec.t(_, T.str.eq(ss, "false"), ss) == T.GotBad{""} : T.Got}
  %n1.streq.f(cs, "false", Eq.or.left_false(Laws.abnf.chars_are(cs, "false"), Bool.or(Laws.abnf.chars_are(cs, "inf"),
    Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs,
    "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan")))))), r1)) :
    {T.word.spec.f(_, ss) == T.GotBad{""} : T.Got}
  %n1.streq.f(cs, "inf", Eq.or.left_false(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"),
    Bool.or(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs,
    "+nan"), Laws.abnf.chars_are(cs, "-nan"))))), r2)) :
    {T.word.spec.inf(_, T.str.eq(ss, "+inf"), T.str.eq(ss, "-inf"), ss) == T.GotBad{""} : T.Got}
  %n1.streq.f(cs, "+inf", Eq.or.left_false(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs, "-inf"),
    Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs,
    "-nan")))), r3)) : {T.word.spec.inf2(_, T.str.eq(ss, "-inf"), ss) == T.GotBad{""} : T.Got}
  %n1.streq.f(cs, "-inf", Eq.or.left_false(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"),
    Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan"))), r4)) :
    {T.word.spec.inf3(_, ss) == T.GotBad{""} : T.Got}
  %n1.streq.f(cs, "nan", Eq.or.left_false(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"),
    Laws.abnf.chars_are(cs, "-nan")), r5)) : {T.word.spec.nan(_, T.str.eq(ss, "+nan"), T.str.eq(ss, "-nan"))
    == T.GotBad{""} : T.Got}
  %n1.streq.f(cs, "+nan", Eq.or.left_false(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan"), r6)) :
    {T.word.spec.nan2(_, T.str.eq(ss, "-nan")) == T.GotBad{""} : T.Got}
  %n1.streq.f(cs, "-nan", Eq.or.right_false(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan"), r6)) :
    {T.word.spec.nan3(_) == T.GotBad{""} : T.Got}
  {==}

# a claim made of each special word is made of every special word
def n1.spec.split.go(
  -P: List<&2, Char> -> Type,
  b1: Bool,
  b2: Bool,
  b3: Bool,
  b4: Bool,
  b5: Bool,
  b6: Bool,
  b7: Bool,
  b8: Bool,
  cs: List<&2, Char>,
  +e1: {Laws.abnf.chars_are(cs, "true") == b1 : Bool},
  +e2: {Laws.abnf.chars_are(cs, "false") == b2 : Bool},
  +e3: {Laws.abnf.chars_are(cs, "inf") == b3 : Bool},
  +e4: {Laws.abnf.chars_are(cs, "+inf") == b4 : Bool},
  +e5: {Laws.abnf.chars_are(cs, "-inf") == b5 : Bool},
  +e6: {Laws.abnf.chars_are(cs, "nan") == b6 : Bool},
  +e7: {Laws.abnf.chars_are(cs, "+nan") == b7 : Bool},
  +e8: {Laws.abnf.chars_are(cs, "-nan") == b8 : Bool},
  +hs: {Bool.or(b1, Bool.or(b2, Bool.or(b3, Bool.or(b4, Bool.or(b5, Bool.or(b6, Bool.or(b7, b8))))))) == True{} : Bool},
  p1: P(String.to_list("true")),
  p2: P(String.to_list("false")),
  p3: P(String.to_list("inf")),
  p4: P(String.to_list("+inf")),
  p5: P(String.to_list("-inf")),
  p6: P(String.to_list("nan")),
  p7: P(String.to_list("+nan")),
  p8: P(String.to_list("-nan"))
) -> P(cs):
  match b1:
    case True{}:
      %Equal.sym(List<&2, Char>, cs, String.to_list("true"), n1.ca.eq(cs, "true", e1)) : P(_)
      p1
    case False{}:
      match b2:
        case True{}:
          %Equal.sym(List<&2, Char>, cs, String.to_list("false"), n1.ca.eq(cs, "false", e2)) : P(_)
          p2
        case False{}:
          match b3:
            case True{}:
              %Equal.sym(List<&2, Char>, cs, String.to_list("inf"), n1.ca.eq(cs, "inf", e3)) : P(_)
              p3
            case False{}:
              match b4:
                case True{}:
                  %Equal.sym(List<&2, Char>, cs, String.to_list("+inf"), n1.ca.eq(cs, "+inf", e4)) : P(_)
                  p4
                case False{}:
                  match b5:
                    case True{}:
                      %Equal.sym(List<&2, Char>, cs, String.to_list("-inf"), n1.ca.eq(cs, "-inf", e5)) : P(_)
                      p5
                    case False{}:
                      match b6:
                        case True{}:
                          %Equal.sym(List<&2, Char>, cs, String.to_list("nan"), n1.ca.eq(cs, "nan", e6)) : P(_)
                          p6
                        case False{}:
                          match b7:
                            case True{}:
                              %Equal.sym(List<&2, Char>, cs, String.to_list("+nan"), n1.ca.eq(cs, "+nan", e7)) : P(_)
                              p7
                            case False{}:
                              match b8:
                                case True{}:
                                  %Equal.sym(List<&2, Char>, cs, String.to_list("-nan"), n1.ca.eq(cs, "-nan",
                                    e8)) : P(_)
                                  p8
                                case False{}:
                                  Eq.bit.absurd(&1, P(cs), hs)

# a claim made of each special word is made of every special word
def n1.spec.split(
  -P: List<&2, Char> -> Type,
  +cs: List<&2, Char>,
  +hs: {n1.isspec(cs) == True{} : Bool},
  p1: P(String.to_list("true")),
  p2: P(String.to_list("false")),
  p3: P(String.to_list("inf")),
  p4: P(String.to_list("+inf")),
  p5: P(String.to_list("-inf")),
  p6: P(String.to_list("nan")),
  p7: P(String.to_list("+nan")),
  p8: P(String.to_list("-nan"))
) -> P(cs):
  n1.spec.split.go(P, Laws.abnf.chars_are(cs, "true"), Laws.abnf.chars_are(cs, "false"), Laws.abnf.chars_are(cs, "inf"),
    Laws.abnf.chars_are(cs, "+inf"), Laws.abnf.chars_are(cs, "-inf"), Laws.abnf.chars_are(cs, "nan"),
    Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan"), cs, {==}, {==}, {==}, {==}, {==}, {==}, {==},
    {==}, hs, p1, p2, p3, p4, p5, p6, p7, p8)

# every special word fails the numeral scan
def n1.spec.bad(
  +cs: List<&2, Char>,
  +hs: {n1.isspec(cs) == True{} : Bool}
) -> {n1.isbad(T.num.go(cs, T.num.start())) == True{} : Bool}:
  n1.spec.split(xs => {n1.isbad(T.num.go(xs, T.num.start())) == True{} : Bool}, cs, hs,
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# so a word the scan does not fail is no special word
def n1.spec.nb.go(
  sp: Bool,
  +cs: List<&2, Char>,
  +es: {n1.isspec(cs) == sp : Bool},
  +hg: {n1.isbad(T.num.go(cs, T.num.start())) == False{} : Bool}
) -> {n1.isspec(cs) == False{} : Bool}:
  match sp:
    case True{}:
      Eq.bit.absurd2(&2, {n1.isspec(cs) == False{} : Bool}, Equal.trans(Bool, True{}, n1.isbad(T.num.go(cs,
        T.num.start())), False{}, Equal.sym(Bool, n1.isbad(T.num.go(cs, T.num.start())), True{}, n1.spec.bad(cs, es)),
        hg))
    case False{}:
      es

# a word the scan does not fail has no colon
def n1.colon.nb(
  cl: Bool,
  +cs: List<&2, Char>,
  +ec: {T.word.colon(cs) == cl : Bool},
  +hg: {n1.isbad(T.num.go(cs, T.num.start())) == False{} : Bool}
) -> {T.word.colon(cs) == False{} : Bool}:
  match cl:
    case True{}:
      Eq.bit.absurd2(&2, {T.word.colon(cs) == False{} : Bool}, Equal.trans(Bool, True{}, n1.isbad(T.num.go(cs,
        T.num.start())), False{}, Equal.sym(Bool, n1.isbad(T.num.go(cs, T.num.start())), True{}, n1.colon.go(cs,
        T.num.start(), {==}, ec)), hg))
    case False{}:
      ec

# and no dash after its first character, unless it has an e or an E
def n1.dash.nb(
  dv: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +ed: {T.word.dash(tt, False{}) == dv : Bool},
  +he: {T.word.ee(tt) == False{} : Bool},
  +hg: {n1.isbad(T.num.go(hh <> tt, T.num.start())) == False{} : Bool}
) -> {T.word.dash(tt, False{}) == False{} : Bool}:
  match dv:
    case True{}:
      Eq.bit.absurd2(&2, {T.word.dash(tt, False{}) == False{} : Bool}, Equal.trans(Bool, True{},
        n1.isbad(T.num.go(hh <> tt, T.num.start())), False{}, Equal.sym(Bool, n1.isbad(T.num.go(hh <> tt,
        T.num.start())), True{}, n1.dash.go(tt, T.num.step(T.num.start(), hh), n1.bok.step(T.num.start(), hh, {==}),
        n1.noe.lead(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), Char.is_eq(hh, '0'), Char.is_digit(hh), hh, T.Plus{},
        10, [], False{}, False{}, ""), ed, he)), hg))
    case False{}:
      ed

# a word with an e or an E is no datetime
def n1.nodate.e(
  ex: Bool,
  +cs: List<&2, Char>,
  +ee: {T.word.ee(cs) == ex : Bool},
  +hg: {n1.isbad(T.num.go(cs, T.num.start())) == False{} : Bool}
) -> {T.word.as_date(T.word.dash(cs, True{}), ex) == False{} : Bool}:
  match ex:
    case True{}:
      {==}
    case False{}:
      match cs:
        case []:
          {==}
        case +hh <> +tt:
          n1.dash.nb(T.word.dash(tt, False{}), hh, tt, {==}, n1.wor.r(T.word.ee.hit(hh), T.word.ee(tt), ee), hg)

# a word the scan does not fail goes to the scan, not the datetime reader
def n1.nodate(
  +cs: List<&2, Char>,
  +hg: {n1.isbad(T.num.go(cs, T.num.start())) == False{} : Bool}
) -> {T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)) == False{} : Bool}:
  %Equal.sym(Bool, T.word.colon(cs), False{}, n1.colon.nb(T.word.colon(cs), cs, {==}, hg)) :
    {T.word.as_date(T.word.or(_, T.word.dash(cs, True{})), T.word.ee(cs)) == False{} : Bool}
  n1.nodate.e(T.word.ee(cs), cs, {==}, hg)

# a word the scan does not fail, special or not, is read by the scan
def n1.wv.go(
  ld: Bool,
  +cs: List<&2, Char>,
  +hg: {n1.isbad(T.num.go(cs, T.num.start())) == False{} : Bool}
) -> {T.word.val.pick(ld, cs) == T.word.num(cs) : T.Got}:
  match ld:
    case True{}:
      %Equal.sym(T.Got, T.word.spec(String.from_list(cs)), T.GotBad{""}, n1.spec.no(cs, n1.spec.nb.go(n1.isspec(cs), cs,
        {==}, hg))) : {T.word.route(_, T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs) == T.word.num(cs)
        : T.Got}
      %Equal.sym(Bool, T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), False{},
        n1.nodate(cs, hg)) : {T.word.route.date(_, cs) == T.word.num(cs) : T.Got}
      {==}
    case False{}:
      %Equal.sym(Bool, T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), False{},
        n1.nodate(cs, hg)) : {T.word.route.date(_, cs) == T.word.num(cs) : T.Got}
      {==}

# a word the scan does not fail is read by the scan
def n1.wv(
  +cs: List<&2, Char>,
  +hg: {n1.isbad(T.num.go(cs, T.num.start())) == False{} : Bool}
) -> {T.word.val(cs) == T.word.num(cs) : T.Got}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      n1.wv.go(T.word.special(hh), hh <> tt, hg)

# The float's value. A finished scan that holds a float is read as a float of
# the scan's sign and word.body's spelling; the sign is the word's first
# sign, and word.body's spelling is abnf.dec_digits'.

# a scan's sign
def n1.sgn(st: T.Num) -> T.Sign:
  match st:
    case T.Num{_nk, sign, _base, _ds, _us, _saw, _why}:
      sign

# a finished scan that holds a float is read as its sign and the spelling,
# by its fields
def n1.fin.flo.go(
  nk: T.NK,
  saw: Bool,
  uz: Bool,
  +sn: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  +cs: List<&2, Char>,
  +hf: {n1.fsh(T.Num{nk, sn, base, ds, uz, saw, why}) == True{} : Bool}
) -> {T.num.fin(T.Num{nk, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn, T.word.body(cs)}} : T.Got}:
  match nk:
    case T.NFrac{}:
      match saw:
        case True{}:
          match uz:
            case True{}:
              Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NFrac{}, sn, base, ds, True{}, True{}, why},
                cs) == T.GotVal{T.VFlo{sn, T.word.body(cs)}} : T.Got},
                hf)
            case False{}:
              {==}
        case False{}:
          Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NFrac{}, sn, base, ds, uz, False{}, why}, cs) == T.GotVal{T.VFlo{sn,
            T.word.body(cs)}} : T.Got}, hf)
    case T.NEDig{}:
      match saw:
        case True{}:
          match uz:
            case True{}:
              Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NEDig{}, sn, base, ds, True{}, True{}, why},
                cs) == T.GotVal{T.VFlo{sn, T.word.body(cs)}} : T.Got},
                hf)
            case False{}:
              {==}
        case False{}:
          Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NEDig{}, sn, base, ds, uz, False{}, why}, cs) == T.GotVal{T.VFlo{sn,
            T.word.body(cs)}} : T.Got}, hf)
    case T.NLead{}:
      Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NLead{}, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn,
        T.word.body(cs)}} : T.Got}, hf)
    case T.NSign{}:
      Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NSign{}, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn,
        T.word.body(cs)}} : T.Got}, hf)
    case T.NZero{}:
      Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NZero{}, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn,
        T.word.body(cs)}} : T.Got}, hf)
    case T.NDig{}:
      Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NDig{}, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn,
        T.word.body(cs)}} : T.Got}, hf)
    case T.NBase{}:
      Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NBase{}, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn,
        T.word.body(cs)}} : T.Got}, hf)
    case T.NExp{}:
      Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NExp{}, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn,
        T.word.body(cs)}} : T.Got}, hf)
    case T.NBad{}:
      Eq.bit.absurd(&2, {T.num.fin(T.Num{T.NBad{}, sn, base, ds, uz, saw, why}, cs) == T.GotVal{T.VFlo{sn,
        T.word.body(cs)}} : T.Got}, hf)

# a finished scan that holds a float is read as its sign and the spelling
def n1.fin.flo(
  +st: T.Num,
  +cs: List<&2, Char>,
  +hf: {n1.fsh(st) == True{} : Bool}
) -> {T.num.fin(st, cs) == T.GotVal{T.VFlo{n1.sgn(st), T.word.body(cs)}} : T.Got}:
  match st:
    case T.Num{nk, +sg, +base, +ds, us, saw, +why}:
      n1.fin.flo.go(nk, saw, us, sg, base, ds, why, cs, hf)

# an integer read or refused is no float
def n1.range.nflo(
  ok: Bool,
  +sg: T.Sign,
  +digits: String,
  +vv: T.Val
) -> {Laws.n1.got.flo(T.num.fin.range(ok, sg, digits), vv) == False{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# an integer, finished or refused, is no float
def n1.int.nflo(
  saw: Bool,
  +sg: T.Sign,
  +digits: String,
  +vv: T.Val
) -> {Laws.n1.got.flo(T.num.fin.int(saw, sg, digits), vv) == False{} : Bool}:
  match saw:
    case True{}:
      n1.range.nflo(T.i64.fits(sg, digits), sg, digits, vv)
    case False{}:
      {==}

# a prefixed integer, finished or refused, is no float
def n1.base.nflo(
  sd: Bool,
  saw: Bool,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +vv: T.Val
) -> {Laws.n1.got.flo(T.num.fin.base(sd, saw, sg, ds), vv) == False{} : Bool}:
  match sd:
    case True{}:
      {==}
    case False{}:
      n1.int.nflo(saw, sg, T.dec.text(ds), vv)

# a finished scan that holds no float is read as no float, by its fields
def n1.fin.nflo.go(
  uz: Bool,
  nk: T.NK,
  saw: Bool,
  +sn: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +hf: {n1.fsh(T.Num{nk, sn, base, ds, uz, saw, why}) == False{} : Bool}
) -> {Laws.n1.got.flo(T.num.fin(T.Num{nk, sn, base, ds, uz, saw, why}, cs), vv) == False{} : Bool}:
  match uz:
    case True{}:
      {==}
    case False{}:
      match nk saw:
        case T.NFrac{} True{}:
          Eq.bit.absurd2(&2, {Laws.n1.got.flo(T.num.fin(T.Num{T.NFrac{}, sn, base, ds, False{}, True{}, why}, cs),
            vv) == False{} : Bool}, hf)
        case T.NEDig{} True{}:
          Eq.bit.absurd2(&2, {Laws.n1.got.flo(T.num.fin(T.Num{T.NEDig{}, sn, base, ds, False{}, True{}, why}, cs),
            vv) == False{} : Bool}, hf)
        case T.NFrac{} False{}:
          {==}
        case T.NEDig{} False{}:
          {==}
        case T.NLead{} s0:
          {==}
        case T.NSign{} s0:
          {==}
        case T.NZero{} s0:
          {==}
        case T.NDig{} s0:
          n1.int.nflo(s0, sn, T.dec.text(ds), vv)
        case T.NBase{} s0:
          n1.base.nflo(T.num.signed(cs), s0, sn, ds, vv)
        case T.NExp{} s0:
          {==}
        case T.NBad{} s0:
          {==}

# a finished scan that holds no float is read as no float
def n1.fin.nflo(
  +st: T.Num,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +hf: {n1.fsh(st) == False{} : Bool}
) -> {Laws.n1.got.flo(T.num.fin(st, cs), vv) == False{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, us, saw, +why}:
      n1.fin.nflo.go(us, nk, saw, sg, base, ds, why, cs, vv, hf)

# The sign. After the first character every step keeps the scan's sign or
# fails it.

# whether a scan kind has the sign sg: a failed scan has any, and the state
# before the first character none
def n1.sgo.nk(nk: T.NK, +ss: T.Sign, +sg: T.Sign) -> Bool:
  match nk:
    case T.NBad{}:
      True{}
    case T.NLead{}:
      False{}
    case _k:
      Laws.sign.eq(ss, sg)

# whether a scan has the sign sg, or has failed
def n1.sgo(st: T.Num, +sg: T.Sign) -> Bool:
  match st:
    case T.Num{nk, ss, _base, _ds, _us, _saw, _why}:
      n1.sgo.nk(nk, ss, sg)

# a digit joined or refused keeps the sign
def n1.sgo.digit(
  ok: Bool,
  +cc: Char,
  +nk: T.NK,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +sg: T.Sign,
  hn: {n1.sgo.nk(nk, ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.digit.ok(ok, cc, nk, ss, base, ds), sg) == True{} : Bool}:
  match ok:
    case True{}:
      hn
    case False{}:
      {==}

# an underscore taken or refused keeps the sign
def n1.sgo.us(
  ok: Bool,
  +nk: T.NK,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  +sg: T.Sign,
  hn: {n1.sgo.nk(nk, ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.us.go(ok, nk, ss, base, ds, why), sg) == True{} : Bool}:
  match ok:
    case True{}:
      hn
    case False{}:
      {==}

# a dot taken or refused keeps the sign
def n1.sgo.dot(
  ok: Bool,
  +ss: T.Sign,
  +sg: T.Sign,
  hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.dot.go(ok, ss), sg) == True{} : Bool}:
  match ok:
    case True{}:
      hs
    case False{}:
      {==}

# an exponent mark taken or refused keeps the sign
def n1.sgo.exp(
  ok: Bool,
  +ss: T.Sign,
  +sg: T.Sign,
  hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.exp.go(ok, ss), sg) == True{} : Bool}:
  match ok:
    case True{}:
      hs
    case False{}:
      {==}

# the first character of an unsigned numeral after a sign keeps the sign
def n1.sgo.lead2(
  zz: Bool,
  dd: Bool,
  +cc: Char,
  +ss: T.Sign,
  +sg: T.Sign,
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.lead.go(False{}, False{}, zz, dd, n1.sl(ss), cc), sg) == True{} : Bool}:
  match zz:
    case True{}:
      hs
    case False{}:
      match dd:
        case True{}:
          n1.sgo.digit(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, ss, 10, [], sg, hs)
        case False{}:
          {==}

# the character after a sign keeps the sign
def n1.sgo.sign(
  pp: Bool,
  mm: Bool,
  +cc: Char,
  +ss: T.Sign,
  +sg: T.Sign,
  +ep: {Char.is_eq(cc, '+') == pp : Bool},
  +em: {Char.is_eq(cc, '-') == mm : Bool},
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.after.sign.go(Bool.or(pp, mm), ss, cc), sg) == True{} : Bool}:
  match pp:
    case True{}:
      {==}
    case False{}:
      match mm:
        case True{}:
          {==}
        case False{}:
          %Equal.sym(Bool, Char.is_eq(cc, '+'), False{}, ep) : {n1.sgo(T.num.lead.go(_, Char.is_eq(cc, '-'),
            Char.is_eq(cc, '0'), Char.is_digit(cc), n1.sl(ss), cc), sg) == True{} : Bool}
          %Equal.sym(Bool, Char.is_eq(cc, '-'), False{}, em) : {n1.sgo(T.num.lead.go(False{}, _,
            Char.is_eq(cc, '0'), Char.is_digit(cc), n1.sl(ss), cc), sg) == True{} : Bool}
          n1.sgo.lead2(Char.is_eq(cc, '0'), Char.is_digit(cc), cc, ss, sg, hs)

# the character after a leading zero keeps the sign
def n1.sgo.zero(
  xx: Bool,
  oo: Bool,
  bb: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sg: T.Sign,
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.zero.go(xx, oo, bb, pp, e1, e2, T.Num{T.NZero{}, ss, base, ds, us, saw, why}, cc), sg) == True{}
  : Bool}:
  match xx oo bb pp:
    case True{} _o _b _p:
      hs
    case False{} True{} _b _p:
      hs
    case False{} False{} True{} _p:
      hs
    case False{} False{} False{} True{}:
      n1.sgo.dot(Bool.and(saw, Bool.not(us)), ss, sg, hs)
    case False{} False{} False{} False{}:
      match e1 e2:
        case True{} _e:
          n1.sgo.exp(Bool.and(saw, Bool.not(us)), ss, sg, hs)
        case False{} True{}:
          n1.sgo.exp(Bool.and(saw, Bool.not(us)), ss, sg, hs)
        case False{} False{}:
          {==}

# the character after a digit of an integer part keeps the sign
def n1.sgo.digs(
  dd: Bool,
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sg: T.Sign,
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.digs.go(dd, uu, pp, e1, e2, T.Num{T.NDig{}, ss, base, ds, us, saw, why}, cc), sg) == True{}
  : Bool}:
  match dd uu pp:
    case True{} _u _p:
      n1.sgo.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NDig{}, ss, base, ds, sg, hs)
    case False{} True{} _p:
      n1.sgo.us(Bool.and(saw, Bool.not(us)), T.NDig{}, ss, base, ds, why, sg, hs)
    case False{} False{} True{}:
      n1.sgo.dot(Bool.and(saw, Bool.not(us)), ss, sg, hs)
    case False{} False{} False{}:
      match e1 e2:
        case True{} _e:
          n1.sgo.exp(Bool.and(saw, Bool.not(us)), ss, sg, hs)
        case False{} True{}:
          n1.sgo.exp(Bool.and(saw, Bool.not(us)), ss, sg, hs)
        case False{} False{}:
          {==}

# the character after a prefixed integer's digit keeps the sign
def n1.sgo.based(
  uu: Bool,
  +cc: Char,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sg: T.Sign,
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.based.go(uu, T.Num{T.NBase{}, ss, base, ds, us, saw, why}, cc), sg) == True{} : Bool}:
  match uu:
    case True{}:
      n1.sgo.us(Bool.and(saw, Bool.not(us)), T.NBase{}, ss, base, ds, why, sg, hs)
    case False{}:
      n1.sgo.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NBase{}, ss, base, ds, sg, hs)

# the character after a fraction's digit keeps the sign
def n1.sgo.frac(
  dd: Bool,
  uu: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sg: T.Sign,
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.frac.go(dd, uu, e1, e2, T.Num{T.NFrac{}, ss, base, ds, us, saw, why}, cc), sg) == True{} : Bool}:
  match dd uu:
    case True{} _u:
      n1.sgo.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NFrac{}, ss, base, ds, sg, hs)
    case False{} True{}:
      n1.sgo.us(Bool.and(saw, Bool.not(us)), T.NFrac{}, ss, base, ds, why, sg, hs)
    case False{} False{}:
      match e1 e2:
        case True{} _e:
          n1.sgo.exp(Bool.and(saw, Bool.not(us)), ss, sg, hs)
        case False{} True{}:
          n1.sgo.exp(Bool.and(saw, Bool.not(us)), ss, sg, hs)
        case False{} False{}:
          {==}

# the character after an exponent's e keeps the sign
def n1.sgo.expon(
  pp: Bool,
  mm: Bool,
  dd: Bool,
  +cc: Char,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sg: T.Sign,
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.expon.go(pp, mm, dd, T.Num{T.NExp{}, ss, base, ds, us, saw, why}, cc), sg) == True{} : Bool}:
  match pp mm dd:
    case True{} _m _d:
      hs
    case False{} True{} _d:
      hs
    case False{} False{} True{}:
      n1.sgo.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NEDig{}, ss, base, ds, sg, hs)
    case False{} False{} False{}:
      {==}

# the character after an exponent's digit keeps the sign
def n1.sgo.edig(
  dd: Bool,
  uu: Bool,
  +cc: Char,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sg: T.Sign,
  +hs: {Laws.sign.eq(ss, sg) == True{} : Bool}
) -> {n1.sgo(T.num.edig.go(dd, uu, T.Num{T.NEDig{}, ss, base, ds, us, saw, why}, cc), sg) == True{} : Bool}:
  match dd uu:
    case True{} _u:
      n1.sgo.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NEDig{}, ss, base, ds, sg, hs)
    case False{} True{}:
      n1.sgo.us(Bool.and(saw, Bool.not(us)), T.NEDig{}, ss, base, ds, why, sg, hs)
    case False{} False{}:
      {==}

# every step after the first keeps the sign or fails
def n1.sgo.step(
  +st: T.Num,
  +cc: Char,
  +sg: T.Sign,
  hs: {n1.sgo(st, sg) == True{} : Bool}
) -> {n1.sgo(T.num.step(st, cc), sg) == True{} : Bool}:
  match st:
    case T.Num{nk, +ss, +base, +ds, +us, +saw, +why}:
      match nk:
        case T.NLead{}:
          Eq.bit.absurd(&2, {n1.sgo(T.num.step(T.Num{T.NLead{}, ss, base, ds, us, saw, why}, cc), sg) == True{}
            : Bool}, hs)
        case T.NSign{}:
          n1.sgo.sign(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), cc, ss, sg, {==}, {==}, hs)
        case T.NZero{}:
          n1.sgo.zero(Char.is_eq(cc, 'x'), Char.is_eq(cc, 'o'), Char.is_eq(cc, 'b'), Char.is_eq(cc, '.'),
            Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, ss, base, ds, us, saw, why, sg, hs)
        case T.NDig{}:
          n1.sgo.digs(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, '.'), Char.is_eq(cc, 'e'),
            Char.is_eq(cc, 'E'), cc, ss, base, ds, us, saw, why, sg, hs)
        case T.NBase{}:
          n1.sgo.based(Char.is_eq(cc, '_'), cc, ss, base, ds, us, saw, why, sg, hs)
        case T.NFrac{}:
          n1.sgo.frac(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, ss, base,
            ds, us, saw, why, sg, hs)
        case T.NExp{}:
          n1.sgo.expon(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), Char.is_digit(cc), cc, ss, base, ds, us, saw, why, sg,
            hs)
        case T.NEDig{}:
          n1.sgo.edig(Char.is_digit(cc), Char.is_eq(cc, '_'), cc, ss, base, ds, us, saw, why, sg, hs)
        case T.NBad{}:
          {==}

# the rest keeps the sign or fails
def n1.sgo.go(
  rest: List<&2, Char>,
  +st: T.Num,
  +sg: T.Sign,
  hs: {n1.sgo(st, sg) == True{} : Bool}
) -> {n1.sgo(T.num.go(rest, st), sg) == True{} : Bool}:
  match rest:
    case []:
      hs
    case +hh <> tt:
      n1.sgo.go(tt, T.num.step(st, hh), sg, n1.sgo.step(st, hh, sg, hs))

# two signs sign.eq takes for one are one
def n1.sign.eq(aa: T.Sign, bb: T.Sign, hh: {Laws.sign.eq(aa, bb) == True{} : Bool}) -> {aa == bb : T.Sign}:
  match aa bb:
    case T.Plus{} T.Plus{}:
      {==}
    case T.Minus{} T.Minus{}:
      {==}
    case T.Plus{} T.Minus{}:
      Eq.bit.absurd(&2, {T.Plus{} == T.Minus{} : T.Sign}, hh)
    case T.Minus{} T.Plus{}:
      Eq.bit.absurd(&2, {T.Minus{} == T.Plus{} : T.Sign}, hh)

# a scan that holds a float and keeps the sign sg has the sign sg, by its
# fields
def n1.sgo.fsh.go(
  nk: T.NK,
  saw: Bool,
  us: Bool,
  +ss: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  +sg: T.Sign,
  hs: {n1.sgo(T.Num{nk, ss, base, ds, us, saw, why}, sg) == True{} : Bool},
  hf: {n1.fsh(T.Num{nk, ss, base, ds, us, saw, why}) == True{} : Bool}
) -> {ss == sg : T.Sign}:
  match nk:
    case T.NFrac{}:
      n1.sign.eq(ss, sg, hs)
    case T.NEDig{}:
      n1.sign.eq(ss, sg, hs)
    case T.NLead{}:
      Eq.bit.absurd(&2, {ss == sg : T.Sign}, hs)
    case T.NSign{}:
      Eq.bit.absurd(&2, {ss == sg : T.Sign}, hf)
    case T.NZero{}:
      Eq.bit.absurd(&2, {ss == sg : T.Sign}, hf)
    case T.NDig{}:
      Eq.bit.absurd(&2, {ss == sg : T.Sign}, hf)
    case T.NBase{}:
      Eq.bit.absurd(&2, {ss == sg : T.Sign}, hf)
    case T.NExp{}:
      Eq.bit.absurd(&2, {ss == sg : T.Sign}, hf)
    case T.NBad{}:
      Eq.bit.absurd(&2, {ss == sg : T.Sign}, hf)

# a scan that holds a float and keeps the sign sg has the sign sg
def n1.sgo.fsh(
  +st: T.Num,
  +sg: T.Sign,
  hs: {n1.sgo(st, sg) == True{} : Bool},
  hf: {n1.fsh(st) == True{} : Bool}
) -> {n1.sgn(st) == sg : T.Sign}:
  match st:
    case T.Num{nk, +ss, +base, +ds, us, saw, +why}:
      n1.sgo.fsh.go(nk, saw, us, ss, base, ds, why, sg, hs, hf)

# the first character of a word gives the sign abnf.dec_sign reads
def n1.sgo.start(
  pp: Bool,
  mm: Bool,
  zz: Bool,
  dd: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +ep: {Char.is_eq(hh, '+') == pp : Bool},
  +em: {Char.is_eq(hh, '-') == mm : Bool}
) -> {n1.sgo(T.num.lead.go(pp, mm, zz, dd, T.num.start(), hh), Laws.abnf.dec_sign(hh <> tt)) == True{} : Bool}:
  match pp:
    case True{}:
      %Equal.sym(Char, hh, '+', Eq.char_eq_true(hh, '+', ep)) : {n1.sgo(n1.ss(T.Plus{}), Laws.abnf.dec_sign(_ <> tt))
        == True{} : Bool}
      {==}
    case False{}:
      match mm:
        case True{}:
          %Equal.sym(Char, hh, '-', Eq.char_eq_true(hh, '-', em)) : {n1.sgo(n1.ss(T.Minus{}),
            Laws.abnf.dec_sign(_ <> tt)) == True{} : Bool}
          {==}
        case False{}:
          +fm = {Equal.trans(Bool, False{}, Char.is_eq(hh, '-'), Laws.abnf.minus(hh), Equal.sym(Bool,
            Char.is_eq(hh, '-'), False{}, em), n1.minus(hh)) : {False{} == Laws.abnf.minus(hh) : Bool}}
          %fm : {n1.sgo(T.num.lead.go(False{}, False{}, zz, dd, T.num.start(), hh), Laws.abnf.sign.pick(_)) == True{}
            : Bool}
          n1.sgo.lead2(zz, dd, hh, T.Plus{}, T.Plus{}, {==})

# a word the scan reads as a float has the sign abnf.dec_sign reads
def n1.flo.sign(
  +hh: Char,
  +tt: List<&2, Char>,
  hf: {n1.fsh(T.num.go(hh <> tt, T.num.start())) == True{} : Bool}
) -> {n1.sgn(T.num.go(hh <> tt, T.num.start())) == Laws.abnf.dec_sign(hh <> tt) : T.Sign}:
  n1.sgo.fsh(T.num.go(hh <> tt, T.num.start()), Laws.abnf.dec_sign(hh <> tt), n1.sgo.go(tt, T.num.step(T.num.start(),
    hh), Laws.abnf.dec_sign(hh <> tt), n1.sgo.start(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), Char.is_eq(hh, '0'),
    Char.is_digit(hh), hh, tt, {==}, {==})), hf)

# The spelling. word.body drops a leading sign and every underscore, as
# abnf.dec_digits does, for a word that does not start with an underscore.

# what the spelling lemma claims: after the first character, the spelling is
# the characters with the underscores removed, after what was kept
def n1.body.G(+cs: List<&2, Char>, +out: List<&2, Char>) -> Type:
  {T.word.body.go(cs, False{}, out) == List.reverse.go(&2, Char, out, String.to_list(Laws.abnf.no_us(cs)))
    : List<&2, Char>}

# one character after the first
def n1.body.c(
  uu: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  +out: List<&2, Char>,
  ih1: n1.body.G(tt, out),
  ih2: n1.body.G(tt, hh <> out)
) -> {T.word.body.go(tt, False{}, T.word.body.put.us(uu, hh, out)) == List.reverse.go(&2, Char, out,
  String.to_list(Laws.abnf.no_us.pick(uu, hh, Laws.abnf.no_us(tt)))) : List<&2, Char>}:
  match uu:
    case True{}:
      ih1
    case False{}:
      ih2

# after the first character, the spelling is the characters with the
# underscores removed, after what was kept
def n1.body.go(
  cs: List<&2, Char>,
  +out: List<&2, Char>
) -> {T.word.body.go(cs, False{}, out) == List.reverse.go(&2, Char, out,
  String.to_list(Laws.abnf.no_us(cs))) : List<&2, Char>}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      %n1.us(hh) : {T.word.body.go(tt, False{}, T.word.body.put.us(Char.is_eq(hh, '_'), hh, out))
        == List.reverse.go(&2, Char, out, String.to_list(Laws.abnf.no_us.pick(_, hh, Laws.abnf.no_us(tt))))
        : List<&2, Char>}
      n1.body.c(Char.is_eq(hh, '_'), hh, tt, out, n1.body.go(tt, out), n1.body.go(tt, hh <> out))

# the spelling after the first character, by whether it is a sign
def n1.body.s(
  pp: Bool,
  mm: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  hu: {Laws.abnf.underscore(hh) == False{} : Bool}
) -> {String.from_list(T.word.body.go(tt, False{}, T.word.body.put.sign(Bool.or(pp, mm), hh, [])))
  == Laws.abnf.digits.pick(Bool.or(mm, pp), hh, tt) : String}:
  match pp mm:
    case True{} True{}:
      %Equal.sym(List<&2, Char>, T.word.body.go(tt, False{}, []), String.to_list(Laws.abnf.no_us(tt)),
        n1.body.go(tt, [])) : {String.from_list(_) == Laws.abnf.no_us(tt) : String}
      ftl(Laws.abnf.no_us(tt))
    case True{} False{}:
      %Equal.sym(List<&2, Char>, T.word.body.go(tt, False{}, []), String.to_list(Laws.abnf.no_us(tt)),
        n1.body.go(tt, [])) : {String.from_list(_) == Laws.abnf.no_us(tt) : String}
      ftl(Laws.abnf.no_us(tt))
    case False{} True{}:
      %Equal.sym(List<&2, Char>, T.word.body.go(tt, False{}, []), String.to_list(Laws.abnf.no_us(tt)),
        n1.body.go(tt, [])) : {String.from_list(_) == Laws.abnf.no_us(tt) : String}
      ftl(Laws.abnf.no_us(tt))
    case False{} False{}:
      %Equal.sym(List<&2, Char>, T.word.body.go(tt, False{}, [hh]), hh <> String.to_list(Laws.abnf.no_us(tt)),
        n1.body.go(tt, [hh])) : {String.from_list(_) == Laws.abnf.no_us(hh <> tt) : String}
      %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, hu) : {SCon{hh, String.from_list(String.to_list(
        Laws.abnf.no_us(tt)))} == Laws.abnf.no_us.pick(_, hh, Laws.abnf.no_us(tt)) : String}
      %Equal.sym(String, String.from_list(String.to_list(Laws.abnf.no_us(tt))), Laws.abnf.no_us(tt),
        ftl(Laws.abnf.no_us(tt))) : {SCon{hh, _} == SCon{hh, Laws.abnf.no_us(tt)} : String}
      {==}

# a word that does not start with an underscore is spelled as abnf.dec_digits
# reads it
def n1.body(
  +hh: Char,
  +tt: List<&2, Char>,
  hu: {Char.is_eq(hh, '_') == False{} : Bool}
) -> {T.word.body(hh <> tt) == Laws.abnf.dec_digits(hh <> tt) : String}:
  %n1.minus(hh) : {String.from_list(T.word.body.go(tt, False{}, T.word.body.put.sign(Bool.or(Char.is_eq(hh, '+'),
    Char.is_eq(hh, '-')), hh, []))) == Laws.abnf.digits.pick(Bool.or(_, Laws.abnf.plus(hh)), hh, tt) : String}
  %n1.plus(hh) : {String.from_list(T.word.body.go(tt, False{}, T.word.body.put.sign(Bool.or(Char.is_eq(hh, '+'),
    Char.is_eq(hh, '-')), hh, []))) == Laws.abnf.digits.pick(Bool.or(Char.is_eq(hh, '-'), _), hh, tt) : String}
  n1.body.s(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), hh, tt, Equal.trans(Bool, Laws.abnf.underscore(hh),
    Char.is_eq(hh, '_'), False{}, Equal.sym(Bool, Char.is_eq(hh, '_'), Laws.abnf.underscore(hh), n1.us(hh)), hu))

# a word that starts with an underscore fails the scan
def n1.us.first(
  uu: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  eu: {Char.is_eq(hh, '_') == uu : Bool},
  hf: {n1.fsh(T.num.go(hh <> tt, T.num.start())) == True{} : Bool}
) -> {Char.is_eq(hh, '_') == False{} : Bool}:
  match uu:
    case True{}:
      +ee = {Equal.sym(Char, hh, '_', Eq.char_eq_true(hh, '_', eu)) : {'_' == hh : Char}}
      Eq.bit.absurd2(&2, {Char.is_eq(hh, '_') == False{} : Bool}, Equal.trans(Bool, True{}, n1.fsh(T.num.go(hh <> tt,
        T.num.start())), False{}, Equal.sym(Bool, n1.fsh(T.num.go(hh <> tt, T.num.start())), True{}, hf),
        Equal.trans(Bool, n1.fsh(T.num.go(hh <> tt, T.num.start())), n1.fsh(T.num.go('_' <> tt, T.num.start())),
          False{},
        Equal.cong(Char, Bool, xx => n1.fsh(T.num.go(xx <> tt, T.num.start())), hh, '_', Equal.sym(Char, '_', hh, ee)),
        n1.fsh.bad(tt, "invalid number"))))
    case False{}:
      eu

# The words word.val reads by their routes: a special word is read as itself,
# and any other word by the datetime reader or the numeral scan.

# a word that is none of the special words goes to the datetime reader or the
# numeral scan, special first character or not
def n1.wv.ns.go(
  ld: Bool,
  +cs: List<&2, Char>,
  hs: {n1.isspec(cs) == False{} : Bool}
) -> {T.word.val.pick(ld, cs) == T.word.route.date(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs,
  True{})), T.word.ee(cs)), cs) : T.Got}:
  match ld:
    case True{}:
      %Equal.sym(T.Got, T.word.spec(String.from_list(cs)), T.GotBad{""}, n1.spec.no(cs, hs)) : {T.word.route(_,
        T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), cs) == T.word.route.date(T.word.as_date(T.word.or(
        T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), cs) : T.Got}
      {==}
    case False{}:
      {==}

# a word that is none of the special words goes to the datetime reader or the
# numeral scan
def n1.wv.ns(
  +cs: List<&2, Char>,
  hs: {n1.isspec(cs) == False{} : Bool}
) -> {T.word.val(cs) == T.word.route.date(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})),
  T.word.ee(cs)), cs) : T.Got}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      n1.wv.ns.go(T.word.special(hh), hh <> tt, hs)

# a word sent to the datetime reader fails the numeral scan
def n1.date.bad(
  bb: Bool,
  +cs: List<&2, Char>,
  eb: {n1.isbad(T.num.go(cs, T.num.start())) == bb : Bool},
  hd: {T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)) == True{} : Bool}
) -> {n1.isbad(T.num.go(cs, T.num.start())) == True{} : Bool}:
  match bb:
    case True{}:
      eb
    case False{}:
      Eq.bit.absurd2(&2, {n1.isbad(T.num.go(cs, T.num.start())) == True{} : Bool}, Equal.trans(Bool, True{},
        T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), False{},
        Equal.sym(Bool, T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), True{},
        hd), n1.nodate(cs, eb)))

# the second half of special-float: inf or nan, with no sign
def n1.sf.bare(
  -P: List<&2, Char> -> Type,
  ii: Bool,
  +cs: List<&2, Char>,
  ei: {Laws.abnf.chars_are(cs, "inf") == ii : Bool},
  hh: {Bool.or(ii, Laws.abnf.chars_are(cs, "nan")) == True{} : Bool},
  p3: P(String.to_list("inf")),
  p6: P(String.to_list("nan"))
) -> P(cs):
  match ii:
    case True{}:
      %Equal.sym(List<&2, Char>, cs, String.to_list("inf"), n1.ca.eq(cs, "inf", ei)) : P(_)
      p3
    case False{}:
      %Equal.sym(List<&2, Char>, cs, String.to_list("nan"), n1.ca.eq(cs, "nan", hh)) : P(_)
      p6

# a sign's inf or nan
def n1.sf.sgn(
  -P: List<&2, Char> -> Type,
  ii: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  ei: {Laws.abnf.chars_are(tt, "inf") == ii : Bool},
  hh: {Bool.or(ii, Laws.abnf.chars_are(tt, "nan")) == True{} : Bool},
  pi: P(cc <> String.to_list("inf")),
  pn: P(cc <> String.to_list("nan"))
) -> P(cc <> tt):
  match ii:
    case True{}:
      %Equal.sym(List<&2, Char>, tt, String.to_list("inf"), n1.ca.eq(tt, "inf", ei)) : P(cc <> _)
      pi
    case False{}:
      %Equal.sym(List<&2, Char>, tt, String.to_list("nan"), n1.ca.eq(tt, "nan", hh)) : P(cc <> _)
      pn

# the sign of a signed special-float
def n1.sf.sign(
  -P: List<&2, Char> -> Type,
  mm: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  em: {Laws.abnf.minus(hh) == mm : Bool},
  hp: {Bool.or(mm, Laws.abnf.plus(hh)) == True{} : Bool},
  hb: {Bool.or(Laws.abnf.chars_are(tt, "inf"), Laws.abnf.chars_are(tt, "nan")) == True{} : Bool},
  p4: P(String.to_list("+inf")),
  p5: P(String.to_list("-inf")),
  p7: P(String.to_list("+nan")),
  p8: P(String.to_list("-nan"))
) -> P(hh <> tt):
  match mm:
    case True{}:
      %Equal.sym(Char, hh, '-', Eq.char_eq_true(hh, '-', Equal.trans(Bool, Char.is_eq(hh, '-'), Laws.abnf.minus(hh),
        True{}, n1.minus(hh), em))) : P(_ <> tt)
      n1.sf.sgn(P, Laws.abnf.chars_are(tt, "inf"), '-', tt, {==}, hb, p5, p8)
    case False{}:
      %Equal.sym(Char, hh, '+', Eq.char_eq_true(hh, '+', Equal.trans(Bool, Char.is_eq(hh, '+'), Laws.abnf.plus(hh),
        True{}, n1.plus(hh), hp))) : P(_ <> tt)
      n1.sf.sgn(P, Laws.abnf.chars_are(tt, "inf"), '+', tt, {==}, hb, p4, p7)

# special-float with its sign test and the test after the sign lifted out
def n1.sf.H(aa: Bool, +bb: Bool, +cs: List<&2, Char>) -> Bool:
  Bool.or(Bool.and(aa, bb), Bool.or(Laws.abnf.chars_are(cs, "inf"), Laws.abnf.chars_are(cs, "nan")))

# special-float's two halves
def n1.sf.go(
  -P: List<&2, Char> -> Type,
  aa: Bool,
  bb: Bool,
  +hh: Char,
  +tt: List<&2, Char>,
  ea: {Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)) == aa : Bool},
  eb: {Bool.or(Laws.abnf.chars_are(tt, "inf"), Laws.abnf.chars_are(tt, "nan")) == bb : Bool},
  hs: {n1.sf.H(aa, bb, hh <> tt) == True{} : Bool},
  p3: P(String.to_list("inf")),
  p4: P(String.to_list("+inf")),
  p5: P(String.to_list("-inf")),
  p6: P(String.to_list("nan")),
  p7: P(String.to_list("+nan")),
  p8: P(String.to_list("-nan"))
) -> P(hh <> tt):
  match aa bb:
    case True{} True{}:
      n1.sf.sign(P, Laws.abnf.minus(hh), hh, tt, {==}, ea, eb, p4, p5, p7, p8)
    case True{} False{}:
      n1.sf.bare(P, Laws.abnf.chars_are(hh <> tt, "inf"), hh <> tt, {==}, hs, p3, p6)
    case False{} _b:
      n1.sf.bare(P, Laws.abnf.chars_are(hh <> tt, "inf"), hh <> tt, {==}, hs, p3, p6)

# a claim made of each special-float is made of every word that matches
# special-float
def n1.sf.split(
  -P: List<&2, Char> -> Type,
  +cs: List<&2, Char>,
  hs: {Laws.abnf.special_float(cs) == True{} : Bool},
  p3: P(String.to_list("inf")),
  p4: P(String.to_list("+inf")),
  p5: P(String.to_list("-inf")),
  p6: P(String.to_list("nan")),
  p7: P(String.to_list("+nan")),
  p8: P(String.to_list("-nan"))
) -> P(cs):
  match cs:
    case []:
      Eq.bit.absurd(&1, P([]), hs)
    case +hh <> +tt:
      n1.sf.go(P, Bool.or(Laws.abnf.minus(hh), Laws.abnf.plus(hh)), Bool.or(Laws.abnf.chars_are(tt, "inf"),
        Laws.abnf.chars_are(tt, "nan")), hh, tt, {==}, {==}, hs, p3, p4, p5, p6, p7, p8)

# a word that matches special-float is a special word
def n1.sf.spec(
  +cs: List<&2, Char>,
  hs: {Laws.abnf.special_float(cs) == True{} : Bool}
) -> {n1.isspec(cs) == True{} : Bool}:
  n1.sf.split(xs => {n1.isspec(xs) == True{} : Bool}, cs, hs, {==}, {==}, {==}, {==}, {==}, {==})

# a word that is no special word matches no special-float
def n1.sf.no(
  sf: Bool,
  +cs: List<&2, Char>,
  es: {Laws.abnf.special_float(cs) == sf : Bool},
  hs: {n1.isspec(cs) == False{} : Bool}
) -> {Laws.abnf.special_float(cs) == False{} : Bool}:
  match sf:
    case True{}:
      Eq.bit.absurd2(&2, {Laws.abnf.special_float(cs) == False{} : Bool}, Equal.trans(Bool, True{}, n1.isspec(cs),
        False{}, Equal.sym(Bool, n1.isspec(cs), True{}, n1.sf.spec(cs, es)), hs))
    case False{}:
      es

# The float law.

# no datetime is a float
def n1.when.nflo(ww: T.WhenOut, +vv: T.Val) -> {Laws.n1.got.flo(T.word.from.when(ww), vv) == False{} : Bool}:
  match ww:
    case T.WSome{_w}:
      {==}
    case T.WFail{_y}:
      {==}
    case T.WSkip{}:
      {==}

# what the float law claims of a word
def n1.flo.G(+cs: List<&2, Char>, +vv: T.Val) -> Type:
  {Laws.n1.got.flo(T.word.val(cs), vv) == Bool.and(Laws.abnf.float(cs), Laws.g.val(Laws.GvFloat{cs}, vv)) : Bool}

# a float's reading holds the value exactly when the value is the one the
# word denotes
def n1.flo.same(
  vv: T.Val,
  +cs: List<&2, Char>
) -> {Laws.n1.got.flo(T.GotVal{T.VFlo{Laws.abnf.dec_sign(cs), Laws.abnf.dec_digits(cs)}}, vv) == Laws.g.flo.is(vv,
  cs) : Bool}:
  match vv:
    case T.VFlo{_s, _t}:
      {==}
    case T.VStr{_t}:
      {==}
    case T.VSpan{_s, _n}:
      {==}
    case T.VInt{_s, _d}:
      {==}
    case T.VBool{_b}:
      {==}
    case T.VWhen{_w}:
      {==}
    case T.VArr{_i}:
      {==}
    case T.VInl{_r}:
      {==}
    case T.VHead{_p, _r}:
      {==}
    case T.VAot{_p, _r}:
      {==}
    case T.VAots{_p, _e}:
      {==}
    case T.VPair{_n, _v}:
      {==}

# a special word's reading, for each special word
def n1.flo.spec(+vv: T.Val, +cs: List<&2, Char>, hs: {n1.isspec(cs) == True{} : Bool}) -> n1.flo.G(cs, vv):
  n1.spec.split(xs => n1.flo.G(xs, vv), cs, hs, {==}, {==}, n1.flo.same(vv, String.to_list("inf")),
    n1.flo.same(vv, String.to_list("+inf")), n1.flo.same(vv, String.to_list("-inf")),
    n1.flo.same(vv, String.to_list("nan")), n1.flo.same(vv, String.to_list("+nan")),
    n1.flo.same(vv, String.to_list("-nan")))

# a scan that holds a float has not failed
def n1.fsh.nb(
  bb: Bool,
  +st: T.Num,
  +eb: {n1.isbad(st) == bb : Bool},
  +hf: {n1.fsh(st) == True{} : Bool}
) -> {n1.isbad(st) == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.absurd(&2, {n1.isbad(st) == False{} : Bool}, Equal.trans(Bool, False{}, n1.fsh(st), True{},
        Equal.sym(Bool, n1.fsh(st), False{}, n1.isbad.fsh(st, eb)), hf))
    case False{}:
      eb

# a word that matches float-int-part ( exp / frac [ exp ] ) is read as the
# float it denotes
def n1.flo.std(
  +hh: Char,
  +tt: List<&2, Char>,
  +vv: T.Val,
  +efs: {Laws.abnf.float_std(hh <> tt) == True{} : Bool}
) -> n1.flo.G(hh <> tt, vv):
  +hf = {Equal.trans(Bool, n1.fsh(T.num.go(hh <> tt, T.num.start())), Laws.abnf.float_std(hh <> tt), True{},
    n1.flo.sh(hh <> tt), efs) : {n1.fsh(T.num.go(hh <> tt, T.num.start())) == True{} : Bool}}
  +fin = T.num.go(hh <> tt, T.num.start())
  +ew = {Equal.trans(T.Got, T.word.val(hh <> tt), T.num.fin(fin, hh <> tt),
    T.GotVal{T.VFlo{Laws.abnf.dec_sign(hh <> tt),
    Laws.abnf.dec_digits(hh <> tt)}}, n1.wv(hh <> tt, n1.fsh.nb(n1.isbad(fin), fin, {==}, hf)),
    Equal.trans(T.Got, T.num.fin(fin, hh <> tt), T.GotVal{T.VFlo{n1.sgn(fin), T.word.body(hh <> tt)}},
    T.GotVal{T.VFlo{Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)}}, n1.fin.flo(fin, hh <> tt, hf),
    Equal.trans(T.Got, T.GotVal{T.VFlo{n1.sgn(fin), T.word.body(hh <> tt)}}, T.GotVal{T.VFlo{Laws.abnf.dec_sign(hh <>
    tt), T.word.body(hh <> tt)}}, T.GotVal{T.VFlo{Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)}},
    Equal.cong(T.Sign, T.Got, ss => T.GotVal{T.VFlo{ss, T.word.body(hh <> tt)}}, n1.sgn(fin),
    Laws.abnf.dec_sign(hh <> tt), n1.flo.sign(hh, tt, hf)),
    Equal.cong(String, T.Got, ss => T.GotVal{T.VFlo{Laws.abnf.dec_sign(hh <> tt), ss}}, T.word.body(hh <> tt),
    Laws.abnf.dec_digits(hh <> tt), n1.body(hh, tt, n1.us.first(Char.is_eq(hh, '_'), hh, tt, {==}, hf))))))
    : {T.word.val(hh <> tt) == T.GotVal{T.VFlo{Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)}}
    : T.Got}}
  %Equal.sym(T.Got, T.word.val(hh <> tt), T.GotVal{T.VFlo{Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <>
    tt)}}, ew) : {Laws.n1.got.flo(_, vv) == Bool.and(Laws.abnf.float(hh <> tt), Laws.g.val(Laws.GvFloat{hh <> tt}, vv))
    : Bool}
  %Equal.sym(Bool, Laws.abnf.float_std(hh <> tt), True{}, efs) : {Laws.n1.got.flo(T.GotVal{T.VFlo{
    Laws.abnf.dec_sign(hh <> tt), Laws.abnf.dec_digits(hh <> tt)}}, vv) == Bool.and(Bool.or(_,
    Laws.abnf.special_float(hh <> tt)), Laws.g.val(Laws.GvFloat{hh <> tt}, vv)) : Bool}
  n1.flo.same(vv, hh <> tt)

# a word sent to the datetime reader or the numeral scan that holds no float
# is read as no float
def n1.flo.ns.go(
  ad: Bool,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +hf: {n1.fsh(T.num.go(cs, T.num.start())) == False{} : Bool}
) -> {Laws.n1.got.flo(T.word.route.date(ad, cs), vv) == False{} : Bool}:
  match ad:
    case True{}:
      n1.when.nflo(T.when.read(cs), vv)
    case False{}:
      n1.fin.nflo(T.num.go(cs, T.num.start()), cs, vv, hf)

# a word that is no special word and matches no float-int-part ( exp / frac
# [ exp ] ) is read as no float, and matches no float
def n1.flo.ns(
  +cs: List<&2, Char>,
  +vv: T.Val,
  +efs: {Laws.abnf.float_std(cs) == False{} : Bool},
  +hs: {n1.isspec(cs) == False{} : Bool}
) -> n1.flo.G(cs, vv):
  %Equal.sym(T.Got, T.word.val(cs), T.word.route.date(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs,
    True{})), T.word.ee(cs)), cs), n1.wv.ns(cs, hs)) : {Laws.n1.got.flo(_, vv) == Bool.and(Laws.abnf.float(cs),
    Laws.g.val(Laws.GvFloat{cs}, vv)) : Bool}
  %Equal.sym(Bool, Laws.abnf.float_std(cs), False{}, efs) : {Laws.n1.got.flo(T.word.route.date(T.word.as_date(
    T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), cs), vv) == Bool.and(Bool.or(_,
    Laws.abnf.special_float(cs)), Laws.g.val(Laws.GvFloat{cs}, vv)) : Bool}
  %Equal.sym(Bool, Laws.abnf.special_float(cs), False{}, n1.sf.no(Laws.abnf.special_float(cs), cs, {==}, hs)) :
    {Laws.n1.got.flo(T.word.route.date(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})),
    T.word.ee(cs)), cs), vv) == Bool.and(Bool.or(False{}, _), Laws.g.val(Laws.GvFloat{cs}, vv)) : Bool}
  n1.flo.ns.go(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), cs, vv,
    Equal.trans(Bool, n1.fsh(T.num.go(cs, T.num.start())), Laws.abnf.float_std(cs), False{}, n1.flo.sh(cs), efs))

# a word that matches no float-int-part ( exp / frac [ exp ] ): a special
# word, or no float at all
def n1.flo.nstd(
  sp: Bool,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +es: {n1.isspec(cs) == sp : Bool},
  +efs: {Laws.abnf.float_std(cs) == False{} : Bool}
) -> n1.flo.G(cs, vv):
  match sp:
    case True{}:
      n1.flo.spec(vv, cs, es)
    case False{}:
      n1.flo.ns(cs, vv, efs, es)

# the float law, by whether the word matches float-int-part ( exp / frac
# [ exp ] )
def n1.flo.law(
  fs: Bool,
  +cs: List<&2, Char>,
  +vv: T.Val,
  +efs: {Laws.abnf.float_std(cs) == fs : Bool}
) -> n1.flo.G(cs, vv):
  match fs:
    case True{}:
      match cs:
        case []:
          Eq.bit.absurd(&1, n1.flo.G([], vv), efs)
        case +hh <> +tt:
          n1.flo.std(hh, tt, vv, efs)
    case False{}:
      n1.flo.nstd(n1.isspec(cs), cs, vv, {==}, efs)

def Laws.float_word_exact(cs, v):
  n1.flo.law(Laws.abnf.float_std(cs), cs, v, {==})

# The boolean law. A boolean is one of two special words, so only word.spec
# reads one: the datetime reader and the numeral scan never do.

# no datetime is a boolean
def n1.when.nbool(ww: T.WhenOut, +vv: T.Val) -> {Laws.n1.got.bool(T.word.from.when(ww), vv) == False{} : Bool}:
  match ww:
    case T.WSome{_w}:
      {==}
    case T.WFail{_y}:
      {==}
    case T.WSkip{}:
      {==}

# an integer read or refused is no boolean
def n1.range.nbool(
  ok: Bool,
  +sg: T.Sign,
  +digits: String,
  +vv: T.Val
) -> {Laws.n1.got.bool(T.num.fin.range(ok, sg, digits), vv) == False{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# an integer, finished or refused, is no boolean
def n1.int.nbool(
  saw: Bool,
  +sg: T.Sign,
  +digits: String,
  +vv: T.Val
) -> {Laws.n1.got.bool(T.num.fin.int(saw, sg, digits), vv) == False{} : Bool}:
  match saw:
    case True{}:
      n1.range.nbool(T.i64.fits(sg, digits), sg, digits, vv)
    case False{}:
      {==}

# a prefixed integer, finished or refused, is no boolean
def n1.base.nbool(
  sd: Bool,
  saw: Bool,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +vv: T.Val
) -> {Laws.n1.got.bool(T.num.fin.base(sd, saw, sg, ds), vv) == False{} : Bool}:
  match sd:
    case True{}:
      {==}
    case False{}:
      n1.int.nbool(saw, sg, T.dec.text(ds), vv)

# a float, finished or refused, is no boolean
def n1.saw.nbool(
  saw: Bool,
  +sg: T.Sign,
  +text: String,
  +vv: T.Val
) -> {Laws.n1.got.bool(T.num.fin.saw(saw, T.VFlo{sg, text}), vv) == False{} : Bool}:
  match saw:
    case True{}:
      {==}
    case False{}:
      {==}

# a finished scan is read as no boolean, by its fields
def n1.fin.nbool.go(
  uz: Bool,
  nk: T.NK,
  +saw: Bool,
  +sn: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  +cs: List<&2, Char>,
  +vv: T.Val
) -> {Laws.n1.got.bool(T.num.fin(T.Num{nk, sn, base, ds, uz, saw, why}, cs), vv) == False{} : Bool}:
  match uz:
    case True{}:
      {==}
    case False{}:
      match nk:
        case T.NFrac{}:
          n1.saw.nbool(saw, sn, T.word.body(cs), vv)
        case T.NEDig{}:
          n1.saw.nbool(saw, sn, T.word.body(cs), vv)
        case T.NLead{}:
          {==}
        case T.NSign{}:
          {==}
        case T.NZero{}:
          {==}
        case T.NDig{}:
          n1.int.nbool(saw, sn, T.dec.text(ds), vv)
        case T.NBase{}:
          n1.base.nbool(T.num.signed(cs), saw, sn, ds, vv)
        case T.NExp{}:
          {==}
        case T.NBad{}:
          {==}

# a finished scan is read as no boolean
def n1.fin.nbool(
  +st: T.Num,
  +cs: List<&2, Char>,
  +vv: T.Val
) -> {Laws.n1.got.bool(T.num.fin(st, cs), vv) == False{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, us, +saw, +why}:
      n1.fin.nbool.go(us, nk, saw, sg, base, ds, why, cs, vv)

# what the boolean law claims of a word
def n1.bool.G(+cs: List<&2, Char>, +vv: T.Val) -> Type:
  {Laws.n1.got.bool(T.word.val(cs), vv) == Bool.and(Laws.abnf.boolean(cs), Laws.g.val(Laws.GvBoolean{cs}, vv))
    : Bool}

# true's reading holds the value exactly when the value is true
def n1.bool.t(vv: T.Val) -> n1.bool.G(String.to_list("true"), vv):
  match vv:
    case T.VBool{b2}:
      match b2:
        case True{}:
          {==}
        case False{}:
          {==}
    case T.VFlo{_s, _t}:
      {==}
    case T.VStr{_t}:
      {==}
    case T.VSpan{_s, _n}:
      {==}
    case T.VInt{_s, _d}:
      {==}
    case T.VWhen{_w}:
      {==}
    case T.VArr{_i}:
      {==}
    case T.VInl{_r}:
      {==}
    case T.VHead{_p, _r}:
      {==}
    case T.VAot{_p, _r}:
      {==}
    case T.VAots{_p, _e}:
      {==}
    case T.VPair{_n, _v}:
      {==}

# false's reading holds the value exactly when the value is false
def n1.bool.f(vv: T.Val) -> n1.bool.G(String.to_list("false"), vv):
  match vv:
    case T.VBool{b2}:
      match b2:
        case True{}:
          {==}
        case False{}:
          {==}
    case T.VFlo{_s, _t}:
      {==}
    case T.VStr{_t}:
      {==}
    case T.VSpan{_s, _n}:
      {==}
    case T.VInt{_s, _d}:
      {==}
    case T.VWhen{_w}:
      {==}
    case T.VArr{_i}:
      {==}
    case T.VInl{_r}:
      {==}
    case T.VHead{_p, _r}:
      {==}
    case T.VAot{_p, _r}:
      {==}
    case T.VAots{_p, _e}:
      {==}
    case T.VPair{_n, _v}:
      {==}

# a special word's reading, for each special word
def n1.bool.spec(+vv: T.Val, +cs: List<&2, Char>, hs: {n1.isspec(cs) == True{} : Bool}) -> n1.bool.G(cs, vv):
  n1.spec.split(xs => n1.bool.G(xs, vv), cs, hs, n1.bool.t(vv), n1.bool.f(vv), {==}, {==}, {==}, {==}, {==}, {==})

# a word that is no special word is no boolean
def n1.bool.no(
  +cs: List<&2, Char>,
  +hs: {n1.isspec(cs) == False{} : Bool}
) -> {Laws.abnf.boolean(cs) == False{} : Bool}:
  +h1 = {Eq.or.left_false(Laws.abnf.chars_are(cs, "true"), Bool.or(Laws.abnf.chars_are(cs, "false"),
    Bool.or(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs,
    "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs,
    "-nan"))))))), hs) : {Laws.abnf.chars_are(cs, "true") == False{} : Bool}}
  +h2 = {Eq.or.left_false(Laws.abnf.chars_are(cs, "false"), Bool.or(Laws.abnf.chars_are(cs, "inf"),
    Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs, "-inf"), Bool.or(Laws.abnf.chars_are(cs,
    "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs, "-nan")))))),
    Eq.or.right_false(Laws.abnf.chars_are(cs, "true"), Bool.or(Laws.abnf.chars_are(cs, "false"),
    Bool.or(Laws.abnf.chars_are(cs, "inf"), Bool.or(Laws.abnf.chars_are(cs, "+inf"), Bool.or(Laws.abnf.chars_are(cs,
    "-inf"), Bool.or(Laws.abnf.chars_are(cs, "nan"), Bool.or(Laws.abnf.chars_are(cs, "+nan"), Laws.abnf.chars_are(cs,
    "-nan"))))))), hs)) : {Laws.abnf.chars_are(cs, "false") == False{} : Bool}}
  %Equal.sym(Bool, Laws.abnf.chars_are(cs, "true"), False{}, h1) : {Bool.or(_, Laws.abnf.chars_are(cs, "false"))
    == False{} : Bool}
  h2

# a word sent to the datetime reader or the numeral scan is read as no
# boolean
def n1.bool.ns.go(
  ad: Bool,
  +cs: List<&2, Char>,
  +vv: T.Val
) -> {Laws.n1.got.bool(T.word.route.date(ad, cs), vv) == False{} : Bool}:
  match ad:
    case True{}:
      n1.when.nbool(T.when.read(cs), vv)
    case False{}:
      n1.fin.nbool(T.num.go(cs, T.num.start()), cs, vv)

# a word that is no special word is read as no boolean, and matches none
def n1.bool.ns(+cs: List<&2, Char>, +vv: T.Val, +hs: {n1.isspec(cs) == False{} : Bool}) -> n1.bool.G(cs, vv):
  %Equal.sym(T.Got, T.word.val(cs), T.word.route.date(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs,
    True{})), T.word.ee(cs)), cs), n1.wv.ns(cs, hs)) : {Laws.n1.got.bool(_, vv) == Bool.and(Laws.abnf.boolean(cs),
    Laws.g.val(Laws.GvBoolean{cs}, vv)) : Bool}
  %Equal.sym(Bool, Laws.abnf.boolean(cs), False{}, n1.bool.no(cs, hs)) : {Laws.n1.got.bool(T.word.route.date(
    T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), cs), vv) == Bool.and(_,
    Laws.g.val(Laws.GvBoolean{cs}, vv)) : Bool}
  n1.bool.ns.go(T.word.as_date(T.word.or(T.word.colon(cs), T.word.dash(cs, True{})), T.word.ee(cs)), cs, vv)

# the boolean law, by whether the word is a special word
def n1.bool.law(sp: Bool, +cs: List<&2, Char>, +vv: T.Val, es: {n1.isspec(cs) == sp : Bool}) -> n1.bool.G(cs, vv):
  match sp:
    case True{}:
      n1.bool.spec(vv, cs, es)
    case False{}:
      n1.bool.ns(cs, vv, es)

def Laws.boolean_word_exact(cs, v):
  n1.bool.law(n1.isspec(cs), cs, v, {==})

# The digits of a prefixed integer. dig.val reads a digit, or a letter a to f
# in either case, as its value, and anything else as 99; dig.ok takes the
# value when it fits the base, which is exactly the radix's digit rule. The
# six letters of each case are taken one at a time, as dg.elim takes digits.

# a code point's comparisons with 97 and 102, seven bits each, the bits above
# the seventh comparing as cc with zero
def lw.cp(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +b4: Bool, +b5: Bool, +b6: Bool, +cc: Cmp) -> Bool:
  Bool.and(Cmp.is_ge(Word.cmp.fin(b0, True{}, Word.cmp.fin(b1, False{}, Word.cmp.fin(b2, False{}, Word.cmp.fin(b3,
    False{}, Word.cmp.fin(b4, False{}, Word.cmp.fin(b5, True{}, Word.cmp.fin(b6, True{}, cc)))))))),
    Cmp.is_le(Word.cmp.fin(b0, False{}, Word.cmp.fin(b1, True{}, Word.cmp.fin(b2, True{}, Word.cmp.fin(b3, False{},
      Word.cmp.fin(b4, False{}, Word.cmp.fin(b5, True{}, Word.cmp.fin(b6, True{}, cc)))))))))

# the char of seven low bits and zeros above them
def lw.ch(b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool) -> Char:
  Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, Eq.zw(25n)}}}}}}}}}

# the seven low bits of a lower case letter from a to f, highest first: six
# patterns are the letters, and the others compare out of the range
def lw.bits(
  -P: Char -> Type,
  +b6: Bool,
  +b5: Bool,
  +b4: Bool,
  +b3: Bool,
  +b2: Bool,
  +b1: Bool,
  +b0: Bool,
  h: {lw.cp(b0, b1, b2, b3, b4, b5, b6, EQ{}) == True{} : Bool},
  pa: P('a'),
  pb: P('b'),
  pc: P('c'),
  pd: P('d'),
  pe: P('e'),
  pf: P('f')
) -> P(lw.ch(b0, b1, b2, b3, b4, b5, b6)):
  match b6:
    case False{}:
      Eq.bit.absurd(&1, P(lw.ch(b0, b1, b2, b3, b4, b5, False{})), h)
    case True{}:
      match b5:
        case False{}:
          Eq.bit.absurd(&1, P(lw.ch(b0, b1, b2, b3, b4, False{}, True{})), h)
        case True{}:
          match b4:
            case True{}:
              Eq.bit.absurd(&1, P(lw.ch(b0, b1, b2, b3, True{}, True{}, True{})), h)
            case False{}:
              match b3:
                case True{}:
                  Eq.bit.absurd(&1, P(lw.ch(b0, b1, b2, True{}, False{}, True{}, True{})), h)
                case False{}:
                  match b2 b1 b0:
                    case False{} False{} False{}:
                      Eq.bit.absurd(&1, P(lw.ch(False{}, False{}, False{}, False{}, False{}, True{}, True{})), h)
                    case False{} False{} True{}:
                      pa
                    case False{} True{} False{}:
                      pb
                    case False{} True{} True{}:
                      pc
                    case True{} False{} False{}:
                      pd
                    case True{} False{} True{}:
                      pe
                    case True{} True{} False{}:
                      pf
                    case True{} True{} True{}:
                      Eq.bit.absurd(&1, P(lw.ch(True{}, True{}, True{}, False{}, False{}, True{}, True{})), h)

# the bits above the seventh are zero, or the code point is out of the range
def lw.at(
  -P: Char -> Type,
  cc: Cmp,
  +b6: Bool,
  +b5: Bool,
  +b4: Bool,
  +b3: Bool,
  +b2: Bool,
  +b1: Bool,
  +b0: Bool,
  +rest: Word(25n),
  ec: {Word.cmp(25n, rest, Eq.zw(25n)) == cc : Cmp},
  h: {lw.cp(b0, b1, b2, b3, b4, b5, b6, cc) == True{} : Bool},
  pa: P('a'),
  pb: P('b'),
  pc: P('c'),
  pd: P('d'),
  pe: P('e'),
  pf: P('f')
) -> P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, rest}}}}}}}}}):
  match cc:
    case LT{}:
      Eq.bit.gone(&1, P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, rest}}}}}}}}}),
        Eq.bit.clash2(Equal.trans(Bool, True{}, Cmp.is_lt(Word.cmp(25n, rest, Eq.zw(25n))), False{},
          Equal.sym(Bool, Cmp.is_lt(Word.cmp(25n, rest, Eq.zw(25n))), True{},
            Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Word.cmp(25n, rest, Eq.zw(25n)), LT{}, ec)),
          Eq.zw_nlt(25n, rest))))
    case GT{}:
      Eq.bit.absurd(&1, P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, rest}}}}}}}}}), h)
    case EQ{}:
      er = Equal.sym(Word(25n), rest, Eq.zw(25n), Eq.word_eq(25n, rest, Eq.zw(25n), ec))
      %er : P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, _}}}}}}}}})
      lw.bits(P, b6, b5, b4, b3, b2, b1, b0, h, pa, pb, pc, pd, pe, pf)

# a claim made of each lower case letter from a to f is made of every
# character from 97 to 102
def lw.elim(
  -P: Char -> Type,
  cc: Char,
  h: {Bool.and(U32.is_ge(Char.to_u32(cc), 97), U32.is_le(Char.to_u32(cc), 102)) == True{} : Bool},
  pa: P('a'),
  pb: P('b'),
  pc: P('c'),
  pd: P('d'),
  pe: P('e'),
  pf: P('f')
) -> P(cc):
  match cc:
    case Chr{U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, +rest}}}}}}}}}:
      lw.at(P, Word.cmp(25n, rest, Eq.zw(25n)), b6, b5, b4, b3, b2, b1, b0, rest, {==}, h, pa, pb, pc, pd, pe, pf)

# a code point's comparisons with 65 and 70, seven bits each, the bits above
# the seventh comparing as cc with zero
def up.cp(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +b4: Bool, +b5: Bool, +b6: Bool, +cc: Cmp) -> Bool:
  Bool.and(Cmp.is_ge(Word.cmp.fin(b0, True{}, Word.cmp.fin(b1, False{}, Word.cmp.fin(b2, False{}, Word.cmp.fin(b3,
    False{}, Word.cmp.fin(b4, False{}, Word.cmp.fin(b5, False{}, Word.cmp.fin(b6, True{}, cc)))))))),
    Cmp.is_le(Word.cmp.fin(b0, False{}, Word.cmp.fin(b1, True{}, Word.cmp.fin(b2, True{}, Word.cmp.fin(b3, False{},
      Word.cmp.fin(b4, False{}, Word.cmp.fin(b5, False{}, Word.cmp.fin(b6, True{}, cc)))))))))

# the char of seven low bits and zeros above them
def up.ch(b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool) -> Char:
  Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, Eq.zw(25n)}}}}}}}}}

# the seven low bits of an upper case letter from A to F, highest first: six
# patterns are the letters, and the others compare out of the range
def up.bits(
  -P: Char -> Type,
  +b6: Bool,
  +b5: Bool,
  +b4: Bool,
  +b3: Bool,
  +b2: Bool,
  +b1: Bool,
  +b0: Bool,
  h: {up.cp(b0, b1, b2, b3, b4, b5, b6, EQ{}) == True{} : Bool},
  pA: P('A'),
  pB: P('B'),
  pC: P('C'),
  pD: P('D'),
  pE: P('E'),
  pF: P('F')
) -> P(up.ch(b0, b1, b2, b3, b4, b5, b6)):
  match b6:
    case False{}:
      Eq.bit.absurd(&1, P(up.ch(b0, b1, b2, b3, b4, b5, False{})), h)
    case True{}:
      match b5:
        case True{}:
          Eq.bit.absurd(&1, P(up.ch(b0, b1, b2, b3, b4, True{}, True{})), h)
        case False{}:
          match b4:
            case True{}:
              Eq.bit.absurd(&1, P(up.ch(b0, b1, b2, b3, True{}, False{}, True{})), h)
            case False{}:
              match b3:
                case True{}:
                  Eq.bit.absurd(&1, P(up.ch(b0, b1, b2, True{}, False{}, False{}, True{})), h)
                case False{}:
                  match b2 b1 b0:
                    case False{} False{} False{}:
                      Eq.bit.absurd(&1, P(up.ch(False{}, False{}, False{}, False{}, False{}, False{}, True{})), h)
                    case False{} False{} True{}:
                      pA
                    case False{} True{} False{}:
                      pB
                    case False{} True{} True{}:
                      pC
                    case True{} False{} False{}:
                      pD
                    case True{} False{} True{}:
                      pE
                    case True{} True{} False{}:
                      pF
                    case True{} True{} True{}:
                      Eq.bit.absurd(&1, P(up.ch(True{}, True{}, True{}, False{}, False{}, False{}, True{})), h)

# the bits above the seventh are zero, or the code point is out of the range
def up.at(
  -P: Char -> Type,
  cc: Cmp,
  +b6: Bool,
  +b5: Bool,
  +b4: Bool,
  +b3: Bool,
  +b2: Bool,
  +b1: Bool,
  +b0: Bool,
  +rest: Word(25n),
  ec: {Word.cmp(25n, rest, Eq.zw(25n)) == cc : Cmp},
  h: {up.cp(b0, b1, b2, b3, b4, b5, b6, cc) == True{} : Bool},
  pA: P('A'),
  pB: P('B'),
  pC: P('C'),
  pD: P('D'),
  pE: P('E'),
  pF: P('F')
) -> P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, rest}}}}}}}}}):
  match cc:
    case LT{}:
      Eq.bit.gone(&1, P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, rest}}}}}}}}}),
        Eq.bit.clash2(Equal.trans(Bool, True{}, Cmp.is_lt(Word.cmp(25n, rest, Eq.zw(25n))), False{},
          Equal.sym(Bool, Cmp.is_lt(Word.cmp(25n, rest, Eq.zw(25n))), True{},
            Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Word.cmp(25n, rest, Eq.zw(25n)), LT{}, ec)),
          Eq.zw_nlt(25n, rest))))
    case GT{}:
      Eq.bit.absurd(&1, P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, rest}}}}}}}}}), h)
    case EQ{}:
      er = Equal.sym(Word(25n), rest, Eq.zw(25n), Eq.word_eq(25n, rest, Eq.zw(25n), ec))
      %er : P(Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, _}}}}}}}}})
      up.bits(P, b6, b5, b4, b3, b2, b1, b0, h, pA, pB, pC, pD, pE, pF)

# a claim made of each upper case letter from A to F is made of every
# character from 65 to 70
def up.elim(
  -P: Char -> Type,
  cc: Char,
  h: {Bool.and(U32.is_ge(Char.to_u32(cc), 65), U32.is_le(Char.to_u32(cc), 70)) == True{} : Bool},
  pA: P('A'),
  pB: P('B'),
  pC: P('C'),
  pD: P('D'),
  pE: P('E'),
  pF: P('F')
) -> P(cc):
  match cc:
    case Chr{U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, +rest}}}}}}}}}:
      up.at(P, Word.cmp(25n, rest, Eq.zw(25n)), b6, b5, b4, b3, b2, b1, b0, rest, {==}, h, pA, pB, pC, pD, pE, pF)

# the base of a radix: 16, 8 or 2
def n1.rb(rx: Laws.ARadix) -> U32:
  match rx:
    case Laws.AHex{}:
      16
    case Laws.AOct{}:
      8
    case Laws.ABin{}:
      2

# what the classification claims of a character: dig.ok takes its value in
# the radix's base exactly when it is one of the radix's digits
def n1.cls.P(+rx: Laws.ARadix, +cc: Char) -> Type:
  {T.dig.ok(T.dig.val(cc), n1.rb(rx)) == Laws.abnf.radix_digit(rx, cc) : Bool}

# a digit
def n1.cls.dig(rx: Laws.ARadix, cc: Char, hc: {Char.is_digit(cc) == True{} : Bool}) -> n1.cls.P(rx, cc):
  match rx:
    case Laws.AHex{}:
      dg.elim(zz => n1.cls.P(Laws.AHex{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.AOct{}:
      dg.elim(zz => n1.cls.P(Laws.AOct{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.ABin{}:
      dg.elim(zz => n1.cls.P(Laws.ABin{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a lower case letter a to f
def n1.cls.low(
  rx: Laws.ARadix,
  cc: Char,
  hc: {Bool.and(U32.is_ge(Char.to_u32(cc), 97), U32.is_le(Char.to_u32(cc), 102)) == True{} : Bool}
) -> n1.cls.P(rx, cc):
  match rx:
    case Laws.AHex{}:
      lw.elim(zz => n1.cls.P(Laws.AHex{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.AOct{}:
      lw.elim(zz => n1.cls.P(Laws.AOct{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.ABin{}:
      lw.elim(zz => n1.cls.P(Laws.ABin{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==})

# an upper case letter A to F
def n1.cls.up(
  rx: Laws.ARadix,
  cc: Char,
  hc: {Bool.and(U32.is_ge(Char.to_u32(cc), 65), U32.is_le(Char.to_u32(cc), 70)) == True{} : Bool}
) -> n1.cls.P(rx, cc):
  match rx:
    case Laws.AHex{}:
      up.elim(zz => n1.cls.P(Laws.AHex{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.AOct{}:
      up.elim(zz => n1.cls.P(Laws.AOct{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==})
    case Laws.ABin{}:
      up.elim(zz => n1.cls.P(Laws.ABin{}, zz), cc, hc, {==}, {==}, {==}, {==}, {==}, {==})

# zero is at most anything
def n1.le0(xx: Nat) -> {Cmp.is_le(Nat.cmp(0n, xx)) == True{} : Bool}:
  match xx:
    case 0n:
      {==}
    case 1n+_x:
      {==}

# at most a is at most a + k
def n1.le.add(
  nn: Nat,
  aa: Nat,
  +kk: Nat,
  hh: {Cmp.is_le(Nat.cmp(nn, aa)) == True{} : Bool}
) -> {Cmp.is_le(Nat.cmp(nn, Nat.add(aa, kk))) == True{} : Bool}:
  match nn aa:
    case 0n a0:
      n1.le0(Nat.add(a0, kk))
    case 1n+m1 0n:
      Eq.bit.absurd(&2, {Cmp.is_le(Nat.cmp(1n+m1, Nat.add(0n, kk))) == True{} : Bool}, hh)
    case 1n+m1 1n+a1:
      n1.le.add(m1, a1, kk, hh)

# a code point past aa + kk is past aa
def n1.le.no(
  bb: Bool,
  +nn: Nat,
  +aa: Nat,
  +kk: Nat,
  eb: {Cmp.is_le(Nat.cmp(nn, aa)) == bb : Bool},
  hh: {Cmp.is_le(Nat.cmp(nn, Nat.add(aa, kk))) == False{} : Bool}
) -> {Cmp.is_le(Nat.cmp(nn, aa)) == False{} : Bool}:
  match bb:
    case True{}:
      Eq.bit.absurd2(&2, {Cmp.is_le(Nat.cmp(nn, aa)) == False{} : Bool}, Equal.trans(Bool, True{},
        Cmp.is_le(Nat.cmp(nn, Nat.add(aa, kk))), False{}, Equal.sym(Bool, Cmp.is_le(Nat.cmp(nn, Nat.add(aa, kk))),
        True{},
        n1.le.add(nn, aa, kk, eb)), hh))
    case False{}:
      eb

# a code point that is no digit is none from 48 to hi, for hi at most 57
def n1.rng.nd(
  gg: Bool,
  +cp: U32,
  +hi: Nat,
  +kk: Nat,
  +hu: U32,
  eh: {U32.to_nat(hu) == hi : Nat},
  ek: {Nat.add(hi, kk) == 57n : Nat},
  +eg: {U32.is_ge(cp, 48) == gg : Bool},
  hd: {Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)) == False{} : Bool}
) -> {Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, hu)) == False{} : Bool}:
  match gg:
    case True{}:
      +hle = {Equal.trans(Bool, U32.is_le(cp, 57), Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)), False{},
        Equal.cong(Bool, Bool, xx => Bool.and(xx, U32.is_le(cp, 57)), True{}, U32.is_ge(cp, 48), Equal.sym(Bool,
        U32.is_ge(cp, 48), True{}, eg)), hd) : {U32.is_le(cp, 57) == False{} : Bool}}
      +h57 = {Equal.trans(Bool, Cmp.is_le(Nat.cmp(U32.to_nat(cp), Nat.add(hi, kk))), U32.is_le(cp, 57), False{},
        Equal.trans(Bool, Cmp.is_le(Nat.cmp(U32.to_nat(cp), Nat.add(hi, kk))), Cmp.is_le(Nat.cmp(U32.to_nat(cp), 57n)),
        U32.is_le(cp, 57), Equal.cong(Nat, Bool, xx => Cmp.is_le(Nat.cmp(U32.to_nat(cp), xx)), Nat.add(hi, kk), 57n,
        ek), Equal.sym(Bool, U32.is_le(cp, 57), Cmp.is_le(Nat.cmp(U32.to_nat(cp), 57n)), u.le(cp, 57))), hle)
        : {Cmp.is_le(Nat.cmp(U32.to_nat(cp), Nat.add(hi, kk))) == False{} : Bool}}
      %Equal.sym(Bool, U32.is_ge(cp, 48), True{}, eg) : {Bool.and(_, U32.is_le(cp, hu)) == False{} : Bool}
      Equal.trans(Bool, U32.is_le(cp, hu), Cmp.is_le(Nat.cmp(U32.to_nat(cp), hi)), False{}, Equal.trans(Bool,
        U32.is_le(cp, hu), Cmp.is_le(Nat.cmp(U32.to_nat(cp), U32.to_nat(hu))), Cmp.is_le(Nat.cmp(U32.to_nat(cp), hi)),
        u.le(cp, hu), Equal.cong(Nat, Bool, xx => Cmp.is_le(Nat.cmp(U32.to_nat(cp), xx)), U32.to_nat(hu), hi, eh)),
        n1.le.no(Cmp.is_le(Nat.cmp(U32.to_nat(cp), hi)), U32.to_nat(cp), hi, kk, {==}, h57))
    case False{}:
      %Equal.sym(Bool, U32.is_ge(cp, 48), False{}, eg) : {Bool.and(_, U32.is_le(cp, hu)) == False{} : Bool}
      {==}

# no digit of any base is 99
def n1.cls.none.go(
  rx: Laws.ARadix,
  +cp: U32,
  +ed: {Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)) == False{} : Bool},
  +el: {Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)) == False{} : Bool},
  +eu: {Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)) == False{} : Bool}
) -> {T.dig.ok(99, n1.rb(rx)) == Laws.abnf.radix_digit(rx, Chr{cp}) : Bool}:
  match rx:
    case Laws.AHex{}:
      %Equal.sym(Bool, Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)), False{}, ed) : {False{} == Bool.or(_,
        Bool.or(Laws.abnf.range(cp, 65, 70), Laws.abnf.range(cp, 97, 102))) : Bool}
      %Equal.sym(Bool, Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)), False{}, eu) : {False{} == Bool.or(False{},
        Bool.or(_, Laws.abnf.range(cp, 97, 102))) : Bool}
      %Equal.sym(Bool, Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)), False{}, el) : {False{} == Bool.or(False{},
        Bool.or(False{}, _)) : Bool}
      {==}
    case Laws.AOct{}:
      Equal.sym(Bool, Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 55)), False{}, n1.rng.nd(U32.is_ge(cp, 48), cp, 55n,
        2n, 55, {==}, {==}, {==}, ed))
    case Laws.ABin{}:
      Equal.sym(Bool, Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 49)), False{}, n1.rng.nd(U32.is_ge(cp, 48), cp, 49n,
        8n, 49, {==}, {==}, {==}, ed))

# a character that is no digit and no letter a to f in either case
def n1.cls.none(
  rx: Laws.ARadix,
  +cp: U32,
  +ed: {Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)) == False{} : Bool},
  +el: {Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)) == False{} : Bool},
  +eu: {Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)) == False{} : Bool}
) -> n1.cls.P(rx, Chr{cp}):
  %Equal.sym(Bool, Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)), False{}, ed) : {T.dig.ok(T.dig.dec(_, cp),
    n1.rb(rx)) == Laws.abnf.radix_digit(rx, Chr{cp}) : Bool}
  %Equal.sym(Bool, Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)), False{}, el) : {T.dig.ok(T.dig.low(_, cp),
    n1.rb(rx)) == Laws.abnf.radix_digit(rx, Chr{cp}) : Bool}
  %Equal.sym(Bool, Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)), False{}, eu) : {T.dig.ok(T.dig.up(_, cp),
    n1.rb(rx)) == Laws.abnf.radix_digit(rx, Chr{cp}) : Bool}
  n1.cls.none.go(rx, cp, ed, el, eu)

# a character of a code point that is a digit, a letter a to f, a letter A
# to F, or none of them
def n1.cls.go(
  dd: Bool,
  ll: Bool,
  uu: Bool,
  rx: Laws.ARadix,
  +cp: U32,
  +ed: {Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)) == dd : Bool},
  +el: {Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)) == ll : Bool},
  +eu: {Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)) == uu : Bool}
) -> n1.cls.P(rx, Chr{cp}):
  match dd:
    case True{}:
      n1.cls.dig(rx, Chr{cp}, ed)
    case False{}:
      match ll:
        case True{}:
          n1.cls.low(rx, Chr{cp}, el)
        case False{}:
          match uu:
            case True{}:
              n1.cls.up(rx, Chr{cp}, eu)
            case False{}:
              n1.cls.none(rx, cp, ed, el, eu)

# dig.ok takes a character's value in the radix's base exactly when it is one
# of the radix's digits
def n1.cls(rx: Laws.ARadix, cc: Char) -> n1.cls.P(rx, cc):
  match cc:
    case Chr{+cp}:
      n1.cls.go(Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)), Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)),
        Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)), rx, cp, {==}, {==}, {==})

# The integer's shape. A finished scan holds an integer, or one out of range,
# when it ends after a leading zero, after a digit of a decimal integer, or
# after a digit of a prefixed integer that no sign came before.

# whether a finished scan's kind holds an integer, sd saying whether the word
# starts with a sign
def n1.ish.nk(nk: T.NK, saw: Bool, us: Bool, +sd: Bool) -> Bool:
  match nk:
    case T.NZero{}:
      Bool.not(us)
    case T.NDig{}:
      Bool.and(saw, Bool.not(us))
    case T.NBase{}:
      Bool.and(saw, Bool.and(Bool.not(us), Bool.not(sd)))
    case _k:
      False{}

# whether a finished scan holds an integer
def n1.ish(st: T.Num, +sd: Bool) -> Bool:
  match st:
    case T.Num{nk, _sign, _base, _ds, us, saw, _why}:
      n1.ish.nk(nk, saw, us, sd)

# whether a numeral kind is a float's, or a failure
def n1.isf.nk(nk: T.NK) -> Bool:
  match nk:
    case T.NFrac{}:
      True{}
    case T.NExp{}:
      True{}
    case T.NEDig{}:
      True{}
    case T.NBad{}:
      True{}
    case _k:
      False{}

# whether a numeral scan is in a float or has failed
def n1.isf(st: T.Num) -> Bool:
  match st:
    case T.Num{nk, _sign, _base, _ds, _us, _saw, _why}:
      n1.isf.nk(nk)

# a digit of a float, taken or refused
def n1.isf.digit(
  ok: Bool,
  +cc: Char,
  +nk: T.NK,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  hn: {n1.isf.nk(nk) == True{} : Bool}
) -> {n1.isf(T.num.digit.ok(ok, cc, nk, sg, base, ds)) == True{} : Bool}:
  match ok:
    case True{}:
      hn
    case False{}:
      {==}

# an underscore of a float, taken or refused
def n1.isf.us(
  ok: Bool,
  +nk: T.NK,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +why: String,
  hn: {n1.isf.nk(nk) == True{} : Bool}
) -> {n1.isf(T.num.us.go(ok, nk, sg, base, ds, why)) == True{} : Bool}:
  match ok:
    case True{}:
      hn
    case False{}:
      {==}

# an exponent mark in a float, taken or refused
def n1.isf.exp(ok: Bool, +sg: T.Sign) -> {n1.isf(T.num.exp.go(ok, sg)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

# the character after a fraction's digit keeps a float's state
def n1.isf.frac(
  dd: Bool,
  uu: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {n1.isf(T.num.frac.go(dd, uu, e1, e2, T.Num{T.NFrac{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match dd uu:
    case True{} _u:
      n1.isf.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NFrac{}, sg, base, ds, {==})
    case False{} True{}:
      n1.isf.us(Bool.and(saw, Bool.not(us)), T.NFrac{}, sg, base, ds, why, {==})
    case False{} False{}:
      match e1 e2:
        case True{} _e:
          n1.isf.exp(Bool.and(saw, Bool.not(us)), sg)
        case False{} True{}:
          n1.isf.exp(Bool.and(saw, Bool.not(us)), sg)
        case False{} False{}:
          {==}

# the character after an exponent's e keeps a float's state
def n1.isf.expon(
  pp: Bool,
  mm: Bool,
  dd: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {n1.isf(T.num.expon.go(pp, mm, dd, T.Num{T.NExp{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match pp mm dd:
    case True{} _m _d:
      {==}
    case False{} True{} _d:
      {==}
    case False{} False{} True{}:
      n1.isf.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NEDig{}, sg, base, ds, {==})
    case False{} False{} False{}:
      {==}

# the character after an exponent's digit keeps a float's state
def n1.isf.edig(
  dd: Bool,
  uu: Bool,
  +cc: Char,
  +sg: T.Sign,
  +base: U32,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String
) -> {n1.isf(T.num.edig.go(dd, uu, T.Num{T.NEDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}:
  match dd uu:
    case True{} _u:
      n1.isf.digit(T.dig.ok(T.dig.val(cc), base), cc, T.NEDig{}, sg, base, ds, {==})
    case False{} True{}:
      n1.isf.us(Bool.and(saw, Bool.not(us)), T.NEDig{}, sg, base, ds, why, {==})
    case False{} False{}:
      {==}

# a step keeps a scan in a float or failed
def n1.isf.step(
  +st: T.Num,
  +cc: Char,
  hs: {n1.isf(st) == True{} : Bool}
) -> {n1.isf(T.num.step(st, cc)) == True{} : Bool}:
  match st:
    case T.Num{nk, +sg, +base, +ds, +us, +saw, +why}:
      match nk:
        case T.NFrac{}:
          n1.isf.frac(Char.is_digit(cc), Char.is_eq(cc, '_'), Char.is_eq(cc, 'e'), Char.is_eq(cc, 'E'), cc, sg, base,
            ds, us, saw, why)
        case T.NExp{}:
          n1.isf.expon(Char.is_eq(cc, '+'), Char.is_eq(cc, '-'), Char.is_digit(cc), cc, sg, base, ds, us, saw, why)
        case T.NEDig{}:
          n1.isf.edig(Char.is_digit(cc), Char.is_eq(cc, '_'), cc, sg, base, ds, us, saw, why)
        case T.NBad{}:
          {==}
        case T.NLead{}:
          Eq.bit.absurd(&2, {n1.isf(T.num.step(T.Num{T.NLead{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NSign{}:
          Eq.bit.absurd(&2, {n1.isf(T.num.step(T.Num{T.NSign{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NZero{}:
          Eq.bit.absurd(&2, {n1.isf(T.num.step(T.Num{T.NZero{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NDig{}:
          Eq.bit.absurd(&2, {n1.isf(T.num.step(T.Num{T.NDig{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)
        case T.NBase{}:
          Eq.bit.absurd(&2, {n1.isf(T.num.step(T.Num{T.NBase{}, sg, base, ds, us, saw, why}, cc)) == True{} : Bool}, hs)

# a scan in a float or failed never finishes as an integer
def n1.fcls(
  rest: List<&2, Char>,
  +st: T.Num,
  +sd: Bool,
  hs: {n1.isf(st) == True{} : Bool}
) -> {n1.ish(T.num.go(rest, st), sd) == False{} : Bool}:
  match rest:
    case []:
      match st:
        case T.Num{nk, _sign, _base, _ds, us, saw, _why}:
          match nk:
            case T.NFrac{}:
              {==}
            case T.NExp{}:
              {==}
            case T.NEDig{}:
              {==}
            case T.NBad{}:
              {==}
            case T.NLead{}:
              Eq.bit.absurd(&2, {n1.ish.nk(T.NLead{}, saw, us, sd) == False{} : Bool}, hs)
            case T.NSign{}:
              Eq.bit.absurd(&2, {n1.ish.nk(T.NSign{}, saw, us, sd) == False{} : Bool}, hs)
            case T.NZero{}:
              Eq.bit.absurd(&2, {n1.ish.nk(T.NZero{}, saw, us, sd) == False{} : Bool}, hs)
            case T.NDig{}:
              Eq.bit.absurd(&2, {n1.ish.nk(T.NDig{}, saw, us, sd) == False{} : Bool}, hs)
            case T.NBase{}:
              Eq.bit.absurd(&2, {n1.ish.nk(T.NBase{}, saw, us, sd) == False{} : Bool}, hs)
    case +hh <> tt:
      n1.fcls(tt, T.num.step(st, hh), sd, n1.isf.step(st, hh, hs))

# a failed scan holds no integer, whatever follows
def n1.ish.bad(
  rest: List<&2, Char>,
  +sd: Bool,
  +why: String
) -> {n1.ish(T.num.go(rest, T.Num{T.NBad{}, T.Plus{}, 10, [], False{}, False{}, why}), sd) == False{} : Bool}:
  n1.fcls(rest, T.Num{T.NBad{}, T.Plus{}, 10, [], False{}, False{}, why}, sd, {==})

# The decimal integer part. After a digit of it the scan finishes as an
# integer exactly when the rest is the repetition.

# after an underscore in an integer part, a character that is no digit fails
def n1.Dui.bad(
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  +sd: Bool
) -> {n1.ish(T.num.go(tt, T.num.digs.go(False{}, uu, pp, e1, e2, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why},
  cc)), sd) == False{} : Bool}:
  match uu:
    case True{}:
      n1.ish.bad(tt, sd, "invalid underscore")
    case False{}:
      match pp:
        case True{}:
          n1.ish.bad(tt, sd, "invalid fraction")
        case False{}:
          match e1:
            case True{}:
              n1.ish.bad(tt, sd, "invalid exponent")
            case False{}:
              match e2:
                case True{}:
                  n1.ish.bad(tt, sd, "invalid exponent")
                case False{}:
                  n1.ish.bad(tt, sd, "invalid number")

# what the integer-part lemma claims
def n1.Di.G(+rest: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String, +sd: Bool) -> Type:
  {n1.ish(T.num.go(rest, n1.sd(sg, ds, why)), sd) == Laws.abnf.dec_rep(rest) : Bool}

# the character after an underscore in an integer part
def n1.Dui.go(
  dd: Bool,
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  +sd: Bool,
  +ed: {Char.is_digit(cc) == dd : Bool},
  ih: n1.Di.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), "", sd)
) -> {n1.ish(T.num.go(tt, T.num.digs.go(dd, uu, pp, e1, e2, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why}, cc)),
  sd) == Laws.abnf.zero_prefixable_int(cc <> tt) : Bool}:
  match dd:
    case True{}:
      %n1.zpi.d(cc, tt, ed) : {n1.ish(T.num.go(tt, T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10,
        ds)), sd) == _ : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.ish(T.num.go(tt, T.num.digit.ok(_,
        cc, T.NDig{}, sg, 10, ds)), sd) == Laws.abnf.dec_rep(tt) : Bool}
      ih
    case False{}:
      Equal.trans(Bool, n1.ish(T.num.go(tt, T.num.digs.go(False{}, uu, pp, e1, e2, T.Num{T.NDig{}, sg, 10, ds, True{},
        True{}, why}, cc)), sd), False{}, Laws.abnf.zero_prefixable_int(cc <> tt), n1.Dui.bad(uu, pp, e1, e2, cc, tt,
        sg, ds, why, sd), n1.zpi.n(cc, tt, ed))

# the type of n1.Di.go's ihu
def n1.Di.go.P1(+tt: List<&2, Char>, +sg: T.Sign, +ds: List<&2, U32>, +why: String, +sd: Bool) -> Type:
  {n1.ish(T.num.go(tt, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why}),
    sd) == Laws.abnf.zero_prefixable_int(tt) : Bool}

# the character after a digit of an integer part
def n1.Di.go(
  dd: Bool,
  uu: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  +sd: Bool,
  +ed: {Char.is_digit(cc) == dd : Bool},
  +eu: {Char.is_eq(cc, '_') == uu : Bool},
  _ep: {Char.is_eq(cc, '.') == pp : Bool},
  _ee1: {Char.is_eq(cc, 'e') == e1 : Bool},
  _ee2: {Char.is_eq(cc, 'E') == e2 : Bool},
  ihd: n1.Di.G(tt, sg, T.dec.go(ds, 10, T.dig.val(cc)), "", sd),
  ihu: n1.Di.go.P1(tt, sg, ds, why, sd)
) -> {n1.ish(T.num.go(tt, T.num.digs.go(dd, uu, pp, e1, e2, n1.sd(sg, ds, why), cc)), sd)
  == Laws.abnf.dec_rep(cc <> tt) : Bool}:
  match dd:
    case True{}:
      %n1.rep.d(cc, tt, ed) : {n1.ish(T.num.go(tt, T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc, T.NDig{}, sg, 10,
        ds)), sd) == _ : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.ish(T.num.go(tt, T.num.digit.ok(_,
        cc, T.NDig{}, sg, 10, ds)), sd) == Laws.abnf.dec_rep(tt) : Bool}
      ihd
    case False{}:
      match uu:
        case True{}:
          %Equal.sym(Char, cc, '_', Eq.char_eq_true(cc, '_', eu)) : {n1.ish(T.num.go(tt, T.Num{T.NDig{}, sg, 10, ds,
            True{}, True{}, why}), sd) == Laws.abnf.dec_rep(_ <> tt) : Bool}
          %n1.rep.u(tt) : {n1.ish(T.num.go(tt, T.Num{T.NDig{}, sg, 10, ds, True{}, True{}, why}), sd) == _ : Bool}
          ihu
        case False{}:
          match pp:
            case True{}:
              %n1.rep.n(cc, tt, ed, eu) : {n1.ish(T.num.go(tt, n1.sf0(sg)), sd) == _ : Bool}
              n1.fcls(tt, n1.sf0(sg), sd, {==})
            case False{}:
              match e1:
                case True{}:
                  %n1.rep.n(cc, tt, ed, eu) : {n1.ish(T.num.go(tt, n1.se(sg)), sd) == _ : Bool}
                  n1.fcls(tt, n1.se(sg), sd, {==})
                case False{}:
                  match e2:
                    case True{}:
                      %n1.rep.n(cc, tt, ed, eu) : {n1.ish(T.num.go(tt, n1.se(sg)), sd) == _ : Bool}
                      n1.fcls(tt, n1.se(sg), sd, {==})
                    case False{}:
                      %n1.rep.n(cc, tt, ed, eu) : {n1.ish(T.num.go(tt, T.num.bad(n1.sd(sg, ds, why),
                        "invalid number")), sd) == _ : Bool}
                      n1.ish.bad(tt, sd, "invalid number")

# after a digit of an integer part, the scan finishes as an integer exactly
# when the rest is the repetition
def n1.Di(
  rest: List<&2, Char>,
  +sg: T.Sign,
  +ds: List<&2, U32>,
  +why: String,
  +sd: Bool
) -> n1.Di.G(rest, sg, ds, why, sd):
  match rest:
    case []:
      {==}
    case +hh <> tt:
      match tt:
        case []:
          n1.Di.go(Char.is_digit(hh), Char.is_eq(hh, '_'), Char.is_eq(hh, '.'), Char.is_eq(hh, 'e'),
            Char.is_eq(hh, 'E'), hh, [], sg, ds, why, sd, {==}, {==}, {==}, {==}, {==},
            n1.Di([], sg, T.dec.go(ds, 10, T.dig.val(hh)), "", sd), {==})
        case +h2 <> +t2:
          n1.Di.go(Char.is_digit(hh), Char.is_eq(hh, '_'), Char.is_eq(hh, '.'), Char.is_eq(hh, 'e'),
            Char.is_eq(hh, 'E'), hh, h2 <> t2, sg, ds, why, sd, {==}, {==}, {==}, {==}, {==},
            n1.Di(h2 <> t2, sg, T.dec.go(ds, 10, T.dig.val(hh)), "", sd),
            n1.Dui.go(Char.is_digit(h2), Char.is_eq(h2, '_'), Char.is_eq(h2, '.'), Char.is_eq(h2, 'e'),
              Char.is_eq(h2, 'E'), h2, t2, sg, ds, why, sd, {==}, n1.Di(t2, sg, T.dec.go(ds, 10, T.dig.val(h2)), "",
              sd)))

# The prefixed integer. After its prefix, and after each digit, the scan
# finishes as an integer exactly when the rest is the radix's repetition and
# no sign came before the prefix.

# a digit of the radix and then the repetition
def n1.bg(tt: List<&2, Char>, +rx: Laws.ARadix) -> Bool:
  match tt:
    case []:
      False{}
    case h2 <> t2:
      Bool.and(Laws.abnf.radix_digit(rx, h2), Laws.abnf.radix_rep(t2, rx))

# no radix has the underscore as a digit
def n1.rd.us(rx: Laws.ARadix) -> {Laws.abnf.radix_digit(rx, '_') == False{} : Bool}:
  match rx:
    case Laws.AHex{}:
      {==}
    case Laws.AOct{}:
      {==}
    case Laws.ABin{}:
      {==}

# a radix's digit is no underscore
def n1.rd.nus(
  uu: Bool,
  +rx: Laws.ARadix,
  +cc: Char,
  eu: {Char.is_eq(cc, '_') == uu : Bool},
  hd: {Laws.abnf.radix_digit(rx, cc) == True{} : Bool}
) -> {False{} == Laws.abnf.underscore(cc) : Bool}:
  match uu:
    case True{}:
      Eq.bit.absurd2(&2, {False{} == Laws.abnf.underscore(cc) : Bool}, Equal.trans(Bool, True{},
        Laws.abnf.radix_digit(rx, cc), False{}, Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), True{}, hd),
        Equal.trans(Bool, Laws.abnf.radix_digit(rx, cc), Laws.abnf.radix_digit(rx, '_'), False{}, Equal.cong(Char,
        Bool, xx => Laws.abnf.radix_digit(rx, xx), cc, '_', Eq.char_eq_true(cc, '_', eu)), n1.rd.us(rx))))
    case False{}:
      Equal.trans(Bool, False{}, Char.is_eq(cc, '_'), Laws.abnf.underscore(cc), Equal.sym(Bool, Char.is_eq(cc, '_'),
        False{}, eu), n1.us(cc))

# the repetition after a radix's digit is the repetition
def n1.rrep.d(
  +rx: Laws.ARadix,
  +cc: Char,
  tt: List<&2, Char>,
  +hd: {Laws.abnf.radix_digit(rx, cc) == True{} : Bool}
) -> {Laws.abnf.radix_rep(tt, rx) == Laws.abnf.radix_rep(cc <> tt, rx) : Bool}:
  match tt:
    case []:
      Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), True{}, hd)
    case +h2 <> +t2:
      %Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), True{}, hd) : {Laws.abnf.radix_rep(h2 <> t2, rx) == Bool.or(
        Bool.and(_, Laws.abnf.radix_rep(h2 <> t2, rx)), Bool.and(Laws.abnf.underscore(cc),
        Bool.and(Laws.abnf.radix_digit(rx, h2), Laws.abnf.radix_rep(t2, rx)))) : Bool}
      %n1.rd.nus(Char.is_eq(cc, '_'), rx, cc, {==}, hd) : {Laws.abnf.radix_rep(h2 <> t2, rx) == Bool.or(
        Laws.abnf.radix_rep(h2 <> t2, rx), Bool.and(_, Bool.and(Laws.abnf.radix_digit(rx, h2), Laws.abnf.radix_rep(t2,
        rx)))) : Bool}
      n1.orf.eq(Laws.abnf.radix_rep(h2 <> t2, rx), Laws.abnf.radix_rep(h2 <> t2, rx), {==})

# the repetition after an underscore is a radix's digit and the repetition
def n1.rrep.u(+rx: Laws.ARadix, tt: List<&2, Char>) -> {n1.bg(tt, rx) == Laws.abnf.radix_rep('_' <> tt, rx) : Bool}:
  match tt:
    case []:
      Equal.sym(Bool, Laws.abnf.radix_digit(rx, '_'), False{}, n1.rd.us(rx))
    case +h2 <> +t2:
      %Equal.sym(Bool, Laws.abnf.radix_digit(rx, '_'), False{}, n1.rd.us(rx)) : {n1.bg(h2 <> t2, rx) == Bool.or(
        Bool.and(_, Laws.abnf.radix_rep(h2 <> t2, rx)), Bool.and(True{}, Bool.and(Laws.abnf.radix_digit(rx, h2),
        Laws.abnf.radix_rep(t2, rx)))) : Bool}
      {==}

# no repetition starts with a character that is no radix digit and no
# underscore
def n1.rrep.n(
  +rx: Laws.ARadix,
  +cc: Char,
  tt: List<&2, Char>,
  +hd: {Laws.abnf.radix_digit(rx, cc) == False{} : Bool},
  +hu: {Char.is_eq(cc, '_') == False{} : Bool}
) -> {False{} == Laws.abnf.radix_rep(cc <> tt, rx) : Bool}:
  match tt:
    case []:
      Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), False{}, hd)
    case +h2 <> +t2:
      %Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), False{}, hd) : {False{} == Bool.or(Bool.and(_,
        Laws.abnf.radix_rep(h2 <> t2, rx)), Bool.and(Laws.abnf.underscore(cc), Bool.and(Laws.abnf.radix_digit(rx, h2),
        Laws.abnf.radix_rep(t2, rx)))) : Bool}
      %Equal.trans(Bool, False{}, Char.is_eq(cc, '_'), Laws.abnf.underscore(cc), Equal.sym(Bool, Char.is_eq(cc, '_'),
        False{}, hu), n1.us(cc)) : {False{} == Bool.or(False{}, Bool.and(_, Bool.and(Laws.abnf.radix_digit(rx, h2),
        Laws.abnf.radix_rep(t2, rx)))) : Bool}
      {==}

# the scan after a digit of a prefixed integer
def n1.sb(+sg: T.Sign, +rx: Laws.ARadix, +ds: List<&2, U32>) -> T.Num:
  T.Num{T.NBase{}, sg, n1.rb(rx), ds, False{}, True{}, ""}

# what the prefixed-digit lemma claims
def n1.Bi.G(+rest: List<&2, Char>, +sg: T.Sign, +rx: Laws.ARadix, +ds: List<&2, U32>, +sd: Bool) -> Type:
  {n1.ish(T.num.go(rest, n1.sb(sg, rx, ds)), sd) == Bool.and(Bool.not(sd), Laws.abnf.radix_rep(rest, rx)) : Bool}

# a digit of the radix is one dig.ok takes
def n1.cls.t(
  +rx: Laws.ARadix,
  +cc: Char,
  eo: {T.dig.ok(T.dig.val(cc), n1.rb(rx)) == True{} : Bool}
) -> {Laws.abnf.radix_digit(rx, cc) == True{} : Bool}:
  Equal.trans(Bool, Laws.abnf.radix_digit(rx, cc), T.dig.ok(T.dig.val(cc), n1.rb(rx)), True{}, Equal.sym(Bool,
    T.dig.ok(T.dig.val(cc), n1.rb(rx)), Laws.abnf.radix_digit(rx, cc), n1.cls(rx, cc)), eo)

# and no other character is
def n1.cls.f(
  +rx: Laws.ARadix,
  +cc: Char,
  eo: {T.dig.ok(T.dig.val(cc), n1.rb(rx)) == False{} : Bool}
) -> {Laws.abnf.radix_digit(rx, cc) == False{} : Bool}:
  Equal.trans(Bool, Laws.abnf.radix_digit(rx, cc), T.dig.ok(T.dig.val(cc), n1.rb(rx)), False{}, Equal.sym(Bool,
    T.dig.ok(T.dig.val(cc), n1.rb(rx)), Laws.abnf.radix_digit(rx, cc), n1.cls(rx, cc)), eo)

# a prefixed integer's state where an underscore fails (after an underscore,
# or before the first digit), with a character: a digit goes on, anything
# else fails
def n1.Bui.go(
  uu: Bool,
  ok: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sd: Bool,
  +eu: {Char.is_eq(cc, '_') == uu : Bool},
  +eo: {T.dig.ok(T.dig.val(cc), n1.rb(rx)) == ok : Bool},
  hq: {Bool.and(saw, Bool.not(us)) == False{} : Bool},
  ih: n1.Bi.G(tt, sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(cc)), sd)
) -> {n1.ish(T.num.go(tt, T.num.based.go(uu, T.Num{T.NBase{}, sg, n1.rb(rx), ds, us, saw, why}, cc)), sd)
  == Bool.and(Bool.not(sd), n1.bg(cc <> tt, rx)) : Bool}:
  match uu:
    case True{}:
      %Equal.sym(Char, cc, '_', Eq.char_eq_true(cc, '_', eu)) : {n1.ish(T.num.go(tt, T.num.us.go(Bool.and(saw,
        Bool.not(us)), T.NBase{}, sg, n1.rb(rx), ds, why)), sd) == Bool.and(Bool.not(sd), n1.bg(_ <> tt, rx)) : Bool}
      %Equal.sym(Bool, Bool.and(saw, Bool.not(us)), False{}, hq) : {n1.ish(T.num.go(tt, T.num.us.go(_, T.NBase{}, sg,
        n1.rb(rx), ds, why)), sd) == Bool.and(Bool.not(sd), n1.bg('_' <> tt, rx)) : Bool}
      %Equal.sym(Bool, Laws.abnf.radix_digit(rx, '_'), False{}, n1.rd.us(rx)) : {n1.ish(T.num.go(tt,
        T.num.bad(T.Num{T.NLead{}, T.Plus{}, 10, [], False{}, False{}, ""}, "invalid underscore")), sd)
        == Bool.and(Bool.not(sd), Bool.and(_, Laws.abnf.radix_rep(tt, rx))) : Bool}
      %Equal.sym(Bool, Bool.and(Bool.not(sd), False{}), False{}, gs.andf(Bool.not(sd))) : {n1.ish(T.num.go(tt,
        T.num.bad(T.Num{T.NLead{}, T.Plus{}, 10, [], False{}, False{}, ""},
        "invalid underscore")), sd) == _ : Bool}
      n1.ish.bad(tt, sd, "invalid underscore")
    case False{}:
      match ok:
        case True{}:
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), n1.rb(rx)), True{}, eo) : {n1.ish(T.num.go(tt, T.num.digit.ok(_, cc,
            T.NBase{}, sg, n1.rb(rx), ds)), sd) == Bool.and(Bool.not(sd), n1.bg(cc <> tt, rx)) : Bool}
          %Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), True{}, n1.cls.t(rx, cc, eo)) : {n1.ish(T.num.go(tt,
            n1.sb(sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(cc)))), sd) == Bool.and(Bool.not(sd), Bool.and(_,
            Laws.abnf.radix_rep(tt, rx))) : Bool}
          ih
        case False{}:
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), n1.rb(rx)), False{}, eo) : {n1.ish(T.num.go(tt, T.num.digit.ok(_,
            cc, T.NBase{}, sg, n1.rb(rx), ds)), sd) == Bool.and(Bool.not(sd), n1.bg(cc <> tt, rx)) : Bool}
          %Equal.sym(Bool, Laws.abnf.radix_digit(rx, cc), False{}, n1.cls.f(rx, cc, eo)) : {n1.ish(T.num.go(tt,
            T.num.bad(T.Num{T.NLead{}, T.Plus{}, 10, [], False{}, False{}, ""}, "invalid digit")), sd)
            == Bool.and(Bool.not(sd), Bool.and(_, Laws.abnf.radix_rep(tt, rx))) : Bool}
          %Equal.sym(Bool, Bool.and(Bool.not(sd), False{}), False{}, gs.andf(Bool.not(sd))) : {n1.ish(T.num.go(tt,
            T.num.bad(T.Num{T.NLead{}, T.Plus{}, 10, [], False{},
            False{}, ""}, "invalid digit")), sd) == _ : Bool}
          n1.ish.bad(tt, sd, "invalid digit")

# a prefixed integer's state where an underscore fails, with a character and
# the rest
def n1.Bui(
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +us: Bool,
  +saw: Bool,
  +why: String,
  +sd: Bool,
  hq: {Bool.and(saw, Bool.not(us)) == False{} : Bool},
  ih: n1.Bi.G(tt, sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(cc)), sd)
) -> {n1.ish(T.num.go(cc <> tt, T.Num{T.NBase{}, sg, n1.rb(rx), ds, us, saw, why}), sd)
  == Bool.and(Bool.not(sd), n1.bg(cc <> tt, rx)) : Bool}:
  n1.Bui.go(Char.is_eq(cc, '_'), T.dig.ok(T.dig.val(cc), n1.rb(rx)), cc, tt, sg, rx, ds, us, saw, why, sd, {==}, {==},
    hq, ih)

# the type of n1.Bi.go's ihu
def n1.Bi.go.P1(+tt: List<&2, Char>, +sg: T.Sign, +rx: Laws.ARadix, +ds: List<&2, U32>, +sd: Bool) -> Type:
  {n1.ish(T.num.go(tt, T.Num{T.NBase{}, sg, n1.rb(rx), ds, True{}, True{}, ""}), sd) == Bool.and(Bool.not(sd),
    n1.bg(tt, rx)) : Bool}

# the character after a digit of a prefixed integer
def n1.Bi.go(
  uu: Bool,
  ok: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +sd: Bool,
  +eu: {Char.is_eq(cc, '_') == uu : Bool},
  +eo: {T.dig.ok(T.dig.val(cc), n1.rb(rx)) == ok : Bool},
  ihd: n1.Bi.G(tt, sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(cc)), sd),
  ihu: n1.Bi.go.P1(tt, sg, rx, ds, sd)
) -> {n1.ish(T.num.go(tt, T.num.based.go(uu, n1.sb(sg, rx, ds), cc)), sd)
  == Bool.and(Bool.not(sd), Laws.abnf.radix_rep(cc <> tt, rx)) : Bool}:
  match uu:
    case True{}:
      %Equal.sym(Char, cc, '_', Eq.char_eq_true(cc, '_', eu)) : {n1.ish(T.num.go(tt, T.Num{T.NBase{}, sg, n1.rb(rx),
        ds, True{}, True{}, ""}), sd) == Bool.and(Bool.not(sd), Laws.abnf.radix_rep(_ <> tt, rx)) : Bool}
      %n1.rrep.u(rx, tt) : {n1.ish(T.num.go(tt, T.Num{T.NBase{}, sg, n1.rb(rx), ds, True{}, True{}, ""}), sd)
        == Bool.and(Bool.not(sd), _) : Bool}
      ihu
    case False{}:
      match ok:
        case True{}:
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), n1.rb(rx)), True{}, eo) : {n1.ish(T.num.go(tt, T.num.digit.ok(_, cc,
            T.NBase{}, sg, n1.rb(rx), ds)), sd) == Bool.and(Bool.not(sd), Laws.abnf.radix_rep(cc <> tt, rx)) : Bool}
          %n1.rrep.d(rx, cc, tt, n1.cls.t(rx, cc, eo)) : {n1.ish(T.num.go(tt, n1.sb(sg, rx, T.dec.go(ds, n1.rb(rx),
            T.dig.val(cc)))), sd) == Bool.and(Bool.not(sd), _) : Bool}
          ihd
        case False{}:
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), n1.rb(rx)), False{}, eo) : {n1.ish(T.num.go(tt, T.num.digit.ok(_,
            cc, T.NBase{}, sg, n1.rb(rx), ds)), sd) == Bool.and(Bool.not(sd), Laws.abnf.radix_rep(cc <> tt, rx)) : Bool}
          %n1.rrep.n(rx, cc, tt, n1.cls.f(rx, cc, eo), eu) : {n1.ish(T.num.go(tt, T.num.bad(T.Num{T.NLead{}, T.Plus{},
            10, [], False{}, False{}, ""}, "invalid digit")), sd) == Bool.and(Bool.not(sd), _) : Bool}
          %Equal.sym(Bool, Bool.and(Bool.not(sd), False{}), False{}, gs.andf(Bool.not(sd))) : {n1.ish(T.num.go(tt,
            T.num.bad(T.Num{T.NLead{}, T.Plus{}, 10, [], False{}, False{},
            ""}, "invalid digit")), sd) == _ : Bool}
          n1.ish.bad(tt, sd, "invalid digit")

# after a digit of a prefixed integer, the scan finishes as an integer
# exactly when the rest is the radix's repetition and no sign came first
def n1.Bi(
  rest: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +ds: List<&2, U32>,
  +sd: Bool
) -> n1.Bi.G(rest, sg, rx, ds, sd):
  match rest:
    case []:
      match sd:
        case True{}:
          {==}
        case False{}:
          {==}
    case +hh <> tt:
      match tt:
        case []:
          n1.Bi.go(Char.is_eq(hh, '_'), T.dig.ok(T.dig.val(hh), n1.rb(rx)), hh, [], sg, rx, ds, sd, {==}, {==},
            n1.Bi([], sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(hh)), sd), Equal.sym(Bool, Bool.and(Bool.not(sd),
            False{}), False{}, gs.andf(Bool.not(sd))))
        case +h2 <> +t2:
          n1.Bi.go(Char.is_eq(hh, '_'), T.dig.ok(T.dig.val(hh), n1.rb(rx)), hh, h2 <> t2, sg, rx, ds, sd, {==}, {==},
            n1.Bi(h2 <> t2, sg, rx, T.dec.go(ds, n1.rb(rx), T.dig.val(hh)), sd),
            n1.Bui(h2, t2, sg, rx, ds, True{}, True{}, "", sd, {==}, n1.Bi(t2, sg, rx, T.dec.go(ds, n1.rb(rx),
              T.dig.val(h2)), sd)))

# after a prefix, the scan finishes as an integer exactly when a digit of the
# radix and the repetition follow and no sign came first
def n1.B0(
  rest: List<&2, Char>,
  +sg: T.Sign,
  +rx: Laws.ARadix,
  +sd: Bool
) -> {n1.ish(T.num.go(rest, T.Num{T.NBase{}, sg, n1.rb(rx), [], False{}, False{}, ""}), sd)
  == Bool.and(Bool.not(sd), n1.bg(rest, rx)) : Bool}:
  match rest:
    case []:
      Equal.sym(Bool, Bool.and(Bool.not(sd), False{}), False{}, gs.andf(Bool.not(sd)))
    case +hh <> +tt:
      n1.Bui(hh, tt, sg, rx, [], False{}, False{}, "", sd, {==}, n1.Bi(tt, sg, rx, T.dec.go([], n1.rb(rx),
        T.dig.val(hh)), sd))

# The leading zero, the sign and the start, for integers.

# the prefixed integers a word 0 and the rest can be
def n1.pfx(+rest: List<&2, Char>) -> Bool:
  Bool.or(Laws.abnf.hex_int('0' <> rest), Bool.or(Laws.abnf.oct_int('0' <> rest), Laws.abnf.bin_int('0' <> rest)))

# 0x and the rest is a hex-int exactly when a hex digit and the repetition
# follow
def n1.pfx.x(tt: List<&2, Char>) -> {n1.bg(tt, Laws.AHex{}) == n1.pfx('x' <> tt) : Bool}:
  match tt:
    case []:
      {==}
    case +c2 <> +rr:
      n1.orf.eq(n1.bg(c2 <> rr, Laws.AHex{}), n1.bg(c2 <> rr, Laws.AHex{}), {==})

# 0o and the rest is an oct-int exactly when an octal digit and the
# repetition follow
def n1.pfx.o(tt: List<&2, Char>) -> {n1.bg(tt, Laws.AOct{}) == n1.pfx('o' <> tt) : Bool}:
  match tt:
    case []:
      {==}
    case +c2 <> +rr:
      n1.orf.eq(n1.bg(c2 <> rr, Laws.AOct{}), n1.bg(c2 <> rr, Laws.AOct{}), {==})

# 0b and the rest is a bin-int exactly when a binary digit and the
# repetition follow
def n1.pfx.b(tt: List<&2, Char>) -> {n1.bg(tt, Laws.ABin{}) == n1.pfx('b' <> tt) : Bool}:
  match tt:
    case []:
      {==}
    case _c <> _r:
      {==}

# a character's test against the code point nn, as the grammar and the code
# write it
def n1.cp(+cc: Char, +nn: U32) -> {Char.is_eq(cc, Chr{nn}) == Laws.abnf.cp(cc, nn) : Bool}:
  match cc:
    case Chr{+cp}:
      {==}

# 0 and a character that is no x, o or b starts no prefixed integer
def n1.pfx.n(
  +cc: Char,
  tt: List<&2, Char>,
  +hx: {Char.is_eq(cc, 'x') == False{} : Bool},
  +ho: {Char.is_eq(cc, 'o') == False{} : Bool},
  +hb: {Char.is_eq(cc, 'b') == False{} : Bool}
) -> {False{} == n1.pfx(cc <> tt) : Bool}:
  match tt:
    case []:
      {==}
    case +c2 <> +rr:
      %Equal.trans(Bool, False{}, Char.is_eq(cc, 'x'), Laws.abnf.cp(cc, 120), Equal.sym(Bool, Char.is_eq(cc, 'x'),
        False{}, hx), n1.cp(cc, 120)) : {False{} == Bool.or(Bool.and(True{}, Bool.and(_,
        Bool.and(Laws.abnf.HEXDIG(c2), Laws.abnf.radix_rep(rr, Laws.AHex{})))), Bool.or(Laws.abnf.oct_int('0' <> cc <>
        c2 <> rr), Laws.abnf.bin_int('0' <> cc <> c2 <> rr))) : Bool}
      %Equal.trans(Bool, False{}, Char.is_eq(cc, 'o'), Laws.abnf.cp(cc, 111), Equal.sym(Bool, Char.is_eq(cc, 'o'),
        False{}, ho), n1.cp(cc, 111)) : {False{} == Bool.or(False{}, Bool.or(Bool.and(True{}, Bool.and(_,
        Bool.and(Laws.abnf.digit0_7(c2), Laws.abnf.radix_rep(rr, Laws.AOct{})))), Laws.abnf.bin_int('0' <> cc <> c2 <>
        rr))) : Bool}
      %Equal.trans(Bool, False{}, Char.is_eq(cc, 'b'), Laws.abnf.cp(cc, 98), Equal.sym(Bool, Char.is_eq(cc, 'b'),
        False{}, hb), n1.cp(cc, 98)) : {False{} == Bool.or(False{}, Bool.or(False{}, Bool.and(True{}, Bool.and(_,
        Bool.and(Laws.abnf.digit0_1(c2), Laws.abnf.radix_rep(rr, Laws.ABin{})))))) : Bool}
      {==}

# what the leading zero lemma claims for integers
def n1.Zi.G(+rest: List<&2, Char>, +sg: T.Sign, +sd: Bool) -> Type:
  {n1.ish(T.num.go(rest, n1.sz(sg)), sd) == Bool.or(Laws.abnf.unsigned_dec_int('0' <> rest), Bool.and(Bool.not(sd),
    n1.pfx(rest))) : Bool}

# after a leading zero, a character that starts no prefix holds no integer
def n1.Zi.no(
  +cc: Char,
  +tt: List<&2, Char>,
  +st: T.Num,
  +sd: Bool,
  hl: {n1.ish(T.num.go(tt, st), sd) == False{} : Bool},
  +hx: {Char.is_eq(cc, 'x') == False{} : Bool},
  +ho: {Char.is_eq(cc, 'o') == False{} : Bool},
  +hb: {Char.is_eq(cc, 'b') == False{} : Bool}
) -> {n1.ish(T.num.go(tt, st), sd) == Bool.or(Laws.abnf.unsigned_dec_int('0' <> cc <> tt), Bool.and(Bool.not(sd),
  n1.pfx(cc <> tt))) : Bool}:
  %n1.pfx.n(cc, tt, hx, ho, hb) : {n1.ish(T.num.go(tt, st), sd) == Bool.or(False{}, Bool.and(Bool.not(sd), _)) : Bool}
  %Equal.sym(Bool, Bool.and(Bool.not(sd), False{}), False{}, gs.andf(Bool.not(sd))) : {n1.ish(T.num.go(tt, st), sd)
    == Bool.or(False{}, _) : Bool}
  hl

# the type of n1.Zi.go's ihx
def n1.Zi.go.P1(+tt: List<&2, Char>, +sg: T.Sign, +sd: Bool) -> Type:
  {n1.ish(T.num.go(tt, T.Num{T.NBase{}, sg, 16, [], False{}, False{}, ""}), sd) == Bool.and(Bool.not(sd), n1.bg(tt,
    Laws.AHex{})) : Bool}

# the type of n1.Zi.go's iho
def n1.Zi.go.P2(+tt: List<&2, Char>, +sg: T.Sign, +sd: Bool) -> Type:
  {n1.ish(T.num.go(tt, T.Num{T.NBase{}, sg, 8, [], False{}, False{}, ""}), sd) == Bool.and(Bool.not(sd), n1.bg(tt,
    Laws.AOct{})) : Bool}

# the type of n1.Zi.go's ihb
def n1.Zi.go.P3(+tt: List<&2, Char>, +sg: T.Sign, +sd: Bool) -> Type:
  {n1.ish(T.num.go(tt, T.Num{T.NBase{}, sg, 2, [], False{}, False{}, ""}), sd) == Bool.and(Bool.not(sd), n1.bg(tt,
    Laws.ABin{})) : Bool}

# the character after a leading zero, for integers
def n1.Zi.go(
  xx: Bool,
  oo: Bool,
  bb: Bool,
  pp: Bool,
  e1: Bool,
  e2: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +sd: Bool,
  +exx: {Char.is_eq(cc, 'x') == xx : Bool},
  +eoo: {Char.is_eq(cc, 'o') == oo : Bool},
  +ebb: {Char.is_eq(cc, 'b') == bb : Bool},
  ihx: n1.Zi.go.P1(tt, sg, sd),
  iho: n1.Zi.go.P2(tt, sg, sd),
  ihb: n1.Zi.go.P3(tt, sg, sd)
) -> {n1.ish(T.num.go(tt, T.num.zero.go(xx, oo, bb, pp, e1, e2, n1.sz(sg), cc)), sd) == Bool.or(
  Laws.abnf.unsigned_dec_int('0' <> cc <> tt), Bool.and(Bool.not(sd), n1.pfx(cc <> tt))) : Bool}:
  match xx:
    case True{}:
      %Equal.sym(Char, cc, 'x', Eq.char_eq_true(cc, 'x', exx)) : {n1.ish(T.num.go(tt, T.num.base(n1.sz(sg), 16)), sd)
        == Bool.or(Laws.abnf.unsigned_dec_int('0' <> _ <> tt), Bool.and(Bool.not(sd), n1.pfx(_ <> tt))) : Bool}
      %n1.pfx.x(tt) : {n1.ish(T.num.go(tt, T.num.base(n1.sz(sg), 16)), sd) == Bool.and(Bool.not(sd), _) : Bool}
      ihx
    case False{}:
      match oo:
        case True{}:
          %Equal.sym(Char, cc, 'o', Eq.char_eq_true(cc, 'o', eoo)) : {n1.ish(T.num.go(tt, T.num.base(n1.sz(sg), 8)), sd)
            == Bool.or(Laws.abnf.unsigned_dec_int('0' <> _ <> tt), Bool.and(Bool.not(sd), n1.pfx(_ <> tt))) : Bool}
          %n1.pfx.o(tt) : {n1.ish(T.num.go(tt, T.num.base(n1.sz(sg), 8)), sd) == Bool.and(Bool.not(sd), _) : Bool}
          iho
        case False{}:
          match bb:
            case True{}:
              %Equal.sym(Char, cc, 'b', Eq.char_eq_true(cc, 'b', ebb)) : {n1.ish(T.num.go(tt, T.num.base(n1.sz(sg), 2)),
                sd) == Bool.or(Laws.abnf.unsigned_dec_int('0' <> _ <> tt), Bool.and(Bool.not(sd), n1.pfx(_ <> tt)))
                : Bool}
              %n1.pfx.b(tt) : {n1.ish(T.num.go(tt, T.num.base(n1.sz(sg), 2)), sd) == Bool.and(Bool.not(sd), _) : Bool}
              ihb
            case False{}:
              match pp:
                case True{}:
                  n1.Zi.no(cc, tt, n1.sf0(sg), sd, n1.fcls(tt, n1.sf0(sg), sd, {==}), exx, eoo, ebb)
                case False{}:
                  match e1:
                    case True{}:
                      n1.Zi.no(cc, tt, n1.se(sg), sd, n1.fcls(tt, n1.se(sg), sd, {==}), exx, eoo, ebb)
                    case False{}:
                      match e2:
                        case True{}:
                          n1.Zi.no(cc, tt, n1.se(sg), sd, n1.fcls(tt, n1.se(sg), sd, {==}), exx, eoo, ebb)
                        case False{}:
                          n1.Zi.no(cc, tt, T.num.bad(n1.sz(sg), "invalid number"), sd, n1.ish.bad(tt, sd,
                            "invalid number"), exx, eoo, ebb)

# after a leading zero, the scan finishes as an integer exactly when nothing
# follows, or a prefix and its digits follow and no sign came first
def n1.Zi(rest: List<&2, Char>, +sg: T.Sign, +sd: Bool) -> n1.Zi.G(rest, sg, sd):
  match rest:
    case []:
      {==}
    case +hh <> +tt:
      n1.Zi.go(Char.is_eq(hh, 'x'), Char.is_eq(hh, 'o'), Char.is_eq(hh, 'b'), Char.is_eq(hh, '.'), Char.is_eq(hh, 'e'),
        Char.is_eq(hh, 'E'), hh, tt, sg, sd, {==}, {==}, {==}, n1.B0(tt, sg, Laws.AHex{}, sd),
        n1.B0(tt, sg, Laws.AOct{}, sd), n1.B0(tt, sg, Laws.ABin{}, sd))

# the first character of an unsigned numeral after a sign, for integers
def n1.Si2.go(
  zz: Bool,
  dd: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ez: {Char.is_eq(cc, '0') == zz : Bool},
  +ed: {Char.is_digit(cc) == dd : Bool},
  ihz: n1.Zi.G(tt, sg, True{}),
  ihd: n1.Di.G(tt, sg, T.dec.go([], 10, T.dig.val(cc)), "", True{})
) -> {n1.ish(T.num.go(tt, T.num.lead.go(False{}, False{}, zz, dd, n1.sl(sg), cc)), True{})
  == Laws.abnf.unsigned_dec_int(cc <> tt) : Bool}:
  match zz:
    case True{}:
      %Equal.sym(Char, cc, '0', Eq.char_eq_true(cc, '0', ez)) : {n1.ish(T.num.go(tt, n1.sz(sg)), True{})
        == Laws.abnf.unsigned_dec_int(_ <> tt) : Bool}
      Equal.trans(Bool, n1.ish(T.num.go(tt, n1.sz(sg)), True{}), Bool.or(Laws.abnf.unsigned_dec_int('0' <> tt),
        False{}), Laws.abnf.unsigned_dec_int('0' <> tt), ihz, n1.orf(Laws.abnf.unsigned_dec_int('0' <> tt)))
    case False{}:
      match dd:
        case True{}:
          %n1.udi.d(cc, tt, n1.d19.y(cc, ed, ez)) : {n1.ish(T.num.go(tt, T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10),
            cc, T.NDig{}, sg, 10, [])), True{}) == _ : Bool}
          %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.ish(T.num.go(tt,
            T.num.digit.ok(_, cc, T.NDig{}, sg, 10, [])), True{}) == Laws.abnf.dec_rep(tt) : Bool}
          ihd
        case False{}:
          %n1.udi.n(cc, tt, ed) : {n1.ish(T.num.go(tt, T.num.bad(n1.sl(sg), "invalid number")), True{}) == _ : Bool}
          n1.ish.bad(tt, True{}, "invalid number")

# the character after a sign, for integers: a second sign fails
def n1.Si.go(
  pp: Bool,
  mm: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +sg: T.Sign,
  +ep: {Char.is_eq(cc, '+') == pp : Bool},
  +em: {Char.is_eq(cc, '-') == mm : Bool},
  ihz: n1.Zi.G(tt, sg, True{}),
  ihd: n1.Di.G(tt, sg, T.dec.go([], 10, T.dig.val(cc)), "", True{})
) -> {n1.ish(T.num.go(tt, T.num.after.sign.go(Bool.or(pp, mm), sg, cc)), True{})
  == Laws.abnf.unsigned_dec_int(cc <> tt) : Bool}:
  match pp:
    case True{}:
      %Equal.sym(Char, cc, '+', Eq.char_eq_true(cc, '+', ep)) : {n1.ish(T.num.go(tt, T.num.bad(T.num.start(),
        "invalid number")), True{}) == Laws.abnf.unsigned_dec_int(_ <> tt) : Bool}
      %n1.udi.n('+', tt, {==}) : {n1.ish(T.num.go(tt, T.num.bad(T.num.start(), "invalid number")), True{}) == _ : Bool}
      n1.ish.bad(tt, True{}, "invalid number")
    case False{}:
      match mm:
        case True{}:
          %Equal.sym(Char, cc, '-', Eq.char_eq_true(cc, '-', em)) : {n1.ish(T.num.go(tt, T.num.bad(T.num.start(),
            "invalid number")), True{}) == Laws.abnf.unsigned_dec_int(_ <> tt) : Bool}
          %n1.udi.n('-', tt, {==}) : {n1.ish(T.num.go(tt, T.num.bad(T.num.start(), "invalid number")), True{}) == _
            : Bool}
          n1.ish.bad(tt, True{}, "invalid number")
        case False{}:
          %Equal.sym(Bool, Char.is_eq(cc, '+'), False{}, ep) : {n1.ish(T.num.go(tt, T.num.lead.go(_,
            Char.is_eq(cc, '-'), Char.is_eq(cc, '0'), Char.is_digit(cc), n1.sl(sg), cc)), True{})
            == Laws.abnf.unsigned_dec_int(cc <> tt) : Bool}
          %Equal.sym(Bool, Char.is_eq(cc, '-'), False{}, em) : {n1.ish(T.num.go(tt, T.num.lead.go(False{}, _,
            Char.is_eq(cc, '0'), Char.is_digit(cc), n1.sl(sg), cc)), True{}) == Laws.abnf.unsigned_dec_int(cc <> tt)
            : Bool}
          n1.Si2.go(Char.is_eq(cc, '0'), Char.is_digit(cc), cc, tt, sg, {==}, {==}, ihz, ihd)

# after a sign, the scan finishes as an integer exactly when the rest is an
# unsigned-dec-int
def n1.Si(
  rest: List<&2, Char>,
  +sg: T.Sign
) -> {n1.ish(T.num.go(rest, n1.ss(sg)), True{}) == Laws.abnf.unsigned_dec_int(rest) : Bool}:
  match rest:
    case []:
      {==}
    case +hh <> +tt:
      n1.Si.go(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), hh, tt, sg, {==}, {==}, n1.Zi(tt, sg, True{}),
        n1.Di(tt, sg, T.dec.go([], 10, T.dig.val(hh)), "", True{}))

# no prefixed integer starts with a character that is no 0
def n1.pre.n0(
  +cc: Char,
  tt: List<&2, Char>,
  +ll: U32,
  +rx: Laws.ARadix,
  +h0: {Char.is_eq(cc, '0') == False{} : Bool}
) -> {False{} == Laws.abnf.prefixed(cc <> tt, ll, rx) : Bool}:
  match tt:
    case []:
      {==}
    case +c1 <> rr:
      match rr:
        case []:
          {==}
        case +c2 <> +r2:
          %Equal.trans(Bool, False{}, Char.is_eq(cc, '0'), Laws.abnf.cp(cc, 48), Equal.sym(Bool, Char.is_eq(cc, '0'),
            False{}, h0), n1.cp(cc, 48)) : {False{} == Bool.and(_, Bool.and(Laws.abnf.cp(c1, ll),
            Bool.and(Laws.abnf.radix_digit(rx, c2), Laws.abnf.radix_rep(r2, rx)))) : Bool}
          {==}

# a sign and an unsigned-dec-int are an integer, and nothing else after a
# sign is
def n1.int.sgn(
  +cc: Char,
  +tt: List<&2, Char>,
  hd: {Char.is_digit(cc) == False{} : Bool},
  +h0: {Char.is_eq(cc, '0') == False{} : Bool},
  hs: {Bool.or(Laws.abnf.minus(cc), Laws.abnf.plus(cc)) == True{} : Bool}
) -> {Laws.abnf.unsigned_dec_int(tt) == Laws.abnf.integer(cc <> tt) : Bool}:
  %Equal.sym(Bool, Bool.or(Laws.abnf.minus(cc), Laws.abnf.plus(cc)), True{}, hs) : {Laws.abnf.unsigned_dec_int(tt)
    == Bool.or(Bool.or(Bool.and(_, Laws.abnf.unsigned_dec_int(tt)), Laws.abnf.unsigned_dec_int(cc <> tt)),
    Bool.or(Laws.abnf.hex_int(cc <> tt), Bool.or(Laws.abnf.oct_int(cc <> tt), Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.udi.n(cc, tt, hd) : {Laws.abnf.unsigned_dec_int(tt) == Bool.or(Bool.or(Laws.abnf.unsigned_dec_int(tt), _),
    Bool.or(Laws.abnf.hex_int(cc <> tt), Bool.or(Laws.abnf.oct_int(cc <> tt), Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 120, Laws.AHex{}, h0) : {Laws.abnf.unsigned_dec_int(tt) == Bool.or(Bool.or(
    Laws.abnf.unsigned_dec_int(tt), False{}), Bool.or(_, Bool.or(Laws.abnf.oct_int(cc <> tt), Laws.abnf.bin_int(cc <>
    tt)))) : Bool}
  %n1.pre.n0(cc, tt, 111, Laws.AOct{}, h0) : {Laws.abnf.unsigned_dec_int(tt) == Bool.or(Bool.or(
    Laws.abnf.unsigned_dec_int(tt), False{}), Bool.or(False{}, Bool.or(_, Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 98, Laws.ABin{}, h0) : {Laws.abnf.unsigned_dec_int(tt) == Bool.or(Bool.or(
    Laws.abnf.unsigned_dec_int(tt), False{}), Bool.or(False{}, Bool.or(False{}, _))) : Bool}
  %Equal.sym(Bool, Bool.or(Laws.abnf.unsigned_dec_int(tt), False{}), Laws.abnf.unsigned_dec_int(tt),
    n1.orf(Laws.abnf.unsigned_dec_int(tt))) : {Laws.abnf.unsigned_dec_int(tt) == Bool.or(_, False{}) : Bool}
  n1.orf.eq(Laws.abnf.unsigned_dec_int(tt), Laws.abnf.unsigned_dec_int(tt), {==})

# a digit that is not 0 and the repetition are an integer
def n1.int.dig(
  +cc: Char,
  +tt: List<&2, Char>,
  +hd: {Char.is_digit(cc) == True{} : Bool},
  +h0: {Char.is_eq(cc, '0') == False{} : Bool},
  em: {False{} == Laws.abnf.minus(cc) : Bool},
  ep: {False{} == Laws.abnf.plus(cc) : Bool}
) -> {Laws.abnf.dec_rep(tt) == Laws.abnf.integer(cc <> tt) : Bool}:
  %em : {Laws.abnf.dec_rep(tt) == Bool.or(Bool.or(Bool.and(Bool.or(_, Laws.abnf.plus(cc)),
    Laws.abnf.unsigned_dec_int(tt)), Laws.abnf.unsigned_dec_int(cc <> tt)), Bool.or(Laws.abnf.hex_int(cc <> tt),
    Bool.or(Laws.abnf.oct_int(cc <> tt), Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %ep : {Laws.abnf.dec_rep(tt) == Bool.or(Bool.or(Bool.and(Bool.or(False{}, _), Laws.abnf.unsigned_dec_int(tt)),
    Laws.abnf.unsigned_dec_int(cc <> tt)), Bool.or(Laws.abnf.hex_int(cc <> tt), Bool.or(Laws.abnf.oct_int(cc <> tt),
    Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.udi.d(cc, tt, n1.d19.y(cc, hd, h0)) : {Laws.abnf.dec_rep(tt) == Bool.or(Bool.or(False{}, _),
    Bool.or(Laws.abnf.hex_int(cc <> tt), Bool.or(Laws.abnf.oct_int(cc <> tt), Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 120, Laws.AHex{}, h0) : {Laws.abnf.dec_rep(tt) == Bool.or(Laws.abnf.dec_rep(tt), Bool.or(_,
    Bool.or(Laws.abnf.oct_int(cc <> tt), Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 111, Laws.AOct{}, h0) : {Laws.abnf.dec_rep(tt) == Bool.or(Laws.abnf.dec_rep(tt), Bool.or(False{},
    Bool.or(_, Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 98, Laws.ABin{}, h0) : {Laws.abnf.dec_rep(tt) == Bool.or(Laws.abnf.dec_rep(tt), Bool.or(False{},
    Bool.or(False{}, _))) : Bool}
  n1.orf.eq(Laws.abnf.dec_rep(tt), Laws.abnf.dec_rep(tt), {==})

# a first character that is no sign, no digit is no integer
def n1.int.no(
  +cc: Char,
  +tt: List<&2, Char>,
  hd: {Char.is_digit(cc) == False{} : Bool},
  +h0: {Char.is_eq(cc, '0') == False{} : Bool},
  em: {False{} == Laws.abnf.minus(cc) : Bool},
  ep: {False{} == Laws.abnf.plus(cc) : Bool}
) -> {False{} == Laws.abnf.integer(cc <> tt) : Bool}:
  %em : {False{} == Bool.or(Bool.or(Bool.and(Bool.or(_, Laws.abnf.plus(cc)), Laws.abnf.unsigned_dec_int(tt)),
    Laws.abnf.unsigned_dec_int(cc <> tt)), Bool.or(Laws.abnf.hex_int(cc <> tt), Bool.or(Laws.abnf.oct_int(cc <> tt),
    Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %ep : {False{} == Bool.or(Bool.or(Bool.and(Bool.or(False{}, _), Laws.abnf.unsigned_dec_int(tt)),
    Laws.abnf.unsigned_dec_int(cc <> tt)), Bool.or(Laws.abnf.hex_int(cc <> tt), Bool.or(Laws.abnf.oct_int(cc <> tt),
    Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.udi.n(cc, tt, hd) : {False{} == Bool.or(Bool.or(False{}, _), Bool.or(Laws.abnf.hex_int(cc <> tt),
    Bool.or(Laws.abnf.oct_int(cc <> tt), Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 120, Laws.AHex{}, h0) : {False{} == Bool.or(False{}, Bool.or(_, Bool.or(Laws.abnf.oct_int(cc <>
    tt), Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 111, Laws.AOct{}, h0) : {False{} == Bool.or(False{}, Bool.or(False{}, Bool.or(_,
    Laws.abnf.bin_int(cc <> tt)))) : Bool}
  %n1.pre.n0(cc, tt, 98, Laws.ABin{}, h0) : {False{} == Bool.or(False{}, Bool.or(False{}, Bool.or(False{}, _)))
    : Bool}
  {==}

# a first character that is no sign and no zero, for integers
def n1.Li2.go(
  dd: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +ez: {Char.is_eq(cc, '0') == False{} : Bool},
  +ed: {Char.is_digit(cc) == dd : Bool},
  +fm: {False{} == Laws.abnf.minus(cc) : Bool},
  +fp: {False{} == Laws.abnf.plus(cc) : Bool},
  ihd: n1.Di.G(tt, T.Plus{}, T.dec.go([], 10, T.dig.val(cc)), "", False{})
) -> {n1.ish(T.num.go(tt, T.num.lead.go(False{}, False{}, False{}, dd, T.num.start(), cc)), False{})
  == Laws.abnf.integer(cc <> tt) : Bool}:
  match dd:
    case True{}:
      %n1.int.dig(cc, tt, ed, ez, fm, fp) : {n1.ish(T.num.go(tt, T.num.digit.ok(T.dig.ok(T.dig.val(cc), 10), cc,
        T.NDig{}, T.Plus{}, 10, [])), False{}) == _ : Bool}
      %Equal.sym(Bool, T.dig.ok(T.dig.val(cc), 10), True{}, n1.dok10(cc, ed)) : {n1.ish(T.num.go(tt,
        T.num.digit.ok(_, cc, T.NDig{}, T.Plus{}, 10, [])), False{}) == Laws.abnf.dec_rep(tt) : Bool}
      ihd
    case False{}:
      %n1.int.no(cc, tt, ed, ez, fm, fp) : {n1.ish(T.num.go(tt, T.num.bad(T.num.start(), "invalid number")), False{})
        == _ : Bool}
      n1.ish.bad(tt, False{}, "invalid number")

# the first character of a word, for integers
def n1.Li.go(
  pp: Bool,
  mm: Bool,
  zz: Bool,
  dd: Bool,
  +cc: Char,
  +tt: List<&2, Char>,
  +ep: {Char.is_eq(cc, '+') == pp : Bool},
  +em: {Char.is_eq(cc, '-') == mm : Bool},
  +ez: {Char.is_eq(cc, '0') == zz : Bool},
  +ed: {Char.is_digit(cc) == dd : Bool},
  ihp: {n1.ish(T.num.go(tt, n1.ss(T.Plus{})), True{}) == Laws.abnf.unsigned_dec_int(tt) : Bool},
  ihm: {n1.ish(T.num.go(tt, n1.ss(T.Minus{})), True{}) == Laws.abnf.unsigned_dec_int(tt) : Bool},
  ihz: n1.Zi.G(tt, T.Plus{}, False{}),
  ihd: n1.Di.G(tt, T.Plus{}, T.dec.go([], 10, T.dig.val(cc)), "", False{})
) -> {n1.ish(T.num.go(tt, T.num.lead.go(pp, mm, zz, dd, T.num.start(), cc)), Bool.or(pp, mm))
  == Laws.abnf.integer(cc <> tt) : Bool}:
  match pp:
    case True{}:
      %Equal.sym(Char, cc, '+', Eq.char_eq_true(cc, '+', ep)) : {n1.ish(T.num.go(tt, n1.ss(T.Plus{})), True{})
        == Laws.abnf.integer(_ <> tt) : Bool}
      %n1.int.sgn('+', tt, {==}, {==}, {==}) : {n1.ish(T.num.go(tt, n1.ss(T.Plus{})), True{}) == _ : Bool}
      ihp
    case False{}:
      match mm:
        case True{}:
          %Equal.sym(Char, cc, '-', Eq.char_eq_true(cc, '-', em)) : {n1.ish(T.num.go(tt, n1.ss(T.Minus{})), True{})
            == Laws.abnf.integer(_ <> tt) : Bool}
          %n1.int.sgn('-', tt, {==}, {==}, {==}) : {n1.ish(T.num.go(tt, n1.ss(T.Minus{})), True{}) == _ : Bool}
          ihm
        case False{}:
          match zz:
            case True{}:
              %Equal.sym(Char, cc, '0', Eq.char_eq_true(cc, '0', ez)) : {n1.ish(T.num.go(tt, n1.sz(T.Plus{})), False{})
                == Laws.abnf.integer(_ <> tt) : Bool}
              ihz
            case False{}:
              n1.Li2.go(dd, cc, tt, ez, ed, Equal.trans(Bool, False{}, Char.is_eq(cc, '-'), Laws.abnf.minus(cc),
                Equal.sym(Bool, Char.is_eq(cc, '-'), False{}, em), n1.minus(cc)), Equal.trans(Bool, False{},
                Char.is_eq(cc, '+'), Laws.abnf.plus(cc), Equal.sym(Bool, Char.is_eq(cc, '+'), False{}, ep),
                n1.plus(cc)), ihd)

# the numeral scan finishes as an integer, or one out of range, exactly when
# the word matches toml.abnf's integer rule
def n1.int.sh(
  cs: List<&2, Char>
) -> {n1.ish(T.num.go(cs, T.num.start()), T.num.signed(cs)) == Laws.abnf.integer(cs) : Bool}:
  match cs:
    case []:
      {==}
    case +hh <> +tt:
      n1.Li.go(Char.is_eq(hh, '+'), Char.is_eq(hh, '-'), Char.is_eq(hh, '0'), Char.is_digit(hh), hh, tt, {==}, {==},
        {==}, {==}, n1.Si(tt, T.Plus{}), n1.Si(tt, T.Minus{}), n1.Zi(tt, T.Plus{}, False{}),
        n1.Di(tt, T.Plus{}, T.dec.go([], 10, T.dig.val(hh)), "", False{}))

# Arithmetic. An integer's value is a Nat, compared and never computed: every
# Nat here stays symbolic, and a large constant is reached only through a
# lemma stated for any Nat.

# a times zero is zero
def n1.mul0(aa: Nat) -> {Nat.mul(aa, 0n) == 0n : Nat}:
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      n1.mul0(pp)

# a times one more than b is a and a times b
def n1.muls(aa: Nat, +bb: Nat) -> {Nat.mul(aa, 1n+bb) == Nat.add(aa, Nat.mul(aa, bb)) : Nat}:
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      %Equal.sym(Nat, Nat.mul(pp, 1n+bb), Nat.add(pp, Nat.mul(pp, bb)), n1.muls(pp, bb)) : {1n+Nat.add(bb, _)
        == 1n+Nat.add(pp, Nat.add(bb, Nat.mul(pp, bb))) : Nat}
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(bb, Nat.add(pp, Nat.mul(pp, bb))), Nat.add(pp, Nat.add(bb,
        Nat.mul(pp, bb))), Ar.nat_add_lcomm(bb, pp, Nat.mul(pp, bb)))

# multiplication commutes
def n1.mulc(aa: Nat, +bb: Nat) -> {Nat.mul(aa, bb) == Nat.mul(bb, aa) : Nat}:
  match aa:
    case 0n:
      Equal.sym(Nat, Nat.mul(bb, 0n), 0n, n1.mul0(bb))
    case 1n+(+pp):
      %Equal.sym(Nat, Nat.mul(pp, bb), Nat.mul(bb, pp), n1.mulc(pp, bb)) : {Nat.add(bb, _) == Nat.mul(bb, 1n+pp) : Nat}
      Equal.sym(Nat, Nat.mul(bb, 1n+pp), Nat.add(bb, Nat.mul(bb, pp)), n1.muls(bb, pp))

# a common left addend leaves a comparison as it is
def n1.cmp.add(mm: Nat, +xx: Nat, +yy: Nat) -> {Nat.cmp(Nat.add(mm, xx), Nat.add(mm, yy)) == Nat.cmp(xx, yy) : Cmp}:
  match mm:
    case 0n:
      {==}
    case 1n+(+pp):
      n1.cmp.add(pp, xx, yy)

# a Nat below another compares LT with it
def n1.cmp.lt(aa: Nat, bb: Nat, hh: {Nat.is_lt(aa, bb) == True{} : Bool}) -> {Nat.cmp(aa, bb) == LT{} : Cmp}:
  match aa bb:
    case 0n 0n:
      Eq.bit.absurd(&2, {Nat.cmp(0n, 0n) == LT{} : Cmp}, hh)
    case 0n 1n+_b:
      {==}
    case 1n+(+a1) 0n:
      Eq.bit.absurd(&2, {Nat.cmp(1n+a1, 0n) == LT{} : Cmp}, hh)
    case 1n+(+a1) 1n+(+b1):
      n1.cmp.lt(a1, b1, hh)

# a Nat above another compares GT with it
def n1.cmp.gt(aa: Nat, bb: Nat, hh: {Nat.is_lt(bb, aa) == True{} : Bool}) -> {Nat.cmp(aa, bb) == GT{} : Cmp}:
  match aa bb:
    case 0n 0n:
      Eq.bit.absurd(&2, {Nat.cmp(0n, 0n) == GT{} : Cmp}, hh)
    case 0n 1n+(+b1):
      Eq.bit.absurd(&2, {Nat.cmp(0n, 1n+b1) == GT{} : Cmp}, hh)
    case 1n+_a 0n:
      {==}
    case 1n+(+a1) 1n+(+b1):
      n1.cmp.gt(a1, b1, hh)

# the ones and the rest: comparing a times M and A with b times M and B, for A
# and B below M, compares a with b and then A with B, as i64.ord folds a
# comparison of digits
def n1.ka(
  aa: Nat,
  bb: Nat,
  +mm: Nat,
  +xa: Nat,
  +xb: Nat,
  +ha: {Nat.is_lt(xa, mm) == True{} : Bool},
  +hb: {Nat.is_lt(xb, mm) == True{} : Bool}
) -> {Nat.cmp(Nat.add(Nat.mul(aa, mm), xa), Nat.add(Nat.mul(bb, mm), xb)) == T.i64.ord(Nat.cmp(aa, bb), Nat.cmp(xa,
  xb)) : Cmp}:
  match aa bb:
    case 0n 0n:
      {==}
    case 0n 1n+(+b1):
      n1.cmp.lt(xa, Nat.add(Nat.add(mm, Nat.mul(b1, mm)), xb), lt.add(xa, Nat.add(mm, Nat.mul(b1, mm)), xb, lt.add(xa,
        mm, Nat.mul(b1, mm), ha)))
    case 1n+(+a1) 0n:
      n1.cmp.gt(Nat.add(Nat.add(mm, Nat.mul(a1, mm)), xa), xb, lt.add(xb, Nat.add(mm, Nat.mul(a1, mm)), xa, lt.add(xb,
        mm, Nat.mul(a1, mm), hb)))
    case 1n+(+a1) 1n+(+b1):
      %Equal.sym(Nat, Nat.add(Nat.add(mm, Nat.mul(a1, mm)), xa), Nat.add(mm, Nat.add(Nat.mul(a1, mm), xa)),
        Ar.nat_add_assoc(mm, Nat.mul(a1, mm), xa)) : {Nat.cmp(_, Nat.add(Nat.add(mm, Nat.mul(b1, mm)), xb))
        == T.i64.ord(Nat.cmp(a1, b1), Nat.cmp(xa, xb)) : Cmp}
      %Equal.sym(Nat, Nat.add(Nat.add(mm, Nat.mul(b1, mm)), xb), Nat.add(mm, Nat.add(Nat.mul(b1, mm), xb)),
        Ar.nat_add_assoc(mm, Nat.mul(b1, mm), xb)) : {Nat.cmp(Nat.add(mm, Nat.add(Nat.mul(a1, mm), xa)), _)
        == T.i64.ord(Nat.cmp(a1, b1), Nat.cmp(xa, xb)) : Cmp}
      Equal.trans(Cmp, Nat.cmp(Nat.add(mm, Nat.add(Nat.mul(a1, mm), xa)), Nat.add(mm, Nat.add(Nat.mul(b1, mm), xb))),
        Nat.cmp(Nat.add(Nat.mul(a1, mm), xa), Nat.add(Nat.mul(b1, mm), xb)), T.i64.ord(Nat.cmp(a1, b1), Nat.cmp(xa,
        xb)), n1.cmp.add(mm, Nat.add(Nat.mul(a1, mm), xa), Nat.add(Nat.mul(b1, mm), xb)), n1.ka(a1, b1, mm, xa, xb,
        ha, hb))

# at most is transitive
def n1.le.trans(
  aa: Nat,
  bb: Nat,
  cc: Nat,
  +h1: {Nat.is_le(aa, bb) == True{} : Bool},
  +h2: {Nat.is_le(bb, cc) == True{} : Bool}
) -> {Nat.is_le(aa, cc) == True{} : Bool}:
  match aa bb cc:
    case 0n _b _c:
      n1.le0(_c)
    case 1n+(+a1) 0n _c:
      Eq.bit.absurd(&2, {Nat.is_le(1n+a1, _c) == True{} : Bool}, h1)
    case 1n+(+a1) 1n+(+b1) 0n:
      Eq.bit.absurd(&2, {Nat.is_le(1n+a1, 0n) == True{} : Bool}, h2)
    case 1n+(+a1) 1n+(+b1) 1n+(+c1):
      n1.le.trans(a1, b1, c1, h1, h2)

# below then at most is below
def n1.lt.le(
  aa: Nat,
  bb: Nat,
  cc: Nat,
  +h1: {Nat.is_lt(aa, bb) == True{} : Bool},
  +h2: {Nat.is_le(bb, cc) == True{} : Bool}
) -> {Nat.is_lt(aa, cc) == True{} : Bool}:
  match aa bb cc:
    case _a 0n _c:
      Eq.bit.absurd(&2, {Nat.is_lt(_a, _c) == True{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(_a, 0n), True{},
        Equal.sym(Bool, Nat.is_lt(_a, 0n), False{}, nlt.zero(_a)), h1))
    case _a 1n+(+b1) 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(_a, 0n) == True{} : Bool}, h2)
    case 0n 1n+(+b1) 1n+(+c1):
      {==}
    case 1n+(+a1) 1n+(+b1) 1n+(+c1):
      n1.lt.le(a1, b1, c1, h1, h2)

# a Nat is at most itself and more
def n1.le.addr(xx: Nat, +yy: Nat) -> {Nat.is_le(xx, Nat.add(xx, yy)) == True{} : Bool}:
  match xx:
    case 0n:
      n1.le0(yy)
    case 1n+(+x1):
      n1.le.addr(x1, yy)

# below b, one more is at most b
def n1.lt.suc(aa: Nat, bb: Nat, hh: {Nat.is_lt(aa, bb) == True{} : Bool}) -> {Nat.is_le(1n+aa, bb) == True{} : Bool}:
  match aa bb:
    case _a 0n:
      Eq.bit.absurd(&2, {Nat.is_le(1n+_a, 0n) == True{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(_a, 0n), True{},
        Equal.sym(Bool, Nat.is_lt(_a, 0n), False{}, nlt.zero(_a)), hh))
    case 0n 1n+(+b1):
      n1.le0(b1)
    case 1n+(+a1) 1n+(+b1):
      n1.lt.suc(a1, b1, hh)

# a times P is at most b times P for a at most b
def n1.le.mul(
  aa: Nat,
  bb: Nat,
  +pp: Nat,
  +hh: {Nat.is_le(aa, bb) == True{} : Bool}
) -> {Nat.is_le(Nat.mul(aa, pp), Nat.mul(bb, pp)) == True{} : Bool}:
  match aa bb:
    case 0n _b:
      n1.le0(Nat.mul(_b, pp))
    case 1n+(+a1) 0n:
      Eq.bit.absurd(&2, {Nat.is_le(Nat.mul(1n+a1, pp), 0n) == True{} : Bool}, hh)
    case 1n+(+a1) 1n+(+b1):
      Equal.trans(Bool, Nat.is_le(Nat.add(pp, Nat.mul(a1, pp)), Nat.add(pp, Nat.mul(b1, pp))),
        Nat.is_le(Nat.mul(a1, pp), Nat.mul(b1, pp)), True{}, Equal.cong(Cmp, Bool, xx => Cmp.is_le(xx),
        Nat.cmp(Nat.add(pp, Nat.mul(a1, pp)), Nat.add(pp, Nat.mul(b1, pp))), Nat.cmp(Nat.mul(a1, pp), Nat.mul(b1, pp)),
        n1.cmp.add(pp, Nat.mul(a1, pp), Nat.mul(b1, pp))), n1.le.mul(a1, b1, pp, hh))

# no underscore among the characters
def n1.nou(xs: List<&2, Char>) -> Bool:
  match xs:
    case []:
      True{}
    case hh <> tt:
      Bool.and(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt))

# every character's value is below r
def n1.dlt(xs: List<&2, Char>, +rr: Nat) -> Bool:
  match xs:
    case []:
      True{}
    case hh <> tt:
      Bool.and(Nat.is_lt(Laws.g.hexdig.val(hh), rr), n1.dlt(tt, rr))

# a character that is no underscore is one more place of the value
def n1.gn.step(
  +hh: Char,
  +tt: List<&2, Char>,
  +rr: Nat,
  +acc: Nat,
  +hu: {Bool.not(Laws.abnf.underscore(hh)) == True{} : Bool}
) -> {Laws.g.num.nat(hh <> tt, rr, acc) == Laws.g.num.nat(tt, rr, Nat.add(Nat.mul(acc, rr), Laws.g.hexdig.val(hh)))
  : Nat}:
  %Equal.sym(Bool, Laws.abnf.underscore(hh), False{}, n1.not.t(Laws.abnf.underscore(hh), hu)) :
    {Laws.g.num.nat(tt, rr, Laws.g.num.nat.step(_, hh, rr, acc)) == Laws.g.num.nat(tt, rr, Nat.add(Nat.mul(acc, rr),
    Laws.g.hexdig.val(hh))) : Nat}
  {==}

# what the value of the digits before contributes: the value from acc is acc
# times the radix to the number of digits, and the value from 0
def n1.hl(
  xs: List<&2, Char>,
  +rr: Nat,
  +acc: Nat,
  +hn: {n1.nou(xs) == True{} : Bool}
) -> {Laws.g.num.nat(xs, rr, acc) == Nat.add(Nat.mul(acc, Nat.pow(rr, List.length(&2, Char, xs))),
  Laws.g.num.nat(xs, rr, 0n)) : Nat}:
  match xs:
    case []:
      %Equal.sym(Nat, Nat.add(Nat.mul(acc, 1n), 0n), Nat.mul(acc, 1n), Ar.nat_add_zero(Nat.mul(acc, 1n))) :
        {acc == _ : Nat}
      Equal.sym(Nat, Nat.mul(acc, 1n), acc, Ar.nat_mul_one(acc))
    case +hh <> +tt:
      +hu = {Eq.and.left(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt), hn) : {Bool.not(Laws.abnf.underscore(hh))
        == True{} : Bool}}
      +ht = {Eq.and.right(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt), hn) : {n1.nou(tt) == True{} : Bool}}
      +dd = Laws.g.hexdig.val(hh)
      +pp = Nat.pow(rr, List.length(&2, Char, tt))
      +gg = Laws.g.num.nat(tt, rr, 0n)
      %Equal.sym(Nat, Laws.g.num.nat(hh <> tt, rr, acc), Laws.g.num.nat(tt, rr, Nat.add(Nat.mul(acc, rr), dd)),
        n1.gn.step(hh, tt, rr, acc, hu)) : {_ == Nat.add(Nat.mul(acc, Nat.mul(rr, pp)), Laws.g.num.nat(hh <> tt, rr,
        0n)) : Nat}
      %Equal.sym(Nat, Laws.g.num.nat(hh <> tt, rr, 0n), Laws.g.num.nat(tt, rr, dd), n1.gn.step(hh, tt, rr, 0n, hu)) :
        {Laws.g.num.nat(tt, rr, Nat.add(Nat.mul(acc, rr), dd)) == Nat.add(Nat.mul(acc, Nat.mul(rr, pp)), _) : Nat}
      %Equal.sym(Nat, Laws.g.num.nat(tt, rr, Nat.add(Nat.mul(acc, rr), dd)), Nat.add(Nat.mul(Nat.add(Nat.mul(acc, rr),
        dd), pp), gg), n1.hl(tt, rr, Nat.add(Nat.mul(acc, rr), dd), ht)) : {_ == Nat.add(Nat.mul(acc, Nat.mul(rr,
        pp)), Laws.g.num.nat(tt, rr, dd)) : Nat}
      %Equal.sym(Nat, Laws.g.num.nat(tt, rr, dd), Nat.add(Nat.mul(dd, pp), gg), n1.hl(tt, rr, dd, ht)) :
        {Nat.add(Nat.mul(Nat.add(Nat.mul(acc, rr), dd), pp), gg) == Nat.add(Nat.mul(acc, Nat.mul(rr, pp)), _) : Nat}
      %Equal.sym(Nat, Nat.mul(Nat.add(Nat.mul(acc, rr), dd), pp), Nat.add(Nat.mul(Nat.mul(acc, rr), pp), Nat.mul(dd,
        pp)), Ar.nat_mul_add_r(Nat.mul(acc, rr), dd, pp)) : {Nat.add(_, gg) == Nat.add(Nat.mul(acc, Nat.mul(rr, pp)),
        Nat.add(Nat.mul(dd, pp), gg)) : Nat}
      %Equal.sym(Nat, Nat.mul(Nat.mul(acc, rr), pp), Nat.mul(acc, Nat.mul(rr, pp)), Ar.nat_mul_assoc(acc, rr, pp)) :
        {Nat.add(Nat.add(_, Nat.mul(dd, pp)), gg) == Nat.add(Nat.mul(acc, Nat.mul(rr, pp)), Nat.add(Nat.mul(dd, pp),
        gg)) : Nat}
      Ar.nat_add_assoc(Nat.mul(acc, Nat.mul(rr, pp)), Nat.mul(dd, pp), gg)

# a Nat is at most itself
def n1.le.refl(xx: Nat) -> {Nat.is_le(xx, xx) == True{} : Bool}:
  Equal.cong(Cmp, Bool, cc => Cmp.is_le(cc), Nat.cmp(xx, xx), EQ{}, ncmp.refl(xx))

# the value of digits below the radix, from 0, is below the radix to the
# number of digits
def n1.hb(
  xs: List<&2, Char>,
  +rr: Nat,
  +hn: {n1.nou(xs) == True{} : Bool},
  +hd: {n1.dlt(xs, rr) == True{} : Bool}
) -> {Nat.is_lt(Laws.g.num.nat(xs, rr, 0n), Nat.pow(rr, List.length(&2, Char, xs))) == True{} : Bool}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      +hu = {Eq.and.left(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt), hn) : {Bool.not(Laws.abnf.underscore(hh))
        == True{} : Bool}}
      +ht = {Eq.and.right(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt), hn) : {n1.nou(tt) == True{} : Bool}}
      +hdh = {Eq.and.left(Nat.is_lt(Laws.g.hexdig.val(hh), rr), n1.dlt(tt, rr), hd) : {Nat.is_lt(Laws.g.hexdig.val(hh),
        rr) == True{} : Bool}}
      +hdt = {Eq.and.right(Nat.is_lt(Laws.g.hexdig.val(hh), rr), n1.dlt(tt, rr), hd) : {n1.dlt(tt, rr) == True{}
        : Bool}}
      +dd = Laws.g.hexdig.val(hh)
      +pp = Nat.pow(rr, List.length(&2, Char, tt))
      +gg = Laws.g.num.nat(tt, rr, 0n)
      %Equal.sym(Nat, Laws.g.num.nat(hh <> tt, rr, 0n), Laws.g.num.nat(tt, rr, dd), n1.gn.step(hh, tt, rr, 0n, hu)) :
        {Nat.is_lt(_, Nat.mul(rr, pp)) == True{} : Bool}
      %Equal.sym(Nat, Laws.g.num.nat(tt, rr, dd), Nat.add(Nat.mul(dd, pp), gg), n1.hl(tt, rr, dd, ht)) :
        {Nat.is_lt(_, Nat.mul(rr, pp)) == True{} : Bool}
      n1.lt.le(Nat.add(Nat.mul(dd, pp), gg), Nat.add(Nat.mul(dd, pp), pp), Nat.mul(rr, pp),
        Equal.trans(Bool, Nat.is_lt(Nat.add(Nat.mul(dd, pp), gg), Nat.add(Nat.mul(dd, pp), pp)), Nat.is_lt(gg, pp),
        True{}, Equal.cong(Cmp, Bool, cc => Cmp.is_lt(cc), Nat.cmp(Nat.add(Nat.mul(dd, pp), gg), Nat.add(Nat.mul(dd,
        pp), pp)), Nat.cmp(gg, pp), n1.cmp.add(Nat.mul(dd, pp), gg, pp)), n1.hb(tt, rr, ht, hdt)),
        Equal.trans(Bool, Nat.is_le(Nat.add(Nat.mul(dd, pp), pp), Nat.mul(rr, pp)), Nat.is_le(Nat.mul(1n+dd, pp),
        Nat.mul(rr, pp)), True{}, Equal.cong(Nat, Bool, xx => Nat.is_le(xx, Nat.mul(rr, pp)), Nat.add(Nat.mul(dd, pp),
        pp), Nat.add(pp, Nat.mul(dd, pp)), Ar.nat_add_comm(Nat.mul(dd, pp), pp)), n1.le.mul(1n+dd, rr, pp,
        n1.lt.suc(dd, rr, hdh))))

# digits whose first is not 0 are worth at least the radix to the number of
# digits after the first
def n1.low(
  +hh: Char,
  +tt: List<&2, Char>,
  +rr: Nat,
  +hn: {n1.nou(hh <> tt) == True{} : Bool},
  +hf: {Nat.is_lt(0n, Laws.g.hexdig.val(hh)) == True{} : Bool}
) -> {Nat.is_le(Nat.pow(rr, List.length(&2, Char, tt)), Laws.g.num.nat(hh <> tt, rr, 0n)) == True{} : Bool}:
  +hu = {Eq.and.left(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt), hn) : {Bool.not(Laws.abnf.underscore(hh))
    == True{} : Bool}}
  +ht = {Eq.and.right(Bool.not(Laws.abnf.underscore(hh)), n1.nou(tt), hn) : {n1.nou(tt) == True{} : Bool}}
  +dd = Laws.g.hexdig.val(hh)
  +pp = Nat.pow(rr, List.length(&2, Char, tt))
  +gg = Laws.g.num.nat(tt, rr, 0n)
  %Equal.sym(Nat, Laws.g.num.nat(hh <> tt, rr, 0n), Laws.g.num.nat(tt, rr, dd), n1.gn.step(hh, tt, rr, 0n, hu)) :
    {Nat.is_le(pp, _) == True{} : Bool}
  %Equal.sym(Nat, Laws.g.num.nat(tt, rr, dd), Nat.add(Nat.mul(dd, pp), gg), n1.hl(tt, rr, dd, ht)) :
    {Nat.is_le(pp, _) == True{} : Bool}
  n1.le.trans(pp, Nat.mul(dd, pp), Nat.add(Nat.mul(dd, pp), gg), Equal.trans(Bool, Nat.is_le(pp, Nat.mul(dd, pp)),
    Nat.is_le(Nat.add(pp, 0n), Nat.mul(dd, pp)), True{}, Equal.cong(Nat, Bool, xx => Nat.is_le(xx, Nat.mul(dd, pp)),
    pp, Nat.add(pp, 0n), Equal.sym(Nat, Nat.add(pp, 0n), pp, Ar.nat_add_zero(pp))), n1.le.mul(1n, dd, pp,
    n1.lt.suc(0n, dd, hf))), n1.le.addr(Nat.mul(dd, pp), gg))

# a power grows with its exponent, for a radix above 0
def n1.pw.le(
  rr: Nat,
  +aa: Nat,
  kk: Nat,
  +hr: {Nat.is_lt(0n, rr) == True{} : Bool}
) -> {Nat.is_le(Nat.pow(rr, aa), Nat.pow(rr, Nat.add(aa, kk))) == True{} : Bool}:
  match rr kk:
    case 0n _k:
      Eq.bit.absurd(&2, {Nat.is_le(Nat.pow(0n, aa), Nat.pow(0n, Nat.add(aa, _k))) == True{} : Bool}, hr)
    case 1n+(+r1) 0n:
      %Equal.sym(Nat, Nat.add(aa, 0n), aa, Ar.nat_add_zero(aa)) : {Nat.is_le(Nat.pow(1n+r1, aa), Nat.pow(1n+r1, _))
        == True{} : Bool}
      n1.le.refl(Nat.pow(1n+r1, aa))
    case 1n+(+r1) 1n+(+k1):
      %Equal.sym(Nat, Nat.add(aa, 1n+k1), 1n+Nat.add(aa, k1), Ar.nat_add_succ(aa, k1)) : {Nat.is_le(Nat.pow(1n+r1,
        aa), Nat.pow(1n+r1, _)) == True{} : Bool}
      n1.le.trans(Nat.pow(1n+r1, aa), Nat.pow(1n+r1, Nat.add(aa, k1)), Nat.mul(1n+r1, Nat.pow(1n+r1, Nat.add(aa, k1))),
        n1.pw.le(1n+r1, aa, k1, hr), n1.le.addr(Nat.pow(1n+r1, Nat.add(aa, k1)), Nat.mul(r1, Nat.pow(1n+r1,
        Nat.add(aa, k1)))))

# An integer's value. A digit of a radix is one of 22 characters, and what
# the scan and the grammar compute of each is checked one by one.

# a claim of a character under its being a digit of the radix
def n1.rd.Q(P: Char -> Type, rx: Laws.ARadix, cc: Char) -> Type:
  {Laws.abnf.radix_digit(rx, cc) == True{} : Bool} -> P(cc)

# 99 is no digit of any base
def n1.no99(rx: Laws.ARadix) -> {T.dig.ok(99, n1.rb(rx)) == False{} : Bool}:
  match rx:
    case Laws.AHex{}:
      {==}
    case Laws.AOct{}:
      {==}
    case Laws.ABin{}:
      {==}

# a code point that is a digit, a letter a to f, a letter A to F, or none of
# them, and a digit of the radix
def n1.rd.go(
  dd: Bool,
  ll: Bool,
  uu: Bool,
  -P: Char -> Type,
  +rx: Laws.ARadix,
  +cp: U32,
  +ed: {Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)) == dd : Bool},
  +el: {Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)) == ll : Bool},
  +eu: {Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)) == uu : Bool},
  +h: {Laws.abnf.radix_digit(rx, Chr{cp}) == True{} : Bool},
  p0: n1.rd.Q(P, rx, '0'),
  p1: n1.rd.Q(P, rx, '1'),
  p2: n1.rd.Q(P, rx, '2'),
  p3: n1.rd.Q(P, rx, '3'),
  p4: n1.rd.Q(P, rx, '4'),
  p5: n1.rd.Q(P, rx, '5'),
  p6: n1.rd.Q(P, rx, '6'),
  p7: n1.rd.Q(P, rx, '7'),
  p8: n1.rd.Q(P, rx, '8'),
  p9: n1.rd.Q(P, rx, '9'),
  pa: n1.rd.Q(P, rx, 'a'),
  pb: n1.rd.Q(P, rx, 'b'),
  pc: n1.rd.Q(P, rx, 'c'),
  pd: n1.rd.Q(P, rx, 'd'),
  pe: n1.rd.Q(P, rx, 'e'),
  pf: n1.rd.Q(P, rx, 'f'),
  pA: n1.rd.Q(P, rx, 'A'),
  pB: n1.rd.Q(P, rx, 'B'),
  pC: n1.rd.Q(P, rx, 'C'),
  pD: n1.rd.Q(P, rx, 'D'),
  pE: n1.rd.Q(P, rx, 'E'),
  pF: n1.rd.Q(P, rx, 'F')
) -> P(Chr{cp}):
  match dd:
    case True{}:
      dg.elim(zz => n1.rd.Q(P, rx, zz), Chr{cp}, ed, p0, p1, p2, p3, p4, p5, p6, p7, p8, p9)(h)
    case False{}:
      match ll:
        case True{}:
          lw.elim(zz => n1.rd.Q(P, rx, zz), Chr{cp}, el, pa, pb, pc, pd, pe, pf)(h)
        case False{}:
          match uu:
            case True{}:
              up.elim(zz => n1.rd.Q(P, rx, zz), Chr{cp}, eu, pA, pB, pC, pD, pE, pF)(h)
            case False{}:
              Eq.bit.absurd(&1, P(Chr{cp}), Equal.trans(Bool, False{}, T.dig.ok(99, n1.rb(rx)), True{},
                Equal.sym(Bool, T.dig.ok(99, n1.rb(rx)), False{}, n1.no99(rx)), Equal.trans(Bool,
                T.dig.ok(99, n1.rb(rx)), Laws.abnf.radix_digit(rx, Chr{cp}), True{}, n1.cls.none.go(rx, cp, ed, el,
                eu), h)))

# a claim made of each of the 22 characters, under its being a digit of the
# radix, is made of every digit of the radix
def n1.rd.elim(
  -P: Char -> Type,
  +rx: Laws.ARadix,
  cc: Char,
  +h: {Laws.abnf.radix_digit(rx, cc) == True{} : Bool},
  p0: n1.rd.Q(P, rx, '0'),
  p1: n1.rd.Q(P, rx, '1'),
  p2: n1.rd.Q(P, rx, '2'),
  p3: n1.rd.Q(P, rx, '3'),
  p4: n1.rd.Q(P, rx, '4'),
  p5: n1.rd.Q(P, rx, '5'),
  p6: n1.rd.Q(P, rx, '6'),
  p7: n1.rd.Q(P, rx, '7'),
  p8: n1.rd.Q(P, rx, '8'),
  p9: n1.rd.Q(P, rx, '9'),
  pa: n1.rd.Q(P, rx, 'a'),
  pb: n1.rd.Q(P, rx, 'b'),
  pc: n1.rd.Q(P, rx, 'c'),
  pd: n1.rd.Q(P, rx, 'd'),
  pe: n1.rd.Q(P, rx, 'e'),
  pf: n1.rd.Q(P, rx, 'f'),
  pA: n1.rd.Q(P, rx, 'A'),
  pB: n1.rd.Q(P, rx, 'B'),
  pC: n1.rd.Q(P, rx, 'C'),
  pD: n1.rd.Q(P, rx, 'D'),
  pE: n1.rd.Q(P, rx, 'E'),
  pF: n1.rd.Q(P, rx, 'F')
) -> P(cc):
  match cc:
    case Chr{+cp}:
      n1.rd.go(Bool.and(U32.is_ge(cp, 48), U32.is_le(cp, 57)), Bool.and(U32.is_ge(cp, 97), U32.is_le(cp, 102)),
        Bool.and(U32.is_ge(cp, 65), U32.is_le(cp, 70)), P, rx, cp, {==}, {==}, {==}, h, p0, p1, p2, p3, p4, p5, p6,
        p7, p8, p9, pa, pb, pc, pd, pe, pf, pA, pB, pC, pD, pE, pF)

# the scan's value of a digit of the radix is the grammar's
def n1.dv(
  +rx: Laws.ARadix,
  cc: Char,
  +h: {Laws.abnf.radix_digit(rx, cc) == True{} : Bool}
) -> {U32.to_nat(T.dig.val(cc)) == Laws.g.hexdig.val(cc) : Nat}:
  n1.rd.elim(zz => {U32.to_nat(T.dig.val(zz)) == Laws.g.hexdig.val(zz) : Nat}, rx, cc, h,
    _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==},
    _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==},
    _h => {==}, _h => {==}, _h => {==}, _h => {==})

# a digit of the radix other than 0 is worth more than 0
def n1.d0(
  +rx: Laws.ARadix,
  cc: Char,
  +h: {Laws.abnf.radix_digit(rx, cc) == True{} : Bool},
  +hz: {Laws.abnf.cp(cc, 48) == False{} : Bool}
) -> {Nat.is_lt(0n, Laws.g.hexdig.val(cc)) == True{} : Bool}:
  n1.rd.elim(zz => {Laws.abnf.cp(zz, 48) == False{} : Bool} -> {Nat.is_lt(0n, Laws.g.hexdig.val(zz)) == True{}
    : Bool}, rx, cc, h,
    _h => ee => Eq.bit.absurd2(&2, {Nat.is_lt(0n, Laws.g.hexdig.val('0')) == True{} : Bool}, ee),
    _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==},
    _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==},
    _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==}, _h => _e => {==},
    _h => _e => {==}, _h => _e => {==}, _h => _e => {==})(hz)

# a hexadecimal digit is from 0 to 7 exactly when it is worth less than 8
def n1.d07(
  cc: Char,
  +h: {Laws.abnf.radix_digit(Laws.AHex{}, cc) == True{} : Bool}
) -> {Laws.abnf.digit0_7(cc) == Nat.is_lt(Laws.g.hexdig.val(cc), 8n) : Bool}:
  n1.rd.elim(zz => {Laws.abnf.digit0_7(zz) == Nat.is_lt(Laws.g.hexdig.val(zz), 8n) : Bool}, Laws.AHex{}, cc, h,
    _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==},
    _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==}, _h => {==},
    _h => {==}, _h => {==}, _h => {==}, _h => {==})

# a digit of the radix is worth less than the radix
def n1.dlr(
  +rx: Laws.ARadix,
  +cc: Char,
  +h: {Laws.abnf.radix_digit(rx, cc) == True{} : Bool}
) -> {Nat.is_lt(Laws.g.hexdig.val(cc), U32.to_nat(n1.rb(rx))) == True{} : Bool}:
  %n1.dv(rx, cc, h) :
    {Nat.is_lt(_, U32.to_nat(n1.rb(rx))) == True{} : Bool}
  Equal.trans(Bool, Nat.is_lt(U32.to_nat(T.dig.val(cc)), U32.to_nat(n1.rb(rx))), U32.is_lt(T.dig.val(cc), n1.rb(rx)),
    True{}, Equal.sym(Bool, U32.is_lt(T.dig.val(cc), n1.rb(rx)), Nat.is_lt(U32.to_nat(T.dig.val(cc)),
    U32.to_nat(n1.rb(rx))), u.lt(T.dig.val(cc), n1.rb(rx))), Equal.trans(Bool, T.dig.ok(T.dig.val(cc), n1.rb(rx)),
    Laws.abnf.radix_digit(rx, cc), True{}, n1.cls(rx, cc), h))

# Decimal digits and their value. Of two numerals of decimal digits with no
# leading zero, i64.step's walk over the characters compares their values,
# and str.eq's walk finds them equal exactly when their values are.

# a numeral's value in base 10
def n1.h10(ss: String) -> Nat:
  Laws.g.num.nat(String.to_list(ss), 10n, 0n)

# a DIGIT is no underscore
def n1.dg.nu(
  +cc: Char,
  +hd: {Laws.abnf.DIGIT(cc) == True{} : Bool}
) -> {Bool.not(Laws.abnf.underscore(cc)) == True{} : Bool}:
  %Equal.sym(Bool, Laws.abnf.underscore(cc), False{}, gs.nous(cc, gs.dig(cc, hd))) : {Bool.not(_) == True{} : Bool}
  {==}

# a DIGIT is worth less than 10
def n1.dg.lt(
  +cc: Char,
  +hd: {Laws.abnf.DIGIT(cc) == True{} : Bool}
) -> {Nat.is_lt(Laws.g.hexdig.val(cc), 10n) == True{} : Bool}:
  dg.elim(zz => {Nat.is_lt(Laws.g.hexdig.val(zz), 10n) == True{} : Bool}, cc, gs.dig(cc, hd), {==}, {==}, {==}, {==},
    {==}, {==}, {==}, {==}, {==}, {==})

# a DIGIT's value and 48 is its code point
def n1.v48(
  +cc: Char,
  +hd: {Laws.abnf.DIGIT(cc) == True{} : Bool}
) -> {Nat.add(48n, Laws.g.hexdig.val(cc)) == U32.to_nat(Char.to_u32(cc)) : Nat}:
  dg.elim(zz => {Nat.add(48n, Laws.g.hexdig.val(zz)) == U32.to_nat(Char.to_u32(zz)) : Nat}, cc, gs.dig(cc, hd), {==},
    {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# DIGITs compare by code point as their values compare
def n1.dcmp(
  +xx: Char,
  +yy: Char,
  +hx: {Laws.abnf.DIGIT(xx) == True{} : Bool},
  +hy: {Laws.abnf.DIGIT(yy) == True{} : Bool}
) -> {U32.cmp(Char.to_u32(xx), Char.to_u32(yy)) == Nat.cmp(Laws.g.hexdig.val(xx), Laws.g.hexdig.val(yy)) : Cmp}:
  %Equal.sym(Cmp, U32.cmp(Char.to_u32(xx), Char.to_u32(yy)), Nat.cmp(U32.to_nat(Char.to_u32(xx)),
    U32.to_nat(Char.to_u32(yy))), Ar.u_cmp(Char.to_u32(xx), Char.to_u32(yy))) : {_ == Nat.cmp(Laws.g.hexdig.val(xx),
    Laws.g.hexdig.val(yy)) : Cmp}
  %n1.v48(xx, hx) : {Nat.cmp(_, U32.to_nat(Char.to_u32(yy))) == Nat.cmp(Laws.g.hexdig.val(xx),
    Laws.g.hexdig.val(yy)) : Cmp}
  %n1.v48(yy, hy) : {Nat.cmp(Nat.add(48n, Laws.g.hexdig.val(xx)), _) == Nat.cmp(Laws.g.hexdig.val(xx),
    Laws.g.hexdig.val(yy)) : Cmp}
  n1.cmp.add(48n, Laws.g.hexdig.val(xx), Laws.g.hexdig.val(yy))

# two characters are equal as their code points compare equal
def n1.ceq(
  +xx: Char,
  +yy: Char
) -> {Char.is_eq(xx, yy) == Cmp.is_eq(U32.cmp(Char.to_u32(xx), Char.to_u32(yy))) : Bool}:
  match xx yy:
    case Chr{_x} Chr{_y}:
      {==}

# every character a DIGIT: none an underscore
def n1.all.nou(
  ss: String,
  +hs: {Laws.g.dec.all(ss) == True{} : Bool}
) -> {n1.nou(String.to_list(ss)) == True{} : Bool}:
  match ss:
    case SNil{}:
      {==}
    case SCon{+hh, +tt}:
      and.tt(Bool.not(Laws.abnf.underscore(hh)), n1.nou(String.to_list(tt)), n1.dg.nu(hh, Eq.and.left(
        Laws.abnf.DIGIT(hh), Laws.g.dec.all(tt), hs)), n1.all.nou(tt, Eq.and.right(Laws.abnf.DIGIT(hh),
        Laws.g.dec.all(tt), hs)))

# and each worth less than 10
def n1.all.dlt(
  ss: String,
  +hs: {Laws.g.dec.all(ss) == True{} : Bool}
) -> {n1.dlt(String.to_list(ss), 10n) == True{} : Bool}:
  match ss:
    case SNil{}:
      {==}
    case SCon{+hh, +tt}:
      and.tt(Nat.is_lt(Laws.g.hexdig.val(hh), 10n), n1.dlt(String.to_list(tt), 10n), n1.dg.lt(hh, Eq.and.left(
        Laws.abnf.DIGIT(hh), Laws.g.dec.all(tt), hs)), n1.all.dlt(tt, Eq.and.right(Laws.abnf.DIGIT(hh),
        Laws.g.dec.all(tt), hs)))

# i64.ord groups either way
def n1.oa(
  aa: Cmp,
  +bb: Cmp,
  +cc: Cmp
) -> {T.i64.ord(T.i64.ord(aa, bb), cc) == T.i64.ord(aa, T.i64.ord(bb, cc)) : Cmp}:
  match aa:
    case EQ{}:
      {==}
    case LT{}:
      {==}
    case GT{}:
      {==}

# whether two strings have one length
def n1.samel(aa: String, bb: String) -> Bool:
  match aa bb:
    case SNil{} SNil{}:
      True{}
    case SCon{_x, xt} SCon{_y, yt}:
      n1.samel(xt, yt)
    case _a _b:
      False{}

# the length of a string's characters
def n1.len(ss: String) -> Nat:
  List.length(&2, Char, String.to_list(ss))

# strings of one length have characters of one length
def n1.samel.len(
  aa: String,
  bb: String,
  +hl: {n1.samel(aa, bb) == True{} : Bool}
) -> {n1.len(aa) == n1.len(bb) : Nat}:
  match aa bb:
    case SNil{} SNil{}:
      {==}
    case SNil{} SCon{_y, _yt}:
      Eq.bit.absurd(&2, {n1.len(SNil{}) == n1.len(SCon{_y, _yt}) : Nat}, hl)
    case SCon{_x, _xt} SNil{}:
      Eq.bit.absurd(&2, {n1.len(SCon{_x, _xt}) == n1.len(SNil{}) : Nat}, hl)
    case SCon{_x, +xt} SCon{_y, +yt}:
      Equal.cong(Nat, Nat, nn => 1n+nn, n1.len(xt), n1.len(yt), n1.samel.len(xt, yt, hl))

# and strings whose lengths compare equal have one length
def n1.samel.of(
  aa: String,
  bb: String,
  +hl: {Nat.cmp(n1.len(aa), n1.len(bb)) == EQ{} : Cmp}
) -> {n1.samel(aa, bb) == True{} : Bool}:
  match aa bb:
    case SNil{} SNil{}:
      {==}
    case SNil{} SCon{_y, _yt}:
      Eq.bit.absurd(&2, {n1.samel(SNil{}, SCon{_y, _yt}) == True{} : Bool}, Equal.cong(Cmp, Bool,
        cc => Cmp.is_eq(cc), Nat.cmp(n1.len(SNil{}), n1.len(SCon{_y, _yt})), EQ{}, hl))
    case SCon{_x, _xt} SNil{}:
      Eq.bit.absurd(&2, {n1.samel(SCon{_x, _xt}, SNil{}) == True{} : Bool}, Equal.cong(Cmp, Bool,
        cc => Cmp.is_eq(cc), Nat.cmp(n1.len(SCon{_x, _xt}), n1.len(SNil{})), EQ{}, hl))
    case SCon{_x, +xt} SCon{_y, +yt}:
      n1.samel.of(xt, yt, hl)

# a DIGIT in front is its value times ten to the rest's length, and the
# rest's value
def n1.hcons(
  +xx: Char,
  +xt: String,
  +hx: {Laws.abnf.DIGIT(xx) == True{} : Bool},
  +ht: {Laws.g.dec.all(xt) == True{} : Bool}
) -> {n1.h10(SCon{xx, xt}) == Nat.add(Nat.mul(Laws.g.hexdig.val(xx), Nat.pow(10n, n1.len(xt))), n1.h10(xt)) : Nat}:
  Equal.trans(Nat, n1.h10(SCon{xx, xt}), Laws.g.num.nat(String.to_list(xt), 10n, Laws.g.hexdig.val(xx)),
    Nat.add(Nat.mul(Laws.g.hexdig.val(xx), Nat.pow(10n, n1.len(xt))), n1.h10(xt)), n1.gn.step(xx,
    String.to_list(xt), 10n, 0n, n1.dg.nu(xx, hx)), n1.hl(String.to_list(xt), 10n, Laws.g.hexdig.val(xx),
    n1.all.nou(xt, ht)))

# DIGITs are worth less than ten to their number
def n1.hb10(
  +ss: String,
  +hs: {Laws.g.dec.all(ss) == True{} : Bool}
) -> {Nat.is_lt(n1.h10(ss), Nat.pow(10n, n1.len(ss))) == True{} : Bool}:
  n1.hb(String.to_list(ss), 10n, n1.all.nou(ss, hs), n1.all.dlt(ss, hs))

# of two strings of DIGITs of one length, i64.step's walk from an order
# already seen finishes as that order, and then their values' order, allows
def n1.lex(
  aa: String,
  bb: String,
  +oo: Cmp,
  +ha: {Laws.g.dec.all(aa) == True{} : Bool},
  +hb: {Laws.g.dec.all(bb) == True{} : Bool},
  +hl: {n1.samel(aa, bb) == True{} : Bool}
) -> {T.i64.step(aa, bb, oo) == Cmp.is_le(T.i64.ord(oo, Nat.cmp(n1.h10(aa), n1.h10(bb)))) : Bool}:
  match aa bb:
    case SNil{} SNil{}:
      match oo:
        case EQ{}:
          {==}
        case LT{}:
          {==}
        case GT{}:
          {==}
    case SNil{} SCon{_y, _yt}:
      Eq.bit.absurd(&2, {T.i64.step(SNil{}, SCon{_y, _yt}, oo) == Cmp.is_le(T.i64.ord(oo, Nat.cmp(n1.h10(SNil{}),
        n1.h10(SCon{_y, _yt})))) : Bool}, hl)
    case SCon{_x, _xt} SNil{}:
      Eq.bit.absurd(&2, {T.i64.step(SCon{_x, _xt}, SNil{}, oo) == Cmp.is_le(T.i64.ord(oo, Nat.cmp(n1.h10(SCon{_x,
        _xt}), n1.h10(SNil{})))) : Bool}, hl)
    case SCon{+xx, +xt} SCon{+yy, +yt}:
      +hx = {Eq.and.left(Laws.abnf.DIGIT(xx), Laws.g.dec.all(xt), ha) : {Laws.abnf.DIGIT(xx) == True{} : Bool}}
      +hxt = {Eq.and.right(Laws.abnf.DIGIT(xx), Laws.g.dec.all(xt), ha) : {Laws.g.dec.all(xt) == True{} : Bool}}
      +hy = {Eq.and.left(Laws.abnf.DIGIT(yy), Laws.g.dec.all(yt), hb) : {Laws.abnf.DIGIT(yy) == True{} : Bool}}
      +hyt = {Eq.and.right(Laws.abnf.DIGIT(yy), Laws.g.dec.all(yt), hb) : {Laws.g.dec.all(yt) == True{} : Bool}}
      +vx = Laws.g.hexdig.val(xx)
      +vy = Laws.g.hexdig.val(yy)
      +pp = Nat.pow(10n, n1.len(xt))
      +el = {Equal.cong(Nat, Nat, nn => Nat.pow(10n, nn), n1.len(xt), n1.len(yt), n1.samel.len(xt, yt, hl))
        : {pp == Nat.pow(10n, n1.len(yt)) : Nat}}
      +hty = {Equal.trans(Bool, Nat.is_lt(n1.h10(yt), pp), Nat.is_lt(n1.h10(yt), Nat.pow(10n, n1.len(yt))), True{},
        Equal.cong(Nat, Bool, nn => Nat.is_lt(n1.h10(yt), nn), pp, Nat.pow(10n, n1.len(yt)), el), n1.hb10(yt, hyt))
        : {Nat.is_lt(n1.h10(yt), pp) == True{} : Bool}}
      %Equal.sym(Nat, n1.h10(SCon{xx, xt}), Nat.add(Nat.mul(vx, pp), n1.h10(xt)), n1.hcons(xx, xt, hx, hxt)) :
        {T.i64.step(SCon{xx, xt}, SCon{yy, yt}, oo) == Cmp.is_le(T.i64.ord(oo, Nat.cmp(_, n1.h10(SCon{yy, yt}))))
        : Bool}
      %Equal.sym(Nat, n1.h10(SCon{yy, yt}), Nat.add(Nat.mul(vy, Nat.pow(10n, n1.len(yt))), n1.h10(yt)),
        n1.hcons(yy, yt, hy, hyt)) : {T.i64.step(SCon{xx, xt}, SCon{yy, yt}, oo) == Cmp.is_le(T.i64.ord(oo,
        Nat.cmp(Nat.add(Nat.mul(vx, pp), n1.h10(xt)), _))) : Bool}
      %el : {T.i64.step(SCon{xx, xt}, SCon{yy, yt}, oo) == Cmp.is_le(T.i64.ord(oo, Nat.cmp(Nat.add(Nat.mul(vx, pp),
        n1.h10(xt)), Nat.add(Nat.mul(vy, _), n1.h10(yt))))) : Bool}
      %Equal.sym(Cmp, Nat.cmp(Nat.add(Nat.mul(vx, pp), n1.h10(xt)), Nat.add(Nat.mul(vy, pp), n1.h10(yt))),
        T.i64.ord(Nat.cmp(vx, vy), Nat.cmp(n1.h10(xt), n1.h10(yt))), n1.ka(vx, vy, pp, n1.h10(xt), n1.h10(yt),
        n1.hb10(xt, hxt), hty)) : {T.i64.step(SCon{xx, xt}, SCon{yy, yt}, oo) == Cmp.is_le(T.i64.ord(oo, _)) : Bool}
      %n1.oa(oo, Nat.cmp(vx, vy), Nat.cmp(n1.h10(xt), n1.h10(yt))) : {T.i64.step(SCon{xx, xt}, SCon{yy, yt}, oo)
        == Cmp.is_le(_) : Bool}
      %Equal.sym(Cmp, U32.cmp(Char.to_u32(xx), Char.to_u32(yy)), Nat.cmp(vx, vy), n1.dcmp(xx, yy, hx, hy)) :
        {T.i64.step(xt, yt, T.i64.ord(oo, _)) == Cmp.is_le(T.i64.ord(T.i64.ord(oo, Nat.cmp(vx, vy)),
        Nat.cmp(n1.h10(xt), n1.h10(yt)))) : Bool}
      n1.lex(xt, yt, T.i64.ord(oo, Nat.cmp(vx, vy)), hxt, hyt, hl)

# a string shorter than the limit fits, whatever came before
def n1.st.lt(
  aa: String,
  bb: String,
  +oo: Cmp,
  +hl: {Nat.is_lt(n1.len(aa), n1.len(bb)) == True{} : Bool}
) -> {T.i64.step(aa, bb, oo) == True{} : Bool}:
  match aa bb:
    case SNil{} SNil{}:
      Eq.bit.absurd(&2, {T.i64.step(SNil{}, SNil{}, oo) == True{} : Bool}, hl)
    case SNil{} SCon{_y, _yt}:
      {==}
    case SCon{_x, _xt} SNil{}:
      Eq.bit.absurd(&2, {T.i64.step(SCon{_x, _xt}, SNil{}, oo) == True{} : Bool}, hl)
    case SCon{+xx, +xt} SCon{+yy, +yt}:
      n1.st.lt(xt, yt, T.i64.ord(oo, U32.cmp(Char.to_u32(xx), Char.to_u32(yy))), hl)

# and a longer one does not
def n1.st.gt(
  aa: String,
  bb: String,
  +oo: Cmp,
  +hl: {Nat.is_lt(n1.len(bb), n1.len(aa)) == True{} : Bool}
) -> {T.i64.step(aa, bb, oo) == False{} : Bool}:
  match aa bb:
    case SNil{} SNil{}:
      Eq.bit.absurd(&2, {T.i64.step(SNil{}, SNil{}, oo) == False{} : Bool}, hl)
    case SNil{} SCon{_y, _yt}:
      Eq.bit.absurd(&2, {T.i64.step(SNil{}, SCon{_y, _yt}, oo) == False{} : Bool}, hl)
    case SCon{_x, _xt} SNil{}:
      {==}
    case SCon{+xx, +xt} SCon{+yy, +yt}:
      n1.st.gt(xt, yt, T.i64.ord(oo, U32.cmp(Char.to_u32(xx), Char.to_u32(yy))), hl)

# at most b is not more than b
def n1.le.nlt(aa: Nat, bb: Nat, +hh: {Nat.is_le(aa, bb) == True{} : Bool}) -> {Nat.is_lt(bb, aa) == False{} : Bool}:
  match aa bb:
    case 0n _b:
      nlt.zero(_b)
    case 1n+(+a1) 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(0n, 1n+a1) == False{} : Bool}, hh)
    case 1n+(+a1) 1n+(+b1):
      n1.le.nlt(a1, b1, hh)

# below is at most
def n1.lt.lte(aa: Nat, bb: Nat, +hh: {Nat.is_lt(aa, bb) == True{} : Bool}) -> {Nat.is_le(aa, bb) == True{} : Bool}:
  match aa bb:
    case 0n _b:
      n1.le0(_b)
    case 1n+(+a1) 0n:
      Eq.bit.absurd(&2, {Nat.is_le(1n+a1, 0n) == True{} : Bool}, hh)
    case 1n+(+a1) 1n+(+b1):
      n1.lt.lte(a1, b1, hh)

# below b is not at least b
def n1.lt.nle(aa: Nat, bb: Nat, +hh: {Nat.is_lt(aa, bb) == True{} : Bool}) -> {Nat.is_le(bb, aa) == False{} : Bool}:
  match aa bb:
    case _a 0n:
      Eq.bit.absurd(&2, {Nat.is_le(0n, _a) == False{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(_a, 0n), True{},
        Equal.sym(Bool, Nat.is_lt(_a, 0n), False{}, nlt.zero(_a)), hh))
    case 0n 1n+_b:
      {==}
    case 1n+(+a1) 1n+(+b1):
      n1.lt.nle(a1, b1, hh)

# below b is not b
def n1.lt.ne(aa: Nat, bb: Nat, +hh: {Nat.is_lt(aa, bb) == True{} : Bool}) -> {Nat.is_eq(aa, bb) == False{} : Bool}:
  match aa bb:
    case _a 0n:
      Eq.bit.absurd(&2, {Nat.is_eq(_a, 0n) == False{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(_a, 0n), True{},
        Equal.sym(Bool, Nat.is_lt(_a, 0n), False{}, nlt.zero(_a)), hh))
    case 0n 1n+_b:
      {==}
    case 1n+(+a1) 1n+(+b1):
      n1.lt.ne(a1, b1, hh)

# above b is not b
def n1.gt.ne(aa: Nat, bb: Nat, +hh: {Nat.is_lt(bb, aa) == True{} : Bool}) -> {Nat.is_eq(aa, bb) == False{} : Bool}:
  match aa bb:
    case 0n _b:
      Eq.bit.absurd(&2, {Nat.is_eq(0n, _b) == False{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(_b, 0n), True{},
        Equal.sym(Bool, Nat.is_lt(_b, 0n), False{}, nlt.zero(_b)), hh))
    case 1n+_a 0n:
      {==}
    case 1n+(+a1) 1n+(+b1):
      n1.gt.ne(a1, b1, hh)

# a comparison GT is the other way below
def n1.gt.lt(aa: Nat, bb: Nat, +hh: {Nat.cmp(aa, bb) == GT{} : Cmp}) -> {Nat.is_lt(bb, aa) == True{} : Bool}:
  match aa bb:
    case 0n 0n:
      Eq.bit.absurd(&2, {Nat.is_lt(0n, 0n) == True{} : Bool}, Equal.cong(Cmp, Bool, cc => Cmp.is_gt(cc), EQ{}, GT{},
        hh))
    case 0n 1n+_b:
      Eq.bit.absurd(&2, {Nat.is_lt(1n+_b, 0n) == True{} : Bool}, Equal.cong(Cmp, Bool, cc => Cmp.is_gt(cc), LT{},
        GT{}, hh))
    case 1n+_a 0n:
      {==}
    case 1n+(+a1) 1n+(+b1):
      n1.gt.lt(a1, b1, hh)

# a power grows with its exponent
def n1.pw.mono(
  +rr: Nat,
  +aa: Nat,
  +bb: Nat,
  +hr: {Nat.is_lt(0n, rr) == True{} : Bool},
  +hh: {Nat.is_le(aa, bb) == True{} : Bool}
) -> {Nat.is_le(Nat.pow(rr, aa), Nat.pow(rr, bb)) == True{} : Bool}:
  %Ar.nat_ge_ex(bb, aa, n1.le.nlt(aa, bb, hh)) : {Nat.is_le(Nat.pow(rr, aa), Nat.pow(rr, _)) == True{} : Bool}
  n1.pw.le(rr, aa, Nat.sub(bb, aa), hr)

# of `and(a, false)` or b, b
def n1.oaf(aa: Bool, +bb: Bool, +hh: {Bool.or(Bool.and(aa, False{}), bb) == True{} : Bool}) -> {bb == True{} : Bool}:
  match aa:
    case True{}:
      hh
    case False{}:
      hh

# the type of n1.canon.tl's ho
def n1.canon.tl.P1(+hh: Char, +tt: String) -> Type:
  {Bool.or(Bool.and(Laws.abnf.cp(hh, 48), String.is_empty(tt)), Bool.and(Laws.abnf.digit1_9(hh),
    Laws.g.dec.all(tt))) == True{} : Bool}

# after the first character of a canonical numeral, only DIGITs
def n1.canon.tl(
  +hh: Char,
  tt: String,
  ho: n1.canon.tl.P1(hh, tt)
) -> {Laws.g.dec.all(tt) == True{} : Bool}:
  match tt:
    case SNil{}:
      {==}
    case SCon{+t1, +ts}:
      Eq.and.right(Laws.abnf.digit1_9(hh), Laws.g.dec.all(SCon{t1, ts}), n1.oaf(Laws.abnf.cp(hh, 48),
        Bool.and(Laws.abnf.digit1_9(hh), Laws.g.dec.all(SCon{t1, ts})), ho))

# a canonical numeral is DIGITs
def n1.canon.all(ss: String, +hs: {Laws.g.dec.canon(ss) == True{} : Bool}) -> {Laws.g.dec.all(ss) == True{} : Bool}:
  match ss:
    case SNil{}:
      Eq.bit.absurd(&2, {Laws.g.dec.all(SNil{}) == True{} : Bool}, hs)
    case SCon{+hh, +tt}:
      and.tt(Laws.abnf.DIGIT(hh), Laws.g.dec.all(tt), Eq.and.left(Laws.abnf.DIGIT(hh), Bool.or(Bool.and(
        Laws.abnf.cp(hh, 48), String.is_empty(tt)), Bool.and(Laws.abnf.digit1_9(hh), Laws.g.dec.all(tt))), hs),
        n1.canon.tl(hh, tt, Eq.and.right(Laws.abnf.DIGIT(hh), Bool.or(Bool.and(Laws.abnf.cp(hh, 48),
        String.is_empty(tt)), Bool.and(Laws.abnf.digit1_9(hh), Laws.g.dec.all(tt))), hs)))

# a canonical numeral of two characters or more starts with a digit1-9
def n1.canon.d19(
  +hh: Char,
  +t1: Char,
  +ts: String,
  +hs: {Laws.g.dec.canon(SCon{hh, SCon{t1, ts}}) == True{} : Bool}
) -> {Laws.abnf.digit1_9(hh) == True{} : Bool}:
  Eq.and.left(Laws.abnf.digit1_9(hh), Laws.g.dec.all(SCon{t1, ts}), n1.oaf(Laws.abnf.cp(hh, 48),
    Bool.and(Laws.abnf.digit1_9(hh), Laws.g.dec.all(SCon{t1, ts})), Eq.and.right(Laws.abnf.DIGIT(hh),
    Bool.or(Bool.and(Laws.abnf.cp(hh, 48), False{}), Bool.and(Laws.abnf.digit1_9(hh), Laws.g.dec.all(SCon{t1,
    ts}))), hs)))

# a digit1-9 is worth more than 0
def n1.d19.pos(
  +cc: Char,
  +hd: {Laws.abnf.digit1_9(cc) == True{} : Bool}
) -> {Nat.is_lt(0n, Laws.g.hexdig.val(cc)) == True{} : Bool}:
  dg.elim(zz => {Char.is_eq(zz, '0') == False{} : Bool} -> {Nat.is_lt(0n, Laws.g.hexdig.val(zz)) == True{} : Bool},
    cc, gs.d19(cc, hd), ee => Eq.bit.absurd2(&2, {Nat.is_lt(0n, Laws.g.hexdig.val('0')) == True{} : Bool}, ee),
    _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==}, _e => {==},
    _e => {==})(gs.d19z(cc, hd))

# of two canonical numerals, the shorter is worth less: the longer starts
# with a digit1-9 and has at least as many after it as the shorter has
def n1.short.go(
  +ah: Char,
  +at: String,
  +bh: Char,
  bt: String,
  +ha: {Laws.g.dec.canon(SCon{ah, at}) == True{} : Bool},
  +hb: {Laws.g.dec.canon(SCon{bh, bt}) == True{} : Bool},
  +hl: {Nat.is_lt(n1.len(at), n1.len(bt)) == True{} : Bool}
) -> {Nat.is_lt(n1.h10(SCon{ah, at}), n1.h10(SCon{bh, bt})) == True{} : Bool}:
  match bt:
    case SNil{}:
      Eq.bit.absurd(&2, {Nat.is_lt(n1.h10(SCon{ah, at}), n1.h10(SCon{bh, SNil{}})) == True{} : Bool},
        Equal.trans(Bool, False{}, Nat.is_lt(n1.len(at), 0n), True{}, Equal.sym(Bool, Nat.is_lt(n1.len(at), 0n),
        False{}, nlt.zero(n1.len(at))), hl))
    case SCon{+b1, +bs}:
      n1.lt.le(n1.h10(SCon{ah, at}), Nat.pow(10n, n1.len(SCon{ah, at})), n1.h10(SCon{bh, SCon{b1, bs}}),
        n1.hb10(SCon{ah, at}, n1.canon.all(SCon{ah, at}, ha)), n1.le.trans(Nat.pow(10n, n1.len(SCon{ah, at})),
        Nat.pow(10n, n1.len(SCon{b1, bs})), n1.h10(SCon{bh, SCon{b1, bs}}), n1.pw.mono(10n, n1.len(SCon{ah, at}),
        n1.len(SCon{b1, bs}), {==}, n1.lt.suc(n1.len(at), n1.len(SCon{b1, bs}), hl)), n1.low(bh,
        String.to_list(SCon{b1, bs}), 10n, n1.all.nou(SCon{bh, SCon{b1, bs}}, n1.canon.all(SCon{bh, SCon{b1, bs}},
        hb)), n1.d19.pos(bh, n1.canon.d19(bh, b1, bs, hb)))))

# of two canonical numerals, the shorter is worth less
def n1.short(
  aa: String,
  bb: String,
  +ha: {Laws.g.dec.canon(aa) == True{} : Bool},
  +hb: {Laws.g.dec.canon(bb) == True{} : Bool},
  +hl: {Nat.is_lt(n1.len(aa), n1.len(bb)) == True{} : Bool}
) -> {Nat.is_lt(n1.h10(aa), n1.h10(bb)) == True{} : Bool}:
  match aa bb:
    case SNil{} _b:
      Eq.bit.absurd(&2, {Nat.is_lt(n1.h10(SNil{}), n1.h10(_b)) == True{} : Bool}, ha)
    case SCon{+ah, +at} SNil{}:
      Eq.bit.absurd(&2, {Nat.is_lt(n1.h10(SCon{ah, at}), n1.h10(SNil{})) == True{} : Bool}, hl)
    case SCon{+ah, +at} SCon{+bh, +bt}:
      n1.short.go(ah, at, bh, bt, ha, hb, hl)

# i64.step against a canonical limit, by how the lengths compare: a shorter
# numeral fits and is worth less, a longer one does not and is worth more,
# and one of the same length compares its digits
def n1.fh.go(
  cc: Cmp,
  +dd: String,
  +ll: String,
  +ec: {Nat.cmp(n1.len(dd), n1.len(ll)) == cc : Cmp},
  +hd: {Laws.g.dec.canon(dd) == True{} : Bool},
  +hl: {Laws.g.dec.canon(ll) == True{} : Bool}
) -> {T.i64.step(dd, ll, EQ{}) == Nat.is_le(n1.h10(dd), n1.h10(ll)) : Bool}:
  match cc:
    case LT{}:
      +hs = {Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Nat.cmp(n1.len(dd), n1.len(ll)), LT{}, ec)
        : {Nat.is_lt(n1.len(dd), n1.len(ll)) == True{} : Bool}}
      Equal.trans(Bool, T.i64.step(dd, ll, EQ{}), True{}, Nat.is_le(n1.h10(dd), n1.h10(ll)), n1.st.lt(dd, ll, EQ{},
        hs), Equal.sym(Bool, Nat.is_le(n1.h10(dd), n1.h10(ll)), True{}, n1.lt.lte(n1.h10(dd), n1.h10(ll),
        n1.short(dd, ll, hd, hl, hs))))
    case EQ{}:
      n1.lex(dd, ll, EQ{}, n1.canon.all(dd, hd), n1.canon.all(ll, hl), n1.samel.of(dd, ll, ec))
    case GT{}:
      +hs = {n1.gt.lt(n1.len(dd), n1.len(ll), ec) : {Nat.is_lt(n1.len(ll), n1.len(dd)) == True{} : Bool}}
      Equal.trans(Bool, T.i64.step(dd, ll, EQ{}), False{}, Nat.is_le(n1.h10(dd), n1.h10(ll)), n1.st.gt(dd, ll, EQ{},
        hs), Equal.sym(Bool, Nat.is_le(n1.h10(dd), n1.h10(ll)), False{}, n1.lt.nle(n1.h10(ll), n1.h10(dd),
        n1.short(ll, dd, hl, hd, hs))))

# of two canonical numerals, i64.step's walk allows the first exactly when it
# is worth at most the second
def n1.fh(
  +dd: String,
  +ll: String,
  +hd: {Laws.g.dec.canon(dd) == True{} : Bool},
  +hl: {Laws.g.dec.canon(ll) == True{} : Bool}
) -> {T.i64.step(dd, ll, EQ{}) == Nat.is_le(n1.h10(dd), n1.h10(ll)) : Bool}:
  n1.fh.go(Nat.cmp(n1.len(dd), n1.len(ll)), dd, ll, {==}, hd, hl)

# after first characters that compare as cc, str.eq's walk goes on exactly
# when cc is EQ, and then answers as the rest's values compare
def n1.seq.c(
  cc: Cmp,
  +xt: String,
  +yt: String,
  +ih: {T.str.eq(xt, yt) == Nat.is_eq(n1.h10(xt), n1.h10(yt)) : Bool}
) -> {T.str.eq.step(xt, yt, Cmp.is_eq(cc)) == Cmp.is_eq(T.i64.ord(cc, Nat.cmp(n1.h10(xt), n1.h10(yt)))) : Bool}:
  match cc:
    case EQ{}:
      ih
    case LT{}:
      str.eq.step.false(xt, yt)
    case GT{}:
      str.eq.step.false(xt, yt)

# two strings of DIGITs of one length are equal exactly when their values are
def n1.seq(
  aa: String,
  bb: String,
  +ha: {Laws.g.dec.all(aa) == True{} : Bool},
  +hb: {Laws.g.dec.all(bb) == True{} : Bool},
  +hl: {n1.samel(aa, bb) == True{} : Bool}
) -> {T.str.eq(aa, bb) == Nat.is_eq(n1.h10(aa), n1.h10(bb)) : Bool}:
  match aa bb:
    case SNil{} SNil{}:
      {==}
    case SNil{} SCon{_y, _yt}:
      Eq.bit.absurd(&2, {T.str.eq(SNil{}, SCon{_y, _yt}) == Nat.is_eq(n1.h10(SNil{}), n1.h10(SCon{_y, _yt}))
        : Bool}, hl)
    case SCon{_x, _xt} SNil{}:
      Eq.bit.absurd(&2, {T.str.eq(SCon{_x, _xt}, SNil{}) == Nat.is_eq(n1.h10(SCon{_x, _xt}), n1.h10(SNil{}))
        : Bool}, hl)
    case SCon{+xx, +xt} SCon{+yy, +yt}:
      +hx = {Eq.and.left(Laws.abnf.DIGIT(xx), Laws.g.dec.all(xt), ha) : {Laws.abnf.DIGIT(xx) == True{} : Bool}}
      +hxt = {Eq.and.right(Laws.abnf.DIGIT(xx), Laws.g.dec.all(xt), ha) : {Laws.g.dec.all(xt) == True{} : Bool}}
      +hy = {Eq.and.left(Laws.abnf.DIGIT(yy), Laws.g.dec.all(yt), hb) : {Laws.abnf.DIGIT(yy) == True{} : Bool}}
      +hyt = {Eq.and.right(Laws.abnf.DIGIT(yy), Laws.g.dec.all(yt), hb) : {Laws.g.dec.all(yt) == True{} : Bool}}
      +vx = Laws.g.hexdig.val(xx)
      +vy = Laws.g.hexdig.val(yy)
      +pp = Nat.pow(10n, n1.len(xt))
      +el = {Equal.cong(Nat, Nat, nn => Nat.pow(10n, nn), n1.len(xt), n1.len(yt), n1.samel.len(xt, yt, hl))
        : {pp == Nat.pow(10n, n1.len(yt)) : Nat}}
      +hty = {Equal.trans(Bool, Nat.is_lt(n1.h10(yt), pp), Nat.is_lt(n1.h10(yt), Nat.pow(10n, n1.len(yt))), True{},
        Equal.cong(Nat, Bool, nn => Nat.is_lt(n1.h10(yt), nn), pp, Nat.pow(10n, n1.len(yt)), el), n1.hb10(yt, hyt))
        : {Nat.is_lt(n1.h10(yt), pp) == True{} : Bool}}
      %Equal.sym(Nat, n1.h10(SCon{xx, xt}), Nat.add(Nat.mul(vx, pp), n1.h10(xt)), n1.hcons(xx, xt, hx, hxt)) :
        {T.str.eq(SCon{xx, xt}, SCon{yy, yt}) == Cmp.is_eq(Nat.cmp(_, n1.h10(SCon{yy, yt}))) : Bool}
      %Equal.sym(Nat, n1.h10(SCon{yy, yt}), Nat.add(Nat.mul(vy, Nat.pow(10n, n1.len(yt))), n1.h10(yt)),
        n1.hcons(yy, yt, hy, hyt)) : {T.str.eq(SCon{xx, xt}, SCon{yy, yt}) == Cmp.is_eq(Nat.cmp(Nat.add(Nat.mul(vx,
        pp), n1.h10(xt)), _)) : Bool}
      %el : {T.str.eq(SCon{xx, xt}, SCon{yy, yt}) == Cmp.is_eq(Nat.cmp(Nat.add(Nat.mul(vx, pp), n1.h10(xt)),
        Nat.add(Nat.mul(vy, _), n1.h10(yt)))) : Bool}
      %Equal.sym(Cmp, Nat.cmp(Nat.add(Nat.mul(vx, pp), n1.h10(xt)), Nat.add(Nat.mul(vy, pp), n1.h10(yt))),
        T.i64.ord(Nat.cmp(vx, vy), Nat.cmp(n1.h10(xt), n1.h10(yt))), n1.ka(vx, vy, pp, n1.h10(xt), n1.h10(yt),
        n1.hb10(xt, hxt), hty)) : {T.str.eq(SCon{xx, xt}, SCon{yy, yt}) == Cmp.is_eq(_) : Bool}
      %Equal.sym(Bool, Char.is_eq(xx, yy), Cmp.is_eq(U32.cmp(Char.to_u32(xx), Char.to_u32(yy))), n1.ceq(xx, yy)) :
        {T.str.eq.step(xt, yt, _) == Cmp.is_eq(T.i64.ord(Nat.cmp(vx, vy), Nat.cmp(n1.h10(xt), n1.h10(yt)))) : Bool}
      %Equal.sym(Cmp, U32.cmp(Char.to_u32(xx), Char.to_u32(yy)), Nat.cmp(vx, vy), n1.dcmp(xx, yy, hx, hy)) :
        {T.str.eq.step(xt, yt, Cmp.is_eq(_)) == Cmp.is_eq(T.i64.ord(Nat.cmp(vx, vy), Nat.cmp(n1.h10(xt),
        n1.h10(yt)))) : Bool}
      n1.seq.c(Nat.cmp(vx, vy), xt, yt, n1.seq(xt, yt, hxt, hyt, hl))

# strings str.eq finds equal have lengths that compare equal
def n1.str.len(
  +aa: String,
  +bb: String,
  +hh: {T.str.eq(aa, bb) == True{} : Bool}
) -> {Nat.cmp(n1.len(aa), n1.len(bb)) == EQ{} : Cmp}:
  %str.eq.true(aa, bb, hh) : {Nat.cmp(n1.len(aa), n1.len(_)) == EQ{} : Cmp}
  ncmp.refl(n1.len(aa))

# strings whose lengths do not compare equal are not equal
def n1.str.nf(
  se: Bool,
  +aa: String,
  +bb: String,
  +es: {T.str.eq(aa, bb) == se : Bool},
  +hn: {Cmp.is_eq(Nat.cmp(n1.len(aa), n1.len(bb))) == False{} : Bool}
) -> {T.str.eq(aa, bb) == False{} : Bool}:
  match se:
    case True{}:
      Eq.bit.absurd2(&2, {T.str.eq(aa, bb) == False{} : Bool}, Equal.trans(Bool, True{},
        Cmp.is_eq(Nat.cmp(n1.len(aa), n1.len(bb))), False{}, Equal.sym(Bool, Cmp.is_eq(Nat.cmp(n1.len(aa),
        n1.len(bb))), True{}, Equal.cong(Cmp, Bool, xx => Cmp.is_eq(xx), Nat.cmp(n1.len(aa), n1.len(bb)), EQ{},
        n1.str.len(aa, bb, es))), hn))
    case False{}:
      es

# of two canonical numerals, by how their lengths compare
def n1.uq.t(
  cc: Cmp,
  +d2: String,
  +dd: String,
  +ec: {Nat.cmp(n1.len(d2), n1.len(dd)) == cc : Cmp},
  +h2: {Laws.g.dec.canon(d2) == True{} : Bool},
  +hd: {Laws.g.dec.canon(dd) == True{} : Bool}
) -> {T.str.eq(d2, dd) == Nat.is_eq(n1.h10(d2), n1.h10(dd)) : Bool}:
  match cc:
    case LT{}:
      +hs = {Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Nat.cmp(n1.len(d2), n1.len(dd)), LT{}, ec)
        : {Nat.is_lt(n1.len(d2), n1.len(dd)) == True{} : Bool}}
      Equal.trans(Bool, T.str.eq(d2, dd), False{}, Nat.is_eq(n1.h10(d2), n1.h10(dd)), n1.str.nf(T.str.eq(d2, dd),
        d2, dd, {==}, Equal.cong(Cmp, Bool, xx => Cmp.is_eq(xx), Nat.cmp(n1.len(d2), n1.len(dd)), LT{}, ec)),
        Equal.sym(Bool, Nat.is_eq(n1.h10(d2), n1.h10(dd)), False{}, n1.lt.ne(n1.h10(d2), n1.h10(dd), n1.short(d2,
        dd, h2, hd, hs))))
    case EQ{}:
      n1.seq(d2, dd, n1.canon.all(d2, h2), n1.canon.all(dd, hd), n1.samel.of(d2, dd, ec))
    case GT{}:
      +hs = {n1.gt.lt(n1.len(d2), n1.len(dd), ec) : {Nat.is_lt(n1.len(dd), n1.len(d2)) == True{} : Bool}}
      Equal.trans(Bool, T.str.eq(d2, dd), False{}, Nat.is_eq(n1.h10(d2), n1.h10(dd)), n1.str.nf(T.str.eq(d2, dd),
        d2, dd, {==}, Equal.cong(Cmp, Bool, xx => Cmp.is_eq(xx), Nat.cmp(n1.len(d2), n1.len(dd)), GT{}, ec)),
        Equal.sym(Bool, Nat.is_eq(n1.h10(d2), n1.h10(dd)), False{}, n1.gt.ne(n1.h10(d2), n1.h10(dd), n1.short(dd,
        d2, hd, h2, hs))))

# a string that is no canonical numeral is not one that is
def n1.uq.f(
  se: Bool,
  +d2: String,
  +dd: String,
  +es: {T.str.eq(d2, dd) == se : Bool},
  +h2: {Laws.g.dec.canon(d2) == False{} : Bool},
  +hd: {Laws.g.dec.canon(dd) == True{} : Bool}
) -> {T.str.eq(d2, dd) == False{} : Bool}:
  match se:
    case True{}:
      Eq.bit.absurd(&2, {T.str.eq(d2, dd) == False{} : Bool}, Equal.trans(Bool, False{}, Laws.g.dec.canon(d2),
        True{}, Equal.sym(Bool, Laws.g.dec.canon(d2), False{}, h2), Equal.trans(Bool, Laws.g.dec.canon(d2),
        Laws.g.dec.canon(dd), True{}, Equal.cong(String, Bool, ss => Laws.g.dec.canon(ss), d2, dd, str.eq.true(d2,
        dd, es)), hd)))
    case False{}:
      es

# by whether the first string is canonical
def n1.uq.go(
  kk: Bool,
  +d2: String,
  +dd: String,
  +ek: {Laws.g.dec.canon(d2) == kk : Bool},
  +hd: {Laws.g.dec.canon(dd) == True{} : Bool}
) -> {T.str.eq(d2, dd) == Bool.and(Laws.g.dec.canon(d2), Nat.is_eq(n1.h10(d2), n1.h10(dd))) : Bool}:
  match kk:
    case True{}:
      %Equal.sym(Bool, Laws.g.dec.canon(d2), True{}, ek) : {T.str.eq(d2, dd) == Bool.and(_, Nat.is_eq(n1.h10(d2),
        n1.h10(dd))) : Bool}
      n1.uq.t(Nat.cmp(n1.len(d2), n1.len(dd)), d2, dd, {==}, ek, hd)
    case False{}:
      %Equal.sym(Bool, Laws.g.dec.canon(d2), False{}, ek) : {T.str.eq(d2, dd) == Bool.and(_, Nat.is_eq(n1.h10(d2),
        n1.h10(dd))) : Bool}
      n1.uq.f(T.str.eq(d2, dd), d2, dd, {==}, ek, hd)

# a string is a canonical numeral D exactly when it is canonical and worth
# what D is
def n1.uq(
  +d2: String,
  +dd: String,
  +hd: {Laws.g.dec.canon(dd) == True{} : Bool}
) -> {String.eq(d2, dd) == Bool.and(Laws.g.dec.canon(d2), Nat.is_eq(n1.h10(d2), n1.h10(dd))) : Bool}:
  %str.eq.agree(d2, dd) : {_ == Bool.and(Laws.g.dec.canon(d2), Nat.is_eq(n1.h10(d2), n1.h10(dd))) : Bool}
  n1.uq.go(Laws.g.dec.canon(d2), d2, dd, {==}, hd)

# The numeral a scan builds: decimal digits as U32s, least-significant
# first. dec.go multiplies it by the radix and adds a digit; dec.text writes
# it as a canonical numeral worth what the digits are.

# appending groups either way
def n1.app.assoc(
  xs: List<&2, U32>,
  +ys: List<&2, U32>,
  +zs: List<&2, U32>
) -> {List.append(&2, U32, List.append(&2, U32, xs, ys), zs) == List.append(&2, U32, xs, List.append(&2, U32, ys, zs))
  : List<&2, U32>}:
  match xs:
    case []:
      {==}
    case +xx <> +xt:
      Equal.cong(List<&2, U32>, List<&2, U32>, ls => xx <> ls, List.append(&2, U32, List.append(&2, U32, xt, ys), zs),
        List.append(&2, U32, xt, List.append(&2, U32, ys, zs)), n1.app.assoc(xt, ys, zs))

# reversing onto a list is reversing, and then the list
def n1.rgo(
  xs: List<&2, U32>,
  +acc: List<&2, U32>
) -> {List.reverse.go(&2, U32, xs, acc) == List.append(&2, U32, List.reverse.go(&2, U32, xs, []), acc)
  : List<&2, U32>}:
  match xs:
    case []:
      {==}
    case +xx <> +xt:
      Equal.trans(List<&2, U32>, List.reverse.go(&2, U32, xt, xx <> acc), List.append(&2, U32, List.reverse.go(&2,
        U32, xt, []), xx <> acc), List.append(&2, U32, List.reverse.go(&2, U32, xt, [xx]), acc), n1.rgo(xt,
        xx <> acc), Equal.sym(List<&2, U32>, List.append(&2, U32, List.reverse.go(&2, U32, xt, [xx]), acc),
        List.append(&2, U32, List.reverse.go(&2, U32, xt, []), xx <> acc), Equal.trans(List<&2, U32>,
        List.append(&2, U32, List.reverse.go(&2, U32, xt, [xx]), acc), List.append(&2, U32, List.append(&2, U32,
        List.reverse.go(&2, U32, xt, []), [xx]), acc), List.append(&2, U32, List.reverse.go(&2, U32, xt, []),
        xx <> acc), Equal.cong(List<&2, U32>, List<&2, U32>, ls => List.append(&2, U32, ls, acc),
        List.reverse.go(&2, U32, xt, [xx]), List.append(&2, U32, List.reverse.go(&2, U32, xt, []), [xx]),
        n1.rgo(xt, [xx])), n1.app.assoc(List.reverse.go(&2, U32, xt, []), [xx], acc))))

# digits written one after the other are the lists written
def n1.dch.app(
  xs: List<&2, U32>,
  +ys: List<&2, U32>
) -> {T.dec.chars(List.append(&2, U32, xs, ys)) == List.append(&2, Char, T.dec.chars(xs), T.dec.chars(ys))
  : List<&2, Char>}:
  match xs:
    case []:
      {==}
    case +xx <> +xt:
      Equal.cong(List<&2, Char>, List<&2, Char>, ls => T.dec.ch(xx) <> ls, T.dec.chars(List.append(&2, U32, xt, ys)),
        List.append(&2, Char, T.dec.chars(xt), T.dec.chars(ys)), n1.dch.app(xt, ys))

# the value of characters one after the other goes on from the first's
def n1.gn.app(
  xs: List<&2, Char>,
  +ys: List<&2, Char>,
  +rr: Nat,
  +acc: Nat
) -> {Laws.g.num.nat(List.append(&2, Char, xs, ys), rr, acc) == Laws.g.num.nat(ys, rr, Laws.g.num.nat(xs, rr, acc))
  : Nat}:
  match xs:
    case []:
      {==}
    case +hh <> +tt:
      n1.gn.app(tt, ys, rr, Laws.g.num.nat.step(Laws.abnf.underscore(hh), hh, rr, acc))

# a digit below ten, written, is one more place of the value
def n1.dch1(
  +dd: U32,
  +acc: Nat,
  +hd: {U32.is_lt(dd, 10) == True{} : Bool}
) -> {Laws.g.num.nat([T.dec.ch(dd)], 10n, acc) == Nat.add(Nat.mul(acc, 10n), U32.to_nat(dd)) : Nat}:
  sm.elim(zz => {Laws.g.num.nat([T.dec.ch(zz)], 10n, acc) == Nat.add(Nat.mul(acc, 10n), U32.to_nat(zz)) : Nat}, dd,
    hd, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# the value of a numeral's digits, least-significant first, as written
def n1.V(ds: List<&2, U32>) -> Nat:
  Laws.g.num.nat(T.dec.chars(List.reverse(&2, U32, ds)), 10n, 0n)

# the value of a numeral's digits, least-significant first, as counted
def n1.W(ds: List<&2, U32>) -> Nat:
  match ds:
    case []:
      0n
    case dd <> tt:
      Nat.add(Nat.mul(n1.W(tt), 10n), U32.to_nat(dd))

# whether every digit is below ten
def n1.d10(ds: List<&2, U32>) -> Bool:
  match ds:
    case []:
      True{}
    case dd <> tt:
      Bool.and(U32.is_lt(dd, 10), n1.d10(tt))

# a digit below ten in front is one more place of what the rest is written
# as
def n1.Vc(
  +dd: U32,
  +tt: List<&2, U32>,
  +hd: {U32.is_lt(dd, 10) == True{} : Bool}
) -> {n1.V(dd <> tt) == Nat.add(Nat.mul(n1.V(tt), 10n), U32.to_nat(dd)) : Nat}:
  %Equal.sym(List<&2, U32>, List.reverse.go(&2, U32, tt, [dd]), List.append(&2, U32, List.reverse.go(&2, U32, tt, []),
    [dd]), n1.rgo(tt, [dd])) : {Laws.g.num.nat(T.dec.chars(_), 10n, 0n) == Nat.add(Nat.mul(n1.V(tt), 10n),
    U32.to_nat(dd)) : Nat}
  %Equal.sym(List<&2, Char>, T.dec.chars(List.append(&2, U32, List.reverse.go(&2, U32, tt, []), [dd])),
    List.append(&2, Char, T.dec.chars(List.reverse.go(&2, U32, tt, [])), [T.dec.ch(dd)]),
    n1.dch.app(List.reverse.go(&2, U32, tt, []), [dd])) : {Laws.g.num.nat(_, 10n, 0n) == Nat.add(Nat.mul(n1.V(tt),
    10n), U32.to_nat(dd)) : Nat}
  %Equal.sym(Nat, Laws.g.num.nat(List.append(&2, Char, T.dec.chars(List.reverse.go(&2, U32, tt, [])),
    [T.dec.ch(dd)]), 10n, 0n), Laws.g.num.nat([T.dec.ch(dd)], 10n, n1.V(tt)),
    n1.gn.app(T.dec.chars(List.reverse.go(&2, U32, tt, [])), [T.dec.ch(dd)], 10n, 0n)) : {_ ==
    Nat.add(Nat.mul(n1.V(tt), 10n), U32.to_nat(dd)) : Nat}
  n1.dch1(dd, n1.V(tt), hd)

# digits below ten are written as they are counted
def n1.VW(ds: List<&2, U32>, +hd: {n1.d10(ds) == True{} : Bool}) -> {n1.V(ds) == n1.W(ds) : Nat}:
  match ds:
    case []:
      {==}
    case +dd <> +tt:
      Equal.trans(Nat, n1.V(dd <> tt), Nat.add(Nat.mul(n1.V(tt), 10n), U32.to_nat(dd)), n1.W(dd <> tt), n1.Vc(dd,
        tt, Eq.and.left(U32.is_lt(dd, 10), n1.d10(tt), hd)), Equal.cong(Nat, Nat, nn => Nat.add(Nat.mul(nn, 10n),
        U32.to_nat(dd)), n1.V(tt), n1.W(tt), n1.VW(tt, Eq.and.right(U32.is_lt(dd, 10), n1.d10(tt), hd))))

# a Nat that compares equal to zero is zero
def n1.ceq0(nn: Nat, +hh: {Cmp.is_eq(Nat.cmp(nn, 0n)) == True{} : Bool}) -> {nn == 0n : Nat}:
  match nn:
    case 0n:
      {==}
    case 1n+(+n1):
      Eq.bit.absurd(&2, {1n+n1 == 0n : Nat}, hh)

# a U32 that is zero counts 0
def n1.uz(+qq: U32, +hh: {U32.is_zero(qq) == True{} : Bool}) -> {U32.to_nat(qq) == 0n : Nat}:
  n1.ceq0(U32.to_nat(qq), Equal.trans(Bool, Cmp.is_eq(Nat.cmp(U32.to_nat(qq), 0n)), Cmp.is_eq(U32.cmp(qq, 0)), True{},
    Equal.cong(Cmp, Bool, cc => Cmp.is_eq(cc), Nat.cmp(U32.to_nat(qq), 0n), U32.cmp(qq, 0), Equal.sym(Cmp,
    U32.cmp(qq, 0), Nat.cmp(U32.to_nat(qq), 0n), Ar.u_cmp(qq, 0))), hh))

# below ten, the quotient by ten is zero
def n1.q0(+qq: U32, +hq: {U32.is_lt(qq, 10) == True{} : Bool}) -> {U32.is_zero(U32.div(qq, 10)) == True{} : Bool}:
  Equal.trans(Bool, U32.is_zero(U32.div(qq, 10)), U32.is_lt(qq, 10), True{}, Equal.sym(Bool, U32.is_lt(qq, 10),
    U32.is_zero(U32.div(qq, 10)), qz(qq)), hq)

# below ten, the remainder by ten counts what the U32 does
def n1.m0(
  +qq: U32,
  +hq: {U32.is_lt(qq, 10) == True{} : Bool}
) -> {U32.to_nat(U32.mod(qq, 10)) == U32.to_nat(qq) : Nat}:
  Equal.trans(Nat, U32.to_nat(U32.mod(qq, 10)), Nat.add(Nat.mul(U32.to_nat(U32.div(qq, 10)), 10n),
    U32.to_nat(U32.mod(qq, 10))), U32.to_nat(qq), Equal.cong(Nat, Nat, nn => Nat.add(Nat.mul(nn, 10n),
    U32.to_nat(U32.mod(qq, 10))), 0n, U32.to_nat(U32.div(qq, 10)), Equal.sym(Nat, U32.to_nat(U32.div(qq, 10)), 0n,
    n1.uz(U32.div(qq, 10), n1.q0(qq, hq)))), Ar.u_div(Unit{}, qq))

# the digits of a carry's quotient below ten count the quotient
def n1.carry.b(
  zz: Bool,
  +qq: U32,
  +ez: {U32.is_zero(qq) == zz : Bool},
  +hq: {U32.is_lt(qq, 10) == True{} : Bool}
) -> {n1.W(T.dec.carry.b0(zz, qq)) == U32.to_nat(qq) : Nat}:
  match zz:
    case True{}:
      Equal.sym(Nat, U32.to_nat(qq), 0n, n1.uz(qq, ez))
    case False{}:
      %Equal.sym(Bool, U32.is_zero(U32.div(qq, 10)), True{}, n1.q0(qq, hq)) : {n1.W(U32.mod(qq, 10) <>
        T.dec.carry.c0(_, U32.div(qq, 10))) == U32.to_nat(qq) : Nat}
      n1.m0(qq, hq)

# and are digits below ten
def n1.carry.okb(
  zz: Bool,
  +qq: U32,
  +hq: {U32.is_lt(qq, 10) == True{} : Bool}
) -> {n1.d10(T.dec.carry.b0(zz, qq)) == True{} : Bool}:
  match zz:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(Bool, U32.is_zero(U32.div(qq, 10)), True{}, n1.q0(qq, hq)) : {n1.d10(U32.mod(qq, 10) <>
        T.dec.carry.c0(_, U32.div(qq, 10))) == True{} : Bool}
      and.tt(U32.is_lt(U32.mod(qq, 10), 10), True{}, md(qq), {==})

# below 100, a carry's quotient by ten is below ten
def n1.c10(+cc: U32, +hc: {U32.is_lt(cc, 100) == True{} : Bool}) -> {U32.is_lt(U32.div(cc, 10), 10) == True{} : Bool}:
  Equal.trans(Bool, U32.is_lt(U32.div(cc, 10), 10), U32.is_lt(cc, 100), True{}, Equal.sym(Bool, U32.is_lt(cc, 100),
    U32.is_lt(U32.div(cc, 10), 10), lt10(cc, 10, 100, 10n, {==}, {==})), hc)

# the digits of a carry below 100 count the carry
def n1.carry.a(
  zz: Bool,
  +cc: U32,
  +ez: {U32.is_zero(cc) == zz : Bool},
  +hc: {U32.is_lt(cc, 100) == True{} : Bool}
) -> {n1.W(T.dec.carry.a(zz, cc)) == U32.to_nat(cc) : Nat}:
  match zz:
    case True{}:
      Equal.sym(Nat, U32.to_nat(cc), 0n, n1.uz(cc, ez))
    case False{}:
      %Equal.sym(Nat, n1.W(T.dec.carry.b(U32.div(cc, 10))), U32.to_nat(U32.div(cc, 10)), n1.carry.b(
        U32.is_zero(U32.div(cc, 10)), U32.div(cc, 10), {==}, n1.c10(cc, hc))) : {Nat.add(Nat.mul(_, 10n),
        U32.to_nat(U32.mod(cc, 10))) == U32.to_nat(cc) : Nat}
      Ar.u_div(Unit{}, cc)

# and are digits below ten
def n1.carry.oka(
  zz: Bool,
  +cc: U32,
  +hc: {U32.is_lt(cc, 100) == True{} : Bool}
) -> {n1.d10(T.dec.carry.a(zz, cc)) == True{} : Bool}:
  match zz:
    case True{}:
      {==}
    case False{}:
      and.tt(U32.is_lt(U32.mod(cc, 10), 10), n1.d10(T.dec.carry.b(U32.div(cc, 10))), md(cc),
        n1.carry.okb(U32.is_zero(U32.div(cc, 10)), U32.div(cc, 10), n1.c10(cc, hc)))

# eight doublings
def n1.dbl8(nn: Nat) -> Nat:
  Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(nn))))))))

# what 2^(8 + mm) is past 256, once uu is known
def n1.pz8(mm: Nat, uu: Unit) -> Nat:
  match uu:
    case Unit{}:
      n1.dbl8(Nat.sub(Ar.pow2(mm), 1n))

# 2^(8 + mm) is 256 and more
def n1.pw8(+mm: Nat, uu: Unit) -> {Ar.pow2u(8n+mm, uu) == Nat.add(256n, n1.pz8(mm, uu)) : Nat}:
  match uu:
    case Unit{}:
      Equal.cong(Nat, Nat, xx => n1.dbl8(xx), Ar.pow2(mm), 1n+Nat.sub(Ar.pow2(mm), 1n), Ar.p2_pos(mm))

# below 256 is below 2^32
def n1.lt256(
  +uu: Unit,
  +kk: Nat,
  +hk: {Nat.is_lt(kk, 256n) == True{} : Bool}
) -> {Nat.is_lt(kk, Ar.pow2u(32n, uu)) == True{} : Bool}:
  %Equal.sym(Nat, Ar.pow2u(32n, uu), Nat.add(256n, n1.pz8(24n, uu)), n1.pw8(24n, uu)) : {Nat.is_lt(kk, _) == True{}
    : Bool}
  lt.add(kk, 256n, n1.pz8(24n, uu), hk)

# a digit times r and a carry, below r, is below ten times r
def n1.dig.bd(
  dn: Nat,
  kk: Nat,
  +rn: Nat,
  +cn: Nat,
  +hd: {Nat.is_lt(dn, kk) == True{} : Bool},
  +hc: {Nat.is_lt(cn, rn) == True{} : Bool}
) -> {Nat.is_lt(Nat.add(Nat.mul(dn, rn), cn), Nat.mul(kk, rn)) == True{} : Bool}:
